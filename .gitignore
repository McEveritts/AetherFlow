setup/sources/plexmediaserver_0.9.17.3.2239-fe07491_amd64.deb

# Environment files
.env
.env.*
!.env.example
!plugins/sdk-template/.env.example

# Dependency directories
node_modules/
vendor/

# Security - Ignore service account keys, sensitive credentials, and secrets
**/service-account*.json
**/credentials*
**/secrets*
**/key*.json
**/*.pem

# Next.js build output
.next/
out/
build/
frontend/playwright-report/
frontend/test-results/

# Build outputs & logs
*.exe
*.log
/dist/
backend/bin/
backend/dist/
backend/aetherflow-api
backend/tmp_test_bin
backend/test-build.exe

# Embedded frontend staging (keep placeholder for go:embed)
backend/web/dist/*
!backend/web/dist/.keep

# Security - never commit SSH or ad-hoc server scripts with credentials
temp_ssh*
ssh_tool.py
ssh_pty.py
deploy_server*.py
fix_*.py
patch_*.py
*.cmds

# Databases & runtime backups
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.bak

# Agent teamwork & IDE state
.agents/
.vscode/
tag_message.txt
lint_results.txt

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
