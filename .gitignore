# Environment files
.env
.env.*
!.env.example
!plugins/sdk-template-rust/.env.example

# Dependency directories
node_modules/
vendor/

# Security - Ignore service account keys, sensitive credentials, and secrets
**/service-account*.json
**/credentials*
**/secrets*
**/key*.json
**/*.pem

# Next.js & Playwright build output
.next/
out/
build/
*.tsbuildinfo
e2e/playwright-report/
e2e/test-results/

# Build outputs & logs
*.exe
*.log
/dist/
backend-rs/target/
backend-rs/aetherflow-api
frontend-rs/target/
frontend-rs/dist/
plugins/**/target/
plugins/**/Cargo.lock
!plugins/sdk-template-rust/backend/Cargo.lock
plugins/**/bin/
plugins/**/ui-link

# External WASM frontend staging (keep placeholder)
/web/dist/*
!/web/dist/.keep

# Security - never commit SSH or ad-hoc server scripts with credentials
temp_ssh*
ssh_tool.py
ssh_pty.py
deploy_server*.py
fix_*.py
patch_*.py
*.cmds

# Databases & runtime backups
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.bak
**/.master.creds
/config/*
!/config/packages.json
!/config/package_automation.json
!/config/openapi-v1.yaml

# Agent teamwork & IDE state
.agents/
.vscode/
tag_message.txt
lint_results.txt

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
