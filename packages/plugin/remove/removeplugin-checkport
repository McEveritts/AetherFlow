if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
  # shellcheck source=/dev/null
  source /opt/AetherFlow/packages/common.sh
elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../../common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$(dirname "${BASH_SOURCE[0]}")/../../common.sh"
fi
OUTTO="${LOGFILE:-/var/log/aetherflow/install.log}"
rutorrent="${rutorrent:-/var/www/rutorrent/}"

function _removeplugin-checkport() {
  username=$(whoami);
  rutorrent="${rutorrent:-/var/www/rutorrent/}"
  echo "Uninstalling the check_port plugin ... " >>"${OUTTO}" 2>&1;
  PLUGIN="check_port"
  for i in $PLUGIN; do
    if [[ -n "${rutorrent}" && -n "$i" && ( -d "${rutorrent}plugins/$i" || -L "${rutorrent}plugins/$i" ) ]]; then
      rm -rf "${rutorrent}plugins/$i"
    fi
  done

  echo "Check_port Plugin Uninstall Complete!" >>"${OUTTO}" 2>&1;

  echo >>"${OUTTO}" 2>&1;
  echo >>"${OUTTO}" 2>&1;
  echo "Close this dialog box to refresh your browser" >>"${OUTTO}" 2>&1;

  exit 0
}

function _removeplugin-check_port() {
  _removeplugin-checkport
}

_removeplugin-checkport
