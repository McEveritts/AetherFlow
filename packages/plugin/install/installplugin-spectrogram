#!/bin/bash
#
# [Quick Box :: Install spectrogram plugin]
#
# GITHUB REPOS
# GitHub _ plugins   :   https://github.com/McEveritts/MediaNexus/tree/master/rtplugins
# LOCAL REPOS
# Local _ packages   :   /etc/AetherFlow/packages
# Local _ plugins    :   /etc/AetherFlow/rtplugins
# Author             :   McEveritts
# URL                :   https://AetherFlow.io
