if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
  # shellcheck source=/dev/null
  source /opt/AetherFlow/packages/common.sh
elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../../common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$(dirname "${BASH_SOURCE[0]}")/../../common.sh"
fi
OUTTO="${LOGFILE:-/var/log/aetherflow/install.log}"
local_setup="${local_setup:-/opt/AetherFlow/setup/}"
rutorrent="${rutorrent:-/var/www/rutorrent/}"

function _installplugin-fileshare() {
  username=$(whoami);
  rutorrent="${rutorrent:-/var/www/rutorrent/}"
  echo "Accessing fileshare in the plugin vault ... " >>"${OUTTO}" 2>&1;
  PLUGINVAULT="/etc/AetherFlow/rtplugins/"
  mkdir -p "${rutorrent}plugins"
  cd "${rutorrent}plugins"

  echo "Installing fileshare plugin ... " >>"${OUTTO}" 2>&1;
  PLUGIN="fileshare"
  for i in $PLUGIN; do
    if [[ -d "${PLUGINVAULT}$i" ]]; then
      cp -R "${PLUGINVAULT}$i" .
    elif [[ -d "${rutorrent}plugins/$i" ]]; then
      echo "Plugin $i is already present in ${rutorrent}plugins" >>"${OUTTO}" 2>&1
    else
      echo "Plugin vault directory not found: ${PLUGINVAULT}$i. Attempting fallback clone..." >>"${OUTTO}" 2>&1
      tmp_git="/tmp/rutorrent-git-$$"
      if git clone --depth 1 https://github.com/Novik/ruTorrent.git "$tmp_git" >>"${OUTTO}" 2>&1; then
        if [[ -d "${tmp_git}/plugins/$i" ]]; then
          cp -R "${tmp_git}/plugins/$i" .
        fi
        rm -rf "$tmp_git"
      else
        rm -rf "$tmp_git"
        echo "Warning: Plugin vault missing and upstream fallback unavailable for $i" >>"${OUTTO}" 2>&1
      fi
    fi
  done

  mkdir -p "${rutorrent}home/fileshare/"
  cd "${rutorrent}home/fileshare/"
  rm -f share.php
  ln -sf ../../plugins/fileshare/share.php share.php
  if [[ -f "${local_setup}templates/rutorrent/plugins/fileshare/conf.php.template" ]]; then
    mkdir -p "${rutorrent}plugins/fileshare"
    cp "${local_setup}templates/rutorrent/plugins/fileshare/conf.php.template" "${rutorrent}plugins/fileshare/conf.php"
  fi

  echo "Adjusting permissions ... " >>"${OUTTO}" 2>&1;
  for i in $PLUGIN; do
    if [[ -d "${rutorrent}plugins/$i" ]]; then
      chown -R www-data: "${rutorrent}plugins/$i" 2>>"${OUTTO}" || true
    fi
  done
  echo "Fileshare Plugin Install Complete!" >>"${OUTTO}" 2>&1;

  echo >>"${OUTTO}" 2>&1;
  echo >>"${OUTTO}" 2>&1;
  echo "Close this dialog box to refresh your browser" >>"${OUTTO}" 2>&1;

  exit 0
}

_installplugin-fileshare
