if [[ -f "$(dirname "${BASH_SOURCE[0]}")/../../common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$(dirname "${BASH_SOURCE[0]}")/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
  # shellcheck source=/dev/null
  source /opt/AetherFlow/current/packages/common.sh
elif [[ -f /opt/AetherFlow/packages/common.sh ]]; then
  # shellcheck source=/dev/null
  source /opt/AetherFlow/packages/common.sh
fi
OUTTO="${LOGFILE:-/var/log/aetherflow/install.log}"
LOGFILE="${OUTTO}"
af_prepare_logfile_path "${LOGFILE}"
local_setup="${local_setup:-/opt/AetherFlow/setup/}"
rutorrent="${rutorrent:-/var/www/rutorrent/}"

function _installplugin-fileshare() {
  username=$(whoami);
  rutorrent="${rutorrent:-/var/www/rutorrent/}"
  log "Accessing fileshare in the plugin vault ... "
  PLUGINVAULT="${PLUGINVAULT:-/etc/AetherFlow/rtplugins/}"
  mkdir -p "${rutorrent}plugins"
  cd "${rutorrent}plugins"

  log "Installing fileshare plugin ... "
  PLUGIN="fileshare"
  for i in $PLUGIN; do
    if [[ -d "${PLUGINVAULT}$i" ]]; then
      cp -R "${PLUGINVAULT}$i" .
    elif [[ -d "${rutorrent}plugins/$i" ]]; then
      log "Plugin $i is already present in ${rutorrent}plugins"
    else
      log "Plugin vault directory not found: ${PLUGINVAULT}$i. Attempting fallback clone..."
      tmp_git="$(mktemp -d "${TMPDIR:-/tmp}/rutorrent-git.XXXXXXXXXX")"
      trap '[[ -n "${tmp_git:-}" ]] && rm -rf "${tmp_git}"' RETURN
      if af_logged git clone --depth 1 https://github.com/Novik/ruTorrent.git "${tmp_git}/repo"; then
        if [[ -d "${tmp_git}/repo/plugins/$i" ]]; then
          cp -R "${tmp_git}/repo/plugins/$i" .
        fi
        rm -rf "$tmp_git"
        tmp_git=""
      else
        rm -rf "$tmp_git"
        tmp_git=""
        log "Warning: Plugin vault missing and upstream fallback unavailable for $i"
      fi
    fi
  done

  mkdir -p "${rutorrent}plugins/fileshare"
  touch "${rutorrent}plugins/fileshare/share.php" 2>/dev/null || true
  mkdir -p "${rutorrent}home/fileshare/"
  cd "${rutorrent}home/fileshare/"
  rm -f share.php
  ln -sf ../../plugins/fileshare/share.php share.php 2>/dev/null || cp -f "${rutorrent}plugins/fileshare/share.php" share.php 2>/dev/null || true
  if [[ -f "${local_setup}templates/rutorrent/plugins/fileshare/conf.php.template" ]]; then
    mkdir -p "${rutorrent}plugins/fileshare"
    cp "${local_setup}templates/rutorrent/plugins/fileshare/conf.php.template" "${rutorrent}plugins/fileshare/conf.php"
  fi

  log "Adjusting permissions ... "
  for i in $PLUGIN; do
    if [[ -d "${rutorrent}plugins/$i" ]]; then
      af_logged_stderr chown -R www-data: "${rutorrent}plugins/$i" || true
    fi
  done
  log "Fileshare Plugin Install Complete!"

  log ""
  log ""
  log "Close this dialog box to refresh your browser"

  exit 0
}

_installplugin-fileshare
