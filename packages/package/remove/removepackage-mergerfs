#!/bin/bash
# AetherFlow Package Uninstaller: MergerFS

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="mergerfs"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local lock_fd="" rc=0
        exec {lock_fd}>>"$target" || return 1
        flock -s "$lock_fd" || { exec {lock_fd}>&-; return 1; }
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        flock -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and unmounting mergerfs.service..."

purge_systemd_unit "mergerfs"

for mount_path in /mnt/unionfs /mnt/mergerfs; do
    if mountpoint -q "$mount_path" 2>/dev/null; then
        af_logged fusermount -u "$mount_path" || af_logged umount "$mount_path"
        if mountpoint -q "$mount_path" 2>/dev/null; then
            print_error "Cannot confirm ${mount_path} is unmounted; refusing package removal."
            exit 1
        fi
    fi
done

APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
DEBIAN_FRONTEND=noninteractive af_logged apt-get "$APT_REMOVE_ACTION" -y -qq mergerfs

report_progress 65 "Cleaning up mergerfs system configuration and version cache..."
rm -f /var/lib/mergerfs/.af-version
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/mergerfs /etc/mergerfs /etc/default/mergerfs
fi
af_logged systemctl daemon-reload

remove_lock "${PACKAGE_NAME}"
report_progress 100 "MergerFS removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
