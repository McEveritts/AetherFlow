#!/bin/bash
# AetherFlow Package Uninstaller: MergerFS

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="mergerfs"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and unmounting mergerfs.service..."

purge_systemd_unit "mergerfs"

for mount_path in /mnt/unionfs /mnt/mergerfs; do
    if mountpoint -q "$mount_path" 2>/dev/null; then
        fusermount -u "$mount_path" >> "$LOGFILE" 2>&1 || umount "$mount_path" >> "$LOGFILE" 2>&1
        if mountpoint -q "$mount_path" 2>/dev/null; then
            print_error "Cannot confirm ${mount_path} is unmounted; refusing package removal."
            exit 1
        fi
    fi
done

APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
DEBIAN_FRONTEND=noninteractive apt-get "$APT_REMOVE_ACTION" -y -qq mergerfs >> "$LOGFILE" 2>&1

report_progress 65 "Cleaning up mergerfs system configuration and version cache..."
rm -f /var/lib/mergerfs/.af-version
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/mergerfs /etc/mergerfs /etc/default/mergerfs
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "MergerFS removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
