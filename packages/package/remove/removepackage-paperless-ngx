#!/bin/bash
# AetherFlow Package Uninstaller: Paperless-ngx

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="paperless-ngx"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local lock_fd="" rc=0
        exec {lock_fd}>>"$target" || return 1
        flock -s "$lock_fd" || { exec {lock_fd}>&-; return 1; }
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        flock -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 15 "Stopping Paperless worker and scheduler before the webserver..."
purge_systemd_unit "paperless-worker" "paperless-scheduler" "paperless-webserver"

report_progress 35 "Stopping and purging companion paperless-worker.service..."

report_progress 55 "Stopping and purging primary paperless-webserver.service..."

report_progress 75 "Removing Paperless-ngx virtualenv, app binaries, state, and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/paperless-ngx /opt/paperless /var/lib/paperless /etc/paperless.conf
    purge_system_user "paperless"
else
    safe_rm_rf /opt/paperless/{.git,.venv,src,static,staticfiles,scripts,node_modules}
    rm -f /opt/paperless/{.af-version,requirements.txt,pyproject.toml,uv.lock}
fi
af_logged systemctl daemon-reload

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Paperless-ngx removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
