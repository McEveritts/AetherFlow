#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
export LOGFILE="/var/log/aetherflow/remove-xrdp.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
trap 'print_error "XRDP removal failed; see ${LOGFILE}."' ERR
report_progress 20 "Stopping XRDP and its session manager..."
purge_systemd_unit xrdp.service xrdp-sesman.service
rollback_file /etc/xrdp/startwm.sh
report_progress 60 "Removing XRDP; preserving Linux users and shared desktop dependencies..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get remove -y xrdp xorgxrdp
if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    DEBIAN_FRONTEND=noninteractive af_logged apt-get purge -y xrdp xorgxrdp
    safe_rm_rf /etc/xrdp /var/lib/xrdp
fi
systemctl daemon-reload
rm -f -- /var/lib/xrdp/.af-version
remove_lock xrdp
report_progress 100 "XRDP removed. Linux accounts and home directories were preserved."
