#!/bin/bash
# AetherFlow Package Uninstaller: NZBGet

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="nzbget"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing nzbget.service..."

purge_systemd_unit "nzbget"

report_progress 65 "Removing NZBGet binaries, state directories, and user account..."
safe_rm_rf /usr/local/share/nzbget /usr/local/bin/nzbget
rm -f /opt/nzbget/{nzbget,unrar,7za,7zr,par2,.af-version}
safe_rm_rf /opt/nzbget/webui
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/nzbget"
    safe_rm_rf /opt/nzbget /var/lib/nzbget /etc/nzbget.conf
    purge_system_user "nzbget"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "NZBGet removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
