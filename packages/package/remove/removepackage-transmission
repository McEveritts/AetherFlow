#!/bin/bash
# AetherFlow Package Uninstaller: Transmission

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="transmission"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and removing transmission-daemon service..."

purge_systemd_unit "transmission-daemon"
purge_systemd_unit "transmission"

report_progress 50 "Purging Transmission APT packages..."
DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq transmission-daemon transmission-cli transmission-common >> "$LOGFILE" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1 || true

report_progress 80 "Removing Transmission configuration, state directories, and user account..."
rm -rf /var/lib/transmission-daemon /var/lib/transmission /etc/transmission-daemon /usr/share/transmission
purge_system_user "debian-transmission"
purge_system_user "transmission"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Transmission completely removed."
log_info "${PACKAGE_NAME} removed successfully"
