source /opt/AetherFlow/packages/common.sh
username="${AETHERFLOW_USER:-$(whoami)}"

function _removepackage-tr() {
	# Disable and Stop Transmission services
	systemctl disable "transmission@${username}" 2>/dev/null || true
	systemctl stop "transmission@${username}" 2>/dev/null || true

	# Remove Transmission user and settings directories
	rm -rf "/home/${username}/torrents/transmission/"
	rm -rf "/home/${username}/trwatch/"
	rm -rf /usr/share/transmission
	rm -rf "/srv/rutorrent/home/${username}.transmission.downloads"
	rm -rf "/home/${username}/.config/transmission/"
	rm -rf /etc/apache2/sites-enabled/transmission.conf

	# Remove any package dependencies and settings
	apt-get -y remove transmission* || true
	apt-get -y purge transmission* || true

	# Remove lock file
	rm -f /install/.transmission.lock

	# Reload apache2
	service apache2 reload 2>/dev/null || true
}

# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"
OUTTO=$LOGFILE

_removepackage-tr
