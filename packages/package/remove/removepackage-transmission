#!/bin/bash
# AetherFlow Package Uninstaller: Transmission

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="transmission"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and removing transmission-daemon service..."

purge_systemd_unit "transmission-daemon" "transmission"

report_progress 50 "Purging Transmission APT packages..."
DEBIAN_FRONTEND=noninteractive apt-get "$APT_REMOVE_ACTION" -y -qq transmission-daemon transmission-cli transmission-common >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1

report_progress 80 "Removing Transmission configuration, state directories, and user account..."
rm -rf /usr/share/transmission
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/transmission-daemon /var/lib/transmission /etc/transmission-daemon
fi
purge_system_user "debian-transmission"
purge_system_user "transmission"
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Transmission removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
