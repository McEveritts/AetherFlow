#!/bin/bash
# AetherFlow Package Uninstaller: Scrutiny

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="scrutiny"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling companion scrutiny-collector.timer and service..."

purge_systemd_unit "scrutiny-collector.timer" "scrutiny-collector.service" "scrutiny.service"

report_progress 50 "Stopping and removing scrutiny.service dashboard..."

report_progress 75 "Removing Scrutiny binaries, database, and user account..."
safe_rm_rf /opt/scrutiny
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/scrutiny"
    safe_rm_rf /var/lib/scrutiny /etc/scrutiny
    purge_system_user "scrutiny"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Scrutiny removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
