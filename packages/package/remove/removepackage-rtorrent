#!/bin/bash
# AetherFlow Package Uninstaller: rTorrent

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rtorrent"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and purging rtorrent.service..."

purge_systemd_unit "rtorrent"
killall -9 rtorrent >> "$LOGFILE" 2>&1 || true

report_progress 65 "Removing rTorrent session data and system user..."
rm -rf /run/rtorrent
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/rtorrent
fi
purge_system_user "rtorrent"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "rTorrent removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
