#!/bin/bash
# AetherFlow Package Uninstaller: rTorrent

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rtorrent"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and purging rtorrent.service..."

prepare_rtorrent_scoped_stop
if ! unit_cgroup="$(systemctl show --property=ControlGroup --value -- rtorrent.service)" ||
    [[ -n "$unit_cgroup" && ( "$unit_cgroup" != /* || "$unit_cgroup" == / || "$unit_cgroup" == */../* || "$unit_cgroup" == */.. ) ]]; then
    print_error "Cannot identify the rtorrent.service cgroup; refusing teardown and data deletion."
    exit 1
fi
stop_systemd_unit rtorrent.service
if ! systemd_unit_inactive rtorrent.service; then
    print_error "Cannot prove rtorrent.service is stopped; refusing teardown and data deletion."
    exit 1
fi
# Systemd can report an inactive unit even if a process could not be killed.
# Inspect only the unit's former cgroup, including any delegated children.
if [[ -n "$unit_cgroup" ]]; then
    for cgroup_root in /sys/fs/cgroup /sys/fs/cgroup/systemd /sys/fs/cgroup/unified; do
        unit_cgroup_path="${cgroup_root}${unit_cgroup}"
        [[ -d "$unit_cgroup_path" ]] || continue
        if [[ -f "$unit_cgroup_path/cgroup.events" ]]; then
            if grep -qx 'populated 0' "$unit_cgroup_path/cgroup.events"; then continue; fi
        elif [[ -r "$unit_cgroup_path/cgroup.procs" ]] &&
            unit_pids="$(find -P "$unit_cgroup_path" -name cgroup.procs -exec cat {} +)" && [[ -z "$unit_pids" ]]; then
            continue
        fi
        print_error "Cannot prove the rtorrent.service cgroup is empty; refusing teardown and data deletion."
        exit 1
    done
fi
purge_systemd_unit "rtorrent"

report_progress 65 "Removing the rTorrent package..."
APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
DEBIAN_FRONTEND=noninteractive af_logged apt-get "$APT_REMOVE_ACTION" -y -qq rtorrent
safe_rm_rf /run/rtorrent
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/rtorrent /etc/rtorrent
    purge_system_user "rtorrent"
fi
af_logged systemctl daemon-reload

rm -f -- /var/lib/rtorrent/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "rTorrent removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
