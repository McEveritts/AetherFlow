#!/bin/bash
#
# [AetherFlow Remove Script - X2Go]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="x2go"
APP_NAME="x2go"
DATA_DIR="/var/lib/x2go"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping x2goserver service..."

purge_systemd_unit "x2goserver"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

report_progress 60 "Removing x2goserver packages..."
DEBIAN_FRONTEND=noninteractive apt-get remove -y x2goserver x2goserver-xsession >> "$LOGFILE" 2>&1 || true
rm -f "${DATA_DIR}/.af-version"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${DATA_DIR} and /etc/x2go..."
    rm -rf "${DATA_DIR}" /etc/x2go
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removal complete."
