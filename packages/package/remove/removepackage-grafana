#!/bin/bash
# AetherFlow Package Uninstaller: Grafana

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="grafana"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling grafana-server.service..."

purge_systemd_unit "grafana-server"

report_progress 50 "Purging Grafana APT package and repository..."
DEBIAN_FRONTEND=noninteractive apt-get "$APT_REMOVE_ACTION" -y -qq grafana >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1
rm -f /etc/apt/sources.list.d/grafana.list /etc/apt/keyrings/grafana.gpg

report_progress 80 "Removing Grafana state, logs, configuration, and user account..."
safe_rm_rf /var/log/grafana /usr/share/grafana
rm -f /var/lib/grafana/.af-version
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/grafana /etc/grafana
    purge_system_user "grafana"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Grafana removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
