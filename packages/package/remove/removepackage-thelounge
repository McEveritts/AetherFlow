#!/bin/bash
# AetherFlow Package Uninstaller: The Lounge

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="thelounge"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing thelounge.service..."

purge_systemd_unit "thelounge"

report_progress 65 "Uninstalling npm package and removing state directories..."
npm uninstall -g thelounge >> "$LOGFILE" 2>&1 || true
rm -f /usr/bin/thelounge /usr/local/bin/thelounge
rm -rf /opt/thelounge
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/thelounge
fi
purge_system_user "thelounge"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "The Lounge removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
