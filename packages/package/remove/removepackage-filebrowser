#!/bin/bash
# AetherFlow Package Uninstaller: File Browser

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="filebrowser"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing filebrowser.service..."

purge_systemd_unit "filebrowser"

report_progress 65 "Removing File Browser binary, database, and user account..."
rm -f /usr/local/bin/filebrowser /opt/AetherFlow/logs/filebrowser_credentials.txt
rm -rf /opt/filebrowser
purge_system_user "filebrowser"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "File Browser completely removed."
log_info "${PACKAGE_NAME} removed successfully"