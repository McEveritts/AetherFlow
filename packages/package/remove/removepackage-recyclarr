#!/bin/bash
# AetherFlow Package Uninstaller: Recyclarr

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="recyclarr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling companion recyclarr.timer..."

purge_systemd_unit "recyclarr.timer" "recyclarr.service"

report_progress 45 "Stopping and purging recyclarr.service..."

report_progress 70 "Removing Recyclarr binaries, configurations, and user account..."
rm -f /usr/local/bin/recyclarr
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/usr/local/bin/recyclarr"
    safe_rm_rf /var/lib/recyclarr /etc/recyclarr /opt/recyclarr
    purge_system_user "recyclarr"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

rm -f -- /opt/recyclarr/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Recyclarr removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
