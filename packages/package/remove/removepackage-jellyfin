#!/bin/bash
# AetherFlow Package Uninstaller: Jellyfin

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="jellyfin"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling jellyfin service..."

purge_systemd_unit "jellyfin"

report_progress 50 "Purging jellyfin APT packages and repository..."
DEBIAN_FRONTEND=noninteractive apt-get "$APT_REMOVE_ACTION" -y -qq "jellyfin*" >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1
rm -f /etc/apt/sources.list.d/jellyfin.list /etc/apt/sources.list.d/jellyfin.sources /etc/apt/keyrings/jellyfin.gpg

report_progress 80 "Removing Jellyfin state, caches, logs, and user account..."
safe_rm_rf /var/cache/jellyfin /var/log/jellyfin /usr/share/jellyfin
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/jellyfin /etc/jellyfin
    purge_system_user "jellyfin"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

rm -f /var/lib/jellyfin/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Jellyfin removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
