#!/bin/bash
#
# [AetherFlow Remove Script - Notifiarr]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="notifiarr"
CONFIG_DIR="/etc/notifiarr"
DATA_DIR="/var/lib/notifiarr"
LOG_DIR="/var/log/notifiarr"
BIN_PATH="/usr/local/bin/notifiarr"
LOCK_FILE="/install/.notifiarr.lock"

setup_log "${APP_NAME}-remove"
log "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

stop_disable_service "notifiarr.service"
rm -f /etc/systemd/system/notifiarr.service
systemctl daemon-reload

report_progress 60 "Removing ${APP_NAME} binary..."
rm -f "${BIN_PATH}" "${CONFIG_DIR}/.af-version"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log "DELETE_DATA=true: Purging ${CONFIG_DIR}, ${DATA_DIR}, and ${LOG_DIR}..."
    rm -rf "${CONFIG_DIR}" "${DATA_DIR}" "${LOG_DIR}"
fi

remove_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} removed"
log "${APP_NAME} removal complete."
