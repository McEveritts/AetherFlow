#!/bin/bash
#
# [AetherFlow Remove Script - Notifiarr]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="notifiarr"
APP_NAME="notifiarr"
APP_USER="notifiarr"
CONFIG_DIR="/etc/notifiarr"
DATA_DIR="/var/lib/notifiarr"
LOG_DIR="/var/log/notifiarr"
BIN_PATH="/usr/local/bin/notifiarr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

purge_systemd_unit "notifiarr"
systemctl daemon-reload >> "$LOGFILE" 2>&1

report_progress 60 "Removing ${APP_NAME} binary..."
rm -f "${BIN_PATH}" "${CONFIG_DIR}/.af-version"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/usr/local/bin/notifiarr"
    log_info "DELETE_DATA=true: Purging ${CONFIG_DIR}, ${DATA_DIR}, and ${LOG_DIR}..."
    safe_rm_rf "${CONFIG_DIR}" "/var/lib/notifiarr" "${LOG_DIR}"
fi

if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_system_user "${APP_USER}"
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
