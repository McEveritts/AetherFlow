#!/bin/bash
# AetherFlow Package Uninstaller: Prometheus + Node Exporter

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="prometheus"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing prometheus and node_exporter services..."

purge_systemd_unit "prometheus"
purge_systemd_unit "node_exporter"

report_progress 65 "Removing Prometheus binaries, time-series data, config, and user accounts..."
rm -f /usr/local/bin/prometheus /usr/local/bin/promtool /usr/local/bin/node_exporter
rm -rf /etc/prometheus /var/lib/prometheus
purge_system_user "prometheus"
purge_system_user "node_exporter"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Prometheus and Node Exporter completely removed."
log_info "${PACKAGE_NAME} removed successfully"