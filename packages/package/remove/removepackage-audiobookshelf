#!/bin/bash
# AetherFlow Package Uninstaller: Audiobookshelf

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="audiobookshelf"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing audiobookshelf.service..."

purge_systemd_unit "audiobookshelf"

report_progress 65 "Removing Audiobookshelf package, state directories, and user account..."
DPKG_REMOVE_ACTION=--remove
if [[ "${DELETE_DATA:-false}" == true ]]; then DPKG_REMOVE_ACTION=--purge; fi
DEBIAN_FRONTEND=noninteractive dpkg "$DPKG_REMOVE_ACTION" audiobookshelf >> "$LOGFILE" 2>&1
rm -f /usr/share/keyrings/audiobookshelf-keyring.gpg /etc/apt/sources.list.d/audiobookshelf.list
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /opt/audiobookshelf /var/lib/audiobookshelf /etc/audiobookshelf /var/cache/audiobookshelf
    purge_system_user "audiobookshelf"
else
    rm -f /opt/audiobookshelf/.af-version
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Audiobookshelf removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
