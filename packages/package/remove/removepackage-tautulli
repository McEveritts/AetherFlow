#!/bin/bash
# AetherFlow Package Uninstaller: Tautulli

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="tautulli"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing tautulli.service..."

purge_systemd_unit "tautulli" "plexpy"

report_progress 65 "Removing Tautulli files, state directories, and user account..."
safe_rm_rf /opt/Tautulli
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /opt/plexpy /var/lib/tautulli /etc/tautulli
    purge_system_user "tautulli"
fi
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_system_user "plexpy"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Tautulli removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
