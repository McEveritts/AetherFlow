#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="cloudplow"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing cloudplow.service..."

purge_systemd_unit "cloudplow"

report_progress 65 "Removing Cloudplow virtualenv, configurations, and logs..."
safe_rm_rf /var/log/cloudplow /opt/cloudplow/.venv
safe_rm_rf /opt/cloudplow/{.git,core,utils,__pycache__}
rm -f /opt/cloudplow/{cloudplow.py,requirements.txt,.af-version}
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/cloudplow /etc/cloudplow /opt/cloudplow
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Cloudplow removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
