#!/bin/bash
#
# [Quick Box :: Uninstaller for Medusa package]
#
source /opt/AetherFlow/packages/common.sh
# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"
OUTTO=$LOGFILE

function _removeMedusa() {
  systemctl disable "medusa@${MASTER}" 2>/dev/null || true
  systemctl stop "medusa@${MASTER}" 2>/dev/null || true
  
  sudo rm -rf /var/run/medusa > /dev/null 2>&1
  sudo rm -f /etc/apache2/sites-enabled/medusa.conf > /dev/null 2>&1
  sudo rm -f /etc/systemd/medusa@.service > /dev/null 2>&1
  sudo rm -f /install/.medusa.lock
  service apache2 reload 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true

  cd "/home/${MASTER}"
  sudo rm -rf .medusa

  echo -n "Verifying Medusa removal from /home/${MASTER} directory"
  echo ""
  ls -al
  echo ""
  echo ""
  echo "Medusa Uninstall Complete. You may reinstall at any time by running [installpackage-medusa]."
}

_removeMedusa
