#!/bin/bash
#
# [AetherFlow :: Remove homeassistant]
#
source /opt/AetherFlow/packages/common.sh
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [remove-homeassistant] $1" | tee -a "$LOGFILE"; }

log "Stopping homeassistant..."
systemctl stop home-assistant@homeassistant 2>/dev/null || true
systemctl disable home-assistant@homeassistant 2>/dev/null || true

log "Removing homeassistant files and configuration..."
rm -rf /home/homeassistant /etc/systemd/system/home-assistant@homeassistant.service /etc/apache2/sites-enabled/homeassistant.conf
userdel homeassistant 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true
service apache2 reload 2>/dev/null || true
rm -f /install/.homeassistant.lock

log "homeassistant has been completely removed."