#!/bin/bash
# AetherFlow Package Uninstaller: Home Assistant

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="homeassistant"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing home-assistant@homeassistant.service..."

purge_systemd_unit "home-assistant@homeassistant"

report_progress 65 "Removing Home Assistant virtualenv, config, and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf "/var/lib/homeassistant" "/srv/homeassistant" "/home/homeassistant"
    purge_system_user "homeassistant"
else
    safe_rm_rf /srv/homeassistant/{bin,lib,lib64,include,share}
    rm -f /srv/homeassistant/pyvenv.cfg /srv/homeassistant/.af-version
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Home Assistant removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
