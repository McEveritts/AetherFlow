#!/bin/bash
#
# [AetherFlow Remove Script - Dispatcharr]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="dispatcharr"
APP_NAME="dispatcharr"
APP_USER="dispatcharr"
INSTALL_DIR="/opt/dispatcharr"
DATA_DIR="/var/lib/dispatcharr"
CONFIG_DIR="/etc/dispatcharr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 15 "Stopping ${APP_NAME} services..."

purge_systemd_unit "dispatcharr-celerybeat"
purge_systemd_unit "dispatcharr-celery"
purge_systemd_unit "dispatcharr"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

report_progress 55 "Removing ${APP_NAME} runtime files..."
rm -rf "${INSTALL_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${CONFIG_DIR}, ${DATA_DIR}, and PostgreSQL database..."
    # Only unlink our compatibility path, and do so before deleting its target.
    # An unrelated symlink or a real /data directory may belong to other apps.
    if [[ -L /data && "$(readlink -f /data)" == "${DATA_DIR}" ]]; then
        rm -f /data
    elif [[ -d /data && ! -L /data ]]; then
        for sub in logos recordings uploads m3us epgs plugins backups logs cache; do
            rm -rf -- "/data/${sub}"
        done
        rmdir /data 2>/dev/null || true
    fi
    rm -rf "${CONFIG_DIR}" "${DATA_DIR}"
    su - postgres -c "psql -c 'DROP DATABASE IF EXISTS dispatcharr;'" >> "$LOGFILE" 2>&1 || true
    su - postgres -c "psql -c 'DROP USER IF EXISTS dispatcharr;'" >> "$LOGFILE" 2>&1 || true
fi

purge_system_user "${APP_USER}"

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
