#!/bin/bash
# AetherFlow Package Uninstaller: ruTorrent

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rutorrent"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Disabling Apache ruTorrent site..."

a2dissite rutorrent.conf >> "$LOGFILE" 2>&1 || true
rm -f /etc/apache2/sites-available/rutorrent.conf /etc/apache2/sites-enabled/rutorrent.conf
remove_apache_app_listener "$PACKAGE_NAME"

# Detach this application before any data or database removal.
apache2ctl configtest >> "$LOGFILE" 2>&1
systemctl reload apache2 >> "$LOGFILE" 2>&1

report_progress 65 "Removing ruTorrent web directory and symlinks..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/rutorrent /var/www/rutorrent /srv/rutorrent
    purge_app_archive_backups "${PACKAGE_NAME}" "/var/www/rutorrent"
    rm -f /etc/apache2/AetherFlow/rutorrent.htpasswd
else
    for webroot in /var/www/rutorrent /srv/rutorrent; do
        [[ -d "$webroot" && ! -L "$webroot" ]] || continue
        while IFS= read -r -d '' runtime_path; do
            safe_rm_rf "$runtime_path"
        done < <(find "$webroot" -mindepth 1 -maxdepth 1 ! -name share ! -name conf ! -name plugins -print0)
    done
    if [[ -L /srv/rutorrent ]]; then rm -f /srv/rutorrent; fi
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "ruTorrent removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
