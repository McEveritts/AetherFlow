#!/bin/bash
# AetherFlow Package Uninstaller: ruTorrent

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="rutorrent"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Disabling Apache ruTorrent site..."

a2dissite rutorrent.conf >> "$LOGFILE" 2>&1 || true
rm -f /etc/apache2/sites-available/rutorrent.conf /etc/apache2/sites-enabled/rutorrent.conf
if [[ -f /etc/apache2/ports.conf ]]; then
    sed -i '/^Listen 8087$/d' /etc/apache2/ports.conf || true
fi

report_progress 65 "Removing ruTorrent web directory and symlinks..."
rm -rf /var/www/rutorrent /srv/rutorrent
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true
systemctl reload apache2 >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "ruTorrent completely removed."
log_info "${PACKAGE_NAME} removed successfully"
