#!/bin/bash
# AetherFlow Package Uninstaller: Threadfin

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="threadfin"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing threadfin.service..."

purge_systemd_unit "threadfin"

report_progress 65 "Removing Threadfin binary, state directories, and user account..."
rm -f /usr/local/bin/threadfin
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/usr/local/bin/threadfin"
    safe_rm_rf /var/lib/threadfin
    purge_system_user "threadfin"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

rm -f -- /var/lib/threadfin/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Threadfin removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
