#!/bin/bash
#
# [Quick Box :: Remove couchpotato package]
#
source /opt/AetherFlow/packages/common.sh
# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"

systemctl disable couchpotato@* 2>/dev/null || true
systemctl stop couchpotato@* 2>/dev/null || true
rm -f /etc/systemd/system/couchpotato@.service
systemctl daemon-reload 2>/dev/null || true

if [[ -f /etc/init.d/couchpotato ]]; then
  service couchpotato stop 2>/dev/null || true
  rm -f /etc/init.d/couchpotato
  rm -f /etc/default/couchpotato
fi

rm -rf "/home/${MASTER}/.couchpotato"
rm -f /etc/apache2/sites-enabled/couchpotato.conf
service apache2 reload 2>/dev/null || true
rm -f /install/.couchpotato.lock
