#!/bin/bash
# AetherFlow Package Uninstaller: Uptime Kuma

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="uptimekuma"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing uptime-kuma.service..."

purge_systemd_unit "uptime-kuma"

report_progress 65 "Removing Uptime Kuma directory and user account..."
rm -rf /opt/uptime-kuma
purge_system_user "uptimekuma"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Uptime Kuma completely removed."
log_info "${PACKAGE_NAME} removed successfully"