#!/bin/bash
# AetherFlow Package Uninstaller: Uptime Kuma

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="uptimekuma"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing uptime-kuma.service..."

purge_systemd_unit "uptime-kuma"

report_progress 65 "Removing Uptime Kuma directory and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "uptime-kuma" "/opt/uptime-kuma"
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/uptime-kuma"
    safe_rm_rf /opt/uptime-kuma /var/lib/uptimekuma
    purge_system_user "uptimekuma"
else
    safe_rm_rf /opt/uptime-kuma/{.git,.runtime,node_modules,dist,server,src,public,extra}
    rm -f /opt/uptime-kuma/{.af-version,package.json,package-lock.json,yarn.lock,pnpm-lock.yaml}
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Uptime Kuma removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
