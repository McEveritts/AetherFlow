#!/bin/bash
source /opt/AetherFlow/packages/common.sh
# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"
username="$MASTER"

apt -y remove par2-tbb python-openssl python-sabyenc python-cheetah >/dev/null 2>&1 || true
rm -rf "/home/$username/SABnzbd"

systemctl disable "sabnzbd@$username" 2>/dev/null || true
systemctl stop "sabnzbd@$username" 2>/dev/null || true
rm -f /etc/systemd/system/sabnzbd@.service
systemctl daemon-reload 2>/dev/null || true

rm -f /etc/apache2/sites-enabled/sabnzbd.conf
rm -f /install/.sabnzbd.lock
service apache2 reload 2>/dev/null || true
