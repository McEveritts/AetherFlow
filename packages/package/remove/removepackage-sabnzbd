#!/bin/bash
# AetherFlow Package Uninstaller: SABnzbd

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="sabnzbd"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing sabnzbd.service..."

purge_systemd_unit "sabnzbd"
purge_systemd_unit "sabnzbdplus"

report_progress 65 "Removing SABnzbd files, state directories, and user account..."
rm -rf /opt/SABnzbd /var/lib/sabnzbd /etc/default/sabnzbdplus
purge_system_user "sabnzbd"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "SABnzbd completely removed."
log_info "${PACKAGE_NAME} removed successfully"
