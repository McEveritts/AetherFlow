#!/bin/bash
#
# [Quick Box :: Remove nzbhydra package]
#
source /opt/AetherFlow/packages/common.sh
# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"

systemctl stop "nzbhydra@${MASTER}" 2>/dev/null || true
systemctl disable "nzbhydra@${MASTER}" 2>/dev/null || true
rm -f /etc/systemd/system/nzbhydra@.service
systemctl daemon-reload 2>/dev/null || true

if [[ -f /etc/init.d/nzbhydra ]]; then
  service nzbhydra stop 2>/dev/null || true
  rm -f /etc/init.d/nzbhydra
  rm -f /etc/default/nzbhydra
fi

rm -rf "/home/${MASTER}/nzbhydra"
rm -f /etc/apache2/sites-enabled/nzbhydra.conf
rm -f /install/.nzbhydra.lock
service apache2 reload 2>/dev/null || true

echo -n "Verifying nzbhydra removal from /home/$MASTER."
echo ""
echo "NZBhydra Uninstall Complete. App data is not removed. To remove run the following command: rm -rf /home/$MASTER/.nzbhyra."
echo ""
echo "You may reinstall at any time by running [installpackage-nzbhydra]."
