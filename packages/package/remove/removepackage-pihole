#!/bin/bash
# AetherFlow Package Uninstaller: Pi-hole

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="pihole"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local lock_fd="" rc=0
        exec {lock_fd}>>"$target" || return 1
        flock -s "$lock_fd" || { exec {lock_fd}>&-; return 1; }
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        flock -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping Pi-hole FTL service..."

purge_systemd_unit "pihole-FTL"

report_progress 50 "Running Pi-hole uninstaller and cleaning directories..."
if [[ "${DELETE_DATA:-false}" == true ]] && command_exists pihole; then
    af_logged pihole uninstall -f || true
fi

safe_rm_rf /var/log/pihole
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/pihole /etc/pihole /opt/pihole /var/www/html/admin /var/www/html/pihole /etc/.pihole
    rm -f /etc/lighttpd/external.conf /etc/lighttpd/conf-enabled/99-pihole-port.conf
fi
rm -f /usr/local/bin/pihole /usr/bin/pihole-FTL /etc/dnsmasq.d/01-pihole.conf
rm -f /etc/systemd/resolved.conf.d/pihole.conf

report_progress 80 "Removing pihole user and reloading services..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_system_user "pihole"
fi
if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
    af_logged systemctl restart systemd-resolved || true
fi
af_logged systemctl daemon-reload

rm -f -- /etc/pihole/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Pi-hole removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
