#!/bin/bash
# AetherFlow Package Uninstaller: Pi-hole

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="pihole"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping Pi-hole FTL service..."

purge_systemd_unit "pihole-FTL"

report_progress 50 "Running Pi-hole uninstaller and cleaning directories..."
if [[ "${DELETE_DATA:-false}" == true ]] && command_exists pihole; then
    pihole uninstall -f >> "$LOGFILE" 2>&1 || true
fi

rm -rf /var/log/pihole
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /etc/pihole /opt/pihole /var/www/html/admin /var/www/html/pihole /etc/.pihole
fi
rm -f /usr/local/bin/pihole /usr/bin/pihole-FTL /etc/dnsmasq.d/01-pihole.conf
rm -f /etc/lighttpd/external.conf /etc/lighttpd/conf-enabled/99-pihole-port.conf
rm -f /etc/systemd/resolved.conf.d/pihole.conf

report_progress 80 "Removing pihole user and reloading services..."
purge_system_user "pihole"
if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
    systemctl restart systemd-resolved >> "$LOGFILE" 2>&1 || true
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Pi-hole removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
