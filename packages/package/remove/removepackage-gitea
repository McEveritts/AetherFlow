#!/bin/bash
#
# [AetherFlow :: Remove gitea]
#
source /opt/AetherFlow/packages/common.sh
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [remove-gitea] $1" | tee -a "$LOGFILE"; }

log "Stopping gitea..."
systemctl stop gitea 2>/dev/null || true
systemctl disable gitea 2>/dev/null || true

log "Removing gitea files and configuration..."
rm -rf /var/lib/gitea /etc/gitea /usr/local/bin/gitea /etc/systemd/system/gitea.service /etc/apache2/sites-enabled/gitea.conf
userdel gitea 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true
service apache2 reload 2>/dev/null || true
rm -f /install/.gitea.lock

log "gitea has been completely removed."