#!/bin/bash
# AetherFlow Package Uninstaller: WireGuard

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="wireguard"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling wg-quick@wg0 service..."

purge_systemd_unit "wg-quick@wg0"

report_progress 50 "Purging WireGuard APT packages..."
DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq wireguard wireguard-tools >> "$LOGFILE" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1 || true

report_progress 80 "Removing WireGuard keys, configuration, and sysctl rules..."
rm -rf /etc/wireguard /etc/sysctl.d/99-wireguard.conf
sysctl --system >> "$LOGFILE" 2>&1 || true
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "WireGuard completely removed."
log_info "${PACKAGE_NAME} removed successfully"