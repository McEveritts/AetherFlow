#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
export LOGFILE="/var/log/aetherflow/remove-kasmvnc.log"
trap 'print_error "KasmVNC removal failed; see ${LOGFILE}."' ERR
report_progress 20 "Stopping KasmVNC..."
purge_systemd_unit af-kasmvnc.service
systemctl daemon-reload
report_progress 60 "Removing KasmVNC; keeping shared desktop dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get remove -y kasmvncserver >> "$LOGFILE" 2>&1
if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    rm -rf /var/lib/kasmvnc /etc/kasmvnc
fi
remove_lock kasmvnc
report_progress 100 "KasmVNC removed."
