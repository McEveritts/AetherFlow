#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
export LOGFILE="/var/log/aetherflow/remove-kasmvnc.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local lock_fd="" rc=0
        exec {lock_fd}>>"$target" || return 1
        flock -s "$lock_fd" || { exec {lock_fd}>&-; return 1; }
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        flock -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi
trap 'print_error "KasmVNC removal failed; see ${LOGFILE}."' ERR
report_progress 20 "Stopping KasmVNC..."
purge_systemd_unit af-kasmvnc.service
systemctl daemon-reload
report_progress 60 "Removing KasmVNC; keeping shared desktop dependencies..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get remove -y kasmvncserver
if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    safe_rm_rf /var/lib/kasmvnc /etc/kasmvnc
    purge_system_user "af-kasmvnc"
fi
rm -f /var/lib/kasmvnc/.af-version
remove_lock kasmvnc
report_progress 100 "KasmVNC removed."
