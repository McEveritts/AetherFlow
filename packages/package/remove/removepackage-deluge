#!/bin/bash
# AetherFlow Package Uninstaller: Deluge

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="deluge"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and removing deluged and deluge-web services..."

purge_systemd_unit "deluge-web"
purge_systemd_unit "deluged"

report_progress 50 "Purging Deluge APT packages..."
DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq deluged deluge-web deluge-console deluge-common >> "$LOGFILE" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1 || true

report_progress 80 "Removing Deluge configuration, logs, and user account..."
rm -rf /var/lib/deluge /var/log/deluge /etc/default/deluged
purge_system_user "deluge"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Deluge completely removed."
log_info "${PACKAGE_NAME} removed successfully"