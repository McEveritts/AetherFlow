#!/bin/bash
# AetherFlow Package Uninstaller: Syncthing

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="syncthing"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
APT_REMOVE_ACTION=remove
if [[ "${DELETE_DATA:-false}" == true ]]; then APT_REMOVE_ACTION=purge; fi
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and removing syncthing.service..."

purge_systemd_unit "syncthing"

report_progress 50 "Purging Syncthing APT package and repository..."
DEBIAN_FRONTEND=noninteractive apt-get "$APT_REMOVE_ACTION" -y -qq syncthing >> "$LOGFILE" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1 || true
rm -f /etc/apt/sources.list.d/syncthing.list /etc/apt/keyrings/syncthing-archive-keyring.gpg

report_progress 80 "Removing Syncthing state directory and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/syncthing
fi
purge_system_user "syncthing"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Syncthing removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
