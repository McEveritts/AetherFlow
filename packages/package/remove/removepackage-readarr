#!/bin/bash
# AetherFlow Package Uninstaller: Readarr

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="readarr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing readarr.service..."

purge_systemd_unit "readarr"

report_progress 65 "Removing Readarr binaries, state directories, and user account..."
rm -rf /opt/Readarr /var/lib/readarr
purge_system_user "readarr"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Readarr completely removed."
log_info "${PACKAGE_NAME} removed successfully"