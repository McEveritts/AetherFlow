#!/bin/bash
#
# [AetherFlow Remove Script - noVNC]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="novnc"
APP_NAME="novnc"
APP_USER="novnc"
DATA_DIR="/var/lib/novnc"
CONFIG_DIR="/etc/novnc"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} services..."

purge_systemd_unit "novnc"
purge_systemd_unit "novnc-xvnc"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

report_progress 60 "Removing ${APP_NAME} packages..."
DEBIAN_FRONTEND=noninteractive apt-get remove -y novnc python3-websockify >> "$LOGFILE" 2>&1 || true

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${CONFIG_DIR} and ${DATA_DIR}..."
    rm -rf "${CONFIG_DIR}" "${DATA_DIR}"
fi

purge_system_user "${APP_USER}"

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
