#!/bin/bash
#
# [AetherFlow Remove Script - noVNC]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="novnc"
DATA_DIR="/var/lib/novnc"
CONFIG_DIR="/etc/novnc"
LOCK_FILE="/install/.novnc.lock"

setup_log "${APP_NAME}-remove"
log "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} services..."

stop_disable_service "novnc.service"
stop_disable_service "novnc-xvnc.service"
rm -f /etc/systemd/system/novnc.service /etc/systemd/system/novnc-xvnc.service
systemctl daemon-reload

report_progress 60 "Removing ${APP_NAME} packages..."
apt-get remove -y novnc python3-websockify >> "${LOG_FILE}" 2>&1 || true
rm -rf "${CONFIG_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log "DELETE_DATA=true: Purging ${DATA_DIR}..."
    rm -rf "${DATA_DIR}"
fi

remove_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} removed"
log "${APP_NAME} removal complete."
