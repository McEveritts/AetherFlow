#!/bin/bash
# AetherFlow Package Uninstaller: n8n

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="n8n"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing n8n.service..."

purge_systemd_unit "n8n"

report_progress 65 "Uninstalling npm package and removing state directories..."
npm uninstall -g n8n >> "$LOGFILE" 2>&1 || true
rm -rf /var/lib/n8n /opt/n8n
purge_system_user "n8n"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "n8n completely removed."
log_info "${PACKAGE_NAME} removed successfully"
