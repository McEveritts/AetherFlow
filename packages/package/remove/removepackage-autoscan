#!/bin/bash
# AetherFlow Package Uninstaller: Autoscan

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="autoscan"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing autoscan.service..."

purge_systemd_unit "autoscan"

report_progress 65 "Removing Autoscan binary, configurations, and state directories..."
rm -f /usr/local/bin/autoscan
rm -rf /etc/autoscan /var/lib/autoscan /opt/autoscan
purge_system_user "autoscan"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Autoscan completely removed."
log_info "${PACKAGE_NAME} removed successfully"
