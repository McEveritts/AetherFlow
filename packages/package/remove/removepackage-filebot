#!/bin/bash
#
# [AetherFlow Remove Script - FileBot]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

PACKAGE_NAME="filebot"
APP_NAME="filebot"
APP_USER="filebot"
FB_DIR="/opt/filebot"
NODE_DIR="/opt/filebot-node"
DATA_DIR="/var/lib/filebot"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

purge_systemd_unit "filebot"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

report_progress 60 "Removing ${APP_NAME} binaries..."
rm -f /usr/local/bin/filebot
rm -rf "${FB_DIR}" "${NODE_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${DATA_DIR}..."
    rm -rf "${DATA_DIR}"
fi

purge_system_user "${APP_USER}"

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
