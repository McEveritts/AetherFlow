#!/bin/bash
#
# [AetherFlow Remove Script - FileBot]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="filebot"
FB_DIR="/opt/filebot"
NODE_DIR="/opt/filebot-node"
DATA_DIR="/var/lib/filebot"
LOCK_FILE="/install/.filebot.lock"

setup_log "${APP_NAME}-remove"
log "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

stop_disable_service "filebot.service"
rm -f /etc/systemd/system/filebot.service
systemctl daemon-reload

report_progress 60 "Removing ${APP_NAME} binaries..."
rm -f /usr/local/bin/filebot
rm -rf "${FB_DIR}" "${NODE_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log "DELETE_DATA=true: Purging ${DATA_DIR}..."
    rm -rf "${DATA_DIR}"
fi

remove_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} removed"
log "${APP_NAME} removal complete."
