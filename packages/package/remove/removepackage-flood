#!/bin/bash
# AetherFlow Package Uninstaller: Flood

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="flood"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
if ! declare -F af_logged_stderr >/dev/null 2>&1; then
    af_logged_stderr() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" 2>/dev/null; else "$@" 2>>"$target"; fi; }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing flood.service..."

purge_systemd_unit "flood"

if command_exists pm2; then
    PM2_APP_PRESENT="$(af_logged_stderr pm2 jlist | python3 -c 'import json,sys; processes=json.load(sys.stdin); print(int(any(process.get("name") == "flood" for process in processes)))')"
    if [[ "$PM2_APP_PRESENT" == 1 ]]; then
        af_logged pm2 stop flood
        af_logged pm2 delete flood
    fi
    af_logged pm2 save --force
fi

report_progress 60 "Uninstalling Flood npm package and removing data directories..."
af_logged npm uninstall -g @jesec/flood || true
af_logged npm uninstall -g flood || true
if [[ -L /usr/bin/flood ]]; then
    FLOOD_BIN_LINK="$(readlink -- /usr/bin/flood 2>/dev/null || true)"
    FLOOD_BIN_REAL="$(readlink -m -- /usr/bin/flood 2>/dev/null || true)"
    if [[ "$FLOOD_BIN_LINK" == /usr/local/bin/flood || "$FLOOD_BIN_LINK" == /usr/local/nodejs/bin/flood || "$FLOOD_BIN_LINK" == /opt/flood/* || "$FLOOD_BIN_REAL" == /usr/local/bin/flood || "$FLOOD_BIN_REAL" == /usr/local/nodejs/bin/flood || "$FLOOD_BIN_REAL" == /opt/flood/* ]]; then
        rm -f /usr/bin/flood
    fi
fi
rm -f /usr/local/bin/flood /var/lib/flood/.af-version
safe_rm_rf /opt/flood
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/flood"
    safe_rm_rf /var/lib/flood /srv/rutorrent/home/flood /etc/apache2/sites-enabled/flood.conf /etc/apache2/sites-available/flood.conf
    purge_system_user "flood"
fi
af_logged systemctl daemon-reload

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Flood removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
