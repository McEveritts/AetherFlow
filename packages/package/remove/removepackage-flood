#!/bin/bash
# AetherFlow Package Uninstaller: Flood

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="flood"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing flood.service..."

purge_systemd_unit "flood"

report_progress 60 "Uninstalling Flood npm package and removing data directories..."
npm uninstall -g @jesec/flood >> "$LOGFILE" 2>&1 || true
npm uninstall -g flood >> "$LOGFILE" 2>&1 || true
rm -f /usr/bin/flood /usr/local/bin/flood
rm -rf /var/lib/flood /srv/rutorrent/home/flood /etc/apache2/sites-enabled/flood.conf /etc/apache2/sites-available/flood.conf
purge_system_user "flood"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Flood completely removed."
log_info "${PACKAGE_NAME} removed successfully"