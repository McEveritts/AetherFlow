#!/bin/bash
#
# [AetherFlow Remove Script - Quassel]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="quassel"
DATA_DIR="/var/lib/quassel"
LOG_DIR="/var/log/quassel"
LOCK_FILE="/install/.quassel.lock"

setup_log "${APP_NAME}-remove"
log "Removing ${APP_NAME}..."
report_progress 20 "Stopping quasselcore service..."

stop_disable_service "quasselcore.service"
systemctl daemon-reload

report_progress 60 "Removing quassel-core package..."
apt-get remove -y quassel-core >> "${LOG_FILE}" 2>&1 || true
rm -f "${DATA_DIR}/.af-version"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log "DELETE_DATA=true: Purging ${DATA_DIR} and ${LOG_DIR}..."
    rm -rf "${DATA_DIR}" "${LOG_DIR}"
fi

remove_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} removed"
log "${APP_NAME} removal complete."
