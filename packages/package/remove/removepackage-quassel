#!/bin/bash
#
# [AetherFlow Remove Script - Quassel]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="quassel"
APP_NAME="quassel"
DATA_DIR="/var/lib/quassel"
LOG_DIR="/var/log/quassel"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping quasselcore service..."

purge_systemd_unit "quasselcore"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

report_progress 60 "Removing quassel-core package..."
DEBIAN_FRONTEND=noninteractive apt-get remove -y quassel-core >> "$LOGFILE" 2>&1 || true
rm -f "${DATA_DIR}/.af-version" /etc/default/quasselcore

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${DATA_DIR} and ${LOG_DIR}..."
    rm -rf "${DATA_DIR}" "${LOG_DIR}"
    purge_system_user "quasselcore"
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
