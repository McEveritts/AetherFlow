#!/bin/bash
source /opt/AetherFlow/packages/common.sh

systemctl stop radarr 2>/dev/null || true
systemctl disable radarr 2>/dev/null || true
rm -f /etc/systemd/system/radarr.service
systemctl daemon-reload 2>/dev/null || true

rm -rf /opt/Radarr
rm -f /etc/apache2/sites-enabled/radarr.conf

if [[ -f /install/.jackett.lock ]]; then
    for list in /etc/apt/sources.list.d/mono-*; do
        if [[ -f $list ]]; then
            rm -f "/etc/apt/sources.list.d/mono-*"
            sudo apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys 3FA7E0328081BFF6A14DA29AA6A19B38D3D831EF
            echo "deb http://download.mono-project.com/repo/ubuntu stable-xenial main" | sudo tee /etc/apt/sources.list.d/mono-official-stable.list
            break
        fi
    done
fi

if [[ -f /install/.lidarr.lock ]]; then
    for list in /etc/apt/sources.list.d/mono-*; do
        if [[ -f $list ]]; then
            rm -f "/etc/apt/sources.list.d/mono-*"
            sudo apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys 3FA7E0328081BFF6A14DA29AA6A19B38D3D831EF
            echo "deb http://download.mono-project.com/repo/ubuntu stable-xenial main" | sudo tee /etc/apt/sources.list.d/mono-official-stable.list
            break
        fi
    done
fi

if [[ -f /install/.sonarr.lock ]]; then
    for list in /etc/apt/sources.list.d/mono-*; do
        if [[ -f $list ]]; then
            rm -f "/etc/apt/sources.list.d/mono-*"
            sudo apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys 3FA7E0328081BFF6A14DA29AA6A19B38D3D831EF
            echo "deb http://download.mono-project.com/repo/ubuntu stable-xenial main" | sudo tee /etc/apt/sources.list.d/mono-official-stable.list
            break
        fi
    done
fi

rm -f /install/.radarr.lock
apt-get -y autoremove && apt-get -y autoclean
service apache2 reload 2>/dev/null || true
echo "Radarr uninstalled!"
