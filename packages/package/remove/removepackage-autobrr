#!/bin/bash
# AetherFlow Package Uninstaller: Autobrr

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="autobrr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing autobrr.service..."

purge_systemd_unit "autobrr"

report_progress 65 "Removing Autobrr binaries, state directories, and user account..."
rm -f /usr/local/bin/autobrr /usr/local/bin/autobrrctl
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/autobrr
fi
purge_system_user "autobrr"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Autobrr removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
