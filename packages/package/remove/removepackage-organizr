#!/bin/bash
# AetherFlow Package Uninstaller: Organizr

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="organizr"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Disabling Apache Organizr site..."

a2dissite organizr.conf >> "$LOGFILE" 2>&1 || true
rm -f /etc/apache2/sites-available/organizr.conf /etc/apache2/sites-enabled/organizr.conf /etc/apache2/conf-available/organizr.conf /etc/apache2/conf-enabled/organizr.conf
remove_apache_app_listener "$PACKAGE_NAME"

# Detach this application before any data or database removal.
apache2ctl configtest >> "$LOGFILE" 2>&1
systemctl reload apache2 >> "$LOGFILE" 2>&1

report_progress 65 "Removing Organizr webroot and reloading Apache..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf /var/lib/organizr /var/www/organizr
    purge_app_archive_backups "${PACKAGE_NAME}" "/var/www/organizr"
elif [[ -d /var/www/organizr && ! -L /var/www/organizr ]]; then
    safe_rm_rf /var/www/organizr/.git
    find /var/www/organizr \( -path '/var/www/organizr/api/config' -o -path '/var/www/organizr/api/db' \) -prune -o \
        \( -type f -o -type l \) \( -name '*.php' -o -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.map' -o -name '.af-version' -o -name 'composer.json' -o -name 'composer.lock' -o -name 'package.json' -o -name 'package-lock.json' \) -exec rm -f -- {} +
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Organizr removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
