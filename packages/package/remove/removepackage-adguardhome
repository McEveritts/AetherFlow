#!/bin/bash
# AetherFlow Package Uninstaller: AdGuard Home

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="adguardhome"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing adguardhome.service..."

purge_systemd_unit "adguardhome"

report_progress 65 "Removing AdGuard Home binaries, configurations, and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    safe_rm_rf "/var/lib/adguardhome"
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/AdGuardHome"
    safe_rm_rf /opt/AdGuardHome
    purge_system_user "adguardhome"
else
    rm -f /opt/AdGuardHome/AdGuardHome /opt/AdGuardHome/.af-version
fi

if [[ -e /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf || -L /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf ]]; then
    validate_config_paths /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf
    rm -f -- /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf
    systemctl restart systemd-resolved >> "$LOGFILE" 2>&1
fi

systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "AdGuard Home removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
