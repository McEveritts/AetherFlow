#!/bin/bash
# AetherFlow Package Uninstaller: Qui

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="qui"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing qui.service..."

purge_systemd_unit "qui"

report_progress 65 "Removing Qui binary, state directories, and user account..."
rm -f /usr/local/bin/qui
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/usr/local/bin/qui"
    safe_rm_rf /var/lib/qui
    purge_system_user "qui"
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

rm -f -- /var/lib/qui/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Qui removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
