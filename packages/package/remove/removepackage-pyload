#!/bin/bash
#
# [Quick Box :: Remove pyload package]
#
source /opt/AetherFlow/packages/common.sh

function _removepyLoad() {
  systemctl stop "pyload@${MASTER}.service" 2>/dev/null || true
  systemctl disable "pyload@${MASTER}.service" 2>/dev/null || true
  rm -f /etc/systemd/system/pyload@.service
  systemctl daemon-reload 2>/dev/null || true

  rm -rf "/home/${MASTER}/.pip"
  rm -rf "/home/${MASTER}/.pyload"
  rm -rf /var/run/pyload
  rm -f /etc/apache2/sites-enabled/pyload.conf
  
  apt-get -y remove tesseract-ocr \
                    gocr \
                    rhino \
                    pyqt4-dev-tools \
                    python-imaging || true
                    
  apt -y autoremove >/dev/null 2>&1 || true
  apt -y autoclean >/dev/null 2>&1 || true
  rm -f /install/.pyload.lock
  service apache2 reload 2>/dev/null || true
}

# LEGACY REMOVED: master.txt
MASTER="$AETHERFLOW_USER"

_removepyLoad
