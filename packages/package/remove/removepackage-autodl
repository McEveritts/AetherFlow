#!/bin/bash
#
# [Quick Box :: Remove AutoDL-IRSSI package]
#
source /opt/AetherFlow/packages/common.sh

function _removepackage-autodl() {
  username=$(whoami);
  users=($(cat /etc/htpasswd | cut -d ":" -f 1))
  PLUGIN="autodl-irssi"
    for i in $PLUGIN; do
      rm -rf "${rutorrent}/plugins/$i"
    done
    systemctl stop irssi@* 2>/dev/null || true
    systemctl disable irssi@* 2>/dev/null || true
    rm -f /etc/systemd/system/irssi@.service
    systemctl daemon-reload 2>/dev/null || true

    for u in "${users[@]}"; do
      rm -rf "/home/${u}/.autodl"
      rm -rf "/home/${u}/.irssi"
    done
    rm -f /install/.autodlirssi.lock
}

_removepackage-autodl
