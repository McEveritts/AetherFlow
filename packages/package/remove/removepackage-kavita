#!/bin/bash
# AetherFlow Package Uninstaller: Kavita

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="kavita"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing kavita.service..."

purge_systemd_unit "kavita"

report_progress 65 "Removing Kavita binaries, libraries, and user account..."
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "${PACKAGE_NAME}" "/opt/Kavita"
    safe_rm_rf /opt/Kavita /var/lib/kavita
    purge_system_user "kavita"
else
    rm -f /opt/Kavita/{Kavita,Kavita.dll,Kavita.deps.json,Kavita.runtimeconfig.json,.af-version} /opt/Kavita/*.dll /opt/Kavita/*.so /opt/Kavita/*.pdb
    safe_rm_rf /opt/Kavita/{wwwroot,runtimes,ref}
fi
systemctl daemon-reload >> "$LOGFILE" 2>&1

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Kavita removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
