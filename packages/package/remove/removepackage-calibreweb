#!/bin/bash
# AetherFlow Package Uninstaller: Calibre-Web

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="calibreweb"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 25 "Stopping and removing calibreweb.service..."

purge_systemd_unit "calibreweb"

report_progress 65 "Removing Calibre-Web virtualenv, app directory, and user account..."
rm -rf /opt/calibre-web
if [[ "${DELETE_DATA:-false}" == true ]]; then
    rm -rf /var/lib/calibre-web /var/lib/calibre-library
fi
purge_system_user "calibreweb"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Calibre-Web removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
