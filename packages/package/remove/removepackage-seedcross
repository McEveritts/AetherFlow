#!/bin/bash
#
# [AetherFlow Remove Script - SeedCross]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="seedcross"
APP_NAME="seedcross"
APP_USER="seedcross"
INSTALL_DIR="/opt/seedcross"
DATA_DIR="/var/lib/seedcross"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

purge_systemd_unit "seedcross"
af_logged systemctl daemon-reload

report_progress 60 "Removing ${APP_NAME} runtime files..."
if [[ "${DELETE_DATA:-false}" != true ]]; then
    retain_app_data_directory "$INSTALL_DIR/db" "$DATA_DIR/db"
    if [[ -f "$INSTALL_DIR/csui/settings.py" ]]; then
        cp -a "$INSTALL_DIR/csui/settings.py" "$DATA_DIR/legacy-settings.py"
        chmod 640 "$DATA_DIR/legacy-settings.py"
    fi
fi
safe_rm_rf "${INSTALL_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${DATA_DIR}..."
    safe_rm_rf "/var/lib/seedcross"
    purge_app_archive_backups "$PACKAGE_NAME" "$INSTALL_DIR"
fi

if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_system_user "${APP_USER}"
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
