#!/bin/bash
# AetherFlow Package Uninstaller: Rclone

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="rclone"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and unmounting rclone-vfs.service..."

purge_systemd_unit "rclone-vfs"
if mountpoint -q /mnt/remote 2>/dev/null; then
    fusermount -uz /mnt/remote >> "$LOGFILE" 2>&1 || true
fi

report_progress 50 "Stopping and removing rclone.service..."
purge_systemd_unit "rclone"

report_progress 75 "Removing rclone binary, state directories, and user account..."
rm -f /usr/bin/rclone
rm -rf /etc/rclone /var/lib/rclone
purge_system_user "rclone"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Rclone completely removed."
log_info "${PACKAGE_NAME} removed successfully"
