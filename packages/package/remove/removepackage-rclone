#!/bin/bash
# AetherFlow Package Uninstaller: Rclone

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rclone"
RCLONE_BIN="/opt/AetherFlow/apps/rclone/rclone"
RCLONE_OWNER="${RCLONE_BIN%/*}/.af-owner"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and unmounting rclone-vfs.service..."

purge_systemd_unit "rclone-vfs" "rclone"
if mountpoint -q /mnt/remote 2>/dev/null; then
    af_logged fusermount -uz /mnt/remote || true
    if [[ "${DELETE_DATA:-false}" == true ]] && mountpoint -q /mnt/remote; then
        print_error "Rclone mount at /mnt/remote is still active"
        exit 1
    fi
fi

report_progress 75 "Removing the AetherFlow Rclone runtime..."
validate_config_paths "$RCLONE_OWNER" /var/lib/rclone/.af-version
if [[ -f "$RCLONE_OWNER" && "$(cat -- "$RCLONE_OWNER")" == "$PACKAGE_NAME" ]]; then
    rm -f -- "$RCLONE_BIN" "$RCLONE_OWNER"
fi
if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_app_archive_backups "$PACKAGE_NAME" "$RCLONE_BIN" require-owner
    purge_app_archive_backups "$PACKAGE_NAME" /usr/bin/rclone require-owner
    validate_config_paths /etc/aetherflow/rclone.env /etc/rclone/rclone.env /etc/rclone/rclone.conf
    rm -f -- /etc/aetherflow/rclone.env /etc/rclone/rclone.env /etc/rclone/rclone.conf
    safe_rm_rf /var/lib/rclone
    purge_system_user "rclone" --keep-home
fi
af_logged systemctl daemon-reload

rm -f -- /var/lib/rclone/.af-version
remove_lock "${PACKAGE_NAME}"
report_progress 100 "Rclone removed; application data retained unless DELETE_DATA=true."
log_info "${PACKAGE_NAME} removed successfully"
