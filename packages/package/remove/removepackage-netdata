#!/bin/bash
# AetherFlow Package Uninstaller: Netdata

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="netdata"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

require_root
log_info "Starting removal for ${PACKAGE_NAME}..."
report_progress 20 "Stopping and disabling netdata.service..."

purge_systemd_unit "netdata"

report_progress 50 "Uninstalling Netdata packages..."
if [[ -x /usr/libexec/netdata/netdata-uninstaller.sh ]]; then
    /usr/libexec/netdata/netdata-uninstaller.sh --yes --force >> "$LOGFILE" 2>&1 || true
fi
DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq "netdata*" >> "$LOGFILE" 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq >> "$LOGFILE" 2>&1 || true
rm -f /etc/apt/sources.list.d/netdata*.list /usr/share/keyrings/netdata*.gpg

report_progress 80 "Removing Netdata directories and user account..."
rm -rf /etc/netdata /var/lib/netdata /var/cache/netdata /var/log/netdata /usr/lib/netdata /usr/share/netdata /opt/netdata
purge_system_user "netdata"
systemctl daemon-reload >> "$LOGFILE" 2>&1 || true

remove_lock "${PACKAGE_NAME}"
report_progress 100 "Netdata completely removed."
log_info "${PACKAGE_NAME} removed successfully"