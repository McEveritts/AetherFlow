#!/bin/bash
#
# [AetherFlow Remove Script - Unmanic]
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="unmanic"
APP_NAME="unmanic"
APP_USER="unmanic"
INSTALL_DIR="/opt/unmanic"
DATA_DIR="/var/lib/unmanic"
export LOGFILE="/var/log/aetherflow/remove-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"

log_info "Removing ${APP_NAME}..."
report_progress 20 "Stopping ${APP_NAME} service..."

purge_systemd_unit "unmanic"
systemctl daemon-reload >> "$LOGFILE" 2>&1

report_progress 60 "Removing ${APP_NAME} virtualenv..."
safe_rm_rf "${INSTALL_DIR}"

if [[ "${DELETE_DATA:-false}" == "true" ]]; then
    log_info "DELETE_DATA=true: Purging ${DATA_DIR}..."
    safe_rm_rf "/var/lib/unmanic"
fi

if [[ "${DELETE_DATA:-false}" == true ]]; then
    purge_system_user "${APP_USER}"
fi

remove_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} removed"
log_info "${PACKAGE_NAME} removed successfully"
