#!/bin/bash
# AetherFlow Package Installer: Nextcloud
# Port: 8088 (and Apache /nextcloud alias)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="nextcloud"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /opt/AetherFlow/logs

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Apache, MariaDB, and PHP extensions for Nextcloud..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    apache2 mariadb-server libapache2-mod-php \
    php php-cli php-mysql php-gd php-curl php-zip php-xml php-mbstring php-intl php-bcmath php-gmp \
    unzip curl openssl ca-certificates >> "$LOGFILE" 2>&1

systemctl enable --now mariadb >> "$LOGFILE" 2>&1
systemctl enable --now apache2 >> "$LOGFILE" 2>&1

report_progress 30 "Provisioning MariaDB database for Nextcloud..."
DB_PASS="$(openssl rand -hex 16)"
ADMIN_USER="admin"
ADMIN_PASS="$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9' | head -c 14)"

mysql -u root <<EOF >> "$LOGFILE" 2>&1
CREATE DATABASE IF NOT EXISTS nextcloud CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS 'nextclouduser'@'localhost' IDENTIFIED BY '${DB_PASS}';
ALTER USER 'nextclouduser'@'localhost' IDENTIFIED BY '${DB_PASS}';
GRANT ALL PRIVILEGES ON nextcloud.* TO 'nextclouduser'@'localhost';
FLUSH PRIVILEGES;
EOF

report_progress 50 "Downloading and extracting latest Nextcloud Server..."
TMP_ZIP=$(mktemp /tmp/nextcloud-XXXXXX.zip)
curl -fsSL "https://download.nextcloud.com/server/releases/latest.zip" -o "$TMP_ZIP" >> "$LOGFILE" 2>&1
rm -rf /var/www/nextcloud /var/lib/nextcloud/data
mkdir -p /var/www /var/lib/nextcloud/data
unzip -qo "$TMP_ZIP" -d /var/www >> "$LOGFILE" 2>&1
rm -f "$TMP_ZIP"

chown -R www-data:www-data /var/www/nextcloud /var/lib/nextcloud

report_progress 75 "Running unattended Nextcloud initialization..."
sudo -u www-data php /var/www/nextcloud/occ maintenance:install \
    --database "mysql" \
    --database-name "nextcloud" \
    --database-user "nextclouduser" \
    --database-pass "${DB_PASS}" \
    --admin-user "${ADMIN_USER}" \
    --admin-pass "${ADMIN_PASS}" \
    --data-dir "/var/lib/nextcloud/data" >> "$LOGFILE" 2>&1

PRIMARY_IP="$(hostname -I 2>/dev/null | awk '{print $1}' || echo 127.0.0.1)"
sudo -u www-data php /var/www/nextcloud/occ config:system:set trusted_domains 0 --value="localhost" >> "$LOGFILE" 2>&1
sudo -u www-data php /var/www/nextcloud/occ config:system:set trusted_domains 1 --value="127.0.0.1" >> "$LOGFILE" 2>&1
sudo -u www-data php /var/www/nextcloud/occ config:system:set trusted_domains 2 --value="${PRIMARY_IP}" >> "$LOGFILE" 2>&1
sudo -u www-data php /var/www/nextcloud/occ config:system:set trusted_domains 3 --value="$(hostname -f 2>/dev/null || hostname)" >> "$LOGFILE" 2>&1

NC_VER="$(grep -oE "OC_VersionString = '[^']+'" /var/www/nextcloud/version.php 2>/dev/null | cut -d"'" -f2 || true)"
if [[ -n "$NC_VER" ]]; then
    printf '%s\n' "$NC_VER" > /var/www/nextcloud/.af-version
fi

cat <<EOF > /opt/AetherFlow/logs/nextcloud_credentials.txt
Nextcloud Admin User: ${ADMIN_USER}
Nextcloud Admin Pass: ${ADMIN_PASS}
Database Name: nextcloud
Database User: nextclouduser
Database Pass: ${DB_PASS}
EOF
chmod 600 /opt/AetherFlow/logs/nextcloud_credentials.txt

report_progress 90 "Configuring Apache VirtualHost on port 8088..."
if ! grep -q "^Listen 8088$" /etc/apache2/ports.conf 2>/dev/null; then
    echo "Listen 8088" >> /etc/apache2/ports.conf
fi

cat <<'EOF' > /etc/apache2/sites-available/nextcloud.conf
Alias /nextcloud "/var/www/nextcloud/"

<Directory /var/www/nextcloud/>
    Require all granted
    AllowOverride All
    Options FollowSymLinks MultiViews
    <IfModule mod_dav.c>
        Dav off
    </IfModule>
</Directory>

<VirtualHost *:8088>
    DocumentRoot /var/www/nextcloud
    <Directory /var/www/nextcloud/>
        Require all granted
        AllowOverride All
        Options FollowSymLinks MultiViews
        <IfModule mod_dav.c>
            Dav off
        </IfModule>
    </Directory>
</VirtualHost>
EOF

a2enmod rewrite headers env dir mime >> "$LOGFILE" 2>&1
a2ensite nextcloud.conf >> "$LOGFILE" 2>&1
systemctl reload apache2 >> "$LOGFILE" 2>&1 || systemctl restart apache2 >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Nextcloud installed on port 8088."
log_info "${PACKAGE_NAME} installed successfully"
