#!/bin/bash
#
# [AetherFlow Install Script - noVNC]
# Installs noVNC HTML5 WebSocket VNC proxy paired with TigerVNC and XFCE4 desktop.
#
set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
validate_config_paths /var/lib/novnc/.vnc/passwd /var/lib/novnc/.vnc/xstartup

PACKAGE_NAME="novnc"
APP_NAME="novnc"
APP_USER="novnc"
DATA_DIR="/var/lib/novnc"
CONFIG_DIR="/etc/novnc"
XVNC_SERVICE_FILE="/etc/systemd/system/novnc-xvnc.service"
SESSION_SERVICE_FILE="/etc/systemd/system/novnc-session.service"
SERVICE_FILE="/etc/systemd/system/novnc.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6080}}"
VNC_PORT="5901"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

PACKAGE_NAME="${PACKAGE_NAME:-novnc}"
if [[ ! "$APP_PORT" =~ ^[0-9]+$ ]] || (( 10#$APP_PORT < 1 || 10#$APP_PORT > 65535 )); then
    print_error "Invalid noVNC port: ${APP_PORT}"
    exit 1
fi
APP_PORT="$((10#$APP_PORT))"
export AF_APP_PORT="$APP_PORT"

VNC_PORT_EXPLICIT=false
if [[ -n "${AF_NOVNC_VNC_PORT:-}" ]]; then
    VNC_PORT_EXPLICIT=true
    VNC_PORT="${AF_NOVNC_VNC_PORT}"
fi
if [[ ! "$VNC_PORT" =~ ^[0-9]+$ ]] || (( 10#$VNC_PORT < 1 || 10#$VNC_PORT > 65535 )); then
    print_error "Invalid noVNC RFB port: ${VNC_PORT}"
    exit 1
fi
VNC_PORT="$((10#$VNC_PORT))"

if (( VNC_PORT == APP_PORT )); then
    if [[ "$VNC_PORT_EXPLICIT" == true ]]; then
        print_error "noVNC WebSocket port (${APP_PORT}) collides with configured AF_NOVNC_VNC_PORT (${VNC_PORT})."
        exit 1
    fi
    EXISTING_VNC_PORT=""
    if [[ -f "${XVNC_SERVICE_FILE}" && ! -L "${XVNC_SERVICE_FILE}" ]]; then
        EXISTING_VNC_PORT="$(sed -nE 's/.*-rfbport[[:space:]]+([0-9]+).*/\1/p' "${XVNC_SERVICE_FILE}" | head -n1 || true)"
    fi
    if [[ "$EXISTING_VNC_PORT" =~ ^[0-9]+$ ]] && (( 10#$EXISTING_VNC_PORT >= 1024 && 10#$EXISTING_VNC_PORT <= 65535 && 10#$EXISTING_VNC_PORT != APP_PORT )); then
        VNC_PORT="$((10#$EXISTING_VNC_PORT))"
    else
        VNC_PORT="$(python3 - "$APP_PORT" <<'PYEOF'
import socket
import sys

app_port = int(sys.argv[1])
for candidate in range(5902, 6000):
    if candidate == app_port:
        continue
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", candidate))
        print(candidate)
        sys.exit(0)
    except OSError:
        continue
    finally:
        sock.close()
sys.exit(1)
PYEOF
)" || {
            print_error "noVNC WebSocket port (${APP_PORT}) collides with default VNC RFB port 5901 and no free loopback port was found in 5902-5999."
            exit 1
        }
    fi
    log_warn "noVNC WebSocket port ${APP_PORT} collides with default VNC RFB port 5901; shifting Xtigervnc -rfbport to ${VNC_PORT}."
fi

begin_state_transaction "novnc-xvnc.service novnc-session.service novnc.service" "$APP_PORT" "/" "/var/lib/novnc" "/etc/novnc" "$XVNC_SERVICE_FILE" "$SESSION_SERVICE_FILE" "$SERVICE_FILE" "/usr/bin/Xtigervnc" "/usr/bin/tigervncserver" "/usr/bin/websockify" "/usr/share/novnc" "/usr/lib/python3/dist-packages/websockify"

prepare_apt_package_transaction /etc/novnc/.af-version novnc python3-websockify tigervnc-standalone-server tigervnc-common
log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_PASS="${MASTER_PASS}"

report_progress 30 "Installing noVNC, websockify, TigerVNC, and XFCE4 desktop environment..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    novnc python3-websockify tigervnc-standalone-server tigervnc-common \
    dbus-x11 xfce4 xfce4-terminal x11-xserver-utils curl jq

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${DATA_DIR}/.vnc" "${CONFIG_DIR}"

report_progress 65 "Configuring VNC session credentials and XFCE4 startup..."
validate_config_paths "${DATA_DIR}/.vnc/passwd" "${DATA_DIR}/.vnc/xstartup"
if [[ ! -f "${DATA_DIR}/.vnc/passwd" ]]; then
    printf '%s\n' "${ADMIN_PASS}" | vncpasswd -f > "${DATA_DIR}/.vnc/passwd"
    chmod 600 "${DATA_DIR}/.vnc/passwd"
fi

if [[ ! -f "${DATA_DIR}/.vnc/xstartup" ]]; then
    cat > "${DATA_DIR}/.vnc/xstartup" <<'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-launch --exit-with-session startxfce4
EOF
    chmod 755 "${DATA_DIR}/.vnc/xstartup"
fi
chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}" "${CONFIG_DIR}"

INSTALLED_VER="$(resolve_installed_apt_package_version novnc)"
queue_app_version "${CONFIG_DIR}/.af-version" "${INSTALLED_VER}"

report_progress 85 "Creating systemd units for TigerVNC (:1) and noVNC WebSocket proxy..."
cat > "${XVNC_SERVICE_FILE}" <<EOF
[Unit]
Description=TigerVNC Headless X11 Desktop Server for noVNC
After=network-online.target

[Service]
Type=exec
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
Environment="DISPLAY=:1"
PrivateTmp=yes
ExecStartPre=!/usr/bin/mkdir -p -m 1777 /tmp/.X11-unix
ExecStart=/usr/bin/Xtigervnc :1 -geometry 1920x1080 -depth 24 -localhost yes -rfbport ${VNC_PORT} -PasswordFile ${DATA_DIR}/.vnc/passwd -AlwaysShared
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "${XVNC_SERVICE_FILE}"

write_config_file "${SESSION_SERVICE_FILE}" 0644 <<EOF
[Unit]
Description=AetherFlow noVNC XFCE Desktop Session
BindsTo=novnc-xvnc.service
After=novnc-xvnc.service
PartOf=novnc-xvnc.service
JoinsNamespaceOf=novnc-xvnc.service

[Service]
Type=exec
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment=HOME=${DATA_DIR} DISPLAY=:1
PrivateTmp=yes
ExecStartPre=/usr/bin/timeout 10s /bin/sh -c 'until test -S /tmp/.X11-unix/X1; do sleep 0.2; done'
ExecStart=${DATA_DIR}/.vnc/xstartup
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=noVNC HTML5 WebSocket VNC Client Proxy
After=network-online.target novnc-xvnc.service novnc-session.service
Requires=novnc-xvnc.service novnc-session.service

[Service]
Type=exec
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
ExecStart=/usr/bin/websockify --web=/usr/share/novnc ${AF_BIND_ADDRESS:-127.0.0.1}:${APP_PORT} 127.0.0.1:${VNC_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "${SERVICE_FILE}"

af_logged systemctl daemon-reload
af_logged systemctl enable novnc-xvnc.service novnc-session.service novnc.service

af_logged systemctl restart novnc-xvnc.service novnc-session.service novnc.service
for unit in novnc-xvnc.service novnc-session.service novnc.service; do
    systemctl is-active --quiet "$unit"
done

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
