#!/bin/bash
#
# [AetherFlow Install Script - noVNC]
# Installs noVNC HTML5 WebSocket VNC proxy paired with TigerVNC and XFCE4 desktop.
#
set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
validate_config_paths /var/lib/novnc/.vnc/passwd /var/lib/novnc/.vnc/xstartup

PACKAGE_NAME="novnc"
APP_NAME="novnc"
APP_USER="novnc"
DATA_DIR="/var/lib/novnc"
CONFIG_DIR="/etc/novnc"
XVNC_SERVICE_FILE="/etc/systemd/system/novnc-xvnc.service"
SERVICE_FILE="/etc/systemd/system/novnc.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6080}}"
VNC_PORT="5901"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

PACKAGE_NAME="${PACKAGE_NAME:-novnc}"
begin_state_transaction "novnc-xvnc.service novnc.service" "$APP_PORT" "/" "/var/lib/novnc" "/etc/novnc" "/usr/local/bin/af-novnc-start" "/usr/local/bin/af-novnc-xvnc-start" "/etc/systemd/system/novnc-xvnc.service" "/etc/systemd/system/novnc.service" "/usr/bin/Xtigervnc" "/usr/bin/tigervncserver" "/usr/bin/x11vnc" "/usr/bin/websockify" "/usr/share/novnc" "/usr/lib/python3/dist-packages/websockify"

prepare_apt_package_transaction /etc/novnc/.af-version novnc websockify tigervnc-standalone-server x11vnc
log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_PASS="${MASTER_PASS}"

report_progress 30 "Installing noVNC, websockify, TigerVNC, and XFCE4 desktop environment..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    novnc python3-websockify tigervnc-standalone-server tigervnc-common \
    dbus-x11 xfce4 xfce4-terminal x11-xserver-utils curl jq

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${DATA_DIR}/.vnc" "${CONFIG_DIR}"

report_progress 65 "Configuring VNC session credentials and XFCE4 startup..."
validate_config_paths "${DATA_DIR}/.vnc/passwd" "${DATA_DIR}/.vnc/xstartup"
if [[ ! -f "${DATA_DIR}/.vnc/passwd" ]]; then
    printf '%s\n' "${ADMIN_PASS}" | vncpasswd -f > "${DATA_DIR}/.vnc/passwd"
    chmod 600 "${DATA_DIR}/.vnc/passwd"
fi

if [[ ! -f "${DATA_DIR}/.vnc/xstartup" ]]; then
    cat > "${DATA_DIR}/.vnc/xstartup" <<'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-launch --exit-with-session startxfce4
EOF
    chmod 755 "${DATA_DIR}/.vnc/xstartup"
fi
chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}" "${CONFIG_DIR}"

INSTALLED_VER="$(dpkg-query -W -f='${Version}' novnc 2>/dev/null | cut -d- -f1 | sed 's/^[0-9]*://' || echo '1.5.0')"
queue_app_version "${CONFIG_DIR}/.af-version" "${INSTALLED_VER}"

report_progress 85 "Creating systemd units for TigerVNC (:1) and noVNC WebSocket proxy..."
cat > "${XVNC_SERVICE_FILE}" <<EOF
[Unit]
Description=TigerVNC Headless X11 Desktop Server for noVNC
After=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
Environment="DISPLAY=:1"
ExecStart=/usr/bin/Xtigervnc :1 -geometry 1920x1080 -depth 24 -localhost yes -rfbport ${VNC_PORT} -PasswordFile ${DATA_DIR}/.vnc/passwd -AlwaysShared
ExecStartPost=/bin/sh -c 'sleep 1 && DISPLAY=:1 ${DATA_DIR}/.vnc/xstartup &'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=noVNC HTML5 WebSocket VNC Client Proxy
After=network-online.target novnc-xvnc.service
Requires=novnc-xvnc.service

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
ExecStart=/usr/bin/websockify --web=/usr/share/novnc ${AF_BIND_ADDRESS:-127.0.0.1}:${APP_PORT} 127.0.0.1:${VNC_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now novnc-xvnc.service novnc.service

af_logged systemctl restart novnc-xvnc.service novnc.service
systemctl is-active --quiet novnc-xvnc.service novnc.service

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
