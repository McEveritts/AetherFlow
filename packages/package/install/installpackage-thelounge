#!/bin/bash
# AetherFlow Package Installer: The Lounge
# Port: 9000

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="thelounge"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9000}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /etc/systemd/system/thelounge.service
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Setting up Node.js runtime and prerequisites for The Lounge..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl ca-certificates build-essential python3 python3-setuptools >> "$LOGFILE" 2>&1

ensure_node 22

NODE_PATH="$(command -v node)"
NODE_ARGS=()
TL_BIN=/usr/local/bin/thelounge
SQLITE_CHECK="const { DatabaseSync } = require(\"node:sqlite\"); new DatabaseSync(\":memory:\").close();"
if ! "${NODE_PATH}" -e "$SQLITE_CHECK" >> "$LOGFILE" 2>&1; then
    if "${NODE_PATH}" --experimental-sqlite -e "$SQLITE_CHECK" >> "$LOGFILE" 2>&1; then
        NODE_ARGS=(--experimental-sqlite)
    else
        log_error "The Lounge requires a Node.js runtime with working node:sqlite support."
        exit 1
    fi
fi

if ! id -u thelounge >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/thelounge --shell /usr/sbin/nologin thelounge
fi

mkdir -p /var/lib/thelounge/users

RUNTIME_BACKUP="$(mktemp -d /tmp/af-runtime-XXXXXX)"
RUNTIME_PATHS=("/opt/thelounge" "/var/lib/thelounge" "/etc/systemd/system/thelounge.service" "/usr/local/bin/thelounge")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_WAS_ACTIVE=0
RUNTIME_QUIESCE_STARTED=0
RUNTIME_MUTATED=0
[[ ! -e "/opt/thelounge" ]] || RUNTIME_HAD_PREVIOUS=true
if systemctl is-active --quiet thelounge 2>/dev/null; then RUNTIME_WAS_ACTIVE=1; fi
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback thelounge || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
            systemctl restart thelounge >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    elif [[ "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 0 && "$RUNTIME_WAS_ACTIVE" -eq 1 && "$RUNTIME_QUIESCE_STARTED" -eq 1 ]]; then
        systemctl restart thelounge >> "$LOGFILE" 2>&1 || restore_failed=true
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        [[ "$RUNTIME_MUTATED" -eq 0 ]] || status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true || -f /etc/systemd/system/thelounge.service || "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
    RUNTIME_QUIESCE_STARTED=1
    stop_systemd_unit thelounge
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 40 "Installing The Lounge with its complete dependency build toolchain..."
RUNTIME_MUTATED=1
install_npm_app thelounge /opt/thelounge /usr/local/bin/thelounge

TL_VER="$("${NODE_PATH}" "${NODE_ARGS[@]}" "${TL_BIN}" -v)"
if [[ ! "$TL_VER" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
    log_error "The Lounge did not report a valid installed version."
    exit 1
fi

report_progress 65 "Configuring The Lounge state and ports..."
if [[ ! -f /var/lib/thelounge/config.js ]]; then
    sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /var/lib/thelounge/config.js
module.exports = {
    public: false,
    host: "127.0.0.1",
    port: @AF_APP_PORT@,
    bind: undefined,
    reverseProxy: true,
    maxHistory: 10000,
    https: {
        enable: false
    }
};
EOF
fi

set_config_value /var/lib/thelounge/config.js js port "$APP_PORT"

chown -hRP thelounge:thelounge /var/lib/thelounge

if ! compgen -G '/var/lib/thelounge/users/*.json' > /dev/null; then
    printf '%s' "${MASTER_PASS}" | sudo -u thelounge THELOUNGE_HOME=/var/lib/thelounge \
        "${NODE_PATH}" "${NODE_ARGS[@]}" -e '
const fs = require("fs");
const [binary, username] = process.argv.slice(1);
process.argv = [process.execPath, binary, "add", username,
    "--password", fs.readFileSync(0, "utf8"), "--save-logs"];
require(binary);
' "${TL_BIN}" "${MASTER_USER}" >> "$LOGFILE" 2>&1
    if [[ ! -s "/var/lib/thelounge/users/${MASTER_USER}.json" ]]; then
        log_error "The Lounge did not create the configured user account."
        exit 1
    fi
fi
chown -hRP thelounge:thelounge /var/lib/thelounge

report_progress 85 "Configuring and starting thelounge.service on port ${APP_PORT}..."
write_config_file /etc/systemd/system/thelounge.service 0644 <<EOF
[Unit]
Description=The Lounge Web IRC Client
After=network.target

[Service]
Type=simple
User=thelounge
Group=thelounge
Environment=THELOUNGE_HOME=/var/lib/thelounge
ExecStart=${NODE_PATH} ${NODE_ARGS[*]} ${TL_BIN} start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable thelounge >> "$LOGFILE" 2>&1
systemctl restart thelounge >> "$LOGFILE" 2>&1

if ! curl --fail --silent --show-error --output /dev/null --connect-timeout 2 --max-time 5 \
    --retry 20 --retry-connrefused --retry-delay 1 --retry-max-time 60 \
    "http://127.0.0.1:${APP_PORT}/" >> "$LOGFILE" 2>&1 \
    || ! systemctl is-active --quiet thelounge; then
    log_error "The Lounge failed its HTTP and service readiness checks."
    exit 1
fi

queue_app_version /var/lib/thelounge/.af-version "${TL_VER#v}"
commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "The Lounge installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
