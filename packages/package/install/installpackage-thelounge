#!/bin/bash
# AetherFlow Package Installer: The Lounge
# Port: 9000

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="thelounge"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9000}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /etc/systemd/system/thelounge.service /var/lib/thelounge/config.js
TL_TARGET_VER=""
TL_PACKAGE="thelounge"
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TL_TARGET_VER="$(af_normalize_exact_registry_version npm "${AF_TARGET_VERSION}")" || exit 1
    TL_PACKAGE="thelounge@${TL_TARGET_VER}"
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Setting up Node.js runtime and prerequisites for The Lounge..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl ca-certificates build-essential python3 python3-setuptools

ensure_node 22

NODE_PATH="$(command -v node)"
NODE_ARGS=()
TL_BIN=/usr/local/bin/thelounge
SQLITE_CHECK="const { DatabaseSync } = require(\"node:sqlite\"); new DatabaseSync(\":memory:\").close();"
if ! af_logged "${NODE_PATH}" -e "$SQLITE_CHECK"; then
    if af_logged "${NODE_PATH}" --experimental-sqlite -e "$SQLITE_CHECK"; then
        NODE_ARGS=(--experimental-sqlite)
    else
        log_error "The Lounge requires a Node.js runtime with working node:sqlite support."
        exit 1
    fi
fi

if ! id -u thelounge >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/thelounge --shell /usr/sbin/nologin thelounge
fi

RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-runtime-")"
RUNTIME_PATHS=("/opt/thelounge" "/var/lib/thelounge" "/etc/systemd/system/thelounge.service" "/usr/local/bin/thelounge")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_WAS_ACTIVE=0
RUNTIME_QUIESCE_STARTED=0
RUNTIME_MUTATED=0
RUNTIME_ENABLE_ATTEMPTED=0
RUNTIME_WAS_ENABLED=0
if systemctl is-active --quiet thelounge 2>/dev/null; then RUNTIME_WAS_ACTIVE=1; fi
if systemctl is-enabled --quiet thelounge 2>/dev/null; then RUNTIME_WAS_ENABLED=1; fi
if [[ -e "/opt/thelounge" || -f /etc/systemd/system/thelounge.service || "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
    RUNTIME_HAD_PREVIOUS=true
fi
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback thelounge || { restore_failed=true; exit 1; }
        if [[ "$RUNTIME_WAS_ENABLED" -eq 0 && "$RUNTIME_ENABLE_ATTEMPTED" -eq 1 ]]; then
            af_logged systemctl disable thelounge || restore_failed=true
        fi
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        af_logged systemctl daemon-reload || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
            af_logged systemctl restart thelounge || restore_failed=true
        elif [[ "$RUNTIME_HAD_PREVIOUS" != true && "$RUNTIME_ENABLE_ATTEMPTED" -eq 1 ]]; then
            af_logged systemctl reset-failed thelounge || true
        fi
    elif [[ "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 0 && "$RUNTIME_WAS_ACTIVE" -eq 1 && "$RUNTIME_QUIESCE_STARTED" -eq 1 ]]; then
        af_logged systemctl restart thelounge || restore_failed=true
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        [[ "$RUNTIME_MUTATED" -eq 0 ]] || status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true ]]; then
    RUNTIME_QUIESCE_STARTED=1
    stop_systemd_unit thelounge
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 40 "Installing ${TL_PACKAGE} with its complete dependency build toolchain..."
RUNTIME_MUTATED=1
install_npm_app "$TL_PACKAGE" /opt/thelounge /usr/local/bin/thelounge

TL_CLI_ERR_FILE="${RUNTIME_BACKUP}/cli-probe.err"
if ! TL_VER_OUT="$("${NODE_PATH}" "${NODE_ARGS[@]}" "${TL_BIN}" -v 2>"$TL_CLI_ERR_FILE")"; then
    cat -- "$TL_CLI_ERR_FILE" >>"$LOGFILE" || true
    if grep -q 'Cannot find module.*thelounge/scripts/version' "$TL_CLI_ERR_FILE"; then
        print_error "Staged ${TL_PACKAGE} is missing scripts/version. Upstream npm 4.5.2 includes the runtime version module."
    else
        print_error "The version check failed for staged ${TL_PACKAGE}. See $LOGFILE."
    fi
    exit 1
fi
TL_VER="$(printf '%s\n' "$TL_VER_OUT" | head -n1 | tr -d '\r')"
if [[ ! "$TL_VER" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
    log_error "The Lounge did not report a valid installed version."
    exit 1
fi
TL_VER="$(af_strip_version_prefix "$TL_VER")"
if [[ -n "$TL_TARGET_VER" && "$TL_VER" != "$TL_TARGET_VER" ]]; then
    log_error "Installed The Lounge version (${TL_VER}) does not match requested target version (${TL_TARGET_VER})."
    exit 1
fi
queue_app_version /var/lib/thelounge/.af-version "$TL_VER"

report_progress 65 "Configuring The Lounge state and ports..."
mkdir -p /var/lib/thelounge/users
if [[ ! -e /var/lib/thelounge/config.js && ! -L /var/lib/thelounge/config.js ]]; then
    sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' | write_config_file /var/lib/thelounge/config.js 0640
module.exports = {
    public: false,
    host: "127.0.0.1",
    port: @AF_APP_PORT@,
    bind: undefined,
    reverseProxy: true,
    maxHistory: 10000,
    https: {
        enable: false
    }
};
EOF
fi

set_config_value /var/lib/thelounge/config.js js port "$APP_PORT"

chown -hRP thelounge:thelounge /var/lib/thelounge

if ! compgen -G '/var/lib/thelounge/users/*.json' > /dev/null; then
    if [[ -z "${MASTER_USER:-}" || -z "${MASTER_PASS:-}" ]]; then
        log_error "The Lounge requires configured MASTER_USER and MASTER_PASS to create the initial user account."
        exit 1
    fi
    printf '%s' "${MASTER_PASS}" | af_logged sudo -u thelounge THELOUNGE_HOME=/var/lib/thelounge \
        "${NODE_PATH}" "${NODE_ARGS[@]}" -e '
const fs = require("fs");
const [binary, username] = process.argv.slice(1);
process.argv = [process.execPath, binary, "add", username,
    "--password", fs.readFileSync(0, "utf8"), "--save-logs"];
require(binary);
' "${TL_BIN}" "${MASTER_USER}"
    if [[ ! -s "/var/lib/thelounge/users/${MASTER_USER}.json" ]]; then
        log_error "The Lounge did not create the configured user account."
        exit 1
    fi
fi
chown -hRP thelounge:thelounge /var/lib/thelounge

report_progress 85 "Configuring and starting thelounge.service on port ${APP_PORT}..."
TL_EXEC_START="${NODE_PATH}"
if (( ${#NODE_ARGS[@]} > 0 )); then
    TL_EXEC_START+=" ${NODE_ARGS[*]}"
fi
TL_EXEC_START+=" ${TL_BIN} start"
write_config_file /etc/systemd/system/thelounge.service 0644 <<EOF
[Unit]
Description=The Lounge Web IRC Client
After=network.target

[Service]
Type=simple
User=thelounge
Group=thelounge
Environment=THELOUNGE_HOME=/var/lib/thelounge
ExecStart=${TL_EXEC_START}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
RUNTIME_ENABLE_ATTEMPTED=1
af_logged systemctl enable thelounge
af_logged systemctl restart thelounge

THELOUNGE_READY_URL="http://127.0.0.1:${APP_PORT}/"
if ! af_logged curl --noproxy '*' --fail --silent --show-error --output /dev/null --connect-timeout 2 --max-time 5 \
    --retry 20 --retry-connrefused --retry-delay 1 --retry-max-time 60 \
    "$THELOUNGE_READY_URL" \
    || ! systemctl is-active --quiet thelounge; then
    log_error "The Lounge failed its HTTP and service readiness checks."
    exit 1
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
if declare -F af_emit_readiness_record >/dev/null 2>&1; then
    af_emit_readiness_record "thelounge.service" "$THELOUNGE_READY_URL" false false
fi
report_progress 100 "The Lounge installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
