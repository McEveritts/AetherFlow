#!/bin/bash
# AetherFlow Package Installer: Prowlarr
# Port: 9696

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="prowlarr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9696}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Prowlarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev ca-certificates >> "$LOGFILE" 2>&1

if ! id -u prowlarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/prowlarr --shell /usr/sbin/nologin prowlarr
fi

mkdir -p /var/lib/prowlarr /opt/Prowlarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) PROWLARR_ARCH="x64" ;;
    arm64) PROWLARR_ARCH="arm64" ;;
    armhf) PROWLARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Prowlarr (${PROWLARR_ARCH})..."
PROWLARR_VERSION="$(github_latest_tag "Prowlarr/Prowlarr" "1.28.2.4885")"
PROWLARR_URL="https://prowlarr.servarr.com/v1/update/master/updatefile?version=${PROWLARR_VERSION#v}&os=linux&runtime=netcore&arch=${PROWLARR_ARCH}"

TMP_TAR=$(mktemp /tmp/prowlarr-XXXXXX.tar.gz)
download_file "$PROWLARR_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Prowlarr to /opt/Prowlarr..."
stage_app_archive "$TMP_TAR" "/opt/Prowlarr" "Prowlarr" "/var/lib/prowlarr" "${PACKAGE_NAME}"
rm -f "$TMP_TAR"

if [[ ! -x /opt/Prowlarr/Prowlarr ]]; then
    print_error "Prowlarr binary /opt/Prowlarr/Prowlarr missing or not executable"
    exit 1
fi

PROBED_VER="$(resolve_installed_binary_version /opt/Prowlarr/Prowlarr "" || true)"
if [[ -n "$PROBED_VER" ]]; then
    RESOLVED_VER="$PROBED_VER"
elif [[ "${AF_ALLOW_VERSION_FALLBACK:-1}" != "0" ]]; then
    RESOLVED_VER="${PROWLARR_VERSION#v}"
else
    print_error "Failed to resolve installed binary version for Prowlarr"
    exit 1
fi

NORM_RESOLVED="${RESOLVED_VER#release-}"
NORM_RESOLVED="${NORM_RESOLVED#Release-}"
NORM_RESOLVED="${NORM_RESOLVED#[vV]}"

NORM_PROWLARR="${PROWLARR_VERSION#release-}"
NORM_PROWLARR="${NORM_PROWLARR#Release-}"
NORM_PROWLARR="${NORM_PROWLARR#[vV]}"

if [[ "${RESOLVED_VER#v}" != "${PROWLARR_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_PROWLARR" ]]; then
    echo "ERROR: Installed Prowlarr version '${RESOLVED_VER}' does not match expected version '${PROWLARR_VERSION}'" >&2
    exit 1
fi

if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    NORM_TARGET="${AF_TARGET_VERSION#release-}"
    NORM_TARGET="${NORM_TARGET#Release-}"
    NORM_TARGET="${NORM_TARGET#[vV]}"
    if [[ "${RESOLVED_VER#v}" != "${AF_TARGET_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_TARGET" ]]; then
        echo "ERROR: Installed Prowlarr version '${RESOLVED_VER}' does not match requested target version '${AF_TARGET_VERSION}'" >&2
        exit 1
    fi
fi

if [[ -n "$RESOLVED_VER" ]]; then
    queue_app_version /opt/Prowlarr/.af-version "$RESOLVED_VER"
fi
set_config_value "/var/lib/prowlarr/config.xml" xml "Port" "$APP_PORT" "Config"

chown -hRP prowlarr:prowlarr /opt/Prowlarr /var/lib/prowlarr

report_progress 85 "Configuring and starting prowlarr.service..."
cat <<'EOF' > /etc/systemd/system/prowlarr.service
[Unit]
Description=Prowlarr Daemon
After=syslog.target network.target

[Service]
User=prowlarr
Group=prowlarr
Type=simple
ExecStart=/opt/Prowlarr/Prowlarr -nobrowser -data=/var/lib/prowlarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now prowlarr >> "$LOGFILE" 2>&1
systemctl restart prowlarr >> "$LOGFILE" 2>&1
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "$READY_URL"
seed_servarr_master_user "prowlarr" ${APP_PORT} "v1"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Prowlarr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
