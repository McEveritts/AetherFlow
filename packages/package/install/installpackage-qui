#!/bin/bash
# AetherFlow Package Installer: Qui
# Port: 7476

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="qui"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-7476}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /var/lib/qui/.af-version /var/lib/qui/config.toml /var/lib/qui/qui.db
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for Qui..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl wget tar openssl ca-certificates >> "$LOGFILE" 2>&1

if ! id -u qui >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/qui --shell /usr/sbin/nologin qui
fi

mkdir -p /var/lib/qui

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) QUI_ARCH="linux_x86_64" ;;
    arm64) QUI_ARCH="linux_arm64" ;;
    armhf) QUI_ARCH="linux_arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Qui release (${QUI_ARCH})..."
QUI_VERSION="$(github_latest_tag "autobrr/qui" "1.33.1")"
QUI_URL="https://github.com/autobrr/qui/releases/download/v${QUI_VERSION}/qui_${QUI_VERSION}_${QUI_ARCH}.tar.gz"

report_progress 65 "Downloading and installing Qui ${QUI_VERSION}..."
TMP_TAR=$(mktemp /tmp/qui-XXXXXX.tar.gz)
download_file "$QUI_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
stage_app_archive "$TMP_TAR" "/usr/local/bin/qui" "qui" "/var/lib/qui" "$PACKAGE_NAME" "." "" "" "binary"
rm -f "$TMP_TAR"
chmod 755 /usr/local/bin/qui
queue_app_version /var/lib/qui/.af-version "${QUI_VERSION#v}"

if [[ ! -f /var/lib/qui/config.toml ]]; then
    SESSION_SECRET="$(openssl rand -hex 32)"
    cat <<EOF > /var/lib/qui/config.toml
host = "127.0.0.1"
port = ${APP_PORT}
logLevel = "INFO"
sessionSecret = "${SESSION_SECRET}"
EOF
fi

if [[ ! -f /var/lib/qui/qui.db ]]; then
    [[ -n "${MASTER_USER:-}" && -n "${AF_CONFIG_PASS:-$MASTER_PASS}" ]] || { print_error "Qui account credentials are required"; exit 1; }
    printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | /usr/local/bin/qui create-user --config-dir=/var/lib/qui --username="${MASTER_USER}" >> "$LOGFILE" 2>&1
elif [[ -n "${AF_CONFIG_PASS:-}" && "${AF_KEEP_EXISTING_SECRETS:-1}" != "1" ]]; then
    printf '%s\n' "$AF_CONFIG_PASS" | /usr/local/bin/qui create-user --config-dir=/var/lib/qui --username="${MASTER_USER}" >> "$LOGFILE" 2>&1 \
        || printf '%s\n' "$AF_CONFIG_PASS" | /usr/local/bin/qui change-password --config-dir=/var/lib/qui --username="${MASTER_USER}" >> "$LOGFILE" 2>&1
fi

set_config_value "/var/lib/qui/config.toml" ini "port" "$APP_PORT" ""

chown -hRP qui:qui /var/lib/qui
chmod 755 /var/lib/qui
chmod 640 /var/lib/qui/config.toml
[[ -f /var/lib/qui/qui.db ]] && chmod 640 /var/lib/qui/qui.db

report_progress 85 "Configuring and starting qui.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/qui.service
[Unit]
Description=qui qBittorrent Web UI service
After=syslog.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qui
Group=qui
WorkingDirectory=/var/lib/qui
ExecStart=/usr/local/bin/qui serve --config-dir=/var/lib/qui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now qui >> "$LOGFILE" 2>&1
systemctl restart qui >> "$LOGFILE" 2>&1
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/"

commit_app_versions
chmod 644 /var/lib/qui/.af-version
chmod 644 /var/lib/qui/.af-version
write_lock "${PACKAGE_NAME}"
report_progress 100 "Qui installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
