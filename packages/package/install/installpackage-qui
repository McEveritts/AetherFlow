#!/bin/bash
# AetherFlow Package Installer: Qui
# Port: 7476

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="qui"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-7476}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /var/lib/qui/.af-version /var/lib/qui/config.toml /var/lib/qui/qui.db
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for Qui..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl wget tar openssl ca-certificates

if ! id -u qui >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/qui --shell /usr/sbin/nologin qui
fi

mkdir -p /var/lib/qui

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) QUI_ARCH="linux_x86_64" ;;
    arm64) QUI_ARCH="linux_arm64" ;;
    armhf) QUI_ARCH="linux_arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Qui release (${QUI_ARCH})..."
QUI_VERSION="$(github_latest_tag "autobrr/qui" "1.33.1")"
QUI_URL="https://github.com/autobrr/qui/releases/download/v${QUI_VERSION}/qui_${QUI_VERSION}_${QUI_ARCH}.tar.gz"

report_progress 65 "Downloading and installing Qui ${QUI_VERSION}..."
TMP_TAR=$(mktemp /tmp/qui-XXXXXX.tar.gz)
af_logged download_file "$QUI_URL" "$TMP_TAR"
stage_app_archive "$TMP_TAR" "/usr/local/bin/qui" "qui" "/var/lib/qui" "$PACKAGE_NAME" "." "" "" "binary"
rm -f "$TMP_TAR"
chmod 755 /usr/local/bin/qui
queue_app_version /var/lib/qui/.af-version "${QUI_VERSION#v}"

if [[ ! -f /var/lib/qui/config.toml ]]; then
    SESSION_SECRET="$(openssl rand -hex 32)"
    cat <<EOF > /var/lib/qui/config.toml
host = "127.0.0.1"
port = ${APP_PORT}
logLevel = "INFO"
sessionSecret = "${SESSION_SECRET}"
EOF
fi

if [[ ! -f /var/lib/qui/qui.db ]]; then
    [[ -n "${MASTER_USER:-}" && -n "${AF_CONFIG_PASS:-$MASTER_PASS}" ]] || { print_error "Qui account credentials are required"; exit 1; }
    printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | af_logged /usr/local/bin/qui create-user --config-dir=/var/lib/qui --username="${MASTER_USER}"
elif [[ -n "${AF_CONFIG_PASS:-}" && "${AF_KEEP_EXISTING_SECRETS:-1}" != "1" ]]; then
    printf '%s\n' "$AF_CONFIG_PASS" | af_logged /usr/local/bin/qui create-user --config-dir=/var/lib/qui --username="${MASTER_USER}" \
        || printf '%s\n' "$AF_CONFIG_PASS" | af_logged /usr/local/bin/qui change-password --config-dir=/var/lib/qui --username="${MASTER_USER}"
fi

set_config_value "/var/lib/qui/config.toml" ini "port" "$APP_PORT" ""

chown -hRP qui:qui /var/lib/qui
chmod 755 /var/lib/qui
chmod 640 /var/lib/qui/config.toml
[[ -f /var/lib/qui/qui.db ]] && chmod 640 /var/lib/qui/qui.db

report_progress 85 "Configuring and starting qui.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/qui.service
[Unit]
Description=qui qBittorrent Web UI service
After=syslog.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qui
Group=qui
WorkingDirectory=/var/lib/qui
ExecStart=/usr/local/bin/qui serve --config-dir=/var/lib/qui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF


af_logged systemctl daemon-reload
af_logged systemctl enable --now qui
af_logged systemctl restart qui
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/"

commit_app_versions
chmod 644 /var/lib/qui/.af-version
chmod 644 /var/lib/qui/.af-version
write_lock "${PACKAGE_NAME}"
report_progress 100 "Qui installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
