#!/bin/bash
# AetherFlow Package Installer: Radarr
# Port: 7878

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="radarr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-7878}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Radarr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl sqlite3 libicu-dev mediainfo ca-certificates

if ! id -u radarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/radarr --shell /usr/sbin/nologin radarr
fi

mkdir -p /var/lib/radarr /opt/Radarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) RADARR_ARCH="x64" ;;
    arm64) RADARR_ARCH="arm64" ;;
    armhf) RADARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Radarr (${RADARR_ARCH})..."
RADARR_VERSION="$(github_latest_tag "Radarr/Radarr" "5.16.3.9541")"
TMP_TAR=$(mktemp /tmp/radarr-XXXXXX.tar.gz)
af_logged download_file "https://radarr.servarr.com/v1/update/master/updatefile?version=${RADARR_VERSION#v}&os=linux&runtime=netcore&arch=${RADARR_ARCH}" "$TMP_TAR"

report_progress 65 "Extracting Radarr to /opt/Radarr..."
stage_app_archive "$TMP_TAR" "/opt/Radarr" "Radarr" "/var/lib/radarr" "${PACKAGE_NAME}"
rm -f "$TMP_TAR"

if [[ ! -x /opt/Radarr/Radarr ]]; then
    print_error "Radarr binary /opt/Radarr/Radarr missing or not executable"
    exit 1
fi

PROBED_VER="$(resolve_installed_binary_version /opt/Radarr/Radarr "" || true)"
if [[ -n "$PROBED_VER" ]]; then
    RESOLVED_VER="$PROBED_VER"
elif [[ "${AF_ALLOW_VERSION_FALLBACK:-1}" != "0" ]]; then
    RESOLVED_VER="${RADARR_VERSION#v}"
else
    print_error "Failed to resolve installed binary version for Radarr"
    exit 1
fi

NORM_RESOLVED="${RESOLVED_VER#release-}"
NORM_RESOLVED="${NORM_RESOLVED#Release-}"
NORM_RESOLVED="${NORM_RESOLVED#[vV]}"

NORM_RADARR="${RADARR_VERSION#release-}"
NORM_RADARR="${NORM_RADARR#Release-}"
NORM_RADARR="${NORM_RADARR#[vV]}"

if [[ "${RESOLVED_VER#v}" != "${RADARR_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_RADARR" ]]; then
    echo "ERROR: Installed Radarr version '${RESOLVED_VER}' does not match expected version '${RADARR_VERSION}'" >&2
    exit 1
fi

if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    NORM_TARGET="${AF_TARGET_VERSION#release-}"
    NORM_TARGET="${NORM_TARGET#Release-}"
    NORM_TARGET="${NORM_TARGET#[vV]}"
    if [[ "${RESOLVED_VER#v}" != "${AF_TARGET_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_TARGET" ]]; then
        echo "ERROR: Installed Radarr version '${RESOLVED_VER}' does not match requested target version '${AF_TARGET_VERSION}'" >&2
        exit 1
    fi
fi

if [[ -n "$RESOLVED_VER" ]]; then
    queue_app_version /opt/Radarr/.af-version "$RESOLVED_VER"
fi
set_config_value "/var/lib/radarr/config.xml" xml "Port" "$APP_PORT" "Config"

chown -hRP radarr:radarr /opt/Radarr /var/lib/radarr

report_progress 85 "Configuring and starting radarr.service..."
cat <<'EOF' > /etc/systemd/system/radarr.service
[Unit]
Description=Radarr Daemon
After=syslog.target network.target

[Service]
User=radarr
Group=radarr
Type=simple
ExecStart=/opt/Radarr/Radarr -nobrowser -data=/var/lib/radarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF


af_logged systemctl daemon-reload
af_logged systemctl enable --now radarr
af_logged systemctl restart radarr
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "$READY_URL"
seed_servarr_master_user "radarr" ${APP_PORT} "v3"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Radarr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
