#!/bin/bash
#
# [AetherFlow :: Install Radarr]
# Movie collection manager for Usenet and BitTorrent
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [radarr] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl sqlite3 libicu-dev >>"$LOGFILE" 2>&1

# ── Download Radarr ──────────────────────────────────────────────────────────
log "Downloading latest Radarr..."
ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) RADARR_ARCH="x64" ;;
    arm64) RADARR_ARCH="arm64" ;;
    armhf) RADARR_ARCH="arm" ;;
    *) RADARR_ARCH="x64" ;;
esac

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "https://radarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=${RADARR_ARCH}" -o radarr.tar.gz >>"$LOGFILE" 2>&1

log "Extracting Radarr..."
rm -rf /opt/Radarr
tar -xzf radarr.tar.gz -C /opt >>"$LOGFILE" 2>&1
rm -f radarr.tar.gz

# ── Create radarr user ───────────────────────────────────────────────────────
if ! id -u radarr &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /opt/Radarr radarr
fi
chown -R radarr:radarr /opt/Radarr
mkdir -p /var/lib/radarr
chown -R radarr:radarr /var/lib/radarr

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/radarr.service <<'EOF'
[Unit]
Description=Radarr Movie Manager
After=syslog.target network.target

[Service]
User=radarr
Group=radarr
Type=simple
ExecStart=/opt/Radarr/Radarr -nobrowser -data=/var/lib/radarr/
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=process
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/radarr

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable radarr.service >>"$LOGFILE" 2>&1
systemctl start radarr.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/radarr.conf <<'EOF'
<Location /radarr>
    ProxyPass http://localhost:7878/radarr
    ProxyPassReverse http://localhost:7878/radarr
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/radarr.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.radarr.lock
log "Radarr installation complete! Access at http://your-server:7878"
