#!/bin/bash
# AetherFlow Package Installer: Radarr
# Port: 7878

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="radarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Radarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev mediainfo ca-certificates >> "$LOGFILE" 2>&1

if ! id -u radarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/radarr --shell /usr/sbin/nologin radarr
fi

mkdir -p /var/lib/radarr /opt/Radarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) RADARR_ARCH="x64" ;;
    arm64) RADARR_ARCH="arm64" ;;
    armhf) RADARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Radarr (${RADARR_ARCH})..."
RADARR_VERSION="$(github_latest_tag "Radarr/Radarr" "5.16.3.9541")"
TMP_TAR=$(mktemp /tmp/radarr-XXXXXX.tar.gz)
curl -fsSL "https://radarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=${RADARR_ARCH}" -o "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Radarr to /opt/Radarr..."
tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
if [[ -n "$RADARR_VERSION" ]]; then
    printf '%s\n' "${RADARR_VERSION#v}" > /opt/Radarr/.af-version
fi
chown -R radarr:radarr /opt/Radarr /var/lib/radarr

report_progress 85 "Configuring and starting radarr.service..."
cat <<'EOF' > /etc/systemd/system/radarr.service
[Unit]
Description=Radarr Daemon
After=syslog.target network.target

[Service]
User=radarr
Group=radarr
Type=simple
ExecStart=/opt/Radarr/Radarr -nobrowser -data=/var/lib/radarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now radarr >> "$LOGFILE" 2>&1
seed_servarr_master_user "radarr" 7878 "v3"

write_lock "${PACKAGE_NAME}"
report_progress 100 "Radarr installed on port 7878."
log_info "${PACKAGE_NAME} installed successfully"
