#!/bin/bash
# AetherFlow Package Installer: ZNC
# Port: 6501

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="znc"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6501}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /var/lib/znc/znc.pem
PACKAGE_NAME="${PACKAGE_NAME:-znc}"
begin_state_transaction "znc" "0" "/" "/var/lib/znc" "/etc/znc" "/etc/systemd/system/znc.service" "/usr/bin/znc" "/usr/lib/znc" "/usr/share/znc"

prepare_apt_package_transaction /var/lib/znc/.af-version znc
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing ZNC packages and cryptographic libraries via apt..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq znc openssl ca-certificates >> "$LOGFILE" 2>&1

if ! id -u znc >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/znc --shell /usr/sbin/nologin znc
fi

mkdir -p /var/lib/znc/configs /var/lib/znc/modules /var/lib/znc/users

# Record version
ZNC_VER="$(znc --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' || dpkg-query -W -f='${Version}' znc 2>/dev/null || echo "1.8.2")"
queue_app_version /var/lib/znc/.af-version "$ZNC_VER"

report_progress 50 "Generating initial ZNC configuration and SSL certificate..."
if [[ ! -f /var/lib/znc/znc.pem ]]; then
    openssl req -x509 -nodes -newkey rsa:2048 -keyout /var/lib/znc/znc.pem -out /var/lib/znc/znc.pem -days 3650 -subj "/CN=znc" >> "$LOGFILE" 2>&1 || true
    chmod 600 /var/lib/znc/znc.pem
fi

validate_config_paths /var/lib/znc/configs/znc.conf
if [[ ! -f /var/lib/znc/configs/znc.conf ]]; then
    ZNC_CFG_VER="$(printf '%s' "$ZNC_VER" | grep -oE '^[0-9]+\.[0-9]+' || echo "1.9")"
    ZNC_CFG_VER="${ZNC_CFG_VER:-1.9}"
    ZNC_SALT="$(python3 -c 'import secrets; print(secrets.token_hex(16))' 2>/dev/null || openssl rand -hex 16)"
    ZNC_HASH="$(AF_SEED_PASS="$MASTER_PASS" AF_SEED_SALT="$ZNC_SALT" python3 -c 'import os,hashlib; print(hashlib.sha256((os.environ["AF_SEED_PASS"]+os.environ["AF_SEED_SALT"]).encode("utf-8")).hexdigest())')"
    write_config_file /var/lib/znc/configs/znc.conf 0600 <<EOF
// ZNC configuration created by AetherFlow
Version = ${ZNC_CFG_VER}
AnonIPLimit = 10
AuthOnlyVia = ""
ConfigWriteDelay = 0
ConnectDelay = 5
HideVersion = false
LoadModule = webadmin
MaxBufferSize = 500
ProtectWebSessions = true
ServerThrottle = 30
Skin = "default"
StatusPrefix = "*"

<Listener listener0>
    Host = 127.0.0.1
    AllowIRC = true
    AllowWeb = true
    IPv4 = true
    IPv6 = true
    Port = ${APP_PORT}
    SSL = false
    URIPrefix = /
</Listener>

<User ${MASTER_USER}>
    Pass       = sha256#${ZNC_HASH}#${ZNC_SALT}#
    Admin      = true
    Nick       = ${MASTER_USER}
    AltNick    = ${MASTER_USER}_
    Ident      = ${MASTER_USER}
    RealName   = ${MASTER_USER}
</User>
EOF
fi

safe_config_python /var/lib/znc/configs/znc.conf "$APP_PORT" <<'PYEOF'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
with ManagedConfig(path) as config:
    text = config.read_text()
    listeners = list(re.finditer(r'(?ms)^\s*<Listener\s+([^>]+)>\s*\n(.*?)^\s*</Listener>', text))
    selected = next((entry for entry in listeners if entry.group(1) in ('l', 'listener0')), None)
    if selected is None and len(listeners) == 1:
        selected = listeners[0]
    if selected is None:
        raise ValueError('Cannot identify the managed ZNC listener')
    block = selected.group(2)
    block, count = re.subn(r'(?m)^([ \t]*Port[ \t]*=[ \t]*)\d+[ \t]*$', lambda match: match.group(1) + sys.argv[2], block)
    if count != 1:
        raise ValueError('Expected one ZNC listener port')
    text = text[:selected.start(2)] + block + text[selected.end(2):]
    config.write_text(text)
PYEOF

chown -hRP znc:znc /var/lib/znc

report_progress 85 "Configuring and starting znc.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/znc.service
[Unit]
Description=ZNC - Advanced IRC Bouncer
After=network-online.target
Wants=network-online.target

[Service]
User=znc
Group=znc
Type=simple
WorkingDirectory=/var/lib/znc
ExecStart=/usr/bin/znc --foreground --datadir=/var/lib/znc
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now znc >> "$LOGFILE" 2>&1
systemctl restart znc >> "$LOGFILE" 2>&1
systemctl is-active --quiet znc

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "ZNC installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
