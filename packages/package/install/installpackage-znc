#!/bin/bash
# AetherFlow Package Installer: ZNC
# Port: 6501

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="znc"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing ZNC packages and cryptographic libraries via apt..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq znc openssl ca-certificates >> "$LOGFILE" 2>&1

if ! id -u znc >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/znc --shell /usr/sbin/nologin znc
fi

mkdir -p /var/lib/znc/configs /var/lib/znc/modules /var/lib/znc/users

# Record version
ZNC_VER="$(znc --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' || dpkg-query -W -f='${Version}' znc 2>/dev/null || echo "1.8.2")"
printf '%s\n' "$ZNC_VER" > /var/lib/znc/.af-version

report_progress 50 "Generating initial ZNC configuration and SSL certificate..."
if [[ ! -f /var/lib/znc/znc.pem ]]; then
    openssl req -x509 -nodes -newkey rsa:2048 -keyout /var/lib/znc/znc.pem -out /var/lib/znc/znc.pem -days 3650 -subj "/CN=znc" >> "$LOGFILE" 2>&1 || true
    chmod 600 /var/lib/znc/znc.pem
fi

if [[ ! -f /var/lib/znc/configs/znc.conf ]]; then
    ZNC_CFG_VER="$(printf '%s' "$ZNC_VER" | grep -oE '^[0-9]+\.[0-9]+' || echo "1.9")"
    ZNC_CFG_VER="${ZNC_CFG_VER:-1.9}"
    ZNC_SALT="aetherflowzncsalt123"
    ZNC_HASH="$(python3 -c 'import sys,hashlib; print(hashlib.sha256((sys.argv[1]+sys.argv[2]).encode("utf-8")).hexdigest())' "${MASTER_PASS}" "${ZNC_SALT}")"
    cat <<EOF > /var/lib/znc/configs/znc.conf
// ZNC configuration created by AetherFlow
Version = ${ZNC_CFG_VER}
AnonIPLimit = 10
AuthOnlyVia = ""
ConfigWriteDelay = 0
ConnectDelay = 5
HideVersion = false
LoadModule = webadmin
MaxBufferSize = 500
ProtectWebSessions = true
ServerThrottle = 30
Skin = "default"
StatusPrefix = "*"

<Listener listener0>
    AllowIRC = true
    AllowWeb = true
    IPv4 = true
    IPv6 = true
    Port = 6501
    SSL = false
    URIPrefix = /
</Listener>

<User ${MASTER_USER}>
    Pass       = sha256#${ZNC_HASH}#${ZNC_SALT}#
    Admin      = true
    Nick       = ${MASTER_USER}
    AltNick    = ${MASTER_USER}_
    Ident      = ${MASTER_USER}
    RealName   = ${MASTER_USER}
</User>
EOF
fi

chown -R znc:znc /var/lib/znc

report_progress 85 "Configuring and starting znc.service on port 6501..."
cat <<'EOF' > /etc/systemd/system/znc.service
[Unit]
Description=ZNC - Advanced IRC Bouncer
After=network-online.target
Wants=network-online.target

[Service]
User=znc
Group=znc
Type=simple
WorkingDirectory=/var/lib/znc
ExecStart=/usr/bin/znc --foreground --datadir=/var/lib/znc
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now znc >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "ZNC installed on port 6501."
log_info "${PACKAGE_NAME} installed successfully"
