#!/bin/bash
# AetherFlow Package Installer: ZNC
# Port: 6501

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="znc"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6501}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /var/lib/znc/znc.pem
PACKAGE_NAME="${PACKAGE_NAME:-znc}"
begin_state_transaction "znc" "0" "/" "/var/lib/znc" "/etc/znc" "/etc/systemd/system/znc.service" "/usr/bin/znc" "/usr/lib/znc" "/usr/share/znc"

prepare_apt_package_transaction /var/lib/znc/.af-version znc
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing ZNC packages and cryptographic libraries via apt..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq znc openssl ca-certificates

if ! id -u znc >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/znc --shell /usr/sbin/nologin znc
fi

mkdir -p /var/lib/znc/configs /var/lib/znc/modules /var/lib/znc/users

# Record version
ZNC_VER="$(znc --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' || dpkg-query -W -f='${Version}' znc 2>/dev/null || echo "1.8.2")"
queue_app_version /var/lib/znc/.af-version "$ZNC_VER"

report_progress 50 "Generating initial ZNC configuration and SSL certificate..."
if [[ ! -f /var/lib/znc/znc.pem ]]; then
    af_logged openssl req -x509 -nodes -newkey rsa:2048 -keyout /var/lib/znc/znc.pem -out /var/lib/znc/znc.pem -days 3650 -subj "/CN=znc" || true
    chmod 600 /var/lib/znc/znc.pem
fi

validate_config_paths /var/lib/znc/configs/znc.conf
if [[ ! -f /var/lib/znc/configs/znc.conf ]]; then
    ZNC_CFG_VER="$(printf '%s' "$ZNC_VER" | grep -oE '^[0-9]+\.[0-9]+' || echo "1.9")"
    ZNC_CFG_VER="${ZNC_CFG_VER:-1.9}"
    ZNC_SALT="$(python3 -c 'import secrets; print(secrets.token_hex(16))' 2>/dev/null || openssl rand -hex 16)"
    ZNC_HASH="$(AF_SEED_PASS="$MASTER_PASS" AF_SEED_SALT="$ZNC_SALT" python3 -c 'import os,hashlib; print(hashlib.sha256((os.environ["AF_SEED_PASS"]+os.environ["AF_SEED_SALT"]).encode("utf-8")).hexdigest())')"
    write_config_file /var/lib/znc/configs/znc.conf 0600 <<EOF
// ZNC configuration created by AetherFlow
Version = ${ZNC_CFG_VER}
AnonIPLimit = 10
AuthOnlyVia = ""
ConfigWriteDelay = 0
ConnectDelay = 5
HideVersion = false
LoadModule = webadmin
MaxBufferSize = 500
ProtectWebSessions = true
ServerThrottle = 30
Skin = "default"
StatusPrefix = "*"

<Listener listener0>
    Host = 127.0.0.1
    AllowIRC = true
    AllowWeb = true
    IPv4 = true
    IPv6 = true
    Port = ${APP_PORT}
    SSL = false
    URIPrefix = /
</Listener>

<User ${MASTER_USER}>
    Pass       = sha256#${ZNC_HASH}#${ZNC_SALT}#
    Admin      = true
    Nick       = ${MASTER_USER}
    AltNick    = ${MASTER_USER}_
    Ident      = ${MASTER_USER}
    RealName   = ${MASTER_USER}
</User>
EOF
fi

safe_config_python /var/lib/znc/configs/znc.conf "$APP_PORT" <<'PYEOF'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
with ManagedConfig(path) as config:
    text = config.read_text()
    listeners = list(re.finditer(r'(?ms)^\s*<Listener\s+([^>]+)>\s*\n(.*?)^\s*</Listener>', text))
    selected = next((entry for entry in listeners if entry.group(1) in ('l', 'listener0')), None)
    if selected is None and len(listeners) == 1:
        selected = listeners[0]
    if selected is None:
        raise ValueError('Cannot identify the managed ZNC listener')
    block = selected.group(2)
    block, count = re.subn(r'(?m)^([ \t]*Port[ \t]*=[ \t]*)\d+[ \t]*$', lambda match: match.group(1) + sys.argv[2], block)
    if count != 1:
        raise ValueError('Expected one ZNC listener port')
    text = text[:selected.start(2)] + block + text[selected.end(2):]
    config.write_text(text)
PYEOF

chown -hRP znc:znc /var/lib/znc

report_progress 85 "Configuring and starting znc.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/znc.service
[Unit]
Description=ZNC - Advanced IRC Bouncer
After=network-online.target
Wants=network-online.target

[Service]
User=znc
Group=znc
Type=simple
WorkingDirectory=/var/lib/znc
ExecStart=/usr/bin/znc --foreground --datadir=/var/lib/znc
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now znc
af_logged systemctl restart znc
systemctl is-active --quiet znc

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "ZNC installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
