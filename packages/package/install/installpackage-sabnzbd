#!/bin/bash
# AetherFlow Package Installer: SABnzbd
# Port: 8085

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="sabnzbd"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python, build, and archive dependencies for SABnzbd..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl python3 python3-pip python3-venv python3-dev build-essential libffi-dev libssl-dev p7zip-full par2 unzip unrar-free ca-certificates >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq unrar >> "$LOGFILE" 2>&1 || true

if ! id -u sabnzbd >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/sabnzbd --shell /usr/sbin/nologin sabnzbd
fi

mkdir -p /opt/SABnzbd /var/lib/sabnzbd

report_progress 35 "Resolving latest SABnzbd release..."
SAB_JSON="$(curl -fsSL https://api.github.com/repos/sabnzbd/sabnzbd/releases/latest 2>/dev/null || true)"
SAB_VERSION="$(printf '%s' "$SAB_JSON" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1 || true)"
SAB_VERSION="${SAB_VERSION:-4.3.3}"
SAB_URL="$(printf '%s' "$SAB_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*-src\.tar\.gz' | head -1 || true)"
if [[ -z "$SAB_URL" ]]; then
    SAB_URL="https://github.com/sabnzbd/sabnzbd/releases/download/${SAB_VERSION}/SABnzbd-${SAB_VERSION}-src.tar.gz"
fi

report_progress 55 "Downloading and extracting SABnzbd ${SAB_VERSION}..."
TMP_TAR=$(mktemp /tmp/sabnzbd-XXXXXX.tar.gz)
curl -fsSL "$SAB_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
rm -rf /opt/SABnzbd
mkdir -p /opt/SABnzbd
tar -xzf "$TMP_TAR" -C /opt/SABnzbd --strip-components=1 >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"

report_progress 75 "Building SABnzbd Python virtualenv..."
python3 -m venv /opt/SABnzbd/.venv >> "$LOGFILE" 2>&1
/opt/SABnzbd/.venv/bin/pip install --upgrade pip wheel setuptools >> "$LOGFILE" 2>&1
/opt/SABnzbd/.venv/bin/pip install -r /opt/SABnzbd/requirements.txt >> "$LOGFILE" 2>&1

printf '%s\n' "${SAB_VERSION#v}" > /opt/SABnzbd/.af-version
BASE_DOMAIN="$(get_base_domain || true)"
SAB_WHITELIST="sabnzbd.aether.local, localhost, 127.0.0.1, $(hostname -f 2>/dev/null || hostname)"
if [[ -n "$BASE_DOMAIN" ]]; then
    SAB_WHITELIST="sabnzbd.${BASE_DOMAIN}, ${SAB_WHITELIST}"
fi
if [[ ! -f /var/lib/sabnzbd/sabnzbd.ini ]]; then
    cat <<EOF > /var/lib/sabnzbd/sabnzbd.ini
__version__ = 19
__encoding__ = utf-8
[misc]
port = 8085
host = 0.0.0.0
inet_exposure = 4
host_whitelist = ${SAB_WHITELIST}
EOF
fi
chown -R sabnzbd:sabnzbd /opt/SABnzbd /var/lib/sabnzbd

report_progress 90 "Configuring and starting sabnzbd.service on port 8085..."
cat <<'EOF' > /etc/systemd/system/sabnzbd.service
[Unit]
Description=SABnzbd Usenet Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sabnzbd
Group=sabnzbd
WorkingDirectory=/opt/SABnzbd
ExecStart=/opt/SABnzbd/.venv/bin/python3 /opt/SABnzbd/SABnzbd.py -f /var/lib/sabnzbd/sabnzbd.ini -s 0.0.0.0:8085 -b 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now sabnzbd >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "SABnzbd installed on port 8085."
log_info "${PACKAGE_NAME} installed successfully"
