#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="sabnzbd"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8085}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install /run/lock
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
exec 9>/run/lock/aetherflow-sabnzbd.lock
flock -n 9 || { log_error "Another SABnzbd installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/sabnzbd/sabnzbd.ini
if [[ -f /var/lib/sabnzbd/sabnzbd.ini ]]; then
    set_config_file_mode 0600 /var/lib/sabnzbd/sabnzbd.ini
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/sabnzbd.service ]] || systemctl is-active --quiet sabnzbd 2>/dev/null || systemctl is-enabled --quiet sabnzbd 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$VENV_MOVED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            if ! quiesce_services_for_rollback sabnzbd; then
                restore_failed=true
                [[ -z "$BUILD_DIR" || ! -d "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"
                print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
                exit 1
            fi
            if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
                restore_app_state "$BACKUP_DIR" || {
                    restore_failed=true
                    [[ -z "$BUILD_DIR" || ! -d "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"
                    print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
                    exit 1
                }
            fi
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/SABnzbd "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/SABnzbd || restore_failed=true
        elif [[ "$VENV_ACTIVATED" -eq 1 || "$VENV_MOVED" -eq 1 ]]; then
            rm -rf /opt/SABnzbd/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            rm -rf /opt/SABnzbd 2>/dev/null || true
            mv "$BACKUP_DIR/app" /opt/SABnzbd 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            rm -rf /opt/SABnzbd/.venv 2>/dev/null || true
            mv "$BACKUP_DIR/venv" /opt/SABnzbd/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/sabnzbd.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/sabnzbd.service" /etc/systemd/system/sabnzbd.service || restore_failed=true
            else
                af_logged systemctl disable sabnzbd || restore_failed=true
                rm -f /etc/systemd/system/sabnzbd.service || restore_failed=true
            fi
            af_logged systemctl daemon-reload || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            if ! af_logged systemctl start sabnzbd || ! systemctl is-active --quiet sabnzbd 2>/dev/null; then
                restore_failed=true
            fi
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python, build, and archive dependencies for SABnzbd..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    curl tar ca-certificates python3 python3-venv python3-pip python3-dev \
    build-essential libffi-dev libssl-dev p7zip-full par2 unzip

if ! id -u sabnzbd >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/sabnzbd --shell /usr/sbin/nologin sabnzbd
fi

mkdir -p /var/lib/sabnzbd /opt /var/backups

report_progress 35 "Resolving latest SABnzbd release..."
SAB_VERSION="$(github_latest_tag "sabnzbd/sabnzbd" "4.3.3")"
SAB_URL="https://github.com/sabnzbd/sabnzbd/releases/download/${SAB_VERSION}/SABnzbd-${SAB_VERSION}-src.tar.gz"

report_progress 55 "Downloading and extracting SABnzbd ${SAB_VERSION} into staging directory..."
BUILD_DIR="$(mktemp -d /opt/.sabnzbd-build.XXXXXX)"
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_TAR=$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/sabnzbd-XXXXXX.tar.gz")
af_logged download_file "$SAB_URL" "$TMP_TAR"
af_validate_tar_archive "$TMP_TAR"
af_logged tar --no-same-owner --no-same-permissions -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1
rm -f "$TMP_TAR"
test -s "$BUILD_DIR/SABnzbd.py" || { log_error "Failed to verify SABnzbd archive extraction"; exit 1; }

report_progress 70 "Building SABnzbd Python virtualenv..."
validate_config_paths /var/backups/.af-backup-root
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-sabnzbd.XXXXXX)"
chmod 700 "$BACKUP_DIR"
stop_systemd_unit sabnzbd
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/sabnzbd
if [[ -f /etc/systemd/system/sabnzbd.service ]]; then
    cp -a /etc/systemd/system/sabnzbd.service "$BACKUP_DIR/sabnzbd.service"
fi
BUILD_HOME="$BUILD_DIR/.build-home"
mkdir -p "$BUILD_HOME"
chmod 755 "$BUILD_DIR"
chmod 700 "$BUILD_HOME"
chown -hRP sabnzbd:sabnzbd "$BUILD_DIR" /var/lib/sabnzbd
run_as_sabnzbd_builder() {
    if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u sabnzbd -- env -i \
            PATH="/usr/local/bin:/usr/bin:/bin" \
            HOME="${BUILD_HOME:-/nonexistent}" \
            XDG_CONFIG_HOME="${BUILD_HOME:-/nonexistent}/.config" \
            PIP_CONFIG_FILE="/dev/null" \
            PIP_DISABLE_PIP_VERSION_CHECK="1" \
            USER="sabnzbd" \
            LOGNAME="sabnzbd" \
            LANG="C.UTF-8" \
            PYTHONNOUSERSITE="1" \
            "$@"
    else
        "$@"
    fi
}
af_logged run_as_sabnzbd_builder python3 -m venv "$BUILD_DIR/.venv"
af_logged run_as_sabnzbd_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir --upgrade pip wheel setuptools
af_logged run_as_sabnzbd_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir -r "$BUILD_DIR/requirements.txt"
test -x "$BUILD_DIR/.venv/bin/python3" || { log_error "Failed to verify SABnzbd virtual environment"; exit 1; }
run_as_sabnzbd_builder python3 -I - "$BUILD_DIR/.venv" "/opt/SABnzbd/.venv" <<'VENV_PYEOF'
import os, pathlib, stat, sys
old_venv, new_venv = sys.argv[1], sys.argv[2]
old_bytes, new_bytes = old_venv.encode(), new_venv.encode()
bin_dir = pathlib.Path(old_venv) / "bin"
if bin_dir.is_dir():
    for entry in bin_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            continue
        data = entry.read_bytes()
        updated = data
        if data.startswith(b"#!") and old_bytes in data.splitlines()[0]:
            first, sep, rest = data.partition(b"\n")
            updated = first.replace(old_bytes, new_bytes) + sep + rest
        elif entry.name.startswith("activate"):
            updated = data.replace(old_bytes, new_bytes)
        if updated != data:
            mode = stat.S_IMODE(entry.stat().st_mode)
            entry.write_bytes(updated)
            os.chmod(entry, mode)
VENV_PYEOF
if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
    pkill -9 -u sabnzbd 2>/dev/null || true
fi
BUILD_HOME="/nonexistent"

# Reclaim $BUILD_DIR strictly via dirfd + O_NOFOLLOW (rejecting hardlinks, special files,
# and escaping/chained symlinks) before touching /opt/SABnzbd or /var/lib/sabnzbd.
python3 -I - "$BUILD_DIR" <<'PYRECLAIM'
import os, pathlib, stat, sys

build_root = os.path.abspath(sys.argv[1])
is_root = os.geteuid() == 0
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)

def open_dir_nofollow(path_str):
    p = pathlib.PurePosixPath(os.path.abspath(path_str))
    if ".." in p.parts:
        raise RuntimeError(f"traversal in {path_str}")
    cur = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    try:
        for part in p.parts[1:]:
            nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur)
            os.close(cur)
            cur = nxt
        return cur
    except BaseException:
        os.close(cur)
        raise

def rmtree_dirfd(parent_fd, name):
    st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISDIR(st.st_mode):
        dfd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=parent_fd)
        try:
            for entry in os.listdir(dfd):
                rmtree_dirfd(dfd, entry)
        finally:
            os.close(dfd)
        os.rmdir(name, dir_fd=parent_fd)
    else:
        os.unlink(name, dir_fd=parent_fd)

def norm_go_w_a_rx(mode, is_dir):
    perm = stat.S_IMODE(mode) & 0o755
    perm |= 0o444
    if is_dir or (perm & 0o111):
        perm |= 0o111
    return perm

def verify_relative_target_confined(root_fd, rel_parts, target):
    if os.path.isabs(target):
        return False
    stack = list(rel_parts)
    for part in pathlib.PurePosixPath(target).parts:
        if part in ("", "."):
            continue
        if part == "..":
            if not stack:
                return False
            stack.pop()
        else:
            stack.append(part)
    if not stack:
        return True
    cur = os.dup(root_fd)
    try:
        for comp in stack[:-1]:
            nxt = os.open(comp, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur)
            os.close(cur)
            cur = nxt
        try:
            st = os.stat(stack[-1], dir_fd=cur, follow_symlinks=False)
        except FileNotFoundError:
            return False
        return stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)
    except OSError:
        return False
    finally:
        os.close(cur)

def is_allowed_venv_python_symlink(child_rel, target):
    if len(child_rel) != 3 or child_rel[0] != ".venv" or child_rel[1] != "bin":
        return False
    if not child_rel[2].startswith("python"):
        return False
    if target.startswith("/usr/bin/python3") and ".." not in pathlib.PurePosixPath(target).parts:
        try:
            st = os.lstat(target)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode):
            resolved = os.path.realpath(target)
            if not resolved.startswith("/usr/bin/python3"):
                return False
            rst = os.stat(resolved)
            return stat.S_ISREG(rst.st_mode) and rst.st_uid == 0 and (rst.st_mode & 0o022) == 0
        return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and (st.st_mode & 0o022) == 0
    return target in ("python3", "python") or (target.startswith("python3.") and "/" not in target)

def reclaim_tree(root_fd, dfd, rel_parts):
    if is_root:
        os.fchown(dfd, 0, 0)
    dst = os.fstat(dfd)
    os.fchmod(dfd, norm_go_w_a_rx(dst.st_mode, True))
    for name in os.listdir(dfd):
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        child_rel = rel_parts + (name,)
        if stat.S_ISLNK(st.st_mode):
            target = os.readlink(name, dir_fd=dfd)
            allowed = (
                is_allowed_venv_python_symlink(child_rel, target)
                or (child_rel == (".venv", "lib64") and target == "lib")
                or verify_relative_target_confined(root_fd, rel_parts, target)
            )
            if not allowed:
                raise RuntimeError(f"forbidden symlink in build dir: {'/'.join(child_rel)} -> {target}")
            if is_root:
                os.chown(name, 0, 0, dir_fd=dfd, follow_symlinks=False)
        elif stat.S_ISDIR(st.st_mode):
            sub_fd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=dfd)
            try:
                reclaim_tree(root_fd, sub_fd, child_rel)
            finally:
                os.close(sub_fd)
        elif stat.S_ISREG(st.st_mode):
            ffd = os.open(name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=dfd)
            try:
                fst = os.fstat(ffd)
                if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                    raise RuntimeError(f"non-regular or hardlinked file in build dir: {'/'.join(child_rel)}")
                if is_root:
                    os.fchown(ffd, 0, 0)
                os.fchmod(ffd, norm_go_w_a_rx(fst.st_mode, False))
            finally:
                os.close(ffd)
        else:
            raise RuntimeError(f"forbidden special file in build dir: {'/'.join(child_rel)}")

build_fd = open_dir_nofollow(build_root)
try:
    try:
        os.stat(".build-home", dir_fd=build_fd, follow_symlinks=False)
        has_bh = True
    except FileNotFoundError:
        has_bh = False
    if has_bh:
        rmtree_dirfd(build_fd, ".build-home")
    reclaim_tree(build_fd, build_fd, ())
finally:
    os.close(build_fd)
PYRECLAIM

queue_app_version "/opt/SABnzbd/.af-version" "${SAB_VERSION#v}" "$BUILD_DIR" "$BACKUP_DIR"
BASE_DOMAIN="$(get_base_domain || true)"
SAB_WHITELIST="sabnzbd.aether.local, localhost, 127.0.0.1, $(hostname -f 2>/dev/null || hostname)"
if [[ -n "$BASE_DOMAIN" ]]; then
    SAB_WHITELIST="sabnzbd.${BASE_DOMAIN}, ${SAB_WHITELIST}"
fi
if [[ ! -f /var/lib/sabnzbd/sabnzbd.ini ]]; then
    SAB_WEB_PASS="$(derive_app_password sabnzbd "${MASTER_PASS}")"
    (umask 077; write_config_file /var/lib/sabnzbd/sabnzbd.ini 0600 <<EOF
__version__ = 19
__encoding__ = utf-8
[misc]
port = ${APP_PORT}
host = 127.0.0.1
inet_exposure = 0
host_whitelist = ${SAB_WHITELIST}
username = ${MASTER_USER}
password = ${SAB_WEB_PASS}
EOF
    )
fi
set_config_file_mode 0600 /var/lib/sabnzbd/sabnzbd.ini
python3 -I - /var/lib/sabnzbd sabnzbd <<'PYSTATE'
import os, pathlib, pwd, stat, sys

state_root = os.path.abspath(sys.argv[1])
user_name = sys.argv[2]
if os.geteuid() != 0:
    raise SystemExit(0)
pw = pwd.getpwnam(user_name)
uid, gid = pw.pw_uid, pw.pw_gid
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)

def open_dir_nofollow(path_str):
    p = pathlib.PurePosixPath(os.path.abspath(path_str))
    if ".." in p.parts:
        raise RuntimeError(f"traversal in {path_str}")
    cur = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    try:
        for part in p.parts[1:]:
            nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur)
            os.close(cur)
            cur = nxt
        return cur
    except BaseException:
        os.close(cur)
        raise

def fchown_tree_no_symlinks(dfd):
    os.fchown(dfd, uid, gid)
    for name in os.listdir(dfd):
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode):
            raise RuntimeError(f"forbidden symlink in state dir: {name}")
        if stat.S_ISDIR(st.st_mode):
            sub_fd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=dfd)
            try:
                fchown_tree_no_symlinks(sub_fd)
            finally:
                os.close(sub_fd)
        elif stat.S_ISREG(st.st_mode):
            ffd = os.open(name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=dfd)
            try:
                fst = os.fstat(ffd)
                if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                    raise RuntimeError(f"non-regular or hardlinked file in state dir: {name}")
                os.fchown(ffd, uid, gid)
            finally:
                os.close(ffd)
        else:
            raise RuntimeError(f"forbidden special file in state dir: {name}")

sfd = open_dir_nofollow(state_root)
try:
    fchown_tree_no_symlinks(sfd)
finally:
    os.close(sfd)
PYSTATE

report_progress 80 "Backing up existing SABnzbd installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    stop_systemd_unit sabnzbd
    SERVICE_STOPPED=1
fi
if [[ -d /opt/SABnzbd ]]; then
    mv /opt/SABnzbd "$BACKUP_DIR/app"
    APP_MOVED=1
fi
mv "$BUILD_DIR" /opt/SABnzbd
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/SABnzbd

set_config_value /var/lib/sabnzbd/sabnzbd.ini ini port "$APP_PORT" misc

report_progress 90 "Configuring and starting sabnzbd.service on port ${APP_PORT}..."
SAB_BIND_HOST="$(retained_bind_address /var/lib/sabnzbd/sabnzbd.ini '^\s*host\s*=\s*([^\r\n#;]+)')"
if [[ "$SAB_BIND_HOST" == *:* && "$SAB_BIND_HOST" != \[*\] ]]; then
    SAB_BIND_HOST="[$SAB_BIND_HOST]"
fi
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_BIND_HOST@/${SAB_BIND_HOST}/g" <<'EOF' | write_config_file /etc/systemd/system/sabnzbd.service 0644
[Unit]
Description=SABnzbd Usenet Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sabnzbd
Group=sabnzbd
WorkingDirectory=/opt/SABnzbd
ExecStart=/opt/SABnzbd/.venv/bin/python3 /opt/SABnzbd/SABnzbd.py -f /var/lib/sabnzbd/sabnzbd.ini -s @AF_BIND_HOST@:@AF_APP_PORT@ -b 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

af_logged systemctl daemon-reload
af_logged systemctl enable --now sabnzbd

READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
wait_for_service_ready "sabnzbd.service" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "SABnzbd installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
