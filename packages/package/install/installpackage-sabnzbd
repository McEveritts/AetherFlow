#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="sabnzbd"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8085}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-sabnzbd.lock
flock -n 9 || { log_error "Another SABnzbd installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/sabnzbd/sabnzbd.ini
if [[ -f /var/lib/sabnzbd/sabnzbd.ini ]]; then
    set_config_file_mode 0600 /var/lib/sabnzbd/sabnzbd.ini
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/sabnzbd.service ]] || systemctl is-active --quiet sabnzbd 2>/dev/null || systemctl is-enabled --quiet sabnzbd 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback sabnzbd || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/SABnzbd "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/SABnzbd
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/SABnzbd/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/SABnzbd 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/SABnzbd/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/sabnzbd.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/sabnzbd.service" /etc/systemd/system/sabnzbd.service || restore_failed=true
            else
                systemctl disable sabnzbd >> "$LOGFILE" 2>&1 || restore_failed=true
                rm -f /etc/systemd/system/sabnzbd.service || restore_failed=true
            fi
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            systemctl start sabnzbd >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python, build, and archive dependencies for SABnzbd..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl tar ca-certificates python3 python3-venv python3-pip python3-dev \
    build-essential libffi-dev libssl-dev p7zip-full par2 unzip >> "$LOGFILE" 2>&1

if ! id -u sabnzbd >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/sabnzbd --shell /usr/sbin/nologin sabnzbd
fi

mkdir -p /var/lib/sabnzbd /opt /var/backups

report_progress 35 "Resolving latest SABnzbd release..."
SAB_VERSION="$(github_latest_tag "sabnzbd/sabnzbd" "4.3.3")"
SAB_URL="https://github.com/sabnzbd/sabnzbd/releases/download/${SAB_VERSION}/SABnzbd-${SAB_VERSION}-src.tar.gz"

report_progress 55 "Downloading and extracting SABnzbd ${SAB_VERSION} into staging directory..."
BUILD_DIR="$(mktemp -d /opt/.sabnzbd-build.XXXXXX)"
TMP_TAR=$(mktemp /tmp/sabnzbd-XXXXXX.tar.gz)
download_file "$SAB_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1 >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
test -s "$BUILD_DIR/SABnzbd.py" || { log_error "Failed to verify SABnzbd archive extraction"; exit 1; }

report_progress 70 "Building SABnzbd Python virtualenv..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-sabnzbd.XXXXXX)"
chmod 700 "$BACKUP_DIR"
stop_systemd_unit sabnzbd
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/sabnzbd
if [[ -f /etc/systemd/system/sabnzbd.service ]]; then
    cp -a /etc/systemd/system/sabnzbd.service "$BACKUP_DIR/sabnzbd.service"
fi
mkdir -p /opt/SABnzbd
if [[ -e /opt/SABnzbd/.venv || -L /opt/SABnzbd/.venv ]]; then
    if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
        stop_systemd_unit sabnzbd
        SERVICE_STOPPED=1
    fi
    mv /opt/SABnzbd/.venv "$BACKUP_DIR/venv"
    VENV_MOVED=1
fi
python3 -m venv /opt/SABnzbd/.venv >> "$LOGFILE" 2>&1
VENV_ACTIVATED=1
/opt/SABnzbd/.venv/bin/pip install --upgrade pip wheel setuptools >> "$LOGFILE" 2>&1
/opt/SABnzbd/.venv/bin/pip install -r "$BUILD_DIR/requirements.txt" >> "$LOGFILE" 2>&1
test -x /opt/SABnzbd/.venv/bin/python3 || { log_error "Failed to verify SABnzbd virtual environment"; exit 1; }

queue_app_version "/opt/SABnzbd/.af-version" "${SAB_VERSION#v}" "$BUILD_DIR" "$BACKUP_DIR"
BASE_DOMAIN="$(get_base_domain || true)"
SAB_WHITELIST="sabnzbd.aether.local, localhost, 127.0.0.1, $(hostname -f 2>/dev/null || hostname)"
if [[ -n "$BASE_DOMAIN" ]]; then
    SAB_WHITELIST="sabnzbd.${BASE_DOMAIN}, ${SAB_WHITELIST}"
fi
if [[ ! -f /var/lib/sabnzbd/sabnzbd.ini ]]; then
    (umask 077; write_config_file /var/lib/sabnzbd/sabnzbd.ini 0600 <<EOF
__version__ = 19
__encoding__ = utf-8
[misc]
port = ${APP_PORT}
host = 127.0.0.1
inet_exposure = 0
host_whitelist = ${SAB_WHITELIST}
username = ${MASTER_USER}
password = ${MASTER_PASS}
EOF
    )
fi
set_config_file_mode 0600 /var/lib/sabnzbd/sabnzbd.ini
chown -hRP sabnzbd:sabnzbd /opt/SABnzbd/.venv "$BUILD_DIR" /var/lib/sabnzbd

report_progress 80 "Backing up existing SABnzbd installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    stop_systemd_unit sabnzbd
    SERVICE_STOPPED=1
fi
mv /opt/SABnzbd/.venv "$BUILD_DIR/.venv"
VENV_ACTIVATED=0
if [[ -d /opt/SABnzbd ]]; then
    mv /opt/SABnzbd "$BACKUP_DIR/app"
    APP_MOVED=1
    if [[ "$VENV_MOVED" -eq 1 ]]; then
        mv "$BACKUP_DIR/venv" "$BACKUP_DIR/app/.venv"
    fi
fi
mv "$BUILD_DIR" /opt/SABnzbd
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/SABnzbd

set_config_value /var/lib/sabnzbd/sabnzbd.ini ini port "$APP_PORT" misc

report_progress 90 "Configuring and starting sabnzbd.service on port ${APP_PORT}..."
SAB_BIND_HOST="$(retained_bind_address /var/lib/sabnzbd/sabnzbd.ini '^\s*host\s*=\s*([^\r\n#;]+)')"
if [[ "$SAB_BIND_HOST" == *:* && "$SAB_BIND_HOST" != \[*\] ]]; then
    SAB_BIND_HOST="[$SAB_BIND_HOST]"
fi
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_BIND_HOST@/${SAB_BIND_HOST}/g" <<'EOF' > /etc/systemd/system/sabnzbd.service
[Unit]
Description=SABnzbd Usenet Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sabnzbd
Group=sabnzbd
WorkingDirectory=/opt/SABnzbd
ExecStart=/opt/SABnzbd/.venv/bin/python3 /opt/SABnzbd/SABnzbd.py -f /var/lib/sabnzbd/sabnzbd.ini -s @AF_BIND_HOST@:@AF_APP_PORT@ -b 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now sabnzbd >> "$LOGFILE" 2>&1

READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
wait_for_service_ready "sabnzbd.service" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "SABnzbd installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
