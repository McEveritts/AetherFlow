#!/bin/bash
# AetherFlow Package Installer: Organizr
# Port: 8086 (and Apache /organizr alias)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="organizr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Apache and PHP dependencies for Organizr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    apache2 libapache2-mod-php git curl unzip ca-certificates \
    php php-cli php-fpm php-sqlite3 php-curl php-zip php-xml php-mbstring php-gd >> "$LOGFILE" 2>&1

report_progress 45 "Cloning Organizr v2 repository..."
rm -rf /var/www/organizr
git clone --depth 1 -b v2-master https://github.com/causefx/Organizr.git /var/www/organizr >> "$LOGFILE" 2>&1
ORG_VER="$(grep -oE '[0-9]+\.[0-9]+\.[0-9]+' /var/www/organizr/api/config/default.php 2>/dev/null | head -n1 || true)"
if [[ -n "$ORG_VER" ]]; then
    printf '%s\n' "$ORG_VER" > /var/www/organizr/.af-version
fi
chown -R www-data:www-data /var/www/organizr
chmod -R 775 /var/www/organizr

report_progress 80 "Configuring Apache VirtualHost on port 8086..."
if ! grep -q "^Listen 8086$" /etc/apache2/ports.conf 2>/dev/null; then
    echo "Listen 8086" >> /etc/apache2/ports.conf
fi

cat <<'EOF' > /etc/apache2/sites-available/organizr.conf
Alias /organizr "/var/www/organizr"

<Directory /var/www/organizr>
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php index.html
</Directory>

<VirtualHost *:8086>
    DocumentRoot /var/www/organizr
    <Directory /var/www/organizr>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html
    </Directory>
</VirtualHost>
EOF

a2enmod rewrite headers env dir mime >> "$LOGFILE" 2>&1
a2ensite organizr.conf >> "$LOGFILE" 2>&1
systemctl enable --now apache2 >> "$LOGFILE" 2>&1
systemctl reload apache2 >> "$LOGFILE" 2>&1 || systemctl restart apache2 >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Organizr installed on port 8086."
log_info "${PACKAGE_NAME} installed successfully"
