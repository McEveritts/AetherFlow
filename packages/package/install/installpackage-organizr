#!/bin/bash
# AetherFlow Package Installer: Organizr
# Port: 8086 (and Apache /organizr alias)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="organizr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8086}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /var/www/organizr/.af-directory-check
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Apache and PHP dependencies for Organizr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    apache2 libapache2-mod-php git curl unzip ca-certificates \
    php php-cli php-fpm php-sqlite3 php-curl php-zip php-xml php-mbstring php-gd

report_progress 45 "Cloning Organizr repository..."
REPO_URL="https://github.com/causefx/Organizr.git"
BUILD_DIR="$(mktemp -d /var/www/.organizr-build.XXXXXX)"
trap '[[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"' EXIT
git_stage_exact_revision "$REPO_URL" "$BUILD_DIR" "${AF_TARGET_VERSION:-}"
ORGANIZR_VERSION="${AF_STAGED_GIT_VERSION#release-}"
ORGANIZR_VERSION="${ORGANIZR_VERSION#Release-}"
ORGANIZR_VERSION="${ORGANIZR_VERSION#[vV]}"
RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-web-runtime-")"
APACHE_CONFIG_BACKED_UP=false
RUNTIME_SNAPSHOT_READY=false
RUNTIME_STOPPED=false
INSTALL_COMMITTED=false
AF_APACHE_QUIESCE_MODE=""
AF_APACHE_IN_MAINTENANCE=false
AF_APACHE_ACTIVATED_NEW_VHOST=false
RUNTIME_PATHS=(
    "/var/www/organizr"
    "/var/lib/organizr"
    "/etc/apache2/sites-available/organizr.conf"
    "/etc/apache2/sites-enabled/organizr.conf"
    "/etc/apache2/conf-available/aetherflow-organizr-listen.conf"
    "/etc/apache2/conf-enabled/aetherflow-organizr-listen.conf"
)
rollback_web_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_SNAPSHOT_READY" == true ]]; then
        apache_app_quiesce_for_rollback "${PACKAGE_NAME}" "$APP_PORT" "/" "$RUNTIME_BACKUP" || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        [[ "$restore_failed" == false ]] && apache_app_resume_after_rollback "${PACKAGE_NAME}" "$RUNTIME_BACKUP" || restore_failed=true
    elif [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && ( "$APACHE_CONFIG_BACKED_UP" == true || "$RUNTIME_STOPPED" == true ) ]]; then
        if [[ "$APACHE_CONFIG_BACKED_UP" == true ]]; then
            for runtime_index in "${!RUNTIME_PATHS[@]}"; do
                runtime_path="${RUNTIME_PATHS[$runtime_index]}"
                case "$runtime_path" in
                    */etc/apache2/sites-*|*/etc/apache2/conf-*)
                        safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
                        ;;
                esac
            done
        fi
        [[ "$restore_failed" == false ]] && apache_app_resume_after_rollback "${PACKAGE_NAME}" "$RUNTIME_BACKUP" || restore_failed=true
    fi
    [[ -z "${BUILD_DIR:-}" ]] || rm -rf -- "$BUILD_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}

trap rollback_web_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    case "$runtime_path" in
        */etc/apache2/sites-*|*/etc/apache2/conf-*)
            if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
                cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
            fi
            ;;
    esac
done
APACHE_CONFIG_BACKED_UP=true
apache_app_enter_maintenance "${PACKAGE_NAME}" "$APP_PORT" "/" "$RUNTIME_BACKUP"
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    case "$runtime_path" in
        */etc/apache2/sites-*|*/etc/apache2/conf-*) continue ;;
    esac
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
RUNTIME_SNAPSHOT_READY=true
if [[ -d /var/www/organizr ]]; then
    find /var/www/organizr -mindepth 1 -maxdepth 1 -type f \
        ! -name '*.php' ! -name '*.js' ! -name '*.css' ! -name '*.html' ! -name '*.map' \
        ! -name .af-version ! -name composer.json ! -name composer.lock \
        ! -name package.json ! -name package-lock.json -exec cp -a -t "$BUILD_DIR" -- {} +
fi
if [[ -d /var/www/organizr/api/config ]]; then
    mkdir -p "$BUILD_DIR/api/config"
    cp -a -- /var/www/organizr/api/config/. "$BUILD_DIR/api/config/"
fi
replace_app_tree "$BUILD_DIR" /var/www/organizr api/db
BUILD_DIR=""
queue_app_version /var/www/organizr/.af-version "${ORGANIZR_VERSION}"
chown -hRP www-data:www-data /var/www/organizr
find -P /var/www/organizr -type d -exec chmod 0750 -- {} +
find -P /var/www/organizr -type f -exec chmod 0640 -- {} +
if [[ -d /var/www/organizr/api/config && ! -L /var/www/organizr/api/config ]]; then
    chmod 0700 -- /var/www/organizr/api/config
    if [[ -f /var/www/organizr/api/config/config.php && ! -L /var/www/organizr/api/config/config.php ]]; then
        chmod 0600 -- /var/www/organizr/api/config/config.php
    fi
fi
if [[ -d /var/www/organizr/api/db && ! -L /var/www/organizr/api/db ]]; then
    chmod 0700 -- /var/www/organizr/api/db
    find -P /var/www/organizr/api/db -type f -exec chmod 0600 -- {} +
fi

report_progress 80 "Configuring Apache VirtualHost on port ${APP_PORT}..."
configure_apache_app_listener "$PACKAGE_NAME" "$APP_PORT"

ORG_VHOST_HOST="127.0.0.1"
if [[ "${AF_APACHE_LISTEN_ALL:-0}" == "1" ]]; then
    ORG_VHOST_HOST="0.0.0.0"
fi
validate_config_paths /etc/apache2/sites-available/organizr.conf
if [[ -s /etc/apache2/sites-available/organizr.conf ]]; then
    safe_config_python /etc/apache2/sites-available/organizr.conf "${ORG_VHOST_HOST}" "${APP_PORT}" <<'ORG_VHOST_PYEOF'
import re, sys
path, vhost_host, port = sys.argv[1], sys.argv[2], sys.argv[3]
existing = safe_read_text(path)
updated = re.sub(
    r"<VirtualHost\s+([^:>]+):[0-9]+>",
    lambda m: f"<VirtualHost {vhost_host if m.group(1) in ('*', '0.0.0.0', '127.0.0.1') else m.group(1)}:{port}>",
    existing,
)
if "ProxyFCGISetEnvIf" not in updated and "<VirtualHost" in updated:
    fcgi_block = (
        "    <IfModule proxy_fcgi_module>\n"
        "        ProxyFCGIBackendType FPM\n"
        '        ProxyFCGISetEnvIf "true" !PATH_TRANSLATED\n'
        "    </IfModule>\n"
    )
    updated = re.sub(
        r"(<VirtualHost\s+[^>]+>\r?\n)",
        r"\1" + fcgi_block,
        updated,
        count=1,
    )
if updated != existing:
    safe_write_text(path, updated, 0o644)
ORG_VHOST_PYEOF
else
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_VHOST_HOST@/${ORG_VHOST_HOST}/g" <<'EOF' | write_config_file /etc/apache2/sites-available/organizr.conf 0644
<VirtualHost @AF_VHOST_HOST@:@AF_APP_PORT@>
    DocumentRoot /var/www/organizr
    Alias /organizr "/var/www/organizr"
    <IfModule proxy_fcgi_module>
        ProxyFCGIBackendType FPM
        ProxyFCGISetEnvIf "true" !PATH_TRANSLATED
    </IfModule>
    <Directory /var/www/organizr>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html
    </Directory>
</VirtualHost>
EOF
fi

apache_app_activate_vhost "${PACKAGE_NAME}" "$RUNTIME_BACKUP"

systemctl is-active --quiet apache2
wait_for_apache_app_ready "${PACKAGE_NAME}" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
INSTALL_COMMITTED=true
report_progress 100 "Organizr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
