#!/bin/bash
# AetherFlow Package Installer: Organizr
# Port: 8086 (and Apache /organizr alias)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="organizr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8086}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /var/www/organizr/.af-directory-check
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Apache and PHP dependencies for Organizr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    apache2 libapache2-mod-php git curl unzip ca-certificates \
    php php-cli php-fpm php-sqlite3 php-curl php-zip php-xml php-mbstring php-gd >> "$LOGFILE" 2>&1

report_progress 45 "Cloning Organizr repository..."
REPO_URL="https://github.com/causefx/Organizr.git"
FALLBACK_TAG="v2.1.2410"
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_TAG="$AF_TARGET_VERSION"
else
    TARGET_TAG="$(git ls-remote --tags --refs "$REPO_URL" 2>/dev/null | sed 's#.*refs/tags/##' | grep -E '^v?[0-9]+(\.[0-9]+)+$' | sort -V | tail -n1 || true)"
    if [[ -z "$TARGET_TAG" ]]; then
        TARGET_TAG="$FALLBACK_TAG"
    fi
fi
if ! git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG}" >/dev/null 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG#v}" >/dev/null 2>&1; then
        TARGET_TAG="${TARGET_TAG#v}"
    elif [[ ! "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/v${TARGET_TAG}" >/dev/null 2>&1; then
        TARGET_TAG="v${TARGET_TAG}"
    else
        af_write_failure_receipt 1 "download" "invalid_target_tag" "Upstream tag refs/tags/${TARGET_TAG} not found in ${REPO_URL}"
        exit 1
    fi
fi
BUILD_DIR="$(mktemp -d /var/www/.organizr-build.XXXXXX)"
trap '[[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"' EXIT
if ! git clone --branch "$TARGET_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]]; then
        ALT_TAG="${TARGET_TAG#v}"
    else
        ALT_TAG="v${TARGET_TAG}"
    fi
    if ! git clone --branch "$ALT_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1; then
        log_error "Failed to clone Organizr repository at tag $TARGET_TAG"
        exit 1
    else
        TARGET_TAG="$ALT_TAG"
    fi
fi
RUNTIME_BACKUP="$(mktemp -d /tmp/af-web-runtime-XXXXXX)"
RUNTIME_SNAPSHOT_READY=false
RUNTIME_STOPPED=false
RUNTIME_PATHS=("/var/www/organizr" "/var/lib/organizr" "/etc/apache2/sites-available/organizr.conf" "/etc/apache2/conf-available/aetherflow-organizr-listen.conf")
rollback_web_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_SNAPSHOT_READY" == true ]]; then
        quiesce_services_for_rollback apache2 || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
    fi
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_STOPPED" == true ]]; then
        [[ "$restore_failed" == false ]] && apache2ctl configtest >> "$LOGFILE" 2>&1 && systemctl start apache2 >> "$LOGFILE" 2>&1 || restore_failed=true
    fi
    [[ -z "${BUILD_DIR:-}" ]] || rm -rf -- "$BUILD_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}

trap rollback_web_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
stop_systemd_unit apache2
RUNTIME_STOPPED=true
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
RUNTIME_SNAPSHOT_READY=true
if [[ -d /var/www/organizr ]]; then
    find /var/www/organizr -mindepth 1 -maxdepth 1 -type f \
        ! -name '*.php' ! -name '*.js' ! -name '*.css' ! -name '*.html' ! -name '*.map' \
        ! -name .af-version ! -name composer.json ! -name composer.lock \
        ! -name package.json ! -name package-lock.json -exec cp -a -t "$BUILD_DIR" -- {} +
fi
if [[ -d /var/www/organizr/api/config ]]; then
    mkdir -p "$BUILD_DIR/api/config"
    cp -a -- /var/www/organizr/api/config/. "$BUILD_DIR/api/config/"
fi
replace_app_tree "$BUILD_DIR" /var/www/organizr api/db
BUILD_DIR=""
queue_app_version /var/www/organizr/.af-version "${TARGET_TAG#v}"
chown -hRP www-data:www-data /var/www/organizr
find -P /var/www/organizr \( -type d -o -type f \) -exec chmod 775 -- {} +

report_progress 80 "Configuring Apache VirtualHost on port ${APP_PORT}..."
configure_apache_app_listener "$PACKAGE_NAME" "$APP_PORT"

if [[ -s /etc/apache2/sites-available/organizr.conf ]]; then
    sed -i -E "s/(<VirtualHost [^:>]+:)[0-9]+>/\1${APP_PORT}>/g" /etc/apache2/sites-available/organizr.conf
else
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/apache2/sites-available/organizr.conf
Alias /organizr "/var/www/organizr"

<Directory /var/www/organizr>
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php index.html
</Directory>

<VirtualHost *:@AF_APP_PORT@>
    DocumentRoot /var/www/organizr
    <Directory /var/www/organizr>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html
    </Directory>
</VirtualHost>
EOF
fi

a2enmod rewrite headers env dir mime >> "$LOGFILE" 2>&1
a2ensite organizr.conf >> "$LOGFILE" 2>&1
systemctl enable --now apache2 >> "$LOGFILE" 2>&1
apache2ctl configtest >> "$LOGFILE" 2>&1
systemctl reload apache2 >> "$LOGFILE" 2>&1

systemctl is-active --quiet apache2

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Organizr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
