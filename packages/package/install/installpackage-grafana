#!/bin/bash
# AetherFlow Package Installer: Grafana
# Port: 3000

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="grafana"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3000}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /etc/apt/keyrings/grafana.gpg /var/lib/grafana/.af-version
PACKAGE_NAME="${PACKAGE_NAME:-grafana}"
begin_state_transaction "grafana-server" "$APP_PORT" "/api/health" "/var/lib/grafana" "/etc/grafana" "/etc/apt/sources.list.d/grafana.list" "/etc/apt/keyrings/grafana.gpg" "/etc/systemd/system/grafana-server.service" "/usr/share/grafana" "/usr/sbin/grafana-server" "/usr/bin/grafana-server" "/usr/bin/grafana-cli" "/usr/share/grafana-server" "/usr/bin/grafana"

prepare_apt_package_transaction /var/lib/grafana/.af-version grafana
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing prerequisites for Grafana..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq apt-transport-https curl gnupg ca-certificates

report_progress 35 "Adding official Grafana APT repository..."
install -m 0755 -d /etc/apt/keyrings
af_logged install_apt_signing_key https://apt.grafana.com/gpg.key /etc/apt/keyrings/grafana.gpg
chmod a+r /etc/apt/keyrings/grafana.gpg
echo "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main" > /etc/apt/sources.list.d/grafana.list

report_progress 65 "Installing Grafana server..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq grafana
verify_deb_installed grafana

report_progress 85 "Configuring Grafana on port ${APP_PORT} and starting service..."
GRAFANA_NEW_DB=0
if [[ ! -s /var/lib/grafana/grafana.db ]]; then
    GRAFANA_NEW_DB=1
fi
GRAFANA_ROTATE_CREDS=0
if [[ "$GRAFANA_NEW_DB" -eq 1 ]] || ( [[ -n "${AF_CONFIG_PASS:-}" ]] && [[ "${AF_KEEP_EXISTING_SECRETS:-1}" != "1" ]] ); then
    GRAFANA_ROTATE_CREDS=1
fi
AF_SEED_USER="${MASTER_USER}" AF_SEED_PASS="${AF_CONFIG_PASS:-$MASTER_PASS}" safe_config_python /etc/grafana/grafana.ini "$GRAFANA_ROTATE_CREDS" <<'PYEOF'
import os, sys, re
path, rotate = sys.argv[1], sys.argv[2]
user, pw = os.environ['AF_SEED_USER'], os.environ['AF_SEED_PASS']
with ManagedConfig(path) as config:
    if config.metadata is not None:
        text = config.read_text()
        text = re.sub(r"(?m)^;?http_port\s*=.*$", 'http_port = ' + os.environ['AF_APP_PORT'], text)
        text = re.sub(r"(?m)^serve_from_sub_path = true$", ';serve_from_sub_path = false', text)
        if rotate == '1':
            text = re.sub(r"(?m)^;?admin_user\s*=.*$", lambda _: f"admin_user = {user}", text)
            text = re.sub(r"(?m)^;?admin_password\s*=.*$", lambda _: f"admin_password = {pw}", text)
        config.write_text(text)
PYEOF

GRAFANA_VER="$(dpkg-query -W -f='${Version}' grafana 2>/dev/null || echo "11.0.0")"
mkdir -p /var/lib/grafana
queue_app_version /var/lib/grafana/.af-version "${GRAFANA_VER%%-*}"

af_logged systemctl daemon-reload
af_logged systemctl enable --now grafana-server
af_logged systemctl restart grafana-server
systemctl is-active --quiet grafana-server
if [[ "$GRAFANA_ROTATE_CREDS" -eq 1 ]] && command_exists grafana-cli; then
    printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | af_logged grafana-cli admin reset-admin-password --password-from-stdin || true
fi

commit_app_versions
chown grafana:grafana /var/lib/grafana/.af-version 2>/dev/null || true
write_lock "${PACKAGE_NAME}"
report_progress 100 "Grafana installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
