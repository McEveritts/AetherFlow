#!/bin/bash
# AetherFlow Package Installer: Transmission (transmission-daemon)
# Port: 9091

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="transmission"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing transmission-daemon and transmission-cli..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq transmission-cli transmission-common transmission-daemon curl ca-certificates >> "$LOGFILE" 2>&1

systemctl stop transmission-daemon >> "$LOGFILE" 2>&1 || true

# Remove any legacy transmission.service unit so transmission-daemon.service is canonical
rm -f /etc/systemd/system/transmission.service

if ! id -u debian-transmission >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/transmission-daemon --shell /usr/sbin/nologin debian-transmission
fi

report_progress 45 "Configuring Transmission daemon on port 9091..."
mkdir -p /var/lib/transmission-daemon/.config/transmission-daemon /var/lib/transmission-daemon/downloads /etc/transmission-daemon

python3 - "${MASTER_USER}" "${MASTER_PASS}" > /var/lib/transmission-daemon/.config/transmission-daemon/settings.json <<'PYEOF'
import sys, json
user, pw = sys.argv[1], sys.argv[2]
cfg = {
    "download-dir": "/var/lib/transmission-daemon/downloads",
    "incomplete-dir": "/var/lib/transmission-daemon/downloads",
    "incomplete-dir-enabled": False,
    "rpc-authentication-required": True,
    "rpc-username": user,
    "rpc-password": pw,
    "rpc-bind-address": "0.0.0.0",
    "rpc-enabled": True,
    "rpc-host-whitelist-enabled": False,
    "rpc-port": 9091,
    "rpc-url": "/transmission/",
    "rpc-whitelist": "127.0.0.1,::1,*.*.*.*",
    "rpc-whitelist-enabled": False,
    "umask": 2
}
print(json.dumps(cfg, indent=4))
PYEOF
cp -f /var/lib/transmission-daemon/.config/transmission-daemon/settings.json /etc/transmission-daemon/settings.json

report_progress 70 "Installing Transmission Web Control UI..."
TWC_URL="$(curl -fsSL https://api.github.com/repos/ronggang/transmission-web-control/releases/latest 2>/dev/null | grep -oP '"tarball_url":\s*"\K[^"]+' | head -1 || true)"
if [[ -n "$TWC_URL" ]]; then
    TMP_TAR=$(mktemp /tmp/twc-XXXXXX.tar.gz)
    if curl -fsSL "$TWC_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1; then
        WEB_DIR="/usr/share/transmission/web"
        mkdir -p "$WEB_DIR"
        if [[ -f "${WEB_DIR}/index.html" && ! -f "${WEB_DIR}/index.original.html" ]]; then
            cp "${WEB_DIR}/index.html" "${WEB_DIR}/index.original.html"
        fi
        tar -xzf "$TMP_TAR" --strip-components=2 -C "$WEB_DIR" --wildcards '*/src/*' >> "$LOGFILE" 2>&1 || true
    fi
    rm -f "$TMP_TAR"
fi

chown -R debian-transmission:debian-transmission /var/lib/transmission-daemon /etc/transmission-daemon

cat <<'EOF' > /etc/systemd/system/transmission-daemon.service
[Unit]
Description=Transmission BitTorrent Daemon
After=network-online.target
Wants=network-online.target

[Service]
User=debian-transmission
Group=debian-transmission
Type=simple
ExecStart=/usr/bin/transmission-daemon -f --log-error --config-dir /var/lib/transmission-daemon/.config/transmission-daemon
ExecReload=/bin/kill -s HUP $MAINPID
NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

report_progress 90 "Starting and enabling transmission-daemon.service..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now transmission-daemon >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Transmission installed on port 9091."
log_info "${PACKAGE_NAME} installed successfully"
