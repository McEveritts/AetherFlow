#!/bin/bash
#
# [AetherFlow :: Install Transmission]
# Fast, easy, and free BitTorrent client
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [transmission] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing Transmission Daemon..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y transmission-daemon transmission-cli >>"$LOGFILE" 2>&1

# Stop the default installed daemon
systemctl stop transmission-daemon >>"$LOGFILE" 2>&1 || true
systemctl disable transmission-daemon >>"$LOGFILE" 2>&1 || true

# ── Create transmission user ─────────────────────────────────────────────────
if ! id -u transmission &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /var/lib/transmission-daemon transmission
fi

# ── Directories ──────────────────────────────────────────────────────────────
log "Setting up directories..."
mkdir -p /var/lib/transmission-daemon/.config/transmission-daemon
mkdir -p /home/transmission/Downloads
chown -R transmission:transmission /var/lib/transmission-daemon
chown -R transmission:transmission /home/transmission

# ── Configuration ────────────────────────────────────────────────────────────
cat > /var/lib/transmission-daemon/.config/transmission-daemon/settings.json <<EOF
{
    "rpc-port": 9091,
    "rpc-enabled": true,
    "rpc-whitelist-enabled": false,
    "rpc-authentication-required": false,
    "download-dir": "/home/transmission/Downloads"
}
EOF
chown transmission:transmission /var/lib/transmission-daemon/.config/transmission-daemon/settings.json

# ── Transmission Web Control (Optional/Modern UI) ────────────────────────────
log "Installing Transmission Web Control..."
TWC_URL=$(curl -sL https://api.github.com/repos/ronggang/transmission-web-control/releases/latest | grep -oP '"tarball_url": "\K[^"]+')
if [[ -z "$TWC_URL" ]]; then
    log "Failed to find Web Control URL, using default UI."
else
    mkdir -p /tmp/AetherFlow/twc
    cd /tmp/AetherFlow/twc
    curl -sL "$TWC_URL" -o twc.tar.gz >>"$LOGFILE" 2>&1
    tar -xzf twc.tar.gz
    TWC_DIR=$(find . -maxdepth 1 -type d -name "ronggang-transmission-web-control*" | head -1)
    if [[ -d "$TWC_DIR/src" ]]; then
        mkdir -p /usr/share/transmission/web
        cp -r /usr/share/transmission/web/index.html /usr/share/transmission/web/index.original.html 2>/dev/null || true
        cp -r ${TWC_DIR}/src/* /usr/share/transmission/web/
    fi
    rm -rf /tmp/AetherFlow/twc
fi

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/transmission.service <<'EOF'
[Unit]
Description=Transmission BitTorrent Daemon
After=network.target

[Service]
User=transmission
Type=notify
ExecStart=/usr/bin/transmission-daemon -f --log-error
ExecReload=/bin/kill -s HUP $MAINPID
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/home/transmission/Downloads /var/lib/transmission-daemon

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable transmission.service >>"$LOGFILE" 2>&1
systemctl start transmission.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/transmission.conf <<'EOF'
<Location /transmission>
    ProxyPass http://localhost:9091/transmission
    ProxyPassReverse http://localhost:9091/transmission
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/transmission.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.transmission.lock
log "Transmission installation complete! Access at http://your-server:9091"
