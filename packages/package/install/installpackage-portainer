# License: GPL-3.0
#
set -e
set -o pipefail

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [portainer] $1" | tee -a "$LOGFILE"; }

if [[ -f /install/.portainer.lock ]]; then
    log "Portainer is already installed. Skipping."
    exit 0
fi

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl ca-certificates >>"$LOGFILE" 2>&1

# ── Architecture detection ───────────────────────────────────────────────────
ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) PORTAINER_ARCH="amd64" ;;
    arm64) PORTAINER_ARCH="arm64" ;;
    armhf) PORTAINER_ARCH="arm"   ;;
    *)     PORTAINER_ARCH="amd64" ;;
esac
log "Detected architecture: ${ARCH} → ${PORTAINER_ARCH}"

# ── Download Portainer CE binary ─────────────────────────────────────────────
log "Downloading Portainer CE..."
PORTAINER_URL="https://github.com/portainer/portainer/releases/latest/download/portainer-${PORTAINER_ARCH}.tar.gz"

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "$PORTAINER_URL" -o portainer.tar.gz >>"$LOGFILE" 2>&1

log "Extracting Portainer..."
rm -rf /opt/portainer
tar -xzf portainer.tar.gz -C /opt >>"$LOGFILE" 2>&1
rm -f portainer.tar.gz

# ── Create portainer user ────────────────────────────────────────────────────
if ! id -u portainer &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /opt/portainer portainer
fi
mkdir -p /var/lib/portainer
chown -R portainer:portainer /opt/portainer /var/lib/portainer

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/portainer.service <<'EOF'
[Unit]
Description=Portainer CE (AetherFlow Managed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portainer
Group=portainer
ExecStart=/opt/portainer/portainer --data /var/lib/portainer --bind :9000 --bind-https :9443
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/portainer

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable portainer.service >>"$LOGFILE" 2>&1
systemctl start portainer.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/portainer.conf <<'EOF'
<Location /portainer>
    ProxyPass http://localhost:9000
    ProxyPassReverse http://localhost:9000
    ProxyPreserveHost On
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/portainer.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.portainer.lock
log "Portainer installation complete! Access at https://your-server:9443"
