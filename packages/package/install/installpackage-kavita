#!/bin/bash
# AetherFlow Package Installer: Kavita
# Port: 5002

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="kavita"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-5002}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
ADMIN_RETAINED=0
for database in /opt/Kavita/config/*.db /var/lib/kavita/*.db; do
    [[ ! -s "$database" ]] || ADMIN_RETAINED=1
done
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing system runtime dependencies for Kavita..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl tar libicu-dev sqlite3 ca-certificates >> "$LOGFILE" 2>&1

if ! id -u kavita >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/kavita --shell /usr/sbin/nologin kavita
fi

mkdir -p /opt/Kavita /var/lib/kavita

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) KAV_ARCH="x64" ;;
    arm64) KAV_ARCH="arm64" ;;
    armhf) KAV_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Kavita release (${KAV_ARCH})..."
KAV_VERSION="$(github_latest_tag "Kareadita/Kavita" "0.8.2")"
KAV_URL="https://github.com/Kareadita/Kavita/releases/download/v${KAV_VERSION}/kavita-linux-${KAV_ARCH}.tar.gz"

report_progress 60 "Downloading and extracting Kavita ${KAV_VERSION}..."
TMP_TAR=$(mktemp /tmp/kavita-XXXXXX.tar.gz)
download_file "$KAV_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
BUILD_DIR="$(mktemp -d /opt/.kavita-build.XXXXXX)"
trap '[[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"; rm -f "$TMP_TAR"' EXIT
tar -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1 >> "$LOGFILE" 2>&1
[[ -s "$BUILD_DIR/Kavita" ]]
chmod 755 "$BUILD_DIR/Kavita"
stage_app_archive "$BUILD_DIR" /opt/Kavita Kavita "" "$PACKAGE_NAME" "." "" preserve
BUILD_DIR=""
rm -f "$TMP_TAR"
chmod +x /opt/Kavita/Kavita
queue_app_version /opt/Kavita/.af-version "${KAV_VERSION#v}"

for kav_cfg in /opt/Kavita/appsettings.json /opt/Kavita/config/appsettings.json; do
    if [[ -f "$kav_cfg" ]]; then
        sed -i 's/"Port": [0-9]*/"Port": '"${APP_PORT}"'/' "$kav_cfg" 2>/dev/null || true
    fi
done

chown -hRP kavita:kavita /opt/Kavita /var/lib/kavita

report_progress 85 "Configuring and starting kavita.service on port ${APP_PORT}..."
KAVITA_BIND_HOST="$(retained_bind_address /etc/systemd/system/kavita.service 'ASPNETCORE_URLS=http://(\[[^\]]+\]|[^:\s"\x27/]+)')"
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_BIND_HOST@/${KAVITA_BIND_HOST}/g" <<'EOF' > /etc/systemd/system/kavita.service
[Unit]
Description=Kavita Dedicated Comic and Manga Server
After=network.target

[Service]
User=kavita
Group=kavita
Type=simple
WorkingDirectory=/opt/Kavita
Environment=ASPNETCORE_URLS=http://@AF_BIND_HOST@:@AF_APP_PORT@
ExecStart=/opt/Kavita/Kavita
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now kavita >> "$LOGFILE" 2>&1
systemctl restart kavita >> "$LOGFILE" 2>&1
verify_systemd_service_active kavita
AF_BOOTSTRAP_RETAINED="$ADMIN_RETAINED" AF_SEED_USER="$MASTER_USER" AF_SEED_PASS="$MASTER_PASS" python3 - >> "$LOGFILE" 2>&1 <<'PYEOF'
import os
import sys, time, json, urllib.request, urllib.error
user, pw = os.environ["AF_SEED_USER"], os.environ["AF_SEED_PASS"]
for _ in range(120):
    try:
        with urllib.request.urlopen('http://127.0.0.1:5002/api/health'.replace('5002', os.environ['AF_APP_PORT']), timeout=3) as r:
            if r.status == 200:
                break
    except Exception:
        time.sleep(1)
else:
    sys.exit('Kavita status endpoint did not become ready')
req = urllib.request.Request('http://127.0.0.1:5002/api/account/register'.replace('5002', os.environ['AF_APP_PORT']), data=json.dumps({'username': user, 'email': f'{user}@aether.local', 'password': pw}).encode('utf-8'), headers={'Content-Type': 'application/json'}, method='POST')
try:
    with urllib.request.urlopen(req, timeout=10) as response:
        if not 200 <= response.status < 300:
            sys.exit('Kavita account initialization failed')
        response.read()
except urllib.error.HTTPError as error:
    detail = error.read(8192).decode('utf-8', errors='replace').lower()
    retained = os.environ.get('AF_BOOTSTRAP_RETAINED') == '1'
    exists = 'already' in detail and any(word in detail for word in ('admin', 'user', 'account', 'initializ'))
    if error.code not in (400, 403, 409) or not (retained or exists):
        raise
PYEOF

finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/api/health"
systemctl is-active --quiet kavita

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Kavita installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
