#!/bin/bash
#
# [AetherFlow :: Install Tautulli]
# Plex monitoring and tracking tool
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [tautulli] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y python3 python3-setuptools git wget >>"$LOGFILE" 2>&1

# ── Create tautulli user ─────────────────────────────────────────────────────
if ! id -u tautulli &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /opt/Tautulli tautulli
fi

# ── Download Tautulli ────────────────────────────────────────────────────────
log "Downloading Tautulli from latest Github repo..."
rm -rf /opt/Tautulli
cd /opt
git clone https://github.com/Tautulli/Tautulli.git >>"$LOGFILE" 2>&1

chown -R tautulli:tautulli /opt/Tautulli

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/tautulli.service <<'EOF'
[Unit]
Description=Tautulli - Plex Monitor
After=network.target

[Service]
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
ExecStart=/usr/bin/python3 /opt/Tautulli/Tautulli.py
User=tautulli
Group=tautulli
Restart=on-failure
RestartSec=5
Type=simple
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/Tautulli

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable tautulli.service >>"$LOGFILE" 2>&1
systemctl start tautulli.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/tautulli.conf <<'EOF'
<Location /tautulli>
    ProxyPass http://localhost:8181/tautulli
    ProxyPassReverse http://localhost:8181/tautulli
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/tautulli.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.tautulli.lock
log "Tautulli installation complete! Access at http://your-server:8181"
