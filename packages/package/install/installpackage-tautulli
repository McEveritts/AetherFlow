#!/bin/bash
# AetherFlow Package Installer: Tautulli
# Port: 8181

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="tautulli"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and Git prerequisites for Tautulli..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git python3 python3-setuptools python3-pip ca-certificates >> "$LOGFILE" 2>&1

if ! id -u tautulli >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/tautulli --shell /usr/sbin/nologin tautulli
fi

mkdir -p /var/lib/tautulli

report_progress 40 "Cloning Tautulli repository..."
rm -rf /opt/Tautulli
git clone --depth 1 https://github.com/Tautulli/Tautulli.git /opt/Tautulli >> "$LOGFILE" 2>&1
TAUTULLI_VERSION="$(git -C /opt/Tautulli describe --tags --abbrev=0 2>/dev/null || true)"
if [[ -n "$TAUTULLI_VERSION" ]]; then
    printf '%s\n' "${TAUTULLI_VERSION#v}" > /opt/Tautulli/.af-version
fi
if [[ ! -f /var/lib/tautulli/config.ini ]]; then
    cat <<EOF > /var/lib/tautulli/config.ini
[General]
http_port = 8181
http_host = 0.0.0.0
http_username = ${MASTER_USER}
http_password = ${MASTER_PASS}
launch_browser = 0
first_run_complete = 1
EOF
fi
chown -R tautulli:tautulli /opt/Tautulli /var/lib/tautulli

report_progress 80 "Configuring and starting tautulli.service on port 8181..."
cat <<'EOF' > /etc/systemd/system/tautulli.service
[Unit]
Description=Tautulli - Stats for Plex Media Server usage
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/Tautulli/Tautulli.py --config /var/lib/tautulli/config.ini --datadir /var/lib/tautulli --quiet --nolaunch --port 8181
GuessMainPID=no
Type=simple
User=tautulli
Group=tautulli
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now tautulli >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Tautulli installed on port 8181."
log_info "${PACKAGE_NAME} installed successfully"
