#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="tautulli"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8181}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-tautulli.lock
flock -n 9 || { log_error "Another Tautulli installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/tautulli/config.ini
if [[ -f /var/lib/tautulli/config.ini ]]; then
    set_config_file_mode 0600 /var/lib/tautulli/config.ini
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/tautulli.service ]] || systemctl is-active --quiet tautulli 2>/dev/null || systemctl is-enabled --quiet tautulli 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback tautulli || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/Tautulli "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/Tautulli
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/Tautulli 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/tautulli.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/tautulli.service" /etc/systemd/system/tautulli.service || restore_failed=true
            else
                systemctl disable tautulli >> "$LOGFILE" 2>&1 || restore_failed=true
                rm -f /etc/systemd/system/tautulli.service || restore_failed=true
            fi
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            systemctl start tautulli >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and Git prerequisites for Tautulli..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git python3 python3-setuptools python3-pip ca-certificates >> "$LOGFILE" 2>&1

if ! id -u tautulli >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/tautulli --shell /usr/sbin/nologin tautulli
fi

mkdir -p /var/lib/tautulli /opt /var/backups

report_progress 40 "Cloning Tautulli repository into staging directory..."
BUILD_DIR="$(mktemp -d /opt/.tautulli-build.XXXXXX)"
git clone --depth 1 https://github.com/Tautulli/Tautulli.git "$BUILD_DIR" >> "$LOGFILE" 2>&1
test -s "$BUILD_DIR/Tautulli.py" || { log_error "Failed to clone Tautulli repository"; exit 1; }

TAUTULLI_VERSION="$(git_checkout_version "$BUILD_DIR" "/opt/Tautulli/.af-version")"

chown -hRP tautulli:tautulli "$BUILD_DIR"

if [[ ! -f /var/lib/tautulli/config.ini ]]; then
    (umask 077; write_config_file /var/lib/tautulli/config.ini 0600 <<EOF
[General]
http_port = ${APP_PORT}
http_host = 127.0.0.1
http_username = ${MASTER_USER}
http_password = ${MASTER_PASS}
launch_browser = 0
first_run_complete = 1
EOF
    )
fi
set_config_file_mode 0600 /var/lib/tautulli/config.ini
chown -hRP tautulli:tautulli /var/lib/tautulli

report_progress 75 "Backing up existing Tautulli installation and activating new build..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-tautulli.XXXXXX)"
chmod 700 "$BACKUP_DIR"
queue_app_version "/opt/Tautulli/.af-version" "${TAUTULLI_VERSION#v}" "$BUILD_DIR" "$BACKUP_DIR"
stop_systemd_unit tautulli
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/tautulli /etc/tautulli
if [[ -f /etc/systemd/system/tautulli.service ]]; then
    cp -a /etc/systemd/system/tautulli.service "$BACKUP_DIR/tautulli.service"
fi
if [[ "$WAS_RUNNABLE" -eq 1 ]]; then
    stop_systemd_unit tautulli
    SERVICE_STOPPED=1
fi
if [[ -d /opt/Tautulli ]]; then
    mv /opt/Tautulli "$BACKUP_DIR/app"
    APP_MOVED=1
fi
mv "$BUILD_DIR" /opt/Tautulli
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/Tautulli

report_progress 80 "Configuring and starting tautulli.service on port ${APP_PORT}..."
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/systemd/system/tautulli.service
[Unit]
Description=Tautulli - Stats for Plex Media Server usage
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/Tautulli/Tautulli.py --config /var/lib/tautulli/config.ini --datadir /var/lib/tautulli --quiet --nolaunch --port @AF_APP_PORT@
GuessMainPID=no
Type=simple
User=tautulli
Group=tautulli
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now tautulli >> "$LOGFILE" 2>&1

READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
wait_for_service_ready "tautulli.service" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Tautulli installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
