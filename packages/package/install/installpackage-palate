VERSION="$(python3 -I - "$BUILD_DIR/package.json" <<'PYVER'
import json, os, pathlib, stat, sys
p = pathlib.PurePosixPath(os.path.abspath(sys.argv[1]))
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
try:
    for part in p.parts[1:-1]:
        nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
        os.close(cur_fd)
        cur_fd = nxt
    fd = os.open(p.parts[-1], os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=cur_fd)
finally:
    os.close(cur_fd)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > 1048576:
        raise SystemExit(1)
    chunks = []
    total = 0
    while True:
        chunk = os.read(fd, 8192)
        if not chunk:
            break
        total += len(chunk)
        if total > 1048576:
            raise SystemExit(1)
        chunks.append(chunk)
    ver = json.loads(b"".join(chunks).decode("utf-8")).get("version", "")
    if not isinstance(ver, str) or not ver.strip():
        raise SystemExit(1)
    print(ver.strip())
finally:
    os.close(fd)
PYVER
