#!/bin/bash
# AetherFlow Package Installer: Palate (native Node.js and PostgreSQL)
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
export LOGFILE="/var/log/aetherflow/install-palate.log"
APP_DIR=/opt/palate
DATA_DIR=/var/lib/palate
CONFIG_DIR=/etc/palate
ENV_FILE="${CONFIG_DIR}/palate.env"
UNIT_FILE=/etc/systemd/system/af-palate.service
REQUESTED_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-}}"
BUILD_DIR=""
RUNTIME_STAGE=""
BACKUP_DIR=""
ENV_BACKUP=""
OLD_APP_MOVED=0
NEW_APP_MOVED=0
UNIT_WRITTEN=0
WAS_ACTIVE=0
SERVICE_STOPPED=0
SUCCESS=0
mkdir -p /install /run/lock /opt /var/backups
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
exec 9>/run/lock/aetherflow-palate.lock
flock -n 9 || { print_error "Another Palate operation is running."; exit 1; }

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        print_error "Palate installation failed; see ${LOGFILE}."
        if [[ -n "$ENV_BACKUP" || "$NEW_APP_MOVED" -eq 1 || "$OLD_APP_MOVED" -eq 1 || -n "$BACKUP_DIR" ]]; then
            if [[ "$SERVICE_STOPPED" -ne 1 ]] && systemctl is-active --quiet af-palate.service; then
                WAS_ACTIVE=1
            fi
            AF_ROLLBACK_BACKUP="${BACKUP_DIR:-$ENV_BACKUP}"
            quiesce_services_for_rollback af-palate.service || { restore_failed=true; exit 1; }
            SERVICE_STOPPED=1
        fi
        if [[ -n "$ENV_BACKUP" ]]; then
            safe_restore_path_from_backup "$ENV_BACKUP" "$ENV_FILE" || restore_failed=true
        fi
        if [[ "$NEW_APP_MOVED" -eq 1 ]]; then
            rm -rf "$APP_DIR" || restore_failed=true
        fi
        if [[ "$OLD_APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" "$APP_DIR" || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/af-palate.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/af-palate.service" "$UNIT_FILE" || restore_failed=true
            else
                af_logged systemctl disable af-palate.service || restore_failed=true
                rm -f "$UNIT_FILE" || restore_failed=true
            fi
            af_logged systemctl daemon-reload || restore_failed=true
        fi
        if [[ -n "$BACKUP_DIR" && -f "$BACKUP_DIR/.af-database-ready" ]]; then
            if ! restore_postgresql_database "$BACKUP_DIR" af_palate; then
                restore_failed=true
                print_error "Palate recovery incomplete; backups retained in $BACKUP_DIR"
                exit "${status:-1}"
            fi
            if [[ -d "$BACKUP_DIR/app-state" ]]; then
                if ! safe_restore_path_from_backup "$BACKUP_DIR/app-state" "$DATA_DIR"; then
                    print_error "Palate data recovery failed; backups retained in $BACKUP_DIR"
    exit "$status"
                fi
            fi
        fi
        if [[ "$restore_failed" == false && "$SERVICE_STOPPED" -eq 1 && "$WAS_ACTIVE" -eq 1 ]]; then
            af_logged systemctl start af-palate.service || restore_failed=true
        fi
        if [[ -n "$BACKUP_DIR" ]]; then
            print_error "Database and vault backups are in ${BACKUP_DIR}."
        fi
    fi
    [[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"
    [[ -z "$RUNTIME_STAGE" ]] || rm -rf "$RUNTIME_STAGE"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${ENV_BACKUP:-unknown}}"
    else
        [[ -z "$ENV_BACKUP" ]] || rm -f "$ENV_BACKUP"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

read_palate_env_key() {
    local env_path="$1"
    local key_name="$2"
    python3 -I - "$env_path" "$key_name" <<'PYENV' 2>/dev/null || true
import os, pathlib, stat, sys

env_path = os.path.abspath(sys.argv[1])
key_name = sys.argv[2]
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)

p = pathlib.PurePosixPath(env_path)
if ".." in p.parts or not p.name:
    raise SystemExit(0)
try:
    cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
except OSError:
    raise SystemExit(0)
try:
    for part in p.parts[1:-1]:
        nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
        os.close(cur_fd)
        cur_fd = nxt
    fd = os.open(p.name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=cur_fd)
except OSError:
    os.close(cur_fd)
    raise SystemExit(0)
os.close(cur_fd)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > 65536:
        raise SystemExit(0)
    raw = os.read(fd, 65537)
    if len(raw) > 65536:
        raise SystemExit(0)
finally:
    os.close(fd)

val = ""
for line in raw.decode("utf-8", errors="replace").splitlines():
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    if s.startswith("export "):
        s = s[7:].strip()
    if "=" not in s:
        continue
    k, v = s.split("=", 1)
    if k.strip() == key_name:
        v = v.strip().strip("\r\n")
        if len(v) >= 2 and ((v[0] == '"' and v[-1] == '"') or (v[0] == "'" and v[-1] == "'")):
            v = v[1:-1]
        val = v
print(val)
PYENV
}

if [[ -f "$ENV_FILE" && ! -L "$ENV_FILE" ]]; then
    PORT="$(read_palate_env_key "$ENV_FILE" "PORT")"
    ENV_BACKUP="$(mktemp "${CONFIG_DIR}/.palate-env.XXXXXX")"
    cp -a "$ENV_FILE" "$ENV_BACKUP"
fi
APP_PORT="${REQUESTED_PORT:-${PORT:-28014}}"
if [[ ! "$APP_PORT" =~ ^[0-9]{4,5}$ ]] || (( 10#$APP_PORT < 1024 || 10#$APP_PORT > 65535 )); then
    print_error "Invalid Palate port: ${APP_PORT}"
    exit 1
fi

report_progress 10 "Installing Palate's native build and database prerequisites..."
export DEBIAN_FRONTEND=noninteractive
af_logged apt-get update -qq
af_logged apt-get install --no-remove -y -qq curl ca-certificates git build-essential python3 python3-setuptools pkg-config xz-utils openssl postgresql postgresql-client
af_logged systemctl enable --now postgresql.service

if ! id -u af-palate >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "$DATA_DIR" --shell /usr/sbin/nologin af-palate
fi
install -d -m 750 -o af-palate -g af-palate "$DATA_DIR"
install -d -m 750 -o root -g af-palate "$CONFIG_DIR"

resolve_palate_app_url() {
    local app_port="$1"
    local base_domain="$2"
    local -a db_candidates=(
        "${AF_DB_PATH:-}"
        "${DB_PATH:-}"
        "${AETHERFLOW_DB_PATH:-}"
        "${AETHERFLOW_DATA_DIR:+${AETHERFLOW_DATA_DIR%/}/aetherflow.sqlite}"
        /var/lib/aetherflow/aetherflow.sqlite
        /opt/AetherFlow/current/data/aetherflow.sqlite
        /opt/AetherFlow/data/aetherflow.sqlite
        /opt/AetherFlow/backend/data/aetherflow.sqlite
    )
    local aether_local="0"
    if grep -qiE '(\.|[[:space:]])aether\.local([[:space:]]|$)' /etc/hosts 2>/dev/null || \
       grep -rqi 'aether\.local' /etc/apache2/sites-available /etc/apache2/sites-enabled 2>/dev/null; then
        aether_local="1"
    fi
    python3 -I - "$app_port" "$base_domain" "$aether_local" "${db_candidates[@]}" <<'PYEOF'
import os, pathlib, re, sqlite3, stat, sys, time, uuid

app_port, base_domain, aether_local = sys.argv[1:4]
db_candidates = sys.argv[4:]
DOMAIN_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$")
base_domain = base_domain.strip().lstrip("*.")
if not DOMAIN_RE.fullmatch(base_domain):
    base_domain = ""
external_enabled = 0
custom_domain = ""
tls_enabled = 0

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
MAX_SCRATCH_BYTES = 2 * 1024 * 1024 * 1024
is_root = os.geteuid() == 0

def open_dir_nofollow(dir_str):
    p = pathlib.PurePosixPath(os.path.abspath(dir_str))
    if ".." in p.parts:
        return -1
    try:
        cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    except OSError:
        return -1
    try:
        for part in p.parts[1:]:
            nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
            os.close(cur_fd)
            cur_fd = nxt
        return cur_fd
    except OSError:
        os.close(cur_fd)
        return -1

def is_trusted_root_dir(dir_str, allow_sticky):
    dp = pathlib.PurePosixPath(os.path.abspath(dir_str))
    if not dp.is_absolute() or ".." in dp.parts:
        return False
    cur_p = pathlib.Path("/")
    for part in dp.parts:
        cur_p = pathlib.Path("/") if part == "/" else cur_p / part
        try:
            cst = os.lstat(cur_p)
        except OSError:
            return False
        if stat.S_ISLNK(cst.st_mode) or not stat.S_ISDIR(cst.st_mode) or cst.st_uid != 0:
            return False
        writable = (cst.st_mode & 0o022) != 0
        sticky = (cst.st_mode & getattr(stat, "S_ISVTX", 0o1000)) != 0
        if writable and not (allow_sticky and sticky):
            return False
    return True

def create_root_scratch(min_free):
    sc_name = f".af-palate-db.{os.getpid()}.{uuid.uuid4().hex}"
    for cand in ("/var/tmp", "/tmp", "/run"):
        if not is_trusted_root_dir(cand, allow_sticky=True):
            continue
        cand_fd = -1
        try:
            cand_fd = os.open(cand, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
            vfs = os.fstatvfs(cand_fd)
            avail = vfs.f_bavail * (vfs.f_frsize or vfs.f_bsize)
            if avail < min_free:
                os.close(cand_fd)
                continue
            os.mkdir(sc_name, 0o700, dir_fd=cand_fd)
            sc_fd = os.open(sc_name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cand_fd)
            st = os.fstat(sc_fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
                os.close(sc_fd)
                os.rmdir(sc_name, dir_fd=cand_fd)
                os.close(cand_fd)
                continue
            os.fchmod(sc_fd, 0o700)
            return cand_fd, sc_fd, sc_name, os.path.join(cand, sc_name)
        except OSError:
            if cand_fd >= 0:
                os.close(cand_fd)
    return None

def copy_fd_bounded(in_fd, out_dir_fd, out_name, remaining):
    out_fd = os.open(out_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0o600, dir_fd=out_dir_fd)
    copied = 0
    tail8 = b""
    try:
        while True:
            chunk = os.read(in_fd, 65536)
            if not chunk:
                break
            copied += len(chunk)
            if copied > remaining:
                raise OSError("scratch copy cap exceeded")
            tail8 = (tail8 + chunk)[-8:]
            view = memoryview(chunk)
            while view:
                w = os.write(out_fd, view)
                if w <= 0:
                    raise OSError("short write")
                view = view[w:]
        if out_name.endswith("-journal") and copied >= 16 and tail8 == b"\xd9\xd5\x05\xf9\x20\xa1\x63\xd7":
            raise OSError("forbidden SQLite super-journal trailer")
        return remaining - copied
    finally:
        os.close(out_fd)

def db_files_root_owned_safe(parent_fd, leaf_name):
    for suffix in ("", "-wal", "-shm", "-journal"):
        try:
            st = os.stat(leaf_name + suffix, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if st is not None and (st.st_uid != 0 or (st.st_mode & 0o022) != 0):
            return False
    return True

def inspect_palate_ingress(db_cand):
    db_abs = os.path.abspath(db_cand)
    parent_str = os.path.dirname(db_abs)
    leaf_name = os.path.basename(db_abs)
    if not leaf_name:
        return None
    parent_fd = open_dir_nofollow(parent_str)
    if parent_fd < 0:
        return None
    try:
        use_scratch = is_root and (
            not is_trusted_root_dir(parent_str, allow_sticky=False)
            or not db_files_root_owned_safe(parent_fd, leaf_name)
        )
        attempts = 3 if use_scratch else 1
        for attempt in range(attempts):
            db_fd = wal_fd = jrn_fd = -1
            sc = None
            try:
                db_fd = os.open(leaf_name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=parent_fd)
                st = os.fstat(db_fd)
                if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                    return None
                if os.read(db_fd, 16) != b"SQLite format 3\x00":
                    return None
                total_sz = st.st_size
                for suffix in ("-wal", "-shm", "-journal"):
                    try:
                        sfd = os.open(leaf_name + suffix, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=parent_fd)
                    except FileNotFoundError:
                        continue
                    sst = os.fstat(sfd)
                    if not stat.S_ISREG(sst.st_mode) or sst.st_nlink != 1:
                        os.close(sfd)
                        return None
                    if suffix == "-wal":
                        wal_fd = sfd
                        total_sz += sst.st_size
                    elif suffix == "-journal":
                        if sst.st_size >= 16:
                            os.lseek(sfd, -8, os.SEEK_END)
                            jtail = os.read(sfd, 8)
                            os.lseek(sfd, 0, os.SEEK_SET)
                            if jtail == b"\xd9\xd5\x05\xf9\x20\xa1\x63\xd7":
                                os.close(sfd)
                                return None
                        jrn_fd = sfd
                        total_sz += sst.st_size
                    else:
                        os.close(sfd)
                if use_scratch:
                    if total_sz > MAX_SCRATCH_BYTES:
                        return None
                    sc = create_root_scratch(total_sz * 2 + 16 * 1024 * 1024)
                    if sc is None:
                        return None
                    _, sc_fd, _, sc_path = sc
                    os.lseek(db_fd, 0, os.SEEK_SET)
                    rem = copy_fd_bounded(db_fd, sc_fd, "palate.sqlite", MAX_SCRATCH_BYTES)
                    if wal_fd >= 0:
                        rem = copy_fd_bounded(wal_fd, sc_fd, "palate.sqlite-wal", rem)
                    if jrn_fd >= 0:
                        copy_fd_bounded(jrn_fd, sc_fd, "palate.sqlite-journal", rem)
                    conn = sqlite3.connect(os.path.join(sc_path, "palate.sqlite"), timeout=2)
                else:
                    conn = sqlite3.connect(pathlib.Path(db_abs).as_uri() + "?mode=ro", uri=True, timeout=2)
                try:
                    conn.execute("PRAGMA trusted_schema = OFF;")
                    cur = conn.cursor()
                    cur.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='app_ingress_configs'")
                    if cur.fetchone():
                        cur.execute("SELECT * FROM app_ingress_configs WHERE LOWER(app_name) = ? LIMIT 1", ("palate",))
                        row = cur.fetchone()
                        if row and cur.description:
                            row_map = {col[0]: row[idx] for idx, col in enumerate(cur.description)}
                            ext_val = row_map.get("external_access_enabled", row_map.get("external_enabled", 0))
                            dom_val = row_map.get("public_domain", row_map.get("custom_domain", ""))
                            tls_val = row_map.get("tls_enabled", 0)
                            return int(bool(ext_val or 0)), str(dom_val or "").strip(), int(bool(tls_val or 0))
                    return 0, "", 0
                finally:
                    conn.close()
            except sqlite3.DatabaseError:
                if attempt + 1 < attempts:
                    time.sleep(0.025)
                    continue
                return None
            except OSError:
                return None
            finally:
                for fd in (db_fd, wal_fd, jrn_fd):
                    if fd >= 0:
                        os.close(fd)
                if sc is not None:
                    sc_base_fd, sc_fd, sc_name, _ = sc
                    for nm in ("palate.sqlite", "palate.sqlite-wal", "palate.sqlite-shm", "palate.sqlite-journal"):
                        try:
                            os.unlink(nm, dir_fd=sc_fd)
                        except FileNotFoundError:
                            _ = nm
                    os.close(sc_fd)
                    try:
                        os.rmdir(sc_name, dir_fd=sc_base_fd)
                    except OSError:
                        _ = sc_name
                    os.close(sc_base_fd)
    finally:
        os.close(parent_fd)
    return None

for cand in db_candidates:
    if not cand:
        continue
    res = inspect_palate_ingress(cand)
    if res is not None:
        external_enabled, raw_custom_domain, tls_enabled = res
        custom_domain = raw_custom_domain if DOMAIN_RE.fullmatch(raw_custom_domain) else ""
        break

managed_url = ""
if external_enabled:
    domain = custom_domain or (f"palate.{base_domain}" if base_domain else "")
    if domain:
        scheme = "https" if tls_enabled else "http"
        managed_url = f"{scheme}://{domain}"

if not managed_url:
    managed_url = "http://palate.aether.local" if aether_local == "1" else f"http://127.0.0.1:{app_port}"

print(managed_url)
print(custom_domain)
PYEOF
}

validate_config_paths "$ENV_FILE"
BASE_DOMAIN="$(get_base_domain)"
_PALATE_URL_INFO="$(resolve_palate_app_url "$APP_PORT" "$BASE_DOMAIN")"
MANAGED_APP_URL="$(printf '%s\n' "$_PALATE_URL_INFO" | sed -n '1p')"
INGRESS_CUSTOM_DOMAIN="$(printf '%s\n' "$_PALATE_URL_INFO" | sed -n '2p')"
if [[ ! -f "$ENV_FILE" ]]; then
    DB_PORT="$(runuser -u postgres -- env -i PATH="/usr/local/bin:/usr/bin:/bin" LANG="C.UTF-8" psql -XAt -d postgres -c 'SHOW port')"
    PALATE_DB_PASSWORD="$(openssl rand -hex 32)"
    APP_URL="$MANAGED_APP_URL"
    umask 077
    write_config_file "$ENV_FILE" <<EOF
NODE_ENV=production
PORT=${APP_PORT}
PALATE_DB_PASSWORD=${PALATE_DB_PASSWORD}
DATABASE_URL=postgresql://af_palate:${PALATE_DB_PASSWORD}@127.0.0.1:${DB_PORT}/af_palate?schema=public
NEXTAUTH_URL=${APP_URL}
NEXTAUTH_SECRET=$(openssl rand -hex 32)
PALATE_ENCRYPTION_SECRET=$(openssl rand -hex 32)
PALATE_RATE_LIMIT_SECRET=$(openssl rand -hex 32)
CRON_SECRET=$(openssl rand -hex 32)
JELLYFIN_LOGIN_ENABLED=true
JELLYFIN_INTERNAL_URL=http://jellyfin.aether.local
NEXT_PUBLIC_JELLYFIN_LOGIN_ENABLED=true
NEXT_PUBLIC_JELLYFIN_PUBLIC_URL=http://jellyfin.aether.local
EOF
    umask 022
fi
chown root:af-palate "$ENV_FILE"
chmod 640 "$ENV_FILE"
PALATE_DB_PASSWORD="$(read_palate_env_key "$ENV_FILE" "PALATE_DB_PASSWORD")"
if [[ ! "${PALATE_DB_PASSWORD:-}" =~ ^[a-f0-9]{64}$ ]]; then
    print_error "The managed database password in ${ENV_FILE} is missing or invalid."
    exit 1
fi

# Update the allocated port and installer-managed NEXTAUTH_URL while preserving secrets and custom NEXTAUTH_URL.
safe_config_python "$ENV_FILE" "$APP_PORT" "$MANAGED_APP_URL" "$BASE_DOMAIN" "$INGRESS_CUSTOM_DOMAIN" <<'PY'
from pathlib import Path
import re
import sys

path, port, managed_url, base_domain, custom_domain = sys.argv[1:6]
existing_lines = safe_read_text(path).splitlines()
current_nextauth = ""
for line in existing_lines:
    if line.startswith("NEXTAUTH_URL="):
        current_nextauth = line.split("=", 1)[1].strip()

managed_candidates = {"", "http://palate.aether.local"}
if base_domain:
    managed_candidates.add(f"https://palate.{base_domain}")
    managed_candidates.add(f"http://palate.{base_domain}")
if custom_domain:
    managed_candidates.add(f"https://{custom_domain}")
    managed_candidates.add(f"http://{custom_domain}")

is_managed_nextauth = (
    current_nextauth in managed_candidates
    or bool(re.fullmatch(r"http://(?:127\.0\.0\.1|localhost):\d+", current_nextauth))
)

lines = []
saw_nextauth = False
for line in existing_lines:
    if line.startswith("PORT="):
        continue
    if line.startswith("NEXTAUTH_URL="):
        saw_nextauth = True
        if is_managed_nextauth:
            lines.append(f"NEXTAUTH_URL={managed_url}")
        else:
            lines.append(line)
        continue
    lines.append(line)
if not saw_nextauth:
    lines.append(f"NEXTAUTH_URL={managed_url}")
lines.append(f"PORT={port}")
safe_write_text(path, "\n".join(lines) + "\n")
PY

report_progress 20 "Preparing Palate's PostgreSQL database..."
# Passwords travel over stdin, never in process arguments or progress messages.
af_logged runuser -u postgres -- env -i PATH="/usr/local/bin:/usr/bin:/bin" LANG="C.UTF-8" psql -Xq -v ON_ERROR_STOP=1 -d postgres <<SQL
SELECT 'CREATE ROLE af_palate LOGIN' WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'af_palate') \gexec
ALTER ROLE af_palate PASSWORD '${PALATE_DB_PASSWORD}';
SELECT 'CREATE DATABASE af_palate OWNER af_palate' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'af_palate') \gexec
SQL

report_progress 30 "Fetching the latest stable Palate release..."
