#!/bin/bash
# AetherFlow Package Installer: Palate (native Node.js and PostgreSQL)
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
export LOGFILE="/var/log/aetherflow/install-palate.log"
APP_DIR=/opt/palate
DATA_DIR=/var/lib/palate
CONFIG_DIR=/etc/palate
ENV_FILE="${CONFIG_DIR}/palate.env"
UNIT_FILE=/etc/systemd/system/af-palate.service
REQUESTED_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-}}"
BUILD_DIR=""
BACKUP_DIR=""
ENV_BACKUP=""
OLD_APP_MOVED=0
NEW_APP_MOVED=0
UNIT_WRITTEN=0
WAS_ACTIVE=0
SERVICE_STOPPED=0
SUCCESS=0
mkdir -p /install /run/lock /opt /var/backups
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
exec 9>/run/lock/aetherflow-palate.lock
flock -n 9 || { print_error "Another Palate operation is running."; exit 1; }

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        print_error "Palate installation failed; see ${LOGFILE}."
        if [[ -n "$ENV_BACKUP" || "$NEW_APP_MOVED" -eq 1 || "$OLD_APP_MOVED" -eq 1 || -n "$BACKUP_DIR" ]]; then
            if [[ "$SERVICE_STOPPED" -ne 1 ]] && systemctl is-active --quiet af-palate.service; then
                WAS_ACTIVE=1
            fi
            AF_ROLLBACK_BACKUP="${BACKUP_DIR:-$ENV_BACKUP}"
            quiesce_services_for_rollback af-palate.service || { restore_failed=true; exit 1; }
            SERVICE_STOPPED=1
        fi
        if [[ -n "$ENV_BACKUP" ]]; then
            safe_restore_path_from_backup "$ENV_BACKUP" "$ENV_FILE" || restore_failed=true
        fi
        if [[ "$NEW_APP_MOVED" -eq 1 ]]; then
            rm -rf "$APP_DIR" || restore_failed=true
        fi
        if [[ "$OLD_APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" "$APP_DIR" || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/af-palate.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/af-palate.service" "$UNIT_FILE" || restore_failed=true
            else
                af_logged systemctl disable af-palate.service || restore_failed=true
                rm -f "$UNIT_FILE" || restore_failed=true
            fi
            af_logged systemctl daemon-reload || restore_failed=true
        fi
        if [[ -n "$BACKUP_DIR" && -f "$BACKUP_DIR/.af-database-ready" ]]; then
            if ! restore_postgresql_database "$BACKUP_DIR" af_palate; then
                restore_failed=true
                print_error "Palate recovery incomplete; backups retained in $BACKUP_DIR"
                exit "${status:-1}"
            fi
            if [[ -d "$BACKUP_DIR/app-state" ]]; then
                if ! safe_restore_path_from_backup "$BACKUP_DIR/app-state" "$DATA_DIR"; then
                    print_error "Palate data recovery failed; backups retained in $BACKUP_DIR"
    exit "$status"
                fi
            fi
        fi
        if [[ "$restore_failed" == false && "$SERVICE_STOPPED" -eq 1 && "$WAS_ACTIVE" -eq 1 ]]; then
            af_logged systemctl start af-palate.service || restore_failed=true
        fi
        if [[ -n "$BACKUP_DIR" ]]; then
            print_error "Database and vault backups are in ${BACKUP_DIR}."
        fi
    fi
    [[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${ENV_BACKUP:-unknown}}"
    else
        [[ -z "$ENV_BACKUP" ]] || rm -f "$ENV_BACKUP"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -f "$ENV_FILE" ]]; then
    # This administrator-owned file is also consumed by systemd and build commands.
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    ENV_BACKUP="$(mktemp "${CONFIG_DIR}/.palate-env.XXXXXX")"
    cp -a "$ENV_FILE" "$ENV_BACKUP"
fi
APP_PORT="${REQUESTED_PORT:-${PORT:-28014}}"
if [[ ! "$APP_PORT" =~ ^[0-9]{4,5}$ ]] || (( 10#$APP_PORT < 1024 || 10#$APP_PORT > 65535 )); then
    print_error "Invalid Palate port: ${APP_PORT}"
    exit 1
fi

report_progress 10 "Installing Palate's native build and database prerequisites..."
export DEBIAN_FRONTEND=noninteractive
af_logged apt-get update -qq
af_logged apt-get install --no-remove -y -qq curl ca-certificates git build-essential python3 python3-setuptools pkg-config xz-utils openssl postgresql postgresql-client
af_logged systemctl enable --now postgresql.service

if ! id -u af-palate >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "$DATA_DIR" --shell /usr/sbin/nologin af-palate
fi
install -d -m 750 -o af-palate -g af-palate "$DATA_DIR"
install -d -m 750 -o root -g af-palate "$CONFIG_DIR"

resolve_palate_app_url() {
    local app_port="$1"
    local base_domain="$2"
    local db_path="" cand=""
    for cand in "${AF_DB_PATH:-}" "${DB_PATH:-}" "${AETHERFLOW_DB_PATH:-}" \
        /var/lib/aetherflow/aetherflow.sqlite \
        /opt/AetherFlow/current/data/aetherflow.sqlite \
        /opt/AetherFlow/data/aetherflow.sqlite \
        /opt/AetherFlow/backend/data/aetherflow.sqlite; do
        if [[ -n "$cand" && -f "$cand" ]]; then
            db_path="$cand"
            break
        fi
    done
    local aether_local="0"
    if grep -qiE '(\.|[[:space:]])aether\.local([[:space:]]|$)' /etc/hosts 2>/dev/null || \
       grep -rqi 'aether\.local' /etc/apache2/sites-available /etc/apache2/sites-enabled 2>/dev/null; then
        aether_local="1"
    fi
    python3 - "$db_path" "$app_port" "$base_domain" "$aether_local" <<'PYEOF'
import sqlite3, sys

db_path, app_port, base_domain, aether_local = sys.argv[1:5]
external_enabled = 0
custom_domain = ""
tls_enabled = 0

if db_path:
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = conn.cursor()
        cur.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='app_ingress_configs'")
        if cur.fetchone():
            cols = {row[1] for row in cur.execute("PRAGMA table_info(app_ingress_configs)")}
            ext_col = "external_access_enabled" if "external_access_enabled" in cols else ("external_enabled" if "external_enabled" in cols else "")
            dom_col = "public_domain" if "public_domain" in cols else ("custom_domain" if "custom_domain" in cols else "")
            tls_col = "tls_enabled" if "tls_enabled" in cols else ""
            if ext_col:
                sel = [
                    ext_col,
                    dom_col if dom_col else "''",
                    tls_col if tls_col else "0",
                ]
                row = cur.execute(
                    f"SELECT {', '.join(sel)} FROM app_ingress_configs WHERE LOWER(app_name) = 'palate' LIMIT 1"
                ).fetchone()
                if row:
                    external_enabled = int(bool(row[0] or 0))
                    custom_domain = (row[1] or "").strip()
                    tls_enabled = int(bool(row[2] or 0))
        conn.close()
    except sqlite3.Error:
        pass

managed_url = ""
if external_enabled:
    domain = custom_domain or (f"palate.{base_domain}" if base_domain else "")
    if domain:
        scheme = "https" if tls_enabled else "http"
        managed_url = f"{scheme}://{domain}"

if not managed_url:
    managed_url = "http://palate.aether.local" if aether_local == "1" else f"http://127.0.0.1:{app_port}"

print(managed_url)
print(custom_domain)
PYEOF
}

validate_config_paths "$ENV_FILE"
BASE_DOMAIN="$(get_base_domain)"
_PALATE_URL_INFO="$(resolve_palate_app_url "$APP_PORT" "$BASE_DOMAIN")"
MANAGED_APP_URL="$(printf '%s\n' "$_PALATE_URL_INFO" | sed -n '1p')"
INGRESS_CUSTOM_DOMAIN="$(printf '%s\n' "$_PALATE_URL_INFO" | sed -n '2p')"
if [[ ! -f "$ENV_FILE" ]]; then
    DB_PORT="$(runuser -u postgres -- psql -XAt -d postgres -c 'SHOW port')"
    PALATE_DB_PASSWORD="$(openssl rand -hex 32)"
    APP_URL="$MANAGED_APP_URL"
    umask 077
    write_config_file "$ENV_FILE" <<EOF
NODE_ENV=production
PORT=${APP_PORT}
PALATE_DB_PASSWORD=${PALATE_DB_PASSWORD}
DATABASE_URL=postgresql://af_palate:${PALATE_DB_PASSWORD}@127.0.0.1:${DB_PORT}/af_palate?schema=public
NEXTAUTH_URL=${APP_URL}
NEXTAUTH_SECRET=$(openssl rand -hex 32)
PALATE_ENCRYPTION_SECRET=$(openssl rand -hex 32)
PALATE_RATE_LIMIT_SECRET=$(openssl rand -hex 32)
CRON_SECRET=$(openssl rand -hex 32)
JELLYFIN_LOGIN_ENABLED=true
JELLYFIN_INTERNAL_URL=http://jellyfin.aether.local
NEXT_PUBLIC_JELLYFIN_LOGIN_ENABLED=true
NEXT_PUBLIC_JELLYFIN_PUBLIC_URL=http://jellyfin.aether.local
EOF
    umask 022
fi
chown root:af-palate "$ENV_FILE"
chmod 640 "$ENV_FILE"
# shellcheck source=/dev/null
source "$ENV_FILE"
if [[ ! "${PALATE_DB_PASSWORD:-}" =~ ^[a-f0-9]{64}$ ]]; then
    print_error "The managed database password in ${ENV_FILE} is missing or invalid."
    exit 1
fi

# Update the allocated port and installer-managed NEXTAUTH_URL while preserving secrets and custom NEXTAUTH_URL.
safe_config_python "$ENV_FILE" "$APP_PORT" "$MANAGED_APP_URL" "$BASE_DOMAIN" "$INGRESS_CUSTOM_DOMAIN" <<'PY'
from pathlib import Path
import re
import sys

path, port, managed_url, base_domain, custom_domain = sys.argv[1:6]
existing_lines = safe_read_text(path).splitlines()
current_nextauth = ""
for line in existing_lines:
    if line.startswith("NEXTAUTH_URL="):
        current_nextauth = line.split("=", 1)[1].strip()

managed_candidates = {"", "http://palate.aether.local"}
if base_domain:
    managed_candidates.add(f"https://palate.{base_domain}")
    managed_candidates.add(f"http://palate.{base_domain}")
if custom_domain:
    managed_candidates.add(f"https://{custom_domain}")
    managed_candidates.add(f"http://{custom_domain}")

is_managed_nextauth = (
    current_nextauth in managed_candidates
    or bool(re.fullmatch(r"http://(?:127\.0\.0\.1|localhost):\d+", current_nextauth))
)

lines = []
saw_nextauth = False
for line in existing_lines:
    if line.startswith("PORT="):
        continue
    if line.startswith("NEXTAUTH_URL="):
        saw_nextauth = True
        if is_managed_nextauth:
            lines.append(f"NEXTAUTH_URL={managed_url}")
        else:
            lines.append(line)
        continue
    lines.append(line)
if not saw_nextauth:
    lines.append(f"NEXTAUTH_URL={managed_url}")
lines.append(f"PORT={port}")
safe_write_text(path, "\n".join(lines) + "\n")
PY

report_progress 20 "Preparing Palate's PostgreSQL database..."
# Passwords travel over stdin, never in process arguments or progress messages.
af_logged runuser -u postgres -- psql -Xq -v ON_ERROR_STOP=1 -d postgres <<SQL
SELECT 'CREATE ROLE af_palate LOGIN' WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'af_palate') \gexec
ALTER ROLE af_palate PASSWORD '${PALATE_DB_PASSWORD}';
SELECT 'CREATE DATABASE af_palate OWNER af_palate' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'af_palate') \gexec
SQL

report_progress 30 "Fetching the latest stable Palate release..."
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TAG="${AF_TARGET_VERSION#release-}"
    TAG="${TAG#Release-}"
    if [[ "$TAG" =~ ^[0-9] ]]; then
        TAG="v${TAG}"
    elif [[ "$TAG" =~ ^V([0-9].*)$ ]]; then
        TAG="v${BASH_REMATCH[1]}"
    fi
else
    TAG="$(git ls-remote --tags --refs --sort=-v:refname https://github.com/McEveritts/Palate.git | awk -F/ '$NF ~ /^v[0-9]+\.[0-9]+\.[0-9]+$/ && !tag {tag=$NF} END {print tag}')"
fi
if [[ ! "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    print_error "Unable to resolve a stable Palate release tag."
    exit 1
fi
BUILD_DIR="$(mktemp -d /opt/.palate-build.XXXXXX)"
af_logged git clone --quiet --depth 1 --branch "$TAG" https://github.com/McEveritts/Palate.git "$BUILD_DIR"

# Use an application-private, checksum-verified Node.js 22 runtime.
case "$(uname -m)" in
    x86_64) NODE_ARCH=x64 ;;
    aarch64|arm64) NODE_ARCH=arm64 ;;
    *) print_error "Palate supports amd64 and arm64 hosts."; exit 1 ;;
esac
curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt -o "$BUILD_DIR/node-shasums.txt"
NODE_ARCHIVE="$(awk -v suffix="-linux-${NODE_ARCH}.tar.xz" 'index($2, suffix) && substr($2, length($2)-length(suffix)+1) == suffix {print $2}' "$BUILD_DIR/node-shasums.txt")"
if [[ ! "$NODE_ARCHIVE" =~ ^node-v22\.[0-9]+\.[0-9]+-linux-(x64|arm64)\.tar\.xz$ ]]; then
    print_error "Unable to resolve Palate's Node.js 22 runtime."
    exit 1
fi
download_file "https://nodejs.org/dist/latest-v22.x/${NODE_ARCHIVE}" "$BUILD_DIR/$NODE_ARCHIVE"
(cd "$BUILD_DIR"; awk -v name="$NODE_ARCHIVE" '$2 == name {print}' node-shasums.txt | sha256sum --check --status)
mkdir "$BUILD_DIR/.runtime"
tar -xJf "$BUILD_DIR/$NODE_ARCHIVE" --strip-components=1 -C "$BUILD_DIR/.runtime"
rm -f "$BUILD_DIR/$NODE_ARCHIVE" "$BUILD_DIR/node-shasums.txt"
"$BUILD_DIR/.runtime/bin/node" -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major !== 22 || minor < 13) process.exit(1)'

if [[ ! -d "$DATA_DIR/vault" ]]; then
    cp -a "$BUILD_DIR/vault" "$DATA_DIR/vault"
fi
rm -rf "$BUILD_DIR/vault"
ln -s "$DATA_DIR/vault" "$BUILD_DIR/vault"
chmod 755 "$BUILD_DIR"
chown -hRP af-palate:af-palate "$BUILD_DIR" "$DATA_DIR"

run_app() {
    runuser -u af-palate -- env "PATH=$BUILD_DIR/.runtime/bin:$PATH" "HOME=$DATA_DIR" NEXT_TELEMETRY_DISABLED=1 \
        /bin/bash -c 'set -e; set -a; source "$1"; set +a; cd "$2"; shift 2; exec "$@"' -- "$ENV_FILE" "$BUILD_DIR" "$@"
}
report_progress 50 "Building Palate ${TAG} as its dedicated service user..."
af_logged node_build run_app npm ci --include=dev --no-audit --no-fund
af_logged run_app node node_modules/prisma/build/index.js generate
af_logged node_build run_app npm run build
test -s "$BUILD_DIR/.next/BUILD_ID"
VERSION="$("$BUILD_DIR/.runtime/bin/node" -p "require('${BUILD_DIR}/package.json').version")"
[[ "$VERSION" == "${TAG#v}" ]] || { print_error "Palate's package version does not match ${TAG}."; exit 1; }
queue_app_version "$APP_DIR/.af-version" "$VERSION"

report_progress 80 "Backing up data and applying Palate's database schema..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-palate.XXXXXX)"
chmod 700 "$BACKUP_DIR"
cp -a "${ENV_BACKUP:-$ENV_FILE}" "$BACKUP_DIR/palate.env"
if [[ -f "$UNIT_FILE" ]]; then
    cp -a "$UNIT_FILE" "$BACKUP_DIR/af-palate.service"
    if systemctl is-active --quiet af-palate.service; then WAS_ACTIVE=1; fi
    af_logged systemctl stop af-palate.service
    SERVICE_STOPPED=1
fi
runuser -u postgres -- pg_dump --format=custom --dbname=af_palate > "$BACKUP_DIR/database.dump"
backup_postgresql_database "$BACKUP_DIR" af_palate
cp -a -- "$DATA_DIR" "$BACKUP_DIR/app-state"
tar -czf "$BACKUP_DIR/vault.tar.gz" -C "$DATA_DIR" vault
# Refuse destructive schema changes: never pass --accept-data-loss or --force-reset.
af_logged run_app node node_modules/prisma/build/index.js db push

if [[ -d "$APP_DIR" ]]; then
    mv "$APP_DIR" "$BACKUP_DIR/app"
    OLD_APP_MOVED=1
fi
mv "$BUILD_DIR" "$APP_DIR"
BUILD_DIR=""
NEW_APP_MOVED=1
UNIT_WRITTEN=1
cat > "$UNIT_FILE" <<EOF
[Unit]
Description=AetherFlow Palate Recipe and Nutrition Planner
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=af-palate
Group=af-palate
WorkingDirectory=${APP_DIR}
EnvironmentFile=${ENV_FILE}
Environment=HOME=${DATA_DIR}
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=${APP_DIR}/.runtime/bin/node ${APP_DIR}/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port \${PORT}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "$UNIT_FILE"
af_logged systemctl daemon-reload
af_logged systemctl enable af-palate.service
af_logged systemctl restart af-palate.service
report_progress 90 "Checking Palate's login page..."
af_logged curl --fail --silent --show-error --output /dev/null --max-time 5 --retry 20 --retry-connrefused --retry-delay 1 --retry-max-time 60 "http://127.0.0.1:${APP_PORT}/login"
systemctl is-active --quiet af-palate.service
commit_app_versions
write_lock palate
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Palate ${VERSION} installed on port ${APP_PORT}. Configure Jellyfin and the public URL in ${ENV_FILE}; sign in with a Jellyfin account."
