#!/bin/bash
# AetherFlow Package Installer: Plex Media Server
# Port: 32400

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="plex"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-32400}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /etc/apt/keyrings/plex.gpg
if [[ "$APP_PORT" != 32400 ]]; then
    print_error "plex requires port 32400; refusing an unsupported port override"
    exit 1
fi
PACKAGE_NAME="${PACKAGE_NAME:-plex}"
begin_state_transaction "plexmediaserver" "$APP_PORT" "/identity" "/var/lib/plex" "/var/lib/plexmediaserver" "/etc/plexmediaserver" "/etc/apt/sources.list.d/plexmediaserver.list" "/etc/apt/keyrings/plex.gpg" "/etc/systemd/system/plexmediaserver.service" "/usr/lib/plexmediaserver" "/usr/share/plexmediaserver" "/usr/bin/plexmediaserver"

prepare_apt_package_transaction /var/lib/plexmediaserver/.af-version plexmediaserver
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites for Plex Media Server..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl gnupg ca-certificates apt-transport-https

report_progress 30 "Configuring official Plex APT repository..."
install -m 0755 -d /etc/apt/keyrings
af_logged install_apt_signing_key https://downloads.plex.tv/plex-keys/PlexSign.key /etc/apt/keyrings/plex.gpg
chmod a+r /etc/apt/keyrings/plex.gpg
echo "deb [signed-by=/etc/apt/keyrings/plex.gpg] https://downloads.plex.tv/repo/deb public main" > /etc/apt/sources.list.d/plexmediaserver.list

report_progress 55 "Installing plexmediaserver package..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" plexmediaserver
verify_deb_installed plexmediaserver

report_progress 85 "Starting and enabling plexmediaserver service..."
af_logged systemctl daemon-reload
af_logged systemctl enable --now plexmediaserver

af_logged systemctl restart plexmediaserver
systemctl is-active --quiet plexmediaserver
mkdir -p /var/lib/plexmediaserver
queue_app_version /var/lib/plexmediaserver/.af-version "$(dpkg-query -W -f='${Version}' plexmediaserver)"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Plex Media Server installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
