#!/bin/bash
#
# [AetherFlow :: Install Syncthing]
# Continuous file synchronization
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [syncthing] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl apt-transport-https gnupg2 >>"$LOGFILE" 2>&1

# ── Create syncthing user ────────────────────────────────────────────────────
if ! id -u syncthing &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /var/lib/syncthing syncthing
fi
mkdir -p /var/lib/syncthing /home/syncthing
chown -R syncthing:syncthing /var/lib/syncthing /home/syncthing

# ── Download Syncthing ───────────────────────────────────────────────────────
log "Downloading latest Syncthing..."
ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) SYNC_ARCH="linux-amd64" ;;
    arm64) SYNC_ARCH="linux-arm64" ;;
    armhf) SYNC_ARCH="linux-arm" ;;
    *) SYNC_ARCH="linux-amd64" ;;
esac

SYNC_URL=$(curl -sL https://api.github.com/repos/syncthing/syncthing/releases/latest | grep -oP '"browser_download_url": "\K(https://[^"]+'${SYNC_ARCH}'\.tar\.gz)(?=")' | head -1)

if [[ -z "$SYNC_URL" ]]; then
    log "Could not parse API download URL, attempting fallback to known latest..."
    SYNC_VERSION=$(curl -sL https://api.github.com/repos/syncthing/syncthing/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    SYNC_URL="https://github.com/syncthing/syncthing/releases/download/${SYNC_VERSION}/syncthing-${SYNC_ARCH}-${SYNC_VERSION}.tar.gz"
fi

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "$SYNC_URL" -o syncthing.tar.gz >>"$LOGFILE" 2>&1

log "Extracting Syncthing..."
tar -xzf syncthing.tar.gz >>"$LOGFILE" 2>&1
rm -f syncthing.tar.gz

SYNC_DIR=$(find . -maxdepth 1 -name "syncthing-linux-*" -type d | head -1)
if [[ -n "$SYNC_DIR" ]]; then
    cp "$SYNC_DIR/syncthing" /usr/local/bin/
    chmod +x /usr/local/bin/syncthing
fi
rm -rf "$SYNC_DIR"

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/syncthing.service <<'EOF'
[Unit]
Description=Syncthing - Open Source Continuous File Synchronization
After=network.target

[Service]
User=syncthing
Group=syncthing
ExecStart=/usr/local/bin/syncthing -no-browser -no-restart -logflags=0
Restart=on-failure
RestartSec=10
SuccessExitStatus=3 4
RestartForceExitStatus=3 4
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/syncthing

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable syncthing.service >>"$LOGFILE" 2>&1
systemctl start syncthing.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/syncthing.conf <<'EOF'
<Location /syncthing>
    ProxyPass http://localhost:8384
    ProxyPassReverse http://localhost:8384
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/syncthing.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.syncthing.lock
log "Syncthing installation complete! Access at http://your-server:8384"
