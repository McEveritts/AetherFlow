#!/bin/bash
# AetherFlow Package Installer: Syncthing
# Port: 8384

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="syncthing"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing prerequisites for Syncthing..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl gnupg ca-certificates apt-transport-https >> "$LOGFILE" 2>&1

report_progress 35 "Adding official Syncthing APT repository..."
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://syncthing.net/release-key.gpg -o /etc/apt/keyrings/syncthing-archive-keyring.gpg >> "$LOGFILE" 2>&1
chmod a+r /etc/apt/keyrings/syncthing-archive-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/syncthing-archive-keyring.gpg] https://apt.syncthing.net/ syncthing stable" > /etc/apt/sources.list.d/syncthing.list

report_progress 60 "Installing Syncthing package..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq syncthing >> "$LOGFILE" 2>&1

if ! id -u syncthing >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/syncthing --shell /usr/sbin/nologin syncthing
fi

mkdir -p /var/lib/syncthing
chown -R syncthing:syncthing /var/lib/syncthing
sudo -u syncthing HOME=/var/lib/syncthing /usr/bin/syncthing generate --home=/var/lib/syncthing --gui-user="${MASTER_USER}" --gui-password="${MASTER_PASS}" >> "$LOGFILE" 2>&1 || true
for st_cfg in /var/lib/syncthing/config.xml /var/lib/syncthing/.local/state/syncthing/config.xml; do
    if [[ -f "$st_cfg" ]] && ! grep -q "insecureSkipHostcheck" "$st_cfg"; then
        sed -i 's|<gui \([^>]*\)>|<gui \1>\n        <insecureSkipHostcheck>true</insecureSkipHostcheck>|' "$st_cfg" || true
    fi
done

report_progress 85 "Configuring and starting syncthing.service on port 8384..."
cat <<'EOF' > /etc/systemd/system/syncthing.service
[Unit]
Description=Syncthing - Open Source Continuous File Synchronization
Documentation=man:syncthing(1)
After=network.target

[Service]
User=syncthing
Group=syncthing
Environment=HOME=/var/lib/syncthing
ExecStart=/usr/bin/syncthing serve --no-browser --no-restart --logflags=0 --gui-address=0.0.0.0:8384 --home=/var/lib/syncthing
Restart=on-failure
RestartSec=5
SuccessExitStatus=3 4
RestartForceExitStatus=3 4
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now syncthing >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Syncthing installed on port 8384."
log_info "${PACKAGE_NAME} installed successfully"
