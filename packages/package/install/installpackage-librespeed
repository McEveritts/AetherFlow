import grp, os, pwd, re, stat, subprocess, sys

state_dir = os.path.normpath(sys.argv[1])
proxy_conf_path = os.path.normpath(sys.argv[2])
o_nofollow = getattr(os, "O_NOFOLLOW", 0)
o_cloexec = getattr(os, "O_CLOEXEC", 0)
o_directory = getattr(os, "O_DIRECTORY", 0)
is_root = os.geteuid() == 0

root_uid = 0
ls_uid = pwd.getpwnam("librespeed").pw_uid if is_root else -1
ls_gid = grp.getgrnam("librespeed").gr_gid if is_root else -1

dir_fd = os.open(state_dir, os.O_RDONLY | o_directory | o_nofollow | o_cloexec)
try:
    dst = os.fstat(dir_fd)
    if not stat.S_ISDIR(dst.st_mode):
        raise SystemExit(f"Refusing non-directory LibreSpeed state root: {state_dir}")

    def harden_entry_in_dir(
        parent_fd: int,
        parent_label: str,
        entry_name: str,
        owner_user: str,
        uid: int,
        gid: int,
        mode: int,
        required: bool,
    ) -> bytes:
        full_label = os.path.join(parent_label, entry_name)
        try:
            fd = os.open(entry_name, os.O_RDONLY | o_nofollow | o_cloexec, dir_fd=parent_fd)
        except FileNotFoundError:
            if required:
                raise SystemExit(f"Missing required LibreSpeed artifact: {full_label}")
            return b""
        except OSError as exc:
            raise SystemExit(f"Refusing symlinked or unsafe LibreSpeed artifact {full_label}: {exc}")
        try:
            fst = os.fstat(fd)
            if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                raise SystemExit(f"Refusing non-regular or hardlinked LibreSpeed artifact: {full_label}")
            os.fchmod(fd, mode)
            if is_root:
                os.fchown(fd, uid, gid)
            else:
                subprocess.run(
                    ["chown", "-h", f"{owner_user}:librespeed", full_label],
                    check=True,
                )
            if entry_name == "settings.toml" and parent_fd == dir_fd:
                if fst.st_size > 1048576:
                    raise SystemExit(f"LibreSpeed settings.toml exceeds 1 MiB limit: {full_label}")
                return os.pread(fd, 1048576, 0)
            return b""
        finally:
            os.close(fd)

    def harden_db_family(target_dir_fd: int, target_label: str, base_leaf: str) -> None:
        exact = {
            base_leaf,
            f"{base_leaf}-wal",
            f"{base_leaf}-shm",
            f"{base_leaf}-journal",
            f"{base_leaf}.bak",
            f"{base_leaf}.bolt.bak",
            "speedtest.bolt.bak",
            "speedtest.bolt.bolt.bak",
            "idObfuscation_salt.bin",
        }
        prefixes = (
            f"{base_leaf}.bak.",
            f"{base_leaf}.bolt.bak.",
            f"{base_leaf}.pre-migrate.",
            "speedtest.bolt.bak.",
            "speedtest.bolt.bolt.bak.",
        )
        for name in sorted(os.listdir(target_dir_fd)):
            if name in exact or name.startswith(prefixes):
                harden_entry_in_dir(
                    target_dir_fd, target_label, name, "librespeed", ls_uid, ls_gid, 0o600, required=False
                )

    cfg_bytes = harden_entry_in_dir(
        dir_fd, state_dir, "settings.toml", "root", root_uid, ls_gid, 0o640, required=True
    )
    harden_db_family(dir_fd, state_dir, "speedtest.db")

    cfg_text = cfg_bytes.decode("utf-8", errors="replace")
    db_m = re.search(r'^[ \t]*database_file\s*=\s*(["\'])([^"\']*)\1', cfg_text, flags=re.MULTILINE)
    raw_db = db_m.group(2).strip() if db_m else ""
    if raw_db:
        resolved_db = os.path.normpath(raw_db if os.path.isabs(raw_db) else os.path.join(state_dir, raw_db))
        prefix = state_dir.rstrip("/") + "/"
        if resolved_db.startswith(prefix):
            rel_parts = [p for p in resolved_db[len(prefix):].split("/") if p and p != "."]
            if rel_parts and ".." not in rel_parts:
                if len(rel_parts) == 1 and rel_parts[0] != "speedtest.db":
                    harden_db_family(dir_fd, state_dir, rel_parts[0])
                elif len(rel_parts) > 1:
                    opened_fds = []
                    cur_fd = dir_fd
                    cur_label = state_dir
                    try:
                        for seg in rel_parts[:-1]:
                            cur_label = os.path.join(cur_label, seg)
                            try:
                                next_fd = os.open(
                                    seg, os.O_RDONLY | o_directory | o_nofollow | o_cloexec, dir_fd=cur_fd
                                )
                            except FileNotFoundError:
                                cur_fd = -1
                                break
                            except OSError as exc:
                                raise SystemExit(f"Refusing symlinked LibreSpeed DB directory {cur_label}: {exc}")
                            opened_fds.append(next_fd)
                            sub_st = os.fstat(next_fd)
                            if not stat.S_ISDIR(sub_st.st_mode):
                                raise SystemExit(f"Refusing non-directory LibreSpeed DB parent: {cur_label}")
                            os.fchmod(next_fd, 0o770)
                            if is_root:
                                os.fchown(next_fd, ls_uid, ls_gid)
                            else:
                                subprocess.run(["chown", "-h", "librespeed:librespeed", cur_label], check=True)
                            cur_fd = next_fd
                        if cur_fd != -1:
                            harden_db_family(cur_fd, cur_label, rel_parts[-1])
                    finally:
                        for sub_fd in reversed(opened_fds):
                            os.close(sub_fd)

    sec_m = re.search(
        r'^[ \t]*trusted_proxy_secret\s*=\s*(["\'])([^"\']*)\1',
        cfg_text,
        flags=re.MULTILINE,
    )
    proxy_secret = sec_m.group(2).strip() if sec_m else ""
    if proxy_secret and not re.fullmatch(r"[A-Za-z0-9_.:=-]{16,128}", proxy_secret):
        raise SystemExit("Refusing unsafe trusted_proxy_secret characters in LibreSpeed settings.toml")

    proxy_conf_dir = os.path.dirname(proxy_conf_path)
    if not os.path.lexists(proxy_conf_dir):
        os.makedirs(proxy_conf_dir, mode=0o750, exist_ok=True)
    pdir_st = os.lstat(proxy_conf_dir)
    if stat.S_ISLNK(pdir_st.st_mode) or not stat.S_ISDIR(pdir_st.st_mode):
        raise SystemExit(f"Refusing non-directory or symlinked proxy config parent: {proxy_conf_dir}")
    if os.path.lexists(proxy_conf_path):
        ex_conf_st = os.lstat(proxy_conf_path)
        if not stat.S_ISREG(ex_conf_st.st_mode):
            raise SystemExit(f"Refusing symlinked or non-regular Apache proxy token snippet: {proxy_conf_path}")

    snippet_body = (
        f'# Managed by AetherFlow LibreSpeed installer (0600 root:root)\nRequestHeader set X-AetherFlow-Proxy-Token "{proxy_secret}"\n'
        if proxy_secret
        else "# Managed by AetherFlow LibreSpeed installer\nRequestHeader unset X-AetherFlow-Proxy-Token\n"
    ).encode("utf-8")
    tmp_snippet = f"{proxy_conf_path}.tmp.{os.getpid()}"
    if os.path.lexists(tmp_snippet):
        os.unlink(tmp_snippet)
    sfd = os.open(
        tmp_snippet,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow | o_cloexec,
        0o600,
    )
    try:
        os.fchmod(sfd, 0o600)
        if is_root:
            os.fchown(sfd, root_uid, root_uid)
        with os.fdopen(sfd, "wb") as sfh:
            sfh.write(snippet_body)
            sfh.flush()
            os.fsync(sfh.fileno())
        os.replace(tmp_snippet, proxy_conf_path)
    except Exception:
        try:
            os.unlink(tmp_snippet)
        except OSError:
            pass
        raise
finally:
    os.close(dir_fd)
PYEOF

