#!/bin/bash
# AetherFlow Package Installer: LibreSpeed
# Port: 8988

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="librespeed"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8988}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /opt/librespeed/settings.toml /opt/librespeed/.af-directory-check
validate_config_paths /opt/librespeed/settings.toml
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites for LibreSpeed..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq python3 curl tar ca-certificates

if ! id -u librespeed >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/librespeed --shell /usr/sbin/nologin librespeed
fi

mkdir -p /opt/librespeed

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) LS_ARCH="amd64" ;;
    arm64) LS_ARCH="arm64" ;;
    armhf) LS_ARCH="armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

TARGET_VER_CLEAN="${AF_TARGET_VERSION:-}"
TARGET_VER_CLEAN="${TARGET_VER_CLEAN#v}"

LOCAL_SPEEDTEST_BIN=""
for candidate in \
    "${AF_SPEEDTEST_BACKEND_BIN:-}" \
    "/opt/AetherFlow/current/bin/speedtest-backend" \
    "/opt/AetherFlow/current/speedtest-backend" \
    "/usr/local/lib/aetherflow/speedtest-backend"; do
    if [[ -n "$candidate" && ! -L "$candidate" && -f "$candidate" && -x "$candidate" ]]; then
        if [[ "${AETHERFLOW_SKIP_PROVENANCE_VERIFY:-0}" != "1" ]]; then
            cand_dir="$(dirname "$candidate")"
            read -r f_uid f_perm < <(stat -c '%u %a' "$candidate" 2>/dev/null || printf '65534 777')
            read -r d_uid d_perm < <(stat -c '%u %a' "$cand_dir" 2>/dev/null || printf '65534 777')
            if [[ "$f_uid" != "0" || "$d_uid" != "0" ]] || (( (8#$f_perm & 022) != 0 )) || (( (8#$d_perm & 022) != 0 )); then
                log_warn "Skipping untrusted local speedtest-backend candidate (must be root-owned and non-group/world-writable): $candidate"
                continue
            fi
        fi
        if [[ -n "$TARGET_VER_CLEAN" ]]; then
            CANDIDATE_VER="$("$candidate" --version 2>/dev/null | sed -n 's/^speedtest-backend[[:space:]]\{1,\}\([0-9][0-9A-Za-z._-]*\).*/\1/p' | head -n1 || true)"
            CANDIDATE_VER="${CANDIDATE_VER#v}"
            if [[ "$CANDIDATE_VER" != "$TARGET_VER_CLEAN" ]]; then
                continue
            fi
        fi
        LOCAL_SPEEDTEST_BIN="$candidate"
        break
    fi
done

LS_VERSION="${AF_TARGET_VERSION:-}"
TMP_TAR=$(mktemp /tmp/librespeed-XXXXXX.tar.gz)
if [[ -n "$LOCAL_SPEEDTEST_BIN" ]]; then
    report_progress 35 "Staging local native LibreSpeed binary..."
    TMP_STAGE_DIR=$(mktemp -d /tmp/librespeed-stage-XXXXXX)
    cp --no-dereference "$LOCAL_SPEEDTEST_BIN" "${TMP_STAGE_DIR}/speedtest-backend"
    chmod 755 "${TMP_STAGE_DIR}/speedtest-backend"
    report_progress 60 "Packaging staged LibreSpeed binary..."
    tar -czf "$TMP_TAR" -C "$TMP_STAGE_DIR" speedtest-backend
    rm -rf -- "$TMP_STAGE_DIR"
else
    report_progress 35 "Resolving speedtest-backend release..."
    if [[ -n "$TARGET_VER_CLEAN" ]]; then
        LS_VERSION="v${TARGET_VER_CLEAN}"
        LS_VER_CLEAN="$TARGET_VER_CLEAN"
    elif [[ -f /opt/AetherFlow/current/.version ]]; then
        SLOT_VER="$(sed -n '1s/^[[:space:]]*v\?\([0-9][0-9A-Za-z._-]*\)[[:space:]]*$/\1/p' /opt/AetherFlow/current/.version || true)"
        if [[ -n "$SLOT_VER" ]]; then
            LS_VERSION="v${SLOT_VER}"
            LS_VER_CLEAN="$SLOT_VER"
        else
            LS_VERSION="$(github_latest_tag "McEveritts/AetherFlow" "4.0.0")"
            LS_VER_CLEAN="${LS_VERSION#v}"
        fi
    else
        LS_VERSION="$(github_latest_tag "McEveritts/AetherFlow" "4.0.0")"
        LS_VER_CLEAN="${LS_VERSION#v}"
    fi
    if [[ -z "${AF_FIXTURE_VERSION:-}" && "$LS_VER_CLEAN" =~ ^[0-3]\. ]]; then
        V4_TAG="$(curl --proto '=https' --proto-redir '=https' -fsSL "https://api.github.com/repos/McEveritts/AetherFlow/releases?per_page=20" 2>/dev/null \
            | sed -n 's/.*"tag_name":[[:space:]]*"\(v\([4-9]\|[1-9][0-9]\{1,\}\)\.[0-9]\{1,\}\.[0-9]\{1,\}[^"]*\)".*/\1/p' | head -n1 || true)"
        if [[ -n "$V4_TAG" ]]; then
            LS_VERSION="$V4_TAG"
            LS_VER_CLEAN="${V4_TAG#v}"
        else
            LS_VERSION="v4.0.0"
            LS_VER_CLEAN="4.0.0"
        fi
    fi
    LS_ARCHIVE_NAME="speedtest-backend_${LS_VER_CLEAN}_linux_${LS_ARCH}.tar.gz"
    LS_URL="https://github.com/McEveritts/AetherFlow/releases/download/v${LS_VER_CLEAN}/${LS_ARCHIVE_NAME}"
    report_progress 60 "Downloading and verifying LibreSpeed ${LS_VER_CLEAN}..."
    af_logged download_file "$LS_URL" "$TMP_TAR"

    if [[ "${AETHERFLOW_SKIP_PROVENANCE_VERIFY:-0}" != "1" ]]; then
        VERIFY_PROVENANCE_PY=""
        for vp_candidate in \
            "${AF_VERIFY_PROVENANCE_PY:-}" \
            "${SELF_DIR}/../../../deploy/verify-provenance.py" \
            "/opt/AetherFlow/current/deploy/verify-provenance.py" \
            "/opt/AetherFlow/deploy/verify-provenance.py"; do
            if [[ -n "$vp_candidate" && -f "$vp_candidate" ]]; then
                VERIFY_PROVENANCE_PY="$vp_candidate"
                break
            fi
        done
        if [[ -z "$VERIFY_PROVENANCE_PY" ]]; then
            rm -f -- "$TMP_TAR"
            print_error "Refusing unverified speedtest-backend archive: deploy/verify-provenance.py not found"
            exit 1
        fi
        LS_SHA256="$(sha256sum "$TMP_TAR" | awk '{print $1}')"
        TMP_BUNDLE="$(mktemp /tmp/librespeed-bundle-XXXXXX.sigstore.json)"
        BUNDLE_ARGS=()
        if af_logged curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 15 --max-time 60 "${LS_URL}.sigstore.json" -o "$TMP_BUNDLE" && [[ -s "$TMP_BUNDLE" ]]; then
            BUNDLE_ARGS=(--bundle-file "$TMP_BUNDLE")
        else
            log_warn "Sidecar .sigstore.json unavailable for ${LS_ARCHIVE_NAME}; falling back to GitHub Attestations API verification"
        fi
        if ! af_logged python3 "$VERIFY_PROVENANCE_PY" \
            --repo "McEveritts/AetherFlow" \
            --digest "$LS_SHA256" \
            --artifact-name "$LS_ARCHIVE_NAME" \
            --tag "v${LS_VER_CLEAN}" \
            "${BUNDLE_ARGS[@]}"; then
            rm -f -- "$TMP_TAR" "$TMP_BUNDLE"
            print_error "Sigstore SLSA provenance verification failed for ${LS_ARCHIVE_NAME}"
            exit 1
        fi
        rm -f -- "$TMP_BUNDLE"
    fi
fi
stage_app_archive "$TMP_TAR" "/opt/librespeed" "speedtest-backend" "" "${PACKAGE_NAME}" "." "" "preserve"
rm -f -- "$TMP_TAR"

if [[ -f /opt/librespeed/speedtest-backend && ! -L /opt/librespeed/speedtest-backend ]]; then
    chmod 755 /opt/librespeed/speedtest-backend
    ln -sfn /opt/librespeed/speedtest-backend /opt/librespeed/speedtest-go
else
    print_error "Native Rust speedtest-backend binary not found after extracting archive"
    exit 1
fi

BIN_VERSION=""
if [[ -x /opt/librespeed/speedtest-backend ]]; then
    BIN_VERSION="$(/opt/librespeed/speedtest-backend --version 2>/dev/null | sed -n 's/^speedtest-backend[[:space:]]\{1,\}\([0-9][0-9A-Za-z._-]*\).*/\1/p' | head -n1 || true)"
fi
LS_VERSION="${BIN_VERSION:-${LS_VERSION:-4.0.0}}"
queue_app_version /opt/librespeed/.af-version "${LS_VERSION#v}"

report_progress 72 "Applying Obsidian V2 theme assets to LibreSpeed..."
OBSIDIAN_ASSET_DIR="${SELF_DIR}/../assets/librespeed"
if [[ ! -d "$OBSIDIAN_ASSET_DIR" && -d "/opt/AetherFlow/current/packages/package/assets/librespeed" ]]; then
    OBSIDIAN_ASSET_DIR="/opt/AetherFlow/current/packages/package/assets/librespeed"
elif [[ ! -d "$OBSIDIAN_ASSET_DIR" && -d "/opt/AetherFlow/packages/package/assets/librespeed" ]]; then
    OBSIDIAN_ASSET_DIR="/opt/AetherFlow/packages/package/assets/librespeed"
fi
if [[ -d "$OBSIDIAN_ASSET_DIR" ]]; then
    rm -rf -- /opt/librespeed/assets.new
    mkdir -p /opt/librespeed/assets.new
    cp -R --no-preserve=ownership "${OBSIDIAN_ASSET_DIR}/." /opt/librespeed/assets.new/
    rm -rf -- /opt/librespeed/assets
    mv -fT /opt/librespeed/assets.new /opt/librespeed/assets
else
    mkdir -p /opt/librespeed/assets
fi

if [[ -f /opt/librespeed/settings.toml ]]; then
    safe_config_python /opt/librespeed/settings.toml "$APP_PORT" <<'PYEOF'
import errno, os, re, shutil, stat, sys
cfg_path, port = sys.argv[1], sys.argv[2]
state_dir = os.path.dirname(os.path.abspath(cfg_path))
confined_db = os.path.join(state_dir, "speedtest.db")
text = safe_read_text(cfg_path)
if re.search(r"^[ \t]*listen_port\s*=", text, re.MULTILINE):
    text = re.sub(r"^[ \t]*listen_port\s*=.*", f"listen_port={port}", text, flags=re.MULTILINE)
else:
    text = text.rstrip("\n") + f"\nlisten_port={port}\n"
text = re.sub(
    r'^([ \t]*database_type\s*=\s*)(["\'])bolt\2([ \t]*(?:#.*)?)$',
    r'\1"sqlite"\3',
    text,
    flags=re.MULTILINE | re.IGNORECASE,
)
if not re.search(r"^[ \t]*redact_ip_addresses\s*=", text, re.MULTILINE):
    text = text.rstrip("\n") + "\nredact_ip_addresses=true\n"
if not re.search(r"^[ \t]*enable_id_obfuscation\s*=", text, re.MULTILINE):
    text = text.rstrip("\n") + "\nenable_id_obfuscation=true\n"

db_type_m = re.search(r'^[ \t]*database_type\s*=\s*(["\'])([^"\']*)\1', text, re.MULTILINE)
db_type = db_type_m.group(2).strip().lower() if db_type_m else "sqlite"
db_file_m = re.search(r'^[ \t]*database_file\s*=\s*(["\'])([^"\']*)\1', text, re.MULTILINE)
if db_type not in ("none", "memory") and db_file_m:
    raw_db_file = db_file_m.group(2).strip()
    if raw_db_file:
        norm_state = os.path.normpath(state_dir)
        resolved_db = os.path.normpath(
            raw_db_file if os.path.isabs(raw_db_file) else os.path.join(norm_state, raw_db_file)
        )
        cur = os.path.dirname(resolved_db)
        while cur and cur != os.sep:
            if os.path.islink(cur):
                raise SystemExit(f"Refusing symlinked parent directory for retained database_file: {cur}")
            cur = os.path.dirname(cur)
        in_state_dir = (resolved_db != norm_state) and resolved_db.startswith(norm_state + os.sep)
        if in_state_dir:
            if os.path.lexists(resolved_db):
                st_in = os.lstat(resolved_db)
                if not stat.S_ISREG(st_in.st_mode):
                    raise SystemExit(f"Refusing non-regular or symlinked retained database_file: {resolved_db}")
            if raw_db_file != resolved_db:
                text = re.sub(
                    r'^[ \t]*database_file\s*=.*',
                    f'database_file="{resolved_db}"',
                    text,
                    flags=re.MULTILINE,
                )
        else:
            allowed_ext_prefixes = (
                "/var/lib/librespeed/",
                "/var/opt/librespeed/",
                "/srv/librespeed/",
                "/opt/librespeed-",
                "/opt/librespeed_",
                "/opt/librespeed.",
            )
            if not any(resolved_db.startswith(pfx) for pfx in allowed_ext_prefixes):
                raise SystemExit(
                    f"Refusing external database_file outside dedicated LibreSpeed directories: {resolved_db}"
                )
            if not os.path.lexists(resolved_db):
                raise SystemExit(
                    f"Configured external database_file is missing; refusing to silently switch databases: {resolved_db}"
                )
            st = os.lstat(resolved_db)
            if not stat.S_ISREG(st.st_mode):
                raise SystemExit(f"Refusing non-regular or symlinked retained database_file: {resolved_db}")

            o_nofollow = getattr(os, "O_NOFOLLOW", 0)
            fd_main = os.open(resolved_db, os.O_RDONLY | o_nofollow)
            try:
                fst = os.fstat(fd_main)
                if not stat.S_ISREG(fst.st_mode):
                    raise SystemExit(f"Refusing non-regular open descriptor for database_file: {resolved_db}")
                hdr = os.read(fd_main, 32)
                is_empty_db = fst.st_size == 0
                is_sqlite_db = hdr.startswith(b"SQLite format 3\x00")
                is_bolt_db = len(hdr) >= 20 and hdr[16:20] in (b"\xed\xda\x0c\xed", b"\xed\x0c\xda\xed")
                if not (is_empty_db or is_sqlite_db or is_bolt_db):
                    raise SystemExit(
                        f"Refusing external database_file without valid SQLite or BoltDB header: {resolved_db}"
                    )
            finally:
                os.close(fd_main)

            if any(os.path.lexists(confined_db + sfx) for sfx in ("", "-wal", "-shm", "-journal")):
                import time
                ts_tag = int(time.time() * 1000)
                bak_base = f"{confined_db}.pre-migrate.{ts_tag}.bak"
                idx_bak = 0
                while any(
                    os.path.lexists(f"{bak_base}{'' if idx_bak == 0 else f'.{idx_bak}'}{sfx}")
                    for sfx in ("", "-wal", "-shm", "-journal")
                ):
                    idx_bak += 1
                if idx_bak > 0:
                    bak_base = f"{bak_base}.{idx_bak}"
                for suffix in ("", "-wal", "-shm", "-journal"):
                    existing_p = confined_db + suffix
                    if not os.path.lexists(existing_p):
                        continue
                    ex_st = os.lstat(existing_p)
                    if not stat.S_ISREG(ex_st.st_mode) or ex_st.st_nlink != 1:
                        raise SystemExit(f"Refusing non-regular, symlinked, or hardlinked local database artifact: {existing_p}")
                    fd_ex = os.open(existing_p, os.O_RDONLY | o_nofollow | getattr(os, "O_CLOEXEC", 0))
                    try:
                        ex_fst = os.fstat(fd_ex)
                        if not stat.S_ISREG(ex_fst.st_mode) or ex_fst.st_nlink != 1 or (ex_fst.st_dev, ex_fst.st_ino) != (ex_st.st_dev, ex_st.st_ino):
                            raise SystemExit(f"Local database artifact changed inode or type before backup: {existing_p}")
                        os.fchmod(fd_ex, 0o600)
                    finally:
                        os.close(fd_ex)
                    os.rename(existing_p, bak_base + suffix)

            for suffix in ("", "-wal", "-shm", "-journal"):
                src_p = resolved_db + suffix
                dst_p = confined_db + suffix
                if not os.path.lexists(src_p):
                    continue
                src_st = os.lstat(src_p)
                if not stat.S_ISREG(src_st.st_mode):
                    raise SystemExit(f"Refusing non-regular or symlinked SQLite sidecar: {src_p}")
                fd_in = os.open(src_p, os.O_RDONLY | o_nofollow | getattr(os, "O_CLOEXEC", 0))
                tmp_dst = dst_p + ".migrated.tmp"
                try:
                    if os.path.lexists(tmp_dst):
                        tmp_st = os.lstat(tmp_dst)
                        if stat.S_ISDIR(tmp_st.st_mode):
                            raise SystemExit(f"Refusing directory at temporary migration path: {tmp_dst}")
                        os.unlink(tmp_dst)
                    with os.fdopen(fd_in, "rb") as f_in:
                        if suffix == "":
                            f_fst = os.fstat(f_in.fileno())
                            if (f_fst.st_dev, f_fst.st_ino) != (fst.st_dev, fst.st_ino):
                                raise SystemExit("External database_file changed inode during migration")
                        fd_out = os.open(
                            tmp_dst,
                            os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow | getattr(os, "O_CLOEXEC", 0),
                            0o600,
                        )
                        with os.fdopen(fd_out, "wb") as f_out:
                            os.fchmod(f_out.fileno(), 0o600)
                            shutil.copyfileobj(f_in, f_out)
                            f_out.flush()
                            os.fsync(f_out.fileno())
                    os.replace(tmp_dst, dst_p)
                except Exception:
                    try:
                        os.unlink(tmp_dst)
                    except OSError:
                        pass
                    raise

            if not os.path.isfile(confined_db) or os.path.islink(confined_db):
                raise SystemExit(f"External database migration verification failed for {confined_db}")
            if os.lstat(confined_db).st_size != fst.st_size:
                raise SystemExit("External database migration byte-size verification failed")

            src_salt = os.path.join(os.path.dirname(resolved_db), "idObfuscation_salt.bin")
            dst_salt = os.path.join(os.path.dirname(confined_db), "idObfuscation_salt.bin")
            if os.path.lexists(src_salt) and not os.path.lexists(dst_salt):
                salt_lst = os.lstat(src_salt)
                if stat.S_ISREG(salt_lst.st_mode) and salt_lst.st_nlink == 1 and salt_lst.st_size == 4:
                    fd_salt_in = os.open(src_salt, os.O_RDONLY | o_nofollow | getattr(os, "O_CLOEXEC", 0))
                    try:
                        salt_fst = os.fstat(fd_salt_in)
                        if (
                            stat.S_ISREG(salt_fst.st_mode)
                            and salt_fst.st_nlink == 1
                            and salt_fst.st_size == 4
                            and (salt_fst.st_dev, salt_fst.st_ino) == (salt_lst.st_dev, salt_lst.st_ino)
                        ):
                            salt_bytes = os.read(fd_salt_in, 5)
                            if len(salt_bytes) == 4:
                                tmp_salt = dst_salt + ".migrated.tmp"
                                if os.path.lexists(tmp_salt):
                                    os.unlink(tmp_salt)
                                fd_salt_out = os.open(
                                    tmp_salt,
                                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | o_nofollow | getattr(os, "O_CLOEXEC", 0),
                                    0o600,
                                )
                                try:
                                    with os.fdopen(fd_salt_out, "wb") as f_salt_out:
                                        os.fchmod(f_salt_out.fileno(), 0o600)
                                        f_salt_out.write(salt_bytes)
                                        f_salt_out.flush()
                                        os.fsync(f_salt_out.fileno())
                                    os.replace(tmp_salt, dst_salt)
                                except Exception:
                                    try:
                                        os.unlink(tmp_salt)
                                    except OSError:
                                        pass
                                    raise
                    finally:
                        os.close(fd_salt_in)

            text = re.sub(
                r'^[ \t]*database_file\s*=.*',
                f'database_file="{confined_db}"',
                text,
                flags=re.MULTILINE,
            )

import secrets
bind_m = re.search(r'^[ \t]*bind_address\s*=\s*(["\'])([^"\']*)\1', text, re.MULTILINE)
bind_val = bind_m.group(2).strip() if bind_m else None
