#!/bin/bash
# AetherFlow Package Installer: LibreSpeed
# Port: 8988

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="librespeed"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8988}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /opt/librespeed/settings.toml /opt/librespeed/.af-directory-check
validate_config_paths /opt/librespeed/settings.toml
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites for LibreSpeed..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3 curl tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u librespeed >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/librespeed --shell /usr/sbin/nologin librespeed
fi

mkdir -p /opt/librespeed

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) LS_ARCH="amd64" ;;
    arm64) LS_ARCH="arm64" ;;
    armhf) LS_ARCH="armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest speedtest-go release..."
LS_VERSION="$(github_latest_tag "librespeed/speedtest-go" "1.1.6")"
LS_URL="https://github.com/librespeed/speedtest-go/releases/download/v${LS_VERSION}/speedtest-go_${LS_VERSION}_linux_${LS_ARCH}.tar.gz"

report_progress 60 "Downloading and extracting LibreSpeed ${LS_VERSION}..."
TMP_TAR=$(mktemp /tmp/librespeed-XXXXXX.tar.gz)
download_file "$LS_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
stage_app_archive "$TMP_TAR" "/opt/librespeed" "speedtest-backend|speedtest-go" "" "${PACKAGE_NAME}" "." "" "preserve"
rm -f "$TMP_TAR"

if [[ -f /opt/librespeed/speedtest-backend ]]; then
    chmod 755 /opt/librespeed/speedtest-backend
    ln -sfn /opt/librespeed/speedtest-backend /opt/librespeed/speedtest-go
elif [[ -f /opt/librespeed/speedtest-go ]]; then
    chmod 755 /opt/librespeed/speedtest-go
    ln -sfn /opt/librespeed/speedtest-go /opt/librespeed/speedtest-backend
else
    print_error "LibreSpeed binary not found after extracting archive"
    exit 1
fi
queue_app_version /opt/librespeed/.af-version "${LS_VERSION#v}"

report_progress 72 "Applying Obsidian V2 theme assets to LibreSpeed..."
mkdir -p /opt/librespeed/assets
TMP_SRC_DIR=$(mktemp -d /tmp/librespeed-src-XXXXXX)
TMP_SRC_TAR=$(mktemp /tmp/librespeed-src-XXXXXX.tar.gz)
LS_SOURCE_URL="https://github.com/librespeed/speedtest-go/archive/refs/tags/v${LS_VERSION}.tar.gz"
if download_file "$LS_SOURCE_URL" "$TMP_SRC_TAR" >> "$LOGFILE" 2>&1 && \
    verify_download_sha256 "$TMP_SRC_TAR" "$PACKAGE_NAME" "$LS_SOURCE_URL" >> "$LOGFILE" 2>&1 && \
    tar -xzf "$TMP_SRC_TAR" -C "$TMP_SRC_DIR" --strip-components=1 >> "$LOGFILE" 2>&1; then
    if [[ -d "${TMP_SRC_DIR}/web/assets" ]]; then
        cp -rf "${TMP_SRC_DIR}/web/assets/." /opt/librespeed/assets/
    fi
fi
rm -f -- "$TMP_SRC_TAR" "$TMP_SRC_TAR.sha256" "$TMP_SRC_TAR.sha256sum"

OBSIDIAN_ASSET_DIR="${SELF_DIR}/../assets/librespeed"
if [[ ! -d "$OBSIDIAN_ASSET_DIR" && -d "/opt/AetherFlow/current/packages/package/assets/librespeed" ]]; then
    OBSIDIAN_ASSET_DIR="/opt/AetherFlow/current/packages/package/assets/librespeed"
elif [[ ! -d "$OBSIDIAN_ASSET_DIR" && -d "/opt/AetherFlow/packages/package/assets/librespeed" ]]; then
    OBSIDIAN_ASSET_DIR="/opt/AetherFlow/packages/package/assets/librespeed"
fi
if [[ -d "$OBSIDIAN_ASSET_DIR" ]]; then
    cp -rf "${OBSIDIAN_ASSET_DIR}/." /opt/librespeed/assets/
    rm -rf /opt/librespeed/assets/backend-patches
    if [[ -d "${TMP_SRC_DIR}/web/assets" && -x /usr/local/go/bin/go ]]; then
        cp -rf /opt/librespeed/assets/. "${TMP_SRC_DIR}/web/assets/"
        if [[ -f "${OBSIDIAN_ASSET_DIR}/backend-patches/stats.go" ]]; then
            cp -f "${OBSIDIAN_ASSET_DIR}/backend-patches/stats.go" "${TMP_SRC_DIR}/results/stats.go"
        fi
        if [[ -f "${OBSIDIAN_ASSET_DIR}/backend-patches/telemetry.go" ]]; then
            cp -f "${OBSIDIAN_ASSET_DIR}/backend-patches/telemetry.go" "${TMP_SRC_DIR}/results/telemetry.go"
        fi
        (cd "$TMP_SRC_DIR" && /usr/local/go/bin/go build -ldflags "-w -s" -trimpath -o /opt/librespeed/speedtest-backend main.go) >> "$LOGFILE" 2>&1 || true
    fi
fi
rm -rf "$TMP_SRC_DIR"

if [[ -f /opt/librespeed/settings.toml ]]; then
    safe_config_python /opt/librespeed/settings.toml "$APP_PORT" <<'PYEOF'
import re, sys
cfg_path, port = sys.argv[1], sys.argv[2]
text = safe_read_text(cfg_path)
if re.search(r"^listen_port\s*=", text, re.MULTILINE):
    text = re.sub(r"^listen_port\s*=.*", f"listen_port={port}", text, flags=re.MULTILINE)
else:
    text += f"\nlisten_port={port}\n"
safe_write_text(cfg_path, text)
PYEOF
else
    LS_STATS_PASS="$(AF_SEED_PASS="$MASTER_PASS" python3 - <<'PYEOF'
import json, os
print(json.dumps(os.environ["AF_SEED_PASS"]))
PYEOF
)"
    write_config_file /opt/librespeed/settings.toml <<EOF
bind_address="127.0.0.1"
listen_port=${APP_PORT}
url_base=""
proxyprotocol_port=0
server_lat=0
server_lng=0
ipinfo_api_key=""
assets_path="/opt/librespeed/assets"
statistics_password=${LS_STATS_PASS}
redact_ip_addresses=false
database_type="bolt"
database_hostname=""
database_name=""
database_username=""
database_password=""
database_file="/opt/librespeed/speedtest.db"
enable_tls=false
tls_cert_file=""
tls_key_file=""
EOF
fi

chown -hRP librespeed:librespeed /opt/librespeed
chmod 755 /opt/librespeed
chmod 640 /opt/librespeed/settings.toml

report_progress 85 "Configuring and starting librespeed.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/librespeed.service
[Unit]
Description=LibreSpeed Speedtest Daemon (speedtest-go)
After=network.target

[Service]
User=librespeed
Group=librespeed
Type=simple
WorkingDirectory=/opt/librespeed
ExecStart=/opt/librespeed/speedtest-backend -c /opt/librespeed/settings.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now librespeed >> "$LOGFILE" 2>&1
systemctl is-active --quiet librespeed

finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "LibreSpeed installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
