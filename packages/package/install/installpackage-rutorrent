#!/bin/bash
# AetherFlow Package Installer: ruTorrent
# Port: 8087

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rutorrent"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8087}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /var/www/rutorrent/.af-directory-check /etc/apache2/AetherFlow/rutorrent.htpasswd
load_master_credentials
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Apache, PHP, and media utility dependencies for ruTorrent..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    apache2 apache2-utils libapache2-mod-php git curl unzip unrar-free mediainfo sox ca-certificates \
    php php-cli php-fpm php-sqlite3 php-curl php-zip php-xml php-mbstring php-gd

report_progress 40 "Cloning ruTorrent repository to /var/www/rutorrent..."
BUILD_DIR="$(mktemp -d /var/www/.rutorrent-build.XXXXXX)"
trap '[[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"' EXIT
git_stage_exact_revision "https://github.com/Novik/ruTorrent.git" "$BUILD_DIR" "${AF_TARGET_VERSION:-}"
if [[ "$AF_STAGED_GIT_REF" != refs/tags/* ]]; then
    print_error "ruTorrent requires an upstream release tag."
    exit 1
fi
RUT_VERSION="$(af_strip_version_prefix "$AF_STAGED_GIT_VERSION")"
# Change the upstream TCP fallback in the new checkout. Older tags use a
# literal port and newer tags also allow an environment override.
sed -Ei '/^[[:space:]]*\$scgi_port[[:space:]]*=/s/([=[:space:]])5000([[:space:]]*;)/\115000\2/' "$BUILD_DIR/conf/config.php"
if [[ -e /srv/rutorrent && ! -L /srv/rutorrent ]]; then
    print_error "/srv/rutorrent is an existing data directory; refusing to replace it with a symlink"
    exit 1
fi
RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-web-runtime-")"
APACHE_CONFIG_BACKED_UP=false
RUNTIME_SNAPSHOT_READY=false
RUNTIME_STOPPED=false
INSTALL_COMMITTED=false
AF_APACHE_QUIESCE_MODE=""
AF_APACHE_IN_MAINTENANCE=false
AF_APACHE_ACTIVATED_NEW_VHOST=false
RUNTIME_PATHS=(
    "/var/www/rutorrent"
    "/var/lib/rutorrent"
    "/srv/rutorrent"
    "/etc/apache2/AetherFlow/rutorrent.htpasswd"
    "/etc/apache2/sites-available/rutorrent.conf"
    "/etc/apache2/sites-enabled/rutorrent.conf"
    "/etc/apache2/conf-available/aetherflow-rutorrent-listen.conf"
    "/etc/apache2/conf-enabled/aetherflow-rutorrent-listen.conf"
)
rollback_web_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_SNAPSHOT_READY" == true ]]; then
        apache_app_quiesce_for_rollback "${PACKAGE_NAME}" "$APP_PORT" "/" "$RUNTIME_BACKUP" || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        [[ "$restore_failed" == false ]] && apache_app_resume_after_rollback "${PACKAGE_NAME}" "$RUNTIME_BACKUP" || restore_failed=true
    elif [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && ( "$APACHE_CONFIG_BACKED_UP" == true || "$RUNTIME_STOPPED" == true ) ]]; then
        if [[ "$APACHE_CONFIG_BACKED_UP" == true ]]; then
            for runtime_index in "${!RUNTIME_PATHS[@]}"; do
                runtime_path="${RUNTIME_PATHS[$runtime_index]}"
                case "$runtime_path" in
                    */etc/apache2/sites-*|*/etc/apache2/conf-*)
                        safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
                        ;;
                esac
            done
        fi
        [[ "$restore_failed" == false ]] && apache_app_resume_after_rollback "${PACKAGE_NAME}" "$RUNTIME_BACKUP" || restore_failed=true
    fi
    [[ -z "${BUILD_DIR:-}" ]] || rm -rf -- "$BUILD_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}

trap rollback_web_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    case "$runtime_path" in
        */etc/apache2/sites-*|*/etc/apache2/conf-*)
            if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
                cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
            fi
            ;;
    esac
done
APACHE_CONFIG_BACKED_UP=true
apache_app_enter_maintenance "${PACKAGE_NAME}" "$APP_PORT" "/" "$RUNTIME_BACKUP"
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    case "$runtime_path" in
        */etc/apache2/sites-*|*/etc/apache2/conf-*) continue ;;
    esac
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
RUNTIME_SNAPSHOT_READY=true
mkdir -p "$BUILD_DIR/plugins"
for plugin_dir in /var/www/rutorrent/plugins/*; do
    [[ -d "$plugin_dir" ]] || continue
    plugin_name="$(basename "$plugin_dir")"
    if [[ ! -e "$BUILD_DIR/plugins/$plugin_name" ]]; then
        cp -a -- "$plugin_dir" "$BUILD_DIR/plugins/$plugin_name"
    elif [[ -f "$plugin_dir/conf.php" ]]; then
        cp -a -- "$plugin_dir/conf.php" "$BUILD_DIR/plugins/$plugin_name/conf.php"
    fi
done
RUT_DEFAULT_CONFIG="$(cat "$BUILD_DIR/conf/config.php")"
replace_app_tree "$BUILD_DIR" /var/www/rutorrent share conf
BUILD_DIR=""
if [[ ! -e /var/www/rutorrent/conf/config.php && ! -L /var/www/rutorrent/conf/config.php ]]; then
    # An operator can preseed only config.local.php or a user override.
    write_config_file /var/www/rutorrent/conf/config.php 0644 <<< "$RUT_DEFAULT_CONFIG"
fi
if [[ -e /srv/rutorrent && ! -L /srv/rutorrent ]]; then
    print_error "/srv/rutorrent is an existing data directory; refusing to replace it with a symlink"
    exit 1
fi
ln -sfn /var/www/rutorrent /srv/rutorrent

queue_app_version /var/www/rutorrent/.af-version "$RUT_VERSION"

mkdir -p /var/www/rutorrent/share/torrents \
         /var/www/rutorrent/share/users \
         /var/www/rutorrent/share/settings

chown -hRP root:www-data /var/www/rutorrent
find -P /var/www/rutorrent -type d -exec chmod 0755 -- {} +
find -P /var/www/rutorrent -type f -exec chmod 0644 -- {} +
chown -hRP www-data:www-data /var/www/rutorrent/share
find -P /var/www/rutorrent/share -type d -exec chmod 0775 -- {} +
find -P /var/www/rutorrent/share -type f -exec chmod 0664 -- {} +
if [[ -d /var/www/rutorrent/conf/users ]]; then
    chown -hRP www-data:www-data /var/www/rutorrent/conf/users
    find -P /var/www/rutorrent/conf/users -type d -exec chmod 0775 -- {} +
    find -P /var/www/rutorrent/conf/users -type f -exec chmod 0664 -- {} +
fi
chown -h www-data:www-data /srv/rutorrent

report_progress 85 "Configuring Apache VirtualHost on port ${APP_PORT}..."
configure_apache_app_listener "$PACKAGE_NAME" "$APP_PORT"

if [[ ! -s /etc/apache2/AetherFlow/rutorrent.htpasswd ]]; then
    install -d -m 0750 -o root -g www-data /etc/apache2/AetherFlow 2>/dev/null || mkdir -p -m 0750 /etc/apache2/AetherFlow
    RUT_HTPASSWD_ENTRY="$(printf '%s\n' "${MASTER_PASS}" | htpasswd -niB "${MASTER_USER}" 2>/dev/null || true)"
    if [[ -z "$RUT_HTPASSWD_ENTRY" || "$RUT_HTPASSWD_ENTRY" != *:* ]]; then
        print_error "Failed to generate /etc/apache2/AetherFlow/rutorrent.htpasswd; refusing unprotected ruTorrent VirtualHost"
        exit 1
    fi
    write_config_file /etc/apache2/AetherFlow/rutorrent.htpasswd 0640 <<EOF
${RUT_HTPASSWD_ENTRY}
EOF
    chown root:www-data /etc/apache2/AetherFlow/rutorrent.htpasswd 2>/dev/null || true
    chmod 0640 /etc/apache2/AetherFlow/rutorrent.htpasswd
fi
if [[ ! -s /etc/apache2/AetherFlow/rutorrent.htpasswd ]]; then
    print_error "Missing or empty /etc/apache2/AetherFlow/rutorrent.htpasswd; refusing unprotected ruTorrent VirtualHost"
    exit 1
fi

RUT_VHOST_HOST="127.0.0.1"
if [[ "${AF_APACHE_LISTEN_ALL:-0}" == "1" ]]; then
    RUT_VHOST_HOST="0.0.0.0"
fi
validate_config_paths /etc/apache2/sites-available/rutorrent.conf
if [[ -s /etc/apache2/sites-available/rutorrent.conf ]]; then
    safe_config_python /etc/apache2/sites-available/rutorrent.conf "${RUT_VHOST_HOST}" "${APP_PORT}" <<'RUT_VHOST_PYEOF'
import re, sys
path, vhost_host, port = sys.argv[1], sys.argv[2], sys.argv[3]
existing = safe_read_text(path)
updated = re.sub(
    r"<VirtualHost\s+([^:>]+):[0-9]+>",
    lambda m: f"<VirtualHost {vhost_host if m.group(1) in ('*', '0.0.0.0', '127.0.0.1') else m.group(1)}:{port}>",
    existing,
)
if updated != existing:
    safe_write_text(path, updated, 0o644)
RUT_VHOST_PYEOF
else
    write_config_file /etc/apache2/sites-available/rutorrent.conf 0644 <<EOF
<VirtualHost ${RUT_VHOST_HOST}:${APP_PORT}>
    DocumentRoot /var/www/rutorrent
    Alias /rutorrent "/var/www/rutorrent"
    <Directory /var/www/rutorrent>
        Options FollowSymLinks
        AllowOverride All
        AuthType Basic
        AuthName "ruTorrent"
        AuthUserFile /etc/apache2/AetherFlow/rutorrent.htpasswd
        Require valid-user
        DirectoryIndex index.php index.html
    </Directory>
</VirtualHost>
EOF
fi

apache_app_activate_vhost "${PACKAGE_NAME}" "$RUNTIME_BACKUP"

systemctl is-active --quiet apache2
wait_for_apache_app_ready "${PACKAGE_NAME}" "$APP_PORT" "/"

report_progress 95 "Checking ruTorrent's configured rTorrent SCGI backend..."
RUT_PROBE_USER="$(awk -F: 'NF >= 2 && $1 !~ /^#/ { print $1; exit }' /etc/apache2/AetherFlow/rutorrent.htpasswd)"
# Use ruTorrent's own configuration loader and XML-RPC transport as the web
# account, including socket permissions and the selected user's config.
if ! RUT_RPC_RESULT="$(timeout --kill-after=2s 12s env -i PATH="$PATH" \
    runuser -u www-data -- php -- /var/www/rutorrent "$RUT_PROBE_USER" 2>/dev/null <<'PHP'
<?php
$_SERVER['REQUEST_METHOD'] = 'GET';
$_SERVER['REMOTE_USER'] = $argv[2];
ob_start();
require $argv[1] . '/php/xmlrpc.php';
$rpcTimeOut = 3;
$rpcTransferTimeOut = 5;
$rpcMaxResponseBytes = 65536;
$rpcLogCalls = false;
$log_file = null;
ini_set('default_socket_timeout', '5');
ini_set('memory_limit', '64M');
// The higher-level request API also initializes rTorrent settings on a new profile.
$request = '<?xml version="1.0"?><methodCall><methodName>system.client_version</methodName><params/></methodCall>';
$reply = rXMLRPCRequest::send($request);
$body = explode("\r\n\r\n", (string) $reply, 2)[1] ?? '';
$response = $body === '' ? false : @simplexml_load_string($body, SimpleXMLElement::class, LIBXML_NONET);
$ready = $response !== false && $response->getName() === 'methodResponse' && !isset($response->fault)
    && trim((string) ($response->params->param->value->string ?? '')) !== '';
ob_end_clean();
echo $ready ? 'ready' : 'unavailable';
PHP
)" || [[ "$RUT_RPC_RESULT" != ready ]]; then
    RUT_RPC_ERROR="ruTorrent could not get an rTorrent SCGI response. Check the endpoint in /var/www/rutorrent/conf and ensure www-data can reach it. For the default 127.0.0.1:15000 endpoint, install or start Marketplace rTorrent, then retry."
    print_error "$RUT_RPC_ERROR"
    af_write_failure_receipt 1 readiness dependency_unavailable "$RUT_RPC_ERROR"
    exit 1
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
INSTALL_COMMITTED=true
report_progress 100 "ruTorrent is ready on port ${APP_PORT} and its configured rTorrent backend responded."
log_info "${PACKAGE_NAME} installed successfully"
