#!/bin/bash
# AetherFlow Package Installer: Prometheus + Node Exporter
# Ports: 9090 (Prometheus), 9100 (Node Exporter)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="prometheus"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9090}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Prometheus..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u prometheus >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin prometheus
fi
if ! id -u node_exporter >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin node_exporter
fi

mkdir -p /etc/prometheus /var/lib/prometheus

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) PROM_ARCH="linux-amd64" ;;
    arm64) PROM_ARCH="linux-arm64" ;;
    armhf) PROM_ARCH="linux-armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 30 "Downloading latest Prometheus (${PROM_ARCH})..."
PROM_VERSION="$(github_latest_tag "prometheus/prometheus" "2.53.1")"
PROM_URL="https://github.com/prometheus/prometheus/releases/download/v${PROM_VERSION}/prometheus-${PROM_VERSION}.${PROM_ARCH}.tar.gz"

TMP_DIR="$(mktemp -d /tmp/prometheus-extract-XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT
TMP_TAR="$TMP_DIR/prometheus.tar.gz"
curl -fsSL "$PROM_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_TAR" -C "$TMP_DIR" >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"

PROM_EXTRACTED="$TMP_DIR/prometheus-${PROM_VERSION}.${PROM_ARCH}"
systemctl stop prometheus node_exporter >> "$LOGFILE" 2>&1 || true
install_binary_atomic "${PROM_EXTRACTED}/prometheus" /usr/local/bin/prometheus
install_binary_atomic "${PROM_EXTRACTED}/promtool" /usr/local/bin/promtool
if [[ -d "${PROM_EXTRACTED}/consoles" ]]; then
    cp -r "${PROM_EXTRACTED}/consoles" /etc/prometheus/
fi
if [[ -d "${PROM_EXTRACTED}/console_libraries" ]]; then
    cp -r "${PROM_EXTRACTED}/console_libraries" /etc/prometheus/
fi
rm -rf "$PROM_EXTRACTED"
chmod +x /usr/local/bin/prometheus /usr/local/bin/promtool

report_progress 60 "Downloading and installing Node Exporter..."
NE_VERSION="$(github_latest_tag "prometheus/node_exporter" "1.8.2")"
NE_URL="https://github.com/prometheus/node_exporter/releases/download/v${NE_VERSION}/node_exporter-${NE_VERSION}.${PROM_ARCH}.tar.gz"

TMP_NE="$TMP_DIR/node_exporter.tar.gz"
curl -fsSL "$NE_URL" -o "$TMP_NE" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_NE" -C "$TMP_DIR" >> "$LOGFILE" 2>&1
rm -f "$TMP_NE"

install_binary_atomic "$TMP_DIR/node_exporter-${NE_VERSION}.${PROM_ARCH}/node_exporter" /usr/local/bin/node_exporter
rm -rf "$TMP_DIR/node_exporter-${NE_VERSION}.${PROM_ARCH}"
chmod +x /usr/local/bin/node_exporter

if [[ ! -f /etc/prometheus/prometheus.yml ]]; then
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/prometheus/prometheus.yml
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:@AF_APP_PORT@']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:9100']
EOF
fi

chown -R prometheus:prometheus /etc/prometheus /var/lib/prometheus
chown prometheus:prometheus /usr/local/bin/prometheus /usr/local/bin/promtool
chown node_exporter:node_exporter /usr/local/bin/node_exporter

report_progress 85 "Configuring and starting prometheus.service and node_exporter.service..."
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/systemd/system/prometheus.service
[Unit]
Description=Prometheus Monitoring Time-Series Database
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/usr/local/bin/prometheus \
    --config.file /etc/prometheus/prometheus.yml \
    --storage.tsdb.path /var/lib/prometheus/ \
    --web.listen-address=0.0.0.0:@AF_APP_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat <<'EOF' > /etc/systemd/system/node_exporter.service
[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now node_exporter >> "$LOGFILE" 2>&1
systemctl restart node_exporter >> "$LOGFILE" 2>&1
systemctl enable --now prometheus >> "$LOGFILE" 2>&1
systemctl restart prometheus >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Prometheus installed on port ${APP_PORT} (with Node Exporter on port 9100)."
log_info "${PACKAGE_NAME} installed successfully"
