#!/bin/bash
# AetherFlow Package Installer: Prometheus + Node Exporter
# Ports: 9090 (Prometheus), 9100 (Node Exporter)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="prometheus"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9090}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
if [[ ! "$APP_PORT" =~ ^[0-9]+$ ]] || (( 10#$APP_PORT < 1 || 10#$APP_PORT > 65535 )); then
    print_error "Invalid Prometheus port: ${APP_PORT}"
    exit 1
fi
APP_PORT="$((10#$APP_PORT))"
export AF_APP_PORT="$APP_PORT"

PROM_BIND_ADDRESS="${AF_BIND_ADDRESS:-127.0.0.1}"
if [[ ! "$PROM_BIND_ADDRESS" =~ ^[a-zA-Z0-9_.:-]+$ && ! "$PROM_BIND_ADDRESS" =~ ^\[[0-9a-fA-F:]+\]$ ]]; then
    print_error "Invalid bind address for Prometheus/Node Exporter: ${PROM_BIND_ADDRESS}"
    exit 1
fi
if [[ "$PROM_BIND_ADDRESS" == *:* && "$PROM_BIND_ADDRESS" != \[*\] ]]; then
    PROM_BIND_ADDRESS="[${PROM_BIND_ADDRESS}]"
fi

NODE_EXPORTER_PORT_EXPLICIT=false
if [[ -n "${AF_NODE_EXPORTER_PORT:-}" ]]; then
    NODE_EXPORTER_PORT_EXPLICIT=true
    NODE_EXPORTER_PORT="${AF_NODE_EXPORTER_PORT}"
else
    NODE_EXPORTER_PORT="9100"
fi
if [[ ! "$NODE_EXPORTER_PORT" =~ ^[0-9]+$ ]] || (( 10#$NODE_EXPORTER_PORT < 1 || 10#$NODE_EXPORTER_PORT > 65535 )); then
    print_error "Invalid Node Exporter port: ${NODE_EXPORTER_PORT}"
    exit 1
fi
NODE_EXPORTER_PORT="$((10#$NODE_EXPORTER_PORT))"

if (( NODE_EXPORTER_PORT == APP_PORT )); then
    if [[ "$NODE_EXPORTER_PORT_EXPLICIT" == true ]]; then
        print_error "Prometheus port (${APP_PORT}) collides with configured AF_NODE_EXPORTER_PORT (${NODE_EXPORTER_PORT})."
        exit 1
    fi
    EXISTING_NE_PORT=""
    if [[ -f /etc/systemd/system/node_exporter.service && ! -L /etc/systemd/system/node_exporter.service ]]; then
        EXISTING_NE_PORT="$(sed -nE 's/.*--web\.listen-address=[^[:space:]]*:([0-9]+).*/\1/p' /etc/systemd/system/node_exporter.service | head -n1 || true)"
    fi
    if [[ "$EXISTING_NE_PORT" =~ ^[0-9]+$ ]] && (( 10#$EXISTING_NE_PORT >= 1024 && 10#$EXISTING_NE_PORT <= 65535 && 10#$EXISTING_NE_PORT != APP_PORT )); then
        NODE_EXPORTER_PORT="$((10#$EXISTING_NE_PORT))"
    else
        NODE_EXPORTER_PORT="$(python3 - "$APP_PORT" <<'PYEOF'
import socket
import sys

app_port = int(sys.argv[1])
for candidate in range(9101, 9200):
    if candidate == app_port:
        continue
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", candidate))
        print(candidate)
        sys.exit(0)
    except OSError:
        continue
    finally:
        sock.close()
sys.exit(1)
PYEOF
)" || {
            print_error "Prometheus port (${APP_PORT}) collides with default Node Exporter port 9100 and no free loopback port was found in 9101-9199."
            exit 1
        }
    fi
    log_warn "Prometheus port ${APP_PORT} collides with default Node Exporter port 9100; shifting Node Exporter to ${PROM_BIND_ADDRESS}:${NODE_EXPORTER_PORT}."
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Prometheus..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl tar ca-certificates jq

if ! id -u prometheus >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin prometheus
fi
if ! id -u node_exporter >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin node_exporter
fi

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) PROM_ARCH="linux-amd64" ;;
    arm64) PROM_ARCH="linux-arm64" ;;
    armhf) PROM_ARCH="linux-armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-runtime-")"
RUNTIME_PATHS=("/usr/local/bin/prometheus" "/usr/local/bin/promtool" "/usr/local/bin/node_exporter" "/usr/bin/prometheus" "/usr/bin/prometheus-node-exporter" "/etc/prometheus" "/var/lib/prometheus" "/etc/systemd/system/prometheus.service" "/etc/systemd/system/node_exporter.service" "/usr/bin/promtool" "/usr/share/prometheus" "/usr/share/prometheus-node-exporter")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_MUTATED=0
if [[ -e /usr/local/bin/prometheus || -e /usr/bin/prometheus || -e /etc/systemd/system/prometheus.service || -e /etc/systemd/system/node_exporter.service ]] || systemctl is-active --quiet prometheus 2>/dev/null || systemctl is-active --quiet node_exporter 2>/dev/null; then
    RUNTIME_HAD_PREVIOUS=true
fi
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback prometheus node_exporter || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        af_logged systemctl daemon-reload || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" == true ]]; then
            af_logged systemctl restart prometheus node_exporter || restore_failed=true
        fi
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
report_progress 30 "Downloading Prometheus (${PROM_ARCH})..."
PROM_VERSION="$(github_latest_tag "prometheus/prometheus" "2.53.1")"
PROM_URL="https://github.com/prometheus/prometheus/releases/download/v${PROM_VERSION}/prometheus-${PROM_VERSION}.${PROM_ARCH}.tar.gz"

mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_DIR="$(mktemp -d "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/prometheus-extract-XXXXXX")"
TMP_TAR="$TMP_DIR/prometheus.tar.gz"
af_logged download_file "$PROM_URL" "$TMP_TAR"
af_validate_tar_archive "$TMP_TAR"
af_logged tar --no-same-owner --no-same-permissions -xzf "$TMP_TAR" -C "$TMP_DIR"
rm -f "$TMP_TAR"

PROM_EXTRACTED="$TMP_DIR/prometheus-${PROM_VERSION}.${PROM_ARCH}"

report_progress 50 "Downloading and extracting Node Exporter..."
# The lifecycle target identifies Prometheus. Node Exporter has its own releases.
NE_VERSION="$(AF_TARGET_VERSION= github_latest_tag "prometheus/node_exporter" "1.8.2")"
NE_URL="https://github.com/prometheus/node_exporter/releases/download/v${NE_VERSION}/node_exporter-${NE_VERSION}.${PROM_ARCH}.tar.gz"
TMP_NE="$TMP_DIR/node_exporter.tar.gz"
af_logged download_file "$NE_URL" "$TMP_NE"
af_validate_tar_archive "$TMP_NE"
af_logged tar --no-same-owner --no-same-permissions -xzf "$TMP_NE" -C "$TMP_DIR"
rm -f "$TMP_NE"
test -s "${PROM_EXTRACTED}/prometheus"
test -s "${PROM_EXTRACTED}/promtool"
test -s "$TMP_DIR/node_exporter-${NE_VERSION}.${PROM_ARCH}/node_exporter"

if [[ "$RUNTIME_HAD_PREVIOUS" == true ]]; then
    stop_systemd_unit prometheus
    stop_systemd_unit node_exporter
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
RUNTIME_MUTATED=1
mkdir -p /etc/prometheus /var/lib/prometheus
install_binary_atomic "${PROM_EXTRACTED}/prometheus" /usr/local/bin/prometheus
if [[ ! -e /usr/bin/prometheus && ! -L /usr/bin/prometheus ]]; then
    ln -s /usr/local/bin/prometheus /usr/bin/prometheus
fi
install_binary_atomic "${PROM_EXTRACTED}/promtool" /usr/local/bin/promtool
if [[ -d "${PROM_EXTRACTED}/consoles" ]]; then
    cp -r "${PROM_EXTRACTED}/consoles" /etc/prometheus/
fi
if [[ -d "${PROM_EXTRACTED}/console_libraries" ]]; then
    cp -r "${PROM_EXTRACTED}/console_libraries" /etc/prometheus/
fi
rm -rf "$PROM_EXTRACTED"
chmod 0755 /usr/local/bin/prometheus /usr/local/bin/promtool

report_progress 60 "Installing Node Exporter..."
install_binary_atomic "$TMP_DIR/node_exporter-${NE_VERSION}.${PROM_ARCH}/node_exporter" /usr/local/bin/node_exporter
if [[ ! -e /usr/bin/prometheus-node-exporter && ! -L /usr/bin/prometheus-node-exporter ]]; then
    ln -s /usr/local/bin/node_exporter /usr/bin/prometheus-node-exporter
fi
rm -rf "$TMP_DIR/node_exporter-${NE_VERSION}.${PROM_ARCH}"
chmod 0755 /usr/local/bin/node_exporter

if [[ ! -f /etc/prometheus/prometheus.yml ]]; then
sed -e "s|@AF_APP_PORT@|${APP_PORT}|g" -e "s|@AF_NODE_EXPORTER_PORT@|${NODE_EXPORTER_PORT}|g" <<'EOF' > /etc/prometheus/prometheus.yml
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:@AF_APP_PORT@']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:@AF_NODE_EXPORTER_PORT@']
EOF
elif [[ ! -L /etc/prometheus/prometheus.yml ]]; then
    safe_config_python "$NODE_EXPORTER_PORT" <<'PYEOF'
import re
import sys

ne_port = sys.argv[1]
with ManagedConfig('/etc/prometheus/prometheus.yml', create_parents=False) as cfg:
    text = cfg.read_text()

    def repl_job(match):
        block = match.group(0)
        return re.sub(r"((?:localhost|127\.0\.0\.1):)\d+", rf"\g<1>{ne_port}", block)

    updated = re.sub(
        r"(?ms)(^[ \t]*-[ \t]*job_name:[ \t]*['\"]?node_exporter['\"]?.*?)(?=^[ \t]*-[ \t]*job_name:|\Z)",
        repl_job,
        text,
    )
    if updated != text:
        cfg.write_text(updated, 0o644)
PYEOF
fi

chown -hRP prometheus:prometheus /etc/prometheus /var/lib/prometheus

report_progress 85 "Configuring and starting prometheus.service and node_exporter.service..."
sed -e "s|@AF_APP_PORT@|${APP_PORT}|g" -e "s|@AF_BIND_ADDRESS@|${PROM_BIND_ADDRESS}|g" <<'EOF' > /etc/systemd/system/prometheus.service
[Unit]
Description=Prometheus Monitoring Time-Series Database
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/usr/local/bin/prometheus \
    --config.file /etc/prometheus/prometheus.yml \
    --storage.tsdb.path /var/lib/prometheus/ \
    --web.listen-address=@AF_BIND_ADDRESS@:@AF_APP_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/prometheus.service

sed -e "s|@AF_NODE_EXPORTER_PORT@|${NODE_EXPORTER_PORT}|g" -e "s|@AF_BIND_ADDRESS@|${PROM_BIND_ADDRESS}|g" <<'EOF' > /etc/systemd/system/node_exporter.service
[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter --web.listen-address=@AF_BIND_ADDRESS@:@AF_NODE_EXPORTER_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/node_exporter.service

af_logged systemctl daemon-reload
af_logged systemctl enable --now node_exporter
af_logged systemctl restart node_exporter
af_logged systemctl enable --now prometheus
af_logged systemctl restart prometheus

report_progress 95 "Verifying HTTP readiness and running versions for Prometheus and Node Exporter..."
no_proxy=127.0.0.1 wait_for_service_ready prometheus "$APP_PORT" /-/ready
no_proxy=127.0.0.1 wait_for_service_ready node_exporter "$NODE_EXPORTER_PORT" /metrics
PROM_LIVE_VERSION="$(curl --noproxy '*' --proto '=http' -fsS --connect-timeout 2 --max-time 5 \
    --max-filesize 65536 "http://127.0.0.1:${APP_PORT}/api/v1/status/buildinfo" |
    jq -er 'select(.status == "success") | .data.version')"
NE_LIVE_VERSION="$(curl --noproxy '*' --proto '=http' -fsS --connect-timeout 2 --max-time 5 \
    --max-filesize 4194304 "http://127.0.0.1:${NODE_EXPORTER_PORT}/metrics" |
    sed -nE '/^node_exporter_build_info\{/s/.*[{,]version="([^"]+)".*/\1/p')"
if [[ "$PROM_LIVE_VERSION" != "$PROM_VERSION" || "$NE_LIVE_VERSION" != "$NE_VERSION" ]]; then
    print_error "Running Prometheus or Node Exporter version does not match the release downloaded."
    exit 1
fi
queue_app_version /etc/prometheus/.af-version "$PROM_LIVE_VERSION"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Prometheus installed on port ${APP_PORT} (with Node Exporter on port ${NODE_EXPORTER_PORT})."
log_info "${PACKAGE_NAME} installed successfully"
