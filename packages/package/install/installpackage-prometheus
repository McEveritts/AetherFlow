#!/bin/bash
# AetherFlow Package Installer: Prometheus + Node Exporter
# Ports: 9090 (Prometheus), 9100 (Node Exporter)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="prometheus"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Prometheus..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u prometheus >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin prometheus
fi
if ! id -u node_exporter >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin node_exporter
fi

mkdir -p /etc/prometheus /var/lib/prometheus

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) PROM_ARCH="linux-amd64" ;;
    arm64) PROM_ARCH="linux-arm64" ;;
    armhf) PROM_ARCH="linux-armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 30 "Downloading latest Prometheus (${PROM_ARCH})..."
PROM_JSON="$(curl -fsSL https://api.github.com/repos/prometheus/prometheus/releases/latest 2>/dev/null || true)"
PROM_VERSION="$(printf '%s' "$PROM_JSON" | grep -oP '"tag_name":\s*"v\K[^"]+' | head -1 || true)"
PROM_VERSION="${PROM_VERSION:-2.53.1}"
PROM_URL="https://github.com/prometheus/prometheus/releases/download/v${PROM_VERSION}/prometheus-${PROM_VERSION}.${PROM_ARCH}.tar.gz"

TMP_TAR=$(mktemp /tmp/prometheus-XXXXXX.tar.gz)
curl -fsSL "$PROM_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_TAR" -C /tmp >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"

PROM_EXTRACTED="/tmp/prometheus-${PROM_VERSION}.${PROM_ARCH}"
cp "${PROM_EXTRACTED}/prometheus" /usr/local/bin/
cp "${PROM_EXTRACTED}/promtool" /usr/local/bin/
if [[ -d "${PROM_EXTRACTED}/consoles" ]]; then
    cp -r "${PROM_EXTRACTED}/consoles" /etc/prometheus/
fi
if [[ -d "${PROM_EXTRACTED}/console_libraries" ]]; then
    cp -r "${PROM_EXTRACTED}/console_libraries" /etc/prometheus/
fi
rm -rf "$PROM_EXTRACTED"
chmod +x /usr/local/bin/prometheus /usr/local/bin/promtool

report_progress 60 "Downloading and installing Node Exporter..."
NE_JSON="$(curl -fsSL https://api.github.com/repos/prometheus/node_exporter/releases/latest 2>/dev/null || true)"
NE_VERSION="$(printf '%s' "$NE_JSON" | grep -oP '"tag_name":\s*"v\K[^"]+' | head -1 || true)"
NE_VERSION="${NE_VERSION:-1.8.2}"
NE_URL="https://github.com/prometheus/node_exporter/releases/download/v${NE_VERSION}/node_exporter-${NE_VERSION}.${PROM_ARCH}.tar.gz"

TMP_NE=$(mktemp /tmp/node_exporter-XXXXXX.tar.gz)
curl -fsSL "$NE_URL" -o "$TMP_NE" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_NE" -C /tmp >> "$LOGFILE" 2>&1
rm -f "$TMP_NE"

cp "/tmp/node_exporter-${NE_VERSION}.${PROM_ARCH}/node_exporter" /usr/local/bin/
rm -rf "/tmp/node_exporter-${NE_VERSION}.${PROM_ARCH}"
chmod +x /usr/local/bin/node_exporter

cat <<'EOF' > /etc/prometheus/prometheus.yml
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:9100']
EOF

chown -R prometheus:prometheus /etc/prometheus /var/lib/prometheus
chown prometheus:prometheus /usr/local/bin/prometheus /usr/local/bin/promtool
chown node_exporter:node_exporter /usr/local/bin/node_exporter

report_progress 85 "Configuring and starting prometheus.service and node_exporter.service..."
cat <<'EOF' > /etc/systemd/system/prometheus.service
[Unit]
Description=Prometheus Monitoring Time-Series Database
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/usr/local/bin/prometheus \
    --config.file /etc/prometheus/prometheus.yml \
    --storage.tsdb.path /var/lib/prometheus/ \
    --web.listen-address=0.0.0.0:9090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat <<'EOF' > /etc/systemd/system/node_exporter.service
[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now node_exporter >> "$LOGFILE" 2>&1
systemctl enable --now prometheus >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Prometheus installed on port 9090 (with Node Exporter on port 9100)."
log_info "${PACKAGE_NAME} installed successfully"
