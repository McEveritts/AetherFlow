#!/bin/bash
# AetherFlow Package Installer: Unpackerr
# Port: 0 (Zero-Touch Arr extraction daemon)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="unpackerr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /etc/unpackerr/unpackerr.conf
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing extraction tools and prerequisites for Unpackerr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl gzip tar unzip unrar-free ca-certificates

if ! id -u unpackerr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/unpackerr --shell /usr/sbin/nologin unpackerr
fi

mkdir -p /etc/unpackerr /var/lib/unpackerr /opt/unpackerr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) UP_TAR_ARCH="amd64"; UP_GZ_ARCH="amd64.linux.gz" ;;
    arm64) UP_TAR_ARCH="arm64"; UP_GZ_ARCH="arm64.linux.gz" ;;
    armhf) UP_TAR_ARCH="armhf"; UP_GZ_ARCH="arm.linux.gz" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Unpackerr binary release..."
UP_VERSION="$(github_latest_tag "Unpackerr/unpackerr" "1.0.0")"
UP_TAR_URL="https://github.com/Unpackerr/unpackerr/releases/download/v${UP_VERSION}/unpackerr_${UP_VERSION}_linux_${UP_TAR_ARCH}.tar.gz"
UP_GZ_URL="https://github.com/davidnewhall/unpackerr/releases/download/v${UP_VERSION}/unpackerr.${UP_GZ_ARCH}"

report_progress 60 "Downloading Unpackerr ${UP_VERSION}..."
TMP_ARCHIVE=$(mktemp /tmp/unpackerr-XXXXXX)
TMP_DIR="$(mktemp -d /tmp/unpackerr-extract-XXXXXX)"
trap '[[ -z "${TMP_DIR:-}" ]] || rm -rf "$TMP_DIR"; rm -f "$TMP_ARCHIVE"' EXIT
if af_logged download_file "$UP_TAR_URL" "$TMP_ARCHIVE"; then
    af_logged tar --no-same-owner -xzf "$TMP_ARCHIVE" -C "$TMP_DIR" unpackerr
else
    af_logged download_file "$UP_GZ_URL" "$TMP_ARCHIVE"
    gzip -dc "$TMP_ARCHIVE" > "$TMP_DIR/unpackerr"
fi
rm -f "$TMP_ARCHIVE"
af_logged systemctl stop unpackerr || true
chmod 755 "$TMP_DIR/unpackerr"
stage_app_archive "$TMP_DIR" /usr/local/bin/unpackerr unpackerr /etc/unpackerr "$PACKAGE_NAME" "." /opt/unpackerr "" binary
TMP_DIR=""
queue_app_version /opt/unpackerr/.af-version "${UP_VERSION#v}"

report_progress 75 "Executing Zero-Touch Arr API discovery..."
get_arr_key() {
    local app="$1"
    local xml_file="/var/lib/${app}/config.xml"
    if [[ -f "$xml_file" ]]; then
        grep -oP '<ApiKey>\K[^<]+' "$xml_file" 2>/dev/null || sed -n 's/.*<ApiKey>\(.*\)<\/ApiKey>.*/\1/p' "$xml_file" 2>/dev/null || true
    fi
}

SONARR_KEY=$(get_arr_key "sonarr")
RADARR_KEY=$(get_arr_key "radarr")
LIDARR_KEY=$(get_arr_key "lidarr")
READARR_KEY=$(get_arr_key "readarr")

if [[ ! -f /etc/unpackerr/unpackerr.conf ]]; then
cat <<EOF > /etc/unpackerr/unpackerr.conf
# Unpackerr Configuration - Generated by AetherFlow
debug = false
quiet = false
error_stderr = false
activity = false
log_queues = "1m"
log_files = 10
log_file_mb = 10
interval = "2m"
start_delay = "1m"
retry_delay = "5m"
max_retries = 3
parallel = 1
file_mode = "0644"
dir_mode = "0755"

EOF

if [[ -n "$SONARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[sonarr]]
  url = "http://127.0.0.1:8989"
  api_key = "${SONARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs", "/var/lib/rtorrent/downloads"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
else
    cat <<'EOF' >> /etc/unpackerr/unpackerr.conf
# [[sonarr]]
#   url = "http://127.0.0.1:8989"
#   api_key = ""
#   paths = ["/downloads", "/mnt/unionfs"]

EOF
fi

if [[ -n "$RADARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[radarr]]
  url = "http://127.0.0.1:7878"
  api_key = "${RADARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs", "/var/lib/rtorrent/downloads"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
else
    cat <<'EOF' >> /etc/unpackerr/unpackerr.conf
# [[radarr]]
#   url = "http://127.0.0.1:7878"
#   api_key = ""
#   paths = ["/downloads", "/mnt/unionfs"]

EOF
fi

if [[ -n "$LIDARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[lidarr]]
  url = "http://127.0.0.1:8686"
  api_key = "${LIDARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
fi

if [[ -n "$READARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[readarr]]
  url = "http://127.0.0.1:8787"
  api_key = "${READARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
fi
fi

chown -hRP unpackerr:unpackerr /etc/unpackerr /var/lib/unpackerr /opt/unpackerr
chmod 640 /etc/unpackerr/unpackerr.conf

report_progress 85 "Configuring and starting unpackerr.service..."
cat <<'EOF' > /etc/systemd/system/unpackerr.service
[Unit]
Description=Unpackerr Archive Extraction Daemon
After=network.target

[Service]
User=unpackerr
Group=unpackerr
Type=simple
ExecStart=/usr/local/bin/unpackerr --config /etc/unpackerr/unpackerr.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now unpackerr
af_logged systemctl restart unpackerr
systemctl is-active --quiet unpackerr
rm -rf -- "$AF_ARCHIVE_BACKUP/release"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Unpackerr installed (Zero-Touch Arr config active)."
log_info "${PACKAGE_NAME} installed successfully"
