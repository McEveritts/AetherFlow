#!/bin/bash
# AetherFlow Package Installer: Unpackerr
# Port: 0 (Zero-Touch Arr extraction daemon)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="unpackerr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths \
    /etc/unpackerr/unpackerr.conf \
    /var/lib/sonarr/config.xml \
    /var/lib/radarr/config.xml \
    /var/lib/lidarr/config.xml \
    /var/lib/readarr/config.xml
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing extraction tools and prerequisites for Unpackerr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq python3 python3-tomlkit curl gzip tar unzip unrar-free ca-certificates

if ! id -u unpackerr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/unpackerr --shell /usr/sbin/nologin unpackerr
fi

mkdir -p /etc/unpackerr /var/lib/unpackerr /opt/unpackerr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) UP_TAR_ARCH="amd64"; UP_GZ_ARCH="amd64.linux.gz" ;;
    arm64) UP_TAR_ARCH="arm64"; UP_GZ_ARCH="arm64.linux.gz" ;;
    armhf) UP_TAR_ARCH="armhf"; UP_GZ_ARCH="arm.linux.gz" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Unpackerr binary release..."
UP_VERSION="$(github_latest_tag "Unpackerr/unpackerr" "1.0.0")"
UP_TAR_URL="https://github.com/Unpackerr/unpackerr/releases/download/v${UP_VERSION}/unpackerr_${UP_VERSION}_linux_${UP_TAR_ARCH}.tar.gz"
UP_GZ_URL="https://github.com/davidnewhall/unpackerr/releases/download/v${UP_VERSION}/unpackerr.${UP_GZ_ARCH}"

report_progress 60 "Downloading Unpackerr ${UP_VERSION}..."
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_ARCHIVE=$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/unpackerr-XXXXXX")
TMP_DIR="$(mktemp -d "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/unpackerr-extract-XXXXXX")"
trap '[[ -z "${TMP_DIR:-}" ]] || rm -rf "$TMP_DIR"; rm -f "$TMP_ARCHIVE"' EXIT
if af_logged download_file "$UP_TAR_URL" "$TMP_ARCHIVE"; then
    af_validate_tar_archive "$TMP_ARCHIVE"
    af_logged tar --no-same-permissions --no-same-owner -xzf "$TMP_ARCHIVE" -C "$TMP_DIR" unpackerr
else
    af_logged download_file "$UP_GZ_URL" "$TMP_ARCHIVE"
    gzip -dc "$TMP_ARCHIVE" > "$TMP_DIR/unpackerr"
fi
rm -f "$TMP_ARCHIVE"
af_logged systemctl stop unpackerr || true
chmod 755 "$TMP_DIR/unpackerr"
stage_app_archive "$TMP_DIR" /usr/local/bin/unpackerr unpackerr /etc/unpackerr "$PACKAGE_NAME" "." /opt/unpackerr "" binary
TMP_DIR=""
queue_app_version /opt/unpackerr/.af-version "${UP_VERSION#v}"

report_progress 75 "Executing Zero-Touch Arr API discovery..."
validate_config_paths \
    /etc/unpackerr/unpackerr.conf \
    /var/lib/sonarr/config.xml \
    /var/lib/radarr/config.xml \
    /var/lib/lidarr/config.xml \
    /var/lib/readarr/config.xml
sync_servarr_toml_config "unpackerr" "/etc/unpackerr/unpackerr.conf"

chown -hRP unpackerr:unpackerr /etc/unpackerr /var/lib/unpackerr /opt/unpackerr
set_config_file_mode 0600 /etc/unpackerr/unpackerr.conf

report_progress 85 "Configuring and starting unpackerr.service..."
cat <<'EOF' > /etc/systemd/system/unpackerr.service
[Unit]
Description=Unpackerr Archive Extraction Daemon
After=network.target

[Service]
User=unpackerr
Group=unpackerr
Type=simple
ExecStart=/usr/local/bin/unpackerr --config /etc/unpackerr/unpackerr.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/unpackerr.service

af_logged systemctl daemon-reload
af_logged systemctl enable --now unpackerr
af_logged systemctl restart unpackerr
systemctl is-active --quiet unpackerr
rm -rf -- "$AF_ARCHIVE_BACKUP/release"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Unpackerr installed (Zero-Touch Arr config active)."
log_info "${PACKAGE_NAME} installed successfully"
