#!/bin/bash
# AetherFlow Package Installer: Unpackerr
# Port: 0 (Zero-Touch Arr extraction daemon)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="unpackerr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing extraction tools and prerequisites for Unpackerr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl gzip tar unzip unrar-free ca-certificates >> "$LOGFILE" 2>&1

if ! id -u unpackerr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/unpackerr --shell /usr/sbin/nologin unpackerr
fi

mkdir -p /etc/unpackerr /var/lib/unpackerr /opt/unpackerr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) UP_ARCH="amd64.linux.gz" ;;
    arm64) UP_ARCH="arm64.linux.gz" ;;
    armhf) UP_ARCH="arm.linux.gz" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Unpackerr binary release..."
UP_JSON="$(curl -fsSL https://api.github.com/repos/davidnewhall/unpackerr/releases/latest 2>/dev/null || true)"
UP_VERSION="$(printf '%s' "$UP_JSON" | grep -oP '"tag_name":\s*"v\K[^"]+' | head -1 || true)"
UP_VERSION="${UP_VERSION:-0.14.5}"
UP_URL="$(printf '%s' "$UP_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*unpackerr\.'${UP_ARCH} | head -1 || true)"
if [[ -z "$UP_URL" ]]; then
    UP_URL="https://github.com/davidnewhall/unpackerr/releases/download/v${UP_VERSION}/unpackerr.${UP_ARCH}"
fi

report_progress 60 "Downloading Unpackerr ${UP_VERSION}..."
TMP_GZ=$(mktemp /tmp/unpackerr-XXXXXX.gz)
curl -fsSL "$UP_URL" -o "$TMP_GZ" >> "$LOGFILE" 2>&1
gzip -dc "$TMP_GZ" > /usr/local/bin/unpackerr
rm -f "$TMP_GZ"
chmod 755 /usr/local/bin/unpackerr
printf '%s\n' "${UP_VERSION#v}" > /opt/unpackerr/.af-version

report_progress 75 "Executing Zero-Touch Arr API discovery..."
get_arr_key() {
    local app="$1"
    local xml_file="/var/lib/${app}/config.xml"
    if [[ -f "$xml_file" ]]; then
        grep -oP '<ApiKey>\K[^<]+' "$xml_file" 2>/dev/null || sed -n 's/.*<ApiKey>\(.*\)<\/ApiKey>.*/\1/p' "$xml_file" 2>/dev/null || true
    fi
}

SONARR_KEY=$(get_arr_key "sonarr")
RADARR_KEY=$(get_arr_key "radarr")
LIDARR_KEY=$(get_arr_key "lidarr")
READARR_KEY=$(get_arr_key "readarr")

cat <<EOF > /etc/unpackerr/unpackerr.conf
# Unpackerr Configuration - Generated by AetherFlow
debug = false
quiet = false
error_stderr = false
activity = false
log_queues = "1m"
log_files = 10
log_file_mb = 10
interval = "2m"
start_delay = "1m"
retry_delay = "5m"
max_retries = 3
parallel = 1
file_mode = "0644"
dir_mode = "0755"

EOF

if [[ -n "$SONARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[sonarr]]
  url = "http://127.0.0.1:8989"
  api_key = "${SONARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs", "/var/lib/rtorrent/downloads"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
else
    cat <<'EOF' >> /etc/unpackerr/unpackerr.conf
# [[sonarr]]
#   url = "http://127.0.0.1:8989"
#   api_key = ""
#   paths = ["/downloads", "/mnt/unionfs"]

EOF
fi

if [[ -n "$RADARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[radarr]]
  url = "http://127.0.0.1:7878"
  api_key = "${RADARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs", "/var/lib/rtorrent/downloads"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
else
    cat <<'EOF' >> /etc/unpackerr/unpackerr.conf
# [[radarr]]
#   url = "http://127.0.0.1:7878"
#   api_key = ""
#   paths = ["/downloads", "/mnt/unionfs"]

EOF
fi

if [[ -n "$LIDARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[lidarr]]
  url = "http://127.0.0.1:8686"
  api_key = "${LIDARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
fi

if [[ -n "$READARR_KEY" ]]; then
    cat <<EOF >> /etc/unpackerr/unpackerr.conf
[[readarr]]
  url = "http://127.0.0.1:8787"
  api_key = "${READARR_KEY}"
  paths = ["/downloads", "/mnt/unionfs"]
  protocols = "torrent"
  timeout = "10s"
  delete_orig = false

EOF
fi

chown -R unpackerr:unpackerr /etc/unpackerr /var/lib/unpackerr /opt/unpackerr
chmod 640 /etc/unpackerr/unpackerr.conf

report_progress 85 "Configuring and starting unpackerr.service..."
cat <<'EOF' > /etc/systemd/system/unpackerr.service
[Unit]
Description=Unpackerr Archive Extraction Daemon
After=network.target

[Service]
User=unpackerr
Group=unpackerr
Type=simple
ExecStart=/usr/local/bin/unpackerr --config /etc/unpackerr/unpackerr.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now unpackerr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Unpackerr installed (Zero-Touch Arr config active)."
log_info "${PACKAGE_NAME} installed successfully"
