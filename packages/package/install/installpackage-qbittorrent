#!/bin/bash
# AetherFlow Package Installer: qBittorrent (qbittorrent-nox)
# Port: 8180

set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="qbittorrent"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8180}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
PACKAGE_NAME="${PACKAGE_NAME:-qbittorrent}"
begin_state_transaction "qbittorrent" "$APP_PORT" "/" "/var/lib/qbittorrent" "/etc/qbittorrent" "/etc/systemd/system/qbittorrent.service" "/usr/bin/qbittorrent-nox" "/usr/lib/qbittorrent" "/usr/share/qbittorrent"

prepare_apt_package_transaction /var/lib/qbittorrent/.af-version qbittorrent-nox
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing qbittorrent-nox via APT..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq qbittorrent-nox

if ! id -u qbittorrent >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/qbittorrent --shell /usr/sbin/nologin qbittorrent
fi

report_progress 55 "Configuring qBittorrent WebUI on port ${APP_PORT}..."
af_logged systemctl stop qbittorrent || true
mkdir -p /var/lib/qbittorrent/.config/qBittorrent/config /var/lib/qbittorrent/Downloads

QBT_PBKDF2="$(generate_qbittorrent_pbkdf2 "${MASTER_PASS}")"
if [[ ! -s /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf && -s /var/lib/qbittorrent/.config/qBittorrent/config/qBittorrent.conf ]]; then
    cp -a /var/lib/qbittorrent/.config/qBittorrent/config/qBittorrent.conf /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf
fi
if [[ ! -s /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf ]]; then
write_config_file /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf 0600 <<EOF
[LegalNotice]
Accepted=true

[Preferences]
WebUI\Port=${APP_PORT}
WebUI\Address=127.0.0.1
WebUI\ServerDomains=*
WebUI\CSRFProtection=true
WebUI\HostHeaderValidation=true
WebUI\Username=${MASTER_USER}
WebUI\Password_PBKDF2="${QBT_PBKDF2}"
Downloads\SavePath=/var/lib/qbittorrent/Downloads/
EOF
fi

set_config_value "/var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf" ini "WebUI\Port" "$APP_PORT" "Preferences"
if [[ -s /var/lib/qbittorrent/.config/qBittorrent/config/qBittorrent.conf ]]; then
    set_config_value /var/lib/qbittorrent/.config/qBittorrent/config/qBittorrent.conf ini 'WebUI\Port' "$APP_PORT" Preferences
fi

chown -hRP qbittorrent:qbittorrent /var/lib/qbittorrent
set_config_file_mode 0600 /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf

report_progress 85 "Configuring and starting qbittorrent.service on port ${APP_PORT}..."
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' | write_config_file /etc/systemd/system/qbittorrent.service 0644
[Unit]
Description=qBittorrent-nox Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qbittorrent
Group=qbittorrent
UMask=007
Environment=HOME=/var/lib/qbittorrent
ExecStart=/usr/bin/qbittorrent-nox --webui-port=@AF_APP_PORT@
Restart=on-failure
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF


af_logged systemctl daemon-reload
af_logged systemctl enable --now qbittorrent
af_logged systemctl restart qbittorrent

systemctl is-active --quiet qbittorrent
queue_app_version /var/lib/qbittorrent/.af-version "$(dpkg-query -W -f='${Version}' qbittorrent-nox)"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "qBittorrent installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
