#!/bin/bash
# AetherFlow Package Installer: qBittorrent (qbittorrent-nox)
# Port: 8180

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="qbittorrent"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing qbittorrent-nox via APT..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq qbittorrent-nox >> "$LOGFILE" 2>&1

if ! id -u qbittorrent >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/qbittorrent --shell /usr/sbin/nologin qbittorrent
fi

report_progress 55 "Configuring qBittorrent WebUI on port 8180..."
mkdir -p /var/lib/qbittorrent/.config/qBittorrent /var/lib/qbittorrent/Downloads

cat <<'EOF' > /var/lib/qbittorrent/.config/qBittorrent/qBittorrent.conf
[LegalNotice]
Accepted=true

[Preferences]
WebUI\Port=8180
WebUI\Address=*
WebUI\ServerDomains=*
WebUI\CSRFProtection=false
WebUI\HostHeaderValidation=false
WebUI\Username=admin
WebUI\Password_PBKDF2="@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)"
Downloads\SavePath=/var/lib/qbittorrent/Downloads/
EOF

chown -R qbittorrent:qbittorrent /var/lib/qbittorrent

report_progress 85 "Configuring and starting qbittorrent.service on port 8180..."
cat <<'EOF' > /etc/systemd/system/qbittorrent.service
[Unit]
Description=qBittorrent-nox Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qbittorrent
Group=qbittorrent
UMask=007
Environment=HOME=/var/lib/qbittorrent
ExecStart=/usr/bin/qbittorrent-nox --webui-port=8180 --profile=/var/lib/qbittorrent/.config
Restart=on-failure
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now qbittorrent >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "qBittorrent installed on port 8180."
log_info "${PACKAGE_NAME} installed successfully"
