#!/bin/bash
# AetherFlow Package Installer: Emby Server
# Port: 8097

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="emby"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8097}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
PACKAGE_NAME="${PACKAGE_NAME:-emby}"
begin_state_transaction "emby-server" "$APP_PORT" "/" "/var/lib/emby" "/var/lib/emby-server" "/etc/emby-server" "/etc/emby" "/opt/emby-server" "/etc/systemd/system/emby-server.service" "/usr/lib/emby-server" "/usr/share/emby-server" "/usr/bin/emby-server"

prepare_apt_package_transaction /opt/emby-server/.af-version emby-server
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites for Emby Server..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl ca-certificates >> "$LOGFILE" 2>&1

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) EMBY_ARCH="amd64" ;;
    arm64) EMBY_ARCH="arm64" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 30 "Resolving latest Emby release for ${EMBY_ARCH}..."
EMBY_VERSION="$(github_latest_tag "MediaBrowser/Emby.Releases" "4.8.10.0")"
EMBY_URL="https://github.com/MediaBrowser/Emby.Releases/releases/download/${EMBY_VERSION}/emby-server-deb_${EMBY_VERSION}_${EMBY_ARCH}.deb"

report_progress 50 "Downloading Emby Server ${EMBY_VERSION}..."
TMP_DEB=$(mktemp /tmp/emby-XXXXXX.deb)
download_file "$EMBY_URL" "$TMP_DEB" >> "$LOGFILE" 2>&1

report_progress 75 "Installing Emby Server package..."
install_deb_verified "$TMP_DEB" emby-server
rm -f "$TMP_DEB"

mkdir -p /opt/emby-server /var/lib/emby/config
queue_app_version /opt/emby-server/.af-version "$(dpkg-query -W -f='${Version}' emby-server)"

if [[ -f /var/lib/emby/config/system.xml ]]; then
    sed -i 's|<HttpServerPortNumber>.*</HttpServerPortNumber>|<HttpServerPortNumber>'"${APP_PORT}"'</HttpServerPortNumber>|g' /var/lib/emby/config/system.xml
    sed -i 's|<PublicPort>.*</PublicPort>|<PublicPort>'"${APP_PORT}"'</PublicPort>|g' /var/lib/emby/config/system.xml
else
    sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /var/lib/emby/config/system.xml
<?xml version="1.0"?>
<ServerConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <HttpServerPortNumber>@AF_APP_PORT@</HttpServerPortNumber>
  <PublicPort>@AF_APP_PORT@</PublicPort>
</ServerConfiguration>
EOF
fi
chown -hRP emby:emby /var/lib/emby 2>/dev/null || true

report_progress 90 "Starting and enabling emby-server service on port ${APP_PORT}..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now emby-server >> "$LOGFILE" 2>&1
systemctl restart emby-server >> "$LOGFILE" 2>&1
systemctl is-active --quiet emby-server
verify_systemd_service_active emby-server
seed_jellyfin_master_user ${APP_PORT}

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Emby Server installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
