#!/bin/bash
#
# [AetherFlow :: Install Emby]
# Open Media Library Server
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [emby] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl wget >>"$LOGFILE" 2>&1

# ── Download Emby Server ─────────────────────────────────────────────────────
log "Downloading latest Emby Server release..."
ARCH=$(dpkg --print-architecture)

EMBY_URL=$(curl -sL https://api.github.com/repos/MediaBrowser/Emby.Releases/releases/latest | grep -oP '"browser_download_url": "\K(https://[^"]+emby-server-deb_[^"]+'${ARCH}'\.deb)(?=")' | head -1)

if [[ -z "$EMBY_URL" ]]; then
    log "Could not parse API download URL, attempting fallback to known latest..."
    EMBY_VERSION=$(curl -sL https://api.github.com/repos/MediaBrowser/Emby.Releases/releases/latest | grep -oP '"tag_name": "\K[^"]+')
    EMBY_URL="https://github.com/MediaBrowser/Emby.Releases/releases/download/${EMBY_VERSION}/emby-server-deb_${EMBY_VERSION}_amd64.deb"
fi

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "$EMBY_URL" -o emby-server.deb >>"$LOGFILE" 2>&1

# ── Install Package ──────────────────────────────────────────────────────────
log "Installing Emby dpkg..."
dpkg -i emby-server.deb >>"$LOGFILE" 2>&1 || apt-get install -y -f >>"$LOGFILE" 2>&1
rm -f emby-server.deb

# ── Create emby system configuration ─────────────────────────────────────────
if ! id -u emby &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /var/lib/emby emby || true
fi

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/emby.conf <<'EOF'
<Location /emby>
    ProxyPass http://localhost:8096/emby
    ProxyPassReverse http://localhost:8096/emby
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/emby.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
systemctl enable emby-server >>"$LOGFILE" 2>&1
systemctl restart emby-server >>"$LOGFILE" 2>&1

touch /install/.emby.lock
log "Emby installation complete! Access at http://your-server:8096"
