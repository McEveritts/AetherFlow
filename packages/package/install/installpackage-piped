        if [[ -n "$expected_ref" ]]; then
            local target_sha=""
            target_sha="$(run_as_piped_clean_env "${DATA_DIR:-$INSTALL_DIR}" git -C "$comp_dir" rev-parse --short=12 "${expected_ref}^{commit}" 2>/dev/null || run_as_piped_clean_env "${DATA_DIR:-$INSTALL_DIR}" git -C "$comp_dir" rev-parse --short=12 "$expected_ref" 2>/dev/null || runuser -u "$APP_NAME" -- git -C "$comp_dir" rev-parse --short=12 "${expected_ref}^{commit}" 2>/dev/null || runuser -u "$APP_NAME" -- git -C "$comp_dir" rev-parse --short=12 "$expected_ref" 2>/dev/null || git -C "$comp_dir" rev-parse --short=12 "${expected_ref}^{commit}" 2>/dev/null || git -C "$comp_dir" rev-parse --short=12 "$expected_ref" 2>/dev/null || true)"
            if [[ -n "$target_sha" ]]; then
                if [[ "$current_sha" != "$target_sha" ]]; then
                    if declare -F print_error >/dev/null 2>&1; then
                        print_error "Piped certification failed: $comp HEAD ($current_sha) does not match target ref $expected_ref ($target_sha)"
                    else
                        printf "Piped certification failed: %s HEAD (%s) does not match target ref %s (%s)\n" "$comp" "$current_sha" "$expected_ref" "$target_sha" >&2
                    fi
                    return 1
                fi
            else
                local head_full=""
                head_full="$(run_as_piped_clean_env "${DATA_DIR:-$INSTALL_DIR}" git -C "$comp_dir" rev-parse HEAD 2>/dev/null || runuser -u "$APP_NAME" -- git -C "$comp_dir" rev-parse HEAD 2>/dev/null || git -C "$comp_dir" rev-parse HEAD 2>/dev/null || true)"
                if [[ ! "$expected_ref" =~ ^[0-9a-fA-F]{7,40}$ || ! "$head_full" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
                    if declare -F print_error >/dev/null 2>&1; then
                        print_error "Piped certification failed: $comp expected ref '$expected_ref' is not a valid 7-40 hex SHA"
                    else
                        printf "Piped certification failed: %s expected ref '%s' is not a valid 7-40 hex SHA\n" "$comp" "$expected_ref" >&2
                    fi
                    return 1
                fi
                local exp_lower="${expected_ref,,}"
                local head_lower="${head_full,,}"
                if [[ "$head_lower" != "$exp_lower"* && "$exp_lower" != "$head_lower"* ]]; then
                    if declare -F print_error >/dev/null 2>&1; then
                        print_error "Piped certification failed: $comp HEAD ($current_sha) does not match target ref $expected_ref"
                    else
                        printf "Piped certification failed: %s HEAD (%s) does not match target ref %s\n" "$comp" "$current_sha" "$expected_ref" >&2
                    fi
                    return 1
                fi
            fi
        fi
    done

    if ! youtube_ready "http://127.0.0.1:${APP_PORT}/"; then
        if declare -F print_error >/dev/null 2>&1; then
            print_error "Piped certification failed: frontend readiness check failed"
        else
            printf "Piped certification failed: frontend readiness check failed\n" >&2
        fi
        return 1
    fi
    if ! youtube_ready "http://127.0.0.1:${APP_PORT}/api/healthcheck"; then
        if declare -F print_error >/dev/null 2>&1; then
            print_error "Piped certification failed: API healthcheck failed"
        else
            printf "Piped certification failed: API healthcheck failed\n" >&2
        fi
        return 1
    fi
    systemctl is-active --quiet piped-backend.service || systemctl is-active --quiet af-piped-api.service || {
        echo "ERROR: piped-backend.service is not active during certification." >&2
        return 1
    }
    systemctl is-active --quiet piped-proxy.service || systemctl is-active --quiet af-piped-proxy.service || {
        echo "ERROR: piped-proxy.service is not active during certification." >&2
        return 1
    }

    local backend_dest="${PIPED_BACKEND_DIR:-${INSTALL_DIR}}/piped.jar"
    local proxy_dest="${PIPED_PROXY_DIR:-${INSTALL_DIR}}/piped-proxy"

    if [[ -z "${DEPLOYED_BACKEND_SHA256:-}" ]]; then
        echo "ERROR: Piped certification failed: missing expected DEPLOYED_BACKEND_SHA256" >&2
        return 1
    fi
    if [[ -z "${DEPLOYED_PROXY_SHA256:-}" ]]; then
        echo "ERROR: Piped certification failed: missing expected DEPLOYED_PROXY_SHA256" >&2
        return 1
    fi

    if [[ ! -f "$backend_dest" || -L "$backend_dest" ]]; then
        echo "ERROR: Piped certification failed: deployed backend JAR at $backend_dest is missing, not a regular file, or is a symlink" >&2
        return 1
    fi
    if [[ ! -f "$proxy_dest" || -L "$proxy_dest" ]]; then
        echo "ERROR: Piped certification failed: deployed proxy binary at $proxy_dest is missing, not a regular file, or is a symlink" >&2
        return 1
    fi

    local current_backend_sha current_proxy_sha
    current_backend_sha="$(sha256_regular_file_nofollow "$backend_dest" 2>/dev/null || true)"
    if [[ -z "$current_backend_sha" || "$current_backend_sha" != "$DEPLOYED_BACKEND_SHA256" ]]; then
        echo "ERROR: Piped certification failed: deployed backend JAR SHA-256 ($current_backend_sha) does not match expected deployed artifact ($DEPLOYED_BACKEND_SHA256)" >&2
        return 1
    fi

    current_proxy_sha="$(sha256_regular_file_nofollow "$proxy_dest" 2>/dev/null || true)"
    if [[ -z "$current_proxy_sha" || "$current_proxy_sha" != "$DEPLOYED_PROXY_SHA256" ]]; then
        echo "ERROR: Piped certification failed: deployed proxy binary SHA-256 ($current_proxy_sha) does not match expected deployed artifact ($DEPLOYED_PROXY_SHA256)" >&2
        return 1
    fi

    local proxy_pid="" running_proxy_exe="" running_proxy_sha=""
    proxy_pid="$(systemctl show -p ExecMainPID --value piped-proxy.service 2>/dev/null | head -n1 | tr -d '[:space:]' || true)"
    if [[ -z "$proxy_pid" || "$proxy_pid" == "0" ]]; then
        proxy_pid="$(systemctl show -p ExecMainPID --value af-piped-proxy.service 2>/dev/null | head -n1 | tr -d '[:space:]' || true)"
    fi

    local proc_root="${AF_PROC_ROOT:-/proc}"
    if [[ -z "$proxy_pid" || ! "$proxy_pid" =~ ^[0-9]+$ || "$proxy_pid" -le 0 || ! -d "$proc_root/$proxy_pid" ]]; then
        echo "ERROR: Piped certification failed: unable to resolve valid running ExecMainPID (${proxy_pid:-none}) for piped-proxy service" >&2
        return 1
    fi

    local raw_proxy_exe=""
    raw_proxy_exe="$(readlink "$proc_root/$proxy_pid/exe" 2>/dev/null || true)"
    running_proxy_exe="$(readlink -f "$proc_root/$proxy_pid/exe" 2>/dev/null || true)"
    if [[ ! -L "$proc_root/$proxy_pid/exe" || -z "$running_proxy_exe" || "$raw_proxy_exe" == *" (deleted)" || "$running_proxy_exe" == *" (deleted)" || ! -f "$running_proxy_exe" ]]; then
        echo "ERROR: Piped certification failed: running piped-proxy process ($proxy_pid) executable (${raw_proxy_exe:-unresolved}) is missing, deleted, or not a regular file" >&2
        return 1
    fi

    local canonical_proxy_dest=""
    canonical_proxy_dest="$(readlink -f "$proxy_dest" 2>/dev/null || echo "$proxy_dest")"
    if [[ "$running_proxy_exe" != "$canonical_proxy_dest" ]]; then
        echo "ERROR: Piped certification failed: running piped-proxy process ($proxy_pid) executable ($running_proxy_exe) does not match deployed path ($canonical_proxy_dest)" >&2
        return 1
    fi

    running_proxy_sha="$(sha256_proc_exe_matching_file "$proc_root/$proxy_pid/exe" "$proxy_dest" 2>/dev/null)" || {
        echo "ERROR: Piped certification failed: running piped-proxy process ($proxy_pid) executable failed inode identity verification against $proxy_dest" >&2
        return 1
    }
    if [[ -z "$running_proxy_sha" || "$running_proxy_sha" != "$DEPLOYED_PROXY_SHA256" ]]; then
        echo "ERROR: Piped certification failed: running piped-proxy process ($proxy_pid) binary SHA-256 (${running_proxy_sha:-empty}) does not match newly published binary ($DEPLOYED_PROXY_SHA256)" >&2
        return 1
    fi

    return 0
}

af_set_stage "certification" 90
if ! certify_piped; then
    if declare -F print_error >/dev/null 2>&1; then
        print_error "Piped certification failed before commit; invoking rollback"
    else
        printf "Piped certification failed before commit; invoking rollback\n" >&2
    fi
    rollback_piped_runtime 1
    exit 1
fi
PIPED_CERTIFIED=1

af_set_stage "record_version" 95
FRONTEND_SHA="$(run_as_piped_clean_env "$DATA_DIR" git -C "${INSTALL_DIR}/frontend" rev-parse HEAD 2>/dev/null || runuser -u "$APP_NAME" -- git -C "${INSTALL_DIR}/frontend" rev-parse HEAD 2>/dev/null || echo "${PIPED_FRONTEND_REF:-unknown}")"
BACKEND_SHA="$(run_as_piped_clean_env "$DATA_DIR" git -C "${INSTALL_DIR}/backend" rev-parse HEAD 2>/dev/null || runuser -u "$APP_NAME" -- git -C "${INSTALL_DIR}/backend" rev-parse HEAD 2>/dev/null || echo "${PIPED_BACKEND_REF:-unknown}")"
PROXY_SHA="$(run_as_piped_clean_env "$DATA_DIR" git -C "${INSTALL_DIR}/proxy" rev-parse HEAD 2>/dev/null || runuser -u "$APP_NAME" -- git -C "${INSTALL_DIR}/proxy" rev-parse HEAD 2>/dev/null || echo "${PIPED_PROXY_REF:-unknown}")"

printf '{"frontend":"%s","backend":"%s","proxy":"%s"}\n' "${FRONTEND_SHA}" "${BACKEND_SHA}" "${PROXY_SHA}" | \
    write_piped_receipt_safely "${INSTALL_DIR}" ".af-components.json" "root" "root" "0644"

PIPED_VERSION="frontend:${FRONTEND_SHA},backend:${BACKEND_SHA},proxy:${PROXY_SHA}"
printf '%s\n' "$PIPED_VERSION" | write_piped_receipt_safely "${INSTALL_DIR}" ".af-version" "root" "root" "0644"
queue_app_version "${INSTALL_DIR}/.af-version" "$PIPED_VERSION"
commit_app_versions
write_lock piped
RUNTIME_CHANGED=false
PIPED_INSTALL_COMPLETED=1
report_progress 100 "Experimental Piped installed. YouTube playback may require additional upstream anti-bot configuration."
