write_piped_receipt_safely() {
    local dir_path="$1"
    local filename="$2"
    local owner_user="${3:-root}"
    local owner_group="${4:-root}"
    local mode_octal="${5:-644}"

    python3 -c '
import os, sys, stat, pwd, grp, secrets

dir_path = sys.argv[1]
filename = sys.argv[2]
owner_user = sys.argv[3] if len(sys.argv) > 3 else "root"
owner_group = sys.argv[4] if len(sys.argv) > 4 else "root"
mode_str = sys.argv[5] if len(sys.argv) > 5 else "644"

if "/" in filename or filename in (".", ".."):
    sys.exit(1)

if not dir_path or not dir_path.startswith("/"):
    sys.exit(1)

parts = [p for p in dir_path.split("/") if p]
if any(p in (".", "..") for p in parts):
    sys.exit(1)

dir_fd = None
tmp_fd = -1
tmp_name = None
try:
    try:
        dir_fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0))
    except OSError:
        sys.exit(1)

    for part in parts:
        try:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), dir_fd=dir_fd)
        except OSError:
            sys.exit(1)
        prev_fd = dir_fd
        dir_fd = next_fd
        os.close(prev_fd)
        try:
            st = os.fstat(dir_fd)
            if not stat.S_ISDIR(st.st_mode):
                sys.exit(1)
        except OSError:
            sys.exit(1)

    try:
        st = os.stat(filename, dir_fd=dir_fd, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
            sys.exit(1)
    except FileNotFoundError:
        pass
    except OSError:
        sys.exit(1)

    mode_int = int(mode_str, 8)
    tmp_name = f".tmp_{filename}_{secrets.token_hex(8)}"
    try:
        tmp_fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode_int, dir_fd=dir_fd)
    except OSError:
        sys.exit(1)

    try:
        content_bytes = sys.stdin.buffer.read()
        view = memoryview(content_bytes)
        total_written = 0
        while total_written < len(view):
            n = os.write(tmp_fd, view[total_written:])
            if n <= 0:
                raise OSError("short write to temporary receipt file")
            total_written += n

        os.fchmod(tmp_fd, mode_int)

        if os.geteuid() == 0:
            uid = pwd.getpwnam(owner_user).pw_uid if owner_user else 0
            gid = grp.getgrnam(owner_group).gr_gid if owner_group else 0
            os.fchown(tmp_fd, uid, gid)
        else:
            uid = os.geteuid()
            gid = os.getegid()
            if owner_user:
                try:
                    pw = pwd.getpwnam(owner_user)
                    if pw.pw_uid == os.geteuid():
                        uid = pw.pw_uid
                except (KeyError, TypeError):
                    pass
            if owner_group:
                try:
                    gr = grp.getgrnam(owner_group)
                    if gr.gr_gid == os.getegid():
                        gid = gr.gr_gid
                except (KeyError, TypeError):
                    pass
            os.fchown(tmp_fd, uid, gid)

        os.fsync(tmp_fd)
        os.close(tmp_fd)
        tmp_fd = -1

        os.replace(tmp_name, filename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except Exception:
        if tmp_fd >= 0:
            try:
                os.close(tmp_fd)
            except Exception:
                pass
            tmp_fd = -1
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except OSError:
            pass
        sys.exit(1)
finally:
    if tmp_fd >= 0:
        try:
            os.close(tmp_fd)
        except Exception:
            pass
    if dir_fd is not None:
        try:
            os.close(dir_fd)
        except Exception:
            pass
' "$dir_path" "$filename" "$owner_user" "$owner_group" "$mode_octal"
}

publish_piped_artifact_safely() {
    local src_path="${1:?missing src_path}"
    local dst_path="${2:?missing dst_path}"
    local mode_octal="${3:-644}"
    local owner_user="${4:-root}"
    local expected_src_user="${5:-${APP_NAME:-piped}}"

    python3 -c '
import os, sys, stat, pwd, grp, secrets, hashlib

src_path = sys.argv[1]
dst_path = sys.argv[2]
mode_str = sys.argv[3] if len(sys.argv) > 3 else "644"
owner_user = sys.argv[4] if len(sys.argv) > 4 else "root"
expected_src_user = sys.argv[5] if len(sys.argv) > 5 else "piped"

if not src_path or not src_path.startswith("/") or not dst_path or not dst_path.startswith("/"):
    sys.exit(1)

src_dir, src_name = os.path.split(src_path)
dst_dir, dst_name = os.path.split(dst_path)

if not src_name or not dst_name or "/" in src_name or "/" in dst_name:
    sys.exit(1)
if src_name in (".", "..") or dst_name in (".", ".."):
    sys.exit(1)

def open_dir_safely(dir_path):
    parts = [p for p in dir_path.split("/") if p]
    if any(p in (".", "..") for p in parts):
        sys.exit(1)
    try:
        fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0))
    except OSError:
        sys.exit(1)
    for part in parts:
        try:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), dir_fd=fd)
        except OSError:
            try:
                os.close(fd)
            except Exception:
                pass
            sys.exit(1)
        os.close(fd)
        fd = next_fd
        try:
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode):
                os.close(fd)
                sys.exit(1)
        except OSError:
            try:
                os.close(fd)
            except Exception:
                pass
            sys.exit(1)
    return fd

src_dir_fd = None
dst_dir_fd = None
src_fd = -1
tmp_fd = -1
tmp_name = None

try:
    src_dir_fd = open_dir_safely(src_dir)
    dst_dir_fd = open_dir_safely(dst_dir)

    expected_uid = None
    try:
        if expected_src_user:
            expected_uid = pwd.getpwnam(expected_src_user).pw_uid
    except (KeyError, TypeError):
        pass

    def verify_stat_and_uid(s):
        if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1:
            return False
        if os.geteuid() == 0:
            if expected_uid is not None:
                return s.st_uid == expected_uid
            return s.st_uid == 0
        else:
            if expected_uid is not None and s.st_uid == expected_uid:
                return True
            return s.st_uid == os.geteuid()

    try:
        pre_st = os.stat(src_name, dir_fd=src_dir_fd, follow_symlinks=False)
    except OSError:
        sys.exit(1)

    if not verify_stat_and_uid(pre_st):
        sys.exit(1)

    try:
        src_fd = os.open(
            src_name,
            os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0),
            dir_fd=src_dir_fd,
        )
    except OSError:
        sys.exit(1)

    st = os.fstat(src_fd)
    if not verify_stat_and_uid(st):
        sys.exit(1)

    if (st.st_dev, st.st_ino) != (pre_st.st_dev, pre_st.st_ino):
        sys.exit(1)

    try:
        dst_st = os.stat(dst_name, dir_fd=dst_dir_fd, follow_symlinks=False)
        if not stat.S_ISREG(dst_st.st_mode):
            sys.exit(1)
    except FileNotFoundError:
        pass
    except OSError:
        sys.exit(1)

    mode_int = int(mode_str, 8)
    tmp_name = f".tmp_{dst_name}_{secrets.token_hex(8)}"
    try:
        tmp_fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode_int, dir_fd=dst_dir_fd)
    except OSError:
        sys.exit(1)

    src_hasher = hashlib.sha256()
    while True:
        chunk = os.read(src_fd, 65536)
        if not chunk:
            break
        src_hasher.update(chunk)
        view = memoryview(chunk)
        total_written = 0
        while total_written < len(view):
            n = os.write(tmp_fd, view[total_written:])
            if n <= 0:
                raise OSError("short write to temporary artifact file")
            total_written += n

    src_digest = src_hasher.hexdigest()

    os.fchmod(tmp_fd, mode_int)

    if os.geteuid() == 0:
        uid = pwd.getpwnam(owner_user).pw_uid if owner_user else 0
        gid = grp.getgrnam(owner_user).gr_gid if owner_user else 0
        os.fchown(tmp_fd, uid, gid)
    else:
        uid = os.geteuid()
        gid = os.getegid()
        if owner_user:
            try:
                pw = pwd.getpwnam(owner_user)
                if pw.pw_uid == os.geteuid():
                    uid = pw.pw_uid
                    gid = pw.pw_gid
            except (KeyError, TypeError):
                pass
        os.fchown(tmp_fd, uid, gid)

    os.fsync(tmp_fd)
    os.close(tmp_fd)
    tmp_fd = -1

    os.replace(tmp_name, dst_name, src_dir_fd=dst_dir_fd, dst_dir_fd=dst_dir_fd)
    tmp_name = None

    dst_check_fd = -1
    try:
        dst_check_fd = os.open(dst_name, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), dir_fd=dst_dir_fd)
        dst_check_st = os.fstat(dst_check_fd)
        if not stat.S_ISREG(dst_check_st.st_mode) or dst_check_st.st_nlink != 1:
            sys.exit(1)
        dst_hasher = hashlib.sha256()
        while True:
            c = os.read(dst_check_fd, 65536)
            if not c:
                break
            dst_hasher.update(c)
        if dst_hasher.hexdigest() != src_digest:
            sys.exit(1)
    finally:
        if dst_check_fd >= 0:
            try:
                os.close(dst_check_fd)
            except Exception:
                pass

    print(src_digest)
except Exception:
    if tmp_fd >= 0:
        try:
            os.close(tmp_fd)
        except Exception:
            pass
        tmp_fd = -1
    if tmp_name is not None and dst_dir_fd is not None:
        try:
            os.unlink(tmp_name, dir_fd=dst_dir_fd)
        except OSError:
            pass
    sys.exit(1)
finally:
    if tmp_fd >= 0:
        try:
            os.close(tmp_fd)
        except Exception:
            pass
    if tmp_name is not None and dst_dir_fd is not None:
        try:
            os.unlink(tmp_name, dir_fd=dst_dir_fd)
        except OSError:
            pass
    if src_fd >= 0:
        try:
            os.close(src_fd)
        except Exception:
            pass
    if src_dir_fd is not None:
        try:
            os.close(src_dir_fd)
        except Exception:
            pass
    if dst_dir_fd is not None:
        try:
            os.close(dst_dir_fd)
        except Exception:
            pass
' "$src_path" "$dst_path" "$mode_octal" "$owner_user" "$expected_src_user"
}

sha256_regular_file_nofollow() {
    local target_path="${1:?missing target_path}"
    local expected_owner="${2:-}"

    python3 -c '
import os, sys, stat, pwd, hashlib

target_path = sys.argv[1]
expected_owner = sys.argv[2] if len(sys.argv) > 2 else ""

if not target_path or not target_path.startswith("/"):
    sys.exit(1)

parts = [p for p in target_path.split("/") if p]
if not parts or any(p in (".", "..") for p in parts):
    sys.exit(1)

filename = parts[-1]
dir_parts = parts[:-1]

cloexec = getattr(os, "O_CLOEXEC", 0)
nonblock = getattr(os, "O_NONBLOCK", 0)

expected_uid = None
if expected_owner:
    try:
        expected_uid = pwd.getpwnam(expected_owner).pw_uid
    except (KeyError, TypeError):
        pass

dir_fd = None
file_fd = -1
try:
    try:
        dir_fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | cloexec)
    except OSError:
        sys.exit(1)

    for part in dir_parts:
        try:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | cloexec, dir_fd=dir_fd)
        except OSError:
            sys.exit(1)
        prev_fd = dir_fd
        dir_fd = next_fd
        try:
            os.close(prev_fd)
        except Exception:
            pass
        st = os.fstat(dir_fd)
        if not stat.S_ISDIR(st.st_mode):
            sys.exit(1)

    try:
        pre_st = os.stat(filename, dir_fd=dir_fd, follow_symlinks=False)
    except OSError:
        sys.exit(1)

    if not stat.S_ISREG(pre_st.st_mode) or pre_st.st_nlink != 1:
        sys.exit(1)

    if expected_uid is not None:
        if os.geteuid() == 0 and pre_st.st_uid != expected_uid:
            sys.exit(1)
        elif os.geteuid() != 0 and pre_st.st_uid != expected_uid and pre_st.st_uid != os.geteuid():
            sys.exit(1)

    try:
        file_fd = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW | nonblock | cloexec, dir_fd=dir_fd)
    except OSError:
        sys.exit(1)

    st = os.fstat(file_fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        sys.exit(1)

    if (st.st_dev, st.st_ino) != (pre_st.st_dev, pre_st.st_ino):
        sys.exit(1)

    if expected_uid is not None:
        if os.geteuid() == 0 and st.st_uid != expected_uid:
            sys.exit(1)
        elif os.geteuid() != 0 and st.st_uid != expected_uid and st.st_uid != os.geteuid():
            sys.exit(1)

    hasher = hashlib.sha256()
    while True:
        chunk = os.read(file_fd, 65536)
        if not chunk:
            break
        hasher.update(chunk)

    print(hasher.hexdigest())
finally:
    if file_fd >= 0:
        try:
            os.close(file_fd)
        except Exception:
            pass
    if dir_fd is not None:
        try:
            os.close(dir_fd)
        except Exception:
            pass
' "$target_path" "$expected_owner"
}

sha256_proc_exe_matching_file() {
    local proc_exe_path="${1:?missing proc_exe_path}"
    local dest_path="${2:?missing dest_path}"

    python3 - "$proc_exe_path" "$dest_path" << 'PYEOF'
import sys, os, stat, hashlib

proc_exe_path = sys.argv[1]
dest_path = sys.argv[2]

cloexec = getattr(os, "O_CLOEXEC", 0)
dest_fd = -1
proc_fd = -1

try:
    try:
        dest_fd = os.open(dest_path, os.O_RDONLY | os.O_NOFOLLOW | cloexec)
    except OSError:
        sys.exit(1)

    dest_st = os.fstat(dest_fd)
    if not stat.S_ISREG(dest_st.st_mode) or dest_st.st_nlink < 1:
        sys.exit(1)

    try:
        proc_fd = os.open(proc_exe_path, os.O_RDONLY | cloexec)
    except OSError:
        sys.exit(1)

    proc_st = os.fstat(proc_fd)
    if not stat.S_ISREG(proc_st.st_mode) or proc_st.st_nlink < 1:
        sys.exit(1)

    if (proc_st.st_dev, proc_st.st_ino) != (dest_st.st_dev, dest_st.st_ino):
        sys.exit(1)

    proc_hasher = hashlib.sha256()
    while True:
        chunk = os.read(proc_fd, 65536)
        if not chunk:
            break
        proc_hasher.update(chunk)
    proc_digest = proc_hasher.hexdigest()

    dest_hasher = hashlib.sha256()
    while True:
        chunk = os.read(dest_fd, 65536)
        if not chunk:
            break
        dest_hasher.update(chunk)
    dest_digest = dest_hasher.hexdigest()

    if proc_digest != dest_digest:
        sys.exit(1)

    sys.stdout.write(proc_digest + "\n")
    sys.exit(0)
finally:
    if dest_fd >= 0:
        try:
            os.close(dest_fd)
        except Exception:
            pass
    if proc_fd >= 0:
        try:
            os.close(proc_fd)
        except Exception:
            pass
PYEOF
}

