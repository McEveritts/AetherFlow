TARGET_FRONTEND_REF=""
TARGET_BACKEND_REF=""
TARGET_PROXY_REF=""
PIPED_FRONTEND_REF=""
PIPED_BACKEND_REF=""
PIPED_PROXY_REF=""

piped_target_raw="${PIPED_TARGET_VERSION:-${AF_TARGET_VERSION:-}}"
raw_target="$piped_target_raw"
if [[ -n "$raw_target" ]]; then
    if [[ "$raw_target" == *","* || "$raw_target" == *"="* || "$raw_target" == *"frontend"* || "$raw_target" == *"backend"* || "$raw_target" == *"proxy"* ]]; then
        if [[ "$raw_target" == ,* || "$raw_target" == *, || "$raw_target" == *,,* ]]; then
            if declare -F print_error >/dev/null 2>&1; then
                print_error "Invalid Piped manifest: leading, trailing, or empty consecutive commas in '$raw_target'"
            else
                printf "Invalid Piped manifest: leading, trailing, or empty consecutive commas in '%s'\n" "$raw_target" >&2
            fi
            exit 1
        fi
        seen_frontend=0
        seen_backend=0
        seen_proxy=0
        IFS=',' read -ra PARTS <<< "$raw_target"
        for part in "${PARTS[@]}"; do
            part="$(echo "$part" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            if [[ -z "$part" ]]; then
                if declare -F print_error >/dev/null 2>&1; then
                    print_error "Empty component in Piped manifest: '$raw_target'"
                else
                    printf "Empty component in Piped manifest: '%s'\n" "$raw_target" >&2
                fi
                exit 1
            fi
            case "$part" in
                frontend=*)
                    if [[ "$seen_frontend" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: frontend"
                        else
                            printf "Duplicate component in Piped target manifest: frontend\n" >&2
                        fi
                        exit 1
                    fi
                    seen_frontend=1
                    PIPED_FRONTEND_REF="${part#frontend=}"
                    ;;
                frontend:*)
                    if [[ "$seen_frontend" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: frontend"
                        else
                            printf "Duplicate component in Piped target manifest: frontend\n" >&2
                        fi
                        exit 1
                    fi
                    seen_frontend=1
                    PIPED_FRONTEND_REF="${part#frontend:}"
                    ;;
                backend=*)
                    if [[ "$seen_backend" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: backend"
                        else
                            printf "Duplicate component in Piped target manifest: backend\n" >&2
                        fi
                        exit 1
                    fi
                    seen_backend=1
                    PIPED_BACKEND_REF="${part#backend=}"
                    ;;
                backend:*)
                    if [[ "$seen_backend" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: backend"
                        else
                            printf "Duplicate component in Piped target manifest: backend\n" >&2
                        fi
                        exit 1
                    fi
                    seen_backend=1
                    PIPED_BACKEND_REF="${part#backend:}"
                    ;;
                proxy=*)
                    if [[ "$seen_proxy" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: proxy"
                        else
                            printf "Duplicate component in Piped target manifest: proxy\n" >&2
                        fi
                        exit 1
                    fi
                    seen_proxy=1
                    PIPED_PROXY_REF="${part#proxy=}"
                    ;;
                proxy:*)
                    if [[ "$seen_proxy" -eq 1 ]]; then
                        if declare -F print_error >/dev/null 2>&1; then
                            print_error "Duplicate component in Piped target manifest: proxy"
                        else
                            printf "Duplicate component in Piped target manifest: proxy\n" >&2
                        fi
                        exit 1
                    fi
                    seen_proxy=1
                    PIPED_PROXY_REF="${part#proxy:}"
                    ;;
                *)
                    if declare -F print_error >/dev/null 2>&1; then
                        print_error "Invalid component in Piped manifest: '$part'"
                    else
                        printf "Invalid component in Piped manifest: '%s'\n" "$part" >&2
                    fi
                    exit 1
                    ;;
            esac
        done
