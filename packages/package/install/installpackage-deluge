#!/bin/bash
# AetherFlow Package Installer: Deluge (deluged + deluge-web)
# Port: 8112

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="deluge"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8112}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
PACKAGE_NAME="${PACKAGE_NAME:-deluge}"
begin_state_transaction "deluged deluge-web" "$APP_PORT" "/" "/var/lib/deluge" "/etc/deluge" "/etc/systemd/system/deluged.service" "/etc/systemd/system/deluge-web.service" "/usr/bin/deluged" "/usr/bin/deluge-web" "/usr/bin/deluge-console" "/usr/lib/python3/dist-packages/deluge" "/usr/share/deluge"

prepare_apt_package_transaction /var/lib/deluge/.af-version deluged deluge-web deluge-console
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing deluged, deluge-web, and deluge-console..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq deluged deluge-web deluge-console python3-libtorrent >> "$LOGFILE" 2>&1

if ! id -u deluge >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/deluge --shell /usr/sbin/nologin deluge
fi

report_progress 55 "Configuring Deluge daemon and WebUI on port ${APP_PORT}..."
systemctl stop deluge-web deluged >> "$LOGFILE" 2>&1 || true
validate_config_paths /var/lib/deluge/.config/deluge/auth /var/lib/deluge/.config/deluge/web.conf /var/log/deluge/.af-directory-check
mkdir -p /var/lib/deluge/Downloads
DELUGE_VER="$(deluged --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' || dpkg-query -W -f='${Version}' deluged 2>/dev/null || echo "2.1.1")"
queue_app_version /var/lib/deluge/.af-version "$DELUGE_VER"
AF_SEED_USER="${MASTER_USER}" AF_SEED_PASS="${AF_CONFIG_PASS:-$MASTER_PASS}" safe_config_python <<'PYEOF'
import os, hashlib, json
user, password = os.environ['AF_SEED_USER'], os.environ['AF_SEED_PASS']
with ManagedConfig('/var/lib/deluge/.config/deluge/auth') as auth, ManagedConfig('/var/lib/deluge/.config/deluge/web.conf') as web:
    auth_text = auth.read_text()
    raw = web.read_text()
    header = {'file': 1, 'format': 1}
    body = {}
    decoder = json.JSONDecoder()
    while raw.strip():
        body, offset = decoder.raw_decode(raw.lstrip())
        raw = raw.lstrip()[offset:]
    rotate = bool(os.environ.get('AF_CONFIG_PASS')) and os.environ.get('AF_KEEP_EXISTING_SECRETS', '1') != '1'
    if rotate or not body.get('pwd_salt') or not body.get('pwd_sha1'):
        salt = hashlib.sha1(os.urandom(32)).hexdigest()
        body['pwd_salt'] = salt
        body['pwd_sha1'] = hashlib.sha1((salt + password).encode('utf-8')).hexdigest()
    body.update(port=int(os.environ['AF_APP_PORT']), first_login=False,
                default_daemon=body.get('default_daemon', '127.0.0.1:58846'))
    if not auth_text or rotate:
        auth_lines = auth_text.splitlines()
        if any(line.startswith(user + ':') for line in auth_lines):
            auth_lines = [f'{user}:{password}:10' if line.startswith(user + ':') else line for line in auth_lines]
        else:
            auth_lines.append(f'{user}:{password}:10')
        auth.write_text('\n'.join(auth_lines) + '\n', 0o600)
    web.write_text(json.dumps(header, indent=4) + json.dumps(body, indent=4))
for path in ('/var/lib/deluge/.af-directory-check', '/var/log/deluge/.af-directory-check'):
    directory, name = config_directory(path)
    try:
        os.fchmod(directory, 0o750)
    finally:
        os.close(directory)
PYEOF
chown -RP deluge:deluge /var/lib/deluge /var/log/deluge

cat <<'EOF' > /etc/systemd/system/deluged.service
[Unit]
Description=Deluge Bittorrent Client Daemon
After=network-online.target

[Service]
Type=simple
User=deluge
Group=deluge
UMask=007
ExecStart=/usr/bin/deluged -d -c /var/lib/deluge/.config/deluge -l /var/log/deluge/daemon.log -L info
Restart=on-failure
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
EOF

sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/systemd/system/deluge-web.service
[Unit]
Description=Deluge Bittorrent Client Web Interface
After=network-online.target deluged.service
Wants=deluged.service

[Service]
Type=simple
User=deluge
Group=deluge
UMask=027
ExecStart=/usr/bin/deluge-web -d -c /var/lib/deluge/.config/deluge -l /var/log/deluge/web.log -L info -p @AF_APP_PORT@
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

report_progress 85 "Starting deluged and deluge-web services..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now deluged >> "$LOGFILE" 2>&1
systemctl enable --now deluge-web >> "$LOGFILE" 2>&1
systemctl is-active --quiet deluged
systemctl is-active --quiet deluge-web

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Deluge installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
