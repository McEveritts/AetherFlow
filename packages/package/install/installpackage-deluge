#!/bin/bash
# AetherFlow Package Installer: Deluge (deluged + deluge-web)
# Port: 8112

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="deluge"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing deluged, deluge-web, and deluge-console..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq deluged deluge-web deluge-console python3-libtorrent >> "$LOGFILE" 2>&1

if ! id -u deluge >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/deluge --shell /usr/sbin/nologin deluge
fi

report_progress 55 "Configuring Deluge daemon and WebUI on port 8112..."
systemctl stop deluge-web deluged >> "$LOGFILE" 2>&1 || true
mkdir -p /var/lib/deluge/.config/deluge /var/log/deluge /var/lib/deluge/Downloads
if ! grep -q "^${MASTER_USER}:" /var/lib/deluge/.config/deluge/auth 2>/dev/null; then
    printf '%s:%s:10\n' "${MASTER_USER}" "${MASTER_PASS}" >> /var/lib/deluge/.config/deluge/auth
fi
python3 - "${MASTER_PASS}" <<'PYEOF'
import sys, os, hashlib, json
pw = sys.argv[1]
salt = hashlib.sha1(os.urandom(32)).hexdigest()
sha1 = hashlib.sha1((salt + pw).encode("utf-8")).hexdigest()
web_conf = "/var/lib/deluge/.config/deluge/web.conf"
header = {"file": 1, "format": 1}
body = {
    "port": 8112,
    "pwd_salt": salt,
    "pwd_sha1": sha1,
    "first_login": False,
    "default_daemon": "127.0.0.1:58846"
}
with open(web_conf, "w", encoding="utf-8") as f:
    f.write(json.dumps(header, indent=4) + json.dumps(body, indent=4))
PYEOF
chown -R deluge:deluge /var/lib/deluge /var/log/deluge
chmod 750 /var/lib/deluge /var/log/deluge

cat <<'EOF' > /etc/systemd/system/deluged.service
[Unit]
Description=Deluge Bittorrent Client Daemon
After=network-online.target

[Service]
Type=simple
User=deluge
Group=deluge
UMask=007
ExecStart=/usr/bin/deluged -d -c /var/lib/deluge/.config/deluge -l /var/log/deluge/daemon.log -L info
Restart=on-failure
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
EOF

cat <<'EOF' > /etc/systemd/system/deluge-web.service
[Unit]
Description=Deluge Bittorrent Client Web Interface
After=network-online.target deluged.service
Wants=deluged.service

[Service]
Type=simple
User=deluge
Group=deluge
UMask=027
ExecStart=/usr/bin/deluge-web -d -c /var/lib/deluge/.config/deluge -l /var/log/deluge/web.log -L info -p 8112
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

report_progress 85 "Starting deluged and deluge-web services..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now deluged >> "$LOGFILE" 2>&1
systemctl enable --now deluge-web >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Deluge installed on port 8112."
log_info "${PACKAGE_NAME} installed successfully"
