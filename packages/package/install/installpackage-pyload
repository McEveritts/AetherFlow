#!/bin/bash
#
# [AetherFlow Install Script - pyLoad]
# Installs pyLoad (pyload-ng) download manager in an isolated Python virtualenv.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="pyload"
APP_USER="pyload"
INSTALL_DIR="/opt/pyload"
DATA_DIR="/var/lib/pyload"
LOCK_FILE="/install/.pyload.lock"
SERVICE_FILE="/etc/systemd/system/pyload.service"
APP_PORT="${AF_APP_PORT:-8000}"

setup_log "${APP_NAME}"
log "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

ensure_master_credentials

report_progress 25 "Installing Python build dependencies, libcurl, and OCR tools..."
apt_update
apt_install curl wget jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip \
    libcurl4-openssl-dev libssl-dev libffi-dev \
    tesseract-ocr p7zip-full unrar-free ffmpeg

ensure_service_user "${APP_USER}" "${DATA_DIR}"
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/settings" "${DATA_DIR}/Downloads"

report_progress 50 "Creating Python virtualenv and installing pyload-ng..."
if [[ ! -d "${INSTALL_DIR}/.venv" ]]; then
    python3 -m venv "${INSTALL_DIR}/.venv" >> "${LOG_FILE}" 2>&1
fi
"${INSTALL_DIR}/.venv/bin/pip" install --upgrade pip setuptools wheel >> "${LOG_FILE}" 2>&1
"${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir "pyload-ng[plugins]" >> "${LOG_FILE}" 2>&1 || \
    "${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir pyload-ng >> "${LOG_FILE}" 2>&1

PYLOAD_VER="$("${INSTALL_DIR}/.venv/bin/python" -c "import importlib.metadata; print(importlib.metadata.version('pyload-ng'))" 2>/dev/null || echo '0.5.0')"
echo "${PYLOAD_VER}" > "${INSTALL_DIR}/.af-version"

report_progress 75 "Configuring ${APP_NAME} Web UI settings on port ${APP_PORT}..."
if [[ ! -f "${DATA_DIR}/settings/pyload.cfg" ]]; then
    cat > "${DATA_DIR}/settings/pyload.cfg" <<EOF
version: 2

download - "Download":
	folder storage_folder : "Download folder" = ${DATA_DIR}/Downloads

webui - "Web Interface":
	bool autologin : "Skip login if single user" = False
	bool develop : "Development mode" = False
	bool enabled : "Activated" = True
	ip host : "IP address" = 0.0.0.0
	int port : "Port" = ${APP_PORT}
	str prefix : "Path prefix" =
	str theme : "Theme" = modern
	bool use_ssl : "Use HTTPS" = False
EOF
else
    sed -i "s|int port : \"Port\" = .*|int port : \"Port\" = ${APP_PORT}|" "${DATA_DIR}/settings/pyload.cfg" || true
    sed -i "s|ip host : \"IP address\" = .*|ip host : \"IP address\" = 0.0.0.0|" "${DATA_DIR}/settings/pyload.cfg" || true
fi

chown -R "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=pyLoad Download Manager Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
ExecStart=${INSTALL_DIR}/.venv/bin/pyload --userdir ${DATA_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now pyload.service >> "${LOG_FILE}" 2>&1

write_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log "${APP_NAME} installation complete."
