#!/bin/bash
#
# [AetherFlow Install Script - pyLoad]
# Installs pyLoad (pyload-ng) download manager in an isolated Python virtualenv.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="pyload"
APP_NAME="pyload"
APP_USER="pyload"
INSTALL_DIR="/opt/pyload"
DATA_DIR="/var/lib/pyload"
SERVICE_FILE="/etc/systemd/system/pyload.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8000}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing Python build dependencies, libcurl, and OCR tools..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip \
    libcurl4-openssl-dev libssl-dev libffi-dev \
    tesseract-ocr p7zip-full unrar-free ffmpeg >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/settings" "${DATA_DIR}/Downloads"

RUNTIME_BACKUP="$(mktemp -d /tmp/af-runtime-XXXXXX)"
RUNTIME_PATHS=("/opt/pyload" "/var/lib/pyload" "/etc/systemd/system/pyload.service")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_MUTATED=0
[[ ! -e "/opt/pyload" ]] || RUNTIME_HAD_PREVIOUS=true
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback pyload || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" == true ]]; then
            systemctl restart pyload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true || -f /etc/systemd/system/pyload.service ]] || systemctl is-active --quiet pyload 2>/dev/null; then
    stop_systemd_unit pyload
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 50 "Creating Python virtualenv and installing pyload-ng..."
RUNTIME_MUTATED=1
if [[ ! -d "${INSTALL_DIR}/.venv" ]]; then
    python3 -m venv "${INSTALL_DIR}/.venv" >> "$LOGFILE" 2>&1
fi
"${INSTALL_DIR}/.venv/bin/pip" install --upgrade pip setuptools wheel >> "$LOGFILE" 2>&1
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_VER="${AF_TARGET_VERSION#v}"
    "${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir "pyload-ng[plugins]==${TARGET_VER}" >> "$LOGFILE" 2>&1 || \
        "${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir "pyload-ng==${TARGET_VER}" >> "$LOGFILE" 2>&1
else
    "${INSTALL_DIR}/.venv/bin/pip" install --upgrade --no-cache-dir "pyload-ng[plugins]" >> "$LOGFILE" 2>&1 || \
        "${INSTALL_DIR}/.venv/bin/pip" install --upgrade --no-cache-dir pyload-ng >> "$LOGFILE" 2>&1
fi

PYLOAD_VER="$("${INSTALL_DIR}/.venv/bin/python" -c "import importlib.metadata; print(importlib.metadata.version('pyload-ng'))" 2>/dev/null || true)"
if [[ -z "$PYLOAD_VER" ]]; then
    print_error "Failed to extract pyload-ng version from ${INSTALL_DIR}/.venv"
    exit 1
fi
if [[ -n "${AF_TARGET_VERSION:-}" && "$PYLOAD_VER" != "${AF_TARGET_VERSION#v}" ]]; then
    print_error "Installed pyload-ng version ($PYLOAD_VER) does not match requested AF_TARGET_VERSION (${AF_TARGET_VERSION#v})"
    exit 1
fi
queue_app_version "${INSTALL_DIR}/.af-version" "${PYLOAD_VER}"

report_progress 75 "Configuring ${APP_NAME} Web UI settings on port ${APP_PORT}..."
if [[ ! -f "${DATA_DIR}/settings/pyload.cfg" ]]; then
    cat > "${DATA_DIR}/settings/pyload.cfg" <<EOF
version: 2

download - "Download":
	folder storage_folder : "Download folder" = ${DATA_DIR}/Downloads

webui - "Web Interface":
	bool autologin : "Skip login if single user" = False
	bool develop : "Development mode" = False
	bool enabled : "Activated" = True
	ip host : "IP address" = 127.0.0.1
	int port : "Port" = ${APP_PORT}
	str prefix : "Path prefix" =
	str theme : "Theme" = modern
	bool use_ssl : "Use HTTPS" = False
EOF
else
    set_config_value "${DATA_DIR}/settings/pyload.cfg" ini 'int port : "Port"' "$APP_PORT"
fi

chown -hRP "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=pyLoad Download Manager Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
ExecStart=${INSTALL_DIR}/.venv/bin/pyload --userdir ${DATA_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now pyload.service >> "$LOGFILE" 2>&1

systemctl restart pyload >> "$LOGFILE" 2>&1
systemctl is-active --quiet pyload

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
