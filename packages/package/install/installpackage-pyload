#!/bin/bash
#
# [AetherFlow Install Script - pyLoad]
# Installs pyLoad (pyload-ng) download manager in an isolated Python virtualenv.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="pyload"
APP_NAME="pyload"
APP_USER="pyload"
INSTALL_DIR="/opt/pyload"
DATA_DIR="/var/lib/pyload"
SERVICE_FILE="/etc/systemd/system/pyload.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8000}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing Python build dependencies, libcurl, and OCR tools..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    curl wget jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip \
    libcurl4-openssl-dev libssl-dev libffi-dev \
    tesseract-ocr p7zip-full unrar-free ffmpeg

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${DATA_DIR}" "${DATA_DIR}/settings" "${DATA_DIR}/Downloads"
chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}"

STAGE_BASE=""
RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-runtime-")"
RUNTIME_PATHS=("/opt/pyload" "/var/lib/pyload" "/etc/systemd/system/pyload.service")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_MUTATED=0
[[ ! -e "/opt/pyload" ]] || RUNTIME_HAD_PREVIOUS=true
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback pyload || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        af_logged systemctl daemon-reload || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" == true ]]; then
            af_logged systemctl restart pyload || restore_failed=true
        fi
    fi
    [[ -z "${STAGE_BASE:-}" ]] || rm -rf -- "$STAGE_BASE"
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true || -f /etc/systemd/system/pyload.service ]] || systemctl is-active --quiet pyload 2>/dev/null; then
    stop_systemd_unit pyload
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 50 "Creating Python virtualenv and installing pyload-ng..."
STAGE_BASE="$(mktemp -d /opt/.af-pyload-build.XXXXXX)"
chmod 0755 "$STAGE_BASE"
STAGE_BUILD="${STAGE_BASE}/build"
mkdir -p "$STAGE_BUILD"
chown -hRP "${APP_USER}:${APP_USER}" "$STAGE_BUILD"

run_as_pyload_builder() {
    if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u "${APP_USER}" -- "$@"
    else
        "$@"
    fi
}

af_logged run_as_pyload_builder python3 -m venv "${STAGE_BUILD}/.venv"
af_logged run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/pip" install --no-cache-dir --upgrade pip setuptools wheel
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_VER="${AF_TARGET_VERSION#v}"
    af_logged run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/pip" install --no-cache-dir "pyload-ng[plugins]==${TARGET_VER}" || \
        af_logged run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/pip" install --no-cache-dir "pyload-ng==${TARGET_VER}"
else
    af_logged run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/pip" install --upgrade --no-cache-dir "pyload-ng[plugins]" || \
        af_logged run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/pip" install --upgrade --no-cache-dir pyload-ng
fi

PYLOAD_VER="$(run_as_pyload_builder "${STAGE_BUILD}/.venv/bin/python" -c "import importlib.metadata; print(importlib.metadata.version('pyload-ng'))" 2>/dev/null || true)"
if [[ -z "$PYLOAD_VER" ]]; then
    print_error "Failed to extract pyload-ng version from ${STAGE_BUILD}/.venv"
    exit 1
fi
if [[ -n "${AF_TARGET_VERSION:-}" && "$PYLOAD_VER" != "${AF_TARGET_VERSION#v}" ]]; then
    print_error "Installed pyload-ng version ($PYLOAD_VER) does not match requested AF_TARGET_VERSION (${AF_TARGET_VERSION#v})"
    exit 1
fi
python3 - "${STAGE_BUILD}/.venv" "${INSTALL_DIR}/.venv" <<'VENV_PYEOF'
import os, pathlib, stat, sys
old_venv, new_venv = sys.argv[1], sys.argv[2]
old_bytes, new_bytes = old_venv.encode(), new_venv.encode()
bin_dir = pathlib.Path(old_venv) / "bin"
if bin_dir.is_dir():
    for entry in bin_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            continue
        data = entry.read_bytes()
        updated = data
        if data.startswith(b"#!") and old_bytes in data.splitlines()[0]:
            first, sep, rest = data.partition(b"\n")
            updated = first.replace(old_bytes, new_bytes) + sep + rest
        elif entry.name.startswith("activate"):
            updated = data.replace(old_bytes, new_bytes)
        if updated != data:
            mode = stat.S_IMODE(entry.stat().st_mode)
            entry.write_bytes(updated)
            os.chmod(entry, mode)
VENV_PYEOF
chown -hRP root:root "${STAGE_BUILD}"
chmod -R go-w,a+rX "${STAGE_BUILD}"

RUNTIME_MUTATED=1
queue_app_version "${INSTALL_DIR}/.af-version" "${PYLOAD_VER}"
if [[ -e "${INSTALL_DIR}" || -L "${INSTALL_DIR}" ]]; then
    mv -T "${INSTALL_DIR}" "${STAGE_BASE}/prev"
fi
mv -T "${STAGE_BUILD}" "${INSTALL_DIR}"
rm -rf -- "${STAGE_BASE}"
STAGE_BASE=""

report_progress 75 "Configuring ${APP_NAME} Web UI settings on port ${APP_PORT}..."
if [[ ! -f "${DATA_DIR}/settings/pyload.cfg" ]]; then
    cat > "${DATA_DIR}/settings/pyload.cfg" <<EOF
version: 2

download - "Download":
	folder storage_folder : "Download folder" = ${DATA_DIR}/Downloads

webui - "Web Interface":
	bool autologin : "Skip login if single user" = False
	bool develop : "Development mode" = False
	bool enabled : "Activated" = True
	ip host : "IP address" = 127.0.0.1
	int port : "Port" = ${APP_PORT}
	str prefix : "Path prefix" =
	str theme : "Theme" = modern
	bool use_ssl : "Use HTTPS" = False
EOF
else
    set_config_value "${DATA_DIR}/settings/pyload.cfg" ini 'int port : "Port"' "$APP_PORT"
fi

chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=pyLoad Download Manager Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
ExecStart=${INSTALL_DIR}/.venv/bin/pyload --userdir ${DATA_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "${SERVICE_FILE}"

af_logged systemctl daemon-reload
af_logged systemctl enable --now pyload.service

af_logged systemctl restart pyload
systemctl is-active --quiet pyload

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
