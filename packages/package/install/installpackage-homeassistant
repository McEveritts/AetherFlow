#!/bin/bash
# AetherFlow Package Installer: Home Assistant Core
# Port: 8123

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="homeassistant"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Python and native build libraries for Home Assistant..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    python3 python3-dev python3-venv python3-pip bluez libffi-dev libssl-dev \
    libjpeg-dev zlib1g-dev autoconf build-essential libopenjp2-7 libtiff-dev \
    libturbojpeg0-dev tzdata ffmpeg liblapack3 liblapack-dev libopenblas-dev \
    libxml2-dev libxslt1-dev ca-certificates >> "$LOGFILE" 2>&1

if ! id -u homeassistant >/dev/null 2>&1; then
    useradd -rm homeassistant -G dialout,gpio,i2c >> "$LOGFILE" 2>&1 || useradd -rm homeassistant >> "$LOGFILE" 2>&1
fi

mkdir -p /srv/homeassistant /home/homeassistant/.homeassistant
if [[ ! -f /home/homeassistant/.homeassistant/configuration.yaml ]]; then
    cat <<'EOF' > /home/homeassistant/.homeassistant/configuration.yaml
default_config:

http:
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1
EOF
fi
chown -R homeassistant:homeassistant /srv/homeassistant /home/homeassistant

report_progress 45 "Creating Home Assistant Python virtual environment..."
sudo -u homeassistant -H bash <<'EOF' >> "$LOGFILE" 2>&1
python3 -m venv /srv/homeassistant
source /srv/homeassistant/bin/activate
pip install --upgrade pip wheel setuptools
pip install homeassistant
EOF

report_progress 85 "Configuring and starting home-assistant@homeassistant.service on port 8123..."
cat <<'EOF' > /etc/systemd/system/home-assistant@homeassistant.service
[Unit]
Description=Home Assistant
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/.homeassistant
ExecStart=/srv/homeassistant/bin/hass -c "/home/%i/.homeassistant"
RestartForceExitStatus=100
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now home-assistant@homeassistant >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Home Assistant installed on port 8123."
log_info "${PACKAGE_NAME} installed successfully"
