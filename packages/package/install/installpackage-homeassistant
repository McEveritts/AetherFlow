#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="homeassistant"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8123}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-homeassistant.lock
flock -n 9 || { log_error "Another Home Assistant installation is running."; exit 1; }

require_root
validate_config_paths /srv/homeassistant/.af-version

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/home-assistant@homeassistant.service ]] || systemctl is-active --quiet home-assistant@homeassistant 2>/dev/null || systemctl is-enabled --quiet home-assistant@homeassistant 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback home-assistant@homeassistant || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /srv/homeassistant "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /srv/homeassistant
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /srv/homeassistant 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/home-assistant@homeassistant.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/home-assistant@homeassistant.service" /etc/systemd/system/home-assistant@homeassistant.service || restore_failed=true
            else
                systemctl disable home-assistant@homeassistant >> "$LOGFILE" 2>&1 || restore_failed=true
                rm -f /etc/systemd/system/home-assistant@homeassistant.service || restore_failed=true
            fi
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            systemctl start home-assistant@homeassistant >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Python and native build libraries for Home Assistant..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    python3 python3-dev python3-venv python3-pip bluez libffi-dev libssl-dev \
    libjpeg-dev zlib1g-dev autoconf build-essential libopenjp2-7 libtiff6 \
    libturbojpeg0-dev tzdata ffmpeg liblapack3 liblapack-dev libopenblas-dev >> "$LOGFILE" 2>&1 || \
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    python3 python3-dev python3-venv python3-pip libffi-dev libssl-dev \
    libjpeg-dev zlib1g-dev autoconf build-essential tzdata ffmpeg >> "$LOGFILE" 2>&1

if ! id -u homeassistant >/dev/null 2>&1; then
    useradd -rm homeassistant -G dialout,gpio,i2c >> "$LOGFILE" 2>&1 || useradd -rm homeassistant >> "$LOGFILE" 2>&1
fi

mkdir -p /srv /var/backups /home/homeassistant/.homeassistant
if [[ ! -f /home/homeassistant/.homeassistant/configuration.yaml ]]; then
    cat <<'EOF' > /home/homeassistant/.homeassistant/configuration.yaml
default_config:

http:
  server_host: 127.0.0.1
  server_port: 8123
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1
EOF
fi
set_config_value "/home/homeassistant/.homeassistant/configuration.yaml" yaml "server_port" "$APP_PORT" "http"

chown -hRP homeassistant:homeassistant /home/homeassistant

report_progress 45 "Creating Home Assistant Python virtual environment with explicit upgrade..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-homeassistant.XXXXXX)"
chmod 700 "$BACKUP_DIR"
stop_systemd_unit home-assistant@homeassistant
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /home/homeassistant/.homeassistant /var/lib/homeassistant
if [[ -f /etc/systemd/system/home-assistant@homeassistant.service ]]; then
    cp -a /etc/systemd/system/home-assistant@homeassistant.service "$BACKUP_DIR/home-assistant@homeassistant.service"
fi
if [[ "$WAS_RUNNABLE" -eq 1 ]]; then
    stop_systemd_unit home-assistant@homeassistant
    SERVICE_STOPPED=1
fi
if [[ -d /srv/homeassistant ]]; then
    mv /srv/homeassistant "$BACKUP_DIR/app"
    APP_MOVED=1
fi
mkdir -p /srv/homeassistant
if [[ "$APP_MOVED" -eq 1 && -f "$BACKUP_DIR/app/.af-version" ]]; then
    install -m 0644 -- "$BACKUP_DIR/app/.af-version" /srv/homeassistant/.af-version
fi
chown -hRP homeassistant:homeassistant /srv/homeassistant
APP_ACTIVATED=1
if [[ "$APP_MOVED" -eq 1 ]]; then
    find "$BACKUP_DIR/app" -mindepth 1 -maxdepth 1 \
        ! -name bin ! -name lib ! -name lib64 ! -name include ! -name share \
        ! -name pyvenv.cfg ! -name .af-version -exec cp -a -t /srv/homeassistant -- {} +
fi

TARGET_HA_SPEC="homeassistant"
TARGET_VER="${AF_PACKAGE_VERSION:-${AETHERFLOW_PACKAGE_VERSION:-${AF_TARGET_VERSION:-}}}"
if [[ -n "$TARGET_VER" ]]; then
    TARGET_HA_SPEC="homeassistant==${TARGET_VER#v}"
fi

sudo -u homeassistant -H bash <<EOF >> "$LOGFILE" 2>&1
python3 -m venv /srv/homeassistant
/srv/homeassistant/bin/pip install --upgrade pip wheel setuptools
/srv/homeassistant/bin/pip install --upgrade "$TARGET_HA_SPEC"
EOF

HASS_VER="$(/srv/homeassistant/bin/hass --version 2>/dev/null || true)"
if [[ -z "$HASS_VER" ]]; then
    log_error "Failed to verify Home Assistant installation in virtualenv"
    exit 1
fi
queue_app_version /srv/homeassistant/.af-version "$HASS_VER"

report_progress 85 "Configuring and starting home-assistant@homeassistant.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/home-assistant@homeassistant.service
[Unit]
Description=Home Assistant
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/.homeassistant
ExecStart=/srv/homeassistant/bin/hass -c "/home/%i/.homeassistant"
RestartForceExitStatus=100
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now home-assistant@homeassistant >> "$LOGFILE" 2>&1
systemctl restart home-assistant@homeassistant >> "$LOGFILE" 2>&1

HEALTHY=0
for attempt in {1..15}; do
    if systemctl is-active --quiet home-assistant@homeassistant; then
        HEALTHY=1
        break
    fi
    sleep 1
done
if [[ "$HEALTHY" -ne 1 ]]; then
    log_error "Home Assistant service did not become active; rolling back."
    exit 1
fi

commit_app_versions
chown homeassistant:homeassistant /srv/homeassistant/.af-version
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Home Assistant installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
