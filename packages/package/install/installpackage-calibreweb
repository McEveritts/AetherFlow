#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="calibreweb"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8083}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install /run/lock
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
if [[ ! "${APP_PORT}" =~ ^[0-9]{1,5}$ ]] || (( 10#${APP_PORT} < 1 || 10#${APP_PORT} > 65535 )); then
    log_error "Invalid Calibre-Web port: ${APP_PORT}"
    exit 1
fi
exec 9>/run/lock/aetherflow-calibreweb.lock
flock -n 9 || { log_error "Another Calibre-Web installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/calibre-web/app.db

if [[ "$APP_PORT" != 8083 ]]; then
    if [[ ! -f /var/lib/calibre-web/app.db ]]; then
        print_error "Calibre-Web requires default port 8083 for initial setup; non-default port ${APP_PORT} requires an existing /var/lib/calibre-web/app.db."
        exit 1
    fi
    if ! safe_config_python /var/lib/calibre-web/app.db "$APP_PORT" <<'PYEOF'
import os, pathlib, sqlite3, stat, sys, tempfile, time, uuid

path = pathlib.Path(sys.argv[1])
port = int(sys.argv[2])
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
MAX_SCRATCH_BYTES = 512 * 1024 * 1024
SUPER_JOURNAL_MAGIC = b"\xd9\xd5\x05\xf9\x20\xa1\x63\xd7"

def is_trusted_root_sticky(dir_str):
    dp = pathlib.PurePosixPath(os.path.abspath(dir_str))
    cur = pathlib.Path("/")
    for part in dp.parts:
        cur = pathlib.Path("/") if part == "/" else cur / part
        try:
            st = os.lstat(cur)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
            return False
        if (st.st_mode & 0o022) != 0 and (st.st_mode & getattr(stat, "S_ISVTX", 0o1000)) == 0:
            return False
    return True

def make_private_scratch(min_free):
    if os.geteuid() == 0:
        sc_name = f".af-cw.{os.getpid()}.{uuid.uuid4().hex}"
        for cand in ("/var/tmp", "/tmp", "/run"):
            if not is_trusted_root_sticky(cand):
                continue
            cand_fd = -1
            try:
                cand_fd = os.open(cand, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
                vfs = os.fstatvfs(cand_fd)
                if vfs.f_bavail * (vfs.f_frsize or vfs.f_bsize) < min_free:
                    os.close(cand_fd)
                    continue
                os.mkdir(sc_name, 0o700, dir_fd=cand_fd)
                sc_fd = os.open(sc_name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cand_fd)
                os.fchmod(sc_fd, 0o700)
                return cand_fd, sc_fd, sc_name, os.path.join(cand, sc_name)
            except OSError:
                if cand_fd >= 0:
                    os.close(cand_fd)
        return None
    tmp_dir = tempfile.mkdtemp(prefix=".af-cw-")
    os.chmod(tmp_dir, 0o700)
    sc_fd = os.open(tmp_dir, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
    return -1, sc_fd, tmp_dir, tmp_dir

def copy_fd_bounded(in_fd, out_dfd, out_name, rem):
    out_fd = os.open(out_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0o600, dir_fd=out_dfd)
    copied = 0
    tail8 = b""
    try:
        while True:
            chunk = os.read(in_fd, 65536)
            if not chunk:
                break
            copied += len(chunk)
            if copied > rem:
                raise OSError("scratch copy cap exceeded")
            tail8 = (tail8 + chunk)[-8:]
            view = memoryview(chunk)
            while view:
                w = os.write(out_fd, view)
                if w <= 0:
                    raise OSError("short write")
                view = view[w:]
        if out_name.endswith("-journal") and copied >= 16 and tail8 == SUPER_JOURNAL_MAGIC:
            raise OSError("forbidden super-journal trailer")
        return rem - copied
    finally:
        os.close(out_fd)

for attempt in range(3):
    sc = None
    db_fd = wal_fd = jrn_fd = -1
    try:
        with ManagedConfig(path, create_parents=False) as config:
            if config.metadata is None:
                sys.exit(1)
            config.check_target()
            db_fd = os.open(config.name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=config.directory)
            dst = os.fstat(db_fd)
            if not stat.S_ISREG(dst.st_mode) or dst.st_nlink != 1:
                sys.exit(1)
            total_sz = dst.st_size
            for suffix in ("-wal", "-shm", "-journal"):
                try:
                    sfd = os.open(config.name + suffix, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=config.directory)
                except FileNotFoundError:
                    continue
                sst = os.fstat(sfd)
                if not stat.S_ISREG(sst.st_mode) or sst.st_nlink != 1:
                    os.close(sfd)
                    sys.exit(1)
                if suffix == "-wal":
                    wal_fd = sfd
                    total_sz += sst.st_size
                elif suffix == "-journal":
                    if sst.st_size >= 16:
                        os.lseek(sfd, -8, os.SEEK_END)
                        jtail = os.read(sfd, 8)
                        os.lseek(sfd, 0, os.SEEK_SET)
                        if jtail == SUPER_JOURNAL_MAGIC:
                            os.close(sfd)
                            sys.exit(1)
                    jrn_fd = sfd
                    total_sz += sst.st_size
                else:
                    os.close(sfd)
            if total_sz > MAX_SCRATCH_BYTES:
                sys.exit(1)
            sc = make_private_scratch(total_sz * 2 + 16 * 1024 * 1024)
            if sc is None:
                sys.exit(1)
            _, sc_fd, _, sc_path = sc
            rem = copy_fd_bounded(db_fd, sc_fd, "app.db", MAX_SCRATCH_BYTES)
            if wal_fd >= 0:
                rem = copy_fd_bounded(wal_fd, sc_fd, "app.db-wal", rem)
            if jrn_fd >= 0:
                copy_fd_bounded(jrn_fd, sc_fd, "app.db-journal", rem)
        conn = sqlite3.connect(os.path.join(sc_path, "app.db"), timeout=5)
        try:
            conn.execute("PRAGMA trusted_schema = OFF;")
            tbl = conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='settings'").fetchone()
            if not tbl:
                sys.exit(1)
            row = conn.execute("SELECT config_port FROM settings LIMIT 1").fetchone()
            sys.exit(0 if row and int(row[0]) == port else 1)
        finally:
            conn.close()
    except sqlite3.DatabaseError:
        if attempt + 1 < 3:
            time.sleep(0.025)
            continue
        sys.exit(1)
    except OSError:
        sys.exit(1)
    finally:
        for fd_c in (db_fd, wal_fd, jrn_fd):
            if fd_c >= 0:
                os.close(fd_c)
        if sc is not None:
            sc_base_fd, sc_fd, sc_name, sc_path = sc
            for nm in ("app.db", "app.db-wal", "app.db-shm", "app.db-journal"):
                try:
                    os.unlink(nm, dir_fd=sc_fd)
                except FileNotFoundError:
                    _ = nm
            os.close(sc_fd)
            try:
                if sc_base_fd >= 0:
                    os.rmdir(sc_name, dir_fd=sc_base_fd)
                else:
                    os.rmdir(sc_path)
            except OSError:
                _ = sc_name
            if sc_base_fd >= 0:
                os.close(sc_base_fd)
sys.exit(1)
PYEOF
    then
        print_error "Calibre-Web starts on port 8083 until its database setting matches ${APP_PORT}."
        exit 1
    fi
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/calibreweb.service ]] || systemctl is-active --quiet calibreweb 2>/dev/null || systemctl is-enabled --quiet calibreweb 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback calibreweb || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/calibre-web "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/calibre-web
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/calibre-web/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/calibre-web 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/calibre-web/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/calibreweb.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/calibreweb.service" /etc/systemd/system/calibreweb.service || restore_failed=true
            else
                af_logged systemctl disable calibreweb || restore_failed=true
                rm -f /etc/systemd/system/calibreweb.service || restore_failed=true
            fi
            af_logged systemctl daemon-reload || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            af_logged systemctl start calibreweb || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and e-book parsing prerequisites..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    git curl ca-certificates python3 python3-pip python3-venv python3-dev \
    build-essential libxml2-dev libxslt1-dev libldap2-dev libsasl2-dev \
    libffi-dev libssl-dev libjpeg-dev zlib1g-dev imagemagick sqlite3

if ! id -u calibreweb >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/calibre-web --shell /usr/sbin/nologin calibreweb
fi

mkdir -p /var/lib/calibre-web /var/lib/calibre-library /opt /var/backups

report_progress 35 "Cloning Calibre-Web repository into staging directory..."
REPO_URL="https://github.com/janeczku/calibre-web.git"
BUILD_DIR="$(mktemp -d /opt/.calibre-web-build.XXXXXX)"
chmod 755 "$BUILD_DIR"
git_stage_exact_revision "$REPO_URL" "$BUILD_DIR" "${AF_TARGET_VERSION:-}"
test -s "$BUILD_DIR/cps.py" || { log_error "Failed to clone Calibre-Web repository"; exit 1; }

CALIBREWEB_VERSION="${AF_STAGED_GIT_VERSION#release-}"
CALIBREWEB_VERSION="${CALIBREWEB_VERSION#Release-}"
CALIBREWEB_VERSION="${CALIBREWEB_VERSION#[vV]}"
validate_config_paths /var/backups/.af-backup-root
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-calibreweb.XXXXXX)"
chmod 700 "$BACKUP_DIR"
queue_app_version "/opt/calibre-web/.af-version" "${CALIBREWEB_VERSION}" "$BUILD_DIR" "$BACKUP_DIR"

report_progress 60 "Setting up Python virtual environment and dependencies..."
chmod 700 "$BACKUP_DIR"
stop_systemd_unit calibreweb
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/calibre-web /var/lib/calibre-library
if [[ -f /etc/systemd/system/calibreweb.service ]]; then
    cp -a /etc/systemd/system/calibreweb.service "$BACKUP_DIR/calibreweb.service"
fi
BUILD_HOME="$BUILD_DIR/.build-home"
mkdir -p "$BUILD_HOME"
chmod 755 "$BUILD_DIR"
chmod 700 "$BUILD_HOME"
chown -hRP calibreweb:calibreweb "$BUILD_DIR" /var/lib/calibre-web /var/lib/calibre-library
run_as_calibreweb_builder() {
    if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u calibreweb -- env -i \
            PATH="/usr/local/bin:/usr/bin:/bin" \
            HOME="${BUILD_HOME:-/nonexistent}" \
            XDG_CONFIG_HOME="${BUILD_HOME:-/nonexistent}/.config" \
            PIP_CONFIG_FILE="/dev/null" \
            PIP_DISABLE_PIP_VERSION_CHECK="1" \
            USER="calibreweb" \
            LOGNAME="calibreweb" \
            LANG="C.UTF-8" \
            PYTHONNOUSERSITE="1" \
            "$@"
    else
        "$@"
    fi
}
af_logged run_as_calibreweb_builder python3 -m venv "$BUILD_DIR/.venv"
af_logged run_as_calibreweb_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir --upgrade pip setuptools wheel
af_logged run_as_calibreweb_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir -r "$BUILD_DIR/requirements.txt"
test -x "$BUILD_DIR/.venv/bin/python" || { log_error "Failed to verify Calibre-Web virtual environment"; exit 1; }
run_as_calibreweb_builder python3 -I - "$BUILD_DIR/.venv" "/opt/calibre-web/.venv" <<'VENV_PYEOF'
import os, pathlib, stat, sys
old_venv, new_venv = sys.argv[1], sys.argv[2]
old_bytes, new_bytes = old_venv.encode(), new_venv.encode()
bin_dir = pathlib.Path(old_venv) / "bin"
if bin_dir.is_dir():
    for entry in bin_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            continue
        data = entry.read_bytes()
        updated = data
        if data.startswith(b"#!") and old_bytes in data.splitlines()[0]:
            first, sep, rest = data.partition(b"\n")
            updated = first.replace(old_bytes, new_bytes) + sep + rest
        elif entry.name.startswith("activate"):
            updated = data.replace(old_bytes, new_bytes)
        if updated != data:
            mode = stat.S_IMODE(entry.stat().st_mode)
            entry.write_bytes(updated)
            os.chmod(entry, mode)
VENV_PYEOF
if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
    pkill -9 -u calibreweb 2>/dev/null || true
fi
BUILD_HOME="/nonexistent"

# Reclaim $BUILD_DIR and verify /var/lib/calibre-web + /var/lib/calibre-library strictly via
# dirfd + O_NOFOLLOW (rejecting hardlinks, special files, and escaping/chained symlinks).
python3 -I - "$BUILD_DIR" calibreweb /var/lib/calibre-web /var/lib/calibre-library <<'PYRECLAIM'
import os, pathlib, pwd, stat, sys

build_root = os.path.abspath(sys.argv[1])
user_name = sys.argv[2]
state_roots = [os.path.abspath(p) for p in sys.argv[3:]]
is_root = os.geteuid() == 0
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)

def open_dir_nofollow(path_str):
    p = pathlib.PurePosixPath(os.path.abspath(path_str))
    if ".." in p.parts:
        raise RuntimeError(f"traversal in {path_str}")
    cur = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    try:
        for part in p.parts[1:]:
            nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur)
            os.close(cur)
            cur = nxt
        return cur
    except BaseException:
        os.close(cur)
        raise

def rmtree_dirfd(parent_fd, name):
    st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISDIR(st.st_mode):
        dfd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=parent_fd)
        try:
            for entry in os.listdir(dfd):
                rmtree_dirfd(dfd, entry)
        finally:
            os.close(dfd)
        os.rmdir(name, dir_fd=parent_fd)
    else:
        os.unlink(name, dir_fd=parent_fd)

def norm_go_w_a_rx(mode, is_dir):
    perm = stat.S_IMODE(mode) & 0o755
    perm |= 0o444
    if is_dir or (perm & 0o111):
        perm |= 0o111
    return perm

def verify_relative_target_confined(root_fd, rel_parts, target):
    if os.path.isabs(target):
        return False
    stack = list(rel_parts)
    for part in pathlib.PurePosixPath(target).parts:
        if part in ("", "."):
            continue
        if part == "..":
            if not stack:
                return False
            stack.pop()
        else:
            stack.append(part)
    if not stack:
        return True
    cur = os.dup(root_fd)
    try:
        for comp in stack[:-1]:
            nxt = os.open(comp, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur)
            os.close(cur)
            cur = nxt
        try:
            st = os.stat(stack[-1], dir_fd=cur, follow_symlinks=False)
        except FileNotFoundError:
            return False
        return stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)
    except OSError:
        return False
    finally:
        os.close(cur)

def is_allowed_venv_python_symlink(child_rel, target):
    if len(child_rel) != 3 or child_rel[0] != ".venv" or child_rel[1] != "bin":
        return False
    if not child_rel[2].startswith("python"):
        return False
    if target.startswith("/usr/bin/python3") and ".." not in pathlib.PurePosixPath(target).parts:
        try:
            st = os.lstat(target)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode):
            resolved = os.path.realpath(target)
            if not resolved.startswith("/usr/bin/python3"):
                return False
            rst = os.stat(resolved)
            return stat.S_ISREG(rst.st_mode) and rst.st_uid == 0 and (rst.st_mode & 0o022) == 0
        return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and (st.st_mode & 0o022) == 0
    return target in ("python3", "python") or (target.startswith("python3.") and "/" not in target)

def reclaim_tree(root_fd, dfd, rel_parts):
    if is_root:
        os.fchown(dfd, 0, 0)
    dst = os.fstat(dfd)
    os.fchmod(dfd, norm_go_w_a_rx(dst.st_mode, True))
    for name in os.listdir(dfd):
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        child_rel = rel_parts + (name,)
        if stat.S_ISLNK(st.st_mode):
            target = os.readlink(name, dir_fd=dfd)
            allowed = (
                is_allowed_venv_python_symlink(child_rel, target)
                or (child_rel == (".venv", "lib64") and target == "lib")
                or verify_relative_target_confined(root_fd, rel_parts, target)
            )
            if not allowed:
                raise RuntimeError(f"forbidden symlink in build dir: {'/'.join(child_rel)} -> {target}")
            if is_root:
                os.chown(name, 0, 0, dir_fd=dfd, follow_symlinks=False)
        elif stat.S_ISDIR(st.st_mode):
            sub_fd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=dfd)
            try:
                reclaim_tree(root_fd, sub_fd, child_rel)
            finally:
                os.close(sub_fd)
        elif stat.S_ISREG(st.st_mode):
            ffd = os.open(name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=dfd)
            try:
                fst = os.fstat(ffd)
                if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                    raise RuntimeError(f"non-regular or hardlinked file in build dir: {'/'.join(child_rel)}")
                if is_root:
                    os.fchown(ffd, 0, 0)
                os.fchmod(ffd, norm_go_w_a_rx(fst.st_mode, False))
            finally:
                os.close(ffd)
        else:
            raise RuntimeError(f"forbidden special file in build dir: {'/'.join(child_rel)}")

def fchown_tree_no_symlinks(dfd, uid, gid):
    os.fchown(dfd, uid, gid)
    for name in os.listdir(dfd):
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode):
            raise RuntimeError(f"forbidden symlink in state dir: {name}")
        if stat.S_ISDIR(st.st_mode):
            sub_fd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=dfd)
            try:
                fchown_tree_no_symlinks(sub_fd, uid, gid)
            finally:
                os.close(sub_fd)
        elif stat.S_ISREG(st.st_mode):
            ffd = os.open(name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=dfd)
            try:
                fst = os.fstat(ffd)
                if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                    raise RuntimeError(f"non-regular or hardlinked file in state dir: {name}")
                os.fchown(ffd, uid, gid)
            finally:
                os.close(ffd)
        else:
            raise RuntimeError(f"forbidden special file in state dir: {name}")

build_fd = open_dir_nofollow(build_root)
try:
    try:
