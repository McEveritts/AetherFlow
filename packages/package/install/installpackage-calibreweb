        cur = pathlib.Path("/")
        for part in dp.parts:
            cur = pathlib.Path("/") if part == "/" else cur / part
            try:
                st = os.lstat(cur)
            except OSError:
                return False
            if _stat.S_ISLNK(st.st_mode) or not _stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
                return False
