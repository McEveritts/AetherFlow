#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="calibreweb"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8083}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install /run/lock
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
if [[ ! "${APP_PORT}" =~ ^[0-9]{1,5}$ ]] || (( 10#${APP_PORT} < 1 || 10#${APP_PORT} > 65535 )); then
    log_error "Invalid Calibre-Web port: ${APP_PORT}"
    exit 1
fi
exec 9>/run/lock/aetherflow-calibreweb.lock
flock -n 9 || { log_error "Another Calibre-Web installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/calibre-web/app.db

if [[ "$APP_PORT" != 8083 ]]; then
    if [[ ! -f /var/lib/calibre-web/app.db ]]; then
        print_error "Calibre-Web requires default port 8083 for initial setup; non-default port ${APP_PORT} requires an existing /var/lib/calibre-web/app.db."
        exit 1
    fi
    if ! safe_config_python /var/lib/calibre-web/app.db "$APP_PORT" <<'PYEOF'
import pathlib, sqlite3, sys
path = pathlib.Path(sys.argv[1])
port = int(sys.argv[2])
with ManagedConfig(path, create_parents=False) as config:
    if config.metadata is None:
        sys.exit(1)
    config.check_target()
    with sqlite3.connect(f'file:/proc/self/fd/{config.directory}/{config.name}?mode=ro', uri=True) as conn:
        row = conn.execute('SELECT config_port FROM settings LIMIT 1').fetchone()
        sys.exit(0 if row and int(row[0]) == port else 1)
PYEOF
    then
        print_error "Calibre-Web starts on port 8083 until its database setting matches ${APP_PORT}."
        exit 1
    fi
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/calibreweb.service ]] || systemctl is-active --quiet calibreweb 2>/dev/null || systemctl is-enabled --quiet calibreweb 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback calibreweb || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/calibre-web "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/calibre-web
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/calibre-web/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/calibre-web 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/calibre-web/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/calibreweb.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/calibreweb.service" /etc/systemd/system/calibreweb.service || restore_failed=true
            else
                af_logged systemctl disable calibreweb || restore_failed=true
                rm -f /etc/systemd/system/calibreweb.service || restore_failed=true
            fi
            af_logged systemctl daemon-reload || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            af_logged systemctl start calibreweb || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and e-book parsing prerequisites..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    git curl ca-certificates python3 python3-pip python3-venv python3-dev \
    build-essential libxml2-dev libxslt1-dev libldap2-dev libsasl2-dev \
    libffi-dev libssl-dev libjpeg-dev zlib1g-dev imagemagick sqlite3

if ! id -u calibreweb >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/calibre-web --shell /usr/sbin/nologin calibreweb
fi

mkdir -p /var/lib/calibre-web /var/lib/calibre-library /opt /var/backups

report_progress 35 "Cloning Calibre-Web repository into staging directory..."
REPO_URL="https://github.com/janeczku/calibre-web.git"
FALLBACK_TAG="0.6.27"
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_TAG="$AF_TARGET_VERSION"
else
    TARGET_TAG="$(git ls-remote --tags --refs "$REPO_URL" 2>/dev/null | sed 's#.*refs/tags/##' | grep -E '^v?[0-9]+(\.[0-9]+)+$' | sort -V | tail -n1 || true)"
    if [[ -z "$TARGET_TAG" ]]; then
        TARGET_TAG="$FALLBACK_TAG"
    fi
fi
if ! git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG}" >/dev/null 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG#v}" >/dev/null 2>&1; then
        TARGET_TAG="${TARGET_TAG#v}"
    elif [[ ! "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/v${TARGET_TAG}" >/dev/null 2>&1; then
        TARGET_TAG="v${TARGET_TAG}"
    else
        af_write_failure_receipt 1 "download" "invalid_target_tag" "Upstream tag refs/tags/${TARGET_TAG} not found in ${REPO_URL}"
        exit 1
    fi
fi
BUILD_DIR="$(mktemp -d /opt/.calibre-web-build.XXXXXX)"
chmod 755 "$BUILD_DIR"
if ! af_logged git clone --branch "$TARGET_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR"; then
    if [[ "$TARGET_TAG" =~ ^v ]]; then
        ALT_TAG="${TARGET_TAG#v}"
    else
        ALT_TAG="v${TARGET_TAG}"
    fi
    af_logged git clone --branch "$ALT_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" || {
        log_error "Failed to clone Calibre-Web repository at tag $TARGET_TAG"
        exit 1
    }
    TARGET_TAG="$ALT_TAG"
fi
test -s "$BUILD_DIR/cps.py" || { log_error "Failed to clone Calibre-Web repository"; exit 1; }

validate_config_paths /var/backups/.af-backup-root
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-calibreweb.XXXXXX)"
chmod 700 "$BACKUP_DIR"
queue_app_version "/opt/calibre-web/.af-version" "${TARGET_TAG#v}" "$BUILD_DIR" "$BACKUP_DIR"

report_progress 60 "Setting up Python virtual environment and dependencies..."
chmod 700 "$BACKUP_DIR"
stop_systemd_unit calibreweb
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/calibre-web /var/lib/calibre-library
if [[ -f /etc/systemd/system/calibreweb.service ]]; then
    cp -a /etc/systemd/system/calibreweb.service "$BACKUP_DIR/calibreweb.service"
fi
chmod 755 "$BUILD_DIR"
chown -hRP calibreweb:calibreweb "$BUILD_DIR" /var/lib/calibre-web /var/lib/calibre-library
run_as_calibreweb_builder() {
    if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u calibreweb -- "$@"
    else
        "$@"
    fi
}
af_logged run_as_calibreweb_builder python3 -m venv "$BUILD_DIR/.venv"
af_logged run_as_calibreweb_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir --upgrade pip setuptools wheel
af_logged run_as_calibreweb_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir -r "$BUILD_DIR/requirements.txt"
test -x "$BUILD_DIR/.venv/bin/python" || { log_error "Failed to verify Calibre-Web virtual environment"; exit 1; }
python3 - "$BUILD_DIR/.venv" "/opt/calibre-web/.venv" <<'VENV_PYEOF'
import os, pathlib, stat, sys
old_venv, new_venv = sys.argv[1], sys.argv[2]
old_bytes, new_bytes = old_venv.encode(), new_venv.encode()
bin_dir = pathlib.Path(old_venv) / "bin"
if bin_dir.is_dir():
    for entry in bin_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            continue
        data = entry.read_bytes()
        updated = data
        if data.startswith(b"#!") and old_bytes in data.splitlines()[0]:
            first, sep, rest = data.partition(b"\n")
            updated = first.replace(old_bytes, new_bytes) + sep + rest
        elif entry.name.startswith("activate"):
            updated = data.replace(old_bytes, new_bytes)
        if updated != data:
            mode = stat.S_IMODE(entry.stat().st_mode)
            entry.write_bytes(updated)
            os.chmod(entry, mode)
VENV_PYEOF
chown -hRP root:root "$BUILD_DIR"
chmod -R go-w,a+rX "$BUILD_DIR"

if [[ ! -f /var/lib/calibre-library/metadata.db ]]; then
    af_logged sqlite3 /var/lib/calibre-library/metadata.db "CREATE TABLE IF NOT EXISTS books (id INTEGER PRIMARY KEY, title TEXT, sort TEXT, timestamp TEXT, pubdate TEXT, series_index REAL, modify_date TEXT, path TEXT, flags INTEGER, has_cover BOOL DEFAULT 0);" || true
fi

chown -hRP calibreweb:calibreweb /var/lib/calibre-web /var/lib/calibre-library

report_progress 75 "Backing up existing Calibre-Web installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    stop_systemd_unit calibreweb
    SERVICE_STOPPED=1
fi
if [[ -d /opt/calibre-web ]]; then
    mv /opt/calibre-web "$BACKUP_DIR/app"
    APP_MOVED=1
fi
mv "$BUILD_DIR" /opt/calibre-web
chmod 755 /opt/calibre-web
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/calibre-web

report_progress 85 "Configuring and starting calibreweb.service on port ${APP_PORT}..."
CALIBRE_BIND_HOST=""
if [[ -f /etc/systemd/system/calibreweb.service ]]; then
    CALIBRE_BIND_HOST="$(safe_config_python /etc/systemd/system/calibreweb.service <<'PYEOF'
import ipaddress
import shlex
import sys

text = safe_read_text(sys.argv[1])
bind_host = ""
for raw_line in text.splitlines():
    stripped = raw_line.strip()
    if not stripped.startswith("ExecStart="):
        continue
    cmd = stripped.split("=", 1)[1].strip()
    try:
        tokens = shlex.split(cmd)
    except ValueError:
        continue
    if not any("cps.py" in tok for tok in tokens):
        continue
    idx = 0
    while idx < len(tokens):
        tok = tokens[idx]
        candidate = None
        if tok == "-i" and idx + 1 < len(tokens):
            candidate = tokens[idx + 1]
            idx += 1
        elif tok.startswith("-i=") and len(tok) > 3:
            candidate = tok[3:]
        elif tok.startswith("-i") and not tok.startswith("--") and len(tok) > 2:
            candidate = tok[2:]
        if candidate is not None:
            raw_ip = candidate.strip()
            unbracketed = raw_ip[1:-1] if raw_ip.startswith("[") and raw_ip.endswith("]") else raw_ip
            try:
                ip = ipaddress.ip_address(unbracketed)
            except ValueError:
                raise ValueError(f"Invalid retained Calibre-Web bind IP: {candidate!r}")
            bind_host = str(ip)
        idx += 1
print(bind_host)
PYEOF
)"
fi
CALIBRE_EXEC_START="/opt/calibre-web/.venv/bin/python /opt/calibre-web/cps.py -p /var/lib/calibre-web/app.db -g /var/lib/calibre-web/gdrive.db"
if [[ -n "$CALIBRE_BIND_HOST" ]]; then
    CALIBRE_EXEC_START="${CALIBRE_EXEC_START} -i ${CALIBRE_BIND_HOST}"
fi
cat <<EOF > /etc/systemd/system/calibreweb.service
[Unit]
Description=Calibre-Web E-Book Library Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=calibreweb
Group=calibreweb
WorkingDirectory=/opt/calibre-web
Environment=CALIBRE_PORT=${APP_PORT}
ExecStart=${CALIBRE_EXEC_START}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/calibreweb.service
UNIT_WRITTEN=1

CALIBRE_READY_META="$(safe_config_python /var/lib/calibre-web/app.db "$APP_PORT" "$CALIBRE_BIND_HOST" /opt/calibre-web <<'PYEOF'
import contextlib
import ipaddress
import os
import pathlib
import sqlite3
import sys

db_path = pathlib.Path(sys.argv[1])
default_port = sys.argv[2].strip()
bind_host = sys.argv[3].strip()
work_dir = pathlib.Path(sys.argv[4])


def emit(mode, primary_url="", fallback_url="", scheme="http", tls_insecure="0", reason=""):
    for val in (mode, primary_url, fallback_url, scheme, tls_insecure, reason):
        print(val)
    sys.exit(0)


def is_local_interface_ip(target_ip):
    proc_root = pathlib.Path(os.environ.get("AF_PROC_ROOT") or "/proc")
    if target_ip.version == 4:
        fib = proc_root / "net" / "fib_trie"
        if not fib.is_file():
            return False
        try:
            lines = fib.read_text(encoding="utf-8", errors="ignore").splitlines()
        except OSError:
            return False
        in_local = False
        prev_ip = None
        for line in lines:
            if line.startswith("Local:"):
                in_local = True
                prev_ip = None
                continue
            if line and not line[0].isspace():
                in_local = False
                prev_ip = None
                continue
            if not in_local:
                continue
            stripped = line.strip()
            if stripped.startswith("|-- "):
                try:
                    prev_ip = ipaddress.IPv4Address(stripped[4:].strip())
                except ValueError:
                    prev_ip = None
            elif stripped.startswith("+-- "):
                prev_ip = None
            elif prev_ip is not None and "/32 host LOCAL" in stripped and prev_ip == target_ip:
                return True
        return False

    if6 = proc_root / "net" / "if_inet6"
    if not if6.is_file():
        return False
    try:
        lines = if6.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return False
    for line in lines:
        parts = line.split()
        if parts and len(parts[0]) == 32:
            try:
                if ipaddress.IPv6Address(bytes.fromhex(parts[0])) == target_ip:
                    return True
            except ValueError:
                continue
    return False


probe_port = default_port
scheme = "http"

if os.path.lexists(db_path):
    with ManagedConfig(db_path, create_parents=False) as config:
        if config.metadata is not None:
            config.check_target()
            try:
                with contextlib.closing(
                    sqlite3.connect(f"file:/proc/self/fd/{config.directory}/{config.name}?mode=ro", uri=True)
                ) as conn:
                    cols = {
                        row[1]
                        for row in conn.execute("PRAGMA table_info(settings)").fetchall()
                    }
                    wanted = [c for c in ("config_port", "config_certfile", "config_keyfile") if c in cols]
                    if wanted:
                        row = conn.execute(f"SELECT {', '.join(wanted)} FROM settings LIMIT 1").fetchone()
                        if row:
                            values = dict(zip(wanted, row))
                            raw_port = values.get("config_port")
                            if raw_port is not None and str(raw_port).strip().isdecimal():
                                parsed_port = int(str(raw_port).strip())
                                if 1 <= parsed_port <= 65535:
                                    probe_port = str(parsed_port)
                            cert = str(values.get("config_certfile") or "").strip()
                            key = str(values.get("config_keyfile") or "").strip()
                            if cert and key:
                                cert_path = pathlib.Path(cert)
                                key_path = pathlib.Path(key)
                                if not cert_path.is_absolute():
                                    cert_path = work_dir / cert_path
                                if not key_path.is_absolute():
                                    key_path = work_dir / key_path
                                if cert_path.is_file() and key_path.is_file():
                                    scheme = "https"
            except sqlite3.Error:
                pass

if not bind_host:
    tls_insecure = "1" if scheme == "https" else "0"
    emit(
        "probe",
        f"{scheme}://127.0.0.1:{probe_port}/login",
        f"{scheme}://[::1]:{probe_port}/login",
        scheme,
        tls_insecure,
        "",
    )

ip = ipaddress.ip_address(bind_host)
mapped = getattr(ip, "ipv4_mapped", None)
if ip.is_unspecified:
    host_for_url = "127.0.0.1" if ip.version == 4 else "[::1]"
    emit(
        "probe",
        f"{scheme}://{host_for_url}:{probe_port}/login",
        "",
        scheme,
        "1" if scheme == "https" else "0",
        "",
    )

if ip.is_loopback or (mapped is not None and mapped.is_loopback):
    host_for_url = str(ip) if ip.version == 4 else f"[{ip}]"
    emit(
        "probe",
        f"{scheme}://{host_for_url}:{probe_port}/login",
        "",
        scheme,
        "1" if scheme == "https" else "0",
        "",
    )

if ip.version == 6 and ip.is_link_local:
    emit(
        "skip",
        reason=f"retained Calibre-Web bind address '{bind_host}' is a link-local IPv6 address without an unambiguous HTTP URL",
    )

if is_local_interface_ip(ip):
    host_for_url = str(ip) if ip.version == 4 else f"[{ip}]"
    emit(
        "probe",
        f"{scheme}://{host_for_url}:{probe_port}/login",
        "",
        scheme,
        "0",
        "",
    )

emit(
    "skip",
    reason=f"retained Calibre-Web bind address '{bind_host}' is not assigned to a local interface on this host",
)
PYEOF
)"
mapfile -t CALIBRE_READY_FIELDS <<< "$CALIBRE_READY_META"
CALIBRE_READY_MODE="${CALIBRE_READY_FIELDS[0]:-skip}"
CALIBRE_PRIMARY_URL="${CALIBRE_READY_FIELDS[1]:-}"
CALIBRE_FALLBACK_URL="${CALIBRE_READY_FIELDS[2]:-}"
CALIBRE_READY_SCHEME="${CALIBRE_READY_FIELDS[3]:-http}"
CALIBRE_TLS_INSECURE="${CALIBRE_READY_FIELDS[4]:-0}"
CALIBRE_READY_REASON="${CALIBRE_READY_FIELDS[5]:-}"

CALIBRE_CURL_ARGS=(--proto "=${CALIBRE_READY_SCHEME}")
if [[ "$CALIBRE_TLS_INSECURE" == "1" ]]; then
    CALIBRE_CURL_ARGS+=(-k)
fi

af_logged systemctl daemon-reload
af_logged systemctl enable --now calibreweb

CALIBRE_READY_ATTEMPTS="${AF_READINESS_ATTEMPTS:-30}"
if [[ ! "$CALIBRE_READY_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || (( 10#$CALIBRE_READY_ATTEMPTS > 300 )); then
    CALIBRE_READY_ATTEMPTS=30
fi
if [[ "$CALIBRE_READY_MODE" != "probe" ]]; then
    if declare -F print_warn >/dev/null 2>&1; then
        print_warn "Skipping direct HTTP readiness probe for calibreweb.service: ${CALIBRE_READY_REASON:-unproven retained listener}; keeping systemd-only readiness check."
    else
        log_warn "Skipping direct HTTP readiness probe for calibreweb.service: ${CALIBRE_READY_REASON:-unproven retained listener}; keeping systemd-only readiness check."
    fi
fi

HEALTHY=0
CALIBRE_VERIFIED_URL=""
for ((attempt = 1; attempt <= CALIBRE_READY_ATTEMPTS; attempt++)); do
    if systemctl is-active --quiet calibreweb; then
        if [[ "$CALIBRE_READY_MODE" != "probe" ]]; then
            HEALTHY=1
            break
        fi
        probe_rc=0
        curl --disable --noproxy '*' "${CALIBRE_CURL_ARGS[@]}" -fsS --connect-timeout 2 --max-time 5 "$CALIBRE_PRIMARY_URL" >/dev/null 2>&1 || probe_rc=$?
        if [[ "$probe_rc" -eq 0 ]]; then
            CALIBRE_VERIFIED_URL="$CALIBRE_PRIMARY_URL"
            HEALTHY=1
            break
        fi
        if [[ "$probe_rc" -eq 7 && -n "$CALIBRE_FALLBACK_URL" ]]; then
            if curl --disable --noproxy '*' "${CALIBRE_CURL_ARGS[@]}" -fsS --connect-timeout 2 --max-time 5 "$CALIBRE_FALLBACK_URL" >/dev/null 2>&1; then
                CALIBRE_VERIFIED_URL="$CALIBRE_FALLBACK_URL"
                HEALTHY=1
                break
            fi
        fi
    fi
    if (( attempt < CALIBRE_READY_ATTEMPTS )); then
        sleep 1
    fi
done
if [[ "$HEALTHY" -ne 1 ]]; then
    if [[ "$CALIBRE_READY_MODE" == "probe" ]]; then
        log_error "Calibre-Web service did not become HTTP-ready at ${CALIBRE_PRIMARY_URL}; rolling back."
    else
        log_error "Calibre-Web service did not become active; rolling back."
    fi
    exit 1
fi
systemctl is-active --quiet calibreweb

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
if [[ "$CALIBRE_READY_MODE" == "probe" && -n "$CALIBRE_VERIFIED_URL" ]] \
    && declare -F af_emit_readiness_record >/dev/null 2>&1; then
    af_emit_readiness_record "calibreweb.service" "$CALIBRE_VERIFIED_URL" false false
fi
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Calibre-Web installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
