#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="calibreweb"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8083}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-calibreweb.lock
flock -n 9 || { log_error "Another Calibre-Web installation is running."; exit 1; }

require_root
validate_config_paths /var/lib/calibre-web/app.db

if [[ "$APP_PORT" != 8083 ]]; then
    if [[ ! -f /var/lib/calibre-web/app.db ]]; then
        print_error "Calibre-Web requires default port 8083 for initial setup; non-default port ${APP_PORT} requires an existing /var/lib/calibre-web/app.db."
        exit 1
    fi
    if ! safe_config_python /var/lib/calibre-web/app.db "$APP_PORT" <<'PYEOF'
import pathlib, sqlite3, sys
path = pathlib.Path(sys.argv[1])
port = int(sys.argv[2])
with ManagedConfig(path, create_parents=False) as config:
    if config.metadata is None:
        sys.exit(1)
    config.check_target()
    with sqlite3.connect(f'file:/proc/self/fd/{config.directory}/{config.name}?mode=ro', uri=True) as conn:
        row = conn.execute('SELECT config_port FROM settings LIMIT 1').fetchone()
        sys.exit(0 if row and int(row[0]) == port else 1)
PYEOF
    then
        print_error "Calibre-Web starts on port 8083 until its database setting matches ${APP_PORT}."
        exit 1
    fi
fi

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/calibreweb.service ]] || systemctl is-active --quiet calibreweb 2>/dev/null || systemctl is-enabled --quiet calibreweb 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            quiesce_services_for_rollback calibreweb || { restore_failed=true; exit 1; }
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/calibre-web "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/calibre-web
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/calibre-web/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/calibre-web 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/calibre-web/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/calibreweb.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/calibreweb.service" /etc/systemd/system/calibreweb.service || restore_failed=true
            else
                systemctl disable calibreweb >> "$LOGFILE" 2>&1 || restore_failed=true
                rm -f /etc/systemd/system/calibreweb.service || restore_failed=true
            fi
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            systemctl start calibreweb >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and e-book parsing prerequisites..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    git curl ca-certificates python3 python3-pip python3-venv python3-dev \
    build-essential libxml2-dev libxslt1-dev libldap2-dev libsasl2-dev \
    libffi-dev libssl-dev libjpeg-dev zlib1g-dev imagemagick sqlite3 >> "$LOGFILE" 2>&1

if ! id -u calibreweb >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/calibre-web --shell /usr/sbin/nologin calibreweb
fi

mkdir -p /var/lib/calibre-web /var/lib/calibre-library /opt /var/backups

report_progress 35 "Cloning Calibre-Web repository into staging directory..."
REPO_URL="https://github.com/janeczku/calibre-web.git"
FALLBACK_TAG="0.6.27"
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_TAG="$AF_TARGET_VERSION"
else
    TARGET_TAG="$(git ls-remote --tags --refs "$REPO_URL" 2>/dev/null | sed 's#.*refs/tags/##' | grep -E '^v?[0-9]+(\.[0-9]+)+$' | sort -V | tail -n1 || true)"
    if [[ -z "$TARGET_TAG" ]]; then
        TARGET_TAG="$FALLBACK_TAG"
    fi
fi
if ! git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG}" >/dev/null 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG#v}" >/dev/null 2>&1; then
        TARGET_TAG="${TARGET_TAG#v}"
    elif [[ ! "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/v${TARGET_TAG}" >/dev/null 2>&1; then
        TARGET_TAG="v${TARGET_TAG}"
    else
        af_write_failure_receipt 1 "download" "invalid_target_tag" "Upstream tag refs/tags/${TARGET_TAG} not found in ${REPO_URL}"
        exit 1
    fi
fi
BUILD_DIR="$(mktemp -d /opt/.calibre-web-build.XXXXXX)"
chmod 755 "$BUILD_DIR"
if ! git clone --branch "$TARGET_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]]; then
        ALT_TAG="${TARGET_TAG#v}"
    else
        ALT_TAG="v${TARGET_TAG}"
    fi
    git clone --branch "$ALT_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1 || {
        log_error "Failed to clone Calibre-Web repository at tag $TARGET_TAG"
        exit 1
    }
    TARGET_TAG="$ALT_TAG"
fi
test -s "$BUILD_DIR/cps.py" || { log_error "Failed to clone Calibre-Web repository"; exit 1; }

BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-calibreweb.XXXXXX)"
queue_app_version "/opt/calibre-web/.af-version" "${TARGET_TAG#v}" "$BUILD_DIR" "$BACKUP_DIR"

report_progress 60 "Setting up Python virtual environment and dependencies..."
chmod 700 "$BACKUP_DIR"
stop_systemd_unit calibreweb
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/calibre-web /var/lib/calibre-library
if [[ -f /etc/systemd/system/calibreweb.service ]]; then
    cp -a /etc/systemd/system/calibreweb.service "$BACKUP_DIR/calibreweb.service"
fi
mkdir -p /opt/calibre-web
if [[ -e /opt/calibre-web/.venv || -L /opt/calibre-web/.venv ]]; then
    if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
        stop_systemd_unit calibreweb
        SERVICE_STOPPED=1
    fi
    mv /opt/calibre-web/.venv "$BACKUP_DIR/venv"
    VENV_MOVED=1
fi
python3 -m venv /opt/calibre-web/.venv >> "$LOGFILE" 2>&1
VENV_ACTIVATED=1
/opt/calibre-web/.venv/bin/pip install --upgrade pip setuptools wheel >> "$LOGFILE" 2>&1
/opt/calibre-web/.venv/bin/pip install -r "$BUILD_DIR/requirements.txt" >> "$LOGFILE" 2>&1
test -x /opt/calibre-web/.venv/bin/python || { log_error "Failed to verify Calibre-Web virtual environment"; exit 1; }

if [[ ! -f /var/lib/calibre-library/metadata.db ]]; then
    sqlite3 /var/lib/calibre-library/metadata.db "CREATE TABLE IF NOT EXISTS books (id INTEGER PRIMARY KEY, title TEXT, sort TEXT, timestamp TEXT, pubdate TEXT, series_index REAL, modify_date TEXT, path TEXT, flags INTEGER, has_cover BOOL DEFAULT 0);" >> "$LOGFILE" 2>&1 || true
fi

chown -hRP calibreweb:calibreweb /opt/calibre-web/.venv "$BUILD_DIR" /var/lib/calibre-web /var/lib/calibre-library

report_progress 75 "Backing up existing Calibre-Web installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    stop_systemd_unit calibreweb
    SERVICE_STOPPED=1
fi
mv /opt/calibre-web/.venv "$BUILD_DIR/.venv"
VENV_ACTIVATED=0
if [[ -d /opt/calibre-web ]]; then
    mv /opt/calibre-web "$BACKUP_DIR/app"
    APP_MOVED=1
    if [[ "$VENV_MOVED" -eq 1 ]]; then
        mv "$BACKUP_DIR/venv" "$BACKUP_DIR/app/.venv"
    fi
fi
mv "$BUILD_DIR" /opt/calibre-web
chmod 755 /opt/calibre-web
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/calibre-web

report_progress 85 "Configuring and starting calibreweb.service on port ${APP_PORT}..."
cat <<EOF > /etc/systemd/system/calibreweb.service
[Unit]
Description=Calibre-Web E-Book Library Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=calibreweb
Group=calibreweb
WorkingDirectory=/opt/calibre-web
Environment=CALIBRE_PORT=${APP_PORT}
ExecStart=/opt/calibre-web/.venv/bin/python /opt/calibre-web/cps.py -p /var/lib/calibre-web/app.db -g /var/lib/calibre-web/gdrive.db
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now calibreweb >> "$LOGFILE" 2>&1

HEALTHY=0
for attempt in {1..15}; do
    if systemctl is-active --quiet calibreweb; then
        HEALTHY=1
        break
    fi
    sleep 1
done
if [[ "$HEALTHY" -ne 1 ]]; then
    log_error "Calibre-Web service did not become active; rolling back."
    exit 1
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Calibre-Web installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
