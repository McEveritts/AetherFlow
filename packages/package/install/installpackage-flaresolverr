#!/bin/bash
# AetherFlow Package Installer: FlareSolverr
# Port: 8191

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="flaresolverr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Chromium and Xvfb dependencies for FlareSolverr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl xvfb python3 python3-venv python3-pip ca-certificates fonts-liberation libnss3 libatk-bridge2.0-0t64 libdrm2 libxkbcommon0 libgbm1 libasound2t64 >> "$LOGFILE" 2>&1 || \
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl xvfb python3 python3-venv python3-pip ca-certificates fonts-liberation libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 libgbm1 libasound2 >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq chromium >> "$LOGFILE" 2>&1 || DEBIAN_FRONTEND=noninteractive apt-get install -y -qq chromium-browser >> "$LOGFILE" 2>&1 || true

if ! id -u flaresolverr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/flaresolverr --shell /usr/sbin/nologin flaresolverr
fi

mkdir -p /opt/flaresolverr /var/lib/flaresolverr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) FS_ARCH="linux_x64" ;;
    arm64) FS_ARCH="linux_arm64" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest FlareSolverr release..."
FS_VERSION="$(github_latest_tag "FlareSolverr/FlareSolverr" "3.3.21")"
FS_URL=""
if [[ "$FS_ARCH" == "linux_x64" ]]; then
    FS_URL="https://github.com/FlareSolverr/FlareSolverr/releases/download/v${FS_VERSION}/flaresolverr_linux_x64.tar.gz"
fi

report_progress 60 "Downloading and installing FlareSolverr ${FS_VERSION}..."
rm -rf /opt/flaresolverr
if [[ -n "$FS_URL" ]]; then
    TMP_TAR=$(mktemp /tmp/flaresolverr-XXXXXX.tar.gz)
    curl -fsSL "$FS_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
    tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
    rm -f "$TMP_TAR"
else
    # Source + venv fallback for arm64 where prebuilt binary tarball is omitted
    TMP_TAR=$(mktemp /tmp/flaresolverr-src-XXXXXX.tar.gz)
    curl -fsSL "https://github.com/FlareSolverr/FlareSolverr/archive/refs/tags/v${FS_VERSION}.tar.gz" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
    mkdir -p /opt/flaresolverr
    tar -xzf "$TMP_TAR" -C /opt/flaresolverr --strip-components=1 >> "$LOGFILE" 2>&1
    rm -f "$TMP_TAR"
    python3 -m venv /opt/flaresolverr/.venv >> "$LOGFILE" 2>&1
    /opt/flaresolverr/.venv/bin/pip install --upgrade pip wheel >> "$LOGFILE" 2>&1
    /opt/flaresolverr/.venv/bin/pip install -r /opt/flaresolverr/requirements.txt >> "$LOGFILE" 2>&1
    cat <<'WRAP' > /opt/flaresolverr/flaresolverr
#!/bin/bash
exec /opt/flaresolverr/.venv/bin/python3 /opt/flaresolverr/src/flaresolverr.py "$@"
WRAP
    chmod +x /opt/flaresolverr/flaresolverr
fi

printf '%s\n' "${FS_VERSION#v}" > /opt/flaresolverr/.af-version
chown -R flaresolverr:flaresolverr /opt/flaresolverr /var/lib/flaresolverr

CHROME_BIN="$(command -v chromium || command -v chromium-browser || echo /usr/bin/chromium)"

report_progress 85 "Configuring and starting flaresolverr.service on port 8191..."
cat <<EOF > /etc/systemd/system/flaresolverr.service
[Unit]
Description=FlareSolverr Proxy Daemon
After=network.target

[Service]
User=flaresolverr
Group=flaresolverr
WorkingDirectory=/opt/flaresolverr
Environment=HOST=0.0.0.0
Environment=PORT=8191
Environment=LOG_LEVEL=info
Environment=HEADLESS=true
Environment=CHROME_EXE=${CHROME_BIN}
Environment=HOME=/var/lib/flaresolverr
ExecStart=/opt/flaresolverr/flaresolverr
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now flaresolverr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "FlareSolverr installed on port 8191."
log_info "${PACKAGE_NAME} installed successfully"
