#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="flaresolverr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8191}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install /run/lock
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
exec 9>/run/lock/aetherflow-flaresolverr.lock
flock -n 9 || { log_error "Another FlareSolverr installation is running."; exit 1; }

require_root

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/flaresolverr.service ]] || systemctl is-active --quiet flaresolverr 2>/dev/null || systemctl is-enabled --quiet flaresolverr 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        [[ "$status" -ne 0 ]] || status=1
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            if ! quiesce_services_for_rollback flaresolverr; then
                restore_failed=true
            else
                restore_app_state "$BACKUP_DIR" || restore_failed=true
            fi
        fi
        if [[ "$restore_failed" == false ]]; then
            if [[ "$APP_ACTIVATED" -eq 1 ]]; then
                mv /opt/flaresolverr "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/flaresolverr
            elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
                rm -rf /opt/flaresolverr/.venv || restore_failed=true
            fi
            if [[ "$APP_MOVED" -eq 1 ]]; then
                mv "$BACKUP_DIR/app" /opt/flaresolverr 2>/dev/null || restore_failed=true
            elif [[ "$VENV_MOVED" -eq 1 ]]; then
                mv "$BACKUP_DIR/venv" /opt/flaresolverr/.venv 2>/dev/null || restore_failed=true
            fi
            if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
                if [[ -f "$BACKUP_DIR/flaresolverr.service" ]]; then
                    safe_restore_path_from_backup "$BACKUP_DIR/flaresolverr.service" /etc/systemd/system/flaresolverr.service || restore_failed=true
                else
                    af_logged systemctl disable flaresolverr || restore_failed=true
                    rm -f /etc/systemd/system/flaresolverr.service || restore_failed=true
                fi
                af_logged systemctl daemon-reload || restore_failed=true
            fi
            if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
                af_logged systemctl start flaresolverr || restore_failed=true
            fi
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf -- "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    elif [[ -n "${BACKUP_DIR:-}" && -d "$BACKUP_DIR" ]]; then
        rm -rf -- "$BACKUP_DIR" || true
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Chromium and Xvfb dependencies for FlareSolverr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    curl git tar ca-certificates xvfb xauth libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2t64 fonts-liberation python3 python3-venv python3-pip || \
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    curl git tar ca-certificates xvfb xauth libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 fonts-liberation python3 python3-venv python3-pip
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq chromium || \
    DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq chromium-browser || true

if ! id -u flaresolverr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/flaresolverr --shell /usr/sbin/nologin flaresolverr
fi

mkdir -p /var/lib/flaresolverr /opt /var/backups

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) FS_ARCH="linux_x64" ;;
    arm64) FS_ARCH="linux_arm64" ;;
    *) FS_ARCH="linux_x64" ;;
esac

report_progress 40 "Resolving latest FlareSolverr release..."
FS_VERSION="$(github_latest_tag "FlareSolverr/FlareSolverr" "3.3.21")"
FS_URL=""
if [[ "$FS_ARCH" == "linux_x64" ]]; then
    FS_URL="https://github.com/FlareSolverr/FlareSolverr/releases/download/v${FS_VERSION#v}/flaresolverr_linux_x64.tar.gz"
fi

report_progress 60 "Downloading and staging FlareSolverr ${FS_VERSION}..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-flaresolverr.XXXXXX)"
chmod 700 "$BACKUP_DIR"
stop_systemd_unit flaresolverr
SERVICE_STOPPED=1
snapshot_app_state "$BACKUP_DIR" /var/lib/flaresolverr /etc/flaresolverr
if [[ -f /etc/systemd/system/flaresolverr.service ]]; then
    cp -a /etc/systemd/system/flaresolverr.service "$BACKUP_DIR/flaresolverr.service"
fi
BUILD_DIR="$(mktemp -d /opt/.flaresolverr-build.XXXXXX)"
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
if [[ -n "$FS_URL" ]]; then
    TMP_TAR=$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/flaresolverr-XXXXXX.tar.gz")
    af_logged download_file "$FS_URL" "$TMP_TAR"
    tar -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1 2>/dev/null || af_logged tar -xzf "$TMP_TAR" -C "$BUILD_DIR"
    rm -f "$TMP_TAR"
else
    FS_REPO="https://github.com/FlareSolverr/FlareSolverr.git"
    FS_TAG="v${FS_VERSION#v}"
    if ! git ls-remote --exit-code --tags "$FS_REPO" "refs/tags/${FS_TAG}" >/dev/null 2>&1; then
        if git ls-remote --exit-code --tags "$FS_REPO" "refs/tags/${FS_VERSION#v}" >/dev/null 2>&1; then
            FS_TAG="${FS_VERSION#v}"
        else
            print_error "Upstream tag refs/tags/${FS_TAG} not found in FlareSolverr/FlareSolverr"
            exit 1
        fi
    fi
    af_logged git clone --branch "$FS_TAG" --depth 1 "$FS_REPO" "$BUILD_DIR"
    git -C "$BUILD_DIR" rev-parse --verify HEAD >/dev/null 2>&1 || { log_error "Failed to verify cloned FlareSolverr source tree"; exit 1; }
    mkdir -p /opt/flaresolverr
    if [[ -e /opt/flaresolverr/.venv || -L /opt/flaresolverr/.venv ]]; then
        if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
            stop_systemd_unit flaresolverr
            SERVICE_STOPPED=1
        fi
        mv /opt/flaresolverr/.venv "$BACKUP_DIR/venv"
        VENV_MOVED=1
    fi
    af_logged python3 -m venv /opt/flaresolverr/.venv
    VENV_ACTIVATED=1
    af_logged /opt/flaresolverr/.venv/bin/pip install --upgrade pip wheel
    af_logged /opt/flaresolverr/.venv/bin/pip install -r "$BUILD_DIR/requirements.txt"
    cat <<'WRAP' > "$BUILD_DIR/flaresolverr"
#!/bin/bash
exec /opt/flaresolverr/.venv/bin/python3 /opt/flaresolverr/src/flaresolverr.py "$@"
WRAP
    chmod 0755 "$BUILD_DIR/flaresolverr"
fi

test -s "$BUILD_DIR/flaresolverr" || test -s "$BUILD_DIR/src/flaresolverr.py" || { log_error "Failed to verify FlareSolverr build output"; exit 1; }
queue_app_version /opt/flaresolverr/.af-version "${FS_VERSION#v}"
chown -hRP flaresolverr:flaresolverr "$BUILD_DIR" /var/lib/flaresolverr

CHROME_BIN="$(command -v chromium || command -v chromium-browser || echo /usr/bin/chromium)"

report_progress 75 "Backing up existing FlareSolverr installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    stop_systemd_unit flaresolverr
    SERVICE_STOPPED=1
fi
if [[ "$VENV_ACTIVATED" -eq 1 ]]; then
    chown -hRP flaresolverr:flaresolverr /opt/flaresolverr/.venv
    mv /opt/flaresolverr/.venv "$BUILD_DIR/.venv"
    VENV_ACTIVATED=0
fi
if [[ -d /opt/flaresolverr ]]; then
    mv /opt/flaresolverr "$BACKUP_DIR/app"
    APP_MOVED=1
    if [[ "$VENV_MOVED" -eq 1 ]]; then
        mv "$BACKUP_DIR/venv" "$BACKUP_DIR/app/.venv"
    fi
fi
mv "$BUILD_DIR" /opt/flaresolverr
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/flaresolverr

report_progress 85 "Configuring and starting flaresolverr.service on port ${APP_PORT}..."
cat <<EOF > /etc/systemd/system/flaresolverr.service
[Unit]
Description=FlareSolverr Anti-Bot Challenge Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flaresolverr
Group=flaresolverr
WorkingDirectory=/opt/flaresolverr
Environment=HOST=127.0.0.1
Environment=PORT=${APP_PORT}
Environment=LOG_LEVEL=info
Environment=HEADLESS=true
Environment=BROWSER_EXECUTABLE_PATH=${CHROME_BIN}
ExecStart=/opt/flaresolverr/flaresolverr
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/flaresolverr.service
UNIT_WRITTEN=1

af_logged systemctl daemon-reload
af_logged systemctl enable --now flaresolverr

READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
wait_for_service_ready "flaresolverr.service" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
rm -rf -- "$BACKUP_DIR"
report_progress 100 "FlareSolverr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
