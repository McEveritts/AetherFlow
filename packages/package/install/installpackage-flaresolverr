#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    source "${SELF_DIR}/../../common.sh"
else
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="flaresolverr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8191}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-flaresolverr.lock
flock -n 9 || { log_error "Another FlareSolverr installation is running."; exit 1; }

require_root

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
UNIT_WRITTEN=0
SUCCESS=0

if [[ -f /etc/systemd/system/flaresolverr.service ]] || systemctl is-active --quiet flaresolverr 2>/dev/null || systemctl is-enabled --quiet flaresolverr 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$?
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 ]]; then
            systemctl stop flaresolverr >> "$LOGFILE" 2>&1 || true
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/flaresolverr "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/flaresolverr
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/flaresolverr/.venv
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/flaresolverr 2>/dev/null || true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/flaresolverr/.venv 2>/dev/null || true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/flaresolverr.service" ]]; then
                cp -a "$BACKUP_DIR/flaresolverr.service" /etc/systemd/system/flaresolverr.service
            else
                systemctl disable flaresolverr >> "$LOGFILE" 2>&1 || true
                rm -f /etc/systemd/system/flaresolverr.service
            fi
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || true
        fi
        if [[ "$WAS_RUNNABLE" -eq 1 ]]; then
            systemctl start flaresolverr >> "$LOGFILE" 2>&1 || true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Chromium and Xvfb dependencies for FlareSolverr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl tar ca-certificates xvfb xauth libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2t64 fonts-liberation python3 python3-venv python3-pip >> "$LOGFILE" 2>&1 || \
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl tar ca-certificates xvfb xauth libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 fonts-liberation python3 python3-venv python3-pip >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq chromium >> "$LOGFILE" 2>&1 || \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq chromium-browser >> "$LOGFILE" 2>&1 || true

if ! id -u flaresolverr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/flaresolverr --shell /usr/sbin/nologin flaresolverr
fi

mkdir -p /var/lib/flaresolverr /opt /var/backups

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) FS_ARCH="linux_x64" ;;
    arm64) FS_ARCH="linux_arm64" ;;
    *) FS_ARCH="linux_x64" ;;
esac

report_progress 40 "Resolving latest FlareSolverr release..."
FS_VERSION="$(github_latest_tag "FlareSolverr/FlareSolverr" "3.3.21")"
FS_URL=""
if [[ "$FS_ARCH" == "linux_x64" ]]; then
    FS_URL="https://github.com/FlareSolverr/FlareSolverr/releases/download/v${FS_VERSION}/flaresolverr_linux_x64.tar.gz"
fi

report_progress 60 "Downloading and staging FlareSolverr ${FS_VERSION}..."
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-flaresolverr.XXXXXX)"
chmod 700 "$BACKUP_DIR"
if [[ -f /etc/systemd/system/flaresolverr.service ]]; then
    cp -a /etc/systemd/system/flaresolverr.service "$BACKUP_DIR/flaresolverr.service"
fi
BUILD_DIR="$(mktemp -d /opt/.flaresolverr-build.XXXXXX)"
if [[ -n "$FS_URL" ]]; then
    TMP_TAR=$(mktemp /tmp/flaresolverr-XXXXXX.tar.gz)
    curl -fsSL "$FS_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
    tar -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1 2>/dev/null || tar -xzf "$TMP_TAR" -C "$BUILD_DIR" >> "$LOGFILE" 2>&1
    rm -f "$TMP_TAR"
else
    TMP_TAR=$(mktemp /tmp/flaresolverr-src-XXXXXX.tar.gz)
    curl -fsSL "https://github.com/FlareSolverr/FlareSolverr/archive/refs/tags/v${FS_VERSION}.tar.gz" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
    tar -xzf "$TMP_TAR" -C "$BUILD_DIR" --strip-components=1 >> "$LOGFILE" 2>&1
    rm -f "$TMP_TAR"
    mkdir -p /opt/flaresolverr
    if [[ -e /opt/flaresolverr/.venv || -L /opt/flaresolverr/.venv ]]; then
        if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
            systemctl stop flaresolverr >> "$LOGFILE" 2>&1 || true
            SERVICE_STOPPED=1
        fi
        mv /opt/flaresolverr/.venv "$BACKUP_DIR/venv"
        VENV_MOVED=1
    fi
    python3 -m venv /opt/flaresolverr/.venv >> "$LOGFILE" 2>&1
    VENV_ACTIVATED=1
    /opt/flaresolverr/.venv/bin/pip install --upgrade pip wheel >> "$LOGFILE" 2>&1
    /opt/flaresolverr/.venv/bin/pip install -r "$BUILD_DIR/requirements.txt" >> "$LOGFILE" 2>&1
    cat <<'WRAP' > "$BUILD_DIR/flaresolverr"
#!/bin/bash
exec /opt/flaresolverr/.venv/bin/python3 /opt/flaresolverr/src/flaresolverr.py "$@"
WRAP
    chmod +x "$BUILD_DIR/flaresolverr"
fi

test -s "$BUILD_DIR/flaresolverr" || test -s "$BUILD_DIR/src/flaresolverr.py" || { log_error "Failed to verify FlareSolverr build output"; exit 1; }
printf '%s\n' "${FS_VERSION#v}" > "$BUILD_DIR/.af-version"
chown -R flaresolverr:flaresolverr "$BUILD_DIR" /var/lib/flaresolverr

CHROME_BIN="$(command -v chromium || command -v chromium-browser || echo /usr/bin/chromium)"

report_progress 75 "Backing up existing FlareSolverr installation and activating new build..."
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    systemctl stop flaresolverr >> "$LOGFILE" 2>&1 || true
    SERVICE_STOPPED=1
fi
if [[ "$VENV_ACTIVATED" -eq 1 ]]; then
    chown -R flaresolverr:flaresolverr /opt/flaresolverr/.venv
    mv /opt/flaresolverr/.venv "$BUILD_DIR/.venv"
    VENV_ACTIVATED=0
fi
if [[ -d /opt/flaresolverr ]]; then
    mv /opt/flaresolverr "$BACKUP_DIR/app"
    APP_MOVED=1
    if [[ "$VENV_MOVED" -eq 1 ]]; then
        mv "$BACKUP_DIR/venv" "$BACKUP_DIR/app/.venv"
    fi
fi
mv "$BUILD_DIR" /opt/flaresolverr
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/flaresolverr

report_progress 85 "Configuring and starting flaresolverr.service on port ${APP_PORT}..."
cat <<EOF > /etc/systemd/system/flaresolverr.service
[Unit]
Description=FlareSolverr Anti-Bot Challenge Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flaresolverr
Group=flaresolverr
WorkingDirectory=/opt/flaresolverr
Environment=HOST=0.0.0.0
Environment=PORT=${APP_PORT}
Environment=LOG_LEVEL=info
Environment=HEADLESS=true
Environment=BROWSER_EXECUTABLE_PATH=${CHROME_BIN}
ExecStart=/opt/flaresolverr/flaresolverr
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF
UNIT_WRITTEN=1

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now flaresolverr >> "$LOGFILE" 2>&1

HEALTHY=0
for attempt in {1..15}; do
    if systemctl is-active --quiet flaresolverr; then
        HEALTHY=1
        break
    fi
    sleep 1
done
if [[ "$HEALTHY" -ne 1 ]]; then
    log_error "FlareSolverr service did not become active; rolling back."
    exit 1
fi

write_lock "${PACKAGE_NAME}"
SUCCESS=1
report_progress 100 "FlareSolverr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
