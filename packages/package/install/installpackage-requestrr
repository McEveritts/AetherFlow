#!/bin/bash
#
# [AetherFlow Install Script - Requestrr]
# Installs Requestrr chatbot server for Discord/Matrix and Arr stack integration.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="requestrr"
APP_NAME="requestrr"
APP_USER="requestrr"
INSTALL_DIR="/opt/requestrr"
DATA_DIR="/var/lib/requestrr"
SERVICE_FILE="/etc/systemd/system/requestrr.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-4545}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing system dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq tar ca-certificates libicu-dev libssl-dev >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/config"

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
    amd64) R_ARCH="linux-x64" ;;
    arm64) R_ARCH="linux-arm64" ;;
    armhf) R_ARCH="linux-arm" ;;
    *)
        log_error "Unsupported architecture for Requestrr: ${ARCH}"
        exit 1
        ;;
esac

report_progress 45 "Resolving latest ${APP_NAME} release from GitHub..."
RELEASE_JSON="$(curl -fsSL https://api.github.com/repos/thomst08/requestrr/releases/latest 2>/dev/null || true)"
LATEST_TAG="$(echo "${RELEASE_JSON}" | jq -r '.tag_name // empty' || true)"
if [[ -z "${LATEST_TAG}" ]]; then
    print_error "Failed to discover latest GitHub release for thomst08/requestrr"
    exit 1
fi
ASSET_URL="$(echo "${RELEASE_JSON}" | jq -r --arg name "requestrr-${R_ARCH}.tar.gz" '.assets[]? | select(.name == $name) | .browser_download_url' | head -n1 || true)"

if [[ -z "${ASSET_URL}" ]]; then
    ASSET_URL="$(echo "${RELEASE_JSON}" | jq -r --arg arch "${R_ARCH}" '.assets[]? | select(.name | test($arch + ".*\\.(tar\\.gz|zip)$")) | .browser_download_url' | head -n1 || true)"
fi

if [[ -z "${ASSET_URL}" ]]; then
    log_error "Unable to resolve Requestrr asset for ${R_ARCH}"
    exit 1
fi

TMP_TAR="$(mktemp --suffix=.tar.gz)"
TMP_EXTRACT="$(mktemp -d)"
report_progress 65 "Downloading ${APP_NAME} (${LATEST_TAG})..."
download_file "${ASSET_URL}" "${TMP_TAR}" >> "$LOGFILE" 2>&1

report_progress 80 "Extracting ${APP_NAME} to ${INSTALL_DIR}..."
tar -xzf "${TMP_TAR}" -C "${TMP_EXTRACT}" >> "$LOGFILE" 2>&1
rm -f "${TMP_TAR}"

if [[ ! -f "${TMP_EXTRACT}/Requestrr.WebApi" ]]; then
    SUBDIR="$(find "${TMP_EXTRACT}" -mindepth 1 -maxdepth 1 -type d | head -n1)"
    if [[ -n "${SUBDIR}" ]]; then
        RELEASE_DIR="$SUBDIR"
    fi
fi
RELEASE_DIR="${RELEASE_DIR:-$TMP_EXTRACT}"
chmod +x "$RELEASE_DIR/Requestrr.WebApi"
stage_app_archive "$RELEASE_DIR" "$INSTALL_DIR" Requestrr.WebApi "$DATA_DIR" "$PACKAGE_NAME" "."
[[ "$RELEASE_DIR" == "$TMP_EXTRACT" ]] || rm -rf -- "$TMP_EXTRACT"

if [[ -d "$AF_ARCHIVE_BACKUP/app/config" && ! -L "$AF_ARCHIVE_BACKUP/app/config" ]]; then
    cp -an -- "$AF_ARCHIVE_BACKUP/app/config/." "${DATA_DIR}/config/"
fi
if [[ -d "${INSTALL_DIR}/config" && ! -L "${INSTALL_DIR}/config" ]]; then
    cp -rn "${INSTALL_DIR}/config/." "${DATA_DIR}/config/" 2>/dev/null || true
    rm -rf "${INSTALL_DIR}/config"
fi
ln -sfn "${DATA_DIR}/config" "${INSTALL_DIR}/config"

if [[ -f "${DATA_DIR}/config/settings.json" ]]; then
    set_config_value "${DATA_DIR}/config/settings.json" json Port "$APP_PORT"
fi

chmod +x "${INSTALL_DIR}/Requestrr.WebApi"
CLEAN_VER="${LATEST_TAG#[vV]}"
queue_app_version "${INSTALL_DIR}/.af-version" "${CLEAN_VER}"
chown -hRP "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Requestrr Media Request Chatbot Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
Environment="ASPNETCORE_URLS=http://*:${APP_PORT}"
Environment="DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false"
Environment="HOME=${DATA_DIR}"
ExecStart=${INSTALL_DIR}/Requestrr.WebApi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now requestrr.service >> "$LOGFILE" 2>&1
systemctl restart requestrr.service >> "$LOGFILE" 2>&1
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
