#!/bin/bash
# AetherFlow Package Installer: Readarr
# Port: 8787

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="readarr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8787}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
print_warn "Readarr upstream retired on June 27, 2025 because its metadata became unusable. Discovery and updates may not work; this installer preserves Readarr and existing data without substituting an unofficial fork."
report_progress 10 "Installing dependencies for Readarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev ca-certificates >> "$LOGFILE" 2>&1

if ! id -u readarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/readarr --shell /usr/sbin/nologin readarr
fi

mkdir -p /var/lib/readarr /opt/Readarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) READARR_ARCH="x64" ;;
    arm64) READARR_ARCH="arm64" ;;
    armhf) READARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

READARR_VERSION=""
if [[ -x /opt/Readarr/Readarr && -f /opt/Readarr/Readarr.dll ]]; then
    READARR_VERSION="$(strings /opt/Readarr/Readarr.dll 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)"
fi

if [[ -n "$READARR_VERSION" ]]; then
    report_progress 50 "Using verified existing Readarr binary (version ${READARR_VERSION})..."
elif [[ -n "${AF_READARR_VERIFIED_ARCHIVE:-}" && -f "${AF_READARR_VERIFIED_ARCHIVE}" && -n "${AF_READARR_SHA256:-}" ]]; then
    report_progress 35 "Verifying pinned Readarr archive..."
    printf '%s  %s\n' "${AF_READARR_SHA256}" "${AF_READARR_VERIFIED_ARCHIVE}" | sha256sum -c - >> "$LOGFILE" 2>&1 || {
        af_write_failure_receipt 1 "verify" "archive_corrupt" "Readarr archive SHA256 verification failed"
        exit 1
    }
    report_progress 65 "Extracting verified Readarr archive to /opt/Readarr..."
    stage_app_archive "${AF_READARR_VERIFIED_ARCHIVE}" "/opt/Readarr" "Readarr" "/var/lib/readarr" "${PACKAGE_NAME}"
    INSTALLED_VER="$(strings /opt/Readarr/Readarr.dll 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)"
    if [[ -z "$INSTALLED_VER" ]]; then
        af_write_failure_receipt 1 "verify" "version_probe_failed" "Failed to extract verified Readarr version from /opt/Readarr/Readarr.dll"
        exit 1
    fi
    READARR_VERSION="$INSTALLED_VER"
else
    af_write_failure_receipt 1 "retired" "retired_upstream" "Readarr is retired upstream; new unpinned downloads are disabled without a pinned SHA-256 artifact"
    exit 1
fi

queue_app_version /opt/Readarr/.af-version "${READARR_VERSION#v}"
printf '%s\n' "${READARR_VERSION#v}" > /opt/Readarr/.af-version 2>/dev/null || true
set_config_value "/var/lib/readarr/config.xml" xml "Port" "$APP_PORT" "Config"

chown -hRP readarr:readarr /opt/Readarr /var/lib/readarr

report_progress 85 "Configuring and starting readarr.service..."
cat <<'EOF' > /etc/systemd/system/readarr.service
[Unit]
Description=Readarr Daemon
After=syslog.target network.target

[Service]
User=readarr
Group=readarr
Type=simple
ExecStart=/opt/Readarr/Readarr -nobrowser -data=/var/lib/readarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now readarr >> "$LOGFILE" 2>&1
systemctl restart readarr >> "$LOGFILE" 2>&1
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "$READY_URL"
seed_servarr_master_user "readarr" ${APP_PORT} "v1"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Readarr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
