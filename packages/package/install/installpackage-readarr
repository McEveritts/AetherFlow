#!/bin/bash
# AetherFlow Package Installer: Readarr
# Port: 8787

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="readarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Readarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev ca-certificates >> "$LOGFILE" 2>&1

if ! id -u readarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/readarr --shell /usr/sbin/nologin readarr
fi

mkdir -p /var/lib/readarr /opt/Readarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) READARR_ARCH="x64" ;;
    arm64) READARR_ARCH="arm64" ;;
    armhf) READARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Readarr (${READARR_ARCH})..."
READARR_JSON="$(curl -fsSL https://api.github.com/repos/Readarr/Readarr/releases/latest 2>/dev/null || true)"
READARR_VERSION="$(printf '%s' "$READARR_JSON" | grep -oP '"tag_name":\s*"v?\K[^"]+' | head -1 || true)"
READARR_URL="$(printf '%s' "$READARR_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*linux-core-'${READARR_ARCH}'\.tar\.gz' | head -1 || true)"
if [[ -z "$READARR_URL" ]]; then
    READARR_URL="https://readarr.servarr.com/v1/update/develop/updatefile?os=linux&runtime=netcore&arch=${READARR_ARCH}"
fi

TMP_TAR=$(mktemp /tmp/readarr-XXXXXX.tar.gz)
curl -fsSL "$READARR_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Readarr to /opt/Readarr..."
tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
if [[ -n "$READARR_VERSION" ]]; then
    printf '%s\n' "${READARR_VERSION#v}" > /opt/Readarr/.af-version
fi
chown -R readarr:readarr /opt/Readarr /var/lib/readarr

report_progress 85 "Configuring and starting readarr.service..."
cat <<'EOF' > /etc/systemd/system/readarr.service
[Unit]
Description=Readarr Daemon
After=syslog.target network.target

[Service]
User=readarr
Group=readarr
Type=simple
ExecStart=/opt/Readarr/Readarr -nobrowser -data=/var/lib/readarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now readarr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Readarr installed on port 8787."
log_info "${PACKAGE_NAME} installed successfully"
