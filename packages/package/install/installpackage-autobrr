#!/bin/bash
# AetherFlow Package Installer: Autobrr
# Port: 7474

set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="autobrr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-7474}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for Autobrr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl wget tar openssl ca-certificates >> "$LOGFILE" 2>&1

if ! id -u autobrr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/autobrr --shell /usr/sbin/nologin autobrr
fi

mkdir -p /var/lib/autobrr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) AB_ARCH="linux_x86_64" ;;
    arm64) AB_ARCH="linux_arm64" ;;
    armhf) AB_ARCH="linux_armv6" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Autobrr release (${AB_ARCH})..."
AB_VERSION="$(github_latest_tag "autobrr/autobrr" "1.46.0")"
AB_URL="https://github.com/autobrr/autobrr/releases/download/v${AB_VERSION}/autobrr_${AB_VERSION}_${AB_ARCH}.tar.gz"

report_progress 65 "Downloading and installing Autobrr ${AB_VERSION}..."
TMP_TAR=$(mktemp /tmp/autobrr-XXXXXX.tar.gz)
download_file "$AB_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
TMP_DIR="$(mktemp -d /tmp/autobrr-extract-XXXXXX)"
trap 'rm -rf "$TMP_DIR"; rm -f "$TMP_TAR"' EXIT
tar -xzf "$TMP_TAR" -C "$TMP_DIR" autobrr autobrrctl >> "$LOGFILE" 2>&1
chmod 755 "$TMP_DIR/autobrr" "$TMP_DIR/autobrrctl"
stage_app_archive "$TMP_DIR" /usr/local/bin/autobrr autobrr /var/lib/autobrr "$PACKAGE_NAME" "." /usr/local/bin/autobrrctl "" binary
install_binary_atomic "$AF_ARCHIVE_BACKUP/release/prepared/autobrrctl" /usr/local/bin/autobrrctl
rm -rf "$TMP_DIR"
rm -f "$TMP_TAR"
chmod +x /usr/local/bin/autobrr /usr/local/bin/autobrrctl
queue_app_version /var/lib/autobrr/.af-version "${AB_VERSION#v}"

if [[ ! -f /var/lib/autobrr/config.toml ]]; then
    SESSION_SECRET="$(openssl rand -hex 16)"
    cat <<EOF > /var/lib/autobrr/config.toml
host = "127.0.0.1"
port = ${APP_PORT}
logLevel = "INFO"
sessionSecret = "${SESSION_SECRET}"
EOF
fi

stop_systemd_unit autobrr
if [[ ! -s /var/lib/autobrr/autobrr.db ]]; then
    printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | /usr/local/bin/autobrrctl --config=/var/lib/autobrr create-user "${MASTER_USER}" >> "$LOGFILE" 2>&1
elif [[ -n "${AF_CONFIG_PASS:-}" && "${AF_KEEP_EXISTING_SECRETS:-1}" != "1" ]]; then
    printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | /usr/local/bin/autobrrctl --config=/var/lib/autobrr create-user "${MASTER_USER}" >> "$LOGFILE" 2>&1 \
        || printf '%s\n' "${AF_CONFIG_PASS:-$MASTER_PASS}" | /usr/local/bin/autobrrctl --config=/var/lib/autobrr change-password "${MASTER_USER}" >> "$LOGFILE" 2>&1
fi

set_config_value "/var/lib/autobrr/config.toml" ini "port" "$APP_PORT" ""

chown -hRP autobrr:autobrr /var/lib/autobrr
chmod 600 /var/lib/autobrr/config.toml

report_progress 85 "Configuring and starting autobrr.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/autobrr.service
[Unit]
Description=autobrr service
After=syslog.target network-online.target

[Service]
Type=simple
User=autobrr
Group=autobrr
ExecStart=/usr/local/bin/autobrr --config=/var/lib/autobrr/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now autobrr >> "$LOGFILE" 2>&1
systemctl restart autobrr >> "$LOGFILE" 2>&1
systemctl is-active --quiet autobrr
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/api/healthz"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Autobrr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
