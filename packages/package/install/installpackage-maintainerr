#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="maintainerr"
BUILD_USER="af-maintainerr-build"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6246}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
require_root
validate_config_paths /var/lib/maintainerr/.af-directory-check
if [[ ! "$APP_PORT" =~ ^[0-9]{1,5}$ ]] || (( 10#$APP_PORT < 1024 || 10#$APP_PORT > 65535 )); then
    log_error "Invalid Maintainerr port: ${APP_PORT}"
    exit 1
fi
mkdir -p "$(dirname "$LOGFILE")" /install /run/lock
exec 9>/run/lock/aetherflow-maintainerr.lock
flock -n 9 || { log_error "Another Maintainerr lifecycle operation is running."; exit 1; }

BUILD_ROOT=""
BUILD_DIR=""
BACKUP_DIR=""
SANDBOX_HELPER=""
BUILD_USER_CREATED=0
BUILDER_UID=""
BUILDER_GID=""
WAS_ACTIVE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
UNIT_WRITTEN=0
DATA_SAVED=0
SUCCESS=0

resolve_sandbox_helper() {
    local candidate_path
    for candidate_path in \
        "${SELF_DIR}/../../system/af-systemd-sandbox" \
        /opt/AetherFlow/current/packages/system/af-systemd-sandbox \
        /opt/AetherFlow/packages/system/af-systemd-sandbox \
        /usr/local/bin/AetherFlow/system/af-systemd-sandbox \
        /usr/local/bin/af-systemd-sandbox; do
        if [[ -f "$candidate_path" && -r "$candidate_path" ]]; then
            printf '%s\n' "$candidate_path"
            return 0
        fi
    done
    return 1
}

run_as_builder() {
    runuser -u "$BUILD_USER" -- env -i \
        "PATH=$BUILD_DIR/.runtime/bin:/usr/local/bin:/usr/bin:/bin" \
        "HOME=$BUILD_ROOT/home" \
        "XDG_CACHE_HOME=$BUILD_ROOT/cache" \
        "XDG_CONFIG_HOME=$BUILD_ROOT/config" \
        "XDG_DATA_HOME=$BUILD_ROOT/data" \
        "TMPDIR=$BUILD_ROOT/tmp" \
        "YARN_CACHE_FOLDER=$BUILD_ROOT/cache/yarn" \
        "npm_config_cache=$BUILD_ROOT/cache/npm" \
        "CI=1" \
        "TURBO_TELEMETRY_DISABLED=1" \
        "YARN_ENABLE_TELEMETRY=0" \
        "$@"
}

quiesce_builder_processes() {
    if [[ ! "$BUILDER_UID" =~ ^[0-9]+$ ]] || (( 10#$BUILDER_UID <= 0 )); then
        log_error "Missing or invalid numeric builder UID for process quiescence."
        return 1
    fi
    local attempt pgrep_rc kill_rc
    for attempt in {1..50}; do
        pgrep_rc=0
        pgrep -U "$BUILDER_UID" >/dev/null 2>&1 || pgrep_rc=$?
        if [[ "$pgrep_rc" -eq 1 ]]; then
            pgrep_rc=0
            pgrep -u "$BUILDER_UID" >/dev/null 2>&1 || pgrep_rc=$?
            if [[ "$pgrep_rc" -eq 1 ]]; then
                return 0
            fi
        fi
        if [[ "$pgrep_rc" -ne 0 && "$pgrep_rc" -ne 1 ]]; then
            log_error "Failed to query active builder processes for UID ${BUILDER_UID} (pgrep exit ${pgrep_rc})."
            return 1
        fi
        kill_rc=0
        pkill -KILL -U "$BUILDER_UID" >/dev/null 2>&1 || kill_rc=$?
        if [[ "$kill_rc" -ne 0 && "$kill_rc" -ne 1 ]]; then
            log_error "Failed to terminate builder processes by real UID ${BUILDER_UID} (pkill exit ${kill_rc})."
            return 1
        fi
        kill_rc=0
        pkill -KILL -u "$BUILDER_UID" >/dev/null 2>&1 || kill_rc=$?
        if [[ "$kill_rc" -ne 0 && "$kill_rc" -ne 1 ]]; then
            log_error "Failed to terminate builder processes by effective UID ${BUILDER_UID} (pkill exit ${kill_rc})."
            return 1
        fi
        sleep "${AF_BUILDER_QUIESCE_SLEEP:-0.1}"
    done
    pgrep_rc=0
    pgrep -U "$BUILDER_UID" >/dev/null 2>&1 || pgrep_rc=$?
    if [[ "$pgrep_rc" -eq 1 ]]; then
        pgrep_rc=0
        pgrep -u "$BUILDER_UID" >/dev/null 2>&1 || pgrep_rc=$?
        if [[ "$pgrep_rc" -eq 1 ]]; then
            return 0
        fi
    fi
    if [[ "$pgrep_rc" -ne 0 && "$pgrep_rc" -ne 1 ]]; then
        log_error "Failed to query active builder processes for UID ${BUILDER_UID} (pgrep exit ${pgrep_rc})."
        return 1
    fi
    log_error "Timed out waiting for builder processes (UID ${BUILDER_UID}) to terminate."
    return 1
}

quarantine_builder_workspace() {
    if [[ -z "$BUILD_ROOT" || ! -e "$BUILD_ROOT" ]]; then
        return 0
    fi
    python3 - "$BUILD_ROOT" <<'PY' >/dev/null 2>&1 || true
import os, stat, sys
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
root_fd = os.open(sys.argv[1], dir_flags)
try:
    st = os.fstat(root_fd)
    if stat.S_ISDIR(st.st_mode):
        if os.geteuid() == 0:
            os.fchown(root_fd, 0, 0)
        os.fchmod(root_fd, 0o700)
finally:
    os.close(root_fd)
PY
}

cleanup() {
    local status=$? restore_failed=false
    local builder_cleanup_ok=1
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 && "$SERVICE_STOPPED" -eq 1 ]]; then
        log_error "Maintainerr activation failed; restoring the previous installation from ${BACKUP_DIR}."
        quiesce_services_for_rollback af-maintainerr || { restore_failed=true; exit 1; }
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/maintainerr "$BACKUP_DIR/failed-app" || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/maintainerr || restore_failed=true
        fi
        if [[ "$DATA_SAVED" -eq 1 && "$APP_ACTIVATED" -eq 1 ]]; then
            restore_app_state "$BACKUP_DIR" || restore_failed=true
            chown -hRP maintainerr:maintainerr /var/lib/maintainerr
            chmod 750 /var/lib/maintainerr
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            if [[ -f "$BACKUP_DIR/af-maintainerr.service" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/af-maintainerr.service" /etc/systemd/system/af-maintainerr.service || restore_failed=true
            else
                rm -f /etc/systemd/system/af-maintainerr.service || restore_failed=true
            fi
            safe_restore_path_from_backup "$BACKUP_DIR/af-maintainerr.service.d" /etc/systemd/system/af-maintainerr.service.d || restore_failed=true
            systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
        if [[ "$restore_failed" == false && "$WAS_ACTIVE" -eq 1 ]]; then
            systemctl start af-maintainerr >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    elif [[ "$SUCCESS" -ne 1 && -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
        rm -rf "$BACKUP_DIR" || restore_failed=true
    fi
    if [[ "$BUILD_USER_CREATED" -eq 1 ]]; then
        if ! quiesce_builder_processes; then
            builder_cleanup_ok=0
            quarantine_builder_workspace
            log_error "Retaining builder identity ${BUILD_USER} (UID ${BUILDER_UID:-unresolved}) and workspace ${BUILD_ROOT:-none} because process quiescence could not be verified. Inspect and terminate remaining processes for UID ${BUILDER_UID:-unresolved}, then remove ${BUILD_USER} and ${BUILD_ROOT:-/opt/.maintainerr-build.*} manually."
        else
            if id -u "$BUILD_USER" >/dev/null 2>&1; then
                if ! userdel "$BUILD_USER" >> "$LOGFILE" 2>&1; then
                    builder_cleanup_ok=0
                    quarantine_builder_workspace
                    log_error "Failed to remove quiescent builder user ${BUILD_USER}; retaining identity and workspace ${BUILD_ROOT:-none} for manual cleanup."
                fi
            fi
            if [[ "$builder_cleanup_ok" -eq 1 ]] && getent group "$BUILD_USER" >/dev/null 2>&1; then
                if ! groupdel "$BUILD_USER" >> "$LOGFILE" 2>&1; then
                    builder_cleanup_ok=0
                    quarantine_builder_workspace
                    log_error "Failed to remove quiescent builder group ${BUILD_USER}; retaining workspace ${BUILD_ROOT:-none} for manual cleanup."
                fi
            fi
            if [[ "$builder_cleanup_ok" -eq 1 ]] && { id -u "$BUILD_USER" >/dev/null 2>&1 || getent group "$BUILD_USER" >/dev/null 2>&1; }; then
                builder_cleanup_ok=0
                quarantine_builder_workspace
                log_error "Builder identity ${BUILD_USER} still exists after cleanup; retaining workspace ${BUILD_ROOT:-none} for manual cleanup."
            fi
            if [[ "$builder_cleanup_ok" -eq 1 ]]; then
                BUILD_USER_CREATED=0
            fi
        fi
    fi
    if [[ "$builder_cleanup_ok" -eq 1 ]]; then
        if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
            rm -rf "$BUILD_DIR" || restore_failed=true
        fi
        if [[ -n "$BUILD_ROOT" && -d "$BUILD_ROOT" ]]; then
            rm -rf "$BUILD_ROOT" || restore_failed=true
        fi
    elif [[ "$status" -eq 0 ]]; then
        status=1
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $BACKUP_DIR"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ! SANDBOX_HELPER="$(resolve_sandbox_helper)"; then
    log_error "Unable to locate readable af-systemd-sandbox helper."
    exit 1
fi

report_progress 10 "Installing Maintainerr native build prerequisites..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl git ca-certificates build-essential python3 python3-setuptools xz-utils pkg-config libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev >> "$LOGFILE" 2>&1

LATEST_TAG="$(github_latest_tag "Maintainerr/Maintainerr" "" false)"
if [[ ! "$LATEST_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    log_error "Unable to resolve a stable Maintainerr release."
    exit 1
fi

if ! id -u maintainerr >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/maintainerr --shell /usr/sbin/nologin maintainerr
fi
mkdir -p /var/lib/maintainerr /var/backups /etc/systemd/system
chown -hRP maintainerr:maintainerr /var/lib/maintainerr
chmod 750 /var/lib/maintainerr

if id -u "$BUILD_USER" >/dev/null 2>&1 || getent group "$BUILD_USER" >/dev/null 2>&1; then
    log_error "Refusing to reuse pre-existing ${BUILD_USER} user or group."
    exit 1
fi
useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$BUILD_USER"
BUILD_USER_CREATED=1
BUILDER_UID="$(id -u "$BUILD_USER")"
BUILDER_GID="$(id -g "$BUILD_USER")"
if [[ ! "$BUILDER_UID" =~ ^[0-9]+$ ]] || [[ ! "$BUILDER_GID" =~ ^[0-9]+$ ]] || (( 10#$BUILDER_UID <= 0 || 10#$BUILDER_GID <= 0 )); then
    log_error "Invalid UID/GID resolved for ${BUILD_USER}."
    exit 1
fi

report_progress 25 "Fetching Maintainerr ${LATEST_TAG} into an unprivileged build workspace..."
BUILD_ROOT="$(mktemp -d /opt/.maintainerr-build.XXXXXX)"
BUILD_DIR="$BUILD_ROOT/app"
python3 - "$BUILD_ROOT" "$BUILDER_UID" "$BUILDER_GID" <<'PY'
import os, stat, sys

build_root = sys.argv[1]
builder_uid = int(sys.argv[2])
builder_gid = int(sys.argv[3])
is_root = os.geteuid() == 0
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)

root_fd = os.open(build_root, dir_flags)
try:
    st = os.fstat(root_fd)
    if not stat.S_ISDIR(st.st_mode):
        raise SystemExit("Build root is not a directory")
    if is_root:
        os.fchown(root_fd, 0, builder_gid)
    os.fchmod(root_fd, 0o750)
    for sub in ("app", "home", "cache", "config", "data", "tmp"):
        os.mkdir(sub, 0o700, dir_fd=root_fd)
        sub_fd = os.open(sub, dir_flags, dir_fd=root_fd)
        try:
            if is_root:
                os.fchown(sub_fd, builder_uid, builder_gid)
            os.fchmod(sub_fd, 0o700)
        finally:
            os.close(sub_fd)
finally:
    os.close(root_fd)
PY

case "$(uname -m)" in
    x86_64) NODE_ARCH=x64 ;;
    aarch64|arm64) NODE_ARCH=arm64 ;;
    *) log_error "Unsupported Node.js architecture: $(uname -m)"; exit 1 ;;
esac
curl --fail --silent --show-error --location https://nodejs.org/dist/latest-v26.x/SHASUMS256.txt -o "$BUILD_ROOT/node-shasums.txt"
NODE_ARCHIVE="$(awk -v suffix="-linux-${NODE_ARCH}.tar.xz" 'index($2, suffix) && substr($2, length($2)-length(suffix)+1) == suffix {print $2}' "$BUILD_ROOT/node-shasums.txt")"
if [[ ! "$NODE_ARCHIVE" =~ ^node-v26\.[0-9]+\.[0-9]+-linux-(x64|arm64)\.tar\.xz$ ]]; then
    log_error "Unable to resolve the private Node.js 26 runtime."
    exit 1
fi
download_file "https://nodejs.org/dist/latest-v26.x/${NODE_ARCHIVE}" "$BUILD_ROOT/$NODE_ARCHIVE"
python3 - "$BUILD_ROOT" "$NODE_ARCHIVE" <<'PY'
import os, stat, sys
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
file_flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
rfd = os.open(sys.argv[1], dir_flags)
try:
    ffd = os.open(sys.argv[2], file_flags, dir_fd=rfd)
    try:
        st = os.fstat(ffd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise SystemExit("Invalid Node runtime archive")
        os.fchmod(ffd, 0o644)
    finally:
        os.close(ffd)
finally:
    os.close(rfd)
PY
(cd "$BUILD_ROOT" && grep -F "  ${NODE_ARCHIVE}" node-shasums.txt | sha256sum --check --status)

run_as_builder git -c core.hooksPath=/dev/null clone --depth 1 --branch "$LATEST_TAG" https://github.com/Maintainerr/Maintainerr.git "$BUILD_DIR" >> "$LOGFILE" 2>&1
quiesce_builder_processes
if [[ -L "$BUILD_DIR" || -e "$BUILD_DIR/.runtime" || -L "$BUILD_DIR/.runtime" ]]; then
    log_error "Unexpected .runtime path in Maintainerr source tree."
    exit 1
fi
run_as_builder mkdir "$BUILD_DIR/.runtime"
run_as_builder tar -xJf "$BUILD_ROOT/$NODE_ARCHIVE" --strip-components=1 --no-same-owner --no-same-permissions -C "$BUILD_DIR/.runtime"
quiesce_builder_processes
rm -f "$BUILD_ROOT/$NODE_ARCHIVE" "$BUILD_ROOT/node-shasums.txt"
run_as_builder "$BUILD_DIR/.runtime/bin/node" -e 'if (Number(process.versions.node.split(".")[0]) !== 26) process.exit(1)'
quiesce_builder_processes

read -r YARN_PACKAGE SOURCE_VERSION < <(python3 - "$BUILD_ROOT" "${LATEST_TAG#v}" <<'PY'
import json, os, re, stat, sys

build_root = sys.argv[1]
expected_version = sys.argv[2]
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
file_flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)

def open_subdir(parent_fd, name):
    return os.open(name, dir_flags, dir_fd=parent_fd)

try:
    root_fd = os.open(build_root, dir_flags)
except OSError:
    sys.exit(1)

try:
    app_fd = open_subdir(root_fd, "app")
    try:
        pkg_fd = os.open("package.json", file_flags, dir_fd=app_fd)
        with os.fdopen(pkg_fd, "r", encoding="utf-8") as fh:
            st = os.fstat(fh.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size <= 0 or st.st_size > 1048576:
                sys.exit(1)
            data = json.load(fh)
        if not isinstance(data, dict):
            sys.exit(1)
        pm = data.get("packageManager", "")
        ver = data.get("version", "")
        if not isinstance(pm, str) or not isinstance(ver, str):
            sys.exit(1)
        if any(ch in pm or ch in ver for ch in (" ", "\t", "\n", "\r")):
            sys.exit(1)
        if not re.fullmatch(r"yarn@4\.[0-9]+\.[0-9]+", pm) or ver != expected_version:
            print(f"{pm} {ver}")
            sys.exit(0)
        yarn_ver = pm.split("@", 1)[1]
        yarn_dir_fd = open_subdir(app_fd, ".yarn")
        try:
            releases_fd = open_subdir(yarn_dir_fd, "releases")
            try:
                yfd = os.open(f"yarn-{yarn_ver}.cjs", file_flags, dir_fd=releases_fd)
                try:
                    yst = os.fstat(yfd)
                    if not stat.S_ISREG(yst.st_mode) or yst.st_nlink != 1 or yst.st_size <= 0:
                        sys.exit(1)
                finally:
                    os.close(yfd)
            finally:
                os.close(releases_fd)
        finally:
            os.close(yarn_dir_fd)
        print(f"{pm} {ver}")
    finally:
        os.close(app_fd)
except Exception:
    sys.exit(1)
finally:
    os.close(root_fd)
PY
) || {
    log_error "Unable to parse Maintainerr package.json metadata."
    exit 1
}
if [[ ! "$YARN_PACKAGE" =~ ^yarn@4\.[0-9]+\.[0-9]+$ ]]; then
    log_error "Unsupported Maintainerr package manager: ${YARN_PACKAGE}"
    exit 1
fi
if [[ "$SOURCE_VERSION" != "${LATEST_TAG#v}" ]]; then
    log_error "Maintainerr source version does not match ${LATEST_TAG}."
    exit 1
fi
YARN_RELEASE="$BUILD_DIR/.yarn/releases/yarn-${YARN_PACKAGE#yarn@}.cjs"
if [[ -L "$YARN_RELEASE" || ! -s "$YARN_RELEASE" ]]; then
    log_error "Missing or invalid bundled Yarn release: ${YARN_RELEASE}"
    exit 1
fi

report_progress 45 "Building Maintainerr ${LATEST_TAG} as ${BUILD_USER} while the installed service stays online..."
run_as_builder /bin/bash -e -c '
    cd "$1"
    printf "\nVITE_BASE_PATH=/\n" >> apps/ui/.env
    node "$2" install --immutable
    node "$2" turbo build
    node "$2" workspaces focus --all --production
    test -s apps/server/dist/main.js
    test -s apps/ui/dist/index.html
    test -s packages/contracts/dist/index.js
    mkdir -p apps/server/dist/ui apps/server/dist/assets
    cp -a apps/ui/dist/. apps/server/dist/ui/
    cp -a apps/server/assets/. apps/server/dist/assets/
' -- "$BUILD_DIR" "$YARN_RELEASE" >> "$LOGFILE" 2>&1

if [[ "$BUILD_USER_CREATED" -eq 1 ]]; then
    quiesce_builder_processes
fi

python3 - "$BUILD_ROOT" "${LATEST_TAG#v}" <<'PY'
import os, pathlib, stat, sys

build_root = sys.argv[1]
version = sys.argv[2]
is_root = os.geteuid() == 0
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
file_flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)

try:
    root_fd = os.open(build_root, dir_flags)
except OSError as exc:
    raise SystemExit(f"Invalid build workspace root: {exc}")

try:
    root_st = os.fstat(root_fd)
    if not stat.S_ISDIR(root_st.st_mode):
        raise SystemExit("Build workspace root is not a directory")
    if is_root and root_st.st_uid != 0:
        raise SystemExit("Untrusted build workspace root owner")
    if is_root:
        os.fchown(root_fd, 0, 0)
    os.fchmod(root_fd, 0o700)

    try:
        app_fd = os.open("app", dir_flags, dir_fd=root_fd)
    except OSError as exc:
        raise SystemExit(f"Invalid build directory: {exc}")

    try:
        app_st = os.fstat(app_fd)
        if not stat.S_ISDIR(app_st.st_mode):
            raise SystemExit("Build app path is not a directory")

        required = [
            (".runtime", "bin", "node"),
            ("apps", "server", "dist", "main.js"),
            ("apps", "server", "dist", "ui", "index.html"),
            ("packages", "contracts", "dist", "index.js"),
        ]
        for parts in required:
            cur_fd = os.dup(app_fd)
            try:
                for part in parts[:-1]:
                    try:
                        next_fd = os.open(part, dir_flags, dir_fd=cur_fd)
                    except OSError as exc:
                        raise SystemExit(f"Refusing symlink or missing directory in required artifact path: {part} ({exc})")
                    os.close(cur_fd)
                    cur_fd = next_fd
                leaf = parts[-1]
                try:
                    lfd = os.open(leaf, file_flags, dir_fd=cur_fd)
                except OSError as exc:
                    raise SystemExit(f"Refusing symlink or missing required build artifact: {'/'.join(parts)} ({exc})")
                try:
                    lst = os.fstat(lfd)
                    if not stat.S_ISREG(lst.st_mode) or lst.st_nlink != 1 or lst.st_size <= 0:
                        raise SystemExit(f"Invalid or empty required build artifact: {'/'.join(parts)}")
                finally:
                    os.close(lfd)
            finally:
                os.close(cur_fd)

        def check_symlink_target(rel_dir_parts, name, raw_target):
            if not raw_target or os.path.isabs(raw_target):
                raise SystemExit(f"Symlink escapes build directory: {'/'.join((*rel_dir_parts, name))} -> {raw_target}")
            resolved = list(rel_dir_parts)
            for comp in pathlib.PurePosixPath(raw_target).parts:
                if comp in ("", "."):
                    continue
                if comp == "..":
                    if not resolved:
                        raise SystemExit(f"Symlink escapes build directory: {'/'.join((*rel_dir_parts, name))} -> {raw_target}")
                    resolved.pop()
                else:
                    resolved.append(comp)

        for rel_root, dirs, files, cur_dir_fd in os.fwalk(top=".", dir_fd=app_fd, topdown=True, follow_symlinks=False):
            rel_parts = tuple(p for p in pathlib.PurePosixPath(rel_root).parts if p not in ("", "."))
            dir_st = os.fstat(cur_dir_fd)
            if not stat.S_ISDIR(dir_st.st_mode):
                raise SystemExit(f"Non-directory encountered during traversal: {rel_root}")
            if is_root:
                os.fchown(cur_dir_fd, 0, 0)
            os.fchmod(cur_dir_fd, 0o755)

            kept_dirs = []
            for dname in dirs:
                dst = os.stat(dname, dir_fd=cur_dir_fd, follow_symlinks=False)
                if stat.S_ISLNK(dst.st_mode):
                    if dst.st_nlink != 1:
                        raise SystemExit(f"Refusing multi-linked symlink in build tree: {rel_root}/{dname}")
                    raw_target = os.readlink(dname, dir_fd=cur_dir_fd)
                    check_symlink_target(rel_parts, dname, raw_target)
                    if is_root:
                        os.chown(dname, 0, 0, dir_fd=cur_dir_fd, follow_symlinks=False)
                elif stat.S_ISDIR(dst.st_mode):
                    kept_dirs.append(dname)
                else:
                    raise SystemExit(f"Refusing special directory entry in build tree: {rel_root}/{dname}")
            dirs[:] = kept_dirs

            for fname in files:
                fst = os.stat(fname, dir_fd=cur_dir_fd, follow_symlinks=False)
                if stat.S_ISLNK(fst.st_mode):
                    if fst.st_nlink != 1:
                        raise SystemExit(f"Refusing multi-linked symlink in build tree: {rel_root}/{fname}")
                    raw_target = os.readlink(fname, dir_fd=cur_dir_fd)
                    check_symlink_target(rel_parts, fname, raw_target)
                    if is_root:
                        os.chown(fname, 0, 0, dir_fd=cur_dir_fd, follow_symlinks=False)
                elif stat.S_ISREG(fst.st_mode):
                    if fst.st_nlink != 1:
                        raise SystemExit(f"Refusing multi-linked file in build tree: {rel_root}/{fname}")
                    ffd = os.open(fname, file_flags, dir_fd=cur_dir_fd)
                    try:
                        ost = os.fstat(ffd)
                        if not stat.S_ISREG(ost.st_mode) or ost.st_nlink != 1 or ost.st_ino != fst.st_ino or ost.st_dev != fst.st_dev:
                            raise SystemExit(f"Artifact changed or multi-linked during validation: {rel_root}/{fname}")
                        if is_root:
                            os.fchown(ffd, 0, 0)
                        mode = 0o755 if ost.st_mode & 0o111 else 0o644
                        os.fchmod(ffd, mode)
                    finally:
                        os.close(ffd)
                else:
                    raise SystemExit(f"Refusing special file in build tree: {rel_root}/{fname}")

        try:
            os.unlink(".af-version", dir_fd=app_fd)
        except FileNotFoundError:
            pass
    finally:
        os.close(app_fd)
finally:
    os.close(root_fd)
PY

