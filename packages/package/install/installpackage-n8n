#!/bin/bash
# AetherFlow Package Installer: n8n
# Port: 5678

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="n8n"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-5678}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Setting up Node.js runtime and build prerequisites for n8n..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl ca-certificates build-essential python3 python3-setuptools >> "$LOGFILE" 2>&1

ensure_node 24

if ! id -u n8n >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/n8n --shell /usr/sbin/nologin n8n
fi

mkdir -p /var/lib/n8n /opt/n8n

report_progress 40 "Installing n8n with its complete dependency build toolchain..."
NODE_MAJOR="$(node -v 2>/dev/null | sed 's/^v//' | cut -d. -f1 || echo 20)"
if [[ ! "$NODE_MAJOR" =~ ^[0-9]+$ ]] || (( NODE_MAJOR < 24 )); then
    print_error "n8n requires Node.js >= 24; refusing to install an incompatible release channel."
    exit 1
fi
TARGET_PKG="n8n"
TARGET_VER="${AF_PACKAGE_VERSION:-${AETHERFLOW_PACKAGE_VERSION:-${AF_TARGET_VERSION:-}}}"
if [[ -n "$TARGET_VER" ]]; then
    TARGET_VER="${TARGET_VER#v}"
    TARGET_MAJOR="$(printf '%s' "$TARGET_VER" | cut -d. -f1)"
    if [[ "${NODE_MAJOR:-20}" -lt 24 && "$TARGET_MAJOR" -ge 2 ]]; then
        print_error "n8n ${TARGET_VER} requires Node.js >= 24; current runtime is Node ${NODE_MAJOR}."
        exit 1
    fi
    TARGET_PKG="n8n@${TARGET_VER}"

fi
install_npm_app "$TARGET_PKG" /opt/n8n /usr/local/bin/n8n

N8N_VER="$(/usr/local/bin/n8n --version 2>/dev/null || true)"
if [[ -n "$N8N_VER" ]]; then
    printf '%s\n' "${N8N_VER#v}" > /var/lib/n8n/.af-version
fi

chown -R n8n:n8n /var/lib/n8n /opt/n8n

NODE_PATH="$(command -v node || echo /usr/bin/node)"
N8N_BIN=/usr/local/bin/n8n

report_progress 85 "Configuring and starting n8n.service on port ${APP_PORT}..."
cat <<EOF > /etc/systemd/system/n8n.service
[Unit]
Description=n8n - Workflow Automation Tool
After=network.target

[Service]
Type=simple
User=n8n
Group=n8n
Environment=N8N_PORT=${APP_PORT}
Environment=N8N_LISTEN_ADDRESS=0.0.0.0
Environment=N8N_USER_FOLDER=/var/lib/n8n
Environment=N8N_PROXY_HOPS=1
Environment=N8N_SECURE_COOKIE=false
Environment=NODE_ENV=production
ExecStart=${NODE_PATH} ${N8N_BIN}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now n8n >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "n8n installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
