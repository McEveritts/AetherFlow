#!/bin/bash
# AetherFlow Package Installer: Scrutiny
# Port: 8098

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="scrutiny"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8098}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing SMART drive telemetry utilities and libraries..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl smartmontools udev ca-certificates >> "$LOGFILE" 2>&1

if ! id -u scrutiny >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/scrutiny --shell /usr/sbin/nologin scrutiny
fi

mkdir -p /opt/scrutiny/bin /var/lib/scrutiny /etc/scrutiny

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) SCRUT_ARCH="amd64" ;;
    arm64) SCRUT_ARCH="arm64" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Scrutiny binaries from GitHub..."
SCRUT_VER="$(github_latest_tag "AnalogJ/scrutiny" "0.8.1")"

WEB_URL="https://github.com/AnalogJ/scrutiny/releases/download/v${SCRUT_VER}/scrutiny-web-linux-${SCRUT_ARCH}"
COLLECTOR_URL="https://github.com/AnalogJ/scrutiny/releases/download/v${SCRUT_VER}/scrutiny-collector-metrics-linux-${SCRUT_ARCH}"

report_progress 60 "Downloading Scrutiny Web UI and Collector binaries..."
BUILD_DIR="$(mktemp -d /opt/.scrutiny-build.XXXXXX)"
trap 'rm -rf -- "$BUILD_DIR"' EXIT
mkdir "$BUILD_DIR/bin"
download_file "$WEB_URL" "$BUILD_DIR/bin/scrutiny-web-linux-${SCRUT_ARCH}" >> "$LOGFILE" 2>&1
download_file "$COLLECTOR_URL" "$BUILD_DIR/bin/scrutiny-collector-metrics-linux-${SCRUT_ARCH}" >> "$LOGFILE" 2>&1
test -s "$BUILD_DIR/bin/scrutiny-web-linux-${SCRUT_ARCH}"
test -s "$BUILD_DIR/bin/scrutiny-collector-metrics-linux-${SCRUT_ARCH}"
chmod +x "$BUILD_DIR/bin/"*
stage_app_archive "$BUILD_DIR" /opt/scrutiny "bin/scrutiny-web-linux-${SCRUT_ARCH}" /etc/scrutiny "$PACKAGE_NAME" "." /var/lib/scrutiny

chmod +x "/opt/scrutiny/bin/scrutiny-web-linux-${SCRUT_ARCH}" \
         "/opt/scrutiny/bin/scrutiny-collector-metrics-linux-${SCRUT_ARCH}"

ln -sfn "/opt/scrutiny/bin/scrutiny-web-linux-${SCRUT_ARCH}" /opt/scrutiny/bin/scrutiny-web
ln -sfn "/opt/scrutiny/bin/scrutiny-collector-metrics-linux-${SCRUT_ARCH}" /opt/scrutiny/bin/scrutiny-collector

# Ensure amd64 path exists for version_command compatibility on all systems
if [[ "$SCRUT_ARCH" != "amd64" ]]; then
    ln -sfn "/opt/scrutiny/bin/scrutiny-web-linux-${SCRUT_ARCH}" /opt/scrutiny/bin/scrutiny-web-linux-amd64
fi

queue_app_version /opt/scrutiny/.af-version "${SCRUT_VER#v}"

validate_config_paths /etc/scrutiny/scrutiny.yaml
if [[ ! -s /etc/scrutiny/scrutiny.yaml ]]; then
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' | write_config_file /etc/scrutiny/scrutiny.yaml
version: 1
web:
  listen:
    port: @AF_APP_PORT@
    host: "127.0.0.1"
  database:
    location: /var/lib/scrutiny/scrutiny.db
EOF
fi
safe_config_python /etc/scrutiny/scrutiny.yaml "$APP_PORT" <<'PYEOF'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
with ManagedConfig(path) as config:
    lines = config.read_text().splitlines(keepends=True)
    if lines and not lines[-1].endswith('\n'):
        lines[-1] += '\n'
    parents = []
    changed = False
    for index, line in enumerate(lines):
        match = re.match(r'^( *)([^\s:#][^:#]*):(?:\s|$)', line)
        if not match:
            continue
        indent, key = len(match.group(1)), match.group(2).strip()
        while parents and parents[-1][0] >= indent:
            parents.pop()
        if [entry[1] for entry in parents] + [key] == ['web', 'listen', 'port']:
            lines[index] = match.group(1) + 'port: ' + sys.argv[2] + '\n'
            changed = True
        parents.append((indent, key))
    if not changed:
        web = next((index for index, line in enumerate(lines) if re.match(r'^web:\s*(?:#.*)?$', line.rstrip('\n'))), None)
        if web is None:
            if any(re.match(r'^web\s*:', line) for line in lines):
                raise ValueError('Unsupported inline Scrutiny web mapping')
            lines.extend(['\n', 'web:\n', '  listen:\n', '    port: ' + sys.argv[2] + '\n'])
        else:
            web_end = next((index for index in range(web + 1, len(lines)) if re.match(r'^[^\s#]', lines[index])), len(lines))
            listen = next((index for index in range(web + 1, web_end) if re.match(r'^ +listen:\s*(?:#.*)?$', lines[index].rstrip('\n'))), None)
            if listen is None:
                if any(re.match(r'^ +listen:', line) for line in lines[web + 1:web_end]):
                    raise ValueError('Unsupported inline Scrutiny listen mapping')
                lines[web_end:web_end] = ['  listen:\n', '    port: ' + sys.argv[2] + '\n']
            else:
                indent = len(lines[listen]) - len(lines[listen].lstrip(' '))
                listen_end = next((index for index in range(listen + 1, web_end) if lines[index].strip() and not lines[index].lstrip().startswith('#') and len(lines[index]) - len(lines[index].lstrip(' ')) <= indent), web_end)
                lines[listen_end:listen_end] = [' ' * (indent + 2) + 'port: ' + sys.argv[2] + '\n']
    config.write_text(''.join(lines))
PYEOF

chown -hRP scrutiny:scrutiny /opt/scrutiny /var/lib/scrutiny /etc/scrutiny

report_progress 80 "Configuring scrutiny.service, collector service, and timer..."
cat <<EOF > /etc/systemd/system/scrutiny.service
[Unit]
Description=Scrutiny SMART Hard Drive Telemetry Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=scrutiny
Group=scrutiny
Type=simple
WorkingDirectory=/opt/scrutiny
ExecStart=/opt/scrutiny/bin/scrutiny-web start --config /etc/scrutiny/scrutiny.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /etc/systemd/system/scrutiny-collector.service
[Unit]
Description=Scrutiny SMART Metrics Collector
After=network.target scrutiny.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/scrutiny/bin/scrutiny-collector run --api-endpoint "http://127.0.0.1:@AF_APP_PORT@"
EOF

cat <<'EOF' > /etc/systemd/system/scrutiny-collector.timer
[Unit]
Description=Hourly Scrutiny SMART Metrics Collection Timer

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now scrutiny >> "$LOGFILE" 2>&1
systemctl enable --now scrutiny-collector.timer >> "$LOGFILE" 2>&1
systemctl restart scrutiny >> "$LOGFILE" 2>&1
systemctl is-active --quiet scrutiny-collector.timer
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Scrutiny installed on port ${APP_PORT} (companion collector timer active)."
log_info "${PACKAGE_NAME} installed successfully"
