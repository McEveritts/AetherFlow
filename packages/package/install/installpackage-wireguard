#!/bin/bash
# AetherFlow Package Installer: WireGuard VPN
# Port: 51820/udp

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="wireguard"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing WireGuard and networking tools..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq wireguard wireguard-tools qrencode iptables iproute2 curl >> "$LOGFILE" 2>&1

report_progress 45 "Generating WireGuard server and client keys..."
mkdir -p /etc/wireguard
chmod 700 /etc/wireguard

umask 077
wg genkey | tee /etc/wireguard/server_private.key | wg pubkey > /etc/wireguard/server_public.key
wg genkey | tee /etc/wireguard/client_private.key | wg pubkey > /etc/wireguard/client_public.key

SERVER_PRIV="$(cat /etc/wireguard/server_private.key)"
SERVER_PUB="$(cat /etc/wireguard/server_public.key)"
CLIENT_PRIV="$(cat /etc/wireguard/client_private.key)"
CLIENT_PUB="$(cat /etc/wireguard/client_public.key)"

DEFAULT_IFACE="$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}' || true)"
DEFAULT_IFACE="${DEFAULT_IFACE:-eth0}"

report_progress 70 "Writing /etc/wireguard/wg0.conf and enabling IP forwarding..."
cat <<EOF > /etc/wireguard/wg0.conf
[Interface]
Address = 10.66.66.1/24
ListenPort = 51820
PrivateKey = ${SERVER_PRIV}
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -o ${DEFAULT_IFACE} -j MASQUERADE

[Peer]
PublicKey = ${CLIENT_PUB}
AllowedIPs = 10.66.66.2/32
EOF
chmod 600 /etc/wireguard/wg0.conf

PUBLIC_IP="$(curl -fsSL --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo 127.0.0.1)"
cat <<EOF > /etc/wireguard/client.conf
[Interface]
PrivateKey = ${CLIENT_PRIV}
Address = 10.66.66.2/24
DNS = 1.1.1.1, 8.8.8.8

[Peer]
PublicKey = ${SERVER_PUB}
Endpoint = ${PUBLIC_IP}:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
EOF
chmod 600 /etc/wireguard/client.conf

mkdir -p /etc/sysctl.d
cat <<'EOF' > /etc/sysctl.d/99-wireguard.conf
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
sysctl --system >> "$LOGFILE" 2>&1 || true

report_progress 90 "Starting wg-quick@wg0 service..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable wg-quick@wg0 >> "$LOGFILE" 2>&1 || true
systemctl restart wg-quick@wg0 >> "$LOGFILE" 2>&1 || true

write_lock "${PACKAGE_NAME}"
report_progress 100 "WireGuard VPN installed on UDP port 51820."
log_info "${PACKAGE_NAME} installed successfully"
