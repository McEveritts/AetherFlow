#!/bin/bash
#
# [AetherFlow Install Script - Duplicati]
# Installs Duplicati 2.x native backup server on bare-metal Debian/Ubuntu.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="duplicati"
APP_NAME="duplicati"
APP_USER="duplicati"
DATA_DIR="/var/lib/duplicati"
CONFIG_DIR="/etc/duplicati"
SERVICE_FILE="/etc/systemd/system/duplicati.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8200}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_PASS="${MASTER_PASS}"

report_progress 20 "Installing Mono runtime, SQLite, and network utilities..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq ca-certificates apt-transport-https libicu-dev sqlite3 >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${DATA_DIR}" "${CONFIG_DIR}"

report_progress 45 "Resolving latest Duplicati release from GitHub..."
RELEASES_JSON="$(curl -fsSL https://api.github.com/repos/duplicati/duplicati/releases/latest 2>/dev/null || true)"
LATEST_TAG="$(echo "${RELEASES_JSON}" | jq -r '.tag_name // empty' || true)"
if [[ -z "${LATEST_TAG}" ]]; then
    LATEST_TAG="v2.0.8.1-2.0.8.1_beta_2024-05-07"
fi

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
    amd64) D_ARCH="linux-x64" ;;
    arm64) D_ARCH="linux-arm64" ;;
    armhf) D_ARCH="linux-arm7" ;;
    *) D_ARCH="all" ;;
esac

DEB_URL="$(echo "${RELEASES_JSON}" | jq -r --arg arch "${D_ARCH}.deb" '.assets[]? | select(.name | endswith($arch)) | .browser_download_url' | head -n1 || true)"
if [[ -z "${DEB_URL}" ]]; then
    DEB_URL="$(echo "${RELEASES_JSON}" | jq -r '.assets[]? | select(.name | endswith(".deb")) | .browser_download_url' | head -n1 || true)"
fi

if [[ -z "${DEB_URL}" ]]; then
    DEB_URL="https://github.com/duplicati/duplicati/releases/download/${LATEST_TAG}/duplicati_${LATEST_TAG#v}_all.deb"
fi

report_progress 65 "Downloading Duplicati package (${LATEST_TAG})..."
TMP_DEB="$(mktemp --suffix=.deb)"
wget -qO "${TMP_DEB}" "${DEB_URL}" >> "$LOGFILE" 2>&1 || curl -fsSL -o "${TMP_DEB}" "${DEB_URL}" >> "$LOGFILE" 2>&1

report_progress 75 "Installing Duplicati deb package..."
dpkg -i "${TMP_DEB}" >> "$LOGFILE" 2>&1 || {
    DEBIAN_FRONTEND=noninteractive apt-get install -f -y >> "$LOGFILE" 2>&1
}
rm -f "${TMP_DEB}"

echo "${LATEST_TAG#v}" > "${DATA_DIR}/.af-version"

if [[ ! -f "${CONFIG_DIR}/duplicati.env" ]]; then
    cat > "${CONFIG_DIR}/duplicati.env" <<EOF
DUPLICATI_PASS=${ADMIN_PASS}
DUPLICATI_PORT=${APP_PORT}
EOF
else
    sed -i "s|^DUPLICATI_PORT=.*|DUPLICATI_PORT=${APP_PORT}|" "${CONFIG_DIR}/duplicati.env" || true
fi
chmod 600 "${CONFIG_DIR}/duplicati.env"
chown -R "${APP_USER}:${APP_USER}" "${DATA_DIR}" "${CONFIG_DIR}"

SERVER_BIN="/usr/bin/duplicati-server"
if [[ ! -x "${SERVER_BIN}" && -x "/usr/lib/duplicati/duplicati-server" ]]; then
    SERVER_BIN="/usr/lib/duplicati/duplicati-server"
fi

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Duplicati Backup Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
EnvironmentFile=${CONFIG_DIR}/duplicati.env
ExecStart=${SERVER_BIN} --webservice-port=${APP_PORT} --webservice-interface=any --webservice-password=\${DUPLICATI_PASS} --webservice-allowed-hostnames=* --server-datafolder=${DATA_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now duplicati.service >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
