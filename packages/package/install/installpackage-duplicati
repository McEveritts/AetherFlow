#!/bin/bash
#
# [AetherFlow Install Script - Duplicati]
# Installs Duplicati 2.x native backup server on bare-metal Debian/Ubuntu.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
validate_config_paths /etc/duplicati/duplicati.env

PACKAGE_NAME="duplicati"
APP_NAME="duplicati"
APP_USER="duplicati"
DATA_DIR="/var/lib/duplicati"
CONFIG_DIR="/etc/duplicati"
SERVICE_FILE="/etc/systemd/system/duplicati.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8200}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_PASS="${MASTER_PASS}"

report_progress 20 "Installing Mono runtime, SQLite, and network utilities..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq ca-certificates apt-transport-https libicu-dev sqlite3 >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${DATA_DIR}" "${CONFIG_DIR}"

BACKUP_DIR="$(mktemp -d /tmp/af-duplicati-runtime-XXXXXX)"
RUNTIME_PATHS=("$CONFIG_DIR" "$DATA_DIR" "$SERVICE_FILE" "/usr/bin/duplicati-server" "/usr/lib/duplicati" "/usr/share/duplicati" "/etc/default/duplicati")
RUNTIME_HAD_PREVIOUS=0
RUNTIME_WAS_ACTIVE=0
RUNTIME_QUIESCE_STARTED=0
RUNTIME_MUTATED=0
if systemctl is-active --quiet duplicati.service 2>/dev/null; then RUNTIME_WAS_ACTIVE=1; fi
if [[ -f "$SERVICE_FILE" || -f "${CONFIG_DIR}/duplicati.env" || -f "${DATA_DIR}/.af-version" || "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
    RUNTIME_HAD_PREVIOUS=1
fi
rollback_runtime() {
    local status=$? runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback duplicati.service || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$BACKUP_DIR/$runtime_index" "$runtime_path" || restore_failed=true
        done
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" -eq 1 ]]; then
            if [[ "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
                systemctl restart duplicati.service >> "$LOGFILE" 2>&1 || restore_failed=true
            fi
        else
            systemctl disable duplicati.service >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    elif [[ "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 0 && "$RUNTIME_WAS_ACTIVE" -eq 1 && "$RUNTIME_QUIESCE_STARTED" -eq 1 ]]; then
        systemctl restart duplicati.service >> "$LOGFILE" 2>&1 || restore_failed=true
    fi
    [[ -z "${TMP_DEB:-}" ]] || rm -f -- "$TMP_DEB"
    if [[ "$restore_failed" == true ]]; then
        [[ "$RUNTIME_MUTATED" -eq 0 ]] || status=1
        print_warn "Rollback incomplete; recovery backup preserved at $BACKUP_DIR"
    else
        rm -rf -- "$BACKUP_DIR" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM


report_progress 45 "Resolving latest Duplicati release from GitHub..."
RELEASES_JSON="$(curl -fsSL https://api.github.com/repos/duplicati/duplicati/releases/latest 2>/dev/null || true)"
LATEST_TAG="$(echo "${RELEASES_JSON}" | jq -r '.tag_name // empty' || true)"
if [[ -z "${LATEST_TAG}" ]]; then
    if [[ "${AF_ALLOW_RELEASE_FALLBACK:-0}" == "1" ]]; then
        LATEST_TAG="v2.0.8.1-2.0.8.1_beta_2024-05-07"
    else
        print_error "Failed to discover latest GitHub release for duplicati/duplicati"
        exit 1
    fi
fi

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
    amd64) D_ARCH="linux-x64" ;;
    arm64) D_ARCH="linux-arm64" ;;
    armhf) D_ARCH="linux-arm7" ;;
    *) D_ARCH="all" ;;
esac

DEB_URL="$(echo "${RELEASES_JSON}" | jq -r --arg arch "${D_ARCH}.deb" '.assets[]? | select(.name | endswith($arch)) | .browser_download_url' | head -n1 || true)"
if [[ -z "${DEB_URL}" ]]; then
    DEB_URL="$(echo "${RELEASES_JSON}" | jq -r '.assets[]? | select(.name | endswith(".deb")) | .browser_download_url' | head -n1 || true)"
fi

if [[ -z "${DEB_URL}" ]]; then
    DEB_URL="https://github.com/duplicati/duplicati/releases/download/${LATEST_TAG}/duplicati_${LATEST_TAG#v}_all.deb"
fi

report_progress 65 "Downloading Duplicati package (${LATEST_TAG})..."
TMP_DEB="$(mktemp --suffix=.deb)"
download_file "${DEB_URL}" "${TMP_DEB}" >> "$LOGFILE" 2>&1

report_progress 75 "Installing Duplicati deb package..."
if [[ "$RUNTIME_HAD_PREVIOUS" -eq 1 ]]; then
    RUNTIME_QUIESCE_STARTED=1
    stop_systemd_unit duplicati.service
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$BACKUP_DIR/$runtime_index"
    fi
done
RUNTIME_MUTATED=1
install_deb_verified "$TMP_DEB" duplicati
rm -f "${TMP_DEB}"

AF_SEED_PASS="$ADMIN_PASS" safe_config_python "${CONFIG_DIR}/duplicati.env" "$APP_PORT" <<'PYEOF'
import shlex, sys
with ManagedConfig(sys.argv[1]) as config:
    retained = config.read_text() if config.metadata else ''
    values = dict(line.split('=', 1) for line in retained.splitlines() if '=' in line)
    password = values.get('DUPLICATI__WEBSERVICE_PASSWORD')
    if password is None:
        password = values.get('DUPLICATI_PASS', os.environ['AF_SEED_PASS'])
    elif password.startswith(('"', "'")):
        password = shlex.split(password)[0]
    password = password.replace('\\', '\\\\').replace('"', '\\"')
    config.write_text(f'DUPLICATI__WEBSERVICE_PASSWORD="{password}"\nDUPLICATI_PORT={sys.argv[2]}\n', 0o600)
PYEOF
if [[ -f /etc/default/duplicati ]]; then
    validate_config_paths /etc/default/duplicati
    chmod 600 /etc/default/duplicati
fi
chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}" "${CONFIG_DIR}"

SERVER_BIN="/usr/bin/duplicati-server"
if [[ ! -x "${SERVER_BIN}" && -x "/usr/lib/duplicati/duplicati-server" ]]; then
    SERVER_BIN="/usr/lib/duplicati/duplicati-server"
fi

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Duplicati Backup Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
EnvironmentFile=${CONFIG_DIR}/duplicati.env
ExecStart=${SERVER_BIN} --webservice-port=${APP_PORT} --webservice-interface=any --webservice-allowed-hostnames=* --server-datafolder=${DATA_DIR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now duplicati.service >> "$LOGFILE" 2>&1
systemctl restart duplicati.service >> "$LOGFILE" 2>&1
systemctl is-active --quiet duplicati.service
wait_for_service_ready duplicati.service "$APP_PORT" "/"

queue_app_version "${DATA_DIR}/.af-version" "$(dpkg-query -W -f='${Version}' duplicati)"
commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
