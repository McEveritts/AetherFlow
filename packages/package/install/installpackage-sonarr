#!/bin/bash
# AetherFlow Package Installer: Sonarr (v4 .NET standalone)
# Port: 8989

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="sonarr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8989}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Sonarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev mediainfo ca-certificates >> "$LOGFILE" 2>&1

if ! id -u sonarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/sonarr --shell /usr/sbin/nologin sonarr
fi

mkdir -p /var/lib/sonarr /opt/Sonarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) SONARR_ARCH="x64" ;;
    arm64) SONARR_ARCH="arm64" ;;
    armhf) SONARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Sonarr v4 (${SONARR_ARCH})..."
SONARR_VERSION="$(github_latest_tag "Sonarr/Sonarr" "4.0.12.2823")"
SONARR_URL="https://github.com/Sonarr/Sonarr/releases/download/v${SONARR_VERSION#v}/Sonarr.main.${SONARR_VERSION#v}.linux-${SONARR_ARCH}.tar.gz"
TMP_TAR=$(mktemp /tmp/sonarr-XXXXXX.tar.gz)
download_file "$SONARR_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Sonarr to /opt/Sonarr..."
stage_app_archive "$TMP_TAR" "/opt/Sonarr" "Sonarr" "/var/lib/sonarr" "${PACKAGE_NAME}"
rm -f "$TMP_TAR"

if [[ ! -x /opt/Sonarr/Sonarr ]]; then
    print_error "Sonarr binary /opt/Sonarr/Sonarr missing or not executable"
    exit 1
fi

PROBED_VER="$(resolve_installed_binary_version /opt/Sonarr/Sonarr "" || true)"
if [[ -n "$PROBED_VER" ]]; then
    RESOLVED_VER="$PROBED_VER"
elif [[ "${AF_ALLOW_VERSION_FALLBACK:-1}" != "0" ]]; then
    RESOLVED_VER="${SONARR_VERSION#v}"
else
    print_error "Failed to resolve installed binary version for Sonarr"
    exit 1
fi

NORM_RESOLVED="${RESOLVED_VER#release-}"
NORM_RESOLVED="${NORM_RESOLVED#Release-}"
NORM_RESOLVED="${NORM_RESOLVED#[vV]}"

NORM_SONARR="${SONARR_VERSION#release-}"
NORM_SONARR="${NORM_SONARR#Release-}"
NORM_SONARR="${NORM_SONARR#[vV]}"

if [[ "${RESOLVED_VER#v}" != "${SONARR_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_SONARR" ]]; then
    echo "ERROR: Installed Sonarr version '${RESOLVED_VER}' does not match expected version '${SONARR_VERSION}'" >&2
    exit 1
fi

if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    NORM_TARGET="${AF_TARGET_VERSION#release-}"
    NORM_TARGET="${NORM_TARGET#Release-}"
    NORM_TARGET="${NORM_TARGET#[vV]}"
    if [[ "${RESOLVED_VER#v}" != "${AF_TARGET_VERSION#v}" && "$NORM_RESOLVED" != "$NORM_TARGET" ]]; then
        echo "ERROR: Installed Sonarr version '${RESOLVED_VER}' does not match requested target version '${AF_TARGET_VERSION}'" >&2
        exit 1
    fi
fi

if [[ -n "$RESOLVED_VER" ]]; then
    queue_app_version /opt/Sonarr/.af-version "$RESOLVED_VER"
fi
set_config_value "/var/lib/sonarr/config.xml" xml "Port" "$APP_PORT" "Config"

chown -hRP sonarr:sonarr /opt/Sonarr /var/lib/sonarr

report_progress 85 "Configuring and starting sonarr.service..."
cat <<'EOF' > /etc/systemd/system/sonarr.service
[Unit]
Description=Sonarr Daemon
After=syslog.target network.target

[Service]
User=sonarr
Group=sonarr
Type=simple
ExecStart=/opt/Sonarr/Sonarr -nobrowser -data=/var/lib/sonarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now sonarr >> "$LOGFILE" 2>&1
systemctl restart sonarr >> "$LOGFILE" 2>&1
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "$READY_URL"
seed_servarr_master_user "sonarr" ${APP_PORT} "v3"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Sonarr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
