#!/bin/bash
# AetherFlow Package Installer: Sonarr (v4 .NET standalone)
# Port: 8989

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="sonarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Sonarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev mediainfo ca-certificates >> "$LOGFILE" 2>&1

if ! id -u sonarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/sonarr --shell /usr/sbin/nologin sonarr
fi

mkdir -p /var/lib/sonarr /opt/Sonarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) SONARR_ARCH="x64" ;;
    arm64) SONARR_ARCH="arm64" ;;
    armhf) SONARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Sonarr v4 (${SONARR_ARCH})..."
SONARR_VERSION="$(github_latest_tag "Sonarr/Sonarr" "4.0.12.2823")"
TMP_TAR=$(mktemp /tmp/sonarr-XXXXXX.tar.gz)
curl -fsSL "https://services.sonarr.tv/v1/download/main/latest?version=4&os=linux&arch=${SONARR_ARCH}" -o "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Sonarr to /opt/Sonarr..."
tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
if [[ -n "$SONARR_VERSION" ]]; then
    printf '%s\n' "${SONARR_VERSION#v}" > /opt/Sonarr/.af-version
fi
chown -R sonarr:sonarr /opt/Sonarr /var/lib/sonarr

report_progress 85 "Configuring and starting sonarr.service..."
cat <<'EOF' > /etc/systemd/system/sonarr.service
[Unit]
Description=Sonarr Daemon
After=syslog.target network.target

[Service]
User=sonarr
Group=sonarr
Type=simple
ExecStart=/opt/Sonarr/Sonarr -nobrowser -data=/var/lib/sonarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now sonarr >> "$LOGFILE" 2>&1
seed_servarr_master_user "sonarr" 8989 "v3"

write_lock "${PACKAGE_NAME}"
report_progress 100 "Sonarr installed on port 8989."
log_info "${PACKAGE_NAME} installed successfully"
