#!/bin/bash
# AetherFlow Package Installer: File Browser
# Port: 8095

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="filebrowser"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /opt/AetherFlow/logs

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for File Browser..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl tar openssl ca-certificates >> "$LOGFILE" 2>&1

if ! id -u filebrowser >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/filebrowser --shell /usr/sbin/nologin filebrowser
fi

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) FB_ARCH="linux-amd64" ;;
    arm64) FB_ARCH="linux-arm64" ;;
    armhf) FB_ARCH="linux-armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Downloading latest File Browser (${FB_ARCH})..."
FB_VERSION="$(github_latest_tag "filebrowser/filebrowser" "v2.31.2" "false")"
FB_URL="https://github.com/filebrowser/filebrowser/releases/download/${FB_VERSION}/${FB_ARCH}-filebrowser.tar.gz"

TMP_TAR=$(mktemp /tmp/filebrowser-XXXXXX.tar.gz)
curl -fsSL "$FB_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
tar --no-same-owner -xzf "$TMP_TAR" -C /usr/local/bin filebrowser >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
chmod +x /usr/local/bin/filebrowser

report_progress 70 "Initializing File Browser database on port 8095..."
mkdir -p /opt/filebrowser /srv
printf '%s\n' "${FB_VERSION#v}" > /opt/filebrowser/.af-version

# Remove any existing DB so config init is idempotent on reinstall
rm -f /opt/filebrowser/filebrowser.db
/usr/local/bin/filebrowser config init --database /opt/filebrowser/filebrowser.db >> "$LOGFILE" 2>&1
/usr/local/bin/filebrowser config set --address 0.0.0.0 --port 8095 --root /srv --minimum-password-length 1 --database /opt/filebrowser/filebrowser.db >> "$LOGFILE" 2>&1 || \
    /usr/local/bin/filebrowser config set --address 0.0.0.0 --port 8095 --root /srv --database /opt/filebrowser/filebrowser.db >> "$LOGFILE" 2>&1

FB_USER="${MASTER_USER}"
FB_PASS="${MASTER_PASS}"
if ! /usr/local/bin/filebrowser users add "$FB_USER" "$FB_PASS" --perm.admin --database /opt/filebrowser/filebrowser.db >> "$LOGFILE" 2>&1; then
    FB_PASS="$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 16)aA1!"
    /usr/local/bin/filebrowser users add "$FB_USER" "$FB_PASS" --perm.admin --database /opt/filebrowser/filebrowser.db >> "$LOGFILE" 2>&1
fi
printf 'FileBrowser Admin User: %s\nFileBrowser Admin Password: %s\n' "${FB_USER}" "${FB_PASS}" > /opt/AetherFlow/logs/filebrowser_credentials.txt
chmod 600 /opt/AetherFlow/logs/filebrowser_credentials.txt

chown -R filebrowser:filebrowser /opt/filebrowser

report_progress 85 "Configuring and starting filebrowser.service on port 8095..."
cat <<'EOF' > /etc/systemd/system/filebrowser.service
[Unit]
Description=File Browser Web File Manager
After=network.target

[Service]
User=filebrowser
Group=filebrowser
ExecStart=/usr/local/bin/filebrowser --database /opt/filebrowser/filebrowser.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now filebrowser >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "File Browser installed on port 8095."
log_info "${PACKAGE_NAME} installed successfully"
