#!/bin/bash
# AetherFlow Package Installer: File Browser
# Port: 8095

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="filebrowser"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8095}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /opt/AetherFlow/logs/filebrowser_credentials.txt
install -d -m 0700 /opt/AetherFlow/logs
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for File Browser..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl tar openssl ca-certificates apache2-utils

if ! id -u filebrowser >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/filebrowser --shell /usr/sbin/nologin filebrowser
fi

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) FB_ARCH="linux-amd64" ;;
    arm64) FB_ARCH="linux-arm64" ;;
    armhf) FB_ARCH="linux-armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Downloading latest File Browser (${FB_ARCH})..."
FB_VERSION="$(github_latest_tag "filebrowser/filebrowser" "v2.31.2" "false")"
FB_URL="https://github.com/filebrowser/filebrowser/releases/download/${FB_VERSION}/${FB_ARCH}-filebrowser.tar.gz"

TMP_TAR=$(mktemp /tmp/filebrowser-XXXXXX.tar.gz)
af_logged download_file "$FB_URL" "$TMP_TAR"
TMP_DIR="$(mktemp -d /tmp/filebrowser-extract-XXXXXX)"
trap '[[ -z "${TMP_DIR:-}" ]] || rm -rf "$TMP_DIR"; rm -f "$TMP_TAR"' EXIT
af_logged tar --no-same-owner -xzf "$TMP_TAR" -C "$TMP_DIR" filebrowser
rm -f "$TMP_TAR"
chmod 755 "$TMP_DIR/filebrowser"
stage_app_archive "$TMP_DIR" /usr/local/bin/filebrowser filebrowser /opt/filebrowser "$PACKAGE_NAME" "." "" "" binary
TMP_DIR=""
chmod +x /usr/local/bin/filebrowser

report_progress 70 "Initializing File Browser database on port ${APP_PORT}..."
mkdir -p /opt/filebrowser /srv
queue_app_version /opt/filebrowser/.af-version "${FB_VERSION#v}"

FB_NEW_DATABASE=0
if [[ ! -s /opt/filebrowser/filebrowser.db ]]; then
    af_logged /usr/local/bin/filebrowser config init --database /opt/filebrowser/filebrowser.db
    FB_NEW_DATABASE=1
fi
if [[ "$FB_NEW_DATABASE" == 1 ]]; then
    af_logged /usr/local/bin/filebrowser config set --address "${AF_BIND_ADDRESS:-127.0.0.1}" --port "${APP_PORT}" --root /srv --minimum-password-length 12 --database /opt/filebrowser/filebrowser.db
else
    af_logged /usr/local/bin/filebrowser config set --address "${AF_BIND_ADDRESS:-127.0.0.1}" --port "${APP_PORT}" --database /opt/filebrowser/filebrowser.db
fi

FB_USER="${MASTER_USER}"
FB_PASS="${MASTER_PASS}"
if [[ "$FB_NEW_DATABASE" == 1 ]]; then
FB_PASSWORD_HASH="$(printf '%s\n' "$FB_PASS" | htpasswd -niBC 10 "$FB_USER")"
FB_PASSWORD_HASH="${FB_PASSWORD_HASH#*:}"
FB_USERS_FILE="$(mktemp /opt/filebrowser/.af-users.XXXXXX.json)"
AF_SEED_USER="$FB_USER" AF_SEED_HASH="$FB_PASSWORD_HASH" safe_config_python "$FB_USERS_FILE" <<'PYEOF'
import json, sys
safe_write_text(sys.argv[1], json.dumps([{'id': 0, 'username': os.environ['AF_SEED_USER'], 'password': os.environ['AF_SEED_HASH'], 'scope': '/srv', 'perm': {'admin': True}}]), 0o600)
PYEOF
af_logged /usr/local/bin/filebrowser users import "$FB_USERS_FILE" --database /opt/filebrowser/filebrowser.db
rm -f -- "$FB_USERS_FILE"
(umask 077; printf 'FileBrowser Admin User: %s\nFileBrowser Admin Password: %s\n' "${FB_USER}" "${FB_PASS}" | write_config_file /opt/AetherFlow/logs/filebrowser_credentials.txt 0600)
fi

chown -hRP filebrowser:filebrowser /opt/filebrowser

report_progress 85 "Configuring and starting filebrowser.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/filebrowser.service
[Unit]
Description=File Browser Web File Manager
After=network.target

[Service]
User=filebrowser
Group=filebrowser
ExecStart=/usr/local/bin/filebrowser --database /opt/filebrowser/filebrowser.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now filebrowser
af_logged systemctl restart filebrowser
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/health"
systemctl is-active --quiet filebrowser

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "File Browser installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
