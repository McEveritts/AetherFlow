#!/bin/bash
# AetherFlow Package Installer: MergerFS
# Port: 0 (FUSE union mount pooling /mnt/local and /mnt/remote into /mnt/unionfs)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="mergerfs"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
PACKAGE_NAME="${PACKAGE_NAME:-mergerfs}"
begin_state_transaction "mergerfs" "0" "/" "/var/lib/mergerfs" "/etc/fuse.conf" "/etc/systemd/system/mergerfs.service" "/usr/bin/mergerfs" "/usr/share/mergerfs"

prepare_apt_package_transaction /var/lib/mergerfs/.af-version mergerfs
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing mergerfs and FUSE3 packages..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
if ! DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq mergerfs fuse3; then
    # Fallback to upstream deb release
    ARCH=$(dpkg --print-architecture)
    report_progress 30 "Fetching mergerfs deb package from GitHub releases..."
    MFS_JSON="$(curl -fsSL https://api.github.com/repos/trapexit/mergerfs/releases/latest 2>/dev/null || true)"
    MFS_DEB_URL="$(printf '%s' "$MFS_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*debian-trixie_'${ARCH}'\.deb' | head -1 || true)"
    if [[ -z "$MFS_DEB_URL" ]]; then
        MFS_DEB_URL="$(printf '%s' "$MFS_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*debian-bookworm_'${ARCH}'\.deb' | head -1 || true)"
    fi
    if [[ -n "$MFS_DEB_URL" ]]; then
        TMP_DEB=$(mktemp /tmp/mergerfs-XXXXXX.deb)
        af_logged download_file "$MFS_DEB_URL" "$TMP_DEB"
        install_deb_verified "$TMP_DEB" mergerfs
        rm -f "$TMP_DEB"
    else
        print_error "Failed to discover a compatible GitHub release for trapexit/mergerfs"
        exit 1
    fi
fi

report_progress 55 "Preparing mount branch directories (/mnt/local, /mnt/remote, /mnt/unionfs)..."
mkdir -p /mnt/local /mnt/remote /mnt/unionfs
chmod 775 /mnt/local /mnt/remote /mnt/unionfs

# Record version if mergerfs binary is present
if command -v mergerfs >/dev/null 2>&1; then
    MFS_VER="$(mergerfs -v 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || dpkg-query -W -f='${Version}' mergerfs 2>/dev/null || true)"
    if [[ -z "$MFS_VER" ]]; then
        if [[ "${AF_ALLOW_RELEASE_FALLBACK:-0}" == "1" ]]; then
            MFS_VER="2.39.0"
        else
            print_error "Failed to determine installed MergerFS version"
            exit 1
        fi
    fi
    mkdir -p /var/lib/mergerfs
    queue_app_version /var/lib/mergerfs/.af-version "$MFS_VER"
fi

report_progress 80 "Configuring and starting mergerfs.service union mount unit..."
cat <<'EOF' > /etc/systemd/system/mergerfs.service
[Unit]
Description=MergerFS Union Filesystem Mount
After=network-online.target rclone-vfs.service
Wants=network-online.target

[Service]
Type=forking
ExecStartPre=-/bin/mkdir -p /mnt/local /mnt/remote /mnt/unionfs
ExecStart=/usr/bin/mergerfs -o defaults,allow_other,use_ino,category.create=epmfs,cache.files=partial,dropcacheonclose=true /mnt/local:/mnt/remote /mnt/unionfs
ExecStop=/bin/fusermount -uz /mnt/unionfs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable mergerfs
af_logged systemctl start mergerfs
systemctl is-active --quiet mergerfs

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "MergerFS installed (pooling /mnt/local & /mnt/remote into /mnt/unionfs)."
log_info "${PACKAGE_NAME} installed successfully"
