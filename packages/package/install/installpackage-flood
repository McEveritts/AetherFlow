#!/bin/bash
# AetherFlow Package Installer: Flood (@jesec/flood)
# Port: 3001

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="flood"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3001}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Node.js 20 LTS for Flood..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl gnupg ca-certificates >> "$LOGFILE" 2>&1

ensure_node 20

if ! id -u flood >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/flood --shell /usr/sbin/nologin flood
fi

mkdir -p /var/lib/flood
chown -hRP flood:flood /var/lib/flood

BACKUP_DIR="$(mktemp -d /tmp/af-flood-runtime-XXXXXX)"
RUNTIME_PATHS=(/opt/flood /usr/local/bin/flood /usr/bin/flood /var/lib/flood /etc/systemd/system/flood.service)
RUNTIME_HAD_PREVIOUS=0
RUNTIME_WAS_ACTIVE=0
RUNTIME_QUIESCE_STARTED=0
RUNTIME_MUTATED=0
if systemctl is-active --quiet flood 2>/dev/null; then RUNTIME_WAS_ACTIVE=1; fi
if [[ -e /opt/flood || -f /etc/systemd/system/flood.service || "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
    RUNTIME_HAD_PREVIOUS=1
fi
rollback_runtime() {
    local status=$? runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback flood || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$BACKUP_DIR/$runtime_index" "$runtime_path" || restore_failed=true
        done
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" -eq 1 ]]; then
            if [[ "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
                systemctl restart flood >> "$LOGFILE" 2>&1 || restore_failed=true
            fi
        else
            systemctl disable flood >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    elif [[ "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 0 && "$RUNTIME_WAS_ACTIVE" -eq 1 && "$RUNTIME_QUIESCE_STARTED" -eq 1 ]]; then
        systemctl restart flood >> "$LOGFILE" 2>&1 || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        [[ "$RUNTIME_MUTATED" -eq 0 ]] || status=1
        print_warn "Rollback incomplete; recovery backup preserved at $BACKUP_DIR"
    else
        rm -rf -- "$BACKUP_DIR" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" -eq 1 ]]; then
    RUNTIME_QUIESCE_STARTED=1
    stop_systemd_unit flood
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$BACKUP_DIR/$runtime_index"
    fi
done
report_progress 55 "Installing @jesec/flood with its complete dependency build toolchain..."
RUNTIME_MUTATED=1
install_npm_app @jesec/flood /opt/flood /usr/local/bin/flood

FLOOD_BIN=/usr/local/bin/flood
if [[ ! -x /usr/bin/flood && -x "$FLOOD_BIN" ]]; then
    ln -sf "$FLOOD_BIN" /usr/bin/flood
fi

FLOOD_VER="$("$FLOOD_BIN" --version 2>/dev/null | head -n1 | tr -d '\r')"
if [[ -z "$FLOOD_VER" ]]; then
    print_error "Failed to determine installed Flood version"
    exit 1
fi
chown -hRP flood:flood /var/lib/flood

report_progress 85 "Configuring and starting flood.service on port ${APP_PORT}..."
FLOOD_BIND_HOST="$(retained_bind_address /etc/systemd/system/flood.service '--host[=\s]+([^\s"\x27]+)')"
cat <<EOF > /etc/systemd/system/flood.service
[Unit]
Description=Flood Web UI for Torrent Clients
After=network.target

[Service]
User=flood
Group=flood
WorkingDirectory=/var/lib/flood
ExecStart=${FLOOD_BIN} --host ${FLOOD_BIND_HOST} --port ${APP_PORT} --rundir /var/lib/flood
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now flood >> "$LOGFILE" 2>&1
systemctl restart flood >> "$LOGFILE" 2>&1
systemctl is-active --quiet flood
wait_for_service_ready flood "$APP_PORT" "/"

queue_app_version /var/lib/flood/.af-version "${FLOOD_VER#v}"
commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Flood installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
