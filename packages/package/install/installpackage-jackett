#!/bin/bash
# AetherFlow Package Installer: Jackett
# Port: 9117

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="jackett"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-9117}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Jackett..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl wget jq tar ca-certificates libicu-dev

if ! id -u jackett >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/jackett --shell /usr/sbin/nologin jackett
fi

mkdir -p /opt/Jackett /var/lib/jackett/Jackett

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) JACKETT_ARCH="AMDx64" ;;
    arm64) JACKETT_ARCH="ARM64" ;;
    armhf) JACKETT_ARCH="ARM32" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading latest Jackett (${JACKETT_ARCH})..."
JACKETT_VERSION="$(github_latest_tag "Jackett/Jackett" "0.22.1000")"
if [[ -n "${JACKETT_VERSION:-}" ]]; then
    JACKETT_URL="https://github.com/Jackett/Jackett/releases/download/v${JACKETT_VERSION#v}/Jackett.Binaries.Linux${JACKETT_ARCH}.tar.gz"
else
    JACKETT_URL="https://github.com/Jackett/Jackett/releases/latest/download/Jackett.Binaries.Linux${JACKETT_ARCH}.tar.gz"
fi
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_TAR="$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/jackett-XXXXXX.tar.gz")"
af_logged download_file "$JACKETT_URL" "$TMP_TAR"

report_progress 65 "Extracting Jackett to /opt/Jackett..."
stage_app_archive "$TMP_TAR" "/opt/Jackett" "jackett" "/var/lib/jackett" "${PACKAGE_NAME}" "Jackett" "" ""
rm -f "$TMP_TAR"
if [[ -n "$JACKETT_VERSION" ]]; then
    queue_app_version /opt/Jackett/.af-version "$(resolve_installed_binary_version /opt/Jackett/jackett "${JACKETT_VERSION#v}")"
fi

if [[ ! -s /var/lib/jackett/Jackett/ServerConfig.json ]]; then
sed "s/@AF_APP_PORT@/${APP_PORT}/g" <<'EOF' > /var/lib/jackett/Jackett/ServerConfig.json
{
  "Port": @AF_APP_PORT@,
  "AllowExternal": true,
  "APIKey": "",
  "AdminPassword": null,
  "InstanceId": "",
  "BlackholeDir": null,
  "UpdateDisabled": false,
  "UpdatePrerelease": false,
  "BasePathOverride": "",
  "CacheEnabled": true,
  "CacheTtl": 2100,
  "CacheMaxResultsPerIndexer": 1000,
  "OmdbApiKey": null,
  "OmdbApiUrl": null,
  "ProxyUrl": null,
  "ProxyType": 0,
  "ProxyPort": null,
  "ProxyUsername": null,
  "ProxyPassword": null,
  "ProxyIsAnonymous": true
}
EOF
fi

set_config_value "/var/lib/jackett/Jackett/ServerConfig.json" json "Port" "$APP_PORT" ""

chown -hRP jackett:jackett /opt/Jackett /var/lib/jackett

report_progress 85 "Configuring and starting jackett.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/jackett.service
[Unit]
Description=Jackett Daemon
After=network.target

[Service]
SyslogIdentifier=jackett
Restart=always
RestartSec=5
Type=simple
User=jackett
Group=jackett
Environment=XDG_CONFIG_HOME=/var/lib/jackett
WorkingDirectory=/opt/Jackett
ExecStart=/opt/Jackett/jackett --NoRestart --DataFolder /var/lib/jackett/Jackett
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/jackett.service


af_logged systemctl daemon-reload
af_logged systemctl enable --now jackett
af_logged systemctl restart jackett
systemctl is-active --quiet jackett

finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Jackett installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
