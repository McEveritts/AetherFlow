#!/bin/bash
# AetherFlow Package Installer: Jackett
# Port: 9117

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="jackett"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Jackett..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl wget jq tar ca-certificates libicu-dev >> "$LOGFILE" 2>&1

if ! id -u jackett >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/jackett --shell /usr/sbin/nologin jackett
fi

mkdir -p /opt/Jackett /var/lib/jackett/Jackett

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) JACKETT_ARCH="AMDx64" ;;
    arm64) JACKETT_ARCH="ARM64" ;;
    armhf) JACKETT_ARCH="ARM32" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading latest Jackett (${JACKETT_ARCH})..."
JACKETT_VERSION="$(curl -fsSL https://api.github.com/repos/Jackett/Jackett/releases/latest 2>/dev/null | grep -oP '"tag_name":\s*"v?\K[^"]+' | head -1 || true)"
TMP_TAR=$(mktemp /tmp/jackett-XXXXXX.tar.gz)
curl -fsSL "https://github.com/Jackett/Jackett/releases/latest/download/Jackett.Binaries.Linux${JACKETT_ARCH}.tar.gz" -o "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Jackett to /opt/Jackett..."
tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
if [[ -n "$JACKETT_VERSION" ]]; then
    printf '%s\n' "${JACKETT_VERSION#v}" > /opt/Jackett/.af-version
fi

cat <<'EOF' > /var/lib/jackett/Jackett/ServerConfig.json
{
  "Port": 9117,
  "AllowExternal": true,
  "APIKey": "",
  "AdminPassword": null,
  "InstanceId": "",
  "BlackholeDir": null,
  "UpdateDisabled": false,
  "UpdatePrerelease": false,
  "BasePathOverride": "",
  "CacheEnabled": true,
  "CacheTtl": 2100,
  "CacheMaxResultsPerIndexer": 1000,
  "OmdbApiKey": null,
  "OmdbApiUrl": null,
  "ProxyUrl": null,
  "ProxyType": 0,
  "ProxyPort": null,
  "ProxyUsername": null,
  "ProxyPassword": null,
  "ProxyIsAnonymous": true
}
EOF

chown -R jackett:jackett /opt/Jackett /var/lib/jackett

report_progress 85 "Configuring and starting jackett.service on port 9117..."
cat <<'EOF' > /etc/systemd/system/jackett.service
[Unit]
Description=Jackett Daemon
After=network.target

[Service]
SyslogIdentifier=jackett
Restart=always
RestartSec=5
Type=simple
User=jackett
Group=jackett
Environment=XDG_CONFIG_HOME=/var/lib/jackett
WorkingDirectory=/opt/Jackett
ExecStart=/opt/Jackett/jackett --NoRestart --DataFolder /var/lib/jackett/Jackett
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now jackett >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Jackett installed on port 9117."
log_info "${PACKAGE_NAME} installed successfully"
