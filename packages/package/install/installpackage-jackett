#!/bin/bash
#
# [AetherFlow :: Install Jackett]
# API Support for trackers
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [jackett] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl libicu-dev >>"$LOGFILE" 2>&1

# ── Download Jackett ─────────────────────────────────────────────────────────
log "Downloading latest Jackett..."
ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) JACKETT_ARCH="LinuxAMDx64" ;;
    arm64) JACKETT_ARCH="LinuxARM64" ;;
    armhf) JACKETT_ARCH="LinuxARM32" ;;
    *) JACKETT_ARCH="LinuxAMDx64" ;;
esac

JACKETT_URL=$(curl -sL https://api.github.com/repos/Jackett/Jackett/releases/latest | grep "browser_download_url.*${JACKETT_ARCH}.tar.gz" | head -1 | cut -d '"' -f 4)
if [[ -z "$JACKETT_URL" ]]; then
    log "Could not determine latest Jackett URL, attempting fallback..."
    JACKETT_VERSION=$(curl -sL https://api.github.com/repos/Jackett/Jackett/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
    JACKETT_URL="https://github.com/Jackett/Jackett/releases/download/v${JACKETT_VERSION}/Jackett.Binaries.${JACKETT_ARCH}.tar.gz"
fi

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "$JACKETT_URL" -o jackett.tar.gz >>"$LOGFILE" 2>&1

log "Extracting Jackett..."
rm -rf /opt/Jackett
tar -xzf jackett.tar.gz -C /opt >>"$LOGFILE" 2>&1
rm -f jackett.tar.gz

# ── Create jackett user ──────────────────────────────────────────────────────
if ! id -u jackett &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /opt/Jackett jackett
fi
chown -R jackett:jackett /opt/Jackett
mkdir -p /var/lib/jackett/.config/Jackett
chown -R jackett:jackett /var/lib/jackett

# ── Configure Jackett ────────────────────────────────────────────────────────
cat >/var/lib/jackett/.config/Jackett/ServerConfig.json <<EOF
{
  "Port": 9117,
  "AllowExternal": false,
  "APIKey": "",
  "AdminPassword": null,
  "InstanceId": "",
  "BlackholeDir": "",
  "UpdateDisabled": true,
  "UpdatePrerelease": false,
  "BasePathOverride": "/jackett",
  "CacheEnabled": true,
  "CacheTtl": 2100,
  "CacheMaxResultsPerIndexer": 1000,
  "FlareSolverrUrl": "",
  "FlareSolverrMaxRequestDelay": 55,
  "OmdbApiKey": "",
  "OmdbApiUrl": ""
}
EOF
chown -R jackett:jackett /var/lib/jackett/.config/Jackett

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/jackett.service <<'EOF'
[Unit]
Description=Jackett Tracker Manager
After=network.target

[Service]
Environment="TMPDIR=/tmp/jackett"
ExecStartPre=-/bin/mkdir -p /tmp/jackett
ExecStartPre=-/bin/chown -R jackett:jackett /tmp/jackett
SyslogIdentifier=jackett
Restart=always
RestartSec=5
Type=simple
User=jackett
Group=jackett
WorkingDirectory=/opt/Jackett
ExecStart=/opt/Jackett/jackett --NoRestart -d /var/lib/jackett/.config/Jackett
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/jackett

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable jackett.service >>"$LOGFILE" 2>&1
systemctl start jackett.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/jackett.conf <<'EOF'
<Location /jackett>
    ProxyPass http://localhost:9117/jackett
    ProxyPassReverse http://localhost:9117/jackett
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/jackett.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.jackett.lock
log "Jackett installation complete! Access at http://your-server:9117"
