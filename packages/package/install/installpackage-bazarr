#!/bin/bash
# AetherFlow Package Installer: Bazarr
# Port: 6767

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="bazarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing Python and build dependencies for Bazarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl python3 python3-pip python3-venv python3-dev build-essential libxml2-dev libxslt1-dev zlib1g-dev libffi-dev libssl-dev unzip unrar-free ffmpeg ca-certificates >> "$LOGFILE" 2>&1

if ! id -u bazarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/bazarr --shell /usr/sbin/nologin bazarr
fi

mkdir -p /opt/bazarr /var/lib/bazarr

report_progress 30 "Downloading official Bazarr release bundle..."
BAZARR_JSON="$(curl -fsSL https://api.github.com/repos/morpheus65535/bazarr/releases/latest 2>/dev/null || true)"
BAZARR_VERSION="$(printf '%s' "$BAZARR_JSON" | grep -oP '"tag_name":\s*"v?\K[^"]+' | head -1 || true)"
BAZARR_URL="$(printf '%s' "$BAZARR_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*bazarr\.zip' | head -1 || true)"
if [[ -z "$BAZARR_URL" ]]; then
    BAZARR_URL="https://github.com/morpheus65535/bazarr/releases/latest/download/bazarr.zip"
fi

TMP_ZIP=$(mktemp /tmp/bazarr-XXXXXX.zip)
curl -fsSL "$BAZARR_URL" -o "$TMP_ZIP" >> "$LOGFILE" 2>&1

report_progress 55 "Extracting Bazarr and creating isolated Python virtualenv..."
unzip -qo "$TMP_ZIP" -d /opt/bazarr >> "$LOGFILE" 2>&1
rm -f "$TMP_ZIP"

python3 -m venv /opt/bazarr/.venv >> "$LOGFILE" 2>&1
/opt/bazarr/.venv/bin/pip install --upgrade pip wheel setuptools >> "$LOGFILE" 2>&1
/opt/bazarr/.venv/bin/pip install -r /opt/bazarr/requirements.txt >> "$LOGFILE" 2>&1

if [[ -n "$BAZARR_VERSION" ]]; then
    printf '%s\n' "${BAZARR_VERSION#v}" > /opt/bazarr/.af-version
fi
chown -R bazarr:bazarr /opt/bazarr /var/lib/bazarr

report_progress 85 "Configuring and starting bazarr.service..."
cat <<'EOF' > /etc/systemd/system/bazarr.service
[Unit]
Description=Bazarr Daemon
After=syslog.target network.target

[Service]
WorkingDirectory=/opt/bazarr
User=bazarr
Group=bazarr
UMask=0002
Restart=on-failure
RestartSec=5
Type=simple
ExecStart=/opt/bazarr/.venv/bin/python3 /opt/bazarr/bazarr.py --no-update --config /var/lib/bazarr
KillSignal=SIGINT
TimeoutStopSec=20
SyslogIdentifier=bazarr

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now bazarr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Bazarr installed on port 6767."
log_info "${PACKAGE_NAME} installed successfully"
