#!/bin/bash
# AetherFlow Package Installer: Uptime Kuma
# Port: 3004

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="uptimekuma"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3004}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Git and Node.js 20 LTS for Uptime Kuma..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git curl gnupg ca-certificates build-essential python3 python3-setuptools >> "$LOGFILE" 2>&1

ensure_node 20

if ! id -u uptimekuma >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/uptime-kuma --shell /usr/sbin/nologin uptimekuma
fi

report_progress 40 "Preparing Uptime Kuma update while preserving monitors and history..."
REPO_URL="https://github.com/louislam/uptime-kuma.git"
FALLBACK_TAG="1.23.15"
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    TARGET_TAG="$AF_TARGET_VERSION"
else
    TARGET_TAG="$(git ls-remote --tags --refs "$REPO_URL" 2>/dev/null | sed 's#.*refs/tags/##' | grep -E '^v?[0-9]+(\.[0-9]+)+$' | sort -V | tail -n1 || true)"
    if [[ -z "$TARGET_TAG" ]]; then
        TARGET_TAG="$FALLBACK_TAG"
    fi
fi
if ! git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG}" >/dev/null 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/${TARGET_TAG#v}" >/dev/null 2>&1; then
        TARGET_TAG="${TARGET_TAG#v}"
    elif [[ ! "$TARGET_TAG" =~ ^v ]] && git ls-remote --exit-code --tags "$REPO_URL" "refs/tags/v${TARGET_TAG}" >/dev/null 2>&1; then
        TARGET_TAG="v${TARGET_TAG}"
    else
        af_write_failure_receipt 1 "download" "invalid_target_tag" "Upstream tag refs/tags/${TARGET_TAG} not found in ${REPO_URL}"
        exit 1
    fi
fi
BUILD_DIR="$(mktemp -d /opt/.uptime-kuma-build.XXXXXX)"
trap '[[ -z "$BUILD_DIR" ]] || rm -rf "$BUILD_DIR"' EXIT
if ! git clone --branch "$TARGET_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1; then
    if [[ "$TARGET_TAG" =~ ^v ]]; then
        ALT_TAG="${TARGET_TAG#v}"
    else
        ALT_TAG="v${TARGET_TAG}"
    fi
    git clone --branch "$ALT_TAG" --depth 1 "$REPO_URL" "$BUILD_DIR" >> "$LOGFILE" 2>&1 || {
        log_error "Failed to clone Uptime Kuma repository at tag $TARGET_TAG"
        exit 1
    }
    TARGET_TAG="$ALT_TAG"
fi

report_progress 65 "Building Uptime Kuma production bundle..."
cd "$BUILD_DIR"
node_build npm run setup >> "$LOGFILE" 2>&1

queue_app_version "/opt/uptime-kuma/.af-version" "${TARGET_TAG#v}"

UK_DATA_REL="data"
mkdir -p "$BUILD_DIR/$UK_DATA_REL"
if [[ -d "/opt/uptime-kuma/$UK_DATA_REL" ]]; then
    cp -a "/opt/uptime-kuma/$UK_DATA_REL/." "$BUILD_DIR/$UK_DATA_REL/"
fi
if [[ -f /opt/uptime-kuma/.env ]]; then
    cp -a /opt/uptime-kuma/.env "$BUILD_DIR/.env"
fi
if [[ -f "$BUILD_DIR/server/server.js" ]]; then
    chmod +x "$BUILD_DIR/server/server.js"
elif [[ -f "$BUILD_DIR/new-code" ]]; then
    chmod +x "$BUILD_DIR/new-code"
fi
if ! command_exists stop_systemd_unit; then
    stop_systemd_unit() { systemctl stop "$1" >> "$LOGFILE" 2>&1 || true; }
fi
stage_app_archive "$BUILD_DIR" /opt/uptime-kuma "server/server.js|new-code" "/opt/uptime-kuma/$UK_DATA_REL" uptime-kuma "."
BUILD_DIR=""
cd /opt/uptime-kuma

chown -hRP uptimekuma:uptimekuma /opt/uptime-kuma
NODE_BIN="$(command -v node || echo /usr/bin/node)"

report_progress 85 "Configuring and starting uptime-kuma.service on port ${APP_PORT}..."
cat <<EOF > /etc/systemd/system/uptime-kuma.service
[Unit]
Description=Uptime Kuma - A fancy self-hosted monitoring tool
After=network.target

[Service]
Type=simple
User=uptimekuma
Group=uptimekuma
WorkingDirectory=/opt/uptime-kuma
Environment=UPTIME_KUMA_PORT=${APP_PORT}
Environment=PORT=${APP_PORT}
ExecStart=${NODE_BIN} server/server.js --port=${APP_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now uptime-kuma >> "$LOGFILE" 2>&1
systemctl restart uptime-kuma >> "$LOGFILE" 2>&1
if [[ -f /opt/uptime-kuma/server/server.js ]]; then
    finish_app_archive_update uptime-kuma "$APP_PORT" "/"
else
    systemctl is-active --quiet uptime-kuma
    rm -rf -- "$AF_ARCHIVE_BACKUP/release"
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Uptime Kuma installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
