#!/bin/bash
# AetherFlow Package Installer: Uptime Kuma
# Port: 3004

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="uptimekuma"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Git and Node.js 20 LTS for Uptime Kuma..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git curl gnupg ca-certificates >> "$LOGFILE" 2>&1

ensure_node 20

if ! id -u uptimekuma >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/uptime-kuma --shell /usr/sbin/nologin uptimekuma
fi

report_progress 40 "Cloning Uptime Kuma repository..."
rm -rf /opt/uptime-kuma
git clone https://github.com/louislam/uptime-kuma.git /opt/uptime-kuma >> "$LOGFILE" 2>&1

report_progress 65 "Building Uptime Kuma production bundle..."
cd /opt/uptime-kuma
npm run setup >> "$LOGFILE" 2>&1

UK_VERSION="$(git describe --tags "$(git rev-list --tags --max-count=1)" 2>/dev/null || true)"
if [[ -n "$UK_VERSION" ]]; then
    printf '%s\n' "${UK_VERSION#v}" > /opt/uptime-kuma/.af-version
fi

chown -R uptimekuma:uptimekuma /opt/uptime-kuma
NODE_BIN="$(command -v node || echo /usr/bin/node)"

report_progress 85 "Configuring and starting uptime-kuma.service on port 3004..."
cat <<EOF > /etc/systemd/system/uptime-kuma.service
[Unit]
Description=Uptime Kuma - A fancy self-hosted monitoring tool
After=network.target

[Service]
Type=simple
User=uptimekuma
Group=uptimekuma
WorkingDirectory=/opt/uptime-kuma
Environment=UPTIME_KUMA_PORT=3004
Environment=PORT=3004
ExecStart=${NODE_BIN} server/server.js --port=3004
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now uptime-kuma >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Uptime Kuma installed on port 3004."
log_info "${PACKAGE_NAME} installed successfully"
