#!/bin/bash
# AetherFlow Package Installer: Threadfin
# Port: 34400

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="threadfin"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-34400}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing dependencies for Threadfin..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl wget ca-certificates ffmpeg

if ! id -u threadfin >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/threadfin --shell /usr/sbin/nologin threadfin
fi

mkdir -p /var/lib/threadfin/conf /var/lib/threadfin/temp

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) TF_ASSET="Threadfin_linux_amd64" ;;
    arm64) TF_ASSET="Threadfin_linux_arm64" ;;
    armhf) TF_ASSET="Threadfin_linux_arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Threadfin release (${TF_ASSET})..."
TF_TAG="$(github_latest_tag "Threadfin/Threadfin" "1.2.37" "false")"
TF_URL="https://github.com/Threadfin/Threadfin/releases/download/${TF_TAG}/${TF_ASSET}"

report_progress 65 "Downloading and installing Threadfin ${TF_TAG}..."
TMP_BIN=$(mktemp /tmp/threadfin-XXXXXX)
af_logged download_file "$TF_URL" "$TMP_BIN"
BUILD_DIR="$(mktemp -d /tmp/threadfin-extract-XXXXXX)"
trap '[[ -z "${BUILD_DIR:-}" ]] || rm -rf -- "$BUILD_DIR"; rm -f -- "$TMP_BIN"' EXIT
mv -- "$TMP_BIN" "$BUILD_DIR/threadfin"
chmod 755 "$BUILD_DIR/threadfin"
stage_app_archive "$BUILD_DIR" /usr/local/bin/threadfin threadfin /var/lib/threadfin "$PACKAGE_NAME" "." "" "" binary
BUILD_DIR=""
queue_app_version /var/lib/threadfin/.af-version "${TF_TAG#v}"

chown -hRP threadfin:threadfin /var/lib/threadfin

report_progress 85 "Configuring and starting threadfin.service on port ${APP_PORT}..."
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_BIND_ADDRESS@/${AF_BIND_ADDRESS:-127.0.0.1}/g" <<'EOF' > /etc/systemd/system/threadfin.service
[Unit]
Description=Threadfin M3U and HDHomeRun IPTV Proxy
After=syslog.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threadfin
Group=threadfin
WorkingDirectory=/var/lib/threadfin
ExecStart=/usr/local/bin/threadfin -port=@AF_APP_PORT@ -bind=@AF_BIND_ADDRESS@ -config=/var/lib/threadfin/conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now threadfin
af_logged systemctl restart threadfin
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Threadfin installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
