#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    source /opt/AetherFlow/current/packages/common.sh
else
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="appname"
APP_LABEL="AppName"
APP_PORT="${AF_APP_PORT:-8080}"
APP_DATA_DIR="/var/lib/${PACKAGE_NAME}"
APP_INSTALL_DIR="/opt/${APP_LABEL}"
APP_BINARY="${APP_INSTALL_DIR}/${APP_LABEL}"
GITHUB_REPOSITORY="owner/repo"

export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")"
require_root
if [[ ! "$APP_PORT" =~ ^[0-9]{1,5}$ ]] || (( 10#$APP_PORT < 1024 || 10#$APP_PORT > 65535 )); then
    print_error "AF_APP_PORT must be between 1024 and 65535."
    exit 1
fi
if has_lock "$PACKAGE_NAME"; then
    log_info "Updating or reinstalling ${APP_LABEL}; existing configuration and data are retained."
fi

report_progress 10 "Installing ${APP_LABEL} dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=120 update -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=120 install -y -qq curl python3 ca-certificates >> "$LOGFILE" 2>&1

case "$(dpkg --print-architecture)" in
    amd64) APP_ARCH="x64" ;;
    arm64) APP_ARCH="arm64" ;;
    armhf) APP_ARCH="arm" ;;
    *) print_error "Unsupported application architecture"; exit 1 ;;
esac
ASSET_SUFFIX="linux-${APP_ARCH}.tar.gz"

report_progress 25 "Resolving the current ${APP_LABEL} release..."
RELEASE_JSON="$(curl -fsSL --connect-timeout 10 --max-time 60 "https://api.github.com/repos/${GITHUB_REPOSITORY}/releases/latest")"
RELEASE_INFO="$(python3 - "$RELEASE_JSON" "$ASSET_SUFFIX" <<'PYEOF'
import json, sys
release = json.loads(sys.argv[1])
version = release.get("tag_name")
assets = [asset for asset in release.get("assets", []) if asset.get("name", "").endswith(sys.argv[2])]
if not version or len(assets) != 1:
    raise RuntimeError("Release must have a version and exactly one matching architecture asset")
url = assets[0].get("browser_download_url", "")
if not url.startswith("https://") or any(character in url + version for character in "\r\n"):
    raise RuntimeError("Invalid release metadata")
print(version)
print(url)
PYEOF
)"
APP_VERSION="${RELEASE_INFO%%$'\n'*}"
DOWNLOAD_URL="${RELEASE_INFO#*$'\n'}"

if ! id -u "$PACKAGE_NAME" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "$APP_DATA_DIR" --shell /usr/sbin/nologin "$PACKAGE_NAME"
fi
mkdir -p "$APP_DATA_DIR" "$(dirname "$APP_INSTALL_DIR")"
TMP_TAR="$(mktemp "/tmp/${PACKAGE_NAME}-XXXXXX.tar.gz")"
trap 'rm -f -- "$TMP_TAR"' EXIT
report_progress 40 "Downloading and staging ${APP_LABEL}..."
download_file "$DOWNLOAD_URL" "$TMP_TAR" >> "$LOGFILE" 2>&1
stage_app_archive "$TMP_TAR" "$APP_INSTALL_DIR" "$APP_LABEL" "$APP_DATA_DIR" "$PACKAGE_NAME" "$APP_LABEL"
chmod 755 "$APP_BINARY"
queue_app_version "$APP_INSTALL_DIR/.af-version" "${APP_VERSION#v}"
chown -hRP "$PACKAGE_NAME:$PACKAGE_NAME" "$APP_INSTALL_DIR" "$APP_DATA_DIR"

report_progress 70 "Configuring ${APP_LABEL} on port ${APP_PORT}..."
cat > "/etc/systemd/system/${PACKAGE_NAME}.service" <<EOF
[Unit]
Description=${APP_LABEL} (AetherFlow Managed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${PACKAGE_NAME}
Group=${PACKAGE_NAME}
WorkingDirectory=${APP_INSTALL_DIR}
ExecStart=${APP_BINARY} --port=${APP_PORT} --data-dir=${APP_DATA_DIR}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=${APP_DATA_DIR}

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable "$PACKAGE_NAME" >> "$LOGFILE" 2>&1
systemctl restart "$PACKAGE_NAME" >> "$LOGFILE" 2>&1
report_progress 90 "Waiting for ${APP_LABEL} readiness..."
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/ping"

commit_app_versions
write_lock "$PACKAGE_NAME"
report_progress 100 "${APP_LABEL} installed on port ${APP_PORT}."
log_info "${APP_LABEL} installation complete."
