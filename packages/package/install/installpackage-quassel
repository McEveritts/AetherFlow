#!/bin/bash
#
# [AetherFlow Install Script - Quassel Core]
# Installs Quassel distributed IRC core on bare-metal Debian/Ubuntu.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
validate_config_paths /var/lib/quassel/quasselCert.pem

PACKAGE_NAME="quassel"
APP_NAME="quassel"
DATA_DIR="/var/lib/quassel"
LOG_DIR="/var/log/quassel"
LISTEN_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-4242}}"
export AF_APP_PORT="$LISTEN_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

PACKAGE_NAME="${PACKAGE_NAME:-quassel}"
begin_state_transaction "quasselcore.service" "0" "/" "/var/lib/quassel" "/etc/default/quasselcore" "/etc/systemd/system/quasselcore.service" "/usr/bin/quasselcore" "/usr/lib/quassel" "/usr/share/quassel"

prepare_apt_package_transaction /var/lib/quassel/.af-version quassel-core
log_info "Starting ${APP_NAME} installation (target port: ${LISTEN_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

report_progress 45 "Installing quassel-core via APT..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq quassel-core openssl

mkdir -p "${DATA_DIR}" "${LOG_DIR}"
if id -u quasselcore >/dev/null 2>&1; then
    QUASSEL_USER="quasselcore"
elif ! id -u quassel >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin quasselcore 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false quasselcore
    QUASSEL_USER="quasselcore"
else
    QUASSEL_USER="quassel"
fi

report_progress 75 "Generating TLS certificate and default configuration for Quassel Core..."
if [[ ! -f "${DATA_DIR}/quasselCert.pem" ]]; then
    af_logged openssl req -x509 -nodes -days 3650 -newkey rsa:4096 \
        -keyout "${DATA_DIR}/quasselCert.pem" \
        -out "${DATA_DIR}/quasselCert.pem" \
        -subj "/CN=quassel.aether.local"
    chmod 600 "${DATA_DIR}/quasselCert.pem"
fi

if [[ ! -s /etc/default/quasselcore ]]; then
cat > /etc/default/quasselcore <<EOF
LISTEN="0.0.0.0"
PORT="${LISTEN_PORT}"
CONFIGDIR="${DATA_DIR}"
LOGFILE="${LOG_DIR}/quasselcore.log"
LOGLEVEL="Info"
EOF
fi
set_config_value /etc/default/quasselcore ini PORT "\"${LISTEN_PORT}\""

chown -hRP "${QUASSEL_USER}:${QUASSEL_USER}" "${DATA_DIR}" "${LOG_DIR}"

INSTALLED_VER="$(dpkg-query -W -f='${Version}' quassel-core 2>/dev/null | cut -d- -f1 | sed 's/^[0-9]*://' || echo '0.14.0')"
queue_app_version "${DATA_DIR}/.af-version" "${INSTALLED_VER}"

report_progress 90 "Enabling and starting quasselcore.service..."
af_logged systemctl daemon-reload
af_logged systemctl enable --now quasselcore.service
af_logged systemctl restart quasselcore.service
systemctl is-active --quiet quasselcore.service

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} Core installed and listening on TCP port ${LISTEN_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
