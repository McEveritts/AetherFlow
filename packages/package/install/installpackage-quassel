#!/bin/bash
#
# [AetherFlow Install Script - Quassel Core]
# Installs Quassel distributed IRC core on bare-metal Debian/Ubuntu.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

PACKAGE_NAME="quassel"
APP_NAME="quassel"
DATA_DIR="/var/lib/quassel"
LOG_DIR="/var/log/quassel"
LISTEN_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-4242}}"
export AF_APP_PORT="$LISTEN_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${LISTEN_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

report_progress 45 "Installing quassel-core via APT..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq quassel-core openssl >> "$LOGFILE" 2>&1

mkdir -p "${DATA_DIR}" "${LOG_DIR}"
if id -u quasselcore >/dev/null 2>&1; then
    QUASSEL_USER="quasselcore"
elif ! id -u quassel >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin quasselcore 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false quasselcore
    QUASSEL_USER="quasselcore"
else
    QUASSEL_USER="quassel"
fi

report_progress 75 "Generating TLS certificate and default configuration for Quassel Core..."
if [[ ! -f "${DATA_DIR}/quasselCert.pem" ]]; then
    openssl req -x509 -nodes -days 3650 -newkey rsa:4096 \
        -keyout "${DATA_DIR}/quasselCert.pem" \
        -out "${DATA_DIR}/quasselCert.pem" \
        -subj "/CN=quassel.aether.local" >> "$LOGFILE" 2>&1
    chmod 600 "${DATA_DIR}/quasselCert.pem"
fi

cat > /etc/default/quasselcore <<EOF
LISTEN="0.0.0.0"
PORT="${LISTEN_PORT}"
CONFIGDIR="${DATA_DIR}"
LOGFILE="${LOG_DIR}/quasselcore.log"
LOGLEVEL="Info"
EOF

chown -R "${QUASSEL_USER}:${QUASSEL_USER}" "${DATA_DIR}" "${LOG_DIR}"

INSTALLED_VER="$(dpkg-query -W -f='${Version}' quassel-core 2>/dev/null | cut -d- -f1 | sed 's/^[0-9]*://' || echo '0.14.0')"
echo "${INSTALLED_VER}" > "${DATA_DIR}/.af-version"

report_progress 90 "Enabling and starting quasselcore.service..."
systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now quasselcore.service >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} Core installed and listening on TCP port ${LISTEN_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
