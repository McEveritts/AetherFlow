#!/bin/bash
#
# [AetherFlow Install Script - SeedCross]
# Installs SeedCross web-based automated torrent cross-seeding manager.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="seedcross"
APP_USER="seedcross"
INSTALL_DIR="/opt/seedcross"
DATA_DIR="/var/lib/seedcross"
LOCK_FILE="/install/.seedcross.lock"
SERVICE_FILE="/etc/systemd/system/seedcross.service"
APP_PORT="${AF_APP_PORT:-8019}"

setup_log "${APP_NAME}"
log "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

ensure_master_credentials
ADMIN_USER="${MASTER_USER}"
ADMIN_PASS="${MASTER_PASS}"
ADMIN_EMAIL="${ADMIN_USER}@localhost"

report_progress 25 "Installing Python runtime and system dependencies..."
apt_update
apt_install curl wget git jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip sqlite3

ensure_service_user "${APP_USER}" "${DATA_DIR}"
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 45 "Cloning ${APP_NAME} repository..."
if [[ -d "${INSTALL_DIR}/.git" ]]; then
    git -C "${INSTALL_DIR}" pull --ff-only >> "${LOG_FILE}" 2>&1 || true
else
    rm -rf "${INSTALL_DIR:?}"/*
    git clone --depth 1 https://github.com/ccf-2012/seedcross.git "${INSTALL_DIR}" >> "${LOG_FILE}" 2>&1
fi

COMMIT_VER="$(git -C "${INSTALL_DIR}" rev-parse --short HEAD 2>/dev/null || echo '1.0.0')"
echo "0.1.0-${COMMIT_VER}" > "${INSTALL_DIR}/.af-version"

report_progress 65 "Creating Python virtualenv and installing dependencies..."
if [[ ! -d "${INSTALL_DIR}/.venv" ]]; then
    python3 -m venv "${INSTALL_DIR}/.venv" >> "${LOG_FILE}" 2>&1
fi
"${INSTALL_DIR}/.venv/bin/pip" install --upgrade pip setuptools wheel gunicorn >> "${LOG_FILE}" 2>&1
if [[ -f "${INSTALL_DIR}/requirements.txt" ]]; then
    "${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir -r "${INSTALL_DIR}/requirements.txt" >> "${LOG_FILE}" 2>&1
fi

chown -R "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 80 "Initializing ${APP_NAME} database and master account..."
if [[ -f "${INSTALL_DIR}/manage.py" ]]; then
    su -s /bin/bash "${APP_USER}" -c "cd '${INSTALL_DIR}' && '${INSTALL_DIR}/.venv/bin/python' manage.py makemigrations --noinput" >> "${LOG_FILE}" 2>&1 || true
    su -s /bin/bash "${APP_USER}" -c "cd '${INSTALL_DIR}' && '${INSTALL_DIR}/.venv/bin/python' manage.py migrate --noinput" >> "${LOG_FILE}" 2>&1 || true
    su -s /bin/bash "${APP_USER}" -c "cd '${INSTALL_DIR}' && '${INSTALL_DIR}/.venv/bin/python' manage.py shell -c \"
from django.contrib.auth import get_user_model
User = get_user_model()
u, _ = User.objects.get_or_create(username='${ADMIN_USER}', defaults={'email': '${ADMIN_EMAIL}', 'is_staff': True, 'is_superuser': True})
u.is_staff = True
u.is_superuser = True
u.set_password('${ADMIN_PASS}')
u.save()
\"" >> "${LOG_FILE}" 2>&1 || true
fi

cat > "${INSTALL_DIR}/start-seedcross.sh" <<EOF
#!/bin/bash
set -euo pipefail
cd "${INSTALL_DIR}"
"${INSTALL_DIR}/.venv/bin/python" manage.py process_tasks &
BG_PID=\$!
trap 'kill "\${BG_PID}" 2>/dev/null || true' EXIT INT TERM
exec "${INSTALL_DIR}/.venv/bin/python" manage.py runserver 0.0.0.0:${APP_PORT} --noreload
EOF
chmod 755 "${INSTALL_DIR}/start-seedcross.sh"
chown "${APP_USER}:${APP_USER}" "${INSTALL_DIR}/start-seedcross.sh"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=SeedCross Automated Torrent Cross-Seeding Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
Environment="HOME=${DATA_DIR}"
Environment="PYTHONUNBUFFERED=1"
ExecStart=${INSTALL_DIR}/start-seedcross.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now seedcross.service >> "${LOG_FILE}" 2>&1

write_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log "${APP_NAME} installation complete."
