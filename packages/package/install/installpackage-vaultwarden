#!/bin/bash
# AetherFlow Package Installer: Vaultwarden
# Port: 8343

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="vaultwarden"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install /opt/AetherFlow/logs

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Vaultwarden..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl jq tar openssl ca-certificates sqlite3 libssl3 >> "$LOGFILE" 2>&1 || \
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl jq tar openssl ca-certificates sqlite3 libssl-dev >> "$LOGFILE" 2>&1

if ! id -u vaultwarden >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/vaultwarden --shell /usr/sbin/nologin vaultwarden
fi

mkdir -p /opt/vaultwarden /var/lib/vaultwarden/data /etc/vaultwarden

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) OCI_ARCH="amd64" ;;
    arm64) OCI_ARCH="arm64" ;;
    armhf) OCI_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Fetching latest Vaultwarden release metadata..."
VW_JSON="$(curl -fsSL https://api.github.com/repos/dani-garcia/vaultwarden/releases/latest 2>/dev/null || true)"
VW_VERSION="$(printf '%s' "$VW_JSON" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1 || true)"
VW_VERSION="${VW_VERSION:-1.32.7}"

report_progress 55 "Extracting prebuilt Vaultwarden binary and Web Vault (${OCI_ARCH})..."
TMP_EXTRACT=$(mktemp -d /tmp/vw-oci-XXXXXX)
VW_TAG="${VW_VERSION#v}"
TOKEN="$(curl -fsSL "https://ghcr.io/token?scope=repository:dani-garcia/vaultwarden:pull" 2>/dev/null | jq -r '.token // empty' || true)"

if [[ -n "$TOKEN" ]]; then
    ACCEPT_INDEX="application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json"
    INDEX="$(curl -fsSL -H "Authorization: Bearer ${TOKEN}" -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${VW_TAG}" 2>/dev/null || \
             curl -fsSL -H "Authorization: Bearer ${TOKEN}" -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${VW_VERSION}" 2>/dev/null || \
             curl -fsSL -H "Authorization: Bearer ${TOKEN}" -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/latest" 2>/dev/null || true)"

    if [[ -n "$INDEX" ]]; then
        MANIFEST_DIGEST="$(printf '%s' "$INDEX" | jq -r --arg arch "$OCI_ARCH" 'if .manifests then (.manifests[] | select(.platform.architecture == $arch and .platform.os == "linux") | .digest) else empty end' | head -n1 || true)"
        if [[ -n "$MANIFEST_DIGEST" ]]; then
            MANIFEST="$(curl -fsSL -H "Authorization: Bearer ${TOKEN}" -H "Accept: application/vnd.oci.image.manifest.v1+json" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${MANIFEST_DIGEST}" 2>/dev/null || true)"
        else
            MANIFEST="$INDEX"
        fi

        for LAYER_DIGEST in $(printf '%s' "$MANIFEST" | jq -r '.layers[]?.digest // empty'); do
            BLOB_FILE="${TMP_EXTRACT}/layer.tar.gz"
            if curl -fsSL -L -H "Authorization: Bearer ${TOKEN}" "https://ghcr.io/v2/dani-garcia/vaultwarden/blobs/${LAYER_DIGEST}" -o "$BLOB_FILE" >> "$LOGFILE" 2>&1; then
                tar -xzf "$BLOB_FILE" -C "$TMP_EXTRACT" vaultwarden web-vault 2>/dev/null || tar -xzf "$BLOB_FILE" -C "$TMP_EXTRACT" ./vaultwarden ./web-vault 2>/dev/null || true
            fi
            rm -f "$BLOB_FILE"
        done
    fi
fi

if [[ ! -f "${TMP_EXTRACT}/vaultwarden" ]]; then
    print_error "Failed to extract vaultwarden binary from official OCI package"
    rm -rf "$TMP_EXTRACT"
    exit 1
fi

install -m 0755 "${TMP_EXTRACT}/vaultwarden" /opt/vaultwarden/vaultwarden
if [[ -d "${TMP_EXTRACT}/web-vault" ]]; then
    rm -rf /opt/vaultwarden/web-vault
    mv "${TMP_EXTRACT}/web-vault" /opt/vaultwarden/web-vault
fi
rm -rf "$TMP_EXTRACT"

printf '%s\n' "${VW_VERSION#v}" > /opt/vaultwarden/.af-version

report_progress 75 "Configuring Vaultwarden environment on port 8343..."
ADMIN_TOKEN="$(openssl rand -base64 48 | tr -d '\n')"
cat <<EOF > /etc/vaultwarden/vaultwarden.env
DATA_FOLDER=/var/lib/vaultwarden/data
WEB_VAULT_FOLDER=/opt/vaultwarden/web-vault
WEB_VAULT_ENABLED=true
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8343
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
ADMIN_TOKEN=${ADMIN_TOKEN}
EOF
chmod 600 /etc/vaultwarden/vaultwarden.env
echo "Vaultwarden Admin Token: ${ADMIN_TOKEN}" > /opt/AetherFlow/logs/vaultwarden_admin_token.txt
chmod 600 /opt/AetherFlow/logs/vaultwarden_admin_token.txt

chown -R vaultwarden:vaultwarden /opt/vaultwarden /var/lib/vaultwarden
chown root:vaultwarden /etc/vaultwarden/vaultwarden.env
chmod 640 /etc/vaultwarden/vaultwarden.env

report_progress 90 "Configuring and starting vaultwarden.service on port 8343..."
cat <<'EOF' > /etc/systemd/system/vaultwarden.service
[Unit]
Description=Vaultwarden Server (Bitwarden compatible)
Documentation=https://github.com/dani-garcia/vaultwarden
After=network.target

[Service]
User=vaultwarden
Group=vaultwarden
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden/vaultwarden
LimitNOFILE=65535
LimitNPROC=4096
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
WorkingDirectory=/var/lib/vaultwarden
ReadWritePaths=/var/lib/vaultwarden /opt/vaultwarden /etc/vaultwarden
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now vaultwarden >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Vaultwarden installed on port 8343."
log_info "${PACKAGE_NAME} installed successfully"
