#!/bin/bash
# AetherFlow Package Installer: Vaultwarden
# Port: 8343

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="vaultwarden"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8343}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /etc/vaultwarden/vaultwarden.env /opt/AetherFlow/logs/vaultwarden_admin_token.txt
install -d -m 0700 /opt/AetherFlow/logs
if [[ -f /etc/vaultwarden/vaultwarden.env ]]; then
    set_config_file_mode 0600 /etc/vaultwarden/vaultwarden.env
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Vaultwarden..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3 curl jq tar openssl ca-certificates sqlite3 libsqlite3-0 libpq5 libmariadb3 >> "$LOGFILE" 2>&1

if ! id -u vaultwarden >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/vaultwarden --shell /usr/sbin/nologin vaultwarden
fi

mkdir -p /opt/vaultwarden /var/lib/vaultwarden/data /etc/vaultwarden

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) OCI_ARCH="amd64" ;;
    arm64) OCI_ARCH="arm64" ;;
    armhf) OCI_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Fetching latest Vaultwarden release metadata..."
VW_VERSION="$(github_latest_tag "dani-garcia/vaultwarden" "1.32.7")"

report_progress 55 "Extracting prebuilt Vaultwarden binary and Web Vault (${OCI_ARCH})..."
TMP_EXTRACT=$(mktemp -d /tmp/vw-oci-XXXXXX)
VW_TAG="${VW_VERSION#v}"
TOKEN="$(curl -fsSL "https://ghcr.io/token?scope=repository:dani-garcia/vaultwarden:pull" 2>/dev/null | jq -r '.token // empty' || true)"

if [[ -n "$TOKEN" ]]; then
    ACCEPT_INDEX="application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json"
    INDEX="$(printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsSL -H @- -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${VW_TAG}" 2>/dev/null || \
             printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsSL -H @- -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${VW_VERSION}" 2>/dev/null || \
             printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsSL -H @- -H "Accept: ${ACCEPT_INDEX}" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/latest" 2>/dev/null || true)"

    if [[ -n "$INDEX" ]]; then
        MANIFEST_DIGEST="$(printf '%s' "$INDEX" | jq -r --arg arch "$OCI_ARCH" 'if .manifests then (.manifests[] | select(.platform.architecture == $arch and .platform.os == "linux") | .digest) else empty end' | head -n1 || true)"
        if [[ -n "$MANIFEST_DIGEST" ]]; then
            MANIFEST="$(printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsSL -H @- -H "Accept: application/vnd.oci.image.manifest.v1+json" "https://ghcr.io/v2/dani-garcia/vaultwarden/manifests/${MANIFEST_DIGEST}" 2>/dev/null || true)"
        else
            MANIFEST="$INDEX"
        fi

        for LAYER_DIGEST in $(printf '%s' "$MANIFEST" | jq -r '.layers[]?.digest // empty'); do
            if [[ ! "$LAYER_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
                print_error "Invalid Vaultwarden OCI layer digest"
                rm -rf "$TMP_EXTRACT"
                exit 1
            fi
            BLOB_FILE="${TMP_EXTRACT}/layer.tar.gz"
            if printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -fsSL -L -H @- "https://ghcr.io/v2/dani-garcia/vaultwarden/blobs/${LAYER_DIGEST}" -o "$BLOB_FILE" >> "$LOGFILE" 2>&1; then
                if ! verify_sha256 "$BLOB_FILE" "${LAYER_DIGEST#sha256:}" "Vaultwarden OCI layer"; then
                    rm -rf "$TMP_EXTRACT"
                    exit 1
                fi
                tar -xzf "$BLOB_FILE" -C "$TMP_EXTRACT" vaultwarden web-vault 2>/dev/null || tar -xzf "$BLOB_FILE" -C "$TMP_EXTRACT" ./vaultwarden ./web-vault 2>/dev/null || true
            fi
            rm -f "$BLOB_FILE"
        done
    fi
fi

if [[ ! -f "${TMP_EXTRACT}/vaultwarden" ]]; then
    print_error "Failed to extract vaultwarden binary from official OCI package"
    rm -rf "$TMP_EXTRACT"
    exit 1
fi

chmod 755 "${TMP_EXTRACT}/vaultwarden"
stage_app_archive "$TMP_EXTRACT" /opt/vaultwarden vaultwarden /var/lib/vaultwarden "$PACKAGE_NAME" "." /etc/vaultwarden

queue_app_version /opt/vaultwarden/.af-version "${VW_VERSION#v}"

report_progress 75 "Configuring Vaultwarden environment on port ${APP_PORT}..."
if [[ -L /etc/vaultwarden/vaultwarden.env ]]; then
    print_error "Refusing symlinked Vaultwarden configuration path"
    exit 1
fi
if [[ -f /etc/vaultwarden/vaultwarden.env ]]; then
    set_config_value /etc/vaultwarden/vaultwarden.env env ROCKET_PORT "$APP_PORT"
else
    ADMIN_TOKEN="${AF_CONFIG_PASS:-$(openssl rand -hex 32)}"
    SIGNUPS_ALLOWED=false
    [[ "${AF_VAULTWARDEN_SIGNUPS_ALLOWED:-false}" != true ]] || SIGNUPS_ALLOWED=true
    (umask 077; write_config_file /etc/vaultwarden/vaultwarden.env 0600 <<EOF
DATA_FOLDER=/var/lib/vaultwarden/data
WEB_VAULT_FOLDER=/opt/vaultwarden/web-vault
WEB_VAULT_ENABLED=true
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=${APP_PORT}
SIGNUPS_ALLOWED=${SIGNUPS_ALLOWED}
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
ADMIN_TOKEN=${ADMIN_TOKEN}
EOF
    printf 'Vaultwarden Admin Token: %s\n' "$ADMIN_TOKEN" | write_config_file /opt/AetherFlow/logs/vaultwarden_admin_token.txt 0600
    )
fi

chown -hRP vaultwarden:vaultwarden /opt/vaultwarden /var/lib/vaultwarden
chown root:vaultwarden /etc/vaultwarden/vaultwarden.env
set_config_file_mode 0600 /etc/vaultwarden/vaultwarden.env

report_progress 90 "Configuring and starting vaultwarden.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/vaultwarden.service
[Unit]
Description=Vaultwarden Server (Bitwarden compatible)
Documentation=https://github.com/dani-garcia/vaultwarden
After=network.target

[Service]
User=vaultwarden
Group=vaultwarden
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden/vaultwarden
LimitNOFILE=65535
LimitNPROC=4096
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
WorkingDirectory=/var/lib/vaultwarden
ReadWritePaths=/var/lib/vaultwarden /opt/vaultwarden /etc/vaultwarden
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now vaultwarden >> "$LOGFILE" 2>&1
systemctl restart vaultwarden >> "$LOGFILE" 2>&1
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/alive"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Vaultwarden installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
