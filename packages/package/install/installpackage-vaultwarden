#!/bin/bash
# AetherFlow Package Installer: Vaultwarden
# Port: 8343

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="vaultwarden"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8343}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /etc/vaultwarden/vaultwarden.env /etc/vaultwarden/admin_token.txt
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Vaultwarden..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq python3 curl jq tar openssl ca-certificates sqlite3 libsqlite3-0 libpq5 libmariadb3

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) OCI_ARCH="amd64" ;;
    arm64) OCI_ARCH="arm64" ;;
    armhf) OCI_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving the Vaultwarden release image..."
VW_VERSION="$(github_latest_tag "dani-garcia/vaultwarden" "1.32.7")"
if [[ ! "$VW_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]]; then
    print_error "Invalid Vaultwarden release version: $VW_VERSION"
    exit 1
fi

OCI_REGISTRY="https://ghcr.io/v2/dani-garcia/vaultwarden"
TOKEN="$(curl --proto '=https' --proto-redir '=https' -fsSL "https://ghcr.io/token?scope=repository:dani-garcia/vaultwarden:pull" | jq -er '.token // empty')"

vaultwarden_oci_fetch() {
    printf 'Authorization: Bearer %s\n' "$TOKEN" |
        curl --proto '=https' --proto-redir '=https' -fsSL -H @- "$@"
}

OCI_ACCEPT="application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json"
if ! MANIFEST="$(vaultwarden_oci_fetch -H "Accept: $OCI_ACCEPT" "$OCI_REGISTRY/manifests/$VW_VERSION" 2>/dev/null)" &&
   ! MANIFEST="$(vaultwarden_oci_fetch -H "Accept: $OCI_ACCEPT" "$OCI_REGISTRY/manifests/v$VW_VERSION" 2>/dev/null)"; then
    print_error "No official Vaultwarden OCI image for exact release $VW_VERSION"
    exit 1
fi

mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_EXTRACT=$(mktemp -d "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/vw-oci-XXXXXX")
trap 'rm -rf -- "$TMP_EXTRACT"' EXIT

MANIFEST_DIGEST="$(jq -r --arg arch "$OCI_ARCH" '
    first(.manifests[]? | select(.platform.os == "linux" and .platform.architecture == $arch
        and ($arch != "arm" or .platform.variant == "v7"))) | .digest // empty
' <<< "$MANIFEST")"
if [[ -n "$MANIFEST_DIGEST" ]]; then
    if [[ ! "$MANIFEST_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
        print_error "Invalid Vaultwarden OCI manifest digest"
        exit 1
    fi
    manifest_file="$TMP_EXTRACT/manifest.json"
    vaultwarden_oci_fetch -H "Accept: $OCI_ACCEPT" "$OCI_REGISTRY/manifests/$MANIFEST_DIGEST" -o "$manifest_file"
    verify_sha256 "$manifest_file" "${MANIFEST_DIGEST#sha256:}" "Vaultwarden OCI manifest"
    MANIFEST="$(< "$manifest_file")"
    rm -f -- "$manifest_file"
fi

CONFIG_DIGEST="$(jq -r '.config.digest // empty' <<< "$MANIFEST")"
if [[ ! "$CONFIG_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
    print_error "No valid Vaultwarden OCI configuration for linux/$OCI_ARCH at release $VW_VERSION"
    exit 1
fi
image_config="$TMP_EXTRACT/image-config.json"
vaultwarden_oci_fetch "$OCI_REGISTRY/blobs/$CONFIG_DIGEST" -o "$image_config"
verify_sha256 "$image_config" "${CONFIG_DIGEST#sha256:}" "Vaultwarden OCI configuration"
IMAGE_VERSION="$(jq -r '.config.Labels["org.opencontainers.image.version"] // empty' < "$image_config")"
rm -f -- "$image_config"
if [[ "${IMAGE_VERSION#[vV]}" != "$VW_VERSION" ]]; then
    print_error "Vaultwarden OCI image version mismatch for release $VW_VERSION"
    exit 1
fi

report_progress 55 "Extracting Vaultwarden $VW_VERSION and Web Vault ($OCI_ARCH)..."
LAYER_DIGESTS="$(jq -er '.layers[].digest' <<< "$MANIFEST")"
while IFS= read -r LAYER_DIGEST; do
    if [[ ! "$LAYER_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
        print_error "Invalid Vaultwarden OCI layer digest"
        exit 1
    fi
    BLOB_FILE="$TMP_EXTRACT/layer.tar.gz"
    af_logged vaultwarden_oci_fetch "$OCI_REGISTRY/blobs/$LAYER_DIGEST" -o "$BLOB_FILE"
    verify_sha256 "$BLOB_FILE" "${LAYER_DIGEST#sha256:}" "Vaultwarden OCI layer"
    tar -xzf "$BLOB_FILE" --no-same-owner --no-same-permissions -C "$TMP_EXTRACT" vaultwarden web-vault 2>/dev/null ||
        tar -xzf "$BLOB_FILE" --no-same-owner --no-same-permissions -C "$TMP_EXTRACT" ./vaultwarden ./web-vault 2>/dev/null || true
    rm -f -- "$BLOB_FILE"
done <<< "$LAYER_DIGESTS"

if [[ ! -f "$TMP_EXTRACT/vaultwarden" || -L "$TMP_EXTRACT/vaultwarden" ]]; then
    print_error "Failed to extract vaultwarden binary from official OCI package"
    exit 1
fi

if ! id -u vaultwarden >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/vaultwarden --shell /usr/sbin/nologin vaultwarden
fi
mkdir -p /opt/vaultwarden /var/lib/vaultwarden/data /etc/vaultwarden

chmod 755 "${TMP_EXTRACT}/vaultwarden"
stage_app_archive "$TMP_EXTRACT" /opt/vaultwarden vaultwarden /var/lib/vaultwarden "$PACKAGE_NAME" "." /etc/vaultwarden

queue_app_version /opt/vaultwarden/.af-version "${VW_VERSION#v}"

report_progress 75 "Configuring Vaultwarden environment on port ${APP_PORT}..."
if [[ -L /etc/vaultwarden/vaultwarden.env ]]; then
    print_error "Refusing symlinked Vaultwarden configuration path"
    exit 1
fi
if [[ -f /etc/vaultwarden/vaultwarden.env ]]; then
    set_config_value /etc/vaultwarden/vaultwarden.env env ROCKET_PORT "$APP_PORT"
else
    ADMIN_TOKEN="${AF_CONFIG_PASS:-$(openssl rand -hex 32)}"
    SIGNUPS_ALLOWED=false
    [[ "${AF_VAULTWARDEN_SIGNUPS_ALLOWED:-false}" != true ]] || SIGNUPS_ALLOWED=true
    (umask 077; write_config_file /etc/vaultwarden/vaultwarden.env 0600 <<EOF
DATA_FOLDER=/var/lib/vaultwarden/data
WEB_VAULT_FOLDER=/opt/vaultwarden/web-vault
WEB_VAULT_ENABLED=true
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=${APP_PORT}
SIGNUPS_ALLOWED=${SIGNUPS_ALLOWED}
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
ADMIN_TOKEN=${ADMIN_TOKEN}
EOF
    install -d -m 0750 /etc/vaultwarden
    printf 'Vaultwarden Admin Token: %s\n' "$ADMIN_TOKEN" | write_config_file /etc/vaultwarden/admin_token.txt 0600
    )
fi

chown -hRP vaultwarden:vaultwarden /opt/vaultwarden /var/lib/vaultwarden
chown root:vaultwarden /etc/vaultwarden/vaultwarden.env
set_config_file_mode 0600 /etc/vaultwarden/vaultwarden.env

report_progress 90 "Configuring and starting vaultwarden.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/vaultwarden.service
[Unit]
Description=Vaultwarden Server (Bitwarden compatible)
Documentation=https://github.com/dani-garcia/vaultwarden
After=network.target

[Service]
User=vaultwarden
Group=vaultwarden
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden/vaultwarden
LimitNOFILE=65535
LimitNPROC=4096
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
WorkingDirectory=/var/lib/vaultwarden
ReadWritePaths=/var/lib/vaultwarden /opt/vaultwarden /etc/vaultwarden
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/vaultwarden.service

af_logged systemctl daemon-reload
af_logged systemctl enable --now vaultwarden
af_logged systemctl restart vaultwarden
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/alive"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Vaultwarden installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
