#!/bin/bash
# AetherFlow Package Installer: Recyclarr
# Port: 0 (Scheduled TRaSH sync service + timer)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="recyclarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites and archive tools for Recyclarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl xz-utils tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u recyclarr >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/recyclarr --shell /usr/sbin/nologin recyclarr
fi

mkdir -p /var/lib/recyclarr /etc/recyclarr /opt/recyclarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) REC_ARCH="x64" ;;
    arm64) REC_ARCH="arm64" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Recyclarr release..."
REC_JSON="$(curl -fsSL https://api.github.com/repos/recyclarr/recyclarr/releases/latest 2>/dev/null || true)"
REC_VERSION="$(printf '%s' "$REC_JSON" | grep -oP '"tag_name":\s*"v\K[^"]+' | head -1 || true)"
REC_VERSION="${REC_VERSION:-7.4.0}"
REC_URL="$(printf '%s' "$REC_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*recyclarr-linux-'${REC_ARCH}'\.tar\.xz' | head -1 || true)"
if [[ -z "$REC_URL" ]]; then
    REC_URL="https://github.com/recyclarr/recyclarr/releases/download/v${REC_VERSION}/recyclarr-linux-${REC_ARCH}.tar.xz"
fi

report_progress 60 "Downloading Recyclarr ${REC_VERSION} (${REC_ARCH})..."
TMP_XZ=$(mktemp /tmp/recyclarr-XXXXXX.tar.xz)
curl -fsSL "$REC_URL" -o "$TMP_XZ" >> "$LOGFILE" 2>&1
tar -xJf "$TMP_XZ" -C /usr/local/bin recyclarr >> "$LOGFILE" 2>&1
rm -f "$TMP_XZ"
chmod 755 /usr/local/bin/recyclarr
printf '%s\n' "${REC_VERSION#v}" > /opt/recyclarr/.af-version

report_progress 75 "Discovering local Sonarr and Radarr API keys for Recyclarr configuration..."
get_arr_key() {
    local app="$1"
    local xml_file="/var/lib/${app}/config.xml"
    if [[ -f "$xml_file" ]]; then
        grep -oP '<ApiKey>\K[^<]+' "$xml_file" 2>/dev/null || sed -n 's/.*<ApiKey>\(.*\)<\/ApiKey>.*/\1/p' "$xml_file" 2>/dev/null || true
    fi
}

SONARR_KEY=$(get_arr_key "sonarr")
RADARR_KEY=$(get_arr_key "radarr")

cat <<EOF > /var/lib/recyclarr/recyclarr.yml
# Recyclarr TRaSH Guides Configuration - Generated by AetherFlow
EOF

if [[ -n "$SONARR_KEY" ]]; then
    cat <<EOF >> /var/lib/recyclarr/recyclarr.yml
sonarr:
  - name: sonarr
    base_url: http://127.0.0.1:8989
    api_key: "${SONARR_KEY}"
    delete_old_custom_formats: true
    replace_existing_custom_formats: true
    quality_definition:
      type: series
    custom_formats:
      - trash_ids:
          - 32b38050c97746468a35606d15b0a340 # Web-1080p
EOF
fi

if [[ -n "$RADARR_KEY" ]]; then
    cat <<EOF >> /var/lib/recyclarr/recyclarr.yml
radarr:
  - name: radarr
    base_url: http://127.0.0.1:7878
    api_key: "${RADARR_KEY}"
    delete_old_custom_formats: true
    replace_existing_custom_formats: true
    quality_definition:
      type: movie
    custom_formats:
      - trash_ids:
          - ed27ebf1e0c30e61081a00392fa50058 # Remux-1080p
EOF
fi

if [[ -z "$SONARR_KEY" && -z "$RADARR_KEY" ]]; then
    cat <<'EOF' >> /var/lib/recyclarr/recyclarr.yml
# Example template (waiting for Sonarr or Radarr installation):
# sonarr:
#   - name: sonarr
#     base_url: http://127.0.0.1:8989
#     api_key: YOUR_API_KEY
EOF
fi

chown -R recyclarr:recyclarr /var/lib/recyclarr /etc/recyclarr /opt/recyclarr
chmod 640 /var/lib/recyclarr/recyclarr.yml

report_progress 85 "Creating and configuring recyclarr.service and companion recyclarr.timer..."
cat <<'EOF' > /etc/systemd/system/recyclarr.service
[Unit]
Description=Recyclarr TRaSH Guides Synchronizer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=recyclarr
Group=recyclarr
WorkingDirectory=/var/lib/recyclarr
ExecStart=/usr/local/bin/recyclarr sync --config /var/lib/recyclarr/recyclarr.yml
EOF

cat <<'EOF' > /etc/systemd/system/recyclarr.timer
[Unit]
Description=Daily Recyclarr TRaSH Guides Synchronization Timer

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now recyclarr.timer >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Recyclarr installed (companion timer active)."
log_info "${PACKAGE_NAME} installed successfully"
