#!/bin/bash
# AetherFlow Package Installer: Recyclarr
# Port: 0 (Scheduled TRaSH sync service + timer)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="recyclarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
af_prepare_job_scratch "$PACKAGE_NAME"
validate_config_paths /var/lib/recyclarr/recyclarr.yml
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites and archive tools for Recyclarr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl xz-utils tar ca-certificates

if ! id -u recyclarr >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/recyclarr --shell /usr/sbin/nologin recyclarr
fi

mkdir -p /var/lib/recyclarr /etc/recyclarr /opt/recyclarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) REC_ARCH="x64" ;;
    arm64) REC_ARCH="arm64" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Recyclarr release..."
REC_VERSION="$(github_latest_tag "recyclarr/recyclarr" "7.4.0")"
REC_URL="https://github.com/recyclarr/recyclarr/releases/download/v${REC_VERSION}/recyclarr-linux-${REC_ARCH}.tar.xz"

report_progress 60 "Downloading Recyclarr ${REC_VERSION} (${REC_ARCH})..."
TMP_XZ="$(mktemp "${AF_JOB_SCRATCH_DIR}/recyclarr-XXXXXX.tar.xz")"
af_logged download_file "$REC_URL" "$TMP_XZ"
TMP_DIR="$(mktemp -d "${AF_JOB_SCRATCH_DIR}/recyclarr-extract-XXXXXX")"
trap '[[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"; rm -f -- "$TMP_XZ"; af_cleanup_job_scratch 1 || true' EXIT
af_logged tar -xJf "$TMP_XZ" -C "$TMP_DIR" recyclarr
rm -f -- "$TMP_XZ"
chmod 755 "$TMP_DIR/recyclarr"
stage_app_archive "$TMP_DIR" /usr/local/bin/recyclarr recyclarr /var/lib/recyclarr "$PACKAGE_NAME" "." /opt/recyclarr "" binary
TMP_DIR=""
chmod 755 /usr/local/bin/recyclarr
queue_app_version /opt/recyclarr/.af-version "${REC_VERSION#v}"

report_progress 75 "Discovering local Sonarr and Radarr API keys for Recyclarr configuration..."
get_arr_key() {
    local app="$1"
    local xml_file="/var/lib/${app}/config.xml"
    if [[ -f "$xml_file" ]]; then
        grep -oP '<ApiKey>\K[^<]+' "$xml_file" 2>/dev/null || sed -n 's/.*<ApiKey>\(.*\)<\/ApiKey>.*/\1/p' "$xml_file" 2>/dev/null || true
    fi
}

SONARR_KEY=$(get_arr_key "sonarr")
RADARR_KEY=$(get_arr_key "radarr")

if [[ ! -f /var/lib/recyclarr/recyclarr.yml ]]; then
cat <<EOF > /var/lib/recyclarr/recyclarr.yml
# Recyclarr TRaSH Guides Configuration - Generated by AetherFlow
EOF

if [[ -n "$SONARR_KEY" ]]; then
    cat <<EOF >> /var/lib/recyclarr/recyclarr.yml
sonarr:
  sonarr:
    base_url: http://127.0.0.1:8989
    api_key: "${SONARR_KEY}"
    delete_old_custom_formats: true
    quality_definition:
      type: series
    custom_formats:
      - trash_ids:
          - 32b38050c97746468a35606d15b0a340 # Web-1080p
EOF
fi

if [[ -n "$RADARR_KEY" ]]; then
    cat <<EOF >> /var/lib/recyclarr/recyclarr.yml
radarr:
  radarr:
    base_url: http://127.0.0.1:7878
    api_key: "${RADARR_KEY}"
    delete_old_custom_formats: true
    quality_definition:
      type: movie
    custom_formats:
      - trash_ids:
          - ed27ebf1e0c30e61081a00392fa50058 # Remux-1080p
EOF
fi

if [[ -z "$SONARR_KEY" && -z "$RADARR_KEY" ]]; then
    cat <<'EOF' >> /var/lib/recyclarr/recyclarr.yml
# Example template (waiting for Sonarr or Radarr installation):
# sonarr:
#   sonarr:
#     base_url: http://127.0.0.1:8989
#     api_key: YOUR_API_KEY
EOF
fi
fi

chown -hRP recyclarr:recyclarr /var/lib/recyclarr /etc/recyclarr /opt/recyclarr
chmod 640 /var/lib/recyclarr/recyclarr.yml

report_progress 85 "Creating and configuring recyclarr.service and companion recyclarr.timer..."
cat <<'EOF' > /etc/systemd/system/recyclarr.service
[Unit]
Description=Recyclarr TRaSH Guides Synchronizer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=recyclarr
Group=recyclarr
WorkingDirectory=/var/lib/recyclarr
ExecStart=/usr/local/bin/recyclarr sync --config /var/lib/recyclarr/recyclarr.yml
EOF

cat <<'EOF' > /etc/systemd/system/recyclarr.timer
[Unit]
Description=Daily Recyclarr TRaSH Guides Synchronization Timer

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true

[Install]
WantedBy=timers.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now recyclarr.timer
systemctl is-active --quiet recyclarr.timer
rm -rf -- "$AF_ARCHIVE_BACKUP/release"

commit_app_versions
af_cleanup_job_scratch 0 || true
write_lock "${PACKAGE_NAME}"
report_progress 100 "Recyclarr installed (companion timer active)."
log_info "${PACKAGE_NAME} installed successfully"
