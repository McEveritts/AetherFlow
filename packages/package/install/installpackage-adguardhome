#!/bin/bash
# AetherFlow Package Installer: AdGuard Home
# Port: 3080

set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="adguardhome"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3080}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /opt/AdGuardHome/AdGuardHome.yaml /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf
DNS_PORT="${AF_DNS_PORT:-53}"
if [[ ! "$DNS_PORT" =~ ^[0-9]{1,5}$ ]] || (( 10#$DNS_PORT < 1 || 10#$DNS_PORT > 65535 )); then
    print_error "AF_DNS_PORT must be between 1 and 65535."
    exit 1
fi
check_dns_port_53_available "adguardhome" "pihole" "AdGuardHome" "$DNS_PORT"
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites and preparing network environment..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl tar ca-certificates libcap2-bin apache2-utils

if ! id -u adguardhome >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /opt/AdGuardHome --shell /usr/sbin/nologin adguardhome
fi

mkdir -p /opt/AdGuardHome

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) AGH_ARCH="linux_amd64" ;;
    arm64) AGH_ARCH="linux_arm64" ;;
    armhf) AGH_ARCH="linux_armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest AdGuard Home release (${AGH_ARCH})..."
AGH_VERSION="$(github_latest_tag "AdguardTeam/AdGuardHome" "0.107.56")"
AGH_URL="https://github.com/AdguardTeam/AdGuardHome/releases/download/v${AGH_VERSION}/AdGuardHome_${AGH_ARCH}.tar.gz"

report_progress 60 "Downloading and extracting AdGuard Home ${AGH_VERSION}..."
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_TAR="$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/agh-XXXXXX.tar.gz")"
if ! af_logged download_file "$AGH_URL" "$TMP_TAR"; then
    # Fallback to static cdn URL
    STATIC_URL="https://static.adguard.com/adguardhome/release/AdGuardHome_${AGH_ARCH}.tar.gz"
    af_logged download_file "$STATIC_URL" "$TMP_TAR"
fi

validate_config_paths /opt/AdGuardHome/AdGuardHome.yaml
stage_app_archive "$TMP_TAR" "/opt/AdGuardHome" "AdGuardHome" "/etc/systemd/resolved.conf" "${PACKAGE_NAME}" "AdGuardHome" "/etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf" "preserve"
rm -f "$TMP_TAR"
validate_config_paths /opt/AdGuardHome/AdGuardHome.yaml
chmod 0755 /opt/AdGuardHome/AdGuardHome
queue_app_version /opt/AdGuardHome/.af-version "${AGH_VERSION#v}"

if [[ ! -f /opt/AdGuardHome/AdGuardHome.yaml ]]; then
    AGH_PASS="${AF_CONFIG_PASS:-$MASTER_PASS}"
    AGH_BCRYPT="$(printf '%s\n' "$AGH_PASS" | htpasswd -niB "${MASTER_USER}" 2>/dev/null | cut -d: -f2- || true)"
    if [[ -z "${AGH_BCRYPT:-}" ]]; then
        print_error "Failed to generate bcrypt password hash for AdGuard Home."
        exit 1
    fi
    write_config_file /opt/AdGuardHome/AdGuardHome.yaml 0600 <<EOF
bind_host: 127.0.0.1
bind_port: ${APP_PORT}
auth_attempts: 5
block_auth_min: 15
http:
  pprof:
    port: 0
    enabled: false
  address: 127.0.0.1:${APP_PORT}
  session_ttl: 720h
users:
  - name: ${MASTER_USER}
    password: ${AGH_BCRYPT}
dns:
  bind_hosts:
    - 0.0.0.0
  port: ${DNS_PORT}
  upstream_dns:
    - 1.1.1.1
    - 8.8.8.8
EOF
else
    safe_config_python /opt/AdGuardHome/AdGuardHome.yaml "$APP_PORT" <<'PYEOF'
import re, sys
port = sys.argv[2]
if not port.isdecimal() or not 1 <= int(port) <= 65535:
    raise ValueError('Invalid AdGuard Home HTTP port')
with ManagedConfig(sys.argv[1], create_parents=False) as config:
    text = config.read_text()
    text = re.sub(r'(?m)^(bind_port:[ \t]*)\d+', lambda match: match.group(1) + port, text)
    header = re.search(r'(?m)^http:[ \t]*(?:#[^\n]*)?$', text)
    if header:
        start = header.end()
        boundary = re.search(r'(?m)^[^\s#][^\n]*:', text[start:])
        end = start + boundary.start() if boundary else len(text)
        block = text[start:end]
        address = re.search(r'(?m)^([ \t]+address:[ \t]*)([^\n]*)$', block)
        if address:
            scalar = re.fullmatch(r'''("[^"]*"|'[^']*'|[^#]*?)([ \t]*(?:#.*)?)''', address.group(2))
            if scalar is None:
                raise ValueError('Invalid retained AdGuard Home HTTP address')
            value = scalar.group(1).strip()
            quote = value[:1] if value[:1] in ('"', "'") else ''
            endpoint = value[1:-1] if quote else value
            host, separator, previous_port = endpoint.rpartition(':')
            if not separator or not previous_port.isdecimal() or not re.fullmatch(r'[a-zA-Z0-9_.:\[\]-]*', host):
                raise ValueError('Invalid retained AdGuard Home HTTP listener')
            setting = address.group(1) + quote + host + ':' + port + quote + scalar.group(2)
            block = block[:address.start()] + setting + block[address.end():]
        else:
            host = re.search(r'(?m)^bind_host:[ \t]*([^\n#]+)', text)
            host = host.group(1).strip().strip('\'"') if host else '127.0.0.1'
            if not re.fullmatch(r'[a-zA-Z0-9_.:\[\]-]+', host):
                raise ValueError('Invalid retained AdGuard Home bind host')
            block = '\n  address: ' + (f'[{host}]' if ':' in host and not host.startswith('[') else host) + ':' + port + block
        text = text[:start] + block + text[end:]
    else:
        host = re.search(r'(?m)^bind_host:[ \t]*([^\n#]+)', text)
        host = host.group(1).strip().strip('\'"') if host else '127.0.0.1'
        if not re.fullmatch(r'[a-zA-Z0-9_.:\[\]-]+', host):
            raise ValueError('Invalid retained AdGuard Home bind host')
        text = text.rstrip('\n') + '\nhttp:\n  address: ' + (f'[{host}]' if ':' in host and not host.startswith('[') else host) + ':' + port + '\n'
    config.write_text(text, 0o600)
PYEOF
fi

validate_config_paths /opt/AdGuardHome/AdGuardHome.yaml
chown -hRP adguardhome:adguardhome /opt/AdGuardHome
set_config_file_mode 0600 /opt/AdGuardHome/AdGuardHome.yaml
af_logged setcap 'cap_net_bind_service=+ep' /opt/AdGuardHome/AdGuardHome || true

AGH_DNS_PRE_SNAPSHOT=""
AGH_DNS_HANDOFF_NEEDED=false
rollback_adguardhome_dns() {
    if [[ -n "${AGH_DNS_PRE_SNAPSHOT:-}" && -d "$AGH_DNS_PRE_SNAPSHOT" ]]; then
        python3 - "$AGH_DNS_PRE_SNAPSHOT" <<'PYEOF'
import json, os, pathlib, secrets, shutil, stat, sys

snap = pathlib.Path(sys.argv[1])
resolv_str = "/etc/resolv.conf"
backup_dir = pathlib.Path("/etc/aetherflow/dns-backup")
meta_path = snap / "meta.json"
if not meta_path.is_file():
    raise SystemExit(0)
meta = json.loads(meta_path.read_text(encoding="utf-8"))
kind = meta.get("resolv_kind")
rdir = os.path.dirname(resolv_str)
rname = os.path.basename(resolv_str)
if kind == "symlink":
    tmp = os.path.join(rdir, f".{rname}.af-rb.{secrets.token_hex(6)}")
    os.symlink(meta["resolv_target"], tmp)
    os.replace(tmp, resolv_str)
elif kind == "file" and (snap / "resolv.conf").is_file():
    tmp = os.path.join(rdir, f".{rname}.af-rb.{secrets.token_hex(6)}")
    mode = int(meta.get("resolv_mode") or 0o644) & 0o644
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        os.fchmod(fd, mode)
        os.write(fd, (snap / "resolv.conf").read_bytes())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, resolv_str)
elif kind == "absent":
    try:
        os.unlink(resolv_str)
    except FileNotFoundError:
        pass

for name in ("adguardhome-resolv.conf.state", "adguardhome-resolv.conf.bak"):
    dest = backup_dir / name
    saved = snap / name
    if saved.is_file():
        backup_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(saved, dest)
        os.chmod(dest, 0o600)
    else:
        try:
            dest.unlink()
        except FileNotFoundError:
            pass
PYEOF
    fi
}

if [[ "$DNS_PORT" == "53" ]]; then
AGH_DNS_PRE_SNAPSHOT="${AF_ARCHIVE_BACKUP}/dns-pre-run"
mkdir -p -m 0700 "$AGH_DNS_PRE_SNAPSHOT"
python3 - "$AGH_DNS_PRE_SNAPSHOT" <<'PYEOF'
import json, os, pathlib, shutil, stat, sys

snap = pathlib.Path(sys.argv[1])
resolv_str = "/etc/resolv.conf"
backup_dir = pathlib.Path("/etc/aetherflow/dns-backup")
meta = {"resolv_kind": "absent"}
try:
    st = os.lstat(resolv_str)
except FileNotFoundError:
    pass
else:
    if stat.S_ISLNK(st.st_mode):
        meta = {"resolv_kind": "symlink", "resolv_target": os.readlink(resolv_str)}
    elif stat.S_ISREG(st.st_mode):
        shutil.copyfile(resolv_str, snap / "resolv.conf")
        meta = {"resolv_kind": "file", "resolv_mode": stat.S_IMODE(st.st_mode)}
(snap / "meta.json").write_text(json.dumps(meta), encoding="utf-8")
for name in ("adguardhome-resolv.conf.state", "adguardhome-resolv.conf.bak"):
    src = backup_dir / name
    if src.is_file() and not src.is_symlink():
        shutil.copy2(src, snap / name)
PYEOF
AF_ARCHIVE_ROLLBACK_HOOK="rollback_adguardhome_dns"
af_backup_resolv_conf_state "adguardhome"

AGH_RESOLV_USES_STUB="$(python3 - <<'PYEOF'
import os, stat
resolv_str = "/etc/resolv.conf"
try:
    st = os.lstat(resolv_str)
except FileNotFoundError:
    print("false")
else:
    if stat.S_ISLNK(st.st_mode):
        target = os.readlink(resolv_str)
        print("true" if "stub-resolv.conf" in target else "false")
    elif stat.S_ISREG(st.st_mode):
        with open(resolv_str, "r", encoding="utf-8", errors="replace") as fh:
            lines = [ln.strip() for ln in fh if ln.strip() and not ln.strip().startswith("#")]
        ns = [ln.split()[1] for ln in lines if ln.startswith("nameserver ") and len(ln.split()) >= 2]
        print("true" if ns == ["127.0.0.53"] else "false")
    else:
        print("false")
PYEOF
)"

AGH_RESOLVED_CHANGED="$(safe_config_python /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf <<'PYEOF'
import re, sys
with ManagedConfig(sys.argv[1], create_parents=False) as config:
    if config.metadata is not None:
        settings = re.findall(r'(?m)^[ \t]*DNSStubListener[ \t]*=[ \t]*([^\n#]*)', config.read_text())
        if not settings or settings[-1].strip().lower() not in ('no', 'false', 'off', '0'):
            with ManagedConfig(sys.argv[2]) as dropin:
                desired = '[Resolve]\nDNSStubListener=no\n'
                if dropin.read_text() != desired:
                    dropin.write_text(desired, 0o644)
                    print('changed')
PYEOF
)"
if [[ "$AGH_RESOLVED_CHANGED" == changed ]]; then
    AF_ARCHIVE_ROLLBACK_RESTART_UNITS+=(systemd-resolved)
    if [[ "$AGH_RESOLV_USES_STUB" == "true" ]]; then
        AGH_DNS_HANDOFF_NEEDED=true
        if [[ -e /run/systemd/resolve/resolv.conf ]]; then
            ln -sfnT /run/systemd/resolve/resolv.conf /etc/resolv.conf
        fi
    fi
    af_logged systemctl restart systemd-resolved
elif [[ "$AGH_RESOLV_USES_STUB" == "true" && -f /etc/systemd/resolved.conf.d/aetherflow-adguardhome.conf ]]; then
    AGH_DNS_HANDOFF_NEEDED=true
fi
fi

report_progress 85 "Configuring and starting adguardhome.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/adguardhome.service
[Unit]
Description=AdGuard Home: Network-level HTTP & DNS Blocker
ConditionFileIsExecutable=/opt/AdGuardHome/AdGuardHome
After=syslog.target network-online.target
Wants=network-online.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart=/opt/AdGuardHome/AdGuardHome -c /opt/AdGuardHome/AdGuardHome.yaml -w /opt/AdGuardHome
WorkingDirectory=/opt/AdGuardHome
User=adguardhome
Group=adguardhome
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/adguardhome.service

af_logged systemctl daemon-reload
af_logged systemctl enable --now adguardhome
systemctl is-active --quiet adguardhome

finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "/"
if [[ "$DNS_PORT" == "53" ]]; then
    af_verify_local_dns_lookup "$DNS_PORT"
    if [[ "$AGH_DNS_HANDOFF_NEEDED" == "true" ]]; then
        af_write_resolv_conf_nameserver "127.0.0.1" "/etc/resolv.conf"
    fi
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "AdGuard Home installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
