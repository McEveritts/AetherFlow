#!/bin/bash
#
# [AetherFlow Install Script - Dispatcharr]
# Installs Dispatcharr IPTV/M3U stream proxy and management dashboard.
# Data lives in marker-proven dedicated storage behind an exclusive /data link.
# Shared /data and nonempty unmarked legacy storage require audited operator migration.
#
set -Eeuo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="dispatcharr"
APP_NAME="dispatcharr"
APP_USER="dispatcharr"
INSTALL_DIR="/opt/dispatcharr"
DATA_DIR="/var/lib/dispatcharr"
CONFIG_DIR="/etc/dispatcharr"
SERVICE_FILE="/etc/systemd/system/dispatcharr.service"
CELERY_SERVICE_FILE="/etc/systemd/system/dispatcharr-celery.service"
BEAT_SERVICE_FILE="/etc/systemd/system/dispatcharr-celerybeat.service"
APP_PORT_SUPPLIED="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-}}"
APP_PORT="${APP_PORT_SUPPLIED:-9191}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

BUILD_DIR=""
BACKUP_DIR=""
ENV_FILE_TMP=""
APP_MOVED=0
APP_ACTIVATED=0
CONFIG_CHANGED=0
SERVICES_STOPPED=0
SUCCESS=0
ACTIVE_UNITS=()
SERVICE_FILES=("${SERVICE_FILE}" "${CELERY_SERVICE_FILE}" "${BEAT_SERVICE_FILE}")

cleanup_dispatcharr() {
    local status=$? service_file config_name
    trap - ERR EXIT
    if [[ "${BASH_SUBSHELL}" -gt 0 ]]; then
        exit "${status}"
    fi
    set +e
    if [[ "${SUCCESS}" -ne 1 ]]; then
        if [[ "${SERVICES_STOPPED}" -eq 1 ]]; then
            systemctl stop dispatcharr-celerybeat.service dispatcharr-celery.service dispatcharr.service >> "$LOGFILE" 2>&1
        fi
        if [[ "${APP_ACTIVATED}" -eq 1 ]]; then
            mv -T "${INSTALL_DIR}" "${BACKUP_DIR}/failed-app"
        fi
        if [[ "${APP_MOVED}" -eq 1 ]]; then
            mv -T "${BACKUP_DIR}/app" "${INSTALL_DIR}"
        fi
        if [[ "${CONFIG_CHANGED}" -eq 1 ]]; then
            for config_name in dispatcharr.env db_pass secret_key; do
                if [[ -f "${BACKUP_DIR}/${config_name}" ]]; then
                    cp -a -- "${BACKUP_DIR}/${config_name}" "${CONFIG_DIR}/${config_name}"
                else
                    rm -f -- "${CONFIG_DIR}/${config_name}"
                fi
            done
            for service_file in "${SERVICE_FILES[@]}"; do
                if [[ -f "${BACKUP_DIR}/$(basename "${service_file}")" ]]; then
                    cp -a -- "${BACKUP_DIR}/$(basename "${service_file}")" "${service_file}"
                else
                    systemctl disable "$(basename "${service_file}")" >> "$LOGFILE" 2>&1
                    rm -f -- "${service_file}"
                fi
            done
            systemctl daemon-reload >> "$LOGFILE" 2>&1
        fi
        if [[ -s "${BACKUP_DIR}/db.dump" && "${APP_ACTIVATED}" -eq 1 ]]; then
            su - postgres -c 'dropdb --if-exists --force dispatcharr && createdb --owner=dispatcharr dispatcharr && pg_restore --clean --if-exists --no-owner --role=dispatcharr --dbname=dispatcharr' < "${BACKUP_DIR}/db.dump" >> "$LOGFILE" 2>&1 || log_error "Database rollback failed; snapshot retained in ${BACKUP_DIR}/db.dump"
        fi
        if [[ "${SERVICES_STOPPED}" -eq 1 && "${#ACTIVE_UNITS[@]}" -gt 0 ]]; then
            systemctl start "${ACTIVE_UNITS[@]}" >> "$LOGFILE" 2>&1 || log_error "Previous Dispatcharr services could not be restarted. See ${LOGFILE}."
        fi
    fi
    if [[ -n "${BUILD_DIR}" && -d "${BUILD_DIR}" ]]; then
        rm -rf -- "${BUILD_DIR}"
    fi
    if [[ -n "${ENV_FILE_TMP}" ]]; then
        rm -f -- "${ENV_FILE_TMP}"
    fi
    exit "${status}"
}
trap cleanup_dispatcharr ERR EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ ! "${APP_PORT}" =~ ^[0-9]{1,5}$ ]] || (( 10#${APP_PORT} < 1 || 10#${APP_PORT} > 65535 )); then
    log_error "Invalid Dispatcharr port: ${APP_PORT}"
    exit 1
fi

dispatcharr_confined_path() {
    local path="$1"
    if [[ "$(readlink -m -- "${path}")" != "${path}" ]]; then
        printf '[ERROR] Dispatcharr path traverses a symlink: %s\n' "${path}" >&2
        return 1
    fi
}

dispatcharr_owned_data() {
    local data_mode marker_mode
    [[ -d "${DATA_DIR}" && ! -L "${DATA_DIR}" && -O "${DATA_DIR}" && -f "${DATA_MARKER}" && ! -L "${DATA_MARKER}" && -O "${DATA_MARKER}" ]] || return 1
    data_mode="$(stat -c %a -- "${DATA_DIR}")" || return 1
    marker_mode="$(stat -c %a -- "${DATA_MARKER}")" || return 1
    (( (8#${data_mode} & 0022) == 0 && (8#${marker_mode} & 0022) == 0 )) || return 1
    [[ "$(stat -c %h -- "${DATA_MARKER}")" == 1 && "$(cat -- "${DATA_MARKER}")" == "aetherflow-dispatcharr-data-v1:${DATA_DIR}" ]]
}

validate_dispatcharr_data() {
    local path entry
    for path in "${INSTALL_DIR}" "${DATA_DIR}" "${CONFIG_DIR}" /install /etc/systemd/system; do
        dispatcharr_confined_path "${path}" || return 1
    done
    if [[ -L /data ]]; then
        if [[ "$(readlink -m /data)" != "${DATA_DIR}" ]]; then
            printf '[ERROR] /data is an unrelated symlink; refusing to replace it.\n' >&2
            return 1
        fi
    elif [[ -e /data ]]; then
        printf '[ERROR] /data must be an exclusive Dispatcharr compatibility symlink, not a real directory or file. Shared and legacy data is retained; explicit operator migration is required.\n' >&2
        return 1
    fi
    if ! dispatcharr_owned_data; then
        if [[ -e "${DATA_DIR}" ]]; then
            if [[ ! -d "${DATA_DIR}" ]]; then
                printf '[ERROR] %s must be a real dedicated directory.\n' "${DATA_DIR}" >&2
                return 1
            fi
            entry="$(find "${DATA_DIR}" -mindepth 1 -maxdepth 1 -print -quit)" || return 1
            if [[ -n "${entry}" ]]; then
                printf '[ERROR] Ownership of %s is not established. Legacy data is retained; explicit operator migration is required.\n' "${DATA_DIR}" >&2
                return 1
            fi
        fi
    fi
    for path in logos recordings uploads m3us epgs plugins backups logs cache media logo_cache uploads/m3us uploads/epgs; do
        if [[ -L "${DATA_DIR}/${path}" || ( -e "${DATA_DIR}/${path}" && ! -d "${DATA_DIR}/${path}" ) ]]; then
            printf '[ERROR] %s must be a real directory inside owned storage.\n' "${DATA_DIR}/${path}" >&2
            return 1
        fi
    done
}

prepare_dispatcharr_data() {
    local path
    validate_dispatcharr_data
    if ! dispatcharr_owned_data; then
        mkdir -p "${DATA_DIR}"
        chown root:root "${DATA_DIR}"
        chmod 755 "${DATA_DIR}"
        (umask 077; set -o noclobber; printf '%s\n' "aetherflow-dispatcharr-data-v1:${DATA_DIR}" > "${DATA_MARKER}")
        chown root:root "${DATA_MARKER}"
        chmod 600 "${DATA_MARKER}"
    fi
    for path in logos recordings uploads m3us epgs plugins backups logs cache media logo_cache uploads/m3us uploads/epgs; do
        if [[ ! -d "${DATA_DIR}/${path}" ]]; then
            mkdir "${DATA_DIR}/${path}"
            chown "${APP_USER}:${APP_USER}" "${DATA_DIR}/${path}"
        fi
    done
    if [[ ! -L /data ]]; then
        ln -s "${DATA_DIR}" /data
    fi
}

DATA_MARKER="${DATA_DIR}/.aetherflow-data-owner"
validate_dispatcharr_data
if [[ -z "${APP_PORT_SUPPLIED}" && -f "${CONFIG_DIR}/dispatcharr.env" && ! -L "${CONFIG_DIR}/dispatcharr.env" ]]; then
    retained_port="$(python3 - "${CONFIG_DIR}/dispatcharr.env" <<'PYEOF'
from pathlib import Path
import re
import shlex
import sys

port = ""
for line in Path(sys.argv[1]).read_text().splitlines():
    match = re.match(r"\s*(?:export\s+)?DISPATCHARR_PORT=(.*)", line)
    if match:
        values = shlex.split(match.group(1), comments=True)
        if len(values) != 1:
            raise ValueError("Invalid retained Dispatcharr port")
        port = values[0]
print(port)
PYEOF
)"
    APP_PORT="${retained_port:-${APP_PORT}}"
    export AF_APP_PORT="${APP_PORT}"
    if [[ ! "${APP_PORT}" =~ ^[0-9]{1,5}$ ]] || (( 10#${APP_PORT} < 1 || 10#${APP_PORT} > 65535 )); then
        log_error "Invalid retained Dispatcharr port: ${APP_PORT}"
        exit 1
    fi
fi

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_USER="${MASTER_USER}"
ADMIN_PASS="${MASTER_PASS}"
ADMIN_EMAIL="${ADMIN_USER}@localhost"

report_progress 20 "Installing system dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
if ! DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget git jq ca-certificates build-essential pkg-config \
    libssl-dev libpcre2-dev python3 python3-venv python3-dev python3-pip \
    libpq-dev redis-server postgresql postgresql-contrib openssl ffmpeg streamlink procps >> "$LOGFILE" 2>&1; then
    # Fallback if libpcre2-dev is unavailable on older Debian/Ubuntu
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        curl wget git jq ca-certificates build-essential pkg-config \
        libssl-dev libpcre3-dev python3 python3-venv python3-dev python3-pip \
        libpq-dev redis-server postgresql postgresql-contrib openssl ffmpeg streamlink procps >> "$LOGFILE" 2>&1 || \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        curl wget git jq ca-certificates build-essential pkg-config \
        libssl-dev python3 python3-venv python3-dev python3-pip \
        libpq-dev redis-server postgresql postgresql-contrib openssl ffmpeg streamlink procps >> "$LOGFILE" 2>&1
fi

report_progress 30 "Provisioning Node.js runtime for web frontend build..."
ensure_node 22

# Dispatcharr v0.33.0 (Django 6) requires Python 3.13 or newer.
PYTHON_BIN="$(command -v python3.13 || command -v python3)"
if ! "${PYTHON_BIN}" -c 'import sys; sys.exit(sys.version_info < (3, 13))'; then
    log_error "Dispatcharr v0.33.0 requires Python 3.13 or newer. Install it before retrying."
    exit 1
fi

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
if [[ -L "${INSTALL_DIR}" || -L "${DATA_DIR}" || -L "${CONFIG_DIR}" ]]; then
    log_error "Dispatcharr installation, data, and configuration roots must not be symlinks."
    exit 1
fi
mkdir -p "${DATA_DIR}" "${CONFIG_DIR}"
chown "root:${APP_USER}" "${CONFIG_DIR}"
chmod 750 "${CONFIG_DIR}"
BACKUP_DIR="$(mktemp -d "${INSTALL_DIR}.af-backup.XXXXXX")"
chmod 700 "${BACKUP_DIR}"
for config_name in dispatcharr.env db_pass secret_key; do
    if [[ -L "${CONFIG_DIR}/${config_name}" ]]; then
        log_error "${CONFIG_DIR}/${config_name} must not be a symlink."
        exit 1
    fi
    if [[ -f "${CONFIG_DIR}/${config_name}" ]]; then
        cp -a -- "${CONFIG_DIR}/${config_name}" "${BACKUP_DIR}/${config_name}"
    fi
done
for service_file in "${SERVICE_FILES[@]}"; do
    if [[ -f "${service_file}" ]]; then
        cp -a -- "${service_file}" "${BACKUP_DIR}/$(basename "${service_file}")"
    fi
    if systemctl is-active --quiet "$(basename "${service_file}")"; then
        ACTIVE_UNITS+=("$(basename "${service_file}")")
    fi
done
CONFIG_CHANGED=1

systemctl enable --now postgresql redis-server >> "$LOGFILE" 2>&1 || true

# Wait for PostgreSQL to be ready (up to 30s)
PG_READY=false
for _ in $(seq 1 30); do
    if su - postgres -c "pg_isready" >/dev/null 2>&1; then
        PG_READY=true
        break
    fi
    sleep 1
done
if [[ "$PG_READY" != "true" ]]; then
    log_warn "PostgreSQL not reporting ready via pg_isready after 30s; proceeding with configuration..."
fi

DB_PASS_FILE="${CONFIG_DIR}/db_pass"
if [[ -f "${DB_PASS_FILE}" ]]; then
    DB_PASS="$(tr -d '[:space:]' < "${DB_PASS_FILE}")"
fi
if [[ ! "${DB_PASS:-}" =~ ^[a-fA-F0-9]{16,128}$ ]]; then
    DB_PASS="$(openssl rand -hex 16)"
fi
printf '%s\n' "${DB_PASS}" > "${DB_PASS_FILE}"
chown root:root "${DB_PASS_FILE}"
chmod 600 "${DB_PASS_FILE}"

su - postgres -c "psql -tc \"SELECT 1 FROM pg_roles WHERE rolname='dispatcharr'\" | grep -q 1 || psql -c \"CREATE USER dispatcharr WITH PASSWORD '${DB_PASS}';\"" >> "$LOGFILE" 2>&1
su - postgres -c "psql -c \"ALTER USER dispatcharr WITH PASSWORD '${DB_PASS}';\"" >> "$LOGFILE" 2>&1
su - postgres -c "psql -tc \"SELECT 1 FROM pg_database WHERE datname='dispatcharr'\" | grep -q 1 || psql -c \"CREATE DATABASE dispatcharr OWNER dispatcharr;\"" >> "$LOGFILE" 2>&1
su - postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE dispatcharr TO dispatcharr;\"" >> "$LOGFILE" 2>&1
su - postgres -c "psql -c \"ALTER DATABASE dispatcharr OWNER TO dispatcharr;\"" >> "$LOGFILE" 2>&1
su - postgres -c "psql -d dispatcharr -c \"ALTER SCHEMA public OWNER TO dispatcharr;\"" >> "$LOGFILE" 2>&1

SECRET_FILE="${CONFIG_DIR}/secret_key"
if [[ -f "${SECRET_FILE}" ]]; then
    DJANGO_SECRET="$(tr -d '[:space:]' < "${SECRET_FILE}")"
fi
if [[ ! "${DJANGO_SECRET:-}" =~ ^[a-fA-F0-9]{32,128}$ ]]; then
    DJANGO_SECRET="$(openssl rand -hex 32)"
fi
printf '%s\n' "${DJANGO_SECRET}" > "${SECRET_FILE}"
chown root:root "${SECRET_FILE}"
chmod 600 "${SECRET_FILE}"

report_progress 45 "Fetching ${APP_NAME} release from GitHub..."
LATEST_TAG="${AF_TARGET_VERSION:-$(curl -fsSL https://api.github.com/repos/Dispatcharr/Dispatcharr/releases/latest 2>/dev/null | jq -r '.tag_name // empty' || true)}"
LATEST_TAG="${LATEST_TAG:-v0.33.0}"
[[ "${LATEST_TAG}" == v* ]] || LATEST_TAG="v${LATEST_TAG}"

BUILD_DIR="$(mktemp -d "${INSTALL_DIR}.af-build.XXXXXX")"
git clone --depth 1 --branch "${LATEST_TAG}" https://github.com/Dispatcharr/Dispatcharr.git "${BUILD_DIR}" >> "$LOGFILE" 2>&1
SERVICES_STOPPED=1
if [[ "${#ACTIVE_UNITS[@]}" -gt 0 ]]; then
    systemctl stop "${ACTIVE_UNITS[@]}" >> "$LOGFILE" 2>&1
fi
su - postgres -c 'pg_dump --format=custom dispatcharr' > "${BACKUP_DIR}/db.dump" 2>> "$LOGFILE"
prepare_dispatcharr_data
if [[ -e "${INSTALL_DIR}" ]]; then
    mv -T "${INSTALL_DIR}" "${BACKUP_DIR}/app"
    APP_MOVED=1
fi
mv -T "${BUILD_DIR}" "${INSTALL_DIR}"
APP_ACTIVATED=1
chown -R root:root "${INSTALL_DIR}"
chmod -R go-w "${INSTALL_DIR}"
chmod 755 "${INSTALL_DIR}"
for relative in logo_cache media; do
    if [[ -L "${INSTALL_DIR}/${relative}" || ( -e "${INSTALL_DIR}/${relative}" && ! -d "${INSTALL_DIR}/${relative}" ) ]]; then
        log_error "Release ${relative} path must be a real directory."
        exit 1
    fi
    if [[ -d "${INSTALL_DIR}/${relative}" ]]; then
        cp -a -- "${INSTALL_DIR}/${relative}/." "${DATA_DIR}/${relative}/"
        rm -rf -- "${INSTALL_DIR}/${relative}"
    fi
    if [[ -d "${BACKUP_DIR}/app/${relative}" && ! -L "${BACKUP_DIR}/app/${relative}" ]]; then
        cp -a -- "${BACKUP_DIR}/app/${relative}/." "${DATA_DIR}/${relative}/"
    fi
    ln -s "${DATA_DIR}/${relative}" "${INSTALL_DIR}/${relative}"
done

ENV_FILE_TMP="$(mktemp "${CONFIG_DIR}/.dispatcharr.env.XXXXXX")"
cat > "${ENV_FILE_TMP}" <<EOF
POSTGRES_DB=dispatcharr
POSTGRES_USER=dispatcharr
POSTGRES_PASSWORD=${DB_PASS}
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DJANGO_SECRET_KEY=${DJANGO_SECRET}
DJANGO_SETTINGS_MODULE=dispatcharr.settings
DISPATCHARR_ENV=aio
DISPATCHARR_LOG_LEVEL=INFO
DISPATCHARR_PORT=${APP_PORT}
DISPATCHARR_LOG_DIR=/data/logs
BACKUP_ROOT=/data/backups
LOGOS_DIR=/data/logos
UPLOADS_DIR=/data/uploads
PLUGINS_DIR=/data/plugins
DISPATCHARR_PLUGINS_DIR=/data/plugins
DATA_DIR=${DATA_DIR}
PYTHONUNBUFFERED=1
EOF
python3 - "${CONFIG_DIR}/dispatcharr.env" "${ENV_FILE_TMP}" <<'PYEOF'
from pathlib import Path
import re
import sys

existing, candidate = map(Path, sys.argv[1:])
defaults = dict(line.split("=", 1) for line in candidate.read_text().splitlines())
required = {"POSTGRES_PASSWORD", "DJANGO_SECRET_KEY", "DISPATCHARR_PORT", "DISPATCHARR_LOG_DIR", "BACKUP_ROOT", "LOGOS_DIR", "UPLOADS_DIR", "PLUGINS_DIR", "DISPATCHARR_PLUGINS_DIR", "DATA_DIR"}
lines = existing.read_text().splitlines(keepends=True) if existing.exists() else []
seen = set()
merged = []
for line in lines:
    match = re.match(r"(?:export\s+)?([A-Za-z_][A-Za-z_0-9]*)=", line)
    key = match.group(1) if match else None
    if key in defaults:
        if key in required:
            if key not in seen:
                merged.append(f"{key}={defaults[key]}\n")
        else:
            merged.append(line)
        seen.add(key)
    else:
        merged.append(line)
if merged and not merged[-1].endswith("\n"):
    merged[-1] += "\n"
merged.extend(f"{key}={value}\n" for key, value in defaults.items() if key not in seen)
candidate.write_text("".join(merged))
PYEOF
chmod 640 "${ENV_FILE_TMP}"
chown "root:${APP_USER}" "${ENV_FILE_TMP}"
mv -f -- "${ENV_FILE_TMP}" "${CONFIG_DIR}/dispatcharr.env"
ENV_FILE_TMP=""
ln -sfn "${CONFIG_DIR}/dispatcharr.env" "${INSTALL_DIR}/.env"

report_progress 60 "Installing Python virtualenv and backend dependencies..."
"${PYTHON_BIN}" -m venv "${INSTALL_DIR}/env" >> "$LOGFILE" 2>&1
"${INSTALL_DIR}/env/bin/pip" install --upgrade pip wheel setuptools daphne gunicorn celery whitenoise >> "$LOGFILE" 2>&1
if [[ -f "${INSTALL_DIR}/pyproject.toml" ]]; then
    # Run manage.py and services from this source tree. A regular wheel install
    # duplicates namespace apps such as apps.api in site-packages, which Django
    # rejects as having multiple filesystem locations.
    "${INSTALL_DIR}/env/bin/pip" install --upgrade --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu --editable "${INSTALL_DIR}" >> "$LOGFILE" 2>&1
elif [[ -f "${INSTALL_DIR}/requirements.txt" ]]; then
    "${INSTALL_DIR}/env/bin/pip" install --upgrade --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r "${INSTALL_DIR}/requirements.txt" >> "$LOGFILE" 2>&1
else
    log_error "Dispatcharr release is missing its Python dependency manifest."
    exit 1
fi
if [[ -x /usr/bin/ffmpeg ]]; then
    ln -sf /usr/bin/ffmpeg "${INSTALL_DIR}/env/bin/ffmpeg"
fi

if [[ -d "${INSTALL_DIR}/frontend" && -f "${INSTALL_DIR}/frontend/package.json" ]]; then
    report_progress 75 "Building ${APP_NAME} frontend web bundle..."
    pushd "${INSTALL_DIR}/frontend" >/dev/null
    node_build npm install --legacy-peer-deps >> "$LOGFILE" 2>&1
    rm -rf "${INSTALL_DIR}/frontend/dist"
    node_build npm run build >> "$LOGFILE" 2>&1
    popd >/dev/null
fi

# Create custom Daphne ASGI static file & proxy wrapper
cat > "${INSTALL_DIR}/aetherflow_asgi.py" <<'EOF'
import asyncio
import concurrent.futures
import logging
import os
import mimetypes
from email.utils import formatdate
from pathlib import Path

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "dispatcharr.settings")

mimetypes.init()
mimetypes.add_type("application/javascript", ".js")
mimetypes.add_type("text/css", ".css")
mimetypes.add_type("image/svg+xml", ".svg")
mimetypes.add_type("application/wasm", ".wasm")
mimetypes.add_type("application/manifest+json", ".webmanifest")

# Daphne is the only HTTP server in this layout, so it owns every live stream.
# Dispatcharr starts its live-proxy runtime (orphaned-channel cleanup thread and
# live:events listener) only in uWSGI/gunicorn workers. Without it, a channel
# left behind by a restarted process stays "active" in Redis with no upstream
# reader and every client stalls. Must run before django.setup(), because
# ProxyConfig.ready() decides whether to start the runtime.
try:
    import apps.proxy.live_proxy.runtime as _af_live_proxy_runtime
except ImportError:
    logging.getLogger("aetherflow.asgi").warning(
        "Dispatcharr live-proxy runtime module not found; Daphne stays client-only")
else:
    if hasattr(_af_live_proxy_runtime, "_RUNTIME_ROLES"):
        _af_live_proxy_runtime._RUNTIME_ROLES = frozenset(
            set(_af_live_proxy_runtime._RUNTIME_ROLES) | {"daphne"})

from dispatcharr.asgi import application as django_application
from django.http import StreamingHttpResponse

# Django's ASGI handler drains *synchronous* StreamingHttpResponse iterators
# with sync_to_async(list)(...) before sending a single byte. Dispatcharr's live
# TS proxy is an endless sync generator, so players got no data. Pull and send
# one chunk at a time on a dedicated pool instead (one busy thread per stream).
STREAM_POOL = concurrent.futures.ThreadPoolExecutor(
    max_workers=max(8, int(os.environ.get("AF_STREAM_THREADS", "256"))),
    thread_name_prefix="af-stream",
)
_STREAM_DONE = object()


def _close_after(pending, closer):
    # A generator can't be closed while next() is running in another thread.
    if pending is not None:
        try:
            pending.result()
        except BaseException:
            pass
    if closer is not None:
        try:
            closer()
        except Exception:
            pass


async def _stream_incrementally(self):
    if self.is_async:
        async for part in self.streaming_content:
            yield part
        return
    source = self._iterator
    chunks = map(self.make_bytes, source)
    pending = None
    try:
        while True:
            pending = STREAM_POOL.submit(next, chunks, _STREAM_DONE)
            part = await asyncio.wrap_future(pending)
            pending = None
            if part is _STREAM_DONE:
                return
            yield part
    finally:
        # Also runs on client disconnect: closing the generator triggers
        # Dispatcharr's GeneratorExit cleanup (client and stream release).
        STREAM_POOL.submit(_close_after, pending, getattr(source, "close", None))


StreamingHttpResponse.__aiter__ = _stream_incrementally

INSTALL_DIR = Path(__file__).resolve().parent
STATIC_DIR = INSTALL_DIR / "static"
FRONTEND_DIST_DIR = INSTALL_DIR / "frontend" / "dist"
DATA_DIR = Path(os.environ.get("DATA_DIR", "/var/lib/dispatcharr"))
LOGOS_DIR = Path(os.environ.get("LOGOS_DIR", str(DATA_DIR / "logos")))
DATA_LOGO_DIR = Path("/data/logos")
# Vite copies frontend/public files to dist's root. Only these public names
# bypass Django's routes; Django still renders index.html and all SPA routes.
ROOT_STATIC_FILES = frozenset({
    "android-chrome-192x192.png", "android-chrome-512x512.png",
    "apple-touch-icon.png", "favicon-16x16.png", "favicon-32x32.png",
    "favicon.ico", "logo.png", "site.webmanifest", "vite.svg",
})
CHUNK_SIZE = 65536

def safe_file_lookup(base_dir: Path, rel_path: str):
    try:
        base_real = base_dir.resolve()
        target = (base_real / rel_path).resolve()
        if target.is_relative_to(base_real) and target.is_file():
            return target
    except (OSError, ValueError, RuntimeError):
        pass
    return None

def resolve_static_file(path: str):
    roots = ()
    if path.startswith("/assets/"):
        rel = path[len("/assets/"):]
        roots = (STATIC_DIR / "assets", FRONTEND_DIST_DIR / "assets")
    elif path.startswith("/static/"):
        rel = path[len("/static/"):]
        roots = (STATIC_DIR,)
    elif path.startswith("/logos/"):
        rel = path[len("/logos/"):]
        roots = (LOGOS_DIR, DATA_DIR / "logos", DATA_LOGO_DIR)
    elif path.removeprefix("/") in ROOT_STATIC_FILES:
        rel = path[1:]
        roots = (STATIC_DIR, FRONTEND_DIST_DIR)
    else:
        return None
    for root in roots:
        target = safe_file_lookup(root, rel)
        if target is not None:
            return target
    return None

async def send_file_response(file_path: Path, method: str, send, is_logo=False):
    # Open before sending headers so a missing/unreadable file can fall through.
    try:
        file = file_path.open("rb")
    except OSError:
        return False
    with file:
        content_type, _ = mimetypes.guess_type(str(file_path))
        stat_result = os.fstat(file.fileno())
        file_size = stat_result.st_size
        headers = [
            (b"content-type", (content_type or "application/octet-stream").encode("ascii")),
            (b"content-length", str(file_size).encode("ascii")),
            (b"cache-control", b"public, max-age=300, must-revalidate" if is_logo else b"public, max-age=86400"),
            (b"x-content-type-options", b"nosniff"),
        ]
        if is_logo:
            headers.append((b"last-modified", formatdate(stat_result.st_mtime, usegmt=True).encode("ascii")))
        await send({"type": "http.response.start", "status": 200, "headers": headers})
        remaining = file_size if method == "GET" else 0
        while remaining:
            chunk = await asyncio.to_thread(file.read, min(CHUNK_SIZE, remaining))
            if not chunk:
                break
            remaining -= len(chunk)
            await send({"type": "http.response.body", "body": chunk, "more_body": True})
        await send({"type": "http.response.body", "body": b"", "more_body": False})
    return True

async def application(scope, receive, send):
    if scope["type"] == "http":
        method = scope.get("method", "GET").upper()
        if method in ("GET", "HEAD"):
            # ASGI's path is already URL-decoded. Decoding again changes literal
            # percent-escaped filenames and can turn them into traversal paths.
            path = scope.get("path", "")
            static_file = resolve_static_file(path)
            if static_file and await send_file_response(static_file, method, send, path.startswith("/logos/")):
                return

    await django_application(scope, receive, send)
