#!/bin/bash
#
# [AetherFlow Install Script - Dispatcharr]
# Installs Dispatcharr (IPTV stream, M3U playlist, and XMLTV EPG proxy/manager)
# natively on bare-metal Debian/Ubuntu with PostgreSQL, Redis, Daphne ASGI, and Celery.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_SH="/opt/AetherFlow/packages/common.sh"
if [[ -f "${COMMON_SH}" ]]; then
    # shellcheck disable=SC1091
    source "${COMMON_SH}"
else
    # shellcheck disable=SC1091
    source "${SELF_DIR}/../../common.sh"
fi

require_root

APP_NAME="dispatcharr"
APP_USER="dispatcharr"
INSTALL_DIR="/opt/dispatcharr"
DATA_DIR="/var/lib/dispatcharr"
CONFIG_DIR="/etc/dispatcharr"
LOCK_FILE="/install/.dispatcharr.lock"
SERVICE_FILE="/etc/systemd/system/dispatcharr.service"
CELERY_SERVICE_FILE="/etc/systemd/system/dispatcharr-celery.service"
BEAT_SERVICE_FILE="/etc/systemd/system/dispatcharr-celerybeat.service"
APP_PORT="${AF_APP_PORT:-9191}"

setup_log "${APP_NAME}"
log "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 5 "Preparing ${APP_NAME} installation..."

ensure_master_credentials
ADMIN_USER="${MASTER_USER}"
ADMIN_PASS="${MASTER_PASS}"
ADMIN_EMAIL="${ADMIN_USER}@localhost"

report_progress 15 "Installing PostgreSQL, Redis, FFmpeg, Python, and system dependencies..."
apt_update
apt_install curl wget git jq ca-certificates build-essential pkg-config \
    python3 python3-venv python3-dev python3-pip \
    postgresql postgresql-contrib libpq-dev \
    redis-server ffmpeg streamlink

report_progress 25 "Provisioning Node.js runtime for frontend asset build..."
ensure_node 20

ensure_service_user "${APP_USER}" "${DATA_DIR}"
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/logos" "${DATA_DIR}/recordings" "${DATA_DIR}/uploads" "${DATA_DIR}/m3u" "${DATA_DIR}/epg" "${CONFIG_DIR}"

# Join video/render groups if present for hardware acceleration (/dev/dri)
if getent group video >/dev/null 2>&1; then
    usermod -aG video "${APP_USER}" || true
fi
if getent group render >/dev/null 2>&1; then
    usermod -aG render "${APP_USER}" || true
fi

systemctl enable --now postgresql >> "${LOG_FILE}" 2>&1 || true
systemctl enable --now redis-server >> "${LOG_FILE}" 2>&1 || true

report_progress 35 "Configuring PostgreSQL database for ${APP_NAME}..."
DB_PASS_FILE="${CONFIG_DIR}/db_pass"
if [[ -f "${DB_PASS_FILE}" ]]; then
    DB_PASS="$(cat "${DB_PASS_FILE}")"
else
    DB_PASS="$(openssl rand -hex 16)"
    echo "${DB_PASS}" > "${DB_PASS_FILE}"
    chmod 600 "${DB_PASS_FILE}"
fi

su - postgres -c "psql -tc \"SELECT 1 FROM pg_roles WHERE rolname='dispatcharr'\" | grep -q 1 || psql -c \"CREATE USER dispatcharr WITH PASSWORD '${DB_PASS}';\"" >> "${LOG_FILE}" 2>&1
su - postgres -c "psql -c \"ALTER USER dispatcharr WITH PASSWORD '${DB_PASS}';\"" >> "${LOG_FILE}" 2>&1
su - postgres -c "psql -tc \"SELECT 1 FROM pg_database WHERE datname='dispatcharr'\" | grep -q 1 || psql -c \"CREATE DATABASE dispatcharr OWNER dispatcharr;\"" >> "${LOG_FILE}" 2>&1
su - postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE dispatcharr TO dispatcharr;\"" >> "${LOG_FILE}" 2>&1

SECRET_FILE="${CONFIG_DIR}/secret_key"
if [[ -f "${SECRET_FILE}" ]]; then
    DJANGO_SECRET="$(cat "${SECRET_FILE}")"
else
    DJANGO_SECRET="$(openssl rand -hex 32)"
    echo "${DJANGO_SECRET}" > "${SECRET_FILE}"
    chmod 600 "${SECRET_FILE}"
fi

report_progress 45 "Fetching latest ${APP_NAME} release from GitHub..."
LATEST_TAG="$(curl -fsSL https://api.github.com/repos/Dispatcharr/Dispatcharr/releases/latest 2>/dev/null | jq -r '.tag_name // empty' || true)"
if [[ -z "${LATEST_TAG}" ]]; then
    LATEST_TAG="main"
fi

if [[ -d "${INSTALL_DIR}/.git" ]]; then
    git -C "${INSTALL_DIR}" fetch --tags --force >> "${LOG_FILE}" 2>&1 || true
    git -C "${INSTALL_DIR}" checkout -f "${LATEST_TAG}" >> "${LOG_FILE}" 2>&1 || git -C "${INSTALL_DIR}" pull --ff-only >> "${LOG_FILE}" 2>&1 || true
else
    rm -rf "${INSTALL_DIR:?}"/*
    if [[ "${LATEST_TAG}" != "main" ]]; then
        git clone --depth 1 --branch "${LATEST_TAG}" https://github.com/Dispatcharr/Dispatcharr.git "${INSTALL_DIR}" >> "${LOG_FILE}" 2>&1 || \
            git clone --depth 1 https://github.com/Dispatcharr/Dispatcharr.git "${INSTALL_DIR}" >> "${LOG_FILE}" 2>&1
    else
        git clone --depth 1 https://github.com/Dispatcharr/Dispatcharr.git "${INSTALL_DIR}" >> "${LOG_FILE}" 2>&1
    fi
fi

echo "${LATEST_TAG#v}" > "${INSTALL_DIR}/.af-version"

cat > "${CONFIG_DIR}/dispatcharr.env" <<EOF
POSTGRES_DB=dispatcharr
POSTGRES_USER=dispatcharr
POSTGRES_PASSWORD=${DB_PASS}
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DJANGO_SECRET_KEY=${DJANGO_SECRET}
DJANGO_SETTINGS_MODULE=dispatcharr.settings
DISPATCHARR_ENV=aio
DISPATCHARR_LOG_LEVEL=INFO
DISPATCHARR_PORT=${APP_PORT}
PYTHONUNBUFFERED=1
EOF
chmod 600 "${CONFIG_DIR}/dispatcharr.env"
chown "${APP_USER}:${APP_USER}" "${CONFIG_DIR}/dispatcharr.env"

report_progress 60 "Installing Python virtualenv and backend dependencies..."
if [[ ! -d "${INSTALL_DIR}/env" ]]; then
    python3 -m venv "${INSTALL_DIR}/env" >> "${LOG_FILE}" 2>&1
fi
"${INSTALL_DIR}/env/bin/pip" install --upgrade pip wheel setuptools daphne gunicorn celery >> "${LOG_FILE}" 2>&1
if [[ -f "${INSTALL_DIR}/requirements.txt" ]]; then
    "${INSTALL_DIR}/env/bin/pip" install --no-cache-dir -r "${INSTALL_DIR}/requirements.txt" >> "${LOG_FILE}" 2>&1
elif [[ -f "${INSTALL_DIR}/pyproject.toml" ]]; then
    "${INSTALL_DIR}/env/bin/pip" install --no-cache-dir "${INSTALL_DIR}" >> "${LOG_FILE}" 2>&1
fi

if [[ -d "${INSTALL_DIR}/frontend" && -f "${INSTALL_DIR}/frontend/package.json" ]]; then
    report_progress 75 "Building ${APP_NAME} frontend web bundle..."
    pushd "${INSTALL_DIR}/frontend" >/dev/null
    npm install --legacy-peer-deps >> "${LOG_FILE}" 2>&1
    npm run build >> "${LOG_FILE}" 2>&1
    popd >/dev/null
fi

chown -R "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}" "${CONFIG_DIR}"

report_progress 85 "Running database migrations and provisioning master account..."
if [[ -f "${INSTALL_DIR}/manage.py" ]]; then
    su -s /bin/bash "${APP_USER}" -c "set -a; source '${CONFIG_DIR}/dispatcharr.env'; set +a; cd '${INSTALL_DIR}' && '${INSTALL_DIR}/env/bin/python' manage.py migrate --noinput" >> "${LOG_FILE}" 2>&1 || true
    su -s /bin/bash "${APP_USER}" -c "set -a; source '${CONFIG_DIR}/dispatcharr.env'; set +a; cd '${INSTALL_DIR}' && '${INSTALL_DIR}/env/bin/python' manage.py collectstatic --noinput" >> "${LOG_FILE}" 2>&1 || true
    su -s /bin/bash "${APP_USER}" -c "set -a; source '${CONFIG_DIR}/dispatcharr.env'; set +a; cd '${INSTALL_DIR}' && '${INSTALL_DIR}/env/bin/python' manage.py shell -c \"
from django.contrib.auth import get_user_model
User = get_user_model()
u, created = User.objects.get_or_create(username='${ADMIN_USER}', defaults={'email': '${ADMIN_EMAIL}', 'is_staff': True, 'is_superuser': True})
u.is_staff = True
u.is_superuser = True
u.set_password('${ADMIN_PASS}')
u.save()
\"" >> "${LOG_FILE}" 2>&1 || true
fi

report_progress 90 "Writing systemd service units for ${APP_NAME}..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Dispatcharr IPTV & Stream Proxy Server (Daphne ASGI)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${CONFIG_DIR}/dispatcharr.env
ExecStart=${INSTALL_DIR}/env/bin/daphne -b 0.0.0.0 -p ${APP_PORT} dispatcharr.asgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat > "${CELERY_SERVICE_FILE}" <<EOF
[Unit]
Description=Dispatcharr Celery Worker
After=network-online.target postgresql.service redis-server.service dispatcharr.service
PartOf=dispatcharr.service

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${CONFIG_DIR}/dispatcharr.env
ExecStart=${INSTALL_DIR}/env/bin/celery -A dispatcharr worker --loglevel=INFO --concurrency=4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat > "${BEAT_SERVICE_FILE}" <<EOF
[Unit]
Description=Dispatcharr Celery Beat Scheduler
After=network-online.target postgresql.service redis-server.service dispatcharr.service
PartOf=dispatcharr.service

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${CONFIG_DIR}/dispatcharr.env
ExecStart=${INSTALL_DIR}/env/bin/celery -A dispatcharr beat --loglevel=INFO
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now dispatcharr.service dispatcharr-celery.service dispatcharr-celerybeat.service >> "${LOG_FILE}" 2>&1

write_lock "${LOCK_FILE}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log "${APP_NAME} installation complete."
