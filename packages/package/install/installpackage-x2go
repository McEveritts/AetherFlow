#!/bin/bash
#
# [AetherFlow Install Script - X2Go]
# Installs X2Go remote desktop server over SSH with XFCE4 session support.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="x2go"
APP_NAME="x2go"
DATA_DIR="/var/lib/x2go"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

PACKAGE_NAME="${PACKAGE_NAME:-x2go}"
begin_state_transaction "x2goserver.service" "0" "/" "/var/lib/x2go" "/etc/x2go" "/etc/systemd/system/x2goserver.service" "/usr/bin/x2gostartagent" "/usr/bin/x2goruncommand" "/usr/sbin/x2gocleansessions" "/usr/lib/x2go" "/usr/share/x2go"

prepare_apt_package_transaction /var/lib/x2go/.af-version x2goserver x2goserver-xsession
log_info "Starting ${APP_NAME} (x2goserver + XFCE4) installation..."
report_progress 15 "Preparing ${APP_NAME} installation..."

report_progress 45 "Installing x2goserver, x2goserver-xsession, and XFCE4 desktop environment..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    x2goserver x2goserver-xsession xfce4 xfce4-goodies dbus-x11 x11-xserver-utils

mkdir -p "${DATA_DIR}"
report_progress 75 "Initializing X2Go SQLite session database..."
if command -v x2godbadmin >/dev/null 2>&1; then
    af_logged x2godbadmin --createdb || true
fi

INSTALLED_VER="$(dpkg-query -W -f='${Version}' x2goserver 2>/dev/null | cut -d- -f1 | sed 's/^[0-9]*://' || echo '4.1.0')"
queue_app_version "${DATA_DIR}/.af-version" "${INSTALLED_VER}"

report_progress 90 "Enabling and starting x2goserver.service..."
af_logged systemctl daemon-reload
af_logged systemctl enable --now x2goserver.service

af_logged systemctl restart x2goserver
systemctl is-active --quiet x2goserver

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} remote desktop server installed and ready over SSH"
log_info "${PACKAGE_NAME} installation complete."
