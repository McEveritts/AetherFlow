source /opt/AetherFlow/packages/common.sh
set -euo pipefail

# Override common.sh LOGFILE for this specific package
export LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p "$(dirname "$LOGFILE")"

# We use print_info to ensure output is visible to the backend installer
log() { print_info "[$APP_ID] $1"; }
APP_ID="netdata"

# ── Install Netdata using official kickstart ─────────────────────────────────
log "Running Netdata kickstart installer..."
fetch_and_run "https://get.netdata.cloud/kickstart.sh" "SKIP" --non-interactive --dont-wait >>"$LOGFILE" 2>&1

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/netdata.conf <<'EOF'
<Location /netdata>
    ProxyPass http://localhost:19999
    ProxyPassReverse http://localhost:19999
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/netdata.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.netdata.lock
log "Netdata installation complete! Access at http://your-server:19999"
