#!/bin/bash
# AetherFlow Package Installer: Netdata
# Port: 19999

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="netdata"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-19999}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing prerequisites for Netdata..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl ca-certificates >> "$LOGFILE" 2>&1

report_progress 45 "Running official Netdata kickstart installer..."
if ! fetch_and_run "https://get.netdata.cloud/kickstart.sh" "SKIP" --non-interactive --stable-channel --disable-telemetry >> "$LOGFILE" 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq netdata >> "$LOGFILE" 2>&1
fi

if [[ -f /etc/netdata/netdata.conf ]]; then
    sed -i 's/bind socket to IP = 127.0.0.1/bind socket to IP = 0.0.0.0/g' /etc/netdata/netdata.conf || true
fi

report_progress 85 "Starting and enabling netdata.service on port ${APP_PORT}..."

set_config_value "/etc/netdata/netdata.conf" ini "default port" "$APP_PORT" "web"

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now netdata >> "$LOGFILE" 2>&1
systemctl restart netdata >> "$LOGFILE" 2>&1 || true

write_lock "${PACKAGE_NAME}"
report_progress 100 "Netdata installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
