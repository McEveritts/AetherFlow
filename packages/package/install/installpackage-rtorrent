#!/bin/bash
# AetherFlow Package Installer: rTorrent
# Port: 0 (SCGI on /run/rtorrent/rpc.sock and 127.0.0.1:15000)

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="rtorrent"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi

require_root
validate_config_paths /var/lib/rtorrent/.af-directory-check /run/rtorrent/.af-directory-check
PACKAGE_NAME="${PACKAGE_NAME:-rtorrent}"
begin_state_transaction "rtorrent" "0" "/" "/var/lib/rtorrent" "/etc/rtorrent" "/etc/systemd/system/rtorrent.service" "/usr/bin/rtorrent" "/usr/share/rtorrent"

prepare_apt_package_transaction /var/lib/rtorrent/.af-version rtorrent
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing rTorrent, screen, and dependencies via apt..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq rtorrent screen curl psmisc ca-certificates

report_progress 40 "Configuring rtorrent service user and session directories..."
if ! id -u rtorrent >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/rtorrent --shell /usr/sbin/nologin rtorrent
fi

# Ensure rtorrent and www-data have shared socket access
af_logged usermod -aG www-data rtorrent || true
af_logged usermod -aG rtorrent www-data || true

mkdir -p /var/lib/rtorrent/session \
         /var/lib/rtorrent/downloads \
         /var/lib/rtorrent/watch \
         /run/rtorrent

report_progress 65 "Preparing rTorrent configuration..."
if [[ -e /var/lib/rtorrent/.rtorrent.rc || -L /var/lib/rtorrent/.rtorrent.rc ]]; then
    [[ -f /var/lib/rtorrent/.rtorrent.rc ]] || { log_error "Existing rTorrent configuration is not a regular file"; exit 1; }
    log_info "Retaining existing rTorrent configuration."
else
    # Publish complete defaults without ever truncating an operator's config.
    (
        config_temp="$(mktemp /var/lib/rtorrent/.rtorrent.rc.af-XXXXXX)"
        trap 'rm -f -- "${config_temp}"' EXIT
    cat <<'EOF' > "${config_temp}"
# AetherFlow rTorrent native configuration
session.path.set = /var/lib/rtorrent/session/
directory.default.set = /var/lib/rtorrent/downloads
schedule2 = watch_directory,5,5,load.start=/var/lib/rtorrent/watch/*.torrent

# SCGI Configuration: localhost TCP port (used by ruTorrent and Flood)
network.scgi.open_port = 127.0.0.1:15000

encoding.add = UTF-8
network.port_range.set = 50000-50100
network.port_random.set = yes
trackers.use_udp.set = yes
dht.mode.set = auto
protocol.pex.set = yes

throttle.global_down.max_rate.set = 0
throttle.global_up.max_rate.set = 0
throttle.max_peers.normal.set = 100
throttle.max_peers.seed.set = -1
throttle.max_uploads.set = 100
pieces.hash.on_completion.set = no
EOF

        ln -- "${config_temp}" /var/lib/rtorrent/.rtorrent.rc
    )
fi

chown -hRP rtorrent:www-data /var/lib/rtorrent /run/rtorrent
chmod 775 /var/lib/rtorrent /run/rtorrent

report_progress 85 "Creating and starting rtorrent.service unit..."
cat <<'EOF' > /etc/systemd/system/rtorrent.service
[Unit]
Description=rTorrent BitTorrent Client
After=network.target

[Service]
Type=forking
User=rtorrent
Group=www-data
RuntimeDirectory=rtorrent
RuntimeDirectoryMode=0775
WorkingDirectory=/var/lib/rtorrent
ExecStartPre=-/bin/rm -f /var/lib/rtorrent/session/rtorrent.lock
ExecStart=/usr/bin/screen -d -m -fa -S rtorrent /usr/bin/rtorrent -n -o import=/var/lib/rtorrent/.rtorrent.rc
ExecStop=/usr/bin/killall -w -s 2 /usr/bin/rtorrent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

af_logged systemctl daemon-reload
af_logged systemctl enable --now rtorrent

af_logged systemctl restart rtorrent
systemctl is-active --quiet rtorrent
queue_app_version /var/lib/rtorrent/.af-version "$(dpkg-query -W -f='${Version}' rtorrent)"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "rTorrent installed successfully (SCGI 127.0.0.1:15000 / /run/rtorrent/rpc.sock)."
log_info "${PACKAGE_NAME} installed successfully"
