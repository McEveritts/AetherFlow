#!/bin/bash
# AetherFlow Package Installer: Gitea
# Port: 3002

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="gitea"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3002}}"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /etc/gitea/app.ini
GITEA_DB_CONFIG=(sqlite3 gitea "" "" "" /var/lib/gitea/data/gitea.db)
GITEA_RETAINED_CONFIG=false
if [[ -f /etc/gitea/app.ini ]]; then
    GITEA_RETAINED_CONFIG=true
    GITEA_RETAINED_DATABASE="$(read_app_database_config gitea /etc/gitea/app.ini)" || exit 1
    mapfile -t GITEA_DB_CONFIG <<< "$GITEA_RETAINED_DATABASE"
fi
if [[ "${GITEA_DB_CONFIG[0]}" == sqlite3 || "${GITEA_DB_CONFIG[0]}" == sqlite ]]; then
    [[ "${GITEA_DB_CONFIG[5]}" == /* ]] || GITEA_DB_CONFIG[5]="/var/lib/gitea/${GITEA_DB_CONFIG[5]}"
    validate_config_paths "${GITEA_DB_CONFIG[5]}" "${GITEA_DB_CONFIG[5]}-wal" "${GITEA_DB_CONFIG[5]}-shm" || exit 1
fi
if [[ -L /etc/gitea || -L /etc/gitea/app.ini ]]; then
    print_error "Refusing symlinked Gitea configuration path"
    exit 1
fi
if [[ -e /etc/gitea/app.ini ]] && { [[ ! -f /etc/gitea/app.ini ]] || [[ "$(stat -c %h /etc/gitea/app.ini)" != 1 ]]; }; then
    print_error "Refusing non-regular or hardlinked Gitea configuration"
    exit 1
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Git and SQLite dependencies for Gitea..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git curl sqlite3 python3 ca-certificates >> "$LOGFILE" 2>&1

if ! id -u gitea >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/gitea --shell /bin/bash gitea
fi

mkdir -p /var/lib/gitea/{custom,data,log} /etc/gitea
chown root:gitea /etc/gitea
chmod 750 /etc/gitea

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) GITEA_ARCH="linux-amd64" ;;
    arm64) GITEA_ARCH="linux-arm64" ;;
    armhf) GITEA_ARCH="linux-arm-6" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Gitea release (${GITEA_ARCH})..."
GITEA_VERSION="$(github_latest_tag "go-gitea/gitea" "1.22.3")"
GITEA_URL="https://github.com/go-gitea/gitea/releases/download/v${GITEA_VERSION}/gitea-${GITEA_VERSION}-${GITEA_ARCH}"

report_progress 65 "Downloading Gitea ${GITEA_VERSION} binary..."
TMP_DIR="$(mktemp -d /tmp/gitea-XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT
download_file "$GITEA_URL" "$TMP_DIR/gitea" >> "$LOGFILE" 2>&1
if [[ "$(od -An -tx1 -N4 "$TMP_DIR/gitea" | tr -d ' \n')" != "7f454c46" ]]; then
    print_error "Gitea download is not an ELF binary"
    exit 1
fi
chmod 755 "$TMP_DIR/gitea"
stage_app_archive "$TMP_DIR" /usr/local/bin/gitea gitea /var/lib/gitea "$PACKAGE_NAME" "." /etc/gitea "" binary
if [[ "$GITEA_RETAINED_CONFIG" == true ]]; then
    AF_ARCHIVE_DATABASE_BACKUP="$AF_ARCHIVE_BACKUP/database"
    AF_ARCHIVE_DATABASE_CONFIG=("${GITEA_DB_CONFIG[@]}")
    if ! backup_configured_database "$AF_ARCHIVE_DATABASE_BACKUP" "${AF_ARCHIVE_DATABASE_CONFIG[@]}" >> "$LOGFILE" 2>&1; then
        print_error "Cannot back up retained Gitea database; refusing to migrate"
        exit 1
    fi
fi
rm -rf "$TMP_DIR"
queue_app_version /var/lib/gitea/.af-version "${GITEA_VERSION#v}"

if [[ ! -f /etc/gitea/app.ini ]]; then
    cat <<EOF > /etc/gitea/app.ini
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = gitea
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

[server]
HTTP_ADDR = 127.0.0.1
HTTP_PORT = ${APP_PORT}
DOMAIN = localhost
ROOT_URL = http://localhost:${APP_PORT}/

[database]
DB_TYPE = sqlite3
PATH = /var/lib/gitea/data/gitea.db

[log]
MODE = console
LEVEL = info
ROOT_PATH = /var/lib/gitea/log

[security]
INSTALL_LOCK = true
EOF
fi
set_config_value /etc/gitea/app.ini ini HTTP_PORT "$APP_PORT" server

chown -hRP gitea:gitea /var/lib/gitea
[[ ! -L /etc/gitea/app.ini ]]
chown root:gitea /etc/gitea/app.ini
chmod 640 /etc/gitea/app.ini

sudo -u gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea migrate --config /etc/gitea/app.ini >> "$LOGFILE" 2>&1
if [[ "$GITEA_RETAINED_CONFIG" != true ]] && sudo -u gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea admin user create \
    --config /etc/gitea/app.ini \
    --username "${MASTER_USER}" \
    --random-password \
    --email "${MASTER_USER}@aether.local" \
    --admin \
    --must-change-password=false > /dev/null 2>> "$LOGFILE"; then
    validate_config_paths /var/lib/gitea/data/gitea.db
    AF_SEED_USER="$MASTER_USER" AF_SEED_PASS="$MASTER_PASS" python3 - <<'PYEOF'
import hashlib, os, secrets, sqlite3
salt = secrets.token_bytes(16)
hashed = hashlib.pbkdf2_hmac('sha256', os.environ['AF_SEED_PASS'].encode(), salt, 50000, 50).hex()
with sqlite3.connect('file:/var/lib/gitea/data/gitea.db?mode=rw', uri=True) as database:
    changed = database.execute('UPDATE user SET passwd=?, salt=?, passwd_hash_algo=? WHERE lower_name=?',
        (hashed, salt.hex(), 'pbkdf2$50000$50', os.environ['AF_SEED_USER'].lower())).rowcount
    if changed != 1:
        raise RuntimeError('Gitea did not create the requested administrator')
PYEOF
fi

report_progress 85 "Configuring and starting gitea.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/gitea.service
[Unit]
Description=Gitea (Git with a cup of tea)
After=syslog.target
After=network.target

[Service]
RestartSec=2s
Type=simple
User=gitea
Group=gitea
WorkingDirectory=/var/lib/gitea/
ExecStart=/usr/local/bin/gitea web --config /etc/gitea/app.ini
Restart=always
Environment=USER=gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now gitea >> "$LOGFILE" 2>&1
systemctl restart gitea >> "$LOGFILE" 2>&1
systemctl is-active --quiet gitea
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/api/healthz"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Gitea installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
