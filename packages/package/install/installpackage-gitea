#!/bin/bash
# AetherFlow Package Installer: Gitea
# Port: 3002

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="gitea"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-3002}}"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing Git and SQLite dependencies for Gitea..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git curl sqlite3 python3 ca-certificates >> "$LOGFILE" 2>&1

if ! id -u gitea >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/gitea --shell /bin/bash gitea
fi

mkdir -p /var/lib/gitea/{custom,data,log} /etc/gitea

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) GITEA_ARCH="linux-amd64" ;;
    arm64) GITEA_ARCH="linux-arm64" ;;
    armhf) GITEA_ARCH="linux-arm-6" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 40 "Resolving latest Gitea release (${GITEA_ARCH})..."
GITEA_VERSION="$(github_latest_tag "go-gitea/gitea" "1.22.3")"
GITEA_URL="https://github.com/go-gitea/gitea/releases/download/v${GITEA_VERSION}/gitea-${GITEA_VERSION}-${GITEA_ARCH}"

report_progress 65 "Downloading Gitea ${GITEA_VERSION} binary..."
TMP_BIN="$(mktemp /tmp/gitea-XXXXXX)"
trap 'rm -f "$TMP_BIN"' EXIT
curl -fsSL "$GITEA_URL" -o "$TMP_BIN" >> "$LOGFILE" 2>&1
if [[ "$(od -An -tx1 -N4 "$TMP_BIN" | tr -d ' \n')" != "7f454c46" ]]; then
    print_error "Gitea download is not an ELF binary"
    exit 1
fi
systemctl stop gitea >> "$LOGFILE" 2>&1 || true
install_binary_atomic "$TMP_BIN" /usr/local/bin/gitea

if [[ ! -f /etc/gitea/app.ini ]]; then
    cat <<EOF > /etc/gitea/app.ini
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = gitea
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

[server]
HTTP_ADDR = 0.0.0.0
HTTP_PORT = ${APP_PORT}
DOMAIN = localhost
ROOT_URL = http://localhost:${APP_PORT}/

[database]
DB_TYPE = sqlite3
PATH = /var/lib/gitea/data/gitea.db

[log]
MODE = console
LEVEL = info
ROOT_PATH = /var/lib/gitea/log

[security]
INSTALL_LOCK = true
EOF
fi
python3 - /etc/gitea/app.ini "$APP_PORT" <<'PYEOF'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
header = re.search(r'(?im)^\[server\][ \t]*$', text)
if header is None:
    text = text.rstrip() + '\n\n[server]\nHTTP_PORT = ' + sys.argv[2] + '\n'
else:
    start = header.end()
    following = re.search(r'(?m)^\[', text[start:])
    end = start + following.start() if following else len(text)
    block = text[start:end]
    pattern = r'(?im)^[ \t]*HTTP_PORT[ \t]*=.*$'
    setting = 'HTTP_PORT = ' + sys.argv[2]
    if re.search(pattern, block):
        block = re.sub(pattern, lambda _: setting, block)
    else:
        block = '\n' + setting + '\n' + block.lstrip('\n')
    text = text[:start] + block + text[end:]
path.write_text(text)
PYEOF

chown -R gitea:gitea /var/lib/gitea
chown -R root:gitea /etc/gitea
chmod 770 /etc/gitea
chmod 660 /etc/gitea/app.ini

sudo -u gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea migrate --config /etc/gitea/app.ini >> "$LOGFILE" 2>&1
sudo -u gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea admin user create \
    --config /etc/gitea/app.ini \
    --username "${MASTER_USER}" \
    --password "${MASTER_PASS}" \
    --email "${MASTER_USER}@aether.local" \
    --admin \
    --must-change-password=false >> "$LOGFILE" 2>&1 || true

report_progress 85 "Configuring and starting gitea.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/gitea.service
[Unit]
Description=Gitea (Git with a cup of tea)
After=syslog.target
After=network.target

[Service]
RestartSec=2s
Type=simple
User=gitea
Group=gitea
WorkingDirectory=/var/lib/gitea/
ExecStart=/usr/local/bin/gitea web --config /etc/gitea/app.ini
Restart=always
Environment=USER=gitea HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now gitea >> "$LOGFILE" 2>&1
systemctl restart gitea >> "$LOGFILE" 2>&1
printf '%s\n' "${GITEA_VERSION#v}" > /var/lib/gitea/.af-version

write_lock "${PACKAGE_NAME}"
report_progress 100 "Gitea installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
