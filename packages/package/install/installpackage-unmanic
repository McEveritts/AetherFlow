#!/bin/bash
#
# [AetherFlow Install Script - Unmanic]
# Installs Unmanic automated media library optimizer and FFmpeg transcoding manager.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="unmanic"
APP_NAME="unmanic"
APP_USER="unmanic"
INSTALL_DIR="/opt/unmanic"
DATA_DIR="/var/lib/unmanic"
SERVICE_FILE="/etc/systemd/system/unmanic.service"
SETTINGS_FILE="${DATA_DIR}/.unmanic/config/settings.json"
validate_config_paths "${INSTALL_DIR}/.af-version" "$SETTINGS_FILE" "$SERVICE_FILE"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8888}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

UNMANIC_TARGET_VER=""
if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    UNMANIC_TARGET_VER="$(af_normalize_exact_registry_version pypi "${AF_TARGET_VERSION}")" || exit 1
fi

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing FFmpeg, VAAPI drivers, and Python virtualenv dependencies..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    curl wget jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip \
    ffmpeg mediainfo sqlite3

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --no-create-home --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi

if getent group video >/dev/null 2>&1; then
    usermod -aG video "${APP_USER}" || true
fi
if getent group render >/dev/null 2>&1; then
    usermod -aG render "${APP_USER}" || true
fi

RUNTIME_BACKUP="$(af_create_recovery_backup_dir "af-runtime-")"
RUNTIME_PATHS=("/opt/unmanic" "/var/lib/unmanic" "/etc/systemd/system/unmanic.service")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_WAS_ACTIVE=0
RUNTIME_WAS_ENABLED=0
RUNTIME_QUIESCE_STARTED=0
RUNTIME_MUTATED=0
RUNTIME_ENABLE_ATTEMPTED=0
if systemctl is-active --quiet unmanic 2>/dev/null; then RUNTIME_WAS_ACTIVE=1; fi
if systemctl is-enabled --quiet unmanic 2>/dev/null; then RUNTIME_WAS_ENABLED=1; fi
if [[ -e "/opt/unmanic" || -f /etc/systemd/system/unmanic.service || "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
    RUNTIME_HAD_PREVIOUS=true
fi
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback unmanic || { restore_failed=true; exit 1; }
        if [[ "$RUNTIME_ENABLE_ATTEMPTED" -eq 1 && "$RUNTIME_WAS_ENABLED" -eq 0 ]]; then
            if ! af_logged systemctl disable unmanic; then
                systemd_unit_inactive unmanic true || restore_failed=true
            fi
        fi
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        af_logged systemctl daemon-reload || restore_failed=true
        if [[ "$RUNTIME_HAD_PREVIOUS" == true ]]; then
            if [[ "$restore_failed" == false && "$RUNTIME_WAS_ACTIVE" -eq 1 ]]; then
                af_logged systemctl restart unmanic || restore_failed=true
            fi
        else
            systemd_unit_inactive unmanic true || restore_failed=true
        fi
    elif [[ "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 0 && "$RUNTIME_WAS_ACTIVE" -eq 1 && "$RUNTIME_QUIESCE_STARTED" -eq 1 ]]; then
        af_logged systemctl restart unmanic || restore_failed=true
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        [[ "$RUNTIME_MUTATED" -eq 0 ]] || status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true ]]; then
    RUNTIME_QUIESCE_STARTED=1
    stop_systemd_unit unmanic
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 55 "Creating Python virtualenv and installing Unmanic..."
RUNTIME_MUTATED=1
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/.unmanic/config" "${DATA_DIR}/.unmanic/userdata"
# Older installations let the service account write the virtualenv.
chown root:root "${INSTALL_DIR}"
chmod 0755 "${INSTALL_DIR}"
rm -rf -- "${INSTALL_DIR}/.venv"
(
    umask 022
    af_logged python3 -m venv "${INSTALL_DIR}/.venv"
    af_logged "${INSTALL_DIR}/.venv/bin/pip" install --upgrade pip setuptools wheel
    if [[ -n "$UNMANIC_TARGET_VER" ]]; then
        af_logged "${INSTALL_DIR}/.venv/bin/pip" install --no-cache-dir "unmanic==${UNMANIC_TARGET_VER}"
    else
        af_logged "${INSTALL_DIR}/.venv/bin/pip" install --upgrade --no-cache-dir unmanic
    fi
)

validate_unmanic_cli_runtime() {
    local cli_ver="$1" expected_ver="$2" version_file=""
    local artifact="" expected_base="" suffix=""

    cli_ver="$(af_strip_version_prefix "$cli_ver")"
    if [[ "${cli_ver,,}" == unmanic[[:space:]]* ]]; then
        cli_ver="$(af_strip_version_prefix "${cli_ver#*[[:space:]]}")"
    fi
    [[ -n "$cli_ver" && "$cli_ver" != *[[:space:]]* ]] || return 1

    for artifact in "${INSTALL_DIR}"/.venv/lib*/python*/site-packages/unmanic/version; do
        [[ ! -L "$artifact" ]] || return 1
        if [[ -f "$artifact" ]]; then
            version_file="$artifact"
            break
        fi
    done

    # Post-release banners omit .postN. Use the installed wheel's exact version pair.
    if [[ -z "$version_file" ]]; then
        [[ "$cli_ver" == "$expected_ver" ]]
        return
    fi
    "${INSTALL_DIR}/.venv/bin/python" - "$version_file" "$expected_ver" "$cli_ver" <<'PYEOF' || return 1
import json
import sys

path, expected, banner = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    version = json.load(handle)
if not isinstance(version, dict) or version.get("short") != expected or version.get("long") != banner:
    sys.exit(1)
PYEOF

    if [[ "$cli_ver" == "$expected_ver" ]]; then
        return 0
    fi
    if [[ "$cli_ver" == "${expected_ver}~"* ]]; then
        suffix="${cli_ver#"${expected_ver}~"}"
    elif [[ "$expected_ver" =~ ^(.+)\.post[0-9]+$ ]]; then
        expected_base="${BASH_REMATCH[1]}"
        [[ "$cli_ver" == "${expected_base}+"* ]] || return 1
        suffix="${cli_ver#"${expected_base}+"}"
    fi
    [[ "$suffix" =~ ^[0-9A-Za-z]+(\.[0-9A-Za-z]+)*(\+[0-9A-Za-z._-]+)?$ ]]
}

if ! UNMANIC_META_VER="$("${INSTALL_DIR}/.venv/bin/python" -c "import importlib.metadata; print(importlib.metadata.version('unmanic'))" 2>/dev/null)"; then
    UNMANIC_META_VER=""
fi
UNMANIC_META_VER="${UNMANIC_META_VER%%$'\n'*}"
UNMANIC_VER="$(af_strip_version_prefix "$UNMANIC_META_VER")"
if [[ -z "${UNMANIC_VER}" ]]; then
    if [[ -z "$UNMANIC_TARGET_VER" && "${AF_ALLOW_RELEASE_FALLBACK:-0}" == "1" ]]; then
        UNMANIC_VER="0.4.1"
    else
        print_error "Failed to determine installed Unmanic version"
        exit 1
    fi
fi
if [[ -n "$UNMANIC_TARGET_VER" && "$UNMANIC_VER" != "$UNMANIC_TARGET_VER" ]]; then
    print_error "Installed Unmanic version (${UNMANIC_VER}) does not match requested target version (${UNMANIC_TARGET_VER})"
    exit 1
fi
if [[ ! -x "${INSTALL_DIR}/.venv/bin/unmanic" ]]; then
    print_error "Unmanic installation did not provide executable ${INSTALL_DIR}/.venv/bin/unmanic"
    exit 1
fi
UNMANIC_CLI_OUT=""
if ! UNMANIC_CLI_OUT="$("${INSTALL_DIR}/.venv/bin/unmanic" --version 2>/dev/null)"; then
    print_error "Failed to execute installed Unmanic CLI (${INSTALL_DIR}/.venv/bin/unmanic --version)"
    exit 1
fi
UNMANIC_CLI_VER="${UNMANIC_CLI_OUT%%$'\n'*}"
if [[ -z "$UNMANIC_CLI_VER" ]]; then
    print_error "Failed to verify installed Unmanic runtime version${UNMANIC_TARGET_VER:+ against target (${UNMANIC_TARGET_VER})}"
    exit 1
fi
if [[ -n "$UNMANIC_TARGET_VER" || -n "$UNMANIC_META_VER" ]]; then
    if ! validate_unmanic_cli_runtime "$UNMANIC_CLI_VER" "${UNMANIC_TARGET_VER:-$UNMANIC_VER}"; then
        print_error "Installed Unmanic runtime version (${UNMANIC_CLI_VER}) does not match installed distribution metadata (${UNMANIC_TARGET_VER:-$UNMANIC_VER})"
        exit 1
    fi
fi
queue_app_version "${INSTALL_DIR}/.af-version" "${UNMANIC_VER}"

report_progress 75 "Configuring ${APP_NAME} on port ${APP_PORT}..."
BIND_ADDRESS="${AF_BIND_ADDRESS:-127.0.0.1}"
if [[ ! -f "${SETTINGS_FILE}" ]]; then
    cat > "${SETTINGS_FILE}" <<EOF
{
  "ui_address": "${BIND_ADDRESS}",
  "ui_port": ${APP_PORT},
  "enable_inotify": false,
  "run_full_scan_on_start": false,
  "concurrent_workers": 2
}
EOF
else
    set_config_value "$SETTINGS_FILE" json ui_port "$APP_PORT"
    set_config_value "$SETTINGS_FILE" json ui_address "$BIND_ADDRESS"
fi

chown -hRP "${APP_USER}:${APP_USER}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Unmanic Automated Library Optimizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
Environment="PYTHONUNBUFFERED=1"
ExecStart=${INSTALL_DIR}/.venv/bin/unmanic --address ${BIND_ADDRESS} --port ${APP_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "${SERVICE_FILE}"

af_logged systemctl daemon-reload
RUNTIME_ENABLE_ATTEMPTED=1
af_logged systemctl enable --now unmanic.service

af_logged systemctl restart unmanic
systemctl is-active --quiet unmanic
READY_HOST="${BIND_ADDRESS}"
if [[ -z "$READY_HOST" || "$READY_HOST" == "0.0.0.0" || "$READY_HOST" == "::" ]]; then
    READY_HOST="127.0.0.1"
elif [[ "$READY_HOST" == *:* && "$READY_HOST" != \[*\] ]]; then
    READY_HOST="[${READY_HOST}]"
fi
wait_for_service_ready unmanic "$APP_PORT" "http://${READY_HOST}:${APP_PORT}/unmanic/api/v2/version/read"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
