#!/bin/bash
#
# [AetherFlow Install Script - Unmanic]
# Installs Unmanic automated media library optimizer and FFmpeg transcoding manager.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="unmanic"
APP_NAME="unmanic"
APP_USER="unmanic"
INSTALL_DIR="/opt/unmanic"
DATA_DIR="/var/lib/unmanic"
SERVICE_FILE="/etc/systemd/system/unmanic.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8888}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing FFmpeg, VAAPI drivers, and Python virtualenv dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq ca-certificates build-essential \
    python3 python3-venv python3-dev python3-pip \
    ffmpeg mediainfo sqlite3 >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${INSTALL_DIR}" "${DATA_DIR}" "${DATA_DIR}/.unmanic/config" "${DATA_DIR}/.unmanic/userdata"

if getent group video >/dev/null 2>&1; then
    usermod -aG video "${APP_USER}" || true
fi
if getent group render >/dev/null 2>&1; then
    usermod -aG render "${APP_USER}" || true
fi

RUNTIME_BACKUP="$(mktemp -d /tmp/af-runtime-XXXXXX)"
RUNTIME_PATHS=("/opt/unmanic" "/var/lib/unmanic" "/etc/systemd/system/unmanic.service")
RUNTIME_HAD_PREVIOUS=false
RUNTIME_MUTATED=0
[[ ! -e "/opt/unmanic" ]] || RUNTIME_HAD_PREVIOUS=true
rollback_runtime() {
    local status="$?" runtime_index runtime_path restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_MUTATED" -eq 1 ]]; then
        quiesce_services_for_rollback unmanic || { restore_failed=true; exit 1; }
        for runtime_index in "${!RUNTIME_PATHS[@]}"; do
            runtime_path="${RUNTIME_PATHS[$runtime_index]}"
            safe_restore_path_from_backup "$RUNTIME_BACKUP/$runtime_index" "$runtime_path" || restore_failed=true
        done
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$RUNTIME_HAD_PREVIOUS" == true ]]; then
            systemctl restart unmanic >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    [[ -z "${TMP_DIR:-}" ]] || rm -rf -- "$TMP_DIR"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at $RUNTIME_BACKUP"
    else
        rm -rf -- "$RUNTIME_BACKUP" || restore_failed=true
    fi
    exit "$status"
}
trap rollback_runtime EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$RUNTIME_HAD_PREVIOUS" == true || -f /etc/systemd/system/unmanic.service ]] || systemctl is-active --quiet unmanic 2>/dev/null; then
    stop_systemd_unit unmanic
fi
for runtime_index in "${!RUNTIME_PATHS[@]}"; do
    runtime_path="${RUNTIME_PATHS[$runtime_index]}"
    if [[ -e "$runtime_path" || -L "$runtime_path" ]]; then
        cp -a -- "$runtime_path" "$RUNTIME_BACKUP/$runtime_index"
    fi
done
report_progress 55 "Creating Python virtualenv and installing Unmanic..."
RUNTIME_MUTATED=1
if [[ ! -d "${INSTALL_DIR}/.venv" ]]; then
    python3 -m venv "${INSTALL_DIR}/.venv" >> "$LOGFILE" 2>&1
fi
"${INSTALL_DIR}/.venv/bin/pip" install --upgrade pip setuptools wheel >> "$LOGFILE" 2>&1
"${INSTALL_DIR}/.venv/bin/pip" install --upgrade --no-cache-dir unmanic >> "$LOGFILE" 2>&1

UNMANIC_VER="$("${INSTALL_DIR}/.venv/bin/python" -c "import importlib.metadata; print(importlib.metadata.version('unmanic'))" 2>/dev/null || true)"
if [[ -z "${UNMANIC_VER}" ]]; then
    if [[ "${AF_ALLOW_RELEASE_FALLBACK:-0}" == "1" ]]; then
        UNMANIC_VER="0.4.1"
    else
        print_error "Failed to determine installed Unmanic version"
        exit 1
    fi
fi
queue_app_version "${INSTALL_DIR}/.af-version" "${UNMANIC_VER}"

report_progress 75 "Configuring ${APP_NAME} on port ${APP_PORT}..."
SETTINGS_FILE="${DATA_DIR}/.unmanic/config/settings.json"
if [[ ! -f "${SETTINGS_FILE}" ]]; then
    cat > "${SETTINGS_FILE}" <<EOF
{
  "ui_port": ${APP_PORT},
  "enable_inotify": false,
  "run_full_scan_on_start": false,
  "concurrent_workers": 2
}
EOF
else
    set_config_value "$SETTINGS_FILE" json ui_port "$APP_PORT"
fi

chown -hRP "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Unmanic Automated Library Optimizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
Environment="HOME=${DATA_DIR}"
Environment="PYTHONUNBUFFERED=1"
ExecStart=${INSTALL_DIR}/.venv/bin/unmanic --port ${APP_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now unmanic.service >> "$LOGFILE" 2>&1

systemctl restart unmanic >> "$LOGFILE" 2>&1
systemctl is-active --quiet unmanic

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
