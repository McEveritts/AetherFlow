#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="paperless-ngx"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8010}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install /run/lock
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi
if [[ ! "${APP_PORT}" =~ ^[0-9]{1,5}$ ]] || (( 10#${APP_PORT} < 1 || 10#${APP_PORT} > 65535 )); then
    log_error "Invalid Paperless-ngx port: ${APP_PORT}"
    exit 1
fi
exec 9>/run/lock/aetherflow-paperless.lock
flock -n 9 || { log_error "Another Paperless-ngx installation is running."; exit 1; }

require_root
validate_config_paths /etc/paperless.conf /var/lib/paperless/data/db.sqlite3 /var/lib/paperless/data/db.sqlite3-wal /var/lib/paperless/data/db.sqlite3-shm

BUILD_DIR=""
BACKUP_DIR=""
WAS_RUNNABLE=0
SERVICE_STOPPED=0
APP_MOVED=0
APP_ACTIVATED=0
VENV_MOVED=0
VENV_ACTIVATED=0
CONF_HAD_PRIOR=0
CONF_TOUCHED=0
UNIT_WRITTEN=0
SUCCESS=0
PAPERLESS_DATABASE_NAME=""
PAPERLESS_DATABASE_SAVED=false

if [[ -f /etc/systemd/system/paperless-webserver.service ]] || systemctl is-active --quiet paperless-webserver 2>/dev/null || systemctl is-enabled --quiet paperless-webserver 2>/dev/null; then
    WAS_RUNNABLE=1
fi

cleanup() {
    local status=$? restore_failed=false
    trap - EXIT
    set +e
    if [[ "$SUCCESS" -ne 1 ]]; then
        if [[ "$APP_ACTIVATED" -eq 1 || "$VENV_ACTIVATED" -eq 1 || "$SERVICE_STOPPED" -eq 1 || "$UNIT_WRITTEN" -eq 1 ]]; then
            quiesce_services_for_rollback paperless-webserver paperless-worker paperless-scheduler || { restore_failed=true; exit 1; }
            if [[ "$PAPERLESS_DATABASE_SAVED" == true ]]; then
                restore_postgresql_database "$BACKUP_DIR" "$PAPERLESS_DATABASE_NAME" || exit 1
            fi
            restore_app_state "$BACKUP_DIR" || exit 1
        fi
        if [[ "$APP_ACTIVATED" -eq 1 ]]; then
            mv /opt/paperless "$BACKUP_DIR/failed-app" 2>/dev/null || rm -rf /opt/paperless
        elif [[ "$VENV_ACTIVATED" -eq 1 ]]; then
            rm -rf /opt/paperless/.venv || restore_failed=true
        fi
        if [[ "$APP_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/app" /opt/paperless 2>/dev/null || restore_failed=true
        elif [[ "$VENV_MOVED" -eq 1 ]]; then
            mv "$BACKUP_DIR/venv" /opt/paperless/.venv 2>/dev/null || restore_failed=true
        fi
        if [[ "$CONF_TOUCHED" -eq 1 ]]; then
            if [[ "$CONF_HAD_PRIOR" -eq 1 && -f "$BACKUP_DIR/paperless.conf" ]]; then
                safe_restore_path_from_backup "$BACKUP_DIR/paperless.conf" /etc/paperless.conf || restore_failed=true
            elif [[ "$CONF_HAD_PRIOR" -eq 0 ]]; then
                rm -f /etc/paperless.conf || restore_failed=true
            fi
        fi
        if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR/database-state" ]]; then
            safe_restore_path_from_backup "$BACKUP_DIR/database-state" /var/lib/paperless/data || restore_failed=true
        fi
        if [[ "$UNIT_WRITTEN" -eq 1 ]]; then
            for unit in paperless-webserver.service paperless-worker.service paperless-scheduler.service; do
                if [[ -f "$BACKUP_DIR/$unit" ]]; then
                    safe_restore_path_from_backup "$BACKUP_DIR/$unit" "/etc/systemd/system/$unit" || restore_failed=true
                else
                    af_logged systemctl disable "${unit%.service}" || restore_failed=true
                    rm -f "/etc/systemd/system/$unit" || restore_failed=true
                fi
            done
        fi
        af_logged systemctl daemon-reload || restore_failed=true
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" -eq 1 ]]; then
            af_logged systemctl start paperless-webserver paperless-worker paperless-scheduler || restore_failed=true
        fi
    fi
    if [[ -n "$BUILD_DIR" && -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR" || restore_failed=true
    fi
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing OCR, Redis, and Python system dependencies for Paperless-ngx..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq \
    redis-server tesseract-ocr tesseract-ocr-eng imagemagick ghostscript \
    poppler-utils gnupg libpq-dev libmagic-dev pkg-config default-libmysqlclient-dev \
    python3 python3-pip python3-venv python3-dev postgresql-client build-essential xz-utils curl git ca-certificates
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq libzbar0t64 || \
    DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq libzbar0 || true

af_logged systemctl enable --now redis-server

if ! id -u paperless >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/paperless --shell /usr/sbin/nologin paperless
fi

mkdir -p /var/lib/paperless/data \
         /var/lib/paperless/media \
         /var/lib/paperless/consume \
         /var/lib/paperless/export \
         /opt /var/backups

report_progress 35 "Resolving latest Paperless-ngx release tarball..."
PNGX_VER="$(github_latest_tag "paperless-ngx/paperless-ngx" "2.14.7")"
PNGX_URL="https://github.com/paperless-ngx/paperless-ngx/releases/download/v${PNGX_VER}/paperless-ngx-v${PNGX_VER}.tar.xz"

report_progress 55 "Downloading and extracting Paperless-ngx ${PNGX_VER} in staging directory..."
BUILD_DIR="$(mktemp -d /opt/.paperless-build.XXXXXX)"
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_XZ=$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/paperless-XXXXXX.tar.xz")
if ! af_logged download_file "$PNGX_URL" "$TMP_XZ"; then
    rm -f "$TMP_XZ"
    log_error "Failed to download or verify SHA-256 for Paperless-ngx ${PNGX_VER}"
    exit 1
fi
if [[ -z "${TEST_ROOT:-}" ]]; then
    af_validate_tar_archive "$TMP_XZ"
fi
tar --no-same-owner --no-same-permissions -xJf "$TMP_XZ" -C "$BUILD_DIR" --strip-components=1 2>/dev/null || af_logged tar --no-same-owner --no-same-permissions -xJf "$TMP_XZ" -C "$BUILD_DIR"
rm -f "$TMP_XZ"
test -f "$BUILD_DIR/src/manage.py" || { log_error "Failed to verify Paperless-ngx manage.py"; exit 1; }
queue_app_version "/opt/paperless/.af-version" "${PNGX_VER#v}"

report_progress 70 "Setting up Python virtual environment and dependencies..."
validate_config_paths /var/backups/.af-backup-root
BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-paperless.XXXXXX)"
chmod 700 "$BACKUP_DIR"
for unit in paperless-webserver.service paperless-worker.service paperless-scheduler.service; do
    if [[ -f "/etc/systemd/system/$unit" ]]; then
        cp -a "/etc/systemd/system/$unit" "$BACKUP_DIR/$unit"
    fi
done
if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    for unit in paperless-webserver.service paperless-worker.service paperless-scheduler.service; do
        stop_systemd_unit "$unit"
    done
    SERVICE_STOPPED=1
fi
snapshot_app_state "$BACKUP_DIR" /var/lib/paperless
if [[ -s /etc/paperless.conf ]]; then
    PAPERLESS_DATABASE_NAME="$(safe_config_python /etc/paperless.conf <<'PYEOF'
import shlex
settings = {}
for line in safe_read_text('/etc/paperless.conf').splitlines():
    key, separator, value = line.partition('=')
    if separator and key.strip() in ('PAPERLESS_DBHOST', 'PAPERLESS_DBNAME', 'PAPERLESS_DBENGINE'):
        parsed = shlex.split(value, comments=True)
        settings[key.strip()] = parsed[0] if parsed else ''
host = settings.get('PAPERLESS_DBHOST', '')
engine = settings.get('PAPERLESS_DBENGINE', 'postgresql')
if host and engine in ('postgresql', 'postgres', 'django.db.backends.postgresql'):
    if host not in ('127.0.0.1', 'localhost', '::1', '/var/run/postgresql'):
        raise SystemExit('Cannot snapshot a remote Paperless PostgreSQL database with local rollback helpers')
    print(settings.get('PAPERLESS_DBNAME') or 'paperless')
PYEOF
)"
    if [[ -n "$PAPERLESS_DATABASE_NAME" ]]; then
        backup_postgresql_database "$BACKUP_DIR" "$PAPERLESS_DATABASE_NAME"
        PAPERLESS_DATABASE_SAVED=true
    fi
fi
chmod 755 "$BUILD_DIR"
chown -hRP paperless:paperless "$BUILD_DIR" /var/lib/paperless
run_as_paperless_builder() {
    if [[ -z "${AF_FIXTURE_ROOT:-}" && -z "${TEST_ROOT:-}" && "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u paperless -- "$@"
    else
        "$@"
    fi
}
af_logged run_as_paperless_builder python3 -m venv "$BUILD_DIR/.venv"
af_logged run_as_paperless_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir --upgrade pip setuptools wheel
if [[ -f "$BUILD_DIR/requirements.txt" ]]; then
    af_logged run_as_paperless_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir -r "$BUILD_DIR/requirements.txt"
fi
af_logged run_as_paperless_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir gunicorn
af_logged run_as_paperless_builder "$BUILD_DIR/.venv/bin/pip" install --no-cache-dir psycopg2-binary || true
test -x "$BUILD_DIR/.venv/bin/python" || { log_error "Failed to verify Paperless-ngx virtual environment"; exit 1; }
python3 - "$BUILD_DIR/.venv" "/opt/paperless/.venv" <<'VENV_PYEOF'
import os, pathlib, stat, sys
old_venv, new_venv = sys.argv[1], sys.argv[2]
old_bytes, new_bytes = old_venv.encode(), new_venv.encode()
bin_dir = pathlib.Path(old_venv) / "bin"
if bin_dir.is_dir():
    for entry in bin_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            continue
        data = entry.read_bytes()
        updated = data
        if data.startswith(b"#!") and old_bytes in data.splitlines()[0]:
            first, sep, rest = data.partition(b"\n")
            updated = first.replace(old_bytes, new_bytes) + sep + rest
        elif entry.name.startswith("activate"):
            updated = data.replace(old_bytes, new_bytes)
        if updated != data:
            mode = stat.S_IMODE(entry.stat().st_mode)
            entry.write_bytes(updated)
            os.chmod(entry, mode)
VENV_PYEOF
chown -hRP root:root "$BUILD_DIR"
chmod -R go-w,a+rX "$BUILD_DIR"
chown -hRP paperless:paperless /var/lib/paperless

report_progress 78 "Configuring /etc/paperless.conf and backing up state..."
validate_config_paths /etc/paperless.conf
if [[ -f /etc/paperless.conf ]]; then
    CONF_HAD_PRIOR=1
    cp -a /etc/paperless.conf "$BACKUP_DIR/paperless.conf"
    CONF_TOUCHED=1
    safe_config_python /etc/paperless.conf "$APP_PORT" <<'PYEOF'
import re, sys
cfg_path, port = sys.argv[1], sys.argv[2]
text = safe_read_text(cfg_path)
if re.search(r"^PAPERLESS_PORT=", text, re.MULTILINE):
    text = re.sub(r"^PAPERLESS_PORT=.*", f"PAPERLESS_PORT={port}", text, flags=re.MULTILINE)
else:
    text += f"\nPAPERLESS_PORT={port}\n"
safe_write_text(cfg_path, text)
PYEOF
else
    SECRET_KEY="$(openssl rand -hex 32)"
    BASE_DOMAIN="$(get_base_domain || true)"
    PAPERLESS_URL_VAL="http://localhost:${APP_PORT}"
    PAPERLESS_CSRF_ORIGINS="http://localhost:${APP_PORT},http://127.0.0.1:${APP_PORT},http://paperless-ngx.aether.local"
    if [[ -n "$BASE_DOMAIN" ]]; then
        PAPERLESS_URL_VAL="https://paperless-ngx.${BASE_DOMAIN}"
        PAPERLESS_CSRF_ORIGINS="https://paperless-ngx.${BASE_DOMAIN},${PAPERLESS_CSRF_ORIGINS}"
    fi
    CONF_TOUCHED=1
    write_config_file /etc/paperless.conf <<EOF
PAPERLESS_REDIS=redis://localhost:6379
PAPERLESS_DATA_DIR=/var/lib/paperless/data
PAPERLESS_MEDIA_ROOT=/var/lib/paperless/media
PAPERLESS_CONSUMPTION_DIR=/var/lib/paperless/consume
PAPERLESS_EXPORT_DIR=/var/lib/paperless/export
PAPERLESS_SECRET_KEY=${SECRET_KEY}
PAPERLESS_URL=${PAPERLESS_URL_VAL}
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PAPERLESS_CSRF_TRUSTED_ORIGINS=${PAPERLESS_CSRF_ORIGINS}
PAPERLESS_USE_X_FORWARD_HOST=true
PAPERLESS_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO", "https"]
PAPERLESS_PORT=${APP_PORT}
PAPERLESS_BIND_ADDR=127.0.0.1
PAPERLESS_ADMIN_USER=${MASTER_USER}
PAPERLESS_ADMIN_PASSWORD=${MASTER_PASS}
PAPERLESS_ADMIN_MAIL=${MASTER_USER}@aether.local
EOF
fi
chmod 640 /etc/paperless.conf
chown root:paperless /etc/paperless.conf

if [[ -f /var/lib/paperless/data/db.sqlite3 ]]; then
    cp -a /var/lib/paperless/data/db.sqlite3 "$BACKUP_DIR/db.sqlite3"
fi
cp -a -- /var/lib/paperless/data "$BACKUP_DIR/database-state"

if [[ "$WAS_RUNNABLE" -eq 1 && "$SERVICE_STOPPED" -eq 0 ]]; then
    for unit in paperless-webserver.service paperless-worker.service paperless-scheduler.service; do
        stop_systemd_unit "$unit"
    done
    SERVICE_STOPPED=1
fi
if [[ -d /opt/paperless ]]; then
    mv /opt/paperless "$BACKUP_DIR/app"
    APP_MOVED=1
fi
mv "$BUILD_DIR" /opt/paperless
APP_ACTIVATED=1
BUILD_DIR=""
cd /opt/paperless

if [[ -f /opt/paperless/src/manage.py ]]; then
    export PAPERLESS_CONFIGURATION_PATH=/etc/paperless.conf
    export PAPERLESS_ADMIN_USER="${MASTER_USER}"
    export PAPERLESS_ADMIN_PASSWORD="${MASTER_PASS}"
    export PAPERLESS_ADMIN_MAIL="${MASTER_USER}@aether.local"
    export DJANGO_SUPERUSER_USERNAME="${MASTER_USER}"
    export DJANGO_SUPERUSER_PASSWORD="${MASTER_PASS}"
    export DJANGO_SUPERUSER_EMAIL="${MASTER_USER}@aether.local"
    af_logged /opt/paperless/.venv/bin/python /opt/paperless/src/manage.py migrate
    af_logged /opt/paperless/.venv/bin/python /opt/paperless/src/manage.py shell <<'PYEOF'
import os
from django.contrib.auth import get_user_model
UserModel = get_user_model()
if not UserModel.objects.filter(is_superuser=True).exists():
    UserModel.objects.create_superuser(
        username=os.environ['DJANGO_SUPERUSER_USERNAME'],
        email=os.environ['DJANGO_SUPERUSER_EMAIL'],
        password=os.environ['DJANGO_SUPERUSER_PASSWORD'],
    )
PYEOF
    af_logged /opt/paperless/.venv/bin/python /opt/paperless/src/manage.py collectstatic --no-input
fi

chown -hRP root:root /opt/paperless
chmod -R go-w,a+rX /opt/paperless
chown -hRP paperless:paperless /var/lib/paperless

report_progress 90 "Configuring multi-unit companion services (webserver, worker, scheduler)..."
UNIT_WRITTEN=1
PAPERLESS_BIND_HOST="$(retained_bind_address /etc/paperless.conf '^PAPERLESS_BIND_ADDR\s*=\s*([^\r\n#]+)')"
if [[ "$PAPERLESS_BIND_HOST" == *:* && "$PAPERLESS_BIND_HOST" != \[*\] ]]; then
    PAPERLESS_BIND_HOST="[$PAPERLESS_BIND_HOST]"
fi
sed -e "s/@AF_APP_PORT@/${APP_PORT}/g" -e "s/@AF_BIND_HOST@/${PAPERLESS_BIND_HOST}/g" <<'EOF' > /etc/systemd/system/paperless-webserver.service
[Unit]
Description=Paperless-ngx Web Server
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=paperless
Group=paperless
Type=simple
WorkingDirectory=/opt/paperless/src
EnvironmentFile=-/etc/paperless.conf
ExecStart=/opt/paperless/.venv/bin/gunicorn -b @AF_BIND_HOST@:@AF_APP_PORT@ -w 2 --threads 4 paperless.wsgi
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat <<'EOF' > /etc/systemd/system/paperless-worker.service
[Unit]
Description=Paperless-ngx Document Consumer and Task Worker
After=network.target redis-server.service paperless-webserver.service
Wants=redis-server.service

[Service]
User=paperless
Group=paperless
Type=simple
WorkingDirectory=/opt/paperless/src
EnvironmentFile=-/etc/paperless.conf
ExecStart=/opt/paperless/.venv/bin/celery -A paperless worker -l info
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat <<'EOF' > /etc/systemd/system/paperless-scheduler.service
[Unit]
Description=Paperless-ngx Celery Beat Scheduler
After=network.target redis-server.service paperless-webserver.service
Wants=redis-server.service

[Service]
User=paperless
Group=paperless
Type=simple
WorkingDirectory=/opt/paperless/src
EnvironmentFile=-/etc/paperless.conf
ExecStart=/opt/paperless/.venv/bin/celery -A paperless beat -l info
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

chmod 0644 /etc/systemd/system/paperless-webserver.service /etc/systemd/system/paperless-worker.service /etc/systemd/system/paperless-scheduler.service

PAPERLESS_READY_META="$(af_local_readiness_python /etc/paperless.conf "$PAPERLESS_BIND_HOST" "$APP_PORT" <<'PYEOF'
import ipaddress
import os
import pathlib
import re
import shlex
import sys
import urllib.parse

conf_path, bind_host, port = sys.argv[1], sys.argv[2].strip().strip('"').strip("'"), sys.argv[3].strip()
unbracketed = bind_host[1:-1] if bind_host.startswith("[") and bind_host.endswith("]") else bind_host


def emit(mode, url="", host_header="", emit_record="0", tls_insecure="0", reason=""):
    for val in (mode, url, host_header, emit_record, tls_insecure, reason):
        print(val)
    sys.exit(0)


def parse_env(text):
    values = {}
    for raw_line in text.splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("export ") and "=" in stripped[7:]:
            stripped = stripped[7:].strip()
        key, sep, value = stripped.partition("=")
        key = key.strip()
        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            continue
        val = value.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in ("'", '"'):
            val = val[1:-1]
        elif val and val[0] in ("'", '"'):
            q = val[0]
            end_q = val.find(q, 1)
            if end_q != -1:
                val = val[1:end_q]
        else:
            val = re.split(r"\s+#", val, maxsplit=1)[0].strip()
        values[key] = val
    return values


def host_allowed(candidate, allowed):
    c = candidate.lower().rstrip(".")
    for pat in allowed:
        p = pat.lower()
        if p == "*":
            return True
        if p.startswith("."):
            if c == p[1:] or c.endswith(p):
                return True
        elif c == p:
            return True
    return False


env = parse_env(safe_read_text(conf_path))

# Inspect Gunicorn overrides that could alter bind target, config, or TLS/mTLS.
scheme = "http"
gunicorn_args = env.get("GUNICORN_CMD_ARGS", "").strip()
if gunicorn_args:
    try:
        tokens = shlex.split(gunicorn_args)
    except ValueError:
        emit("skip", reason="retained GUNICORN_CMD_ARGS could not be parsed safely")
    has_cert = False
    has_key = False
    idx = 0
    while idx < len(tokens):
        tok = tokens[idx]
        if tok in ("-c", "--config", "-b", "--bind", "--paste", "--wsgi-app") or tok.startswith(
            ("--config=", "--bind=", "--paste=", "--wsgi-app=", "-c", "-b")
        ):
            if tok != "--check-config":
                emit(
                    "skip",
                    reason=f"retained GUNICORN_CMD_ARGS option '{tok}' overrides Gunicorn listener/config behavior",
                )
        elif tok == "--certfile" or tok.startswith("--certfile="):
            val = tok.split("=", 1)[1] if "=" in tok else (tokens[idx + 1] if idx + 1 < len(tokens) else "")
            if tok == "--certfile":
                idx += 1
            if val.strip():
                has_cert = True
        elif tok == "--keyfile" or tok.startswith("--keyfile="):
            val = tok.split("=", 1)[1] if "=" in tok else (tokens[idx + 1] if idx + 1 < len(tokens) else "")
            if tok == "--keyfile":
                idx += 1
            if val.strip():
                has_key = True
        elif tok == "--cert-reqs" or tok.startswith("--cert-reqs="):
            val = tok.split("=", 1)[1] if "=" in tok else (tokens[idx + 1] if idx + 1 < len(tokens) else "")
            if tok == "--cert-reqs":
                idx += 1
            if val not in ("", "0"):
                emit("skip", reason="retained GUNICORN_CMD_ARGS enables TLS client certificate verification")
        idx += 1
    if has_cert != has_key:
        emit("skip", reason="retained GUNICORN_CMD_ARGS specifies incomplete TLS certfile/keyfile settings")
    if has_cert and has_key:
        scheme = "https"

# Gunicorn strips only SCRIPT_NAME (not PAPERLESS_FORCE_SCRIPT_NAME) from PATH_INFO.
script_name = env.get("SCRIPT_NAME", "").strip()
prefix = script_name.rstrip("/")
if prefix:
    if (
        not prefix.startswith("/")
        or not re.fullmatch(r"/[A-Za-z0-9._/-]*", prefix)
        or "//" in prefix
        or any(part in (".", "..") for part in prefix.split("/"))
    ):
        emit("skip", reason=f"retained SCRIPT_NAME '{script_name}' is not a safe HTTP path prefix")
probe_path = f"{prefix}/accounts/login/"

# Resolve local bind host without probing external hosts.
connect_host = ""
strict_loopback = False
localhost_need = None  # "v4", "v6", "v6_dual", "any", or None

if bind_host in ("", "*", "0.0.0.0"):
    connect_host = "127.0.0.1"
    strict_loopback = True
    localhost_need = "v4"
elif bind_host in ("::", "[::]"):
    connect_host = "[::1]"
    strict_loopback = True
    localhost_need = "v6_dual"
elif bind_host.lower() == "localhost":
    lb_ips = resolve_localhost_loopback_ips(port)
    if not lb_ips:
        emit("skip", reason="retained PAPERLESS_BIND_ADDR 'localhost' did not resolve strictly to loopback addresses")
    connect_host = "localhost"
    strict_loopback = True
    localhost_need = "any"
else:
    try:
        ip = ipaddress.ip_address(unbracketed)
    except ValueError:
        emit(
            "skip",
            reason=f"retained PAPERLESS_BIND_ADDR '{bind_host}' is a non-loopback hostname that cannot be proved local without risking an external probe",
        )
    mapped = getattr(ip, "ipv4_mapped", None)
    if ip.is_unspecified:
        if ip.version == 4:
            connect_host = "127.0.0.1"
            localhost_need = "v4"
        else:
            connect_host = "[::1]"
            localhost_need = "v6_dual"
        strict_loopback = True
    elif ip.is_loopback or (mapped is not None and mapped.is_loopback):
        connect_host = str(ip) if ip.version == 4 else f"[{ip}]"
        strict_loopback = True
        if str(ip) == "127.0.0.1":
            localhost_need = "v4"
        elif str(ip) == "::1":
            localhost_need = "v6"
        else:
            localhost_need = None
    elif ip.version == 6 and ip.is_link_local:
        emit(
            "skip",
            reason=f"retained PAPERLESS_BIND_ADDR '{bind_host}' is a link-local IPv6 address without an unambiguous HTTP URL",
        )
    elif is_local_interface_ip(ip):
        connect_host = str(ip) if ip.version == 4 else f"[{ip}]"
        strict_loopback = False
        localhost_need = None
    else:
        emit(
            "skip",
            reason=f"retained PAPERLESS_BIND_ADDR '{bind_host}' is not assigned to a local interface on this host",
        )

# Compute Paperless-ngx's effective Django ALLOWED_HOSTS (matching upstream settings).
has_allowed = "PAPERLESS_ALLOWED_HOSTS" in env
paperless_url = env.get("PAPERLESS_URL", "").strip()
if has_allowed or paperless_url:
    allowed_hosts = [h.strip() for h in env.get("PAPERLESS_ALLOWED_HOSTS", "").split(",") if h.strip()]
else:
    allowed_hosts = ["*"]
if allowed_hosts != ["*"]:
    allowed_hosts.append("localhost")
if paperless_url:
    parsed_url = urllib.parse.urlparse(paperless_url)
    u_host = (parsed_url.hostname or "").removesuffix(".")
    if u_host and u_host != "*" and not u_host.startswith("."):
        if ":" in u_host and not u_host.startswith("["):
            u_host = f"[{u_host}]"
        allowed_hosts.append(u_host)

tls_insecure = "1" if (scheme == "https" and strict_loopback) else "0"

if host_allowed(connect_host, allowed_hosts):
    emit("probe", f"{scheme}://{connect_host}:{port}{probe_path}", "", "1", tls_insecure, "")

# Paperless-ngx always appends "localhost" to ALLOWED_HOSTS. Prefer http(s)://localhost:<port>
# when localhost strictly resolves to the bound loopback address so runner replay works too.
if localhost_need is not None:
    lb_ips = resolve_localhost_loopback_ips(port)
    if lb_ips:
        can_use_localhost = False
        if localhost_need == "any":
            can_use_localhost = True
        elif localhost_need == "v4":
            can_use_localhost = ipaddress.IPv4Address("127.0.0.1") in lb_ips
        elif localhost_need == "v6":
            can_use_localhost = ipaddress.IPv6Address("::1") in lb_ips
        elif localhost_need == "v6_dual":
            if ipaddress.IPv6Address("::1") in lb_ips:
                can_use_localhost = True
            elif ipaddress.IPv4Address("127.0.0.1") in lb_ips:
                proc_root = pathlib.Path(os.environ.get("AF_PROC_ROOT") or "/proc")
                try:
                    v6only = (proc_root / "sys/net/ipv6/bindv6only").read_text(encoding="utf-8").strip()
                except OSError:
                    v6only = "1"
                can_use_localhost = v6only == "0"
        if can_use_localhost:
            emit(
                "probe",
                f"{scheme}://localhost:{port}{probe_path}",
                "",
                "1",
                "1" if scheme == "https" else "0",
                "",
            )

emit(
    "probe",
    f"{scheme}://{connect_host}:{port}{probe_path}",
    "localhost",
    "0",
    tls_insecure,
    f"retained PAPERLESS_ALLOWED_HOSTS excludes '{connect_host}' so direct local readiness requires Host: localhost, which af_emit_readiness_record cannot encode",
)
PYEOF
)"
mapfile -t PAPERLESS_READY_FIELDS <<< "$PAPERLESS_READY_META"
PAPERLESS_READY_MODE="${PAPERLESS_READY_FIELDS[0]:-skip}"
PAPERLESS_READY_URL="${PAPERLESS_READY_FIELDS[1]:-}"
PAPERLESS_HOST_HEADER="${PAPERLESS_READY_FIELDS[2]:-}"
PAPERLESS_EMIT_RECORD="${PAPERLESS_READY_FIELDS[3]:-0}"
PAPERLESS_TLS_INSECURE="${PAPERLESS_READY_FIELDS[4]:-0}"
PAPERLESS_READY_REASON="${PAPERLESS_READY_FIELDS[5]:-}"

af_logged systemctl daemon-reload
af_logged systemctl enable --now paperless-webserver
af_logged systemctl enable --now paperless-worker
af_logged systemctl enable --now paperless-scheduler

if [[ "$PAPERLESS_READY_MODE" != "probe" ]]; then
    if declare -F print_warn >/dev/null 2>&1; then
        print_warn "Skipping direct HTTP readiness probe for paperless-webserver.service: ${PAPERLESS_READY_REASON:-unproven retained listener}; keeping systemd-only readiness check."
    else
        log_warn "Skipping direct HTTP readiness probe for paperless-webserver.service: ${PAPERLESS_READY_REASON:-unproven retained listener}; keeping systemd-only readiness check."
    fi
fi

if ! af_wait_local_web_services "$PAPERLESS_READY_URL" "" "$PAPERLESS_TLS_INSECURE" \
    "$PAPERLESS_HOST_HEADER" paperless-webserver paperless-worker paperless-scheduler >/dev/null; then
    if [[ "$PAPERLESS_READY_MODE" == "probe" ]]; then
        log_error "Paperless-ngx web service did not become HTTP-ready at ${PAPERLESS_READY_URL} or companion units were not active; rolling back."
    else
        log_error "Paperless-ngx services did not become active; rolling back."
    fi
    exit 1
fi
systemctl is-active --quiet paperless-webserver
systemctl is-active --quiet paperless-worker
systemctl is-active --quiet paperless-scheduler
if [[ "$PAPERLESS_READY_MODE" == "probe" && "$PAPERLESS_EMIT_RECORD" != "1" && -n "$PAPERLESS_READY_REASON" ]]; then
    if declare -F print_warn >/dev/null 2>&1; then
        print_warn "Verified local HTTP readiness for paperless-webserver.service without emitting af_emit_readiness_record: ${PAPERLESS_READY_REASON}"
    else
        log_warn "Verified local HTTP readiness for paperless-webserver.service without emitting af_emit_readiness_record: ${PAPERLESS_READY_REASON}"
    fi
fi

commit_app_versions
write_lock "${PACKAGE_NAME}"
SUCCESS=1
if [[ "$PAPERLESS_READY_MODE" == "probe" && "$PAPERLESS_EMIT_RECORD" == "1" && -n "$PAPERLESS_READY_URL" ]] \
    && declare -F af_emit_readiness_record >/dev/null 2>&1; then
    af_emit_readiness_record "paperless-webserver.service" "$PAPERLESS_READY_URL" false false
fi
rm -rf -- "$BACKUP_DIR"
report_progress 100 "Paperless-ngx installed on port ${APP_PORT} (multi-unit companion stack active)."
log_info "${PACKAGE_NAME} installed successfully"
