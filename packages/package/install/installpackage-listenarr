#!/bin/bash
#
# [AetherFlow Install Script - Listenarr]
# Installs Listenarr automated audiobook collection manager on bare-metal Linux.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="listenarr"
APP_NAME="listenarr"
APP_USER="listenarr"
INSTALL_DIR="/opt/Listenarr"
DATA_DIR="/var/lib/listenarr"
SERVICE_FILE="/etc/systemd/system/listenarr.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-4546}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials

report_progress 25 "Installing system dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl wget jq unzip ca-certificates libicu-dev libssl-dev sqlite3 >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p /opt /var/lib /var/backups

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
    amd64) L_ARCH="linux-x64" ;;
    arm64) L_ARCH="linux-arm64" ;;
    *)
        log_error "Unsupported architecture for Listenarr: ${ARCH}"
        exit 1
        ;;
esac

report_progress 45 "Resolving latest ${APP_NAME} release from GitHub..."
AUTH_HEADER=()
GH_TOKEN="${AF_GITHUB_TOKEN:-${GITHUB_TOKEN:-}}"
if [[ -n "$GH_TOKEN" ]]; then
    AUTH_HEADER=(-H "Authorization: Bearer $GH_TOKEN")
fi

RELEASES_JSON="$(curl -fsSL ${AUTH_HEADER:+"${AUTH_HEADER[@]}"} https://api.github.com/repos/Listenarrs/Listenarr/releases 2>/dev/null || true)"

if [[ -n "${AF_TARGET_VERSION:-}" ]]; then
    MATCH_LINE="$(echo "${RELEASES_JSON}" | jq -r --arg ver "$AF_TARGET_VERSION" --arg vver "v${AF_TARGET_VERSION#v}" --arg rver "${AF_TARGET_VERSION#v}" --arg arch "${L_ARCH}.zip" '
        .[] | select((.tag_name == $ver or .tag_name == $vver or .tag_name == $rver) and any(.assets[]?; .name | endswith($arch))) |
        "\(.tag_name)\t\([.assets[] | select(.name | endswith($arch))][0].browser_download_url)"
    ' | head -n1 || true)"
    if [[ -z "$MATCH_LINE" ]]; then
        TARGET_TAG_LOOKUP="$AF_TARGET_VERSION"
        TAG_RELEASE_JSON="$(curl -fsSL ${AUTH_HEADER:+"${AUTH_HEADER[@]}"} "https://api.github.com/repos/Listenarrs/Listenarr/releases/tags/${TARGET_TAG_LOOKUP}" 2>/dev/null || true)"
        if [[ -z "$TAG_RELEASE_JSON" && ! "$TARGET_TAG_LOOKUP" =~ ^v ]]; then
            TARGET_TAG_LOOKUP="v${TARGET_TAG_LOOKUP}"
            TAG_RELEASE_JSON="$(curl -fsSL ${AUTH_HEADER:+"${AUTH_HEADER[@]}"} "https://api.github.com/repos/Listenarrs/Listenarr/releases/tags/${TARGET_TAG_LOOKUP}" 2>/dev/null || true)"
        fi
        if [[ -n "$TAG_RELEASE_JSON" ]]; then
            MATCH_LINE="$(echo "${TAG_RELEASE_JSON}" | jq -r --arg arch "${L_ARCH}.zip" '
                "\(.tag_name)\t\([.assets[] | select(.name | endswith($arch))][0].browser_download_url // empty)"
            ' || true)"
        fi
    fi
    LATEST_TAG="$(echo "$MATCH_LINE" | cut -f1)"
    ASSET_URL="$(echo "$MATCH_LINE" | cut -f2)"
else
    MATCH_LINE="$(echo "${RELEASES_JSON}" | jq -r --arg arch "${L_ARCH}.zip" '
        .[] | select(any(.assets[]?; .name | endswith($arch))) |
        "\(.tag_name)\t\([.assets[] | select(.name | endswith($arch))][0].browser_download_url)"
    ' | sort -V -k1,1 | tail -n1 || true)"
    LATEST_TAG="$(echo "$MATCH_LINE" | cut -f1)"
    ASSET_URL="$(echo "$MATCH_LINE" | cut -f2)"
fi

if [[ -z "${LATEST_TAG}" ]]; then
    print_error "Failed to discover GitHub release for Listenarrs/Listenarr"
    exit 1
fi
if [[ -z "${ASSET_URL}" ]]; then
    log_error "Failed to locate Listenarr release asset for ${L_ARCH}"
    exit 1
fi

TMP_ZIP="$(mktemp --suffix=.zip)"
TMP_EXTRACT="$(mktemp -d /opt/.listenarr-build.XXXXXX)"
chmod 755 "$TMP_EXTRACT"
BACKUP_DIR=""
APP_MOVED=false
APP_ACTIVATED=false
RUNTIME_CHANGED=false
WAS_RUNNABLE=false
cleanup() {
    local status=$? restore_failed=false
    trap - EXIT INT TERM
    set +e
    if [[ "${INSTALL_COMMITTED:-false}" != true && "$status" -ne 0 && "$RUNTIME_CHANGED" == true ]]; then
        quiesce_services_for_rollback listenarr.service || { restore_failed=true; exit 1; }
        if [[ "$APP_ACTIVATED" == true ]]; then
            rm -rf -- "$INSTALL_DIR" || restore_failed=true
        fi
        if [[ "$APP_MOVED" == true ]]; then
            mv -T "$BACKUP_DIR/app" "$INSTALL_DIR" || restore_failed=true
        fi
        safe_restore_path_from_backup "$BACKUP_DIR/data" "$DATA_DIR" || restore_failed=true
        if [[ -f "$BACKUP_DIR/listenarr.service" ]]; then
            safe_restore_path_from_backup "$BACKUP_DIR/listenarr.service" "$SERVICE_FILE" || restore_failed=true
        else
            systemctl disable listenarr.service >> "$LOGFILE" 2>&1 || restore_failed=true
            rm -f -- "$SERVICE_FILE" || restore_failed=true
        fi
        systemctl daemon-reload >> "$LOGFILE" 2>&1 || restore_failed=true
        if [[ "$restore_failed" == false && "$WAS_RUNNABLE" == true ]]; then
            systemctl start listenarr.service >> "$LOGFILE" 2>&1 || restore_failed=true
        fi
    fi
    rm -f -- "$TMP_ZIP"
    rm -rf -- "$TMP_EXTRACT"
    if [[ "$restore_failed" == true ]]; then
        status=1
        print_warn "Rollback incomplete; recovery backup preserved at ${BACKUP_DIR:-${RUNTIME_BACKUP:-unknown}}"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
report_progress 65 "Downloading ${APP_NAME} (${LATEST_TAG})..."
download_file "${ASSET_URL}" "${TMP_ZIP}" >> "$LOGFILE" 2>&1

report_progress 80 "Extracting ${APP_NAME} to ${INSTALL_DIR}..."
unzip -qo "${TMP_ZIP}" -d "${TMP_EXTRACT}" >> "$LOGFILE" 2>&1
rm -f "${TMP_ZIP}"

STAGE_SRC="$TMP_EXTRACT"
if [[ ! -s "$STAGE_SRC/Listenarr.Api" && ! -s "$STAGE_SRC/Listenarr.dll" ]]; then
    mapfile -t RELEASE_DIRS < <(find "$TMP_EXTRACT" -mindepth 1 -maxdepth 1 -type d)
    [[ "${#RELEASE_DIRS[@]}" -eq 1 ]] || { print_error "Invalid Listenarr release layout"; exit 1; }
    STAGE_SRC="${RELEASE_DIRS[0]}"
fi
[[ -s "$STAGE_SRC/Listenarr.Api" || -s "$STAGE_SRC/Listenarr.dll" ]] || { print_error "Listenarr release is missing its runtime"; exit 1; }
chmod +x "${STAGE_SRC}/Listenarr.Api" 2>/dev/null || true
queue_app_version "$INSTALL_DIR/.af-version" "${LATEST_TAG#v}"

BACKUP_DIR="$(mktemp -d /var/backups/aetherflow-listenarr.XXXXXX)"
chmod 700 "$BACKUP_DIR"
if [[ -f "$SERVICE_FILE" ]]; then
    cp -a "$SERVICE_FILE" "$BACKUP_DIR/listenarr.service"
fi
if [[ -f /etc/systemd/system/listenarr.service ]] || systemctl is-active --quiet listenarr.service 2>/dev/null; then
    WAS_RUNNABLE=true
    stop_systemd_unit listenarr.service
fi
if [[ -d "$DATA_DIR" ]]; then
    cp -a "$DATA_DIR" "$BACKUP_DIR/data"
fi
RUNTIME_CHANGED=true
if [[ -e "$INSTALL_DIR" ]]; then
    mv -T "${INSTALL_DIR}" "${BACKUP_DIR}/app"
    APP_MOVED=true
fi
mv -T "${STAGE_SRC}" "${INSTALL_DIR}"
APP_ACTIVATED=true
mkdir -p "${DATA_DIR}/config"
chown -hRP "${APP_USER}:${APP_USER}" "${INSTALL_DIR}" "${DATA_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Listenarr Audiobook Collection Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
Environment="ASPNETCORE_URLS=http://*:${APP_PORT}"
Environment="DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false"
Environment="HOME=${DATA_DIR}"
Environment="XDG_CONFIG_HOME=${DATA_DIR}/config"
ExecStart=${INSTALL_DIR}/Listenarr.Api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now listenarr.service >> "$LOGFILE" 2>&1
systemctl restart listenarr.service >> "$LOGFILE" 2>&1
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
wait_for_service_ready "listenarr.service" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
RUNTIME_CHANGED=false
rm -rf -- "$BACKUP_DIR"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
