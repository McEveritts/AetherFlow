#!/bin/bash
# AetherFlow Package Installer: Autoscan
# Port: 3030

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="autoscan"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing prerequisites for Autoscan..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u autoscan >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/autoscan --shell /usr/sbin/nologin autoscan
fi

mkdir -p /etc/autoscan /var/lib/autoscan /opt/autoscan

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) AS_ARCH="amd64" ;;
    arm64) AS_ARCH="arm64" ;;
    armhf) AS_ARCH="armv6" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Autoscan release from Cloudbox..."
AS_JSON="$(curl -fsSL https://api.github.com/repos/Cloudbox/autoscan/releases/latest 2>/dev/null || true)"
AS_VERSION="$(printf '%s' "$AS_JSON" | grep -oP '"tag_name":\s*"v\K[^"]+' | head -1 || true)"
AS_VERSION="${AS_VERSION:-1.4.0}"
AS_URL="$(printf '%s' "$AS_JSON" | grep -oP '"browser_download_url":\s*"\K[^"]*autoscan_'${AS_VERSION}'_linux_'${AS_ARCH}'\.tar\.gz' | head -1 || true)"
if [[ -z "$AS_URL" ]]; then
    AS_URL="https://github.com/Cloudbox/autoscan/releases/download/v${AS_VERSION}/autoscan_${AS_VERSION}_linux_${AS_ARCH}.tar.gz"
fi

report_progress 60 "Downloading Autoscan ${AS_VERSION} (${AS_ARCH})..."
TMP_TAR=$(mktemp /tmp/autoscan-XXXXXX.tar.gz)
curl -fsSL "$AS_URL" -o "$TMP_TAR" >> "$LOGFILE" 2>&1
tar -xzf "$TMP_TAR" -C /usr/local/bin autoscan >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
chmod 755 /usr/local/bin/autoscan
printf '%s\n' "${AS_VERSION#v}" > /opt/autoscan/.af-version

report_progress 75 "Performing Zero-Touch Arr API key auto-discovery for Autoscan..."
get_arr_key() {
    local app="$1"
    local xml_file="/var/lib/${app}/config.xml"
    if [[ -f "$xml_file" ]]; then
        grep -oP '<ApiKey>\K[^<]+' "$xml_file" 2>/dev/null || sed -n 's/.*<ApiKey>\(.*\)<\/ApiKey>.*/\1/p' "$xml_file" 2>/dev/null || true
    fi
}

SONARR_KEY=$(get_arr_key "sonarr")
RADARR_KEY=$(get_arr_key "radarr")

cat <<EOF > /etc/autoscan/config.yml
# Autoscan configuration generated by AetherFlow
port: 3030
scan-priority: 0
minimum-age: 1m
scan-delay: 5s

anchors:
  - /mnt/unionfs
  - /downloads

triggers:
EOF

if [[ -n "$SONARR_KEY" ]]; then
    cat <<EOF >> /etc/autoscan/config.yml
  sonarr:
    - name: sonarr
      priority: 1
      api-key: "${SONARR_KEY}"
EOF
fi

if [[ -n "$RADARR_KEY" ]]; then
    cat <<EOF >> /etc/autoscan/config.yml
  radarr:
    - name: radarr
      priority: 1
      api-key: "${RADARR_KEY}"
EOF
fi

if [[ -z "$SONARR_KEY" && -z "$RADARR_KEY" ]]; then
    cat <<'EOF' >> /etc/autoscan/config.yml
  manual:
    - name: manual
      priority: 0
EOF
fi

chown -R autoscan:autoscan /etc/autoscan /var/lib/autoscan /opt/autoscan
chmod 640 /etc/autoscan/config.yml

report_progress 85 "Configuring and starting autoscan.service on port 3030..."
cat <<'EOF' > /etc/systemd/system/autoscan.service
[Unit]
Description=Autoscan Media Scanner Daemon
After=network.target

[Service]
User=autoscan
Group=autoscan
Type=simple
ExecStart=/usr/local/bin/autoscan --config /etc/autoscan/config.yml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now autoscan >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Autoscan installed on port 3030 (Arr webhooks ready)."
log_info "${PACKAGE_NAME} installed successfully"
