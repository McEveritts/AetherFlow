#!/bin/bash
# AetherFlow Package Installer: Autoscan
# Port: 3030

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="autoscan"
EXPLICIT_APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-}}"
APP_PORT="${EXPLICIT_APP_PORT:-3030}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
validate_config_paths /etc/autoscan/config.yml
if [[ ! "$APP_PORT" =~ ^[0-9]{1,5}$ ]] || (( 10#$APP_PORT < 1 || 10#$APP_PORT > 65535 )); then
    print_error "Invalid Autoscan listener port"
    exit 1
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
print_warn "Cloudbox Autoscan is archived, unmaintained and feature frozen; future integration incompatibilities will not receive upstream fixes. Existing configuration and data are preserved; no fork is substituted."
report_progress 10 "Installing prerequisites for Autoscan..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl ca-certificates

if ! id -u autoscan >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/autoscan --shell /usr/sbin/nologin autoscan
fi

mkdir -p /etc/autoscan /var/lib/autoscan /opt/autoscan

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) AS_ARCH="amd64" ;;
    arm64) AS_ARCH="arm64" ;;
    armhf) AS_ARCH="armv7" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Resolving latest Autoscan release from Cloudbox..."
AS_VERSION="$(github_latest_tag "Cloudbox/autoscan" "1.4.0")"
AS_URL="https://github.com/Cloudbox/autoscan/releases/download/v${AS_VERSION}/autoscan_v${AS_VERSION}_linux_${AS_ARCH}"

report_progress 60 "Downloading Autoscan ${AS_VERSION} (${AS_ARCH})..."
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_DIR="$(mktemp -d "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/autoscan-extract-XXXXXX")"
trap '[[ -z "${TMP_DIR:-}" ]] || rm -rf "$TMP_DIR"' EXIT
af_logged download_file "$AS_URL" "$TMP_DIR/autoscan"
chmod 755 "$TMP_DIR/autoscan"
stage_app_archive "$TMP_DIR" /usr/local/bin/autoscan autoscan /etc/autoscan "$PACKAGE_NAME" "." /opt/autoscan "" binary
TMP_DIR=""
queue_app_version /opt/autoscan/.af-version "${AS_VERSION#v}"

report_progress 75 "Configuring Autoscan..."
BIND_ADDRESS="${AF_BIND_ADDRESS:-127.0.0.1}"
RETAINED_CONFIG=false
if [[ -f /etc/autoscan/config.yml ]]; then
    RETAINED_CONFIG=true
fi

if [[ "$RETAINED_CONFIG" == false ]]; then
cat <<EOF > /etc/autoscan/config.yml
# Autoscan configuration generated by AetherFlow
# Configure media server targets (Plex/Emby/Jellyfin), authentication,
# and anchor files (regular files, not directories) before enabling automated scans.
host:
  - ${BIND_ADDRESS}
port: ${APP_PORT}
minimum-age: 1m
scan-delay: 5s

# anchors:
#   - /mnt/unionfs/mount.anchor

triggers:
  manual:
    priority: 0
EOF

if [[ -f /var/lib/sonarr/config.xml ]]; then
    cat <<'EOF' >> /etc/autoscan/config.yml
  sonarr:
    - name: sonarr
      priority: 1
EOF
fi

if [[ -f /var/lib/radarr/config.xml ]]; then
    cat <<'EOF' >> /etc/autoscan/config.yml
  radarr:
    - name: radarr
      priority: 1
EOF
fi
elif [[ -n "$EXPLICIT_APP_PORT" ]]; then
    set_config_value "/etc/autoscan/config.yml" yaml "port" "$APP_PORT" ""
fi

safe_config_python /etc/autoscan/config.yml "$BIND_ADDRESS" <<'PYEOF'
import re, sys

cfg_path, bind_addr = sys.argv[1], sys.argv[2]
with ManagedConfig(cfg_path, create_parents=False) as cfg:
    text = cfg.read_text()
    m = re.search(r'(?m)^host:[ \t]*([^\n]*)(?:\n|$)((?:[ \t]+-[ \t]*[^\n]*(?:\n|$))*)', text)
    if m is None:
        text = f"host:\n  - {bind_addr}\n" + text
        cfg.write_text(text, 0o640)
    else:
        inline = m.group(1).strip()
        if inline.startswith("#"):
            inline = ""
        items_block = m.group(2)
        if inline in ("", "[]", "['']", '[""]', '["0.0.0.0"]', "['0.0.0.0']", '["*"]', "['*']") and not items_block.strip():
            replacement = f"host:\n  - {bind_addr}\n"
            text = text[:m.start()] + replacement + text[m.end():]
            cfg.write_text(text, 0o640)
        elif items_block.strip():
            items = []
            for ln in items_block.splitlines():
                s = ln.strip()
                if not s.startswith("-"):
                    continue
                val = s[1:].strip()
                if val and val[0] in ("'", '"'):
                    q = val[0]
                    end_q = val.find(q, 1)
                    val = val[1:end_q] if end_q != -1 else val.strip(q)
                else:
                    val = val.split("#", 1)[0].strip()
                items.append(val)
            if not items or all(item in ("", "0.0.0.0", "*") for item in items):
                replacement = f"host:\n  - {bind_addr}\n"
                text = text[:m.start()] + replacement + text[m.end():]
                cfg.write_text(text, 0o640)
PYEOF

chown -hRP autoscan:autoscan /etc/autoscan /var/lib/autoscan /opt/autoscan
chmod 755 /opt/autoscan /var/lib/autoscan
chmod 640 /etc/autoscan/config.yml

READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
if [[ "$READY_URL" =~ ^https?://(\[[^]]+\]|[^:/]+):([0-9]{1,5})(/.*)?$ ]]; then
    READY_PORT="${BASH_REMATCH[2]}"
    if [[ -n "$EXPLICIT_APP_PORT" ]] && (( 10#$READY_PORT != 10#$APP_PORT )); then
        print_error "Autoscan's retained host port overrides requested port $APP_PORT. Use port $READY_PORT or update the host entry in /etc/autoscan/config.yml."
        exit 1
    fi
    APP_PORT="$READY_PORT"
    export AF_APP_PORT="$APP_PORT"
fi

report_progress 85 "Configuring and starting autoscan.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/autoscan.service
[Unit]
Description=Autoscan Media Scanner Daemon
After=network.target

[Service]
User=autoscan
Group=autoscan
Type=simple
Environment=XDG_CONFIG_HOME=/var/lib/autoscan/.config
ExecStart=/usr/local/bin/autoscan --config /etc/autoscan/config.yml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/autoscan.service


af_logged systemctl daemon-reload
af_logged systemctl enable --now autoscan
af_logged systemctl restart autoscan
systemctl is-active --quiet autoscan
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "$READY_URL"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Autoscan installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
