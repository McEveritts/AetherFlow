#!/bin/bash
# AetherFlow Package Installer: NZBGet (nzbgetcom/nzbget fork)
# Port: 6789

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="nzbget"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for NZBGet..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl p7zip-full par2 unzip unrar-free python3 ca-certificates >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq unrar >> "$LOGFILE" 2>&1 || true

if ! id -u nzbget >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/nzbget --shell /usr/sbin/nologin nzbget
fi

mkdir -p /opt/nzbget /var/lib/nzbget

report_progress 35 "Resolving latest NZBGet release..."
NZBGET_VERSION="$(github_latest_tag "nzbgetcom/nzbget" "24.3")"
NZBGET_URL="https://github.com/nzbgetcom/nzbget/releases/download/v${NZBGET_VERSION}/nzbget-${NZBGET_VERSION}-bin-linux.run"

report_progress 60 "Downloading and installing NZBGet ${NZBGET_VERSION}..."
TMP_RUN=$(mktemp /tmp/nzbget-XXXXXX.run)
curl -fsSL "$NZBGET_URL" -o "$TMP_RUN" >> "$LOGFILE" 2>&1
sh "$TMP_RUN" --destdir /opt/nzbget >> "$LOGFILE" 2>&1
rm -f "$TMP_RUN"

printf '%s\n' "${NZBGET_VERSION#v}" > /opt/nzbget/.af-version

if [[ -f /opt/nzbget/nzbget.conf ]]; then
    sed -i 's|^MainDir=.*|MainDir=/var/lib/nzbget|g' /opt/nzbget/nzbget.conf
    sed -i 's|^ControlIP=.*|ControlIP=0.0.0.0|g' /opt/nzbget/nzbget.conf
    sed -i 's|^ControlPort=.*|ControlPort=6789|g' /opt/nzbget/nzbget.conf
    python3 - /opt/nzbget/nzbget.conf "${MASTER_USER}" "${MASTER_PASS}" <<'PYEOF'
import sys, re
path, user, pw = sys.argv[1:4]
txt = open(path, "r", encoding="utf-8", errors="ignore").read()
txt = re.sub(r"(?m)^ControlUsername=.*$", lambda _: f"ControlUsername={user}", txt)
txt = re.sub(r"(?m)^ControlPassword=.*$", lambda _: f"ControlPassword={pw}", txt)
open(path, "w", encoding="utf-8").write(txt)
PYEOF
fi

chown -R nzbget:nzbget /opt/nzbget /var/lib/nzbget

report_progress 85 "Configuring and starting nzbget.service on port 6789..."
cat <<'EOF' > /etc/systemd/system/nzbget.service
[Unit]
Description=NZBGet Daemon
After=network.target

[Service]
User=nzbget
Group=nzbget
Type=forking
ExecStart=/opt/nzbget/nzbget -c /opt/nzbget/nzbget.conf -D
ExecStop=/opt/nzbget/nzbget -Q
ExecReload=/opt/nzbget/nzbget -O
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now nzbget >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "NZBGet installed on port 6789."
log_info "${PACKAGE_NAME} installed successfully"
