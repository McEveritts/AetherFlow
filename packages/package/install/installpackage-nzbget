#!/bin/bash
# AetherFlow Package Installer: NZBGet (nzbgetcom/nzbget fork)
# Port: 6789

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="nzbget"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-6789}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
validate_config_paths /var/lib/nzbget/nzbget.conf
if [[ -f /var/lib/nzbget/nzbget.conf ]]; then
    set_config_file_mode 0600 /var/lib/nzbget/nzbget.conf
fi
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for NZBGet..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl p7zip-full par2 unzip unrar-free python3 ca-certificates >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq unrar >> "$LOGFILE" 2>&1 || true

if ! id -u nzbget >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/nzbget --shell /usr/sbin/nologin nzbget
fi

mkdir -p /opt/nzbget /var/lib/nzbget

report_progress 35 "Resolving latest NZBGet release..."
NZBGET_VERSION="$(github_latest_tag "nzbgetcom/nzbget" "24.3")"
NZBGET_URL="https://github.com/nzbgetcom/nzbget/releases/download/v${NZBGET_VERSION}/nzbget-${NZBGET_VERSION}-bin-linux.run"

report_progress 60 "Downloading and installing NZBGet ${NZBGET_VERSION}..."
TMP_RUN=$(mktemp /tmp/nzbget-XXXXXX.run)
download_file "$NZBGET_URL" "$TMP_RUN" >> "$LOGFILE" 2>&1
BUILD_DIR="$(mktemp -d /opt/.nzbget-build.XXXXXX)"
trap 'rm -rf -- "$BUILD_DIR"; rm -f -- "$TMP_RUN"' EXIT
sh "$TMP_RUN" --destdir "$BUILD_DIR" >> "$LOGFILE" 2>&1
rm -f "$TMP_RUN"
stage_app_archive "$BUILD_DIR" /opt/nzbget nzbget /var/lib/nzbget "$PACKAGE_NAME" "." "" preserve

queue_app_version /opt/nzbget/.af-version "${NZBGET_VERSION#v}"

NZBGET_EXISTING_CONFIG=false
if [[ -s /var/lib/nzbget/nzbget.conf ]]; then
    NZBGET_EXISTING_CONFIG=true
elif [[ -s /opt/nzbget/nzbget.conf ]]; then
    install -m 0600 -- /opt/nzbget/nzbget.conf /var/lib/nzbget/nzbget.conf
    [[ ! -f "$AF_ARCHIVE_BACKUP/app/nzbget.conf" ]] || NZBGET_EXISTING_CONFIG=true
fi
if [[ "$NZBGET_EXISTING_CONFIG" != true ]]; then
    set_config_value /var/lib/nzbget/nzbget.conf ini MainDir /var/lib/nzbget
    set_config_value /var/lib/nzbget/nzbget.conf ini ControlIP 127.0.0.1
fi
if [[ "$NZBGET_EXISTING_CONFIG" != true || ( -n "${AF_CONFIG_PASS:-}" && "${AF_KEEP_EXISTING_SECRETS:-1}" != 1 ) ]]; then
    set_config_value /var/lib/nzbget/nzbget.conf ini ControlUsername "${AF_CONFIG_USER:-$MASTER_USER}"
    set_config_value /var/lib/nzbget/nzbget.conf ini ControlPassword "${AF_CONFIG_PASS:-$MASTER_PASS}"
fi
set_config_file_mode 0600 /var/lib/nzbget/nzbget.conf
set_config_value /var/lib/nzbget/nzbget.conf ini ControlPort "$APP_PORT"

chown -hRP nzbget:nzbget /opt/nzbget /var/lib/nzbget

report_progress 85 "Configuring and starting nzbget.service on port ${APP_PORT}..."
cat <<'EOF' > /etc/systemd/system/nzbget.service
[Unit]
Description=NZBGet Daemon
After=network.target

[Service]
User=nzbget
Group=nzbget
Type=forking
ExecStart=/opt/nzbget/nzbget -c /var/lib/nzbget/nzbget.conf -D
ExecStop=/opt/nzbget/nzbget -c /var/lib/nzbget/nzbget.conf -Q
ExecReload=/opt/nzbget/nzbget -c /var/lib/nzbget/nzbget.conf -O
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now nzbget >> "$LOGFILE" 2>&1
systemctl restart nzbget >> "$LOGFILE" 2>&1
wait_for_service_ready() {
    local service="${1:-nzbget}" port="${2:-$APP_PORT}" path="${3:-/jsonrpc/version}"
    systemctl is-active --quiet "$service" || return 1
    safe_config_python /var/lib/nzbget/nzbget.conf <<'PYEOF' | curl -K - -fsS -o /dev/null \
        --connect-timeout 2 --max-time 5 --retry 20 --retry-connrefused --retry-delay 1 --retry-max-time 60 \
        "http://127.0.0.1:${port}${path}" >> "$LOGFILE" 2>&1 || return 1
import json
settings = {}
for line in safe_read_text('/var/lib/nzbget/nzbget.conf').splitlines():
    key, separator, value = line.partition('=')
    if separator and key.strip() in ('ControlUsername', 'ControlPassword'):
        settings[key.strip()] = value.strip()
credentials = settings.get('ControlUsername', '') + ':' + settings.get('ControlPassword', '')
print('user = ' + json.dumps(credentials, ensure_ascii=False))
PYEOF
    systemctl is-active --quiet "$service"
}
finish_app_archive_update "$PACKAGE_NAME" "$APP_PORT" "/jsonrpc/version"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "NZBGet installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
