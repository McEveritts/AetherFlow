#!/bin/bash
# AetherFlow Package Installer: Overseerr
# Port: 5056

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="overseerr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing system and Node.js prerequisites for Overseerr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl git gnupg ca-certificates build-essential python3 >> "$LOGFILE" 2>&1

ensure_node 20
if ! command_exists yarn; then
    npm install -g yarn >> "$LOGFILE" 2>&1
    sync_node_global_bins
fi

if ! id -u overseerr >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir /var/lib/overseerr --shell /usr/sbin/nologin overseerr
fi

mkdir -p /var/lib/overseerr

report_progress 30 "Cloning Overseerr repository..."
rm -rf /opt/overseerr
git clone https://github.com/sct/overseerr.git /opt/overseerr >> "$LOGFILE" 2>&1
cd /opt/overseerr
LATEST_TAG="$(git tag -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)"
if [[ -n "$LATEST_TAG" ]]; then
    git checkout "$LATEST_TAG" >> "$LOGFILE" 2>&1 || true
    printf '%s\n' "${LATEST_TAG#v}" > /opt/overseerr/.af-version
fi

report_progress 55 "Installing Overseerr dependencies and building production bundle..."
export CYPRESS_INSTALL_BINARY=0
yarn install --ignore-engines --frozen-lockfile --network-timeout 1000000 >> "$LOGFILE" 2>&1 || yarn install --ignore-engines --network-timeout 1000000 >> "$LOGFILE" 2>&1
yarn build >> "$LOGFILE" 2>&1

chown -R overseerr:overseerr /opt/overseerr /var/lib/overseerr

NODE_BIN="$(command -v node || echo /usr/bin/node)"

report_progress 85 "Configuring and starting overseerr.service on port 5056..."
cat <<EOF > /etc/systemd/system/overseerr.service
[Unit]
Description=Overseerr Service
Wants=network-online.target
After=network-online.target

[Service]
User=overseerr
Group=overseerr
WorkingDirectory=/opt/overseerr
Environment=NODE_ENV=production
Environment=PORT=5056
Environment=CONFIG_DIRECTORY=/var/lib/overseerr
Type=simple
Restart=on-failure
RestartSec=5
ExecStart=${NODE_BIN} dist/index.js

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now overseerr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Overseerr installed on port 5056."
log_info "${PACKAGE_NAME} installed successfully"
