#!/bin/bash
#
# [AetherFlow Install Script - Notifiarr]
# Installs Notifiarr unified client on bare-metal Debian/Ubuntu.
#
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root

PACKAGE_NAME="notifiarr"
APP_NAME="notifiarr"
APP_USER="notifiarr"
CONFIG_DIR="/etc/notifiarr"
DATA_DIR="/var/lib/notifiarr"
LOG_DIR="/var/log/notifiarr"
BIN_PATH="/usr/local/bin/notifiarr"
SERVICE_FILE="/etc/systemd/system/notifiarr.service"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-5454}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

log_info "Starting ${APP_NAME} installation (target port: ${APP_PORT})..."
report_progress 10 "Preparing ${APP_NAME} installation..."

load_master_credentials
ADMIN_USER="${MASTER_USER}"
ADMIN_PASS="${MASTER_PASS}"

report_progress 20 "Installing dependencies..."
DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3 curl wget jq tar ca-certificates >> "$LOGFILE" 2>&1

if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --user-group --create-home --home-dir "${DATA_DIR}" --shell /usr/sbin/nologin "${APP_USER}" 2>/dev/null || \
    useradd --system --user-group --home-dir "${DATA_DIR}" --shell /bin/false "${APP_USER}"
fi
mkdir -p "${CONFIG_DIR}" "${DATA_DIR}" "${LOG_DIR}"

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
    amd64) N_ARCH="x86_64" ;;
    arm64) N_ARCH="arm64" ;;
    armhf) N_ARCH="armhf" ;;
    *)
        log_error "Unsupported architecture for Notifiarr: ${ARCH}"
        exit 1
        ;;
esac

report_progress 45 "Resolving latest Notifiarr release from GitHub..."
RELEASE_JSON="$(curl -fsSL https://api.github.com/repos/Notifiarr/notifiarr/releases/latest 2>/dev/null || true)"
LATEST_TAG="$(echo "${RELEASE_JSON}" | jq -r '.tag_name // empty' || true)"
if [[ -z "${LATEST_TAG}" ]]; then
    LATEST_TAG="v0.7.3"
fi

ASSET_URL="$(echo "${RELEASE_JSON}" | jq -r --arg arch "linux.${N_ARCH}.tar.gz" '.assets[]? | select(.name | contains("linux") and endswith($arch)) | .browser_download_url' | head -n1 || true)"
if [[ -z "${ASSET_URL}" ]]; then
    ASSET_URL="https://github.com/Notifiarr/notifiarr/releases/download/${LATEST_TAG}/notifiarr.linux.${N_ARCH}.tar.gz"
fi

report_progress 65 "Downloading ${APP_NAME} (${LATEST_TAG})..."
TMP_TAR="$(mktemp --suffix=.tar.gz)"
TMP_DIR="$(mktemp -d)"
wget -qO "${TMP_TAR}" "${ASSET_URL}" >> "$LOGFILE" 2>&1 || curl -fsSL -o "${TMP_TAR}" "${ASSET_URL}" >> "$LOGFILE" 2>&1

tar -xzf "${TMP_TAR}" -C "${TMP_DIR}" >> "$LOGFILE" 2>&1
EXTRACTED_BIN="$(find "${TMP_DIR}" -type f -name "notifiarr" -perm -111 | head -n1 || find "${TMP_DIR}" -type f -name "notifiarr" | head -n1)"
if [[ -n "${EXTRACTED_BIN}" && -f "${EXTRACTED_BIN}" ]]; then
    install -m 0755 "${EXTRACTED_BIN}" "${BIN_PATH}"
else
    log_error "Failed to extract notifiarr binary"
    rm -rf "${TMP_TAR}" "${TMP_DIR}"
    exit 1
fi
rm -rf "${TMP_TAR}" "${TMP_DIR}"

echo "${LATEST_TAG#v}" > "${CONFIG_DIR}/.af-version"

report_progress 75 "Configuring ${APP_NAME} integration and credentials..."
API_KEY_EXTRACT='
import sys, re, xml.etree.ElementTree as ET
path = sys.argv[1]
try:
    tree = ET.parse(path)
    key = tree.findtext("ApiKey")
    if key: print(key.strip())
except Exception:
    pass
'
SONARR_KEY="$(python3 -c "${API_KEY_EXTRACT}" /var/lib/sonarr/config.xml 2>/dev/null || true)"
RADARR_KEY="$(python3 -c "${API_KEY_EXTRACT}" /var/lib/radarr/config.xml 2>/dev/null || true)"
LIDARR_KEY="$(python3 -c "${API_KEY_EXTRACT}" /var/lib/lidarr/config.xml 2>/dev/null || true)"
READARR_KEY="$(python3 -c "${API_KEY_EXTRACT}" /var/lib/readarr/config.xml 2>/dev/null || true)"
PROWLARR_KEY="$(python3 -c "${API_KEY_EXTRACT}" /var/lib/prowlarr/config.xml 2>/dev/null || true)"

if [[ ! -f "${CONFIG_DIR}/notifiarr.conf" ]]; then
    cat > "${CONFIG_DIR}/notifiarr.conf" <<EOF
# Notifiarr configuration
api_key = ""
bind_addr = "0.0.0.0:${APP_PORT}"
ui_password = ""
urlbase = "/"
quiet = false
log_file = "${LOG_DIR}/app.log"
http_log = "${LOG_DIR}/http.log"
EOF

    if [[ -n "${SONARR_KEY}" ]]; then
        cat >> "${CONFIG_DIR}/notifiarr.conf" <<EOF

[[sonarr]]
  name = "AetherFlow Sonarr"
  url = "http://127.0.0.1:8989"
  api_key = "${SONARR_KEY}"
EOF
    fi

    if [[ -n "${RADARR_KEY}" ]]; then
        cat >> "${CONFIG_DIR}/notifiarr.conf" <<EOF

[[radarr]]
  name = "AetherFlow Radarr"
  url = "http://127.0.0.1:7878"
  api_key = "${RADARR_KEY}"
EOF
    fi

    if [[ -n "${LIDARR_KEY}" ]]; then
        cat >> "${CONFIG_DIR}/notifiarr.conf" <<EOF

[[lidarr]]
  name = "AetherFlow Lidarr"
  url = "http://127.0.0.1:8686"
  api_key = "${LIDARR_KEY}"
EOF
    fi

    if [[ -n "${READARR_KEY}" ]]; then
        cat >> "${CONFIG_DIR}/notifiarr.conf" <<EOF

[[readarr]]
  name = "AetherFlow Readarr"
  url = "http://127.0.0.1:8787"
  api_key = "${READARR_KEY}"
EOF
    fi

    if [[ -n "${PROWLARR_KEY}" ]]; then
        cat >> "${CONFIG_DIR}/notifiarr.conf" <<EOF

[[prowlarr]]
  name = "AetherFlow Prowlarr"
  url = "http://127.0.0.1:9696"
  api_key = "${PROWLARR_KEY}"
EOF
    fi
else
    sed -i "s|^bind_addr = .*|bind_addr = \"0.0.0.0:${APP_PORT}\"|" "${CONFIG_DIR}/notifiarr.conf" || true
fi

NOTIFIARR_UI_CREDENTIALS="${ADMIN_USER}:${ADMIN_PASS}" python3 - "${CONFIG_DIR}/notifiarr.conf" <<'PYEOF'
import json
import os
from pathlib import Path
import re
import sys

config = Path(sys.argv[1])
text = config.read_text(encoding="utf-8")
value = "ui_password = " + json.dumps(os.environ["NOTIFIARR_UI_CREDENTIALS"], ensure_ascii=False)
text, count = re.subn(r"^ui_password\s*=.*$", lambda match: value, text, flags=re.MULTILINE)
if not count:
    raise SystemExit("Missing ui_password in Notifiarr configuration")
config.write_text(text, encoding="utf-8")
PYEOF

chmod 600 "${CONFIG_DIR}/notifiarr.conf"
chown -R "${APP_USER}:${APP_USER}" "${CONFIG_DIR}" "${DATA_DIR}" "${LOG_DIR}"

report_progress 90 "Configuring ${APP_NAME} systemd service..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Notifiarr Unified Notification Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${DATA_DIR}
ExecStart=${BIN_PATH} -c ${CONFIG_DIR}/notifiarr.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now notifiarr.service >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "${APP_NAME} installed and running on port ${APP_PORT}"
log_info "${PACKAGE_NAME} installed successfully"
