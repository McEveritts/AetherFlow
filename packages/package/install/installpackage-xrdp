#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

require_root
validate_config_paths /etc/xrdp/startwm.sh
export LOGFILE="/var/log/aetherflow/install-xrdp.log"
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi
trap 'print_error "XRDP installation failed; see ${LOGFILE}."' ERR
PACKAGE_NAME="${PACKAGE_NAME:-xrdp}"
begin_state_transaction "xrdp-sesman.service xrdp.service" "0" "/" "/var/lib/xrdp" "/etc/xrdp" "/etc/systemd/system/xrdp-sesman.service" "/etc/systemd/system/xrdp.service" "/usr/sbin/xrdp" "/usr/sbin/xrdp-sesman" "/usr/lib/xrdp" "/usr/share/xrdp"

prepare_apt_package_transaction /var/lib/xrdp/.af-version xrdp xorgxrdp
report_progress 15 "Installing XRDP, Xorg backend, and XFCE desktop..."
export DEBIAN_FRONTEND=noninteractive
af_logged apt-get update -qq
af_logged apt-get install --no-remove -y -qq xrdp xorgxrdp xfce4 xfce4-terminal dbus-x11 ssl-cert

report_progress 60 "Configuring XRDP desktop sessions and TLS certificate access..."
usermod -a -G ssl-cert xrdp
backup_file_once /etc/xrdp/startwm.sh
if [[ ! -s /etc/xrdp/startwm.sh ]] || grep -q '^test -x /etc/X11/Xsession' /etc/xrdp/startwm.sh; then
write_config_file /etc/xrdp/startwm.sh 0755 <<'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-run-session -- startxfce4
EOF
fi

report_progress 85 "Starting XRDP and its session manager..."
systemctl daemon-reload
af_logged systemctl enable xrdp-sesman.service xrdp.service
af_logged systemctl restart xrdp-sesman.service xrdp.service
systemctl is-active --quiet xrdp-sesman.service xrdp.service
mkdir -p /var/lib/xrdp
queue_app_version /var/lib/xrdp/.af-version "$(dpkg-query -W -f='${Version}' xrdp)"
commit_app_versions
write_lock xrdp
report_progress 100 "XRDP installed. Connect using an RDP client on TCP 3389 (or your existing configured port) with an existing Linux account. Restrict access with a firewall or VPN."
