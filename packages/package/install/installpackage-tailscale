#!/bin/bash
# AetherFlow Package Installer: Tailscale Mesh VPN

set -euo pipefail
umask 077

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="tailscale"
DATA_DIR="/var/lib/tailscale"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() {
        local target="${LOGFILE:-/dev/null}"
        if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; return $?; fi
        local _flock_bin="flock"
        if ! command -v flock >/dev/null 2>&1 && [[ -x /usr/bin/flock ]]; then _flock_bin="/usr/bin/flock"; fi
        local _out_r="" _meta=""
        exec {_out_r}< <(python3 - "$target" <<'PYEOF'
import fcntl, os, select, stat, sys
target = sys.argv[1]
parent_dir = os.path.dirname(target) or "."
if not os.path.lexists(parent_dir):
    os.makedirs(parent_dir, mode=0o750, exist_ok=True)
pst = os.lstat(parent_dir)
if stat.S_ISLNK(pst.st_mode) or not stat.S_ISDIR(pst.st_mode):
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
try:
    fd = os.open(target, flags, 0o640)
except OSError:
    sys.stderr.write(f"Refusing unsafe logfile path: {target}\n")
    raise SystemExit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.stderr.write(f"Refusing non-regular or hardlinked logfile target: {target}\n")
            raise SystemExit(1)
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~getattr(os, "O_NONBLOCK", 0))
        sys.stdout.write(f"{os.getpid()}:{fd}\n")
        sys.stdout.flush()
        poller = select.poll()
        poller.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        poller.poll(5000)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
finally:
    os.close(fd)
PYEOF
        ) || return 1
        if ! IFS= read -r _meta <&"$_out_r" || [[ ! "$_meta" =~ ^([0-9]+):([0-9]+)$ ]]; then exec {_out_r}<&-; return 1; fi
        local _hpid="${BASH_REMATCH[1]}" _hfd="${BASH_REMATCH[2]}" lock_fd="" rc=0
        exec {lock_fd}>>"/proc/${_hpid}/fd/${_hfd}" || { exec {_out_r}<&-; return 1; }
        "$_flock_bin" -s "$lock_fd" || { exec {lock_fd}>&-; exec {_out_r}<&-; return 1; }
        exec {_out_r}<&-
        "$@" >&"$lock_fd" 2>&1 || rc=$?
        "$_flock_bin" -u "$lock_fd" 2>/dev/null || true
        exec {lock_fd}>&-
        return "$rc"
    }
fi
touch "$LOGFILE"
chmod 600 "$LOGFILE"

require_root
validate_config_paths /etc/apt/keyrings/tailscale-archive-keyring.gpg /etc/tailscale/key
PACKAGE_NAME="${PACKAGE_NAME:-tailscale}"
begin_state_transaction "tailscaled.service" "0" "/" "/var/lib/tailscale" "/etc/tailscale" "/etc/default/tailscaled" "/etc/sysctl.d/99-tailscale.conf" "/etc/apt/sources.list.d/tailscale.list" "/etc/apt/keyrings/tailscale-archive-keyring.gpg" "/etc/systemd/system/tailscaled.service" "/usr/bin/tailscale" "/usr/sbin/tailscaled" "/usr/share/tailscale"

prepare_apt_package_transaction /var/lib/tailscale/.af-version tailscale
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 15 "Installing prerequisites for Tailscale..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install --no-remove -y -qq curl gnupg ca-certificates apt-transport-https lsb-release iproute2 iptables

report_progress 35 "Configuring official Tailscale APT repository..."
DISTRO_ID="debian"
CODENAME="bookworm"
if [[ -f /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    if [[ "${ID:-}" == "ubuntu" ]]; then
        DISTRO_ID="ubuntu"
    else
        DISTRO_ID="debian"
    fi
    CODENAME="${VERSION_CODENAME:-$(lsb_release -c -s 2>/dev/null || echo bookworm)}"
fi

install -m 0755 -d /etc/apt/keyrings
af_logged download_file "https://pkgs.tailscale.com/stable/${DISTRO_ID}/${CODENAME}.noarmor.gpg" /etc/apt/keyrings/tailscale-archive-keyring.gpg
chmod a+r /etc/apt/keyrings/tailscale-archive-keyring.gpg

cat <<EOF > /etc/apt/sources.list.d/tailscale.list
deb [signed-by=/etc/apt/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/${DISTRO_ID} ${CODENAME} main
EOF

report_progress 60 "Installing Tailscale daemon and CLI..."
DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install --no-remove -y -qq tailscale

report_progress 75 "Enabling IPv4 and IPv6 packet forwarding for subnet routing..."
mkdir -p /etc/sysctl.d "${DATA_DIR}"
cat <<'EOF' > /etc/sysctl.d/99-tailscale.conf
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
af_logged sysctl -p /etc/sysctl.d/99-tailscale.conf

report_progress 90 "Enabling and starting tailscaled.service..."
af_logged systemctl daemon-reload
af_logged systemctl enable tailscaled.service
af_logged systemctl start tailscaled.service
systemctl is-active --quiet tailscaled.service

AUTH_KEY="${AF_TAILSCALE_AUTHKEY:-${TAILSCALE_AUTHKEY:-}}"
unset AF_TAILSCALE_AUTHKEY TAILSCALE_AUTHKEY
if [[ -n "${AUTH_KEY}" ]]; then
    log_info "Enrolling Tailscale node using the supplied one-time key..."
    AUTH_DIR="$(mktemp -d /run/aetherflow-tailscale-auth.XXXXXX)"
    trap 'status=$?; rm -rf -- "$AUTH_DIR"; cleanup_state_transaction "$status"' EXIT
    printf '%s' "$AUTH_KEY" > "${AUTH_DIR}/key"
    chmod 600 "${AUTH_DIR}/key"
    unset AUTH_KEY
    # Never put the secret itself in process arguments or installer logs.
    if ! tailscale login --auth-key="file:${AUTH_DIR}/key" --timeout=30s > "${AUTH_DIR}/output" 2>&1; then
        log_error "Tailscale enrollment failed. Existing daemon state was preserved; authenticate from Network or retry with a valid key."
        exit 1
    fi
    rm -rf -- "$AUTH_DIR"
    trap 'cleanup_state_transaction $?' EXIT
fi

mkdir -p /var/lib/tailscale
TS_VERSION="$(dpkg-query -W -f='${Version}' tailscale 2>/dev/null || true)"
queue_app_version /var/lib/tailscale/.af-version "${TS_VERSION:-1.76.6}"
commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Tailscale Mesh VPN installed. Open Network > Tailscale Mesh to authenticate this node if not already enrolled."
log_info "${PACKAGE_NAME} installed successfully"
