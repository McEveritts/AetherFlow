#!/bin/bash
#
# [AetherFlow :: Install Lidarr]
# Music collection manager for Usenet and BitTorrent
#
# Author : McEveritts
# URL    : https://AetherFlow.io
# License: GPL-3.0
#
set -e

LOGFILE="/opt/AetherFlow/logs/installer.log"
mkdir -p /opt/AetherFlow/logs /install

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [lidarr] $1" | tee -a "$LOGFILE"; }

# ── Dependencies ─────────────────────────────────────────────────────────────
log "Installing dependencies..."
apt-get update >>"$LOGFILE" 2>&1
apt-get install -y curl sqlite3 libicu-dev chromaprint-tools >>"$LOGFILE" 2>&1

# ── Download Lidarr ──────────────────────────────────────────────────────────
log "Downloading latest Lidarr..."
ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) LIDARR_ARCH="x64" ;;
    arm64) LIDARR_ARCH="arm64" ;;
    armhf) LIDARR_ARCH="arm" ;;
    *) LIDARR_ARCH="x64" ;;
esac

mkdir -p /tmp/AetherFlow
cd /tmp/AetherFlow
curl -sL "https://lidarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=${LIDARR_ARCH}" -o lidarr.tar.gz >>"$LOGFILE" 2>&1

log "Extracting Lidarr..."
rm -rf /opt/Lidarr
tar -xzf lidarr.tar.gz -C /opt >>"$LOGFILE" 2>&1
rm -f lidarr.tar.gz

# ── Create lidarr user ───────────────────────────────────────────────────────
if ! id -u lidarr &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -d /opt/Lidarr lidarr
fi
chown -R lidarr:lidarr /opt/Lidarr
mkdir -p /var/lib/lidarr
chown -R lidarr:lidarr /var/lib/lidarr

# ── Systemd service ──────────────────────────────────────────────────────────
log "Creating systemd service..."
cat > /etc/systemd/system/lidarr.service <<'EOF'
[Unit]
Description=Lidarr Music Manager
After=syslog.target network.target

[Service]
User=lidarr
Group=lidarr
Type=simple
ExecStart=/opt/Lidarr/Lidarr -nobrowser -data=/var/lib/lidarr/
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=process
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/lidarr

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable lidarr.service >>"$LOGFILE" 2>&1
systemctl start lidarr.service

# ── Apache reverse proxy ─────────────────────────────────────────────────────
log "Configuring Apache reverse proxy..."
cat > /etc/apache2/sites-enabled/lidarr.conf <<'EOF'
<Location /lidarr>
    ProxyPass http://localhost:8686/lidarr
    ProxyPassReverse http://localhost:8686/lidarr
</Location>
EOF
chown www-data:www-data /etc/apache2/sites-enabled/lidarr.conf
a2enmod proxy proxy_http >>/dev/null 2>&1
service apache2 reload >>"$LOGFILE" 2>&1

# ── Finalize ─────────────────────────────────────────────────────────────────
touch /install/.lidarr.lock
log "Lidarr installation complete! Access at http://your-server:8686"
