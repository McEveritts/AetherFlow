#!/bin/bash
# AetherFlow Package Installer: Lidarr
# Port: 8686

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f /opt/AetherFlow/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
else
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
fi

PACKAGE_NAME="lidarr"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p "$(dirname "$LOGFILE")" /install

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Lidarr..."

DEBIAN_FRONTEND=noninteractive apt-get update -y -qq >> "$LOGFILE" 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl sqlite3 libicu-dev libchromaprint-tools mediainfo ca-certificates >> "$LOGFILE" 2>&1

if ! id -u lidarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/lidarr --shell /usr/sbin/nologin lidarr
fi

mkdir -p /var/lib/lidarr /opt/Lidarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) LIDARR_ARCH="x64" ;;
    arm64) LIDARR_ARCH="arm64" ;;
    armhf) LIDARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Lidarr (${LIDARR_ARCH})..."
LIDARR_VERSION="$(curl -fsSL https://api.github.com/repos/Lidarr/Lidarr/releases/latest 2>/dev/null | grep -oP '"tag_name":\s*"v?\K[^"]+' | head -1 || true)"
TMP_TAR=$(mktemp /tmp/lidarr-XXXXXX.tar.gz)
curl -fsSL "https://lidarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=${LIDARR_ARCH}" -o "$TMP_TAR" >> "$LOGFILE" 2>&1

report_progress 65 "Extracting Lidarr to /opt/Lidarr..."
tar -xzf "$TMP_TAR" -C /opt >> "$LOGFILE" 2>&1
rm -f "$TMP_TAR"
if [[ -n "$LIDARR_VERSION" ]]; then
    printf '%s\n' "${LIDARR_VERSION#v}" > /opt/Lidarr/.af-version
fi
chown -R lidarr:lidarr /opt/Lidarr /var/lib/lidarr

report_progress 85 "Configuring and starting lidarr.service..."
cat <<'EOF' > /etc/systemd/system/lidarr.service
[Unit]
Description=Lidarr Daemon
After=syslog.target network.target

[Service]
User=lidarr
Group=lidarr
Type=simple
ExecStart=/opt/Lidarr/Lidarr -nobrowser -data=/var/lib/lidarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >> "$LOGFILE" 2>&1
systemctl enable --now lidarr >> "$LOGFILE" 2>&1

write_lock "${PACKAGE_NAME}"
report_progress 100 "Lidarr installed on port 8686."
log_info "${PACKAGE_NAME} installed successfully"
