#!/bin/bash
# AetherFlow Package Installer: Lidarr
# Port: 8686

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELF_DIR}/../../common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SELF_DIR}/../../common.sh"
elif [[ -f /opt/AetherFlow/current/packages/common.sh ]]; then
    # shellcheck source=/dev/null
    source /opt/AetherFlow/current/packages/common.sh
else
    # shellcheck source=/dev/null
    source /opt/AetherFlow/packages/common.sh
fi

PACKAGE_NAME="lidarr"
APP_PORT="${AF_APP_PORT:-${AETHERFLOW_APP_PORT:-8686}}"
export AF_APP_PORT="$APP_PORT"
export LOGFILE="/var/log/aetherflow/install-${PACKAGE_NAME}.log"
mkdir -p /install
if declare -F af_prepare_logfile_path >/dev/null 2>&1; then
    af_prepare_logfile_path "$LOGFILE"
elif [[ -L "${LOGFILE%/*}" || -L "$LOGFILE" || ( -e "$LOGFILE" && ! -f "$LOGFILE" ) ]]; then
    echo "ERROR: Unsafe logfile path: $LOGFILE" >&2
    exit 1
else
    mkdir -p -m 0750 "${LOGFILE%/*}"
fi
if ! declare -F af_logged >/dev/null 2>&1; then
    af_logged() { local target="${LOGFILE:-/dev/null}"; if [[ "$target" == "/dev/null" ]]; then "$@" >/dev/null 2>&1; else "$@" >>"$target" 2>&1; fi; }
fi

require_root
log_info "Starting installation for ${PACKAGE_NAME}..."
report_progress 10 "Installing dependencies for Lidarr..."

DEBIAN_FRONTEND=noninteractive af_logged apt-get update -y -qq
DEBIAN_FRONTEND=noninteractive af_logged apt-get install -y -qq curl sqlite3 libicu-dev libchromaprint-tools mediainfo ca-certificates

if ! id -u lidarr >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir /var/lib/lidarr --shell /usr/sbin/nologin lidarr
fi

mkdir -p /var/lib/lidarr /opt/Lidarr

ARCH=$(dpkg --print-architecture)
case "$ARCH" in
    amd64) LIDARR_ARCH="x64" ;;
    arm64) LIDARR_ARCH="arm64" ;;
    armhf) LIDARR_ARCH="arm" ;;
    *) print_error "Unsupported architecture: $ARCH"; exit 1 ;;
esac

report_progress 35 "Downloading Lidarr (${LIDARR_ARCH})..."
LIDARR_VERSION="$(github_latest_tag "Lidarr/Lidarr" "2.8.2.4493")"
LIDARR_URL="https://lidarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=${LIDARR_ARCH}"
if [[ -n "${LIDARR_VERSION:-}" ]]; then
    LIDARR_URL="https://lidarr.servarr.com/v1/update/master/updatefile?version=${LIDARR_VERSION#v}&os=linux&runtime=netcore&arch=${LIDARR_ARCH}"
fi
mkdir -p "${AF_JOB_SCRATCH_ROOT:-/var/tmp}"
TMP_TAR="$(mktemp "${AF_JOB_SCRATCH_ROOT:-/var/tmp}/lidarr-XXXXXX.tar.gz")"
af_logged download_file "$LIDARR_URL" "$TMP_TAR"

report_progress 65 "Extracting Lidarr to /opt/Lidarr..."
stage_app_archive "$TMP_TAR" "/opt/Lidarr" "Lidarr" "/var/lib/lidarr" "${PACKAGE_NAME}"
rm -f "$TMP_TAR"
if [[ -n "$LIDARR_VERSION" ]]; then
    queue_app_version /opt/Lidarr/.af-version "$(resolve_installed_binary_version /opt/Lidarr/Lidarr "${LIDARR_VERSION#v}")"
fi
set_config_value "/var/lib/lidarr/config.xml" xml "Port" "$APP_PORT" "Config"

chown -hRP lidarr:lidarr /opt/Lidarr /var/lib/lidarr

report_progress 85 "Configuring and starting lidarr.service..."
cat <<'EOF' > /etc/systemd/system/lidarr.service
[Unit]
Description=Lidarr Daemon
After=syslog.target network.target

[Service]
User=lidarr
Group=lidarr
Type=simple
ExecStart=/opt/Lidarr/Lidarr -nobrowser -data=/var/lib/lidarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/lidarr.service


af_logged systemctl daemon-reload
af_logged systemctl enable --now lidarr
af_logged systemctl restart lidarr
systemctl is-active --quiet lidarr
READY_URL="$(application_readiness_url "$PACKAGE_NAME" "$APP_PORT")"
finish_app_archive_update "${PACKAGE_NAME}" "$APP_PORT" "$READY_URL"
seed_servarr_master_user "lidarr" ${APP_PORT} "v1"

commit_app_versions
write_lock "${PACKAGE_NAME}"
report_progress 100 "Lidarr installed on port ${APP_PORT}."
log_info "${PACKAGE_NAME} installed successfully"
