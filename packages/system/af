#!/bin/bash
set -euo pipefail
for CLI_BIN in "${AETHERFLOW_CLI_BIN:-}" /usr/local/bin/af-cli /opt/AetherFlow/bin/af-cli; do
  if [[ -n "$CLI_BIN" && -x "$CLI_BIN" && ! "$CLI_BIN" -ef "$0" ]]; then
    exec "$CLI_BIN" "$@"
  fi
done
if [[ "${AETHERFLOW_USE_RUNNER:-0}" == 1 ]]; then
  printf 'The authoritative af-cli is required but is not installed.\n' >&2
  exit 1
fi
for COMMON_SH in /opt/AetherFlow/current/packages/common.sh /opt/AetherFlow/packages/common.sh /usr/local/bin/AetherFlow/common.sh; do
  if [[ -f "${COMMON_SH}" ]]; then
    source "${COMMON_SH}"
    break
  fi
done
if [[ ! -f "${COMMON_SH}" ]]; then
  printf 'Unable to locate AetherFlow common.sh\n' >&2
  exit 1
fi
mkdir -p /opt/AetherFlow/logs
validate_config_paths /opt/AetherFlow/logs/maintenance.lock
exec 200>>/opt/AetherFlow/logs/maintenance.lock
export AF_MAINTENANCE_GUARD_FD=200
flock -n 200 || { printf 'Another AetherFlow maintenance operation is running.\n' >&2; exit 1; }

package_roots=(/opt/AetherFlow/current/packages/package /opt/AetherFlow/packages/package /usr/local/bin/AetherFlow/package)
package_root() {
  local root
  for root in "${package_roots[@]}"; do
    if [[ -d "${root}/$1" ]]; then
      printf '%s\n' "${root}/$1"
      return
    fi
  done
  return 1
}
package_script() {
  local root
  [[ "$2" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || return 1
  for root in "${package_roots[@]}"; do
    if [[ -f "${root}/$1/$1package-$2" ]]; then
      printf '%s\n' "${root}/$1/$1package-$2"
      return
    fi
  done
  return 1
}
