function _intro() {
  whiptail --title "AetherFlow Package Manager" --msgbox "Welcome to the AetherFlow Package Manger! Using this script you can choose to install and remove the packages contained within our AetherFlow package repository. Use the arrow keys to navigate, spacebar to toggle the currently selected item and enter to continue." 15 50
}

function _function() {
  function=$(whiptail --title "AetherFlow Package Manager" --menu "Choose an option:" --ok-button "Continue" --nocancel 12 50 3 \
               Install "packages" \
               Remove "packages" \
               Exit "" 3>&1 1>&2 2>&3)

    if [[ $function == Install ]]; then
      _install
    elif [[ $function == Remove ]]; then
      _remove
    elif [[ $function == Exit ]]; then
      exit 0
    fi
}

function _install() {
  installa=()
  mapfile -t locks < <(find "$(package_root install)" -type f -name 'installpackage-*' -printf "%f\n" | sed 's/^installpackage-//' | sort -d)
  for i in "${locks[@]}"; do
    app=${i}
    if [[ $i == autodl ]]; then app=autodlirssi; fi
    if [[ ! -f /install/.$app.lock ]]; then
      installa+=("$i" '""')
    fi
  done
  local results_file
  results_file="$(mktemp)"
	whiptail --title "Install Software" --checklist --noitem --separate-output "Make some choices:" 15 26 7 "${installa[@]}" 2>"${results_file}"
  readarray -t packages < "${results_file}"
  rm -f "${results_file}"
  for i in "${packages[@]}"; do
    i="${i//\"/}"
    echo -e "Installing $i "
    bash "$(package_script install "$i")"
  done
  _function
}

function _remove() {
removea=()
mapfile -t locks < <(find "$(package_root remove)" -type f -name 'removepackage-*' -printf "%f\n" | sed 's/^removepackage-//' | sort -d)
for i in "${locks[@]}"; do
  app=${i}
  if [[ $i == autodl ]]; then app=autodlirssi; fi
  if [[ -f /install/.$app.lock ]]; then
    removea+=("$i" '""')
  fi
done
local results_file
results_file="$(mktemp)"
whiptail --title "Remove Software" --noitem --checklist --separate-output "Make some choices:" 15 26 7 "${removea[@]}" 2>"${results_file}"
readarray -t packages < "${results_file}"
rm -f "${results_file}"
for i in "${packages[@]}"; do
  i="${i//\"/}"
  echo -e "Removing $i "
  AF_LIFECYCLE_ACTION=remove AF_PACKAGE_ACTION=remove DELETE_DATA=false bash "$(package_script remove "$i")"
done
_function
}

function _cli() {
  local action="$1" package app script
  shift
  for package in "$@"; do
    if ! package_script install "$package" >/dev/null; then
      printf 'Package %s not found\n' "$package" >&2
      return 1
    fi
    app="$package"
    if [[ "$package" == autodl ]]; then app=autodlirssi; fi
    if [[ "$action" == update && ! -f /etc/Swizzin/.${app}.lock && ! -f /install/.${app}.lock ]]; then
      printf 'Package %s not installed; cannot update\n' "$package" >&2
      return 1
    fi
  done
  export AF_LIFECYCLE_ACTION="$action" AF_PACKAGE_ACTION="$action"
  if [[ "$action" == update || "$action" == reinstall ]]; then
    export AF_KEEP_EXISTING_SECRETS=1
  fi
  for package in "$@"; do
    app="$package"
    if [[ "$package" == autodl ]]; then app=autodlirssi; fi
    if [[ -f /install/.${app}.lock && "$action" == install ]]; then
      printf 'Package %s already installed\n' "$package"
    else
      script="$(package_script install "$package")" || return 1
      printf 'Installing %s\n' "$package"
      bash "$script" || return $?
    fi
  done
}

function _clr() {
  local package app script purge=false
  local -a packages=()
  shift
  for package in "$@"; do
    if [[ "$package" == --purge ]]; then purge=true; else packages+=("$package"); fi
  done
  [[ "${#packages[@]}" -gt 0 ]] || { printf 'Choose a package to remove\n' >&2; return 1; }
  set -- "${packages[@]}"
  for package in "$@"; do
    if ! package_script remove "$package" >/dev/null; then
      printf 'Package %s not found\n' "$package" >&2
      return 1
    fi
  done
  export AF_LIFECYCLE_ACTION=remove AF_PACKAGE_ACTION=remove DELETE_DATA="$purge"
  for package in "$@"; do
    app="$package"
    if [[ "$package" == autodl ]]; then app=autodlirssi; fi
    if [[ -f /etc/Swizzin/.$app.lock || -f /install/.$app.lock ]]; then
      script="$(package_script remove "$package")" || return 1
      printf 'Removing %s\n' "$package"
      bash "$script" || return $?
    else
      printf 'Package %s not installed\n' "$package" >&2
      return 1
    fi
  done
}

function _updateaf() {
  echo -e "Updating AetherFlow local repository"
  if [[ ! -f /install/.developer.lock ]]; then
    if [[ -d /opt/AetherFlow ]]; then
      cd /opt/AetherFlow || { echo "Critical: /opt/AetherFlow not found!"; exit 1; }
      git stash --include-untracked -m "af-update-$(date +%s)" 2>/dev/null || true
      git checkout master 2>/dev/null
      if ! git pull --ff-only 2>/dev/null; then
        echo "[WARN] Fast-forward failed, attempting rebase..."
        if ! git pull --rebase 2>/dev/null; then
          echo "[ERROR] Rebase failed (conflicts). Aborting update."
          git rebase --abort 2>/dev/null
          return 1
        fi
      fi
    else
      git clone --recursive https://github.com/McEveritts/AetherFlow /opt/AetherFlow
    fi
  else
    if [[ -d /opt/AetherFlow ]]; then
      cd /opt/AetherFlow || { echo "Critical: /opt/AetherFlow not found!"; exit 1; }
      git stash --include-untracked -m "af-update-dev-$(date +%s)" 2>/dev/null || true
      if git rev-parse --verify origin/development >/dev/null 2>&1; then
        git checkout development 2>/dev/null
        if ! git pull --ff-only 2>/dev/null; then
          echo "[WARN] Fast-forward failed, attempting rebase..."
          if ! git pull --rebase 2>/dev/null; then
            echo "[ERROR] Rebase failed (conflicts). Aborting update."
            git rebase --abort 2>/dev/null
            return 1
          fi
        fi
      else
        echo "[WARN] development branch not found on remote, falling back to master"
        git checkout master 2>/dev/null
        if ! git pull --ff-only 2>/dev/null; then
          git pull --rebase 2>/dev/null || { git rebase --abort 2>/dev/null; return 1; }
        fi
      fi
    else
      git clone --recursive --branch "development" https://github.com/McEveritts/AetherFlow /opt/AetherFlow 2>/dev/null || \
        git clone --recursive https://github.com/McEveritts/AetherFlow /opt/AetherFlow
    fi
  fi
}

function _help() {
  sgformat="${bold}%-15s${normal}"
  spacing=$(echo $'\t' | pr -Te15)

  echo -e "Usage: $(basename "$0") [ install | reinstall | update | remove ] ${bold}pkg1 pkg2 [...]${normal}\n"
  echo -e "       $(basename "$0") [ list | self-update | update | upgrade ]\n"
  echo -e "       $(basename "$0")\n"
  echo -e "Note: Bare update and self-update update the repository; update with package names updates those packages.\n" | fmt --goal=66 --tagged-paragraph
  echo -e "\n"
  printf "${sgformat}" "install"
  echo -e "The install function requires at least one package name as an argument but will accept multiples\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  echo -e "               Example: af install quassel syncthing znc\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "remove"
  echo -e "The remove function requires at least one package name as an argument but will accept multiples\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  echo -e "               Example: af remove quassel syncthing znc\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "update"
  echo -e "Update named packages, or update the local repository when no packages are given\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "reinstall"
  echo -e "Reinstall named packages while retaining existing secrets\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "self-update"
  echo -e "Update the local AetherFlow repository without package arguments\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "upgrade"
  echo -e "The upgrade command will update your local AetherFlow installation to the latest version\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  printf "${sgformat}" "list"
  echo -e "The list command will list packages available to be managed by af\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
}

function _list() {
  mapfile -t repo < <(find "$(package_root install)" -type f -name 'installpackage-*' -printf "%f\n" | sed 's/^installpackage-//' | sort -d)
  for i in "${repo[@]}"; do
    app=$i
    sgformat="${bold}%-15s${normal}"
    spacing=$(echo $'\t' | pr -Te15)
    # Check installation status
    if [[ -f /install/.${app}.lock ]]; then
      status="[installed]"
    else
      status="[available]"
    fi
    printf "${sgformat}" "$i"
    echo -e "${status}\n" | fmt --goal=50 | sed -e "2,\$s/^/$spacing/"
  done
}

normal=""
yellow=""
bold=""
if [[ -t 1 && -n "${TERM:-}" && "$TERM" != dumb ]]; then
  normal=$(tput sgr0 2>/dev/null || true)
  yellow=$(tput setaf 3 2>/dev/null || true)
  bold=$(tput bold 2>/dev/null || true)
fi
if [[ -z "${1:-}" ]]; then
  _intro
  _function
  exit 0
fi
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  _help "$0"
  exit 0
fi
if [[ ! "$1" =~ ^(install|remove|uninstall|update|reinstall|self-update|list|upgrade)$ ]]; then
  echo "Error: $1 invalid command"
  exit 1
fi
if [[ "$1" =~ ^(self-update|list|upgrade)$ && "$#" -gt 1 ]]; then
  printf 'Error: %s does not accept package arguments\n' "$1" >&2
  exit 1
fi
if [[ "$1" == self-update || ( "$1" == update && "$#" -eq 1 ) ]]; then
  _updateaf
  exit 0
fi
if [[ $1 == upgrade ]]; then
    # Update AetherFlow local repository before upgrade
  _updateaf
  echo "Upgrading AetherFlow ... This may take a moment"
  if [[ ! -f /install/.developer.lock ]]; then
    if [[ -d /opt/AetherFlow ]]; then
      bash /opt/AetherFlow/packages/system/updateAetherFlow
    else
      git clone --recursive https://github.com/McEveritts/AetherFlow /opt/AetherFlow
      bash /opt/AetherFlow/packages/system/updateAetherFlow
    fi
  else
    if [[ -d /opt/AetherFlow ]]; then
      bash /opt/AetherFlow/packages/system/updateAetherFlow
    else
      git clone --recursive --branch "development" https://github.com/McEveritts/AetherFlow /opt/AetherFlow 2>/dev/null || \
        git clone --recursive https://github.com/McEveritts/AetherFlow /opt/AetherFlow
      bash /opt/AetherFlow/packages/system/updateAetherFlow
    fi
  fi
  #printf "" > "$LOGFILE"
  exit 0
fi
if [[ $1 == list ]]; then
  _list
  exit 0
fi
if [[ -n "${1:-}" ]] && [[ -z "${2:-}" ]]; then
  echo "Error: You must choose some packages"
  exit 1
fi
if [[ "$1" =~ ^(install|reinstall|update)$ ]]; then
  _cli "$@"
  exit 0
fi
if [[ $1 == remove || $1 == uninstall ]]; then
  _clr "$@"
  exit 0
fi
