#!/bin/bash
# Automatically expands Apache2's Let's Encrypt certificate when new *.BASE_DOMAIN
# app subdomains resolve in DNS and are registered in AetherFlow.
set -euo pipefail

# Reconcile /etc/hosts internal .aether.local loopback entries FIRST (even before certbot/public TLS).
# Never write public domains into /etc/hosts, or getent ahosts will self-poison to 127.0.0.1.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGES_JSON=""
for pkg_cand in \
    "${AF_PACKAGES_JSON:-}" \
    /opt/AetherFlow/current/config/packages.json \
    /opt/AetherFlow/config/packages.json \
    "${SCRIPT_DIR}/../../config/packages.json"; do
    if [[ -n "$pkg_cand" && -f "$pkg_cand" ]]; then
        PACKAGES_JSON="$pkg_cand"
        break
    fi
done

declare -A ALLOWED_WEB_APPS=()
PACKAGES_JSON_LOADED=0
if [[ -n "$PACKAGES_JSON" ]] && command -v python3 >/dev/null 2>&1; then
    while IFS= read -r valid_app; do
        [[ -n "$valid_app" ]] && ALLOWED_WEB_APPS["$valid_app"]=1
    done < <(python3 - "$PACKAGES_JSON" <<'PYEOF' 2>/dev/null || true
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as fh:
    entries = json.load(fh)
for entry in entries:
    if not isinstance(entry, dict):
        continue
    name = str(entry.get("name") or "").strip()
    port = entry.get("default_port")
    if name and isinstance(port, (int, float)) and not isinstance(port, bool) and port > 0:
        print(name)
PYEOF
)
    [[ "${#ALLOWED_WEB_APPS[@]}" -gt 0 ]] && PACKAGES_JSON_LOADED=1
fi

is_allowed_web_app() {
    local app="$1"
    [[ "$app" =~ ^[a-zA-Z0-9-]+$ ]] || return 1
    case "$app" in
        core|10g|developer|cron|aetherflow) return 1 ;;
    esac
    if [[ "$PACKAGES_JSON_LOADED" -eq 1 ]]; then
        [[ -n "${ALLOWED_WEB_APPS[$app]:-}" ]]
        return $?
    fi
    return 0
}

HOSTS_DOMAINS=("aetherflow.aether.local")
for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    if is_allowed_web_app "$app"; then
        HOSTS_DOMAINS+=("${app}.aether.local")
    fi
done

if [[ -w /etc/hosts && ! -L /etc/hosts ]]; then
    (
        HOSTS_LOCK="/run/aetherflow/hosts.lock"
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            mkdir -p -m 0750 /run/aetherflow
        fi
        [[ ! -L /run/aetherflow && ! -L "$HOSTS_LOCK" ]] &&
            [[ ! -e "$HOSTS_LOCK" || -f "$HOSTS_LOCK" ]] &&
            [[ "$(stat -c '%u' /run/aetherflow)" == 0 ]] &&
            (( (8#$(stat -c '%a' /run/aetherflow) & 0022) == 0 )) || {
            echo "[af-certbot-sync] Refusing unsafe hosts lock path" >&2
            exit 1
        }
        exec 8>>"$HOSTS_LOCK"
        HOSTS_LOCK_FD="/proc/${BASHPID}/fd/8"
        [[ ! -L "$HOSTS_LOCK" && "$HOSTS_LOCK" -ef "$HOSTS_LOCK_FD" ]] &&
            [[ "$(stat -Lc '%h' "$HOSTS_LOCK_FD")" == 1 ]] || {
            echo "[af-certbot-sync] Refusing replaced or hard-linked hosts lock" >&2
            exit 1
        }
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            chown root:aetherflow "$HOSTS_LOCK_FD"
            chmod 0660 "$HOSTS_LOCK_FD"
        fi
        [[ "$(stat -Lc '%a %U:%G' "$HOSTS_LOCK_FD")" == "660 root:aetherflow" ]] || {
            echo "[af-certbot-sync] Hosts lock must be 0660 root:aetherflow" >&2
            exit 1
        }
        flock -x -w 30 8 || {
            echo "[af-certbot-sync] Timed out acquiring ${HOSTS_LOCK}" >&2
            exit 1
        }
        # Preserve any non-.aether.local custom domains previously written inside AetherFlow's managed block
        while IFS= read -r existing_entry; do
            [[ -n "$existing_entry" ]] && HOSTS_DOMAINS+=("$existing_entry")
        done < <(awk '
            /^# (--- AETHERFLOW INTERNAL DNS ---|BEGIN AETHERFLOW MANAGED BLOCK)$/ { in_block=1; next }
            /^# (--- END AETHERFLOW INTERNAL DNS ---|END AETHERFLOW MANAGED BLOCK)$/ { in_block=0; next }
            in_block && $1 == "127.0.0.1" && NF >= 2 {
                for (i = 2; i <= NF; i++) {
                    if ($i !~ /\.aether\.local$/) print $i
                }
            }
        ' /etc/hosts)
        mapfile -t UNIQUE_HOSTS < <(printf '%s\n' "${HOSTS_DOMAINS[@]}" | awk 'NF && !seen[$0]++' | sort)
        TMP_HOSTS="$(mktemp /etc/.hosts.aetherflow.XXXXXX 2>/dev/null || mktemp)"
        awk '
            /^# (--- AETHERFLOW INTERNAL DNS ---|BEGIN AETHERFLOW MANAGED BLOCK)$/ { skip=1; next }
            /^# (--- END AETHERFLOW INTERNAL DNS ---|END AETHERFLOW MANAGED BLOCK)$/ { skip=0; next }
            !skip { print }
        ' /etc/hosts > "$TMP_HOSTS"
        {
            echo "# --- AETHERFLOW INTERNAL DNS ---"
            for h in "${UNIQUE_HOSTS[@]}"; do
                printf "127.0.0.1\t%s\n" "$h"
            done
            echo "# --- END AETHERFLOW INTERNAL DNS ---"
        } >> "$TMP_HOSTS"
        chmod 0644 "$TMP_HOSTS"
        if ! mv -f "$TMP_HOSTS" /etc/hosts 2>/dev/null; then
            cat "$TMP_HOSTS" > /etc/hosts
            rm -f "$TMP_HOSTS"
        fi
    )
fi

if ! command -v certbot >/dev/null 2>&1; then
    echo "[af-certbot-sync] certbot binary not found; skipping TLS certificate expansion." >&2
    exit 0
fi

ENV_DB=""
ENV_DATA_DIR=""
if [[ -f /etc/aetherflow/aetherflow.env ]]; then
    ENV_DB="$(grep -E '^(AF_DB_PATH|DB_PATH|AETHERFLOW_DB_PATH)=' /etc/aetherflow/aetherflow.env 2>/dev/null | tail -n1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//" | tr -d '\r\n' || true)"
    ENV_DATA_DIR="$(grep -E '^DATA_DIR=' /etc/aetherflow/aetherflow.env 2>/dev/null | tail -n1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//" | tr -d '\r\n' || true)"
fi
DB=""
for cand in \
    "${AF_DB_PATH:-}" \
    "${DB_PATH:-}" \
    "${AETHERFLOW_DB_PATH:-}" \
    "$ENV_DB" \
    "${DATA_DIR:+${DATA_DIR%/}/aetherflow.sqlite}" \
    "${ENV_DATA_DIR:+${ENV_DATA_DIR%/}/aetherflow.sqlite}" \
    /var/lib/aetherflow/aetherflow.sqlite \
    /opt/AetherFlow/current/data/aetherflow.sqlite \
    /opt/AetherFlow/data/aetherflow.sqlite \
    /opt/AetherFlow/backend/data/aetherflow.sqlite; do
    if [[ -n "$cand" && -f "$cand" ]]; then
        DB="$cand"
        break
    fi
done

BASE_DOMAIN=""
if [[ -n "$DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
    BASE_DOMAIN="$(sqlite3 -cmd ".timeout 5000" "$DB" "SELECT base_domain FROM settings WHERE id = 1;" 2>/dev/null | sed 's/^\*\.//' | tr -d '[:space:]' || true)"
fi
if [[ -z "$BASE_DOMAIN" && -f /etc/aetherflow/aetherflow.env ]]; then
    BASE_DOMAIN="$(grep -E '^AETHERFLOW_BASE_DOMAIN=' /etc/aetherflow/aetherflow.env 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '[:space:]' || true)"
    case "$BASE_DOMAIN" in
        \"*\") BASE_DOMAIN="${BASE_DOMAIN:1:${#BASE_DOMAIN}-2}" ;;
        \'*\') BASE_DOMAIN="${BASE_DOMAIN:1:${#BASE_DOMAIN}-2}" ;;
    esac
    BASE_DOMAIN="${BASE_DOMAIN#\*.}"
fi
DOMAIN_REGEX='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
if [[ -z "$BASE_DOMAIN" || "$BASE_DOMAIN" == "localhost" || "$BASE_DOMAIN" == *.local ]] || [[ ! "$BASE_DOMAIN" =~ $DOMAIN_REGEX ]]; then
    exit 0
fi

public_dns_resolves() {
    local host="$1" resolver rr
    for resolver in 1.1.1.1 8.8.8.8; do
        for rr in A AAAA; do
            if command -v dig >/dev/null 2>&1; then
                dig +short +time=2 +tries=1 -t "$rr" "$host" "@$resolver" 2>/dev/null |
                    grep -Eq '^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[0-9a-fA-F]*:[0-9a-fA-F:.]+)$' && return 0
            elif command -v host >/dev/null 2>&1; then
                host -W 2 -t "$rr" "$host" "$resolver" 2>/dev/null |
                    grep -Eq ' has (IPv6 )?address ' && return 0
            elif command -v nslookup >/dev/null 2>&1; then
                nslookup -timeout=2 "-type=$rr" "$host" "$resolver" 2>/dev/null |
                    awk '/^Name:/ { answer=1 } answer && /^Address/ { found=1 } END { exit !found }' && return 0
            else
                { getent ahostsv4 "$host" || true; getent ahostsv6 "$host" || true; } 2>/dev/null |
                    awk '$1 !~ /^(127\.|::1$|::ffff:127\.)/ { found=1 } END { exit !found }'
                return $?
            fi
        done
    done
    return 1
}

CERT_FILE="/etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem"
if [[ ! -f "$CERT_FILE" ]]; then
    echo "[af-certbot-sync] Initial TLS certificate not yet issued for ${BASE_DOMAIN} (${CERT_FILE} missing); skipping SAN expansion." >&2
    exit 0
fi

CURRENT_SAN_DNS="$(openssl x509 -in "$CERT_FILE" -noout -ext subjectAltName 2>/dev/null |
    tr ',' '\n' | sed -nE 's/^[[:space:]]*DNS:([^[:space:]]+)[[:space:]]*$/\1/p' || true)"
cert_has_san() {
    grep -Fxiq -- "$1" <<< "$CURRENT_SAN_DNS"
}

trigger_runner_tls_resync() {
    if [[ "${AF_CERTBOT_SYNC_FROM_RUNNER:-0}" == "1" ]]; then
        return 0
    fi
    local runner_sock="${AETHERFLOW_RUNNER_SOCK:-/run/aetherflow/runner.sock}"
    local runner_sock_dir
    runner_sock_dir="$(dirname -- "$runner_sock")"
    local apache_dir="${AETHERFLOW_APACHE_DIR:-/etc/apache2}"
    local apache_enabled_dir="${apache_dir}/sites-enabled"
    local apache_avail_dir="${apache_dir}/sites-available"
    if [[ ! -e "$runner_sock" && ! -L "$runner_sock" ]]; then
        return 0
    fi
    local caller_uid="${EUID:-$(id -u)}"
    local dir_uid sock_uid
    dir_uid="$(stat -c '%u' "$runner_sock_dir" 2>/dev/null || echo -1)"
    sock_uid="$(stat -c '%u' "$runner_sock" 2>/dev/null || echo -1)"
    local owner_ok=1
    if [[ "$caller_uid" -eq 0 ]]; then
        [[ "$dir_uid" == "0" && "$sock_uid" == "0" ]] || owner_ok=0
    else
        [[ ("$dir_uid" == "0" || "$dir_uid" == "$caller_uid") && ("$sock_uid" == "0" || "$sock_uid" == "$caller_uid") ]] || owner_ok=0
    fi
    if [[ -L "$runner_sock_dir" || ! -d "$runner_sock_dir" || -L "$runner_sock" || ! -S "$runner_sock" || "$owner_ok" -ne 1 ]] ||
        (( (8#$(stat -c '%a' "$runner_sock_dir" 2>/dev/null || echo 777) & 0022) != 0 )) ||
        (( (8#$(stat -c '%a' "$runner_sock" 2>/dev/null || echo 777) & 0002) != 0 )); then
        echo "[af-certbot-sync] Refusing unsafe runner socket path: ${runner_sock}" >&2
        return 0
    fi
    local needs_resync=0
    if [[ "${NEED_EXPAND:-0}" -eq 1 ]]; then
        needs_resync=1
    elif [[ ! -L "$apache_dir" && -d "$apache_dir" && ! -L "$apache_enabled_dir" && -d "$apache_enabled_dir" ]]; then
        local conf conf_name conf_target
        for conf in "${apache_enabled_dir}"/aetherflow-ext-*.conf; do
            [[ -e "$conf" || -L "$conf" ]] || continue
            if [[ -L "$conf" ]]; then
                conf_name="$(basename -- "$conf")"
                conf_target=""
                if command -v readlink >/dev/null 2>&1; then
                    conf_target="$(readlink -- "$conf" 2>/dev/null || true)"
                elif [[ -x /usr/bin/readlink ]]; then
                    conf_target="$(/usr/bin/readlink -- "$conf" 2>/dev/null || true)"
                elif [[ -x /bin/readlink ]]; then
                    conf_target="$(/bin/readlink -- "$conf" 2>/dev/null || true)"
                fi
                if [[ "$conf_target" != "../sites-available/${conf_name}" && "$conf_target" != "${apache_avail_dir}/${conf_name}" ]]; then
                    continue
                fi
                [[ ! -L "${apache_avail_dir}/${conf_name}" && -f "${apache_avail_dir}/${conf_name}" ]] || continue
                if grep -Fq "TLS certificate provisioning pending" -- "${apache_avail_dir}/${conf_name}" 2>/dev/null; then
                    needs_resync=1
                    break
                fi
            elif [[ -f "$conf" ]]; then
                if grep -Fq "TLS certificate provisioning pending" -- "$conf" 2>/dev/null; then
                    needs_resync=1
                    break
                fi
            fi
        done
    fi
    if [[ "$needs_resync" -ne 1 ]]; then
        return 0
    fi
    local resync_ok=0
    if command -v curl >/dev/null 2>&1; then
        if curl --silent --show-error --fail --max-time 60 --noproxy '*' \
            --unix-socket "$runner_sock" \
            -X POST \
            -H 'Content-Type: application/json' \
            -d '{}' \
            http://localhost/v1/ingress/resync-tls >/dev/null; then
            resync_ok=1
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if python3 - "$runner_sock" <<'PYEOF'
import os, socket, struct, sys
sock_path = sys.argv[1]
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    s.settimeout(60.0)
    s.connect(sock_path)
    if hasattr(socket, "SO_PEERCRED"):
        _pid, peer_uid, _gid = struct.unpack("iii", s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        euid = os.geteuid()
        allowed_uids = (0,) if euid == 0 else (0, euid)
        if peer_uid not in allowed_uids:
            sys.exit(1)
    s.sendall(
        b"POST /v1/ingress/resync-tls HTTP/1.1\r\n"
        b"Host: localhost\r\n"
        b"Content-Type: application/json\r\n"
        b"Content-Length: 2\r\n"
        b"Connection: close\r\n\r\n{}"
    )
    data = b""
    while len(data) < 4096:
        chunk = s.recv(1024)
        if not chunk:
            break
        data += chunk
status_line = data.split(b"\r\n", 1)[0].decode("ascii", "replace")
parts = status_line.split(" ", 2)
if len(parts) < 2 or not parts[1].isdigit() or not (200 <= int(parts[1]) < 300):
    sys.exit(1)
PYEOF
        then
            resync_ok=1
        fi
    fi
    if [[ "$resync_ok" -ne 1 ]]; then
        echo "[af-certbot-sync] Warning: failed to resync pending TLS Apache vhosts via runner" >&2
    fi
    return 0
}

if cert_has_san "*.${BASE_DOMAIN}"; then
    # Wildcard certificate already covers all subdomains
    trigger_runner_tls_resync
    exit 0
fi

DOMAINS=("$BASE_DOMAIN")
for sub in "www.${BASE_DOMAIN}" "direct.${BASE_DOMAIN}"; do
    if public_dns_resolves "$sub"; then
        DOMAINS+=("$sub")
    fi
done

if [[ -n "$DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
    while IFS= read -r dom; do
        dom="$(echo "$dom" | tr -d '[:space:]')"
        [[ -z "$dom" ]] && continue
        if [[ "$dom" =~ $DOMAIN_REGEX ]] && public_dns_resolves "$dom"; then
            DOMAINS+=("$dom")
        fi
    done < <(sqlite3 -cmd ".timeout 5000" "$DB" "SELECT DISTINCT public_domain FROM app_ingress_configs WHERE external_access_enabled = 1 AND public_domain != '';" 2>/dev/null || true)
fi

for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    is_allowed_web_app "$app" || continue
    [[ "$app" =~ ^[a-z0-9_-]+$ ]] || continue
    cand="${app}.${BASE_DOMAIN}"
    ext_enabled=""
    if [[ -n "$DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
        ext_enabled="$(sqlite3 -readonly -cmd ".timeout 5000" -cmd ".parameter init" \
            -cmd ".parameter set @app \"'$app'\"" -cmd ".parameter set @domain \"'$cand'\"" "$DB" \
            "SELECT 1 FROM app_ingress_configs WHERE LOWER(app_name) = LOWER(@app) AND external_access_enabled = 1 AND (public_domain = '' OR LOWER(public_domain) = LOWER(@domain)) LIMIT 1;" 2>/dev/null || true)"
    fi
    [[ -n "$ext_enabled" ]] || continue
    if public_dns_resolves "$cand"; then
        DOMAINS+=("$cand")
    fi
done

mapfile -t UNIQUE_DOMAINS < <(printf '%s\n' "${DOMAINS[@]}" | awk '!seen[$0]++')

NEED_EXPAND=0
CERT_ARGS=()
for d in "${UNIQUE_DOMAINS[@]}"; do
    CERT_ARGS+=("-d" "$d")
    if ! cert_has_san "$d"; then
        NEED_EXPAND=1
    fi
done

if [[ "$NEED_EXPAND" -eq 1 ]]; then
    WEBROOT="/var/www/aetherflow-default"
    echo "[af-certbot-sync] Expanding TLS certificate SANs for ${BASE_DOMAIN}: ${UNIQUE_DOMAINS[*]} (webroot=${WEBROOT})" >&2
    (umask 022; mkdir -p "${WEBROOT}/.well-known/acme-challenge")
    certbot certonly --webroot -w "${WEBROOT}" --cert-name "$BASE_DOMAIN" --expand --non-interactive --agree-tos "${CERT_ARGS[@]}"
    systemctl reload apache2
fi

trigger_runner_tls_resync
