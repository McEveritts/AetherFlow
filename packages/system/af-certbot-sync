#!/bin/bash
# Automatically expands Apache2's Let's Encrypt certificate when new *.BASE_DOMAIN
# app subdomains resolve in DNS and are registered in AetherFlow.
set -euo pipefail

DB="/opt/AetherFlow/backend/data/aetherflow.sqlite"
if [[ ! -f "$DB" ]] || ! command -v certbot >/dev/null 2>&1; then
    exit 0
fi

BASE_DOMAIN=""
if command -v sqlite3 >/dev/null 2>&1; then
    BASE_DOMAIN="$(sqlite3 "$DB" "SELECT base_domain FROM settings WHERE id = 1;" 2>/dev/null | sed 's/^\*\.//' | tr -d '[:space:]' || true)"
fi
if [[ -z "$BASE_DOMAIN" && -f /etc/aetherflow/aetherflow.env ]]; then
    BASE_DOMAIN="$(grep -oP '^AETHERFLOW_BASE_DOMAIN=\K.*' /etc/aetherflow/aetherflow.env 2>/dev/null | sed 's/^\*\.//' | tr -d '[:space:]' || true)"
fi
DOMAIN_REGEX='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
if [[ -z "$BASE_DOMAIN" || "$BASE_DOMAIN" == "localhost" || "$BASE_DOMAIN" == *.local ]] || [[ ! "$BASE_DOMAIN" =~ $DOMAIN_REGEX ]]; then
    exit 0
fi

public_dns_resolves() {
    local host="$1"
    if command -v dig >/dev/null 2>&1; then
        [[ -n "$(dig +short +time=2 +tries=1 A "$host" @1.1.1.1 2>/dev/null | grep -E '^[0-9]+\.' || true)" ]] && return 0
        [[ -n "$(dig +short +time=2 +tries=1 A "$host" @8.8.8.8 2>/dev/null | grep -E '^[0-9]+\.' || true)" ]] && return 0
        return 1
    elif command -v host >/dev/null 2>&1; then
        host -W 2 -t A "$host" 1.1.1.1 >/dev/null 2>&1 && return 0
        host -W 2 -t A "$host" 8.8.8.8 >/dev/null 2>&1 && return 0
        return 1
    elif command -v nslookup >/dev/null 2>&1; then
        nslookup -timeout=2 "$host" 1.1.1.1 >/dev/null 2>&1 && return 0
        nslookup -timeout=2 "$host" 8.8.8.8 >/dev/null 2>&1 && return 0
        return 1
    fi
    getent ahosts "$host" 2>/dev/null | awk '{print $1}' | grep -qvE '^(127\.|::1$)'
}

# Reconcile /etc/hosts internal .aether.local loopback entries ONLY.
# Never write public domains into /etc/hosts, or getent ahosts will self-poison to 127.0.0.1.
HOSTS_DOMAINS=("aetherflow.aether.local")
for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    [[ "$app" == "core" ]] && continue
    if [[ "$app" =~ ^[a-zA-Z0-9-]+$ ]]; then
        HOSTS_DOMAINS+=("${app}.aether.local")
    fi
done

if [[ -w /etc/hosts ]]; then
    mapfile -t UNIQUE_HOSTS < <(printf '%s\n' "${HOSTS_DOMAINS[@]}" | awk 'NF && !seen[$0]++' | sort)
    TMP_HOSTS="$(mktemp)"
    awk '
        /^# --- AETHERFLOW INTERNAL DNS ---$/ { skip=1; next }
        /^# --- END AETHERFLOW INTERNAL DNS ---$/ { skip=0; next }
        !skip { print }
    ' /etc/hosts > "$TMP_HOSTS"
    {
        echo "# --- AETHERFLOW INTERNAL DNS ---"
        for h in "${UNIQUE_HOSTS[@]}"; do
            printf "127.0.0.1\t%s\n" "$h"
        done
        echo "# --- END AETHERFLOW INTERNAL DNS ---"
    } >> "$TMP_HOSTS"
    cat "$TMP_HOSTS" > /etc/hosts
    rm -f "$TMP_HOSTS"
fi

CERT_FILE="/etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem"
if [[ ! -f "$CERT_FILE" ]]; then
    exit 0
fi

CURRENT_SANS="$(openssl x509 -in "$CERT_FILE" -noout -ext subjectAltName 2>/dev/null || true)"
ESCAPED_BASE="${BASE_DOMAIN//./\.}"
if echo "$CURRENT_SANS" | grep -qE "DNS:\*\.${ESCAPED_BASE}(,|$| )"; then
    # Wildcard certificate already covers all subdomains
    exit 0
fi

DOMAINS=("$BASE_DOMAIN")
for sub in "www.${BASE_DOMAIN}" "direct.${BASE_DOMAIN}"; do
    if public_dns_resolves "$sub"; then
        DOMAINS+=("$sub")
    fi
done

while IFS= read -r dom; do
    dom="$(echo "$dom" | tr -d '[:space:]')"
    [[ -z "$dom" ]] && continue
    if [[ "$dom" =~ $DOMAIN_REGEX ]] && public_dns_resolves "$dom"; then
        DOMAINS+=("$dom")
    fi
done < <(sqlite3 "$DB" "SELECT DISTINCT public_domain FROM app_ingress_configs WHERE external_access_enabled = 1 AND public_domain != '';" 2>/dev/null || true)

for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    [[ "$app" == "core" ]] && continue
    [[ "$app" =~ ^[a-zA-Z0-9-]+$ ]] || continue
    ext_disabled="$(sqlite3 "$DB" "SELECT 1 FROM app_ingress_configs WHERE LOWER(app_name) = LOWER('${app}') AND (external_access_enabled = 0 OR (public_domain != '' AND LOWER(public_domain) != LOWER('${app}.${BASE_DOMAIN}'))) LIMIT 1;" 2>/dev/null || true)"
    [[ -n "$ext_disabled" ]] && continue
    cand="${app}.${BASE_DOMAIN}"
    if public_dns_resolves "$cand"; then
        DOMAINS+=("$cand")
    fi
done

mapfile -t UNIQUE_DOMAINS < <(printf '%s\n' "${DOMAINS[@]}" | awk '!seen[$0]++')

NEED_EXPAND=0
CERT_ARGS=()
for d in "${UNIQUE_DOMAINS[@]}"; do
    CERT_ARGS+=("-d" "$d")
    escaped_d="${d//./\.}"
    if ! echo "$CURRENT_SANS" | grep -qE "DNS:${escaped_d}(,|$| )"; then
        NEED_EXPAND=1
    fi
done

if [[ "$NEED_EXPAND" -eq 1 ]]; then
    mkdir -p /srv/aetherflow/.well-known/acme-challenge
    if certbot certonly --webroot -w /srv/aetherflow --cert-name "$BASE_DOMAIN" --expand --non-interactive --agree-tos "${CERT_ARGS[@]}"; then
        systemctl reload apache2
    fi
fi
