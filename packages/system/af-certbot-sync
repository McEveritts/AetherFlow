#!/bin/bash
# Automatically expands Apache2's Let's Encrypt certificate when new *.BASE_DOMAIN
# app subdomains resolve in DNS and are registered in AetherFlow.
set -euo pipefail

# Reconcile /etc/hosts internal .aether.local loopback entries FIRST (even before certbot/public TLS).
# Never write public domains into /etc/hosts, or getent ahosts will self-poison to 127.0.0.1.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGES_JSON=""
for pkg_cand in \
    "${AF_PACKAGES_JSON:-}" \
    /opt/AetherFlow/current/config/packages.json \
    /opt/AetherFlow/config/packages.json \
    "${SCRIPT_DIR}/../../config/packages.json"; do
    if [[ -n "$pkg_cand" && -f "$pkg_cand" ]]; then
        PACKAGES_JSON="$pkg_cand"
        break
    fi
done

declare -A ALLOWED_WEB_APPS=()
PACKAGES_JSON_LOADED=0
if [[ -n "$PACKAGES_JSON" ]] && command -v python3 >/dev/null 2>&1; then
    while IFS= read -r valid_app; do
        [[ -n "$valid_app" ]] && ALLOWED_WEB_APPS["$valid_app"]=1
    done < <(python3 -I - "$PACKAGES_JSON" <<'PYEOF' 2>/dev/null || true
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as fh:
    entries = json.load(fh)
for entry in entries:
    if not isinstance(entry, dict):
        continue
    name = str(entry.get("name") or "").strip()
    port = entry.get("default_port")
    if name and isinstance(port, (int, float)) and not isinstance(port, bool) and port > 0:
        print(name)
PYEOF
)
    [[ "${#ALLOWED_WEB_APPS[@]}" -gt 0 ]] && PACKAGES_JSON_LOADED=1
fi

is_allowed_web_app() {
    local app="$1"
    [[ "$app" =~ ^[a-zA-Z0-9-]+$ ]] || return 1
    case "$app" in
        core|10g|developer|cron|aetherflow) return 1 ;;
    esac
    if [[ "$PACKAGES_JSON_LOADED" -eq 1 ]]; then
        [[ -n "${ALLOWED_WEB_APPS[$app]:-}" ]]
        return $?
    fi
    return 0
}

HOSTS_DOMAINS=("aetherflow.aether.local")
for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    if is_allowed_web_app "$app"; then
        HOSTS_DOMAINS+=("${app}.aether.local")
    fi
done

if [[ -w /etc/hosts && ! -L /etc/hosts ]]; then
    (
        HOSTS_LOCK="/run/aetherflow/hosts.lock"
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            mkdir -p -m 0750 /run/aetherflow
        fi
        [[ ! -L /run/aetherflow && ! -L "$HOSTS_LOCK" ]] &&
            [[ ! -e "$HOSTS_LOCK" || -f "$HOSTS_LOCK" ]] &&
            [[ "$(stat -c '%u' /run/aetherflow)" == 0 ]] &&
            (( (8#$(stat -c '%a' /run/aetherflow) & 0022) == 0 )) || {
            echo "[af-certbot-sync] Refusing unsafe hosts lock path" >&2
            exit 1
        }
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            chown root:aetherflow /run/aetherflow
            chmod 0750 /run/aetherflow
        fi
        exec 8>>"$HOSTS_LOCK"
        HOSTS_LOCK_FD="/proc/${BASHPID}/fd/8"
        [[ ! -L "$HOSTS_LOCK" && "$HOSTS_LOCK" -ef "$HOSTS_LOCK_FD" ]] &&
            [[ "$(stat -Lc '%h' "$HOSTS_LOCK_FD")" == 1 ]] || {
            echo "[af-certbot-sync] Refusing replaced or hard-linked hosts lock" >&2
            exit 1
        }
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            chown root:aetherflow "$HOSTS_LOCK_FD"
            chmod 0660 "$HOSTS_LOCK_FD"
        fi
        [[ "$(stat -Lc '%a %U:%G' "$HOSTS_LOCK_FD")" == "660 root:aetherflow" ]] || {
            echo "[af-certbot-sync] Hosts lock must be 0660 root:aetherflow" >&2
            exit 1
        }
        flock -x -w 30 8 || {
            echo "[af-certbot-sync] Timed out acquiring ${HOSTS_LOCK}" >&2
            exit 1
        }
        # Preserve any non-.aether.local custom domains previously written inside AetherFlow's managed block
        while IFS= read -r existing_entry; do
            [[ -n "$existing_entry" ]] && HOSTS_DOMAINS+=("$existing_entry")
        done < <(awk '
            /^# (--- AETHERFLOW INTERNAL DNS ---|BEGIN AETHERFLOW MANAGED BLOCK)$/ { in_block=1; next }
            /^# (--- END AETHERFLOW INTERNAL DNS ---|END AETHERFLOW MANAGED BLOCK)$/ { in_block=0; next }
            in_block && $1 == "127.0.0.1" && NF >= 2 {
                for (i = 2; i <= NF; i++) {
                    if ($i !~ /\.aether\.local$/) print $i
                }
            }
        ' /etc/hosts)
        mapfile -t UNIQUE_HOSTS < <(printf '%s\n' "${HOSTS_DOMAINS[@]}" | awk 'NF && !seen[$0]++' | sort)
        TMP_HOSTS="$(mktemp /etc/.hosts.aetherflow.XXXXXX 2>/dev/null || mktemp)"
        awk '
            /^# (--- AETHERFLOW INTERNAL DNS ---|BEGIN AETHERFLOW MANAGED BLOCK)$/ { skip=1; next }
            /^# (--- END AETHERFLOW INTERNAL DNS ---|END AETHERFLOW MANAGED BLOCK)$/ { skip=0; next }
            !skip { print }
        ' /etc/hosts > "$TMP_HOSTS"
        {
            echo "# --- AETHERFLOW INTERNAL DNS ---"
            for h in "${UNIQUE_HOSTS[@]}"; do
                printf "127.0.0.1\t%s\n" "$h"
            done
            echo "# --- END AETHERFLOW INTERNAL DNS ---"
        } >> "$TMP_HOSTS"
        chmod 0644 "$TMP_HOSTS"
        if ! mv -f "$TMP_HOSTS" /etc/hosts 2>/dev/null; then
            cat "$TMP_HOSTS" > /etc/hosts
            rm -f "$TMP_HOSTS"
        fi
    )
fi

if ! command -v certbot >/dev/null 2>&1; then
    echo "[af-certbot-sync] certbot binary not found; skipping TLS certificate expansion." >&2
    exit 0
fi

af_certbot_read_env_values() {
    python3 -I - /etc/aetherflow/aetherflow.env <<'PYENV' 2>/dev/null || true
import os, pathlib, stat, sys

env_path = os.path.abspath(sys.argv[1])
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)

p = pathlib.PurePosixPath(env_path)
if ".." in p.parts or not p.name:
    raise SystemExit(0)
try:
    cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
except OSError:
    raise SystemExit(0)
try:
    for part in p.parts[1:-1]:
        nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
        os.close(cur_fd)
        cur_fd = nxt
    fd = os.open(p.name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=cur_fd)
except OSError:
    os.close(cur_fd)
    raise SystemExit(0)
os.close(cur_fd)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > 65536:
        raise SystemExit(0)
    raw = os.read(fd, 65537)
    if len(raw) > 65536:
        raise SystemExit(0)
finally:
    os.close(fd)

env_db = ""
env_data_dir = ""
env_base_domain = ""
for line in raw.decode("utf-8", errors="replace").splitlines():
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    if s.startswith("export "):
        s = s[7:].strip()
    if "=" not in s:
        continue
    k, v = s.split("=", 1)
    k = k.strip()
    v = v.strip().strip("\r\n")
    if len(v) >= 2 and ((v[0] == '"' and v[-1] == '"') or (v[0] == "'" and v[-1] == "'")):
        v = v[1:-1]
    if k in ("AF_DB_PATH", "DB_PATH", "AETHERFLOW_DB_PATH"):
        env_db = v
    elif k == "DATA_DIR":
        env_data_dir = v
    elif k == "AETHERFLOW_BASE_DOMAIN":
        env_base_domain = v

print(env_db)
print(env_data_dir)
print(env_base_domain)
PYENV
}

# FD-confined, root-scratch-isolated read-only SQLite snapshot reader for af-certbot-sync.
# Never opens live /var/lib/aetherflow/aetherflow.sqlite (or -wal/-shm/-journal sidecars) as root.
af_certbot_inspect_db() {
    python3 -I - "$@" <<'PYDB' 2>/dev/null || true
import json, os, pathlib, sqlite3, stat, sys, time, uuid

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
MAX_SCRATCH_BYTES = 2 * 1024 * 1024 * 1024
is_root = os.geteuid() == 0

def open_dir_nofollow(dir_str):
    p = pathlib.PurePosixPath(os.path.abspath(dir_str))
    if ".." in p.parts:
        return -1
    try:
        cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    except OSError:
        return -1
    try:
        for part in p.parts[1:]:
            nxt = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
            os.close(cur_fd)
            cur_fd = nxt
        return cur_fd
    except OSError:
        os.close(cur_fd)
        return -1

def is_trusted_root_dir(dir_str, allow_sticky):
    dp = pathlib.PurePosixPath(os.path.abspath(dir_str))
    if not dp.is_absolute() or ".." in dp.parts:
        return False
    cur_p = pathlib.Path("/")
    for part in dp.parts:
        cur_p = pathlib.Path("/") if part == "/" else cur_p / part
        try:
            cst = os.lstat(cur_p)
        except OSError:
            return False
        if stat.S_ISLNK(cst.st_mode) or not stat.S_ISDIR(cst.st_mode) or cst.st_uid != 0:
            return False
        writable = (cst.st_mode & 0o022) != 0
        sticky = (cst.st_mode & getattr(stat, "S_ISVTX", 0o1000)) != 0
        if writable and not (allow_sticky and sticky):
            return False
    return True

def create_root_scratch(min_free):
    sc_name = f".af-certbot-db.{os.getpid()}.{uuid.uuid4().hex}"
    for cand in ("/var/tmp", "/tmp", "/run"):
        if not is_trusted_root_dir(cand, allow_sticky=True):
            continue
        cand_fd = -1
        try:
            cand_fd = os.open(cand, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
            vfs = os.fstatvfs(cand_fd)
            avail = vfs.f_bavail * (vfs.f_frsize or vfs.f_bsize)
            if avail < min_free:
                os.close(cand_fd)
                continue
            os.mkdir(sc_name, 0o700, dir_fd=cand_fd)
            sc_fd = os.open(sc_name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cand_fd)
            st = os.fstat(sc_fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
                os.close(sc_fd)
                os.rmdir(sc_name, dir_fd=cand_fd)
                os.close(cand_fd)
                continue
            os.fchmod(sc_fd, 0o700)
            return cand_fd, sc_fd, sc_name, os.path.join(cand, sc_name)
        except OSError:
            if cand_fd >= 0:
                os.close(cand_fd)
    return None

def copy_fd_bounded(in_fd, out_dir_fd, out_name, remaining):
    out_fd = os.open(out_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0o600, dir_fd=out_dir_fd)
    copied = 0
    tail8 = b""
    try:
        while True:
            chunk = os.read(in_fd, 65536)
            if not chunk:
                break
            copied += len(chunk)
            if copied > remaining:
                raise OSError("scratch copy cap exceeded")
            tail8 = (tail8 + chunk)[-8:]
            view = memoryview(chunk)
            while view:
                w = os.write(out_fd, view)
                if w <= 0:
                    raise OSError("short write")
                view = view[w:]
        if out_name.endswith("-journal") and copied >= 16 and tail8 == b"\xd9\xd5\x05\xf9\x20\xa1\x63\xd7":
            raise OSError("forbidden SQLite super-journal trailer")
        return remaining - copied
    finally:
        os.close(out_fd)

def read_certbot_snapshot(conn):
    base_domain = ""
    has_settings = conn.execute(
        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='settings')"
    ).fetchone()
    if has_settings and has_settings[0]:
        row = conn.execute("SELECT base_domain FROM settings WHERE id = 1").fetchone()
        if row and row[0]:
            base_domain = str(row[0]).strip()
    public_domains = []
    enabled_apps = []
    has_ingress = conn.execute(
        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='app_ingress_configs')"
    ).fetchone()
    if has_ingress and has_ingress[0]:
        pub_rows = conn.execute(
            "SELECT DISTINCT public_domain FROM app_ingress_configs WHERE external_access_enabled = 1 AND public_domain != ''"
        ).fetchall()
        app_rows = conn.execute(
            "SELECT LOWER(app_name), LOWER(COALESCE(public_domain, '')) FROM app_ingress_configs WHERE external_access_enabled = 1"
        ).fetchall()
        public_domains = [str(dom).strip() for (dom,) in pub_rows if dom]
        enabled_apps = [[str(app_name), str(pub_dom or "")] for app_name, pub_dom in app_rows if app_name]
    return {
        "base_domain": base_domain,
        "public_domains": public_domains,
        "enabled_apps": enabled_apps,
    }

def db_files_root_owned_safe(parent_fd, leaf_name):
    for suffix in ("", "-wal", "-shm", "-journal"):
        try:
            st = os.stat(leaf_name + suffix, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if st is not None and (st.st_uid != 0 or (st.st_mode & 0o022) != 0):
            return False
    return True

def inspect_candidate(db_cand):
    db_abs = os.path.abspath(db_cand)
    parent_str = os.path.dirname(db_abs)
    leaf_name = os.path.basename(db_abs)
    if not leaf_name:
        return None
    parent_fd = open_dir_nofollow(parent_str)
    if parent_fd < 0:
        return None
    try:
        use_scratch = is_root and (
            not is_trusted_root_dir(parent_str, allow_sticky=False)
            or not db_files_root_owned_safe(parent_fd, leaf_name)
        )
        attempts = 3 if use_scratch else 1
        for attempt in range(attempts):
            db_fd = wal_fd = jrn_fd = -1
            sc = None
            try:
                db_fd = os.open(leaf_name, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=parent_fd)
                st = os.fstat(db_fd)
                if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                    return None
                if os.read(db_fd, 16) != b"SQLite format 3\x00":
                    return None
                total_sz = st.st_size
                for suffix in ("-wal", "-shm", "-journal"):
                    try:
                        sfd = os.open(leaf_name + suffix, os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=parent_fd)
                    except FileNotFoundError:
                        continue
                    sst = os.fstat(sfd)
                    if not stat.S_ISREG(sst.st_mode) or sst.st_nlink != 1:
                        os.close(sfd)
                        return None
                    if suffix == "-wal":
                        wal_fd = sfd
                        total_sz += sst.st_size
                    elif suffix == "-journal":
                        if sst.st_size >= 16:
                            os.lseek(sfd, -8, os.SEEK_END)
                            jtail = os.read(sfd, 8)
                            os.lseek(sfd, 0, os.SEEK_SET)
                            if jtail == b"\xd9\xd5\x05\xf9\x20\xa1\x63\xd7":
                                os.close(sfd)
                                return None
                        jrn_fd = sfd
                        total_sz += sst.st_size
                    else:
                        os.close(sfd)
                if use_scratch:
                    if total_sz > MAX_SCRATCH_BYTES:
                        return None
                    sc = create_root_scratch(total_sz * 2 + 16 * 1024 * 1024)
                    if sc is None:
                        return None
                    _, sc_fd, _, sc_path = sc
                    os.lseek(db_fd, 0, os.SEEK_SET)
                    rem = copy_fd_bounded(db_fd, sc_fd, "certbot.sqlite", MAX_SCRATCH_BYTES)
                    if wal_fd >= 0:
                        rem = copy_fd_bounded(wal_fd, sc_fd, "certbot.sqlite-wal", rem)
                    if jrn_fd >= 0:
                        copy_fd_bounded(jrn_fd, sc_fd, "certbot.sqlite-journal", rem)
                    conn = sqlite3.connect(os.path.join(sc_path, "certbot.sqlite"), timeout=5)
                else:
                    conn = sqlite3.connect(pathlib.Path(db_abs).as_uri() + "?mode=ro", uri=True, timeout=5)
                try:
                    conn.execute("PRAGMA trusted_schema = OFF;")
                    return read_certbot_snapshot(conn)
                finally:
                    conn.close()
            except sqlite3.DatabaseError:
                if attempt + 1 < attempts:
                    time.sleep(0.025)
                    continue
                return None
            except OSError:
                return None
            finally:
                for fd in (db_fd, wal_fd, jrn_fd):
                    if fd >= 0:
                        os.close(fd)
                if sc is not None:
                    sc_base_fd, sc_fd, sc_name, _ = sc
                    for nm in ("certbot.sqlite", "certbot.sqlite-wal", "certbot.sqlite-shm", "certbot.sqlite-journal"):
                        try:
                            os.unlink(nm, dir_fd=sc_fd)
                        except FileNotFoundError:
                            _ = nm
                    os.close(sc_fd)
                    try:
                        os.rmdir(sc_name, dir_fd=sc_base_fd)
                    except OSError:
                        _ = sc_name
                    os.close(sc_base_fd)
    finally:
        os.close(parent_fd)
    return None

for cand in sys.argv[1:]:
    if not cand:
        continue
    res = inspect_candidate(cand)
    if res is not None:
        print(json.dumps(res))
        break
PYDB
}

ENV_DB=""
ENV_DATA_DIR=""
ENV_BASE_DOMAIN=""
_ENV_PARSED="$(af_certbot_read_env_values)"
if [[ -n "$_ENV_PARSED" ]]; then
    ENV_DB="$(printf '%s\n' "$_ENV_PARSED" | sed -n '1p')"
    ENV_DATA_DIR="$(printf '%s\n' "$_ENV_PARSED" | sed -n '2p')"
    ENV_BASE_DOMAIN="$(printf '%s\n' "$_ENV_PARSED" | sed -n '3p')"
fi

DB_SNAPSHOT_JSON="$(af_certbot_inspect_db \
    "${AF_DB_PATH:-}" \
    "${DB_PATH:-}" \
    "${AETHERFLOW_DB_PATH:-}" \
    "$ENV_DB" \
    "${AETHERFLOW_DATA_DIR:+${AETHERFLOW_DATA_DIR%/}/aetherflow.sqlite}" \
    "${ENV_DATA_DIR:+${ENV_DATA_DIR%/}/aetherflow.sqlite}" \
    /var/lib/aetherflow/aetherflow.sqlite \
    /opt/AetherFlow/current/data/aetherflow.sqlite \
    /opt/AetherFlow/data/aetherflow.sqlite \
    /opt/AetherFlow/backend/data/aetherflow.sqlite)"

BASE_DOMAIN=""
if [[ -n "$DB_SNAPSHOT_JSON" ]]; then
    BASE_DOMAIN="$(python3 -I -c 'import json, sys; d = json.loads(sys.argv[1]); print((d.get("base_domain") or "").strip())' "$DB_SNAPSHOT_JSON" 2>/dev/null | sed 's/^\*\.//' | tr -d '[:space:]' || true)"
fi
if [[ -z "$BASE_DOMAIN" && -n "$ENV_BASE_DOMAIN" ]]; then
    BASE_DOMAIN="$(printf '%s' "$ENV_BASE_DOMAIN" | tr -d '[:space:]')"
    BASE_DOMAIN="${BASE_DOMAIN#\*.}"
fi
DOMAIN_REGEX='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
if [[ -z "$BASE_DOMAIN" || "$BASE_DOMAIN" == "localhost" || "$BASE_DOMAIN" == *.local ]] || [[ ! "$BASE_DOMAIN" =~ $DOMAIN_REGEX ]]; then
    exit 0
fi

public_dns_resolves() {
    local host="$1" resolver rr
    for resolver in 1.1.1.1 8.8.8.8; do
        for rr in A AAAA; do
            if command -v dig >/dev/null 2>&1; then
                dig +short +time=2 +tries=1 -t "$rr" "$host" "@$resolver" 2>/dev/null |
                    grep -Eq '^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[0-9a-fA-F]*:[0-9a-fA-F:.]+)$' && return 0
            elif command -v host >/dev/null 2>&1; then
                host -W 2 -t "$rr" "$host" "$resolver" 2>/dev/null |
                    grep -Eq ' has (IPv6 )?address ' && return 0
            elif command -v nslookup >/dev/null 2>&1; then
                nslookup -timeout=2 "-type=$rr" "$host" "$resolver" 2>/dev/null |
                    awk '/^Name:/ { answer=1 } answer && /^Address/ { found=1 } END { exit !found }' && return 0
            else
                { getent ahostsv4 "$host" || true; getent ahostsv6 "$host" || true; } 2>/dev/null |
                    awk '$1 !~ /^(127\.|::1$|::ffff:127\.)/ { found=1 } END { exit !found }'
                return $?
            fi
        done
    done
    return 1
}

CERT_FILE="/etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem"
if [[ ! -f "$CERT_FILE" ]]; then
    echo "[af-certbot-sync] Initial TLS certificate not yet issued for ${BASE_DOMAIN} (${CERT_FILE} missing); skipping SAN expansion." >&2
    exit 0
fi

CURRENT_SAN_DNS="$(openssl x509 -in "$CERT_FILE" -noout -ext subjectAltName 2>/dev/null |
    tr ',' '\n' | sed -nE 's/^[[:space:]]*DNS:([^[:space:]]+)[[:space:]]*$/\1/p' || true)"
cert_has_san() {
    grep -Fxiq -- "$1" <<< "$CURRENT_SAN_DNS"
}
if cert_has_san "*.${BASE_DOMAIN}"; then
    # Wildcard certificate already covers all subdomains
    exit 0
fi

DOMAINS=("$BASE_DOMAIN")
for sub in "www.${BASE_DOMAIN}" "direct.${BASE_DOMAIN}"; do
    if public_dns_resolves "$sub"; then
        DOMAINS+=("$sub")
    fi
done

if [[ -n "$DB_SNAPSHOT_JSON" ]]; then
    while IFS= read -r dom; do
        dom="$(echo "$dom" | tr -d '[:space:]')"
        [[ -z "$dom" ]] && continue
        if [[ "$dom" =~ $DOMAIN_REGEX ]] && public_dns_resolves "$dom"; then
            DOMAINS+=("$dom")
        fi
    done < <(python3 -I -c 'import json, sys; d = json.loads(sys.argv[1]); [print(x) for x in d.get("public_domains", [])]' "$DB_SNAPSHOT_JSON" 2>/dev/null || true)
fi

for lock in /install/.*.lock; do
    [[ -e "$lock" ]] || continue
    app="$(basename "$lock")"
    app="${app#.}"
    app="${app%.lock}"
    is_allowed_web_app "$app" || continue
    [[ "$app" =~ ^[a-z0-9_-]+$ ]] || continue
    cand="${app}.${BASE_DOMAIN}"
    ext_enabled=""
    if [[ -n "$DB_SNAPSHOT_JSON" ]]; then
        ext_enabled="$(python3 -I -c 'import json, sys
d = json.loads(sys.argv[1])
app = sys.argv[2].lower()
cand = sys.argv[3].lower()
for a, pub in d.get("enabled_apps", []):
    if a == app and (pub == "" or pub == cand):
        print("1")
        break
' "$DB_SNAPSHOT_JSON" "$app" "$cand" 2>/dev/null || true)"
    fi
    [[ -n "$ext_enabled" ]] || continue
    if public_dns_resolves "$cand"; then
        DOMAINS+=("$cand")
    fi
done

mapfile -t UNIQUE_DOMAINS < <(printf '%s\n' "${DOMAINS[@]}" | awk '!seen[$0]++')

NEED_EXPAND=0
CERT_ARGS=()
for d in "${UNIQUE_DOMAINS[@]}"; do
    CERT_ARGS+=("-d" "$d")
    if ! cert_has_san "$d"; then
        NEED_EXPAND=1
    fi
done

if [[ "$NEED_EXPAND" -eq 1 ]]; then
    WEBROOT="/var/www/aetherflow-default"
    echo "[af-certbot-sync] Expanding TLS certificate SANs for ${BASE_DOMAIN}: ${UNIQUE_DOMAINS[*]} (webroot=${WEBROOT})" >&2
    (umask 022; mkdir -p "${WEBROOT}/.well-known/acme-challenge")
    certbot certonly --webroot -w "${WEBROOT}" --cert-name "$BASE_DOMAIN" --expand --non-interactive --agree-tos "${CERT_ARGS[@]}"
    systemctl reload apache2
fi
