#!/usr/bin/env bash
# Compatibility shim delegating legacy af-backup to native `af backup`.
set -euo pipefail

for af_bin in "${AETHERFLOW_CLI_BIN:-}" /opt/AetherFlow/current/bin/af /opt/AetherFlow/current/af /usr/local/bin/af-cli /opt/AetherFlow/bin/af-cli /usr/local/bin/af; do
  if [[ -n "$af_bin" && -x "$af_bin" && ! "$af_bin" -ef "$0" ]]; then
    if [[ "$af_bin" != "/usr/local/bin/af" ]] || ! grep -q '/usr/local/bin/AetherFlow/system/af' "$af_bin" 2>/dev/null; then
      exec "$af_bin" backup "$@"
    fi
  fi
done

printf 'Native AetherFlow CLI binary (/usr/local/bin/af) not found.\n' >&2
exit 1
