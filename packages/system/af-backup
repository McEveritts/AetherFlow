#!/usr/bin/env bash
# Compatibility shim delegating legacy af-backup to native `af backup`.
set -euo pipefail

SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_REAL}")" && pwd)"
_af_cli_shim=""
for _cand in \
  "${SCRIPT_DIR}/../lib/cli_shim.sh" \
  /opt/AetherFlow/current/packages/lib/cli_shim.sh \
  /opt/AetherFlow/packages/lib/cli_shim.sh \
  /usr/local/bin/AetherFlow/lib/cli_shim.sh; do
  if [[ -f "$_cand" ]]; then
    _af_cli_shim="$_cand"
    break
  fi
done
if [[ -z "$_af_cli_shim" ]]; then
  printf 'Unable to locate AetherFlow CLI shim helper (packages/lib/cli_shim.sh).\n' >&2
  exit 1
fi
# shellcheck source=../lib/cli_shim.sh
source "$_af_cli_shim"
af_exec_native_cli backup "$@"
