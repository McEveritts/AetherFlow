set -euo pipefail

JSON_OUTPUT=0
USERNAME=""
SIZE=""

print_usage() {
  echo "Usage: setdisk [--username USER] [--size 500GB] [--json]"
}

emit_json_error() {
  local user="$1" quota="$2" err_msg="$3"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys; print(json.dumps({"username": sys.argv[1], "quota": sys.argv[2], "error": sys.argv[3], "status": "failed"}))' \
      "$user" "$quota" "$err_msg"
  else
    printf '{"error":"%s","status":"failed"}\n' "${err_msg//\"/\'}"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --username)
        [[ $# -ge 2 ]] || { echo "Missing value for --username" >&2; exit 1; }
        USERNAME="$2"
        shift 2
        ;;
      --size)
        [[ $# -ge 2 ]] || { echo "Missing value for --size" >&2; exit 1; }
        SIZE="$2"
        shift 2
        ;;
      --json)
        JSON_OUTPUT=1
        shift
        ;;
      --help|-h)
        print_usage
        exit 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        print_usage >&2
        exit 1
        ;;
    esac
  done
}

prompt_if_needed() {
  if [[ -z "${USERNAME}" ]]; then
    echo "================================================================================="
    echo "Disk Space MUST be in GB/TB - Do not attempt to add decimals in space settings,"
    echo "Example - Good: 711GB OR 2TB, Example - Bad: 711.5GB OR 2.5TB"
    echo "================================================================================="
    echo
    echo -n "Username: "
    read -r USERNAME
  fi

  if [[ -z "${SIZE}" ]]; then
    echo "Quota size for user: (EX: 500GB): "
    read -r SIZE
  fi
}

apply_quota() {
  local quantity unit_bytes max_quantity disk_blocks quota_bytes setquota_err=""
  if [[ ! "${USERNAME}" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    if [[ ${JSON_OUTPUT} -eq 1 ]]; then
      emit_json_error "${USERNAME}" "${SIZE^^}" "Invalid username."
    else
      echo "Invalid username: ${USERNAME}" >&2
    fi
    return 2
  fi
  [[ "${SIZE^^}" =~ ^([0-9]+)([MGT]B)$ ]] || return 1
  quantity="${BASH_REMATCH[1]}"
  case "${BASH_REMATCH[2]}" in
    MB) unit_bytes=$((1024 * 1024)) ;;
    GB) unit_bytes=$((1024 * 1024 * 1024)) ;;
    TB) unit_bytes=$((1024 * 1024 * 1024 * 1024)) ;;
  esac

  # Normalize before comparing lengths so leading zeros cannot trigger octal or overflow.
  quantity="${quantity#"${quantity%%[!0]*}"}"
  quantity="${quantity:-0}"
  max_quantity=$((9223372036854775807 / unit_bytes))
  if [[ ${#quantity} -gt ${#max_quantity} ||
        ( ${#quantity} -eq ${#max_quantity} && "$quantity" > "$max_quantity" ) ]]; then
    return 1
  fi
  quota_bytes=$((10#$quantity * unit_bytes))
  disk_blocks=$((quota_bytes / 1024))

  if ! setquota_err="$(setquota -u "${USERNAME}" "${disk_blocks}" "${disk_blocks}" 0 0 -a 2>&1)"; then
    if [[ ${JSON_OUTPUT} -eq 1 ]]; then
      emit_json_error "${USERNAME}" "${SIZE^^}" "${setquota_err:-setquota failed}"
    else
      echo "Failed to apply quota for ${USERNAME}: ${setquota_err:-setquota failed}" >&2
    fi
    return 2
  fi

  if [[ ${JSON_OUTPUT} -eq 1 ]]; then
    printf '{"username":"%s","quota":"%s","quota_bytes":%s,"status":"applied"}\n' "${USERNAME}" "${SIZE^^}" "${quota_bytes}"
  else
    echo "Quota updated for ${USERNAME}: ${SIZE^^}"
  fi
}

parse_args "$@"
prompt_if_needed

rc=0
apply_quota || rc=$?
if [[ "$rc" -ne 0 ]]; then
  if [[ "$rc" -eq 1 ]]; then
    if [[ ${JSON_OUTPUT} -eq 1 ]]; then
      emit_json_error "${USERNAME}" "${SIZE^^}" "Invalid quota size. Use integer MB, GB, or TB values."
    else
      echo "================================================================================="
      echo "Disk Space MUST be in GB/TB - Do not attempt to add decimals in space settings,"
      echo "Example - Good: 711GB OR 2TB, Example - Bad: 711.5GB OR 2.5TB"
      echo "Exiting script, type bash $0 and try again"
      echo "================================================================================="
    fi
  fi
  exit 1
fi
