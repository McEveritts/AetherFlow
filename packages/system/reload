CURRENT_USER="$(id -un)"
pkill -u "$CURRENT_USER" irssi >/dev/null 2>&1 || true
pkill -u "$CURRENT_USER" rtorrent >/dev/null 2>&1 || true
rm -f -- "${HOME}/.sessions/rtorrent.lock"

