#!/bin/bash
set -euo pipefail

# AetherFlow v4 update compatibility shim delegating to `af release` / `release-manager.sh`.
AF_ROOT="${AF_INSTALL_ROOT:-/opt/AetherFlow}"
AF_ROOT_REAL=""
if [[ -n "${AF_INSTALL_ROOT:-}" ]]; then
    if [[ "${AF_ROOT}" != /* ]]; then
        echo "[ERROR] AF_INSTALL_ROOT must be an absolute path: ${AF_ROOT}" >&2
        exit 1
    fi
    AF_ROOT_REAL="$(readlink -f -- "${AF_ROOT}" 2>/dev/null || realpath -m -- "${AF_ROOT}")"
    AF_ROOT="${AF_ROOT_REAL}"
fi
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CHANNEL="" CHECK_ONLY=false DRY_RUN=false OFFLINE=false

usage() {
    cat <<'EOF'
Usage: updateAetherFlow [--channel <stable|nightly|experimental>] [--check] [--dry-run] [--offline] [--help]
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --channel) [[ $# -ge 2 ]] || { echo "[ERROR] --channel requires stable, nightly, or experimental" >&2; exit 1; }; CHANNEL="$2"; shift 2 ;;
        --channel=*) CHANNEL="${1#--channel=}"; shift ;;
        --check) CHECK_ONLY=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --offline) OFFLINE=true; shift ;;
        *) echo "[ERROR] Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

[[ "${CHANNEL}" == "experimental" ]] && CHANNEL="nightly"

if [[ -n "${CHANNEL}" && "${CHANNEL}" != "stable" && "${CHANNEL}" != "nightly" ]]; then
    echo "[ERROR] Unsupported channel '${CHANNEL}' (expected stable, nightly, or experimental)" >&2
    exit 1
fi

if [[ "${OFFLINE}" == "true" && "${DRY_RUN}" != "true" ]]; then
    echo "[ERROR] --offline requires --dry-run (live offline self-update is unsupported)" >&2
    exit 1
fi

if [[ "${DRY_RUN}" != "true" && "${CHECK_ONLY}" != "true" && "${EUID}" -ne 0 ]]; then
    echo "[ERROR] updateAetherFlow must run as root (re-run with sudo, or pass --check / --help / --dry-run)." >&2
    exit 1
fi

is_confined_to_install_root() {
    local target_real="$1"
    [[ -n "${target_real}" ]] || return 1
    if [[ -z "${AF_INSTALL_ROOT:-}" ]]; then
        return 0
    fi
    if [[ "${AF_ROOT_REAL}" == "/" ]]; then
        [[ "${target_real}" == /* ]]
    else
        [[ "${target_real}" == "${AF_ROOT_REAL}" || "${target_real}" == "${AF_ROOT_REAL}/"* ]]
    fi
}

is_known_shell_shim() {
    local target_file="$1"
    grep -qE 'AetherFlow v4 update compatibility shim|AetherFlow Package Manager Batch CLI Installer|/usr/local/bin/AetherFlow/system/af' "${target_file}" 2>/dev/null
}

resolve_af_bin() {
    local path_af cand self_real cand_real magic
    local -a candidates=()
    self_real="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    if [[ -n "${AF_INSTALL_ROOT:-}" ]]; then
        candidates=(
            "${AF_ROOT}/current/bin/af"
            "${AF_ROOT}/current/af"
            "${AF_ROOT}/opt/AetherFlow/current/bin/af"
            "${AF_ROOT}/opt/AetherFlow/current/af"
            "${AF_ROOT}/usr/local/bin/af"
        )
    else
        path_af="$(command -v af 2>/dev/null || true)"
        candidates=(
            "${AF_ROOT}/current/bin/af"
            "${AF_ROOT}/current/af"
            "/usr/local/bin/af"
            "${path_af}"
        )
    fi
    for cand in "${candidates[@]}"; do
        [[ -n "${cand}" && -x "${cand}" && ! -d "${cand}" ]] || continue
        cand_real="$(readlink -f -- "${cand}" 2>/dev/null || true)"
        [[ -n "${cand_real}" && -x "${cand_real}" && ! -d "${cand_real}" ]] || continue
        [[ "${cand_real}" == "${self_real}" ]] && continue
        is_confined_to_install_root "${cand_real}" || continue
        magic="$(LC_ALL=C head -c 2 -- "${cand_real}" 2>/dev/null || true)"
        if [[ "${magic}" == "#!" ]] && is_known_shell_shim "${cand_real}"; then
            continue
        fi
        printf '%s\n' "${cand}"; return 0
    done
    return 1
}

resolve_release_manager() {
    local cand cand_real
    local -a candidates=(
        "${AF_ROOT}/current/deploy/release-manager.sh"
        "${AF_ROOT}/deploy/release-manager.sh"
        "${AF_ROOT}/opt/AetherFlow/current/deploy/release-manager.sh"
        "${AF_ROOT}/opt/AetherFlow/deploy/release-manager.sh"
    )
    if [[ -z "${AF_INSTALL_ROOT:-}" ]]; then
        candidates+=("${REPO_ROOT}/deploy/release-manager.sh")
    fi
    for cand in "${candidates[@]}"; do
        [[ -f "${cand}" ]] || continue
        cand_real="$(readlink -f -- "${cand}" 2>/dev/null || true)"
        [[ -n "${cand_real}" && -f "${cand_real}" ]] || continue
        is_confined_to_install_root "${cand_real}" || continue
        printf '%s\n' "${cand}"; return 0
    done
    return 1
}

AF_BIN="$(resolve_af_bin || true)"
RM_SCRIPT="$(resolve_release_manager || true)"
AF_GLOBAL_ARGS=()
RM_GLOBAL_ARGS=()
if [[ -n "${AF_INSTALL_ROOT:-}" ]]; then
    AF_GLOBAL_ARGS+=(--root "${AF_ROOT}")
    export AETHERFLOW_RELEASE_ROOT="${AF_ROOT}"
    RM_GLOBAL_ARGS+=(--root "${AF_ROOT}")
fi

read_confined_version_file() {
    local cand="$1" cand_real
    [[ ! -L "${cand}" && -f "${cand}" ]] || return 1
    cand_real="$(readlink -f -- "${cand}" 2>/dev/null || true)"
    [[ -n "${cand_real}" && -f "${cand_real}" ]] || return 1
    is_confined_to_install_root "${cand_real}" || return 1
    head -n 1 -- "${cand_real}"
}

if [[ "${CHECK_ONLY}" == "true" ]]; then
    [[ "${DRY_RUN}" == "true" ]] && { echo "[DRY-RUN] Would check release status under ${AF_ROOT}"; exit 0; }
    [[ -n "${AF_BIN}" ]] && exec "${AF_BIN}" ${AF_GLOBAL_ARGS[@]+"${AF_GLOBAL_ARGS[@]}"} release status
    if ver_out="$(read_confined_version_file "${AF_ROOT}/current/.version")"; then
        printf 'current_version=%s\n' "${ver_out}"; exit 0
    elif ver_out="$(read_confined_version_file "${AF_ROOT}/opt/AetherFlow/current/.version")"; then
        printf 'current_version=%s\n' "${ver_out}"; exit 0
    fi
    echo "[ERROR] No native af CLI or active release slot found under ${AF_ROOT}" >&2
    exit 1
fi

CMD_ARGS=()
[[ -n "${CHANNEL}" ]] && CMD_ARGS+=(--channel "${CHANNEL}")
[[ "${OFFLINE}" == "true" ]] && CMD_ARGS+=(--offline)

if [[ -n "${AF_BIN}" ]]; then
    if [[ "${DRY_RUN}" == "true" && "${OFFLINE}" == "true" ]]; then
        exec "${AF_BIN}" --dry-run ${AF_GLOBAL_ARGS[@]+"${AF_GLOBAL_ARGS[@]}"} release deploy --local ${CMD_ARGS[@]+"${CMD_ARGS[@]}"}
    fi
    CMD=("${AF_BIN}" ${AF_GLOBAL_ARGS[@]+"${AF_GLOBAL_ARGS[@]}"} release deploy --local ${CMD_ARGS[@]+"${CMD_ARGS[@]}"})
elif [[ -n "${RM_SCRIPT}" ]]; then
    if [[ "${DRY_RUN}" == "true" && "${OFFLINE}" == "true" ]]; then
        exec bash "${RM_SCRIPT}" deploy ${RM_GLOBAL_ARGS[@]+"${RM_GLOBAL_ARGS[@]}"} --dry-run ${CMD_ARGS[@]+"${CMD_ARGS[@]}"}
    fi
    CMD=(bash "${RM_SCRIPT}" deploy ${RM_GLOBAL_ARGS[@]+"${RM_GLOBAL_ARGS[@]}"} ${CMD_ARGS[@]+"${CMD_ARGS[@]}"})
else
    echo "[ERROR] Neither native af CLI nor release-manager.sh found under ${AF_ROOT}" >&2
    exit 1
fi

[[ "${DRY_RUN}" == "true" ]] && { printf '[DRY-RUN] Would execute:'; printf ' %q' "${CMD[@]}"; printf '\n'; exit 0; }
exec "${CMD[@]}"
