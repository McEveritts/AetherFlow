#!/bin/bash

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for COMMON_SH in "${SELF_DIR}/../common.sh" /opt/AetherFlow/current/packages/common.sh /opt/AetherFlow/packages/common.sh /usr/local/bin/AetherFlow/common.sh; do
    if [[ -f "${COMMON_SH}" ]]; then
        source "${COMMON_SH}"
        break
    fi
done
if [[ ! -f "${COMMON_SH}" ]]; then
    printf 'Unable to locate AetherFlow common.sh\n' >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage:
  af-systemd-sandbox apply --profile <profile> [--rw <path>]... <unit> [<unit>...]
  af-systemd-sandbox remove <unit> [<unit>...]

Profiles:
  native, go, python, node, mono, dotnet, java, privileged, none
EOF
}

normalize_unit() {
    local unit="$1"
    case "${unit}" in
        *.service|*.timer|*.socket) printf '%s\n' "${unit}" ;;
        *) printf '%s.service\n' "${unit}" ;;
    esac
}

is_exempt_unit() {
    local unit="$1"
    case "${unit}" in
        aetherflow-api.service|aetherflow-runner.service|af-transcode-worker*|wg-quick@*|wireguard*|tailscale*|tailscaled*|nfs-server*|mnt-af\\x2dpeers-*|fail2ban.service|pihole-FTL.service|netdata.service|node_exporter.service|apache2.service|mariadb.service|mysql.service|mergerfs*|rclone-vfs*|scrutiny-collector*|x2goserver*|novnc-xvnc*|novnc-session*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

service_user_for_unit() {
    local unit="$1"
    local service_user
    service_user="$(systemctl show "${unit}" -p User --value 2>/dev/null || true)"
    if [[ -z "${service_user}" ]]; then
        service_user="root"
    fi
    printf '%s\n' "${service_user}"
}

service_home_for_user() {
    local service_user="$1"
    local entry
    entry="$(getent passwd "${service_user}" 2>/dev/null || true)"
    if [[ -n "${entry}" ]]; then
        printf '%s\n' "${entry}" | cut -d: -f6
        return
    fi

    printf '/home/%s\n' "${service_user}"
}

resolve_master_user() {
    local creds_file u=""
    for creds_file in "${AETHERFLOW_MASTER_CREDS_FILE:-/var/lib/aetherflow/.master.creds}" "/etc/aetherflow/.master.creds" "/root/.master.creds"; do
        if [[ -n "${creds_file}" ]]; then
            u="$(python3 -I - "${creds_file}" <<'PY' 2>/dev/null || true
import json
import os
import pathlib
import re
import stat
import sys

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
MAX_CREDS_BYTES = 65536

try:
    p = pathlib.PurePosixPath(os.path.abspath(sys.argv[1]))
    if ".." in p.parts or len(p.parts) < 2:
        raise SystemExit(0)
    cur_fd = os.open("/", os.O_RDONLY | O_DIRECTORY | O_CLOEXEC)
    try:
        for part in p.parts[1:-1]:
            nxt_fd = os.open(part, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, dir_fd=cur_fd)
            os.close(cur_fd)
            cur_fd = nxt_fd
        fd = os.open(p.parts[-1], os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC, dir_fd=cur_fd)
    finally:
        os.close(cur_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > MAX_CREDS_BYTES:
            raise SystemExit(0)
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, 8192)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_CREDS_BYTES:
                raise SystemExit(0)
            chunks.append(chunk)
        text = b"".join(chunks).decode("utf-8", errors="replace")
    finally:
        os.close(fd)
    try:
        username = json.loads(text).get("username", "")
    except json.JSONDecodeError:
        first = text.splitlines()[0].strip()
        username = first.removeprefix("username=") if first.startswith("username=") else first.split(":", 1)[0]
    if isinstance(username, str) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
        print(username)
except (OSError, ValueError, IndexError, AttributeError):
    _ = sys.argv[1]
PY
)"
            if [[ -n "${u}" ]]; then
                printf '%s\n' "${u}"
                return
            fi
        fi
    done
    printf '%s\n' "${service_user:-root}"
}

expand_rw_path() {
    local raw_path="$1"
    local service_user="$2"
    local service_home="$3"
    local master_user
    master_user="$(resolve_master_user)"
    local optional_prefix=""
    if [[ "${raw_path}" == -* ]]; then
        optional_prefix="-"
        raw_path="${raw_path#-}"
    fi
    local expanded="${raw_path}"
    expanded="${expanded//\{\{SERVICE_USER\}\}/${service_user}}"
    expanded="${expanded//\{\{SERVICE_HOME\}\}/${service_home}}"
    expanded="${expanded//\{\{MASTER_USER\}\}/${master_user}}"
    # Always prefix with '-' if optional or if directory does not currently exist on disk
    # so systemd never fails with 226/NAMESPACE on optional/missing directories.
    local result=""
    if [[ -n "${optional_prefix}" || ! -e "${expanded}" ]]; then
        result="-${expanded}"
    else
        result="${expanded}"
    fi
    if [[ "${result}" == *[[:space:]]* ]]; then
        printf '"%s"\n' "${result}"
    else
        printf '%s\n' "${result}"
    fi
}

profile_block() {
    local profile="$1"
    local unit="${2:-}"
    local private_devices="yes"
    local restrict_namespaces="yes"
    local umask="0077"
    local protect_home="read-only"

    case "${unit}" in
        jellyfin*|plex*|emby*|tdarr*|threadfin*|scrutiny*|dispatcharr*|unmanic*)
            private_devices="no"
            ;;
        flaresolverr*)
            restrict_namespaces="no"
            ;;
        librespeed.service)
            protect_home="yes"
            ;;
    esac

    case "${unit}" in
        qbittorrent*|deluge*|rtorrent*|transmission*|sabnzbd*|nzbget*|pyload*|syncthing*|flood*|sonarr*|radarr*|lidarr*|readarr*|bazarr*|listenarr*|unpackerr*|filebot*|seedcross*|unmanic*|cloudplow*|qui*|autobrr*|autoscan*|recyclarr*|dispatcharr*|jellyfin*|plex*|emby*|audiobookshelf*|calibreweb*|kavita*|navidrome*)
            umask="0002"
            ;;
    esac

    cat <<EOF
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=${private_devices}
ProtectSystem=strict
ProtectHome=${protect_home}
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=${restrict_namespaces}
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=${umask}
EOF

    case "${profile}" in
        node|mono|dotnet|java|python)
            ;;
        *)
            echo "MemoryDenyWriteExecute=yes"
            ;;
    esac
}

remove_sandbox_dropin() {
    local unit="$1"
    local dropin_dir="/etc/systemd/system/${unit}.d"
    local dropin_file="${dropin_dir}/10-aetherflow-sandbox.conf"
    rm -f "${dropin_file}" "${dropin_dir}/aetherflow-sandbox.conf"
    rmdir "${dropin_dir}" >/dev/null 2>&1 || true
    log_info "Removed sandbox drop-in for ${unit}"
}

apply_sandbox_dropin() {
    local profile="$1"
    local unit="$2"
    shift 2

    if [[ "${unit}" != *.service ]]; then
        remove_sandbox_dropin "${unit}"
        return 0
    fi

    if [[ "${profile}" == "privileged" || "${profile}" == "none" ]] || is_exempt_unit "${unit}"; then
        remove_sandbox_dropin "${unit}"
        log_info "Unit ${unit} is exempt from strict sandboxing (profile=${profile})"
        return 0
    fi

    local service_user service_home dropin_dir dropin_file
    service_user="$(service_user_for_unit "${unit}")"
    service_home="$(service_home_for_user "${service_user}")"
    dropin_dir="/etc/systemd/system/${unit}.d"
    dropin_file="${dropin_dir}/10-aetherflow-sandbox.conf"

    if [[ -L "/etc/systemd/system" || -L "${dropin_dir}" || -L "${dropin_file}" ]]; then
        sandbox_error "Refusing symlinked sandbox drop-in path for ${unit}"
        return 1
    fi
    mkdir -p "${dropin_dir}"
    rm -f "${dropin_dir}/aetherflow-sandbox.conf"

    local tmp_dropin
    tmp_dropin="$(mktemp "${dropin_dir}/.10-aetherflow-sandbox.conf.XXXXXX")"
    chmod 0644 "${tmp_dropin}"
    {
        echo "[Service]"
        profile_block "${profile}" "${unit}"

        if [[ "$#" -gt 0 ]]; then
            local expanded_paths=()
            local raw_path
            for raw_path in "$@"; do
                expanded_paths+=("$(expand_rw_path "${raw_path}" "${service_user}" "${service_home}")")
            done

            printf 'ReadWritePaths='
            printf '%s ' "${expanded_paths[@]}"
            printf '\n'
        fi
    } > "${tmp_dropin}"
    mv -f "${tmp_dropin}" "${dropin_file}"

    log_info "Applied sandbox profile ${profile} to ${unit}"
}

sandbox_error() {
    local msg="$1"
    if declare -F log_error >/dev/null 2>&1; then
        log_error "${msg}"
    fi
    printf 'ERROR: %s\n' "${msg}" >&2
}

restart_if_active() {
    local unit="$1"
    local is_active_rc=0
    systemctl is-active --quiet -- "${unit}" || is_active_rc=$?
    if [[ "${is_active_rc}" -eq 0 ]]; then
        if ! systemctl restart -- "${unit}"; then
            sandbox_error "Failed to restart active unit ${unit} after sandbox update"
            return 1
        fi
        local unit_type
        if ! unit_type="$(systemctl show -p Type --value -- "${unit}")"; then
            sandbox_error "Unable to inspect service type after sandbox restart of ${unit}"
            return 1
        fi
        if [[ "${unit_type}" != "oneshot" ]] && ! systemctl is-active --quiet -- "${unit}"; then
            sandbox_error "Unit ${unit} is not active after sandbox restart"
            return 1
        fi
    elif [[ "${is_active_rc}" -ne 3 && "${is_active_rc}" -ne 4 ]]; then
        sandbox_error "Unable to inspect active state for ${unit} (systemctl is-active exited ${is_active_rc})"
        return "${is_active_rc}"
    fi
}

command_name="${1:-}"
if [[ -z "${command_name}" ]]; then
    usage
    exit 1
fi
shift || true

case "${command_name}" in
    apply)
        profile="native"
        rw_paths=()
        units=()

        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --profile)
                    profile="${2:-}"
                    shift 2
                    ;;
                --rw)
                    rw_paths+=("${2:-}")
                    shift 2
                    ;;
                --help|-h)
                    usage
                    exit 0
                    ;;
                *)
                    units+=("$(normalize_unit "$1")")
                    shift
                    ;;
            esac
        done

        if [[ "${#units[@]}" -eq 0 ]]; then
            usage
            exit 1
        fi

        restart_units=()
        for unit in "${units[@]}"; do
            had_dropin=false
            if [[ -f "/etc/systemd/system/${unit}.d/10-aetherflow-sandbox.conf" || -f "/etc/systemd/system/${unit}.d/aetherflow-sandbox.conf" ]]; then
                had_dropin=true
            fi
            apply_sandbox_dropin "${profile}" "${unit}" "${rw_paths[@]}"
            if [[ "${unit}" == *.service ]]; then
                if [[ -f "/etc/systemd/system/${unit}.d/10-aetherflow-sandbox.conf" || "${had_dropin}" == true ]]; then
                    restart_units+=("${unit}")
                fi
            fi
        done

        if ! systemctl daemon-reload; then
            sandbox_error "Failed to reload systemd daemon after sandbox update"
            exit 1
        fi
        for unit in "${restart_units[@]}"; do
            restart_if_active "${unit}"
        done
        ;;
    remove)
        units=()
        while [[ "$#" -gt 0 ]]; do
            units+=("$(normalize_unit "$1")")
            shift
        done
        if [[ "${#units[@]}" -eq 0 ]]; then
            usage
            exit 1
        fi
        for unit in "${units[@]}"; do
            remove_sandbox_dropin "${unit}"
        done
        if ! systemctl daemon-reload; then
            sandbox_error "Failed to reload systemd daemon after sandbox removal"
            exit 1
        fi
        ;;
    --help|-h)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
