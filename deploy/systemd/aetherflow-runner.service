[Unit]
Description=AetherFlow Privileged Host Runner (UNIX Socket Helper)
Documentation=https://github.com/McEveritts/AetherFlow
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=root
Group=aetherflow
UMask=0077
WorkingDirectory=/opt/AetherFlow/current

# Creates /run/aetherflow and /var/log/aetherflow owned by root:aetherflow (0750)
RuntimeDirectory=aetherflow
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LogsDirectory=aetherflow
LogsDirectoryMode=0750
LogsDirectoryPreserve=yes

Environment=DATA_DIR=/var/lib/aetherflow
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock
EnvironmentFile=-/opt/AetherFlow/current/backend/.env
EnvironmentFile=-/etc/aetherflow/aetherflow.env

ExecStart=/opt/AetherFlow/current/aetherflow-api runner

KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=on-failure
RestartSec=3s

LimitNOFILE=65535

# Sandboxing: NoNewPrivileges=yes and RestrictSUIDSGID=yes are intentionally
# omitted because marketplace package installers drop privileges via Debian
# sudo 1.9+, which aborts when PR_GET_NO_NEW_PRIVS is set.
PrivateTmp=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
