[Unit]
Description=AetherFlow Control Plane & Embedded UI (Single-Binary)
Documentation=https://github.com/McEveritts/AetherFlow

# ── Boot Race Prevention ─────────────────────────────────────────────────────
After=network-online.target time-sync.target aetherflow-runner.service
Wants=network-online.target aetherflow-runner.service
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=aetherflow
Group=aetherflow
SupplementaryGroups=systemd-journal adm
WorkingDirectory=/opt/AetherFlow/current

# ── FHS Managed Directories ──────────────────────────────────────────────────
# Automatically provisions /var/lib/aetherflow and /var/log/aetherflow owned by
# aetherflow:aetherflow and grants write access inside ProtectSystem=strict.
StateDirectory=aetherflow
StateDirectoryMode=0700
LogsDirectory=aetherflow
LogsDirectoryMode=0750

# ── Execution ────────────────────────────────────────────────────────────────
ExecStart=/opt/AetherFlow/current/aetherflow-api

Environment=GIN_MODE=release
Environment=DATA_DIR=/var/lib/aetherflow
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock
EnvironmentFile=-/etc/aetherflow/aetherflow.env
EnvironmentFile=-/opt/AetherFlow/current/backend/.env

# ── Signal Traps & Graceful Shutdown ─────────────────────────────────────────
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=35s

# ── Restart Policy ───────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── Zero-Trust Namespace Isolation ───────────────────────────────────────────
# Safe to enforce strictly because writable state is limited to the paths below
# and root host operations go through /run/aetherflow/runner.sock.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

ReadWritePaths=/var/lib/aetherflow /var/log/aetherflow /run/aetherflow
# Legacy v3 databases live in /opt/AetherFlow/backend/data. The '-' skips the
# path when that directory was never created.
ReadWritePaths=-/opt/AetherFlow/backend/data -/var/lib/openclaw

# ── Operator Drop-in Overrides ──────────────────────────────────────────────
# Host-specific bind mounts, local media paths, or supplementary groups (such as
# media downloader groups or user storage directories) should not be hard-coded
# in this packaged unit. Instead, configure them in an operator-owned systemd
# drop-in file at /etc/systemd/system/aetherflow-api.service.d/local.conf:
#
#   [Service]
#   SupplementaryGroups=media
#   ReadWritePaths=/mnt/storage
#   BindPaths=/mnt/storage/media:/var/lib/aetherflow/mcbrowser/user-1/Media

# ── Resource Limits ──────────────────────────────────────────────────────────
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
