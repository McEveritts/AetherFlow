[Unit]
Description=AetherFlow Control Plane & Embedded UI (Single-Binary)
Documentation=https://github.com/McEveritts/AetherFlow

# ── Boot Race Prevention ─────────────────────────────────────────────────────
After=network-online.target time-sync.target aetherflow-runner.service
Wants=network-online.target aetherflow-runner.service
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=aetherflow
Group=aetherflow
SupplementaryGroups=systemd-journal adm qbittorrent betheenvy
WorkingDirectory=/opt/AetherFlow/current

# ── FHS Managed Directories ──────────────────────────────────────────────────
# Automatically provisions /var/lib/aetherflow and /var/log/aetherflow owned by
# aetherflow:aetherflow and grants write access inside ProtectSystem=strict.
StateDirectory=aetherflow
StateDirectoryMode=0700
LogsDirectory=aetherflow
LogsDirectoryMode=0750

# ── Execution ────────────────────────────────────────────────────────────────
ExecStart=/opt/AetherFlow/current/aetherflow-api

# Environment injection from hardened FHS path (with legacy fallback).
EnvironmentFile=-/etc/aetherflow/aetherflow.env
EnvironmentFile=-/opt/AetherFlow/current/backend/.env
Environment=GIN_MODE=release
Environment=DB_PATH=/var/lib/aetherflow/aetherflow.sqlite
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock

# ── Signal Traps & Graceful Shutdown ─────────────────────────────────────────
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=35s

# ── Restart Policy ───────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── Zero-Trust Namespace Isolation ───────────────────────────────────────────
# Safe to enforce strictly because writable state is limited to the paths below
# and root host operations go through /run/aetherflow/runner.sock.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

ReadWritePaths=/var/lib/aetherflow /var/log/aetherflow /run/aetherflow
# Legacy v3 databases live in /opt/AetherFlow/backend/data. The '-' skips the
# path when that directory was never created. release-manager.sh does not
# replace a unit that is already installed.
ReadWritePaths=-/opt/AetherFlow/backend/data -/var/lib/openclaw -/home/hdd -/home/betheenvy/.google_root -/home/betheenvy/Google -/home/betheenvy/torrents
BindPaths=-/home/betheenvy/.google_root:/var/lib/aetherflow/mcbrowser/user-1/Google -/home/hdd/torrents:/var/lib/aetherflow/mcbrowser/user-1/Torrents

# ── Resource Limits ──────────────────────────────────────────────────────────
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
