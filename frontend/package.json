{
  "name": "frontend",
  "version": "4.0.0-rc1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --config jest.config.mjs --passWithNoTests --forceExit",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:ci": "jest --config jest.config.mjs --ci --runInBand --coverage --forceExit",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/d3": "^7.4.3",
    "ace-builds": "^1.45.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.43.0",
    "katex": "^0.18.10",
    "lucide-react": "^0.575.0",
    "marked": "^18.2.0",
    "marked-katex-extension": "^5.1.13",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "undici": "^8.12.4"
  }
}
