CLI_PASSWORD=""
CLI_DOMAIN=""
CLI_BOOTSTRAP_SHA256=""

af_die() {
    echo "$1" >&2
    exit 1
}

af_usage() {
    echo ""
    echo "AetherFlow Installer"
    echo "===================="
    echo ""
    echo "Usage: bash AetherFlow-Setup [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --resume               Resume from last successful step (default if state exists)"
    echo "  --repair <step...>     Force re-run specific step(s) by ID"
    echo "  --fresh                Wipe all state and start from scratch"
    echo "  --list-steps           Show all steps and their completion status"
    echo "  --unattended           Skip interactive prompts and use seeded/default values"
    echo "  --channel <name>       Release channel to pull: stable, nightly (default: stable)"
    echo "  --from-source          Explicitly build control plane from source instead of pulling prebuilt v4 release"
    echo "  --sha256 <hex>         Pin expected SHA-256 for offline/airgapped bootstrap archive"
    echo "  --username <name>      Seed the master account username"
    echo "  --password <secret>    Seed the master account password"
    echo "  --domain <hostname>    Seed the installer hostname/domain value"
    echo "  --env-seed <path>      Source a .env.seed file before prompting"
    echo "  --help, -h             Show this help message"
    echo ""
    echo "Examples:"
    echo "  bash AetherFlow-Setup"
    echo "  bash AetherFlow-Setup --channel nightly"
    echo "  bash AetherFlow-Setup --resume"
    echo "  bash AetherFlow-Setup --repair build_modern"
    echo "  bash AetherFlow-Setup --from-source --repair build_modern"
    echo "  bash AetherFlow-Setup --unattended --username admin --password secret --domain aether.local"
    echo "  bash AetherFlow-Setup --env-seed /root/.env.seed --unattended"
    echo ""
}

af_truthy() {
    case "${1,,}" in
        1|true|yes|y|on) return 0 ;;
        *) return 1 ;;
    esac
}

af_normalize_yes_no() {
    local value="${1:-}"
    local default_value="${2:-no}"

    if [[ -z "${value}" ]]; then
        printf '%s' "${default_value}"
        return 0
    fi

    if af_truthy "${value}"; then
        printf '%s' "yes"
        return 0
    fi

    case "${value,,}" in
        0|false|no|n|off) printf '%s' "no" ;;
        *) printf '%s' "${default_value}" ;;
    esac
}

af_first_nonempty() {
    local candidate
    for candidate in "$@"; do
        if [[ -n "${candidate}" ]]; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

af_resolve_seed_path() {
    local candidate="$1"
    local resolved_dir=""

    if [[ -z "${candidate}" ]]; then
        return 1
    fi

    if [[ -f "${candidate}" ]]; then
        resolved_dir="$(cd "$(dirname "${candidate}")" && pwd -P)"
        printf '%s/%s' "${resolved_dir}" "$(basename "${candidate}")"
        return 0
    fi

    if [[ -f "${CALLER_DIR}/${candidate}" ]]; then
        resolved_dir="$(cd "${CALLER_DIR}" && pwd -P)"
        printf '%s/%s' "${resolved_dir}" "${candidate}"
        return 0
    fi

    if [[ -f "${SCRIPT_DIR}/${candidate}" ]]; then
        resolved_dir="$(cd "${SCRIPT_DIR}" && pwd -P)"
        printf '%s/%s' "${resolved_dir}" "${candidate}"
        return 0
    fi

    if [[ -f "$(dirname "${SCRIPT_DIR}")/${candidate}" ]]; then
        resolved_dir="$(cd "$(dirname "${SCRIPT_DIR}")" && pwd -P)"
        printf '%s/%s' "${resolved_dir}" "${candidate}"
        return 0
    fi

    return 1
}

af_find_env_seed() {
    local resolved_seed=""
    local candidate=""

    if [[ -n "${ENV_SEED_FILE}" ]]; then
        resolved_seed="$(af_resolve_seed_path "${ENV_SEED_FILE}")" || af_die "Unable to locate env seed file: ${ENV_SEED_FILE}"
        printf '%s' "${resolved_seed}"
        return 0
    fi

    if [[ -n "${AETHERFLOW_ENV_SEED:-}" ]]; then
        resolved_seed="$(af_resolve_seed_path "${AETHERFLOW_ENV_SEED}")" || af_die "Unable to locate env seed file: ${AETHERFLOW_ENV_SEED}"
        printf '%s' "${resolved_seed}"
        return 0
    fi

    for candidate in \
        "${CALLER_DIR}/.env.seed" \
        "${SCRIPT_DIR}/.env.seed" \
        "$(dirname "${SCRIPT_DIR}")/.env.seed" \
        "/root/.env.seed"
    do
        if resolved_seed="$(af_resolve_seed_path "${candidate}")"; then
            printf '%s' "${resolved_seed}"
            return 0
        fi
    done

    return 1
}

parse_args() {
    local -a translated=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --resume)
                translated+=(-r)
                ;;
            --repair)
                shift
                local -a repair_values=()
                while [[ $# -gt 0 && "$1" != --* && "$1" != -* ]]; do
                    repair_values+=("$1")
                    shift
                done
                [[ ${#repair_values[@]} -gt 0 ]] || af_die "Option --repair requires at least one step ID."
                translated+=(-p "${repair_values[*]}")
                continue
                ;;
            --repair=*)
                translated+=(-p "${1#*=}")
                ;;
            --fresh)
                translated+=(-f)
                ;;
            --list-steps)
                translated+=(-l)
                ;;
            --unattended)
                translated+=(-u)
                ;;
            --from-source)
                translated+=(-S)
                ;;
            --channel)
                [[ $# -ge 2 ]] || af_die "Option --channel requires a value."
                translated+=(-C "$2")
                shift
                ;;
            --channel=*)
                translated+=(-C "${1#*=}")
                ;;
            --username)
                [[ $# -ge 2 ]] || af_die "Option --username requires a value."
                translated+=(-U "$2")
                shift
                ;;
            --username=*)
                translated+=(-U "${1#*=}")
                ;;
            --password)
                [[ $# -ge 2 ]] || af_die "Option --password requires a value."
                translated+=(-P "$2")
                shift
                ;;
            --password=*)
                translated+=(-P "${1#*=}")
                ;;
            --domain)
                [[ $# -ge 2 ]] || af_die "Option --domain requires a value."
                translated+=(-D "$2")
                shift
                ;;
            --domain=*)
                translated+=(-D "${1#*=}")
                ;;
            --env-seed)
                [[ $# -ge 2 ]] || af_die "Option --env-seed requires a value."
                translated+=(-E "$2")
                shift
                ;;
            --env-seed=*)
                translated+=(-E "${1#*=}")
                ;;
            --sha256)
                [[ $# -ge 2 ]] || af_die "Option --sha256 requires a value."
                CLI_BOOTSTRAP_SHA256="$2"
                shift
                ;;
            --sha256=*)
                CLI_BOOTSTRAP_SHA256="${1#*=}"
                ;;
            --help)
                translated+=(-h)
                ;;
            -p|-U|-P|-D|-E|-C)
                [[ $# -ge 2 ]] || af_die "Option $1 requires a value."
                translated+=("$1" "$2")
                shift
                ;;
            -r|-f|-l|-h|-u|-S)
                translated+=("$1")
                ;;
            --)
                shift
                break
                ;;
            -*)
                af_die "Unknown option: $1 (try --help)"
                ;;
            *)
                translated+=("$1")
                ;;
        esac
        shift
    done

    if [[ $# -gt 0 ]]; then
        translated+=("$@")
    fi

    set -- "${translated[@]}"
    OPTIND=1
    while getopts ":rfhlup:U:P:D:E:C:S" opt; do
        case "${opt}" in
            r) RESUME_MODE=true ;;
            p) REPAIR_STEPS="${OPTARG}" ;;
            f) FRESH_INSTALL=true ;;
            l) LIST_ONLY=true ;;
            h)
                af_usage
                exit 0
                ;;
            u) UNATTENDED=true ;;
            S) BUILD_FROM_SOURCE=true ;;
            C) RELEASE_CHANNEL="${OPTARG}" ;;
            U) CLI_USERNAME="${OPTARG}" ;;
            P) CLI_PASSWORD="${OPTARG}" ;;
            D) CLI_DOMAIN="${OPTARG}" ;;
            E) ENV_SEED_FILE="${OPTARG}" ;;
            :)
                af_die "Option -${OPTARG} requires a value."
                ;;
            \?)
                af_die "Unknown option: -${OPTARG} (try --help)"
                ;;
        esac
    done
    shift $((OPTIND - 1))

    [[ $# -eq 0 ]] || af_die "Unknown argument: $1 (try --help)"
}

version_ge() {
    # Returns 0 when $1 >= $2 (version sort aware).
    [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" == "$2" ]]
}

af_detect_default_channel() {
    local repo_root
    repo_root="$(dirname "${SCRIPT_DIR}")"
    if command -v git >/dev/null 2>&1 && [[ -d "${repo_root}/.git" ]]; then
        local branch
        branch="$(git -C "${repo_root}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        case "${branch,,}" in
            experimental)
                printf 'nightly'
                return 0
                ;;
            nightly)
                printf 'nightly'
                return 0
                ;;
        esac
    fi
    if [[ -f "${repo_root}/backend-rs/Cargo.toml" && ! -f "${repo_root}/.force-stable-channel" ]]; then
        local ver_stamp=""
        [[ -f "${repo_root}/.version" ]] && ver_stamp="$(tr -d '[:space:]' < "${repo_root}/.version" 2>/dev/null || true)"
        if [[ "${ver_stamp,,}" == *experimental* ]]; then
            printf 'nightly'
            return 0
        elif [[ "${ver_stamp,,}" == *nightly* ]]; then
            printf 'nightly'
            return 0
        fi
    fi
    printf 'stable'
}

parse_args "$@"
if [[ -n "${CLI_BOOTSTRAP_SHA256}" ]]; then
    export AETHERFLOW_BOOTSTRAP_SHA256="${CLI_BOOTSTRAP_SHA256}"
fi
if af_truthy "${AETHERFLOW_UNATTENDED:-}"; then
    UNATTENDED=true
fi
if af_truthy "${AETHERFLOW_BUILD_FROM_SOURCE:-}"; then
    BUILD_FROM_SOURCE=true
fi
if [[ "${BUILD_FROM_SOURCE}" == "true" ]]; then
    export AETHERFLOW_BUILD_FROM_SOURCE=1
fi
if [[ -z "${RELEASE_CHANNEL}" ]]; then
    RELEASE_CHANNEL="$(af_detect_default_channel)"
fi
case "${RELEASE_CHANNEL}" in
    experimental)
        RELEASE_CHANNEL="nightly"
        export AETHERFLOW_RELEASE_CHANNEL="${RELEASE_CHANNEL}"
        ;;
    stable|nightly)
        export AETHERFLOW_RELEASE_CHANNEL="${RELEASE_CHANNEL}"
        ;;
    *)
        af_die "Unsupported release channel: ${RELEASE_CHANNEL} (expected stable or nightly)"
        ;;
esac

bootstrap_check_supported_os() {
    if [[ ! -r /etc/os-release ]]; then
        echo "Unable to determine operating system (missing /etc/os-release)."
        exit 1
    fi

    # shellcheck disable=1091
    . /etc/os-release
    local distro="${ID:-unknown}"
    local version="${VERSION_ID:-0}"

    case "$distro" in
        ubuntu)
            if ! version_ge "$version" "20.04"; then
                echo "Unsupported Ubuntu version: ${version}. AetherFlow requires Ubuntu 20.04 or newer."
                exit 1
            fi
            ;;
        debian)
            if [[ -z "${VERSION_ID:-}" && ("${VERSION_CODENAME:-}" == "trixie" || "${PRETTY_NAME:-}" =~ [Tt]rixie) ]]; then
                version="13"
            fi
            if ! version_ge "$version" "11"; then
                echo "Unsupported Debian version: ${version}. AetherFlow requires Debian 11 or newer."
                exit 1
            fi
            ;;
        kali)
            # Kali Linux is Debian-based (ID_LIKE=debian). Treat as Debian.
            ;;
        *)
            echo "Unsupported distribution: ${distro}. AetherFlow supports Ubuntu 20.04+, Debian 11+, and Kali Linux."
            exit 1
            ;;
    esac
}

## Auto-Bootstrap if downloaded as a single script via the GitHub one-liner
_verify_bootstrap_sigstore_attestation() {
    local tarball_path="$1"
    local attestation_path="$2"
    local github_repo="$3"
    local expected_sha256="$4"
    local bootstrap_tag="$5"
    local release_channel="$6"

    if [[ ! -s "${tarball_path}" || ! -s "${attestation_path}" || -L "${attestation_path}" ]]; then
        return 1
    fi

    if command -v gh >/dev/null 2>&1 && gh attestation verify --help >/dev/null 2>&1; then
        local -a gh_args=(
            attestation verify "${tarball_path}"
            --bundle "${attestation_path}"
            --repo "${github_repo}"
            --signer-workflow "${github_repo}/.github/workflows/release.yml"
            --deny-self-hosted-runners
        )
        if [[ -n "${bootstrap_tag}" && "${bootstrap_tag}" != *-* ]]; then
            gh_args+=(--source-ref "refs/tags/${bootstrap_tag}")
        fi
        gh "${gh_args[@]}" >/dev/null 2>&1
        return $?
    fi

    python3 - "${attestation_path}" "${github_repo}" "${expected_sha256}" "aetherflow-bootstrap.tar.gz" "${bootstrap_tag}" "${release_channel}" <<'PYEOF'
