REPAIR_STEPS=""
FRESH_INSTALL=false
RESUME_MODE=false
LIST_ONLY=false
UNATTENDED=false
BUILD_FROM_SOURCE=false
RELEASE_CHANNEL="${AETHERFLOW_RELEASE_CHANNEL:-${RELEASE_CHANNEL:-}}"
