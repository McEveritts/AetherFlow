    _save_seed_value release_channel "${seeded_channel}"
    _save_seed_yes_no build_from_source "${seeded_from_source}" "no"
    _save_seed_yes_no kernel "${seeded_kernel}" "yes"
    _save_seed_yes_no is10g "${seeded_10g}" "no"
    _save_seed_yes_no ffmpeg "${seeded_ffmpeg}" "yes"
    _save_seed_yes_no bbr "${seeded_bbr}" "yes"
    _save_seed_yes_no denyhosts "${seeded_denyhosts}" "yes"
    _save_seed_yes_no reboot_after_install "${seeded_reboot}" "no"

    if [[ "${UNATTENDED}" == "true" ]]; then
        _save_config continued "yes"
        [[ -n "${seeded_log_file}" ]] || _save_config OUTTO "/root/AetherFlow.${PPID}.log"
        [[ -n "${seeded_username}" ]] || _save_config username "admin"
        [[ -n "${seeded_10g}" ]] || _save_config is10g "no"
        [[ -n "${seeded_primaryroot}" ]] || _save_config primaryroot "root"
        [[ -n "${seeded_ffmpeg}" ]] || _save_config ffmpeg "yes"
        [[ -n "${seeded_bbr}" ]] || _save_config bbr "yes"
        [[ -n "${seeded_denyhosts}" ]] || _save_config denyhosts "yes"
        [[ -n "${seeded_reboot}" ]] || _save_config reboot_after_install "no"
        [[ -n "${seeded_kernel}" ]] || _save_config kernel "yes"
    fi
}

