# shellcheck disable=2312,2243,1003
spinner() {
	local pid=$1
	local delay=0.1
	local -a spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
	local i=0
	if [[ -t 1 ]]; then
		while kill -0 "${pid}" 2>/dev/null; do
			printf " [${bold}${magenta}%s${normal}]  " "${spinstr[i]}"
			i=$(((i + 1) % 10))
			sleep "${delay}"
			printf "\b\b\b\b\b\b"
		done
		printf "    \b\b\b\b"
	fi
	wait "${pid}"
	local rc=$?
	if [[ ${rc} -eq 0 ]]; then
		echo -ne "${OK}"
	fi
	return ${rc}
}

port_is_listening() {
    local port="$1"
    netstat -ln 2>/dev/null | awk -v port=":${port}" '$0 ~ port && $0 ~ /LISTEN/ { found=1; exit } END { exit(found ? 0 : 1) }'
}

