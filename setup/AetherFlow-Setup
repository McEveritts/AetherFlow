class ProvenanceVerificationError(Exception):
    pass


def _wrap_pem(label: str, raw_b64: str) -> str:
    der = base64.b64decode(raw_b64)
    encoded = base64.encodebytes(der).decode("ascii")
    return f"-----BEGIN {label}-----\n{encoded}-----END {label}-----\n"


def _extract_bundles(data: object) -> list[dict]:
    if not isinstance(data, dict):
        raise ProvenanceVerificationError("attestation payload must be a JSON object")
    if isinstance(data.get("attestations"), list):
        return [item["bundle"] for item in data["attestations"] if isinstance(item, dict) and isinstance(item.get("bundle"), dict)]
    if isinstance(data.get("bundle"), dict):
        return [data["bundle"]]
    if isinstance(data.get("verificationMaterial"), dict) and isinstance(data.get("dsseEnvelope"), dict):
        return [data]
    return []


def _load_bundles_from_file(path: Path) -> list[dict]:
    raw = path.read_bytes()
    if len(raw) > 16 * 1024 * 1024:
        raise ProvenanceVerificationError("attestation bundle exceeds 16 MiB limit")
    text = raw.decode("utf-8")
    try:
        return _extract_bundles(json.loads(text))
    except json.JSONDecodeError:
        bundles: list[dict] = []
        for idx, line in enumerate(text.splitlines(), 1):
            stripped = line.strip()
            if not stripped:
                continue
            try:
                bundles.extend(_extract_bundles(json.loads(stripped)))
            except Exception as exc:
                raise ProvenanceVerificationError(f"invalid JSONL bundle at line {idx}: {exc}") from exc
        return bundles


def _parse_openssl_asn1_time(raw: str) -> int:
    cleaned = re.sub(r"(\d{2}:\d{2}:\d{2})\.\d+", r"\1", raw.strip())
    parsed = email.utils.parsedate_tz(cleaned)
    if parsed is not None:
        return int(email.utils.mktime_tz(parsed))
    dt = time.strptime(cleaned, "%b %d %H:%M:%S %Y %Z")
    return int(calendar.timegm(dt))


def _read_der_length(buf: bytes, idx: int) -> tuple[int, int]:
    if idx >= len(buf):
        raise ProvenanceVerificationError("truncated ASN.1 DER length")
    first = buf[idx]
    idx += 1
    if (first & 0x80) == 0:
        return first, idx
    num_octets = first & 0x7F
    if num_octets == 0 or num_octets > 4 or idx + num_octets > len(buf):
        raise ProvenanceVerificationError("invalid ASN.1 DER long-form length")
    return int.from_bytes(buf[idx : idx + num_octets], "big"), idx + num_octets


def _extract_fulcio_runner_environment(leaf_der: bytes) -> str | None:
    pos = 0
    while True:
        found = leaf_der.find(FULCIO_RUNNER_ENV_OID_DER, pos)
        if found == -1:
            return None
        cursor = found + len(FULCIO_RUNNER_ENV_OID_DER)
        pos = found + 1
        try:
            if cursor + 3 <= len(leaf_der) and leaf_der[cursor] == 0x01 and leaf_der[cursor + 1] == 0x01:
                cursor += 3
            if cursor >= len(leaf_der) or leaf_der[cursor] != 0x04:
                continue
            octet_len, cursor = _read_der_length(leaf_der, cursor + 1)
            if cursor + octet_len > len(leaf_der):
                continue
            ext_val = leaf_der[cursor : cursor + octet_len]
            if ext_val and ext_val[0] in (0x0C, 0x16):
                str_len, inner = _read_der_length(ext_val, 1)
                if inner + str_len == len(ext_val):
                    return ext_val[inner : inner + str_len].decode("utf-8", errors="strict")
            return ext_val.decode("utf-8", errors="strict")
        except Exception:
            continue


def _verify_signature_with_openssl(td: Path, pub_pem: str, key_details: str, message: bytes, signature: bytes, tag: str) -> None:
    pub_path = td / f"{tag}-pub.pem"
    msg_path = td / f"{tag}-msg.bin"
    sig_path = td / f"{tag}-sig.bin"
    pub_path.write_text(pub_pem, encoding="utf-8")
    msg_path.write_bytes(message)
    sig_path.write_bytes(signature)
    if key_details == "PKIX_ED25519":
        cmd = ["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(pub_path), "-rawin", "-in", str(msg_path), "-sigfile", str(sig_path)]
    else:
        cmd = ["openssl", "dgst", "-sha256", "-verify", str(pub_path), "-signature", str(sig_path), str(msg_path)]
    res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    if res.returncode != 0:
        raise ProvenanceVerificationError(f"OpenSSL signature verification failed ({tag}): {res.stderr.strip() or res.stdout.strip()}")


def _verify_rfc3161_timestamps(td: Path, vm: dict, raw_dsse_sig: bytes) -> list[int]:
    ts_data = vm.get("timestampVerificationData")
    if not isinstance(ts_data, dict):
        return []
    rfc_list = ts_data.get("rfc3161Timestamps")
    if not isinstance(rfc_list, list) or not rfc_list:
        return []
    tsa_roots_path = td / "tsa-roots.pem"
    tsa_leaves_path = td / "tsa-leaves.pem"
    sig_data_path = td / "dsse-raw-sig.bin"
    tsa_roots_path.write_text("".join(_wrap_pem("CERTIFICATE", c) for c in SIGSTORE_TSA_ROOTS_B64), encoding="utf-8")
    tsa_leaves_path.write_text("".join(_wrap_pem("CERTIFICATE", c) for c in SIGSTORE_TSA_LEAVES_B64), encoding="utf-8")
    sig_data_path.write_bytes(raw_dsse_sig)
    verified_times: list[int] = []
    for idx, entry in enumerate(rfc_list):
        if not isinstance(entry, dict) or not isinstance(entry.get("signedTimestamp"), str):
            raise ProvenanceVerificationError(f"malformed rfc3161Timestamps[{idx}]")
        ts_path = td / f"rfc3161-{idx}.der"
        ts_path.write_bytes(base64.b64decode(entry["signedTimestamp"]))
        matched_mode: list[str] | None = None
        last_err = ""
        for token_flags in ([], ["-token_in"]):
            v_res = subprocess.run(
                ["openssl", "ts", "-verify", "-data", str(sig_data_path), "-in", str(ts_path), *token_flags, "-CAfile", str(tsa_roots_path), "-untrusted", str(tsa_leaves_path)],
                capture_output=True, text=True, timeout=15,
            )
            if v_res.returncode == 0 and "Verification: OK" in (v_res.stdout + v_res.stderr):
                matched_mode = token_flags
                break
            last_err = (v_res.stderr or v_res.stdout).strip()
        if matched_mode is None:
            raise ProvenanceVerificationError(f"RFC 3161 TSA verification failed: {last_err}")
        r_res = subprocess.run(["openssl", "ts", "-reply", "-in", str(ts_path), *matched_mode, "-text"], capture_output=True, text=True, timeout=10)
        if r_res.returncode != 0:
            raise ProvenanceVerificationError(f"failed to inspect RFC 3161 timestamp: {r_res.stderr.strip()}")
        ts_epoch = None
        for line in r_res.stdout.splitlines():
            if line.strip().startswith("Time stamp:"):
                ts_epoch = _parse_openssl_asn1_time(line.strip().split(":", 1)[1])
                break
        if ts_epoch is None or ts_epoch <= 0:
            raise ProvenanceVerificationError("RFC 3161 timestamp missing valid generation time")
        verified_times.append(ts_epoch)
    return verified_times


def _verify_merkle_inclusion(leaf_hash: bytes, log_index: int, tree_size: int, hashes_b64: list[str], expected_root: bytes) -> None:
    if log_index < 0 or tree_size <= 0 or log_index >= tree_size:
        raise ProvenanceVerificationError("invalid Rekor Merkle tree bounds")
    fn, sn, acc = log_index, tree_size - 1, leaf_hash
    for h_b64 in hashes_b64:
        sibling = base64.b64decode(h_b64)
        if len(sibling) != 32 or sn == 0:
            raise ProvenanceVerificationError("invalid Rekor Merkle proof")
        if (fn & 1) == 1 or fn == sn:
            acc = hashlib.sha256(b"\x01" + sibling + acc).digest()
            while (fn & 1) == 0 and fn != 0:
                fn >>= 1
                sn >>= 1
        else:
            acc = hashlib.sha256(b"\x01" + acc + sibling).digest()
        fn >>= 1
        sn >>= 1
    if sn != 0 or acc != expected_root:
        raise ProvenanceVerificationError("Rekor Merkle inclusion root hash mismatch")


def _extract_der_from_verifier(verifier: object) -> bytes:
    if isinstance(verifier, dict):
        for key in ("x509Certificate", "publicKey"):
            obj = verifier.get(key)
            if isinstance(obj, dict) and isinstance(obj.get("rawBytes"), str):
                return _extract_der_from_verifier(obj["rawBytes"])
        if isinstance(verifier.get("content"), str):
            return _extract_der_from_verifier(verifier["content"])
        raise ProvenanceVerificationError("unsupported Rekor verifier format")
    if not isinstance(verifier, str):
        raise ProvenanceVerificationError("Rekor verifier must be string or object")
    decoded = base64.b64decode(verifier)
    try:
        text = decoded.decode("ascii")
        if "-----BEGIN " in text:
            return base64.b64decode("".join(ln.strip() for ln in text.splitlines() if ln.strip() and not ln.strip().startswith("-----")))
    except UnicodeDecodeError:
        pass
    return decoded


def _normalize_hash_digest_hex(hash_obj: dict) -> tuple[str, str]:
    alg_raw = str(hash_obj.get("algorithm", "")).strip()
    alg = "sha256" if alg_raw.upper() in ("SHA2_256", "SHA256", "SHA-256", "1") else alg_raw.lower()
    for field in ("value", "digest"):
        raw = hash_obj.get(field)
        if isinstance(raw, str) and raw:
            val = raw.strip()
            if SAFE_HEX64_RE.fullmatch(val):
                return alg, val.lower()
            return alg, base64.b64decode(val).hex()
    return alg, ""


def _verify_rekor_tlog_entry(td: Path, tlog: dict, expected_payload_sha256: str, expected_dsse_sig_b64: str, expected_leaf_der: bytes, verified_tsa_times: list[int]) -> list[int]:
    log_id_obj = tlog.get("logId")
    if not isinstance(log_id_obj, dict) or not isinstance(log_id_obj.get("keyId"), str):
        raise ProvenanceVerificationError("missing Rekor logId.keyId")
    key_id = log_id_obj["keyId"]
    if key_id not in SIGSTORE_REKOR_KEYS:
        raise ProvenanceVerificationError(f"untrusted Rekor keyId: {key_id}")
    spki_b64, key_details, expected_origin = SIGSTORE_REKOR_KEYS[key_id]
    spki_der = base64.b64decode(spki_b64)
    rekor_pub_pem = _wrap_pem("PUBLIC KEY", spki_b64)
    key_id_bytes = base64.b64decode(key_id)
    integrated_time = int(tlog.get("integratedTime", 0) or 0)
    log_index = int(tlog["logIndex"])
    if integrated_time < 0 or log_index < 0:
        raise ProvenanceVerificationError("out-of-range Rekor integratedTime/logIndex")
    canon_b64 = tlog.get("canonicalizedBody")
    if not isinstance(canon_b64, str) or not canon_b64:
        raise ProvenanceVerificationError("missing Rekor canonicalizedBody")
    canon_bytes = base64.b64decode(canon_b64)
    canon_obj = json.loads(canon_bytes.decode("utf-8"))
    api_version = str(canon_obj.get("apiVersion", "")).strip()
    kv = tlog.get("kindVersion")
    kv_version = str(kv.get("version", "")).strip() if isinstance(kv, dict) else ""
    spec = canon_obj.get("spec")
    if not isinstance(spec, dict):
        raise ProvenanceVerificationError("missing spec in Rekor canonicalizedBody")
    inner_v2 = spec.get("dsseV002") or spec.get("intotoV002")
    active_spec = inner_v2 if isinstance(inner_v2, dict) else spec
    is_v2_entry = api_version == "0.0.2" or kv_version == "0.0.2" or isinstance(inner_v2, dict)
    payload_hash_obj = active_spec.get("payloadHash")
    if not isinstance(payload_hash_obj, dict) and isinstance(active_spec.get("data"), dict):
        payload_hash_obj = active_spec["data"].get("hash") or active_spec["data"]
    if not isinstance(payload_hash_obj, dict):
        raise ProvenanceVerificationError("Rekor entry lacks payloadHash")
    alg, digest_hex = _normalize_hash_digest_hex(payload_hash_obj)
    if alg != "sha256" or digest_hex != expected_payload_sha256:
        raise ProvenanceVerificationError("Rekor payloadHash mismatch")
    rekor_sigs = active_spec.get("signatures")
    if not isinstance(rekor_sigs, list) or not rekor_sigs:
        raise ProvenanceVerificationError("Rekor entry lacks signatures")
    expected_sig_raw = base64.b64decode(expected_dsse_sig_b64)
    matched = False
    for item in rekor_sigs:
        if not isinstance(item, dict):
            continue
        cand = item.get("signature") or item.get("sig") or item.get("content")
        ver = item.get("verifier") or item.get("publicKey")
        if not isinstance(cand, str) or ver is None:
            continue
        try:
            cand_raw = base64.b64decode(cand)
            if (cand_raw == expected_sig_raw or cand_raw == expected_dsse_sig_b64.encode("ascii")) and _extract_der_from_verifier(ver) == expected_leaf_der:
                matched = True
                break
        except Exception:
            continue
    if not matched:
        raise ProvenanceVerificationError("Rekor entry signature/verifier mismatch")
    proof = tlog.get("inclusionProof")
    if not isinstance(proof, dict) or not isinstance(proof.get("checkpoint"), dict):
        raise ProvenanceVerificationError("Rekor tlogEntry missing inclusionProof")
    envelope = proof["checkpoint"].get("envelope")
    hashes = proof.get("hashes")
    root_hash_b64 = proof.get("rootHash")
    if not isinstance(envelope, str) or "\n\n" not in envelope or not isinstance(hashes, list) or not isinstance(root_hash_b64, str):
        raise ProvenanceVerificationError("malformed Rekor inclusionProof")
    proof_index = int(proof.get("logIndex", -1))
    tree_size = int(proof.get("treeSize", -1))
    if proof_index < 0 or proof_index > log_index:
        raise ProvenanceVerificationError("Rekor inclusionProof logIndex invalid")
    expected_root = base64.b64decode(root_hash_b64)
    _verify_merkle_inclusion(hashlib.sha256(b"\x00" + canon_bytes).digest(), proof_index, tree_size, hashes, expected_root)
    note_body, sig_section = envelope.split("\n\n", 1)
    note_lines = note_body.splitlines()
    if len(note_lines) < 3:
        raise ProvenanceVerificationError("Rekor checkpoint note invalid")
    note_origin = note_lines[0].strip()
    if expected_origin and not (note_origin == expected_origin or note_origin.startswith(expected_origin + " - ")):
        raise ProvenanceVerificationError("Rekor checkpoint origin mismatch")
    if int(note_lines[1].strip()) != tree_size or base64.b64decode(note_lines[2].strip()) != expected_root:
        raise ProvenanceVerificationError("Rekor checkpoint root/size mismatch")
    allowed_hints = {key_id_bytes[:4], hashlib.sha256(spki_der).digest()[:4]}
    if key_details == "PKIX_ED25519" and len(spki_der) >= 32:
        allowed_hints.add(hashlib.sha256(note_origin.encode("utf-8") + b"\n\x01" + spki_der[-32:]).digest()[:4])
    ckpt_ok = False
    for line in sig_section.splitlines():
        parts = line.strip().split()
        if len(parts) < 3 or (expected_origin and parts[1].strip() != expected_origin):
            continue
        try:
            hint_and_sig = base64.b64decode(parts[-1])
        except Exception:
            continue
        if len(hint_and_sig) <= 4 or hint_and_sig[:4] not in allowed_hints:
            continue
        _verify_signature_with_openssl(td, rekor_pub_pem, key_details, (note_body + "\n").encode("utf-8"), hint_and_sig[4:], "rekor-ckpt")
        ckpt_ok = True
        break
    if not ckpt_ok:
        raise ProvenanceVerificationError("no valid Rekor checkpoint signature")
    authenticated_times: list[int] = list(verified_tsa_times)
    promise = tlog.get("inclusionPromise")
    if isinstance(promise, dict) and isinstance(promise.get("signedEntryTimestamp"), str):
        if integrated_time <= 0:
            raise ProvenanceVerificationError("non-positive integratedTime with SET")
        set_payload = json.dumps({"body": canon_b64, "integratedTime": integrated_time, "logID": hashlib.sha256(spki_der).hexdigest(), "logIndex": log_index}, separators=(",", ":"), sort_keys=True).encode("utf-8")
        _verify_signature_with_openssl(td, rekor_pub_pem, key_details, set_payload, base64.b64decode(promise["signedEntryTimestamp"]), "rekor-set")
        authenticated_times.append(integrated_time)
    elif not is_v2_entry:
        raise ProvenanceVerificationError("Rekor v1 tlogEntry missing SET")
    if not authenticated_times:
        raise ProvenanceVerificationError("Rekor tlogEntry lacks authenticated timestamp")
    return authenticated_times


def _validate_workflow_ref_policy(san_ref: str, slsa_ref: str, expected_tag: str | None, expected_channel: str | None) -> None:
    if not san_ref or not PROTECTED_WORKFLOW_REF_RE.fullmatch(san_ref):
        raise ProvenanceVerificationError(f"Fulcio SAN ref {san_ref!r} is not a protected nightly branch or v4+ release tag")
    if not slsa_ref or slsa_ref != san_ref:
        raise ProvenanceVerificationError(f"SLSA workflow.ref {slsa_ref!r} != Fulcio SAN ref {san_ref!r}")
    norm_channel = expected_channel.strip().lower() if expected_channel else None
    if norm_channel == "experimental":
        norm_channel = "nightly"
    if expected_tag:
        tag = expected_tag.strip()
        if not V4_RELEASE_TAG_RE.fullmatch(tag):
            raise ProvenanceVerificationError(f"invalid v4+ release tag {tag!r}")
        is_prerelease = "-" in tag
        if norm_channel == "stable" and is_prerelease:
            raise ProvenanceVerificationError("stable channel cannot verify prerelease tag")
        if norm_channel == "nightly" and not is_prerelease:
            raise ProvenanceVerificationError("nightly channel requires prerelease tag")
        if not is_prerelease:
            if san_ref != f"refs/tags/{tag}":
                raise ProvenanceVerificationError(f"stable release {tag!r} requires refs/tags/{tag}, got {san_ref!r}")
        elif "-nightly." in tag.lower() or norm_channel == "nightly":
            if san_ref not in {"refs/heads/nightly", "refs/heads/Nightly", f"refs/tags/{tag}"}:
                raise ProvenanceVerificationError(f"nightly release {tag!r} got unexpected ref {san_ref!r}")
        elif san_ref != f"refs/tags/{tag}":
            raise ProvenanceVerificationError(f"prerelease {tag!r} got unexpected ref {san_ref!r}")
    elif norm_channel == "stable":
        if not san_ref.startswith("refs/tags/v") or "-" in san_ref[len("refs/tags/"):]:
            raise ProvenanceVerificationError(f"stable channel requires non-prerelease tag ref, got {san_ref!r}")
    elif norm_channel == "nightly":
        if san_ref not in ("refs/heads/nightly", "refs/heads/Nightly") and "-nightly." not in san_ref.lower():
            raise ProvenanceVerificationError(f"nightly channel requires nightly ref, got {san_ref!r}")


def verify_single_bundle(bundle: dict, repo: str, expected_digest: str, artifact_name: str, expected_tag: str | None, expected_channel: str | None) -> None:
    vm = bundle.get("verificationMaterial")
    dsse = bundle.get("dsseEnvelope")
    if not isinstance(vm, dict) or not isinstance(dsse, dict):
        raise ProvenanceVerificationError("bundle missing verificationMaterial or dsseEnvelope")
    if dsse.get("payloadType") != "application/vnd.in-toto+json":
        raise ProvenanceVerificationError("unexpected DSSE payloadType")
    payload_b64 = dsse.get("payload")
    sigs = dsse.get("signatures")
    if not isinstance(payload_b64, str) or not isinstance(sigs, list) or not sigs:
        raise ProvenanceVerificationError("missing DSSE payload or signatures")
    candidate_sigs = [(e["sig"], base64.b64decode(e["sig"])) for e in sigs if isinstance(e, dict) and isinstance(e.get("sig"), str) and e["sig"]]
    if not candidate_sigs:
        raise ProvenanceVerificationError("missing DSSE signature bytes")
    raw_payload = base64.b64decode(payload_b64)
    payload_sha256 = hashlib.sha256(raw_payload).hexdigest()
    extra_inters_b64: list[str] = []
    if isinstance(vm.get("certificate"), dict) and isinstance(vm["certificate"].get("rawBytes"), str):
        leaf_b64 = vm["certificate"]["rawBytes"]
    elif isinstance(vm.get("x509CertificateChain"), dict) and isinstance(vm["x509CertificateChain"].get("certificates"), list) and vm["x509CertificateChain"]["certificates"]:
        certs = vm["x509CertificateChain"]["certificates"]
        leaf_b64 = certs[0]["rawBytes"]
        extra_inters_b64 = [c["rawBytes"] for c in certs[1:] if isinstance(c, dict) and isinstance(c.get("rawBytes"), str)]
    else:
        raise ProvenanceVerificationError("bundle missing X.509 signing certificate")
    tlog_entries = vm.get("tlogEntries")
    if not isinstance(tlog_entries, list) or not tlog_entries:
        raise ProvenanceVerificationError("bundle missing Rekor tlogEntries")
    with tempfile.TemporaryDirectory(prefix="af-bs-prov-") as tmp:
        td = Path(tmp)
        leaf_der = base64.b64decode(leaf_b64)
        verified_candidates: list[tuple[bytes, list[int]]] = []
        last_err: Exception | None = None
        for sig_b64, raw_sig in candidate_sigs:
            try:
                tsa_times = _verify_rfc3161_timestamps(td, vm, raw_sig)
            except Exception as exc:
                last_err = exc
                continue
            for entry in tlog_entries:
                if not isinstance(entry, dict):
                    continue
                try:
                    times = _verify_rekor_tlog_entry(td, entry, payload_sha256, sig_b64, leaf_der, tsa_times)
                    if times:
                        verified_candidates.append((raw_sig, times))
                        break
                except Exception as exc:
                    last_err = exc
        if not verified_candidates:
            raise ProvenanceVerificationError(f"no valid Rekor entry: {last_err}")
        roots_path = td / "roots.pem"
        inters_path = td / "inters.pem"
        leaf_path = td / "leaf.pem"
        roots_path.write_text("".join(_wrap_pem("CERTIFICATE", c) for c in SIGSTORE_FULCIO_ROOTS_B64), encoding="utf-8")
        inters_pem = "".join(_wrap_pem("CERTIFICATE", c) for c in (*SIGSTORE_FULCIO_INTERMEDIATES_B64, *extra_inters_b64))
        inters_path.write_text(inters_pem, encoding="utf-8")
        leaf_path.write_text(_wrap_pem("CERTIFICATE", leaf_b64), encoding="utf-8")
        dates_res = subprocess.run(["openssl", "x509", "-in", str(leaf_path), "-noout", "-dates"], capture_output=True, text=True, timeout=10)
        if dates_res.returncode != 0:
            raise ProvenanceVerificationError("failed to parse leaf certificate dates")
        not_before = not_after = None
        for line in dates_res.stdout.splitlines():
            if line.startswith("notBefore="):
                not_before = _parse_openssl_asn1_time(line.split("=", 1)[1])
            elif line.startswith("notAfter="):
                not_after = _parse_openssl_asn1_time(line.split("=", 1)[1])
        if not_before is None or not_after is None:
            raise ProvenanceVerificationError("leaf certificate missing validity bounds")
        text_res = subprocess.run(["openssl", "x509", "-in", str(leaf_path), "-noout", "-text"], capture_output=True, text=True, timeout=10)
        if text_res.returncode != 0:
            raise ProvenanceVerificationError("failed to inspect leaf certificate")
        cert_text = text_res.stdout
        eku_m = re.search(r"X509v3 Extended Key Usage:\s*(?:critical\s*)?\n\s*([^\n]+)", cert_text)
        if not eku_m or "Code Signing" not in eku_m.group(1):
            raise ProvenanceVerificationError("leaf certificate missing Code Signing EKU")
        san_m = re.search(r"X509v3 Subject Alternative Name:\s*(?:critical\s*)?\n\s*([^\n]+)", cert_text)
        if not san_m:
            raise ProvenanceVerificationError("leaf certificate missing SAN")
        expected_uri_prefix = f"uri:https://github.com/{repo.lower()}/.github/workflows/release.yml@"
        matched_san = next((tok.strip()[4:] for tok in san_m.group(1).split(",") if tok.strip().lower().startswith(expected_uri_prefix)), None)
        if not matched_san:
            raise ProvenanceVerificationError(f"leaf SAN does not match {repo}/.github/workflows/release.yml")
        san_ref = matched_san.split("@", 1)[1] if "@" in matched_san else ""
        issuer_m = re.search(r"1\.3\.6\.1\.4\.1\.57264\.1\.(?:1|8):\s*(?:critical\s*)?\n\s*([^\n]+)", cert_text)
        if not issuer_m or "https://token.actions.githubusercontent.com" not in issuer_m.group(1):
            raise ProvenanceVerificationError("leaf certificate missing GitHub Actions OIDC issuer")
        if _extract_fulcio_runner_environment(leaf_der) != "github-hosted":
            raise ProvenanceVerificationError("leaf certificate runner_environment is not 'github-hosted'")
        pub_res = subprocess.run(["openssl", "x509", "-in", str(leaf_path), "-pubkey", "-noout"], capture_output=True, text=True, timeout=10)
        if pub_res.returncode != 0 or "BEGIN PUBLIC KEY" not in pub_res.stdout:
            raise ProvenanceVerificationError("failed to extract leaf public key")
        pt_bytes = b"application/vnd.in-toto+json"
        pae = f"DSSEv1 {len(pt_bytes)} ".encode("ascii") + pt_bytes + f" {len(raw_payload)} ".encode("ascii") + raw_payload
        bound_ok = False
        last_bound_err: Exception | None = None
        for raw_sig, times in verified_candidates:
            try:
                _verify_signature_with_openssl(td, pub_res.stdout, "PKIX_ECDSA_P256_SHA_256", pae, raw_sig, "dsse-pae")
                for auth_time in times:
                    if not (not_before <= auth_time <= not_after):
                        raise ProvenanceVerificationError("timestamp outside leaf cert validity window")
                    chain_cmd = ["openssl", "verify", "-attime", str(auth_time), "-CAfile", str(roots_path)]
                    if inters_pem.strip():
                        chain_cmd.extend(["-untrusted", str(inters_path)])
                    chain_cmd.append(str(leaf_path))
                    chain_res = subprocess.run(chain_cmd, capture_output=True, text=True, timeout=15)
                    if chain_res.returncode != 0:
                        raise ProvenanceVerificationError(f"Fulcio chain verification failed: {chain_res.stderr.strip() or chain_res.stdout.strip()}")
                bound_ok = True
                break
            except Exception as exc:
                last_bound_err = exc
        if not bound_ok:
            raise last_bound_err or ProvenanceVerificationError("DSSE verification failed")
    statement = json.loads(raw_payload.decode("utf-8"))
    if statement.get("_type") != "https://in-toto.io/Statement/v1" or statement.get("predicateType") != "https://slsa.dev/provenance/v1":
        raise ProvenanceVerificationError("unexpected in-toto/SLSA statement type")
    subjects = statement.get("subject")
    if not isinstance(subjects, list) or not subjects:
        raise ProvenanceVerificationError("in-toto statement contains no subjects")
    expected_name = PurePosixPath(artifact_name).name
    if not any(
        isinstance(s, dict)
        and isinstance(s.get("digest"), dict)
        and str(s["digest"].get("sha256", "")).lower() == expected_digest
        and PurePosixPath(str(s.get("name", ""))).name == expected_name
        for s in subjects
    ):
        raise ProvenanceVerificationError(f"in-toto subject mismatch for {expected_name}@sha256:{expected_digest}")
    workflow = ((statement.get("predicate") or {}).get("buildDefinition") or {}).get("externalParameters", {}).get("workflow")
    if not isinstance(workflow, dict):
        raise ProvenanceVerificationError("missing SLSA externalParameters.workflow")
    if str(workflow.get("repository", "")).rstrip("/").lower() != f"https://github.com/{repo.lower()}":
        raise ProvenanceVerificationError("SLSA workflow repository mismatch")
    wf_path = str(workflow.get("path", "")).strip()
    if not (wf_path == ".github/workflows/release.yml" or wf_path.endswith("/.github/workflows/release.yml")):
        raise ProvenanceVerificationError("SLSA workflow path mismatch")
    _validate_workflow_ref_policy(san_ref, str(workflow.get("ref", "")).strip(), expected_tag, expected_channel)


attest_path = Path(sys.argv[1])
repo = sys.argv[2].strip()
expected_digest = sys.argv[3].strip().lower()
artifact_name = sys.argv[4].strip()
expected_tag = sys.argv[5].strip() or None
expected_channel = sys.argv[6].strip() or None
if not SAFE_REPO_RE.fullmatch(repo):
    raise SystemExit(f"invalid repository: {repo!r}")
if not SAFE_HEX64_RE.fullmatch(expected_digest):
    raise SystemExit(f"invalid sha256: {expected_digest!r}")
bundles = _load_bundles_from_file(attest_path)
if not bundles:
    raise SystemExit("no Sigstore attestation bundles found")
errors: list[str] = []
for idx, bundle in enumerate(bundles):
    try:
        verify_single_bundle(bundle, repo, expected_digest, artifact_name, expected_tag, expected_channel)
        sys.exit(0)
    except Exception as exc:
        errors.append(f"bundle[{idx}]: {exc}")
raise SystemExit("; ".join(errors))
PYEOF
}

_bootstrap_standalone_checkout() {
    echo "Bootstrapping AetherFlow Installer Environment..."
    bootstrap_check_supported_os
    local bootstrap_env_seed
    if bootstrap_env_seed="$(af_find_env_seed)"; then
        export AETHERFLOW_ENV_SEED="${bootstrap_env_seed}"
        UNATTENDED=true
    fi
    if [[ "${UNATTENDED}" == "true" ]]; then
        export AETHERFLOW_UNATTENDED=true
    fi
    export DEBIAN_FRONTEND=noninteractive
    local default_bootstrap_ref="nightly"
    case "${RELEASE_CHANNEL}" in
        experimental) default_bootstrap_ref="nightly" ;;
        nightly) default_bootstrap_ref="nightly" ;;
        stable) default_bootstrap_ref="${AETHERFLOW_STABLE_BOOTSTRAP_REF:-master}" ;;
    esac
    local github_repo="${AETHERFLOW_GITHUB_REPO:-${GITHUB_REPO:-McEveritts/AetherFlow}}"
    if [[ ! "${github_repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
        af_die "Invalid AETHERFLOW_GITHUB_REPO '${github_repo}'. Existing /opt/AetherFlow preserved."
    fi
    local BOOTSTRAP_REF="${AETHERFLOW_BOOTSTRAP_REF:-${default_bootstrap_ref}}"
    local BOOTSTRAP_URL="${AETHERFLOW_BOOTSTRAP_URL:-}"
    local bootstrap_tmp_root="${AETHERFLOW_BOOTSTRAP_TMPDIR:-/tmp}"
    local target_opt_root="${AETHERFLOW_BOOTSTRAP_INSTALL_ROOT:-/opt/AetherFlow}"
    local target_opt_parent
    target_opt_parent="$(dirname "${target_opt_root}")"

    bootstrap_tmp="$(mktemp -d "${bootstrap_tmp_root%/}/aetherflow-bootstrap.XXXXXXXXXX")"
    chmod 0700 "${bootstrap_tmp}"
    bootstrap_stage=""
    trap 'rm -rf "${bootstrap_tmp:-}" "${bootstrap_stage:-}"' EXIT
    local BOOTSTRAP_TARBALL="${bootstrap_tmp}/aetherflow-bootstrap.tar.gz"
    local bootstrap_extract="${bootstrap_tmp}/src"
    mkdir -p "${bootstrap_extract}"

    apt-get update -y >/dev/null 2>&1
    apt-get install -y git bc curl ca-certificates sqlite3 python3 openssl >/dev/null 2>&1

    local bootstrap_source=""
    local expected_bootstrap_sha="${AETHERFLOW_BOOTSTRAP_SHA256:-}"
    expected_bootstrap_sha="${expected_bootstrap_sha,,}"
    local explicit_sha256_pin=0
    if [[ -n "${expected_bootstrap_sha}" ]]; then
        explicit_sha256_pin=1
        if [[ ! "${expected_bootstrap_sha}" =~ ^[0-9a-f]{64}$ ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Invalid --sha256 / AETHERFLOW_BOOTSTRAP_SHA256 pin '${expected_bootstrap_sha}'. Existing /opt/AetherFlow preserved."
        fi
    fi

    local bootstrap_tag="${AETHERFLOW_BOOTSTRAP_TAG:-${AETHERFLOW_RELEASE_TAG:-}}"
    local resolved_attestation_url=""
    local resolved_sha256sums_url=""

    if [[ -z "${BOOTSTRAP_URL}" ]]; then
        local release_meta_url
        if [[ "${RELEASE_CHANNEL}" == "stable" ]]; then
            release_meta_url="https://api.github.com/repos/${github_repo}/releases/latest"
        else
            release_meta_url="https://api.github.com/repos/${github_repo}/releases?per_page=10"
        fi
        local release_meta_json="${bootstrap_tmp}/releases.json"
        if curl -fsSL --retry 3 -H "Accept: application/vnd.github+json" \
            --output "${release_meta_json}" "${release_meta_url}" >/dev/null 2>&1 && [[ -s "${release_meta_json}" ]]; then
            local resolved_line=""
            resolved_line="$(python3 - "${release_meta_json}" "${RELEASE_CHANNEL}" "${explicit_sha256_pin}" <<'PYEOF' 2>/dev/null || true
import json, sys
data = json.load(open(sys.argv[1], "r", encoding="utf-8"))
channel = sys.argv[2]
allow_unattested = sys.argv[3] == "1"
releases = [data] if isinstance(data, dict) else (data if isinstance(data, list) else [])
for rel in releases:
    if not isinstance(rel, dict) or rel.get("draft"):
        continue
    if channel == "stable" and rel.get("prerelease"):
        continue
    assets = {a.get("name"): a.get("browser_download_url") for a in (rel.get("assets") or []) if isinstance(a, dict)}
    tar_url = assets.get("aetherflow-bootstrap.tar.gz") or ""
    sums_url = assets.get("SHA256SUMS") or ""
    attest_url = (
        assets.get("aetherflow-bootstrap.tar.gz.attestation.jsonl")
        or assets.get("aetherflow-bootstrap.tar.gz.sigstore.json")
        or ""
    )
    if tar_url and sums_url and (allow_unattested or attest_url):
        tag_name = str(rel.get("tag_name") or "").strip()
        print(f"{tar_url}\t{tag_name}\t{attest_url}\t{sums_url}")
        break
PYEOF
)"
            if [[ -n "${resolved_line}" ]]; then
                IFS=$'\t' read -r BOOTSTRAP_URL bootstrap_tag resolved_attestation_url resolved_sha256sums_url <<< "${resolved_line}"
            fi
        fi
    fi

    if [[ -n "${BOOTSTRAP_URL}" ]]; then
        if [[ -z "${bootstrap_tag}" && "${BOOTSTRAP_URL}" =~ /releases/download/([^/]+)/ ]]; then
            bootstrap_tag="${BASH_REMATCH[1]}"
        fi

        curl -fsSL --retry 3 --output "${BOOTSTRAP_TARBALL}" \
            "${BOOTSTRAP_URL}" >/dev/null 2>&1 || rm -f "${BOOTSTRAP_TARBALL}"

        if [[ -z "${expected_bootstrap_sha}" ]]; then
            local sha256sums_url="${AETHERFLOW_BOOTSTRAP_SHA256SUMS_URL:-${resolved_sha256sums_url}}"
            if [[ -z "${sha256sums_url}" && "${BOOTSTRAP_URL}" == */releases/download/* ]]; then
                sha256sums_url="${BOOTSTRAP_URL%/*}/SHA256SUMS"
            fi
            if [[ -n "${sha256sums_url}" ]]; then
                local bootstrap_sums="${bootstrap_tmp}/SHA256SUMS"
                if curl -fsSL --retry 3 --output "${bootstrap_sums}" "${sha256sums_url}" >/dev/null 2>&1 && [[ -s "${bootstrap_sums}" ]]; then
                    local bootstrap_asset="${BOOTSTRAP_URL##*/}"
                    bootstrap_asset="${bootstrap_asset%%\?*}"
                    expected_bootstrap_sha="$(awk -v target="${bootstrap_asset}" '
                        /^[0-9A-Fa-f]{64}[[:space:]]+/ {
                            file=$2
                            sub(/^\.\//, "", file)
                            if (file == target) {
                                print tolower($1)
                                exit
                            }
                        }
                    ' "${bootstrap_sums}")"
                fi
            fi
        fi

        local actual_bootstrap_sha=""
        if [[ -n "${expected_bootstrap_sha}" ]]; then
            if [[ ! -s "${BOOTSTRAP_TARBALL}" ]]; then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap archive download failed from ${BOOTSTRAP_URL}; refusing unverified fallback. Existing /opt/AetherFlow preserved."
            fi
            actual_bootstrap_sha="$(sha256sum "${BOOTSTRAP_TARBALL}" | awk '{print tolower($1)}')"
            if [[ "${actual_bootstrap_sha}" != "${expected_bootstrap_sha}" ]]; then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap archive SHA-256 verification failed (expected=${expected_bootstrap_sha}, actual=${actual_bootstrap_sha}). Existing /opt/AetherFlow preserved."
            fi
        elif [[ "${AETHERFLOW_ALLOW_UNVERIFIED_BOOTSTRAP:-0}" != "1" ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Refusing unverified bootstrap download from ${BOOTSTRAP_URL} without SHA256SUMS or AETHERFLOW_BOOTSTRAP_SHA256 (set AETHERFLOW_ALLOW_UNVERIFIED_BOOTSTRAP=1 only for developer testing). Existing /opt/AetherFlow preserved."
        fi

        if [[ "${explicit_sha256_pin}" -eq 0 && "${AETHERFLOW_ALLOW_UNVERIFIED_BOOTSTRAP:-0}" != "1" ]]; then
            [[ -n "${actual_bootstrap_sha}" ]] || actual_bootstrap_sha="$(sha256sum "${BOOTSTRAP_TARBALL}" | awk '{print tolower($1)}')"
            local bootstrap_attestation="${bootstrap_tmp}/aetherflow-bootstrap.tar.gz.attestation.jsonl"
            local override_attestation="${AETHERFLOW_BOOTSTRAP_ATTESTATION_FILE:-${AETHERFLOW_PROVENANCE_BUNDLE_FILE:-}}"
            if [[ -n "${override_attestation}" ]]; then
                if [[ ! -s "${override_attestation}" || -L "${override_attestation}" ]]; then
                    rm -rf "${bootstrap_tmp}"
                    af_die "Bootstrap Sigstore attestation bundle missing or invalid at ${override_attestation}; refusing unverified fallback. Existing /opt/AetherFlow preserved."
                fi
                cp -f "${override_attestation}" "${bootstrap_attestation}"
            else
                local attest_dl_ok=0
                local candidate_attest_url
                for candidate_attest_url in \
                    "${AETHERFLOW_BOOTSTRAP_ATTESTATION_URL:-}" \
                    "${resolved_attestation_url}" \
                    "${BOOTSTRAP_URL}.attestation.jsonl" \
                    "${BOOTSTRAP_URL}.sigstore.json"
                do
                    [[ -n "${candidate_attest_url}" ]] || continue
                    rm -f "${bootstrap_attestation}"
                    if curl -fsSL --retry 3 --output "${bootstrap_attestation}" "${candidate_attest_url}" >/dev/null 2>&1 && [[ -s "${bootstrap_attestation}" ]]; then
                        attest_dl_ok=1
                        break
                    fi
                done
                if [[ "${attest_dl_ok}" -ne 1 ]]; then
                    rm -rf "${bootstrap_tmp}"
                    af_die "Bootstrap Sigstore attestation download failed for ${BOOTSTRAP_URL}; refusing unverified fallback. Existing /opt/AetherFlow preserved."
                fi
            fi

            if ! _verify_bootstrap_sigstore_attestation \
                "${BOOTSTRAP_TARBALL}" \
                "${bootstrap_attestation}" \
                "${github_repo}" \
                "${actual_bootstrap_sha}" \
                "${bootstrap_tag}" \
                "${RELEASE_CHANNEL}"; then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap Sigstore attestation verification failed for ${BOOTSTRAP_URL}; refusing extraction. Existing /opt/AetherFlow preserved."
            fi
        fi

        if [[ -s "${BOOTSTRAP_TARBALL}" ]]; then
            if ! python3 - "${BOOTSTRAP_TARBALL}" <<'PYEOF' >/dev/null 2>&1
import pathlib, sys, tarfile
with tarfile.open(sys.argv[1], "r:*") as tf:
    for m in tf.getmembers():
        name = m.name or ""
        if not (m.isfile() or m.isdir()):
            raise SystemExit(1)
        if name.startswith("/") or name.startswith("\\") or ".." in pathlib.PurePosixPath(name).parts:
            raise SystemExit(1)
PYEOF
            then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap archive failed tar security validation (links or traversal detected). Existing /opt/AetherFlow preserved."
            fi
            if tar --no-same-owner --no-same-permissions -xzf "${BOOTSTRAP_TARBALL}" -C "${bootstrap_extract}" >/dev/null 2>&1; then
                bootstrap_source="$(find "${bootstrap_extract}" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
            fi
            rm -f "${BOOTSTRAP_TARBALL}"
        fi
        if [[ -z "${bootstrap_source}" ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Failed to extract verified bootstrap archive. Existing /opt/AetherFlow preserved."
        fi
    else
        local commit_meta_json="${bootstrap_tmp}/commit.json"
        local resolved_commit_sha=""
        local resolved_tree_sha=""
        if [[ "${BOOTSTRAP_REF}" =~ ^[0-9a-fA-F]{40}$ ]]; then
            resolved_commit_sha="${BOOTSTRAP_REF,,}"
        elif curl -fsSL --retry 3 -H "Accept: application/vnd.github+json" \
            --output "${commit_meta_json}" \
            "https://api.github.com/repos/${github_repo}/commits/${BOOTSTRAP_REF}" >/dev/null 2>&1 && [[ -s "${commit_meta_json}" ]]; then
            read -r resolved_commit_sha resolved_tree_sha < <(python3 - "${commit_meta_json}" <<'PYEOF' 2>/dev/null || true
import json, re, sys
doc = json.load(open(sys.argv[1], "r", encoding="utf-8"))
sha = str(doc.get("sha") or "").strip().lower()
tree = str(((doc.get("commit") or {}).get("tree") or {}).get("sha") or "").strip().lower()
if re.fullmatch(r"[0-9a-f]{40}", sha) and re.fullmatch(r"[0-9a-f]{40}", tree):
    print(f"{sha} {tree}")
PYEOF
)
        fi
        if [[ -z "${resolved_commit_sha}" && "${AETHERFLOW_ALLOW_UNVERIFIED_BOOTSTRAP:-0}" != "1" ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Unable to resolve verified commit digest for '${BOOTSTRAP_REF}' from GitHub API; refusing unverified bootstrap. Existing /opt/AetherFlow preserved."
        fi
        mkdir -p "${bootstrap_tmp}/repo"
        if [[ -n "${resolved_commit_sha}" ]]; then
            if ! (
                git -C "${bootstrap_tmp}/repo" init -q &&
                git -C "${bootstrap_tmp}/repo" remote add origin "https://github.com/${github_repo}.git" &&
                git -C "${bootstrap_tmp}/repo" fetch -q --depth 1 origin "${resolved_commit_sha}" &&
                git -C "${bootstrap_tmp}/repo" checkout -q --detach FETCH_HEAD
            ) >/dev/null 2>&1; then
                rm -rf "${bootstrap_tmp}"
                af_die "Failed to fetch verified AetherFlow commit '${resolved_commit_sha}'. Refusing implicit branch fallback; existing /opt/AetherFlow preserved."
            fi
            local actual_commit_sha actual_tree_sha
            actual_commit_sha="$(git -C "${bootstrap_tmp}/repo" rev-parse HEAD 2>/dev/null | tr '[:upper:]' '[:lower:]')"
            actual_tree_sha="$(git -C "${bootstrap_tmp}/repo" rev-parse 'HEAD^{tree}' 2>/dev/null | tr '[:upper:]' '[:lower:]')"
            if [[ "${actual_commit_sha}" != "${resolved_commit_sha}" ]] || [[ -n "${resolved_tree_sha}" && "${actual_tree_sha}" != "${resolved_tree_sha}" ]]; then
                rm -rf "${bootstrap_tmp}"
                af_die "Fetched Git object digest mismatch (commit=${actual_commit_sha}/${resolved_commit_sha}, tree=${actual_tree_sha}/${resolved_tree_sha}). Existing /opt/AetherFlow preserved."
            fi
        elif ! git clone --depth 1 --branch "${BOOTSTRAP_REF}" "https://github.com/${github_repo}.git" "${bootstrap_tmp}/repo" >/dev/null 2>&1; then
            rm -rf "${bootstrap_tmp}"
            af_die "Failed to clone AetherFlow branch '${BOOTSTRAP_REF}'. Refusing implicit branch fallback; existing /opt/AetherFlow preserved."
        fi
        bootstrap_source="${bootstrap_tmp}/repo"
    fi

    if [[ ! -f "${bootstrap_source}/setup/AetherFlow-Setup" || ! -d "${bootstrap_source}/setup/modules" ]]; then
        rm -rf "${bootstrap_tmp}"
        af_die "Staged bootstrap tree is incomplete (missing setup/AetherFlow-Setup or setup/modules). Existing /opt/AetherFlow preserved."
    fi

    # Atomically replace /opt/AetherFlow via sibling staging cutover after verification
    mkdir -p "${target_opt_parent}"
    bootstrap_stage="$(mktemp -d "${target_opt_parent}/.AetherFlow.staging.XXXXXXXXXX")"
    chmod 0755 "${bootstrap_stage}"
    if ! cp -a "${bootstrap_source}/." "${bootstrap_stage}/"; then
        rm -rf "${bootstrap_stage}" "${bootstrap_tmp}"
        af_die "Failed to stage /opt/AetherFlow from verified bootstrap tree. Existing /opt/AetherFlow preserved."
    fi

    local bootstrap_backup=""
    if [[ -e "${target_opt_root}" ]]; then
        if [[ "${target_opt_root}" == "/opt/AetherFlow" ]]; then
            bootstrap_backup="/opt/AetherFlow.bak.$$"
        else
            bootstrap_backup="${target_opt_root}.bak.$$"
        fi
        rm -rf "${bootstrap_backup}"
        mv "${target_opt_root}" "${bootstrap_backup}"
    fi
    if ! mv -T "${bootstrap_stage}" "${target_opt_root}"; then
        rm -rf "${bootstrap_stage}" "${bootstrap_tmp}"
        if [[ -n "${bootstrap_backup}" && -e "${bootstrap_backup}" ]]; then
            mv "${bootstrap_backup}" "${target_opt_root}" || true
        fi
        af_die "Failed to stage /opt/AetherFlow from verified bootstrap tree; restored previous /opt/AetherFlow."
    fi
    bootstrap_stage=""
    # Preserve existing immutable releases/current across bootstrap refresh if present
    if [[ -n "${bootstrap_backup}" && -d "${bootstrap_backup}/releases" && ! -d "${target_opt_root}/releases" ]]; then
        mv "${bootstrap_backup}/releases" "${target_opt_root}/releases"
        if [[ -L "${bootstrap_backup}/current" ]]; then
            cp -P "${bootstrap_backup}/current" "${target_opt_root}/current"
        fi
    fi
    rm -rf "${bootstrap_tmp}" "${bootstrap_backup}"
    trap - EXIT

    if [[ "${AETHERFLOW_BOOTSTRAP_NO_EXEC:-0}" == "1" ]]; then
        return 0
    fi

    # Relaunch from the proper directory
    cd "${target_opt_root}/setup" || exit 1
    exec bash AetherFlow-Setup "${ORIGINAL_ARGS[@]}"
    exit 0
}

