                done
                if [[ "${attest_dl_ok}" -ne 1 ]]; then
                    rm -rf "${bootstrap_tmp}"
                    af_die "Bootstrap Sigstore attestation download failed for ${BOOTSTRAP_URL}; refusing unverified fallback. Existing /opt/AetherFlow preserved."
                fi
            fi

            if ! _verify_bootstrap_sigstore_attestation \
                "${BOOTSTRAP_TARBALL}" \
                "${bootstrap_attestation}" \
                "${github_repo}" \
                "${actual_bootstrap_sha}" \
                "${bootstrap_tag}" \
                "${RELEASE_CHANNEL}"; then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap Sigstore attestation verification failed for ${BOOTSTRAP_URL}; refusing extraction. Existing /opt/AetherFlow preserved."
            fi
        fi

        if [[ -s "${BOOTSTRAP_TARBALL}" ]]; then
            if ! python3 - "${BOOTSTRAP_TARBALL}" <<'PYEOF' >/dev/null 2>&1
import pathlib, sys, tarfile
with tarfile.open(sys.argv[1], "r:*") as tf:
    for m in tf.getmembers():
        name = m.name or ""
        if not (m.isfile() or m.isdir()):
            raise SystemExit(1)
        if name.startswith("/") or name.startswith("\\") or ".." in pathlib.PurePosixPath(name).parts:
            raise SystemExit(1)
PYEOF
            then
                rm -rf "${bootstrap_tmp}"
                af_die "Bootstrap archive failed tar security validation (links or traversal detected). Existing /opt/AetherFlow preserved."
            fi
            if tar --no-same-owner --no-same-permissions -xzf "${BOOTSTRAP_TARBALL}" -C "${bootstrap_extract}" >/dev/null 2>&1; then
                bootstrap_source="$(find "${bootstrap_extract}" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
            fi
            rm -f "${BOOTSTRAP_TARBALL}"
        fi
        if [[ -z "${bootstrap_source}" ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Failed to extract verified bootstrap archive. Existing /opt/AetherFlow preserved."
        fi
    else
        local commit_meta_json="${bootstrap_tmp}/commit.json"
        local resolved_commit_sha=""
        local resolved_tree_sha=""
        if [[ "${BOOTSTRAP_REF}" =~ ^[0-9a-fA-F]{40}$ ]]; then
            resolved_commit_sha="${BOOTSTRAP_REF,,}"
        elif curl -fsSL --retry 3 -H "Accept: application/vnd.github+json" \
            --output "${commit_meta_json}" \
            "https://api.github.com/repos/${github_repo}/commits/${BOOTSTRAP_REF}" >/dev/null 2>&1 && [[ -s "${commit_meta_json}" ]]; then
            read -r resolved_commit_sha resolved_tree_sha < <(python3 - "${commit_meta_json}" <<'PYEOF' 2>/dev/null || true
import json, re, sys
doc = json.load(open(sys.argv[1], "r", encoding="utf-8"))
sha = str(doc.get("sha") or "").strip().lower()
tree = str(((doc.get("commit") or {}).get("tree") or {}).get("sha") or "").strip().lower()
if re.fullmatch(r"[0-9a-f]{40}", sha) and re.fullmatch(r"[0-9a-f]{40}", tree):
    print(f"{sha} {tree}")
PYEOF
)
        fi
        if [[ -z "${resolved_commit_sha}" && "${AETHERFLOW_ALLOW_UNVERIFIED_BOOTSTRAP:-0}" != "1" ]]; then
            rm -rf "${bootstrap_tmp}"
            af_die "Unable to resolve verified commit digest for '${BOOTSTRAP_REF}' from GitHub API; refusing unverified bootstrap. Existing /opt/AetherFlow preserved."
        fi
        mkdir -p "${bootstrap_tmp}/repo"
        if [[ -n "${resolved_commit_sha}" ]]; then
            if ! (
                git -C "${bootstrap_tmp}/repo" init -q &&
                git -C "${bootstrap_tmp}/repo" remote add origin "https://github.com/${github_repo}.git" &&
                git -C "${bootstrap_tmp}/repo" fetch -q --depth 1 origin "${resolved_commit_sha}" &&
                git -C "${bootstrap_tmp}/repo" checkout -q --detach FETCH_HEAD
            ) >/dev/null 2>&1; then
                rm -rf "${bootstrap_tmp}"
                af_die "Failed to fetch verified AetherFlow commit '${resolved_commit_sha}'. Refusing implicit branch fallback; existing /opt/AetherFlow preserved."
            fi
            local actual_commit_sha actual_tree_sha
            actual_commit_sha="$(git -C "${bootstrap_tmp}/repo" rev-parse HEAD 2>/dev/null | tr '[:upper:]' '[:lower:]')"
            actual_tree_sha="$(git -C "${bootstrap_tmp}/repo" rev-parse 'HEAD^{tree}' 2>/dev/null | tr '[:upper:]' '[:lower:]')"
            if [[ "${actual_commit_sha}" != "${resolved_commit_sha}" ]] || [[ -n "${resolved_tree_sha}" && "${actual_tree_sha}" != "${resolved_tree_sha}" ]]; then
                rm -rf "${bootstrap_tmp}"
                af_die "Fetched Git object digest mismatch (commit=${actual_commit_sha}/${resolved_commit_sha}, tree=${actual_tree_sha}/${resolved_tree_sha}). Existing /opt/AetherFlow preserved."
            fi
        elif ! git clone --depth 1 --branch "${BOOTSTRAP_REF}" "https://github.com/${github_repo}.git" "${bootstrap_tmp}/repo" >/dev/null 2>&1; then
            rm -rf "${bootstrap_tmp}"
            af_die "Failed to clone AetherFlow branch '${BOOTSTRAP_REF}'. Refusing implicit branch fallback; existing /opt/AetherFlow preserved."
        fi
        bootstrap_source="${bootstrap_tmp}/repo"
    fi

    if [[ ! -f "${bootstrap_source}/setup/AetherFlow-Setup" || ! -d "${bootstrap_source}/setup/modules" ]]; then
        rm -rf "${bootstrap_tmp}"
        af_die "Staged bootstrap tree is incomplete (missing setup/AetherFlow-Setup or setup/modules). Existing /opt/AetherFlow preserved."
    fi

    # Atomically replace /opt/AetherFlow via sibling staging cutover after verification
    mkdir -p "${target_opt_parent}"
    bootstrap_stage="$(mktemp -d "${target_opt_parent}/.AetherFlow.staging.XXXXXXXXXX")"
    chmod 0755 "${bootstrap_stage}"
    if ! cp -a "${bootstrap_source}/." "${bootstrap_stage}/"; then
        rm -rf "${bootstrap_stage}" "${bootstrap_tmp}"
        af_die "Failed to stage /opt/AetherFlow from verified bootstrap tree. Existing /opt/AetherFlow preserved."
    fi

    local bootstrap_backup=""
    if [[ -e "${target_opt_root}" ]]; then
        if [[ "${target_opt_root}" == "/opt/AetherFlow" ]]; then
            bootstrap_backup="/opt/AetherFlow.bak.$$"
        else
            bootstrap_backup="${target_opt_root}.bak.$$"
        fi
        rm -rf "${bootstrap_backup}"
        mv "${target_opt_root}" "${bootstrap_backup}"
    fi
    if ! mv -T "${bootstrap_stage}" "${target_opt_root}"; then
        rm -rf "${bootstrap_stage}" "${bootstrap_tmp}"
        if [[ -n "${bootstrap_backup}" && -e "${bootstrap_backup}" ]]; then
            mv "${bootstrap_backup}" "${target_opt_root}" || true
        fi
        af_die "Failed to stage /opt/AetherFlow from verified bootstrap tree; restored previous /opt/AetherFlow."
    fi
    bootstrap_stage=""
    # Preserve existing immutable releases/current across bootstrap refresh if present
    if [[ -n "${bootstrap_backup}" && -d "${bootstrap_backup}/releases" && ! -d "${target_opt_root}/releases" ]]; then
        mv "${bootstrap_backup}/releases" "${target_opt_root}/releases"
        if [[ -L "${bootstrap_backup}/current" ]]; then
            cp -P "${bootstrap_backup}/current" "${target_opt_root}/current"
        fi
    fi
    rm -rf "${bootstrap_tmp}" "${bootstrap_backup}"
    trap - EXIT

    if [[ "${AETHERFLOW_BOOTSTRAP_NO_EXEC:-0}" == "1" ]]; then
        return 0
    fi

    # Relaunch from the proper directory
    cd "${target_opt_root}/setup" || exit 1
    exec bash AetherFlow-Setup "${ORIGINAL_ARGS[@]}"
    exit 0
}

