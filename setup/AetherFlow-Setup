_load_env_seed_file() {
    local resolved_seed=""
    local source_exit=0

    if resolved_seed="$(af_find_env_seed)"; then
        ENV_SEED_FILE="${resolved_seed}"
        export AETHERFLOW_ENV_SEED="${ENV_SEED_FILE}"
        echo "Loaded environment seed from ${ENV_SEED_FILE}"
        set -a
        # shellcheck disable=1090
        source "${ENV_SEED_FILE}"
        source_exit=$?
        set +a
        [[ ${source_exit} -eq 0 ]] || af_die "Unable to source env seed file: ${ENV_SEED_FILE}"
        UNATTENDED=true
    fi
}

_save_seed_value() {
    local key="$1"
    local value="$2"
    if [[ -n "${value}" ]]; then
        _save_config "${key}" "${value}"
    fi
}

_save_seed_yes_no() {
    local key="$1"
    local value="$2"
    local default_value="$3"
    if [[ -n "${value}" ]]; then
        _save_config "${key}" "$(af_normalize_yes_no "${value}" "${default_value}")"
    fi
}

_apply_seed_config() {
    local seeded_username=""
    local seeded_password=""
    local seeded_hostname=""
    local seeded_public_ip=""
    local seeded_log_file=""
    local seeded_primaryroot=""
    local seeded_kernel=""
    local seeded_10g=""
