    seeded_username="$(af_first_nonempty "${CLI_USERNAME}" "${AETHERFLOW_USERNAME:-}" "${INSTALL_USERNAME:-}" "${username:-}")"
    seeded_password="$(af_first_nonempty "${CLI_PASSWORD}" "${AETHERFLOW_PASSWORD:-}" "${INSTALL_PASSWORD:-}" "${passwd:-${password:-}}")"
    seeded_hostname="$(af_first_nonempty "${CLI_DOMAIN}" "${AETHERFLOW_HOSTNAME:-}" "${AETHERFLOW_DOMAIN:-}" "${hostname_value:-${domain:-}}")"
    seeded_public_ip="$(af_first_nonempty "${AETHERFLOW_PUBLIC_IP:-}" "${AETHERFLOW_IP:-}" "${IP:-}")"
    seeded_log_file="$(af_first_nonempty "${AETHERFLOW_LOG_FILE:-}" "${OUTTO:-}")"
    seeded_primaryroot="$(af_first_nonempty "${AETHERFLOW_PRIMARYROOT:-}" "${primaryroot:-}")"
    seeded_kernel="$(af_first_nonempty "${AETHERFLOW_INSTALL_DISTRIBUTION_KERNEL:-}" "${kernel:-}")"
    seeded_10g="$(af_first_nonempty "${AETHERFLOW_IS_10G:-}" "${AETHERFLOW_10G:-}" "${is10g:-}")"
    seeded_ffmpeg="$(af_first_nonempty "${AETHERFLOW_FFMPEG:-}" "${ffmpeg:-}")"
    seeded_bbr="$(af_first_nonempty "${AETHERFLOW_BBR:-}" "${bbr:-}")"
    seeded_denyhosts="$(af_first_nonempty "${AETHERFLOW_BLOCK_PUBLIC_TRACKERS:-}" "${denyhosts:-}")"
    seeded_reboot="$(af_first_nonempty "${AETHERFLOW_REBOOT:-}" "${reboot_after_install:-}")"
    seeded_channel="$(af_first_nonempty "${RELEASE_CHANNEL:-}" "${AETHERFLOW_RELEASE_CHANNEL:-}" "${release_channel:-}" "$(af_detect_default_channel)")"
    seeded_from_source="$(af_first_nonempty "${AETHERFLOW_BUILD_FROM_SOURCE:-}" "${build_from_source:-}")"
