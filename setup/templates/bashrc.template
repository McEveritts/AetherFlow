# AetherFlow v4.0.0 shell environment drop-in (/etc/profile.d/aetherflow.sh)
case ":${PATH}:" in
    *:/opt/AetherFlow/current/bin:*) ;;
    *) PATH="${PATH}:/opt/AetherFlow/current/bin" ;;
esac
case ":${PATH}:" in
    *:/usr/local/bin:*) ;;
    *) PATH="/usr/local/bin:${PATH}" ;;
esac
export PATH

if [ -n "${PS1:-}" ]; then
    alias af-status='aetherflow status'
    alias af-logs='aetherflow logs'
    alias af-restart='aetherflow restart'
fi
