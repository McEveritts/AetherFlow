<VirtualHost *:80>
        ServerName _
        ProxyRequests Off
        ProxyPreserveHost On
        ProxyTimeout 3600
        RequestHeader unset X-Real-IP
        RequestHeader unset X-Forwarded-Host
        RequestHeader unset X-Aetherflow-User
        RequestHeader unset X-Aetherflow-External-App
        RequestHeader unset Remote-User
        RequestHeader unset X-Forwarded-User
        RequestHeader set X-Real-IP "%{REMOTE_ADDR}s"
        RequestHeader set X-Forwarded-Proto "http"
        RequestHeader set X-Forwarded-Port "80"
        RewriteEngine On
        RewriteCond %{HTTP_HOST} \.aether\.local(:[0-9]+)?$ [NC]
        RewriteCond %{HTTP:Upgrade} websocket [NC]
        RewriteCond %{HTTP:Connection} upgrade [NC]
        RewriteRule ^/?(.*)$ ws://127.0.0.1:8080/$1 [P,L]
        RewriteCond %{HTTP_HOST} \.aether\.local(:[0-9]+)?$ [NC]
        RewriteRule ^/?(.*)$ http://127.0.0.1:8080/$1 [P,L]
        RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
        RewriteRule ^/?(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

        DocumentRoot "/var/www/aetherflow-default"
        <Directory "/var/www/aetherflow-default/">
                Options -Indexes -Includes -ExecCGI
                AllowOverride None
                Require all granted
        </Directory>
</VirtualHost>

<VirtualHost *:443>
        ServerName _
        Protocols h2 http/1.1
        SSLEngine on
        SSLProtocol -all +TLSv1.2 +TLSv1.3
        SSLHonorCipherOrder off
        SSLCipherSuite HIGH:!aNULL:!MD5:!3DES
        SSLCompression off
        SSLSessionTickets off

        SSLCertificateFile /etc/ssl/certs/ssl-cert-snakeoil.pem
        SSLCertificateKeyFile /etc/ssl/private/ssl-cert-snakeoil.key

        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

        DocumentRoot "/var/www/aetherflow-default"
        <Directory "/var/www/aetherflow-default/">
                Options -Indexes -Includes -ExecCGI
                AllowOverride None
                Require all granted
        </Directory>
        <Location "/.well-known/acme-challenge/">
                Require all granted
        </Location>

        ProxyRequests Off
        ProxyPreserveHost On
        ProxyTimeout 3600
        RequestHeader unset X-Real-IP
        RequestHeader unset X-Forwarded-Host
        RequestHeader unset X-Aetherflow-User
        RequestHeader unset X-Aetherflow-External-App
        RequestHeader unset Remote-User
        RequestHeader unset X-Forwarded-User
        RequestHeader set X-Real-IP "%{REMOTE_ADDR}s"
        RequestHeader set X-Forwarded-Proto "https"
        RequestHeader set X-Forwarded-Port "443"

        RewriteEngine On
        RewriteCond %{HTTP:Upgrade} websocket [NC]
        RewriteCond %{HTTP:Connection} upgrade [NC]
        RewriteRule ^/?(.*)$ ws://127.0.0.1:8080/$1 [P,L]

        ProxyPass /.well-known/acme-challenge/ !
        ProxyPass /downloads !
        ProxyPassMatch "^/[^/]+[.](rtorrent|deluge)[.]downloads(/|$)" !

        ProxyPass /api/ http://127.0.0.1:8080/api/ retry=0 timeout=3600 keepalive=On
        ProxyPassReverse /api/ http://127.0.0.1:8080/api/

        ProxyPass / http://127.0.0.1:8080/ retry=0 timeout=3600 keepalive=On upgrade=websocket
        ProxyPassReverse / http://127.0.0.1:8080/
</VirtualHost>
