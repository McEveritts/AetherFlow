[Unit]
Description=AetherFlow Control Plane and WASM Dashboard
Documentation=https://github.com/McEveritts/AetherFlow
After=network-online.target time-sync.target aetherflow-runner.service
Wants=network-online.target aetherflow-runner.service
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=aetherflow
Group=aetherflow
SupplementaryGroups=systemd-journal adm
WorkingDirectory=/opt/AetherFlow/current
ExecStart=/opt/AetherFlow/current/aetherflow-api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Managed Directories
StateDirectory=aetherflow
StateDirectoryMode=0700

Environment=PORT=8080
Environment=DATA_DIR=/var/lib/aetherflow
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock
Environment=PRIVILEGED_RUNNER_ENABLED=true
Environment=AETHERFLOW_ENV=production
EnvironmentFile=-/opt/AetherFlow/current/backend/.env
EnvironmentFile=-/etc/aetherflow/aetherflow.env

# Zero-Trust Namespace Isolation
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/dri rw
DeviceAllow=char-drm rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
NoNewPrivileges=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=default
ProcSubset=all
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

ReadWritePaths=/var/lib/aetherflow /var/log/aetherflow /run/aetherflow
ReadWritePaths=-/opt/AetherFlow/backend/data

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
