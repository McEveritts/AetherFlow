[Unit]
Description=AetherFlow Control Plane & Embedded UI (Single-Binary)
Documentation=https://github.com/McEveritts/AetherFlow
After=network-online.target time-sync.target aetherflow-runner.service
Wants=network-online.target aetherflow-runner.service
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=aetherflow
Group=aetherflow
SupplementaryGroups=systemd-journal adm
WorkingDirectory=/opt/AetherFlow/current
ExecStart=/opt/AetherFlow/current/aetherflow-api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Managed Directories
StateDirectory=aetherflow
StateDirectoryMode=0700
LogsDirectory=aetherflow
LogsDirectoryMode=0750

Environment=GIN_MODE=release
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/aetherflow
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock
Environment=PRIVILEGED_RUNNER_ENABLED=true
Environment=COOKIE_SECURE=false
EnvironmentFile=-/etc/aetherflow/aetherflow.env
EnvironmentFile=-/opt/AetherFlow/current/backend/.env

# Zero-Trust Namespace Isolation
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=default
ProcSubset=all
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

ReadWritePaths=/var/lib/aetherflow /var/log/aetherflow /run/aetherflow
ReadWritePaths=-/opt/AetherFlow/backend/data -/var/lib/openclaw -/home/hdd

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
