[Unit]
Description=AetherFlow Go API Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aetherflow
Group=aetherflow
WorkingDirectory=/opt/AetherFlow/backend
ExecStart=/opt/AetherFlow/backend/aetherflow-api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment=GIN_MODE=release
# Fix #5: Correct DB path — backend/data/, not dashboard/db/
Environment=AETHERFLOW_DB_PATH=/opt/AetherFlow/backend/data/aetherflow.sqlite
# Fix #5: AES key and JWT secret (installer overwrites with generated values)
Environment=AES_MASTER_KEY=__AES_MASTER_KEY__
Environment=JWT_SECRET=__JWT_SECRET__
# Fix #7: Allow plain-HTTP session cookies for local/HTTP testing
Environment=COOKIE_SECURE=false
# Fix #8: ALLOWED_HOSTS (installer injects the host's LAN + public IP)
Environment=ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,__HOST_IP__:8080,__PUBLIC_IP__:8080
# Fix #9: CORS origins including the frontend port (LAN + public IP)
Environment=ALLOWED_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://__HOST_IP__:3000,http://__PUBLIC_IP__:3000

# Security Hardening
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
# Fix #5: ReadWritePaths for the backend data directory
ReadWritePaths=/opt/AetherFlow/backend/data

[Install]
WantedBy=multi-user.target
