[Unit]
Description=AetherFlow Control Plane & Embedded UI (Single-Binary)
Documentation=https://github.com/McEveritts/AetherFlow
After=network-online.target time-sync.target aetherflow-runner.service
Wants=network-online.target aetherflow-runner.service
RequiresMountsFor=/opt/AetherFlow

[Service]
Type=simple
User=aetherflow
Group=aetherflow
WorkingDirectory=/opt/AetherFlow/backend
ExecStart=/opt/AetherFlow/backend/aetherflow-api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Managed Directories
StateDirectory=aetherflow
StateDirectoryMode=0700
LogsDirectory=aetherflow
LogsDirectoryMode=0750

# Environment injection from hardened FHS path with legacy fallback
EnvironmentFile=-/etc/aetherflow/aetherflow.env
Environment=GIN_MODE=release
Environment=AETHERFLOW_DB_PATH=/opt/AetherFlow/backend/data/aetherflow.sqlite
Environment=AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock
Environment=AES_MASTER_KEY=__AES_MASTER_KEY__
Environment=JWT_SECRET=__JWT_SECRET__
Environment=COOKIE_SECURE=false
Environment=ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,__HOST_IP__:8080,__PUBLIC_IP__:8080
Environment=ALLOWED_CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://__HOST_IP__:8080,http://__PUBLIC_IP__:8080

# Zero-Trust Namespace Isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

ReadWritePaths=/var/lib/aetherflow /var/log/aetherflow /run/aetherflow /opt/AetherFlow/backend/data
ReadWritePaths=-/var/lib/openclaw

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
