# AetherFlow Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Google OAuth2 (Required for login)
# ===========================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web application)
# 2. Add your server's URL to Authorized JavaScript Origins
# 3. Add the redirect URI below to Authorized Redirect URIs
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=https://YOUR_SERVER_IP/api/auth/google/callback

# ===========================================
# Admin & Security
# ===========================================
# The email address that gets automatic admin role on first login
ADMIN_EMAIL=your-email@gmail.com

# JWT signing secret (generate a random string)
JWT_SECRET=change-me-to-a-random-secret-string

# ===========================================
# API Server
# ===========================================
PORT=8080

# ===========================================
# Database
# ===========================================
DB_PATH=/opt/AetherFlow/backend/aetherflow.sqlite

# ===========================================
# Google AI / Gemini (Optional - for AI features)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# Cluster Mode (Optional - for multi-node setups)
# ===========================================
# CLUSTER_MODE=master|worker|standalone (default: standalone)
# CLUSTER_MODE=master
# GRPC_PORT=50051
# CLUSTER_MASTER_ADDR=master-ip:50051
# CLUSTER_PSK=your-pre-shared-key
# CLUSTER_CA_CERT=/path/to/ca.crt
# CLUSTER_SERVER_CERT=/path/to/server.crt
# CLUSTER_SERVER_KEY=/path/to/server.key
# CLUSTER_CLIENT_CERT=/path/to/client.crt
# CLUSTER_CLIENT_KEY=/path/to/client.key

# ===========================================
# OIDC Provider (Optional - SSO for downstream apps)
# ===========================================
# OIDC_ISSUER=https://your-server.com
# OIDC_KEY_PATH=./data/oidc_rsa.pem

# ===========================================
# Encryption & Security (Required for production)
# ===========================================
# AES-256 master key for encrypting API keys at rest in SQLite.
# Must be exactly 32 bytes (raw) or base64-encoded 32 bytes.
# Server will refuse to start in production (GIN_MODE=release) without this.
# Generate with: openssl rand -base64 32
AES_MASTER_KEY=

# Redis configuration for JWT blacklisting (session revocation)
REDIS_PASSWORD=
REDIS_ADDR=localhost:6379

# Comma-separated list of allowed Host header values.
# Prevents host header injection and open redirect attacks (CWE-601).
# Leave empty for dev (allows all hosts).
# ALLOWED_HOSTS=api.aetherflow.com,your-domain.com,your-public-ip:8080

# Comma-separated list of frontend origins for CORS and WebSocket CheckOrigin.
# When set, overrides the auto-detection of local/LAN/public IPs.
# Each entry must be a full origin URL (scheme + host + optional port).
# Example below uses RFC 5737 documentation-only IP space.
# ALLOWED_CORS_ORIGIN=http://localhost:3000,http://192.168.1.100:3000,http://192.0.2.10:3000

# Cookie security flag. Defaults to true (HTTPS-only).
# Set to false ONLY for local HTTP development.
# COOKIE_SECURE=false

# CSRF protection is ON by default for cookie-authenticated requests.
# Set CSRF_DISABLED=true to disable for local development.
# CSRF_DISABLED=false
