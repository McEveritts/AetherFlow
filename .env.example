# AetherFlow Environment Configuration (/etc/aetherflow/aetherflow.env)
# Copy this file to /etc/aetherflow/aetherflow.env (mode 0600) or .env for local dev

# ===========================================
# Core Secrets (Required)
# ===========================================
# HS256 JWT signing secret (>= 32 bytes, cryptographically random)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-string-at-least-32-bytes

# AES-256-GCM master key for encrypting API keys & secrets at rest in SQLite (enc:v1:).
# Must be exactly 32 bytes (raw 32-char) or Base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
AES_MASTER_KEY=

# ===========================================
# Rust Control Plane & Privileged Runner
# ===========================================
PORT=8080
AF_DB_PATH=/var/lib/aetherflow/aetherflow.sqlite
AETHERFLOW_RUNNER_SOCK=/run/aetherflow/runner.sock

# Optional default baseDomain for automatic <app>.<baseDomain> Apache2 TLS ingress
# AETHERFLOW_BASE_DOMAIN=node.example.com

# ===========================================
# Native McBrowser Storage (af-files)
# ===========================================
# Dedicated absolute directory owned by the API service user (mode 0700).
# Custom paths must also be added to ReadWritePaths in aetherflow-api.service.
AF_MCBROWSER_ROOT=/var/lib/aetherflow/mcbrowser
# AF_MCBROWSER_MAX_UPLOAD_BYTES=68719476736
# AF_ALLOWED_FS_ROOTS=/mnt,/media,/srv,/home

# ===========================================
# Google OAuth2 & Built-In OIDC Provider (Optional)
# ===========================================
# ADMIN_EMAIL=your-email@example.com
# GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret-here
# GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
# OIDC_ISSUER=https://YOUR_DOMAIN
# OIDC_KEY_PATH=/var/lib/aetherflow/oidc_rsa.pem

# ===========================================
# FlowAI Multi-Provider Defaults (Optional)
# ===========================================
# Keys saved via Settings -> FlowAI Engine are encrypted at rest in SQLite and take precedence.
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_ENDPOINT=http://localhost:11434
# LM_STUDIO_ENDPOINT=http://localhost:1234

# ===========================================
# Host, CORS & Cookie Hardening
# ===========================================
# Comma-separated list of allowed Host header values (prevents Host header poisoning).
# ALLOWED_HOSTS=node.example.com,localhost:8080,127.0.0.1:8080

# Comma-separated list of frontend origins for CORS and WebSocket Origin checks.
# ALLOWED_CORS_ORIGIN=https://node.example.com

# Cookie security flag (defaults to true for HTTPS). Set false ONLY for local HTTP dev.
# COOKIE_SECURE=true
# CSRF_DISABLED=false

# ===========================================
# Release Engine, Package Executor & Cluster (Optional)
# ===========================================
# Optional GitHub token for higher rate limits on release checks
# AF_GITHUB_TOKEN=
# AETHERFLOW_ENABLE_RUST_PACKAGES=0
# AETHERFLOW_USE_RUST_RELEASE=0
# AF_HEAL_AUTO_APPROVE=false

# CLUSTER_MODE=standalone
# GRPC_PORT=50051
# CLUSTER_MASTER_ADDR=master-ip:50051
# CLUSTER_PSK=your-pre-shared-key
