{
  "id": "telemetry-inspector",
  "name": "Telemetry Inspector",
  "version": "1.0.0",
  "sdk": "managed-sample",
  "contract_version": "v1",
  "runtime_status": "managed",
  "description": "Managed loopback telemetry & marketplace diagnostics sample plugin for AetherFlow v4.0.0.",
  "author": "AetherFlow Core",
  "permissions": [
    "marketplace:read",
    "system:metrics:read"
  ],
  "api_scopes": [
    "GET /api/v1/public/marketplace",
    "GET /api/v1/auth/system/metrics"
  ],
  "lifecycle_hooks": {
    "on_start": "backend/hooks/start.sh"
  },
  "backend": {
    "language": "python3",
    "entry": "backend/runtime.py",
    "health_path": "/healthz",
    "port_allocation": "dynamic"
  },
  "frontend": {
    "entry": "frontend/dist/index.html",
    "bundle": "frontend/dist/index.html",
    "slot": "marketplace",
    "capabilities": [
      "sandbox-iframe",
      "postmessage-bridge",
      "scoped-proxy"
    ]
  }
}
