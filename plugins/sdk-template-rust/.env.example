AETHERFLOW_API_BASE_URL=http://127.0.0.1:8080
# Short-lived scoped plugin token (typ=plugin, iss=aetherflow-plugin, aud=aetherflow-plugin-api)
# minted automatically by the host runtime or via POST /api/v1/admin/plugins/<id>/token.
# NEVER pass an operator session JWT here.
AETHERFLOW_PLUGIN_TOKEN=replace-with-scoped-plugin-token
PLUGIN_BIND_ADDR=127.0.0.1
PLUGIN_PORT=21000
