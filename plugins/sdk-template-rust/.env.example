AETHERFLOW_API_BASE_URL=http://127.0.0.1:8080
# Operator session JWT (HS256 aetherflow_session token) required for /api/v1/auth/* routes.
# Note: plugin-scoped token minting is not yet active in backend-rs.
AETHERFLOW_PLUGIN_TOKEN=replace-with-operator-session-jwt
PLUGIN_BIND_ADDR=127.0.0.1
PLUGIN_PORT=9123
