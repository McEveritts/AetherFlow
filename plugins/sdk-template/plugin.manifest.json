{
  "id": "{{PLUGIN_ID}}",
  "name": "{{PLUGIN_NAME}}",
  "version": "0.1.0",
  "description": "Describe what this plugin adds to AetherFlow.",
  "author": "Community Developer",
  "permissions": [
    "marketplace:read",
    "system:metrics:read"
  ],
  "api_scopes": [
    "GET /api/v1/public/marketplace",
    "GET /api/v1/auth/system/metrics"
  ],
  "lifecycle_hooks": {
    "on_start": "backend/hooks/start.sh",
    "on_stop": "backend/hooks/stop.sh"
  },
  "backend": {
    "entry": "backend/main.go",
    "health_path": "/healthz",
    "port_allocation": "dynamic"
  },
  "frontend": {
    "entry": "frontend/src/index.tsx",
    "slot": "marketplace"
  }
}
