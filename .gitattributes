# Set default behavior to automatically normalize line endings and use LF
* text=auto eol=lf

# Explicitly ensure shell scripts and systemd templates always use LF line endings
*.sh text eol=lf
*.bash text eol=lf
*.template text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.env text eol=lf

# Explicitly mark archives and binary assets as binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.zip binary
*.deb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary

# Mark vendored third-party C/C++ sources, legacy Go compatibility tree, and static bundles as vendored for GitHub Linguist
setup/sources/** linguist-vendored
backend/** linguist-vendored
packages/package/assets/librespeed/backend-patches/** linguist-vendored
plugins/sdk-template/** linguist-vendored
frontend/public/** linguist-vendored

